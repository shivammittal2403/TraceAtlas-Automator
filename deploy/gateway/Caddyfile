# TraceAtlas single-IP LOCAL gateway. Requires Caddy >= 2.8.
# Binds exclusively to 127.0.0.1. For access from a remote workstation,
# use an authenticated SSH tunnel or private VPN, NOT a public port forward.
# Run via deploy/gateway/start-local.sh; do not serve this file over the web.
http://127.0.0.1:8780 {
    bind 127.0.0.1
    encode gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Cross-Origin-Resource-Policy "same-origin"
        Cache-Control "no-store"
        -Server
    }

    # Bcrypt/argon2 hash generated by 'caddy hash-password', not plaintext.
    # All routes, including health checks, require gateway authentication.
    basic_auth {
        analyst {$TRACEATLAS_GATEWAY_PASSWORD_HASH}
    }

    route {
        @employeeRoot path /employee
        redir @employeeRoot /employee/ 308

        # The only proxied backend is the existing authorized single-user
        # employee console. The upstream is itself bound to loopback and
        # rejects calls missing the separate internal gateway token.
        handle_path /employee/* {
            reverse_proxy 127.0.0.1:8765 {
                header_up Host 127.0.0.1:8765
                header_up X-TraceAtlas-Internal-Token {$TRACEATLAS_CONSOLE_GATEWAY_TOKEN}
                transport http {
                    dial_timeout 3s
                    response_header_timeout 35s
                }
            }
        }

        handle /gateway/healthz {
            respond "gateway_alive_not_production_ready" 200
        }

        # Hosted Vercel+Supabase handlers are NOT a local process. Do not
        # impersonate them, leak cloud worker credentials, or route them to
        # the privileged local single-user employee.
        handle /api/* {
            respond "cloud_control_plane_not_mounted" 503
        }

        # Public static frontend and source catalogue on one local origin.
        # Browser features requiring /api remain unavailable until a fully
        # authenticated/tenant-qualified hosted control plane is deployed.
        handle {
            root * {$TRACEATLAS_PUBLIC_DIR}
            file_server
        }
    }
}
