            "invoices",
            "ledgers",
            "ownership_data",
            "sanctions_data",
            "trade_data",
            "crypto_refs",
            "financial_reports",
            "transaction_paths",
            "bank_statement_paths",
            "invoice_paths",
            "ledger_paths",
            "ownership_paths",
            "sanctions_paths",
            "stix_misp_paths",
