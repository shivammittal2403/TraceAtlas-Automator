# --------------------------------------------------------------------
# Generic helpers
# --------------------------------------------------------------------

def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat()


def stable_id(prefix: str, *parts: Any) -> str:
    raw = "|".join(str(json_safe(p)) for p in parts)
    digest = hashlib.sha1(raw.encode("utf-8")).hexdigest()[:16]
    return f"{prefix}-{digest}"


def json_safe(obj: Any) -> Any:
    if isinstance(obj, dict):
        return {str(k): json_safe(v) for k, v in obj.items()}
    if isinstance(obj, (list, tuple, set)):
        return [json_safe(x) for x in obj]
    if isinstance(obj, datetime):
        return obj.isoformat()
    if isinstance(obj, timedelta):
        return obj.total_seconds()
    if isinstance(obj, bytes):
        return obj.hex()
    if isinstance(obj, (str, int, float, bool, type(None))):
        return obj
    return str(obj)


def normalize_text(value: Any) -> str:
    if value is None:
        return ""
    s = unicodedata.normalize("NFKC", str(value))
    s = re.sub(r"[\u200b\u200c\u200d\u2060\ufeff]", "", s)
    return s.strip()


def iso(dt: Optional[datetime]) -> Optional[str]:
    return dt.isoformat() if isinstance(dt, datetime) else None


def clamp(value: float, lo: float = 0.0, hi: float = 1.0) -> float:
    return max(lo, min(hi, value))


def unique_preserve(items: Iterable[Any]) -> List[Any]:
    seen: Set[str] = set()
    out = []
    for item in items:
        key = json_safe(item)
        if isinstance(key, (dict, list)):
            key = json.dumps(key, sort_keys=True, ensure_ascii=False)
        key = str(key)
        if key not in seen:
            seen.add(key)
            out.append(item)
    return out


def add_unique(lst: List[Any], item: Any) -> None:
    if item is None:
        return
    key = json_safe(item)
    if isinstance(key, (dict, list)):
        key = json.dumps(key, sort_keys=True, ensure_ascii=False)
    key = str(key)
    for existing in lst:
        ex_key = json_safe(existing)
        if isinstance(ex_key, (dict, list)):
            ex_key = json.dumps(ex_key, sort_keys=True, ensure_ascii=False)
        if str(ex_key) == key:
            return
    lst.append(item)


def parse_time(value: Any) -> Optional[datetime]:
    if not value:
        return None
    s = normalize_text(value)
    if not s:
        return None
    if s.endswith("Z"):
        s = s[:-1] + "+00:00"
    try:
        dt = datetime.fromisoformat(s)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        return dt
    except Exception:
        pass
    for fmt in (
        "%Y-%m-%dT%H:%M:%S%z",
        "%Y-%m-%dT%H:%M:%S",
        "%Y-%m-%d %H:%M:%S",
        "%Y-%m-%d",
        "%d/%m/%Y",
        "%m/%d/%Y",
        "%Y-%m",
        "%Y",
    ):
        try:
            dt = datetime.strptime(s, fmt)
            if dt.tzinfo is None:
                dt = dt.replace(tzinfo=timezone.utc)
            return dt
        except Exception:
            continue
    return None


def parse_float(value: Any) -> Optional[float]:
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        return float(value)
    s = normalize_text(value).replace(",", "")
    m = re.search(r"[-+]?\d*\.?\d+(?:[eE][-+]?\d+)?", s)
    if not m:
        return None
    try:
        return float(m.group())
    except Exception:
        return None


def parse_int(value: Any) -> Optional[int]:
    f = parse_float(value)
    return int(f) if f is not None else None


def sha256_hex(value: str) -> str:
    return hashlib.sha256(value.encode("utf-8")).hexdigest()


def mask_value(value: Any, keep_prefix: int = 3, keep_suffix: int = 2) -> str:
    s = normalize_text(value)
    if not s:
        return ""
    if len(s) <= keep_prefix + keep_suffix:
        return "*" * len(s)
    return s[:keep_prefix] + "*" * (len(s) - keep_prefix - keep_suffix) + s[-keep_suffix:]


def source_list(*items: Any) -> List[str]:
    out = []
    for it in items:
        if it is None:
            continue
        if isinstance(it, list):
            out.extend(normalize_text(x) for x in it if normalize_text(x))
        else:
            s = normalize_text(it)
            if s:
                out.append(s)
    return list(dict.fromkeys(out))


def norm_enum(value: Any, allowed: Set[str], default: str = "UNKNOWN") -> str:
    s = normalize_text(value).upper().replace("-", "_").replace(" ", "_")
    return s if s in allowed else default


def days_between(a: Optional[datetime], b: Optional[datetime]) -> Optional[int]:
    if not a or not b:
        return None
    return (b - a).days


def safe_mean(values: Iterable[float]) -> Optional[float]:
    vals = [float(v) for v in values]
    if not vals:
        return None
    return round(sum(vals) / float(len(vals)), 6)


def median(values: Iterable[float]) -> Optional[float]:
    vals = sorted(float(v) for v in values)
    if not vals:
        return None
    n = len(vals)
    mid = n // 2
    if n % 2:
        return round(vals[mid], 6)
    return round((vals[mid - 1] + vals[mid]) / 2.0, 6)


def relative_diff(a: Optional[float], b: Optional[float]) -> Optional[float]:
    if a is None or b is None:
        return None
    denom = max(abs(a), abs(b), 1e-9)
    return abs(a - b) / denom


def to_percent_share(value: Optional[float]) -> Optional[float]:
    if value is None:
        return None
    if 0.0 <= value <= 1.0:
        return value * 100.0
    if 0.0 <= value <= 100.0:
        return value
    return None


# --------------------------------------------------------------------
# Policy / authorization
# --------------------------------------------------------------------

def collect_intent_text(manifest: Dict[str, Any]) -> str:
    parts = [
        normalize_text(manifest.get("objective", "")),
        " ".join(normalize_text(q) for q in manifest.get("questions", []) or []),
        " ".join(normalize_text(x) for x in manifest.get("requested_actions", []) or []),
    ]
    return " ".join(parts)


def policy_screen(manifest: Dict[str, Any]) -> List[str]:
    blob = collect_intent_text(manifest)
    blocked = []
    for pat, label in PROHIBITED_PATTERNS:
        if pat.search(blob):
            blocked.append(label)
    return list(dict.fromkeys(blocked))


def has_internal_sensitive(manifest: Dict[str, Any]) -> bool:
    if manifest.get("internal_sales_data") or manifest.get("customer_data"):
        return True
    if manifest.get("price_books") or manifest.get("pipeline_data"):
        return True
    if manifest.get("confidential_competitor_material"):
        return True
    for m in manifest.get("market_metrics", []) or []:
        cls = normalize_text(m.get("data_classification", "")).upper()
        stype = normalize_text(m.get("source_type", "")).lower()
        if cls in INTERNAL_CLASSIFICATIONS or stype in {"internal_sales", "customer_database", "price_book", "pipeline"}:
            return True
    return False


def detect_mnpi(manifest: Dict[str, Any]) -> bool:
    if manifest.get("mnpi_candidate") is True:
        return True
    blob = collect_intent_text(manifest).lower()
    if re.search(r"\b(mnpi|material\s+non[- ]public\s+information|insider\s+information)\b", blob):
        return True
    for bucket in (
        "market_metrics",
        "sizing_estimates",
        "pricing_data",
        "demand_signals",
        "supply_signals",
        "competitors",
        "market_shares",
        "forecasts",
    ):
        for item in manifest.get(bucket, []) or []:
            if isinstance(item, dict) and item.get("mnpi_candidate") is True:
                return True
    return False


def authorization_check(manifest: Dict[str, Any]) -> Tuple[bool, List[str]]:
    auth = manifest.get("authorization") or {}
    reasons: List[str] = []

    if not auth.get("approved"):
        reasons.append("AUTHORIZATION_MISSING_OR_NOT_APPROVED")

    scope = auth.get("scope", "provided_records_only")
    if scope not in ALLOWED_SCOPES:
        reasons.append("UNSUPPORTED_SCOPE")

    model_mode = auth.get("model_mode", "LOCAL_ONLY")
    if model_mode == "CLOUD" and not auth.get("cloud_approved"):
        reasons.append("CLOUD_PROCESSING_NOT_APPROVED")

    if model_mode not in {"LOCAL_ONLY", "HYBRID", "CLOUD"}:
        reasons.append("UNKNOWN_MODEL_MODE")

    if has_internal_sensitive(manifest) and not auth.get("private_data_approved"):
        reasons.append("PRIVATE_OR_CONFIDENTIAL_MARKET_DATA_NOT_APPROVED")

    if detect_mnpi(manifest) and not auth.get("mnpi_review_approved"):
        reasons.append("MNPI_REVIEW_REQUIRED")

    return (len(reasons) == 0), reasons


# --------------------------------------------------------------------
# Sources / pedigree / independence
# --------------------------------------------------------------------

def collect_referenced_source_ids(obj: Any) -> Set[str]:
    ids: Set[str] = set()

    def walk(x: Any) -> None:
        if isinstance(x, dict):
            for k, v in x.items():
                if k in ("source_id", "source_ids"):
                    if isinstance(v, list):
                        ids.update(normalize_text(i) for i in v if normalize_text(i))
                    else:
                        s = normalize_text(v)
                        if s:
                            ids.add(s)
                walk(v)
        elif isinstance(x, list):
            for i in x:
                walk(i)

    walk(obj)
    return ids


def ingest_sources(manifest: Dict[str, Any]) -> Dict[str, Dict[str, Any]]:
    sources: Dict[str, Dict[str, Any]] = {}
    for s in manifest.get("sources", []) or []:
        sid = normalize_text(s.get("source_id"))
        if not sid:
            continue
        stype = normalize_text(s.get("source_type", "unknown")).lower()
        reliability = s.get("reliability")
        if reliability is None:
            reliability = SOURCE_RELIABILITY.get(stype, SOURCE_RELIABILITY["unknown"])
        sources[sid] = {
            "source_id": sid,
            "source_type": stype,
            "upstream_source_id": normalize_text(s.get("upstream_source_id")) or None,
            "reliability": clamp(float(reliability)),
            "observed_at": normalize_text(s.get("observed_at")) or None,
            "url": s.get("url"),
            "limitations": list(s.get("limitations", []) or []),
        }

    for sid in collect_referenced_source_ids(manifest):
        if sid not in sources:
            sources[sid] = {
                "source_id": sid,
                "source_type": "unknown",
                "upstream_source_id": None,
                "reliability": SOURCE_RELIABILITY["unknown"],
                "observed_at": None,
                "url": None,
                "limitations": ["Source referenced but not defined in manifest."],
            }
    return sources


def resolve_source_root(sid: str, sources: Dict[str, Dict[str, Any]], memo: Dict[str, str], visiting: Set[str]) -> str:
    if sid in memo:
        return memo[sid]
    if sid in visiting:
        return sid
    visiting.add(sid)
    src = sources.get(sid)
    if not src or not src.get("upstream_source_id"):
        memo[sid] = sid
        visiting.discard(sid)
        return sid
    root = resolve_source_root(src["upstream_source_id"], sources, memo, visiting)
    memo[sid] = root
    visiting.discard(sid)
    return root


def build_source_roots(sources: Dict[str, Dict[str, Any]]) -> Dict[str, str]:
    memo: Dict[str, str] = {}
    for sid in sources:
        resolve_source_root(sid, sources, memo, set())
    return memo


def source_family_ids(source_ids: List[str], source_roots: Dict[str, str]) -> List[str]:
    roots = []
    for sid in source_ids:
        roots.append(source_roots.get(sid, sid))
    return list(dict.fromkeys(roots))


def source_quality(source_ids: List[str], sources: Dict[str, Dict[str, Any]]) -> Tuple[float, float]:
    vals = [float(sources.get(sid, {}).get("reliability", SOURCE_RELIABILITY["unknown"])) for sid in source_ids]
    if not vals:
        return SOURCE_RELIABILITY["unknown"], SOURCE_RELIABILITY["unknown"]
    return max(vals), sum(vals) / len(vals)


def independence_state(families: List[str], sources: Dict[str, Dict[str, Any]], source_ids: List[str]) -> str:
    if not source_ids:
        return "UNKNOWN"
    if len(families) <= 1:
        return "DEPENDENT"
    types = {sources.get(sid, {}).get("source_type", "unknown") for sid in source_ids}
    rels = [sources.get(sid, {}).get("reliability", 0.3) for sid in source_ids]
    if len(types) == 1 and max(rels) < 0.70:
        return "PARTIALLY_DEPENDENT"
    if max(rels) >= 0.70:
        return "INDEPENDENT"
    return "PARTIALLY_DEPENDENT"


def collect_all_source_ids(*lists: Any) -> List[str]:
    ids = []
    for lst in lists:
        if not isinstance(lst, list):
            continue
        for item in lst:
            if isinstance(item, dict):
                ids.extend(source_list(item.get("source_ids", []), item.get("source_id")))
    return list(dict.fromkeys(ids))


def overall_source_independence(
    sources: Dict[str, Dict[str, Any]],
    source_roots: Dict[str, str],
    *lists: Any,
) -> Dict[str, Any]:
    ids = collect_all_source_ids(*lists)
    fams = source_family_ids(ids, source_roots)
    state = independence_state(fams, sources, ids)
    max_rel, avg_rel = source_quality(ids, sources)
    return {
        "source_ids": ids,
        "source_families": fams,
        "state": state,
        "max_reliability": round(max_rel, 4),
        "avg_reliability": round(avg_rel, 4),
        "limitations": [
            "Multiple articles/blogs quoting one market-research report are one evidence family.",
            "Independent sources can disagree; dependence does not automatically mean falsehood.",
        ],
    }


# --------------------------------------------------------------------
# Market definition / metrics / sizing
# --------------------------------------------------------------------

def ingest_market(manifest: Dict[str, Any]) -> Dict[str, Any]:
    md = manifest.get("market_definition") or manifest.get("market") or {}
    market_id = normalize_text(md.get("market_id") or md.get("id") or "MARKET-1")
    geographies = source_list(
        md.get("geographies"),
        md.get("geography"),
        md.get("regions"),
        md.get("countries"),
    )
    channels = source_list(md.get("channel_scope"), md.get("channels"))
    time_window = md.get("time_window") or {}
    currency = normalize_text(md.get("currency")).upper() or "UNKNOWN"
    unit = normalize_text(md.get("measurement_unit") or md.get("unit")) or "UNKNOWN"

    return {
        "market_id": market_id,
        "name": normalize_text(md.get("name")) or market_id,
        "definition": normalize_text(md.get("definition")) or None,
        "included_categories": source_list(md.get("included_categories"), md.get("in_scope_products")),
        "excluded_categories": source_list(md.get("excluded_categories"), md.get("out_of_scope_products")),
        "customer_scope": source_list(md.get("customer_scope"), md.get("in_scope_customers")),
        "geographies": geographies,
        "default_geography": geographies[0] if geographies else "GLOBAL",
        "channel_scope": channels,
        "time_window": {
            "start": normalize_text(time_window.get("start")) or None,
            "end": normalize_text(time_window.get("end")) or None,
            "raw": time_window,
        },
        "currency": currency,
        "measurement_unit": unit,
        "assumptions": source_list(md.get("assumptions")),
        "source_ids": source_list(md.get("source_ids"), md.get("source_id")),
        "confidence": clamp(float(md.get("confidence", 0.65))),
        "limitations": list(md.get("limitations", []) or []) + [
            "Industry classification is not market definition.",
            "Product category is not market; buyer need, substitutability, geography, and time matter.",
            "TAM is not expected revenue.",
        ],
    }


def ingest_metrics(manifest: Dict[str, Any], market: Dict[str, Any]) -> List[Dict[str, Any]]:
    out = []
    for idx, m in enumerate(manifest.get("market_metrics", []) or []):
        metric_id = normalize_text(m.get("metric_id") or m.get("id") or f"MET-{idx}")
        value = parse_float(m.get("value"))
        metric_type = norm_enum(m.get("metric_type"), METRIC_TYPES)
        currency = normalize_text(m.get("currency") or market.get("currency")).upper() or "UNKNOWN"
        unit = normalize_text(m.get("unit") or market.get("measurement_unit")) or "UNKNOWN"
        geography = normalize_text(m.get("geography") or m.get("region") or market.get("default_geography")) or "GLOBAL"
        period_start = parse_time(m.get("period_start") or m.get("start"))
        period_end = parse_time(m.get("period_end") or m.get("end") or m.get("year"))
        denominator = parse_float(m.get("denominator"))
        out.append({
            "metric_id": metric_id,
            "market_id": normalize_text(m.get("market_id")) or market.get("market_id"),
            "segment_id": normalize_text(m.get("segment_id")) or None,
            "geography": geography,
            "metric_type": metric_type,
            "value": value,
            "unit": unit,
            "currency": currency,
            "denominator": denominator,
            "period_start": period_start,
            "period_end": period_end,
            "method": normalize_text(m.get("method")) or None,
            "data_classification": normalize_text(m.get("data_classification")).upper() or None,
            "mnpi_candidate": bool(m.get("mnpi_candidate")),
            "source_ids": source_list(m.get("source_ids"), m.get("source_id")),
            "confidence": clamp(float(m.get("confidence", 0.65))),
            "limitations": list(m.get("limitations", []) or []) + [
                "Metric semantics must be preserved; revenue is not units, shipments are not sales.",
                "Reported estimate is not observed fact unless source/method supports it.",
            ],
        })
    return out


def ingest_sizing(manifest: Dict[str, Any], market: Dict[str, Any]) -> List[Dict[str, Any]]:
    out = []
    for idx, s in enumerate(manifest.get("sizing_estimates", []) or []):
        estimate_id = normalize_text(s.get("estimate_id") or s.get("id") or f"SIZE-{idx}")
        low = parse_float(s.get("value_low"))
        base = parse_float(s.get("value_base") or s.get("value"))
        high = parse_float(s.get("value_high"))
        derived_midpoint = False
        if base is None and low is not None and high is not None:
            base = round((low + high) / 2.0, 6)
            derived_midpoint = True
        method = norm_enum(s.get("method"), SIZING_METHODS)
        metric_type = norm_enum(s.get("metric_type"), METRIC_TYPES)
        currency = normalize_text(s.get("currency") or market.get("currency")).upper() or "UNKNOWN"
        unit = normalize_text(s.get("unit") or market.get("measurement_unit")) or "UNKNOWN"
        geography = normalize_text(s.get("geography") or market.get("default_geography")) or "GLOBAL"
        period_start = parse_time(s.get("period_start") or s.get("start"))
        period_end = parse_time(s.get("period_end") or s.get("end") or s.get("year"))
        out.append({
            "estimate_id": estimate_id,
            "market_id": normalize_text(s.get("market_id")) or market.get("market_id"),
            "segment_id": normalize_text(s.get("segment_id")) or None,
            "geography": geography,
            "method": method,
            "metric_type": metric_type,
            "value_low": low,
            "value_base": base,
            "value_high": high,
            "unit": unit,
            "currency": currency,
            "period_start": period_start,
            "period_end": period_end,
            "assumptions": source_list(s.get("assumptions")),
            "formula": normalize_text(s.get("formula")) or None,
            "derived_midpoint": derived_midpoint,
            "source_ids": source_list(s.get("source_ids"), s.get("source_id")),
            "confidence": clamp(float(s.get("confidence", 0.60))),
            "limitations": list(s.get("limitations", []) or []) + [
                "Market size is definition-dependent; changing boundary can materially change estimate.",
                "Do not average methods blindly; investigate methodology and definition differences.",
            ],
        })
    return out


def ingest_layer(manifest: Dict[str, Any], key: str, market: Dict[str, Any]) -> Optional[Dict[str, Any]]:
    obj = manifest.get(key)
    if not obj:
        return None
    low = parse_float(obj.get("value_low"))
    base = parse_float(obj.get("value_base") or obj.get("value"))
    high = parse_float(obj.get("value_high"))
    if base is None and low is not None and high is not None:
        base = round((low + high) / 2.0, 6)
    return {
        "layer": key.upper(),
        "market_id": normalize_text(obj.get("market_id")) or market.get("market_id"),
        "state": norm_enum(obj.get("state"), TAM_STATES),
        "method": norm_enum(obj.get("method"), SIZING_METHODS),
        "metric_type": norm_enum(obj.get("metric_type"), METRIC_TYPES),
        "value_low": low,
        "value_base": base,
        "value_high": high,
        "currency": normalize_text(obj.get("currency") or market.get("currency")).upper() or "UNKNOWN",
        "unit": normalize_text(obj.get("unit") or market.get("measurement_unit")) or "UNKNOWN",
        "period": normalize_text(obj.get("period")) or None,
        "assumptions": source_list(obj.get("assumptions")),
        "filters": obj.get("filters", {}) or {},
        "source_ids": source_list(obj.get("source_ids"), obj.get("source_id")),
        "confidence": clamp(float(obj.get("confidence", 0.55))),
        "limitations": list(obj.get("limitations", []) or []) + [
            "TAM is theoretically addressable demand under stated definition, not expected revenue.",
            "SAM applies capability/geography/customer/regulatory/channel constraints.",
            "SOM must reflect competition, distribution, capacity, pricing, and time; not arbitrary % of TAM.",
        ],
    }


def triangulate_sizing(estimates: List[Dict[str, Any]]) -> Dict[str, Any]:
    by_method: Dict[str, List[Dict[str, Any]]] = defaultdict(list)
    for e in estimates:
        if e.get("value_base") is not None:
            by_method[e.get("method", "UNKNOWN")].append(e)
    if not by_method:
        return {
            "state": "INSUFFICIENT_DATA",
            "methods": [],
            "ranges": [],
            "divergence": None,
            "limitations": ["No base sizing estimates with usable values were provided."],
        }

    ranges = []
    all_bases = []
    all_lows = []
    all_highs = []
    for method, es in sorted(by_method.items()):
        lows = [e["value_low"] for e in es if e.get("value_low") is not None]
        bases = [e["value_base"] for e in es if e.get("value_base") is not None]
        highs = [e["value_high"] for e in es if e.get("value_high") is not None]
        all_bases.extend(bases)
        all_lows.extend(lows)
        all_highs.extend(highs)
        ranges.append({
            "method": method,
            "estimate_count": len(es),
            "low": min(lows) if lows else None,
            "base_median": median(bases),
            "high": max(highs) if highs else None,
            "source_ids": collect_all_source_ids(es),
        })

    divergence = None
    if all_bases:
        denom = max(abs(max(all_bases)), abs(min(all_bases)), 1e-9)
        divergence = round((max(all_bases) - min(all_bases)) / denom, 4)

    return {
        "state": "TRIANGULATED" if len(by_method) >= 2 else "SINGLE_METHOD",
        "methods": sorted(by_method.keys()),
        "ranges": ranges,
        "combined_low": min(all_lows) if all_lows else (min(all_bases) if all_bases else None),
        "combined_base_median": median(all_bases),
        "combined_high": max(all_highs) if all_highs else (max(all_bases) if all_bases else None),
        "divergence": divergence,
        "limitations": [
            "Triangulation compares methods; it does not average away definition differences.",
            "Large divergence requires methodology/market-boundary investigation.",
        ],
    }


# --------------------------------------------------------------------
# Competitors / shares / pricing
# --------------------------------------------------------------------

def ingest_competitors(manifest: Dict[str, Any]) -> Tuple[Dict[str, Dict[str, Any]], List[Dict[str, Any]], List[Dict[str, Any]]]:
    competitors: Dict[str, Dict[str, Any]] = {}
    for idx, c in enumerate(manifest.get("competitors", []) or []):
        cid = normalize_text(c.get("competitor_id") or c.get("id") or c.get("company") or f"COMP-{idx}")
        competitors[cid] = {
            "competitor_id": cid,
            "legal_entity": normalize_text(c.get("legal_entity")) or None,
            "brand": normalize_text(c.get("brand")) or cid,
            "products": source_list(c.get("products")),
            "segments": source_list(c.get("segments")),
            "geographies": source_list(c.get("geographies"), c.get("geography")),
            "channels": source_list(c.get("channels")),
            "positioning": source_list(c.get("positioning")),
            "capabilities": source_list(c.get("capabilities")),
            "partnerships": source_list(c.get("partnerships")),
            "signals": source_list(c.get("signals")),
            "market_share_estimates": c.get("market_share_estimates", []) or [],
            "source_ids": source_list(c.get("source_ids"), c.get("source_id")),
            "confidence": clamp(float(c.get("confidence", 0.60))),
            "limitations": list(c.get("limitations", []) or []) + [
                "Brand is not legal company; resolve entity through CORPINT where material.",
                "Total company revenue is not market-specific revenue without segment evidence.",
                "Marketing claim is not demonstrated capability.",
            ],
        }

    relationships = []
    for idx, rel in enumerate(manifest.get("competitor_relationships", []) or []):
        cid = normalize_text(rel.get("competitor_id"))
        if not cid:
            continue
        relationships.append({
            "relationship_id": normalize_text(rel.get("relationship_id")) or stable_id("CREL", cid, idx),
            "competitor_id": cid,
            "market_id": normalize_text(rel.get("market_id")) or None,
            "segment_id": normalize_text(rel.get("segment_id")) or None,
            "relationship_type": norm_enum(rel.get("relationship_type"), COMPETITOR_RELATIONSHIPS),
            "overlap_evidence": normalize_text(rel.get("overlap_evidence")) or None,
            "source_ids": source_list(rel.get("source_ids"), rel.get("source_id")),
            "confidence": clamp(float(rel.get("confidence", 0.60))),
            "limitations": [
                "Direct competition requires material overlap in buyer, need, product, geography, and budget.",
                "Substitute can reduce demand without being same category.",
            ],
        })

    products = []
    for idx, p in enumerate(manifest.get("competitor_products", []) or []):
        products.append({
            "product_id": normalize_text(p.get("product_id") or p.get("id") or f"PROD-{idx}"),
            "competitor_id": normalize_text(p.get("competitor_id")) or None,
            "name": normalize_text(p.get("name")) or None,
            "category": normalize_text(p.get("category")) or None,
            "features": source_list(p.get("features")),
            "deployment": source_list(p.get("deployment")),
            "target_segments": source_list(p.get("target_segments")),
            "availability_state": norm_enum(p.get("availability_state"), {
                "ANNOUNCED", "BETA", "LIMITED_AVAILABILITY", "GENERAL_AVAILABILITY", "DISCONTINUED", "UNKNOWN"
            }),
            "source_ids": source_list(p.get("source_ids"), p.get("source_id")),
            "limitations": [
                "Feature present is not feature quality.",
                "Roadmap/announced capability is not currently available capability.",
            ],
        })

    return competitors, relationships, products


def ingest_market_shares(
    manifest: Dict[str, Any],
    metrics_by_id: Dict[str, Dict[str, Any]],
    competitors: Dict[str, Dict[str, Any]],
) -> List[Dict[str, Any]]:
    out = []
    for idx, sh in enumerate(manifest.get("market_shares", []) or []):
        cid = normalize_text(sh.get("competitor_id"))
        numer_id = normalize_text(sh.get("numerator_metric_id"))
        denom_id = normalize_text(sh.get("denominator_metric_id"))
        basis = norm_enum(sh.get("basis"), SHARE_BASES)
        reported_value = parse_float(sh.get("value"))
        computed_value = None
        formula = None
        calc_conflict = None

        numer = metrics_by_id.get(numer_id) if numer_id else None
        denom = metrics_by_id.get(denom_id) if denom_id else None
        if numer and denom and numer.get("value") is not None and denom.get("value") not in (None, 0):
            computed_value = round(numer["value"] / denom["value"], 6)
            formula = f"{numer_id} / {denom_id}"
            if reported_value is not None:
                rd = relative_diff(reported_value, computed_value)
                if rd is not None and rd > 0.01:
                    calc_conflict = {
                        "reported_value": reported_value,
                        "computed_value": computed_value,
                        "relative_difference": round(rd, 4),
                    }

        value = reported_value if reported_value is not None else computed_value
        period = normalize_text(sh.get("period")) or iso((denom or {}).get("period_end")) or None
        out.append({
            "share_id": normalize_text(sh.get("share_id")) or stable_id("SHARE", cid, basis, period, idx),
            "competitor_id": cid,
            "market_id": normalize_text(sh.get("market_id")) or None,
            "basis": basis,
            "value": value,
            "reported_value": reported_value,
            "computed_value": computed_value,
            "formula": formula,
            "numerator_metric_id": numer_id or None,
            "denominator_metric_id": denom_id or None,
            "period": period,
            "calculation_conflict": calc_conflict,
            "source_ids": source_list(sh.get("source_ids"), sh.get("source_id")),
            "confidence": clamp(float(sh.get("confidence", 0.55))),
            "limitations": list(sh.get("limitations", []) or []) + [
                "Market share requires compatible numerator/denominator scope, period, geography, unit, and metric.",
                "Market share is not profitability or competitive strength automatically.",
                "Private-company share estimates require labeled proxies and uncertainty.",
            ],
        })
        if cid and cid not in competitors:
            competitors[cid] = {
                "competitor_id": cid,
                "legal_entity": None,
                "brand": cid,
                "products": [],
                "segments": [],
                "geographies": [],
                "channels": [],
                "positioning": [],
                "capabilities": [],
                "partnerships": [],
                "signals": [],
                "market_share_estimates": [],
                "source_ids": source_list(sh.get("source_ids"), sh.get("source_id")),
                "confidence": 0.35,
                "limitations": ["Placeholder competitor inferred from share record; no company facts invented."],
            }
    return out


def compute_hhi(shares: List[Dict[str, Any]], basis: str = "REVENUE_SHARE") -> Optional[float]:
    vals = []
    for s in shares:
        if s.get("basis") != basis:
            continue
        p = to_percent_share(s.get("value"))
        if p is not None:
            vals.append(p)
    if not vals:
        return None
    return round(sum((v * v) for v in vals), 4)


def compute_top_n(shares: List[Dict[str, Any]], basis: str, n: int) -> Optional[float]:
    vals = []
    for s in shares:
        if s.get("basis") != basis:
            continue
        p = to_percent_share(s.get("value"))
        if p is not None:
            vals.append(p)
    if not vals:
        return None
    vals.sort(reverse=True)
    return round(sum(vals[:n]), 4)


def ingest_pricing(manifest: Dict[str, Any], market: Dict[str, Any]) -> List[Dict[str, Any]]:
    out = []
    for idx, p in enumerate(manifest.get("pricing_data", []) or manifest.get("pricing", []) or []):
        point_id = normalize_text(p.get("price_id") or p.get("id") or f"PRICE-{idx}")
        currency = normalize_text(p.get("currency") or market.get("currency")).upper() or "UNKNOWN"
        out.append({
            "price_id": point_id,
            "market_id": normalize_text(p.get("market_id")) or market.get("market_id"),
            "competitor_id": normalize_text(p.get("competitor_id")) or None,
            "product_id": normalize_text(p.get("product_id")) or None,
            "segment_id": normalize_text(p.get("segment_id")) or None,
            "geography": normalize_text(p.get("geography") or market.get("default_geography")) or "GLOBAL",
            "tier": normalize_text(p.get("tier")) or None,
            "price_type": norm_enum(p.get("price_type"), PRICING_TYPES),
            "list_price": parse_float(p.get("list_price")),
            "observed_contract_price": parse_float(p.get("observed_contract_price")),
            "estimated_realized_price": parse_float(p.get("estimated_realized_price")),
            "promotional_price": parse_float(p.get("promotional_price")),
            "currency": currency,
            "unit": normalize_text(p.get("unit")) or "UNKNOWN",
            "effective_date": parse_time(p.get("effective_date") or p.get("date")),
            "promotion_start": parse_time(p.get("promotion_start")),
            "promotion_end": parse_time(p.get("promotion_end")),
            "source_ids": source_list(p.get("source_ids"), p.get("source_id")),
            "confidence": clamp(float(p.get("confidence", 0.60))),
            "limitations": list(p.get("limitations", []) or []) + [
                "List price is not realized price.",
                "Promotional price is not normal price.",
                "Cheaper is not better value without capability/TCO/risk context.",
            ],
        })
    return out


def analyze_pricing(points: List[Dict[str, Any]]) -> Tuple[List[Dict[str, Any]], List[Dict[str, Any]]]:
    buckets: Dict[Tuple[str, Optional[str], str], List[float]] = defaultdict(list)
    discounts = []

    for p in points:
        cur = p.get("currency") or "UNKNOWN"
        tier = p.get("tier")
        for typ in ("list_price", "observed_contract_price", "estimated_realized_price", "promotional_price"):
            val = p.get(typ)
            if val is not None:
                buckets[(cur, tier, typ.upper())].append(float(val))

        lp = p.get("list_price")
        rp = p.get("estimated_realized_price") or p.get("observed_contract_price")
        if lp and rp and lp > 0:
            discounts.append({
                "price_id": p.get("price_id"),
                "competitor_id": p.get("competitor_id"),
                "product_id": p.get("product_id"),
                "currency": p.get("currency"),
                "list_price": lp,
                "realized_or_contract_price": rp,
                "discount_pct": round((lp - rp) / lp, 4),
                "note": "Discount is evidence-dependent and may reflect negotiation, bundling, promotion, or data quality.",
            })

    stats = []
    for (cur, tier, typ), vals in sorted(buckets.items()):
        stats.append({
            "currency": cur,
            "tier": tier,
            "price_type": typ,
            "count": len(vals),
            "min": round(min(vals), 6),
            "max": round(max(vals), 6),
            "mean": safe_mean(vals),
            "median": median(vals),
        })
    return stats, discounts


# --------------------------------------------------------------------
# Signals / customer intelligence / contexts / drivers
# --------------------------------------------------------------------

def ingest_signals(manifest: Dict[str, Any], buckets: Tuple[str, ...], kind: str) -> List[Dict[str, Any]]:
    allowed = DEMAND_SIGNAL_TYPES if kind == "DEMAND" else SUPPLY_SIGNAL_TYPES
    out = []
    for bucket in buckets:
        for idx, s in enumerate(manifest.get(bucket, []) or []):
            sid = normalize_text(s.get("signal_id") or s.get("id") or f"{kind}-{bucket}-{idx}")
            out.append({
                "signal_id": sid,
                "kind": kind,
                "market_id": normalize_text(s.get("market_id")) or None,
                "segment_id": normalize_text(s.get("segment_id")) or None,
                "geography": normalize_text(s.get("geography")) or None,
                "signal_type": norm_enum(s.get("signal_type"), allowed),
                "value": parse_float(s.get("value")),
                "unit": normalize_text(s.get("unit")) or None,
                "period_start": parse_time(s.get("period_start")),
                "period_end": parse_time(s.get("period_end")),
                "evidence_text": normalize_text(s.get("evidence_text") or s.get("description")) or None,
                "source_ids": source_list(s.get("source_ids"), s.get("source_id")),
                "confidence": clamp(float(s.get("confidence", 0.55))),
                "limitations": list(s.get("limitations", []) or []) + [
                    "Signal type matters: attention is not demand, shipment is not end-user sale, tender is not purchase.",
                ],
            })
    return out


def analyze_signals(signals: List[Dict[str, Any]], kind: str) -> Dict[str, Any]:
    counts = Counter(s.get("signal_type", "UNKNOWN") for s in signals)
    strongest = None
    if signals:
        strongest = max(
            signals,
            key=lambda s: (
                DEMAND_SIGNAL_WEIGHT.get(s.get("signal_type", "UNKNOWN"), 0.1) if kind == "DEMAND" else 0.5,
                s.get("confidence", 0.0),
            ),
        )
    return {
        "kind": kind,
        "count": len(signals),
        "type_counts": dict(counts),
        "strongest_signal_id": strongest.get("signal_id") if strongest else None,
        "strongest_signal_type": strongest.get("signal_type") if strongest else None,
        "limitations": [
            "Demand and supply signals are not interchangeable.",
            "Low-weight signals can support hypotheses but cannot alone prove market demand.",
        ],
    }


def ingest_items(manifest: Dict[str, Any], bucket: str, text_keys: Tuple[str, ...]) -> List[Dict[str, Any]]:
    out = []
    for idx, item in enumerate(manifest.get(bucket, []) or []):
        text = None
        for k in text_keys:
            v = normalize_text(item.get(k))
            if v:
                text = v
                break
        if not text and isinstance(item, str):
            text = item
        out.append({
            "item_id": normalize_text(item.get("id") if isinstance(item, dict) else None) or stable_id(bucket, idx, text),
            "text": text,
            "segment_id": normalize_text(item.get("segment_id")) if isinstance(item, dict) else None,
            "evidence_state": norm_enum(item.get("evidence_state") if isinstance(item, dict) else None, EVIDENCE_STATES),
            "source_ids": source_list(item.get("source_ids") if isinstance(item, dict) else None, item.get("source_id") if isinstance(item, dict) else None),
            "confidence": clamp(float(item.get("confidence", 0.55))) if isinstance(item, dict) else 0.45,
            "limitations": [
                "Inferred needs/pain points are hypotheses unless directly reported or multi-source supported.",
            ],
        })
    return out


def ingest_generic_context(manifest: Dict[str, Any], bucket: str) -> List[Dict[str, Any]]:
    out = []
    for idx, item in enumerate(manifest.get(bucket, []) or []):
        if not isinstance(item, dict):
            item = {"description": item}
        out.append({
            "context_id": normalize_text(item.get("id")) or stable_id(bucket, idx, item.get("description")),
            "type": bucket,
            "description": normalize_text(item.get("description") or item.get("text") or item.get("name")) or None,
            "sample_size": parse_int(item.get("sample_size")),
            "method": normalize_text(item.get("method")) or None,
            "population": normalize_text(item.get("population")) or None,
            "field_dates": normalize_text(item.get("field_dates")) or None,
            "response_rate": parse_float(item.get("response_rate")),
            "rating": parse_float(item.get("rating")),
            "volume": parse_int(item.get("volume")),
            "platform": normalize_text(item.get("platform")) or None,
            "source_ids": source_list(item.get("source_ids"), item.get("source_id")),
            "confidence": clamp(float(item.get("confidence", 0.50))),
            "limitations": list(item.get("limitations", []) or []) + [
                "Context-specific bias and coverage limitations must be preserved.",
            ],
        })
    return out


def ingest_drivers(manifest: Dict[str, Any]) -> List[Dict[str, Any]]:
    out = []
    mappings = [
        ("regulatory_drivers", "REGULATORY"),
        ("macro_drivers", "MACROECONOMIC"),
        ("technology_drivers", "TECHNOLOGY"),
        ("market_events", "EVENT"),
    ]
    for bucket, default_type in mappings:
        for idx, d in enumerate(manifest.get(bucket, []) or []):
            out.append({
                "driver_id": normalize_text(d.get("driver_id") or d.get("id") or f"DRV-{bucket}-{idx}"),
                "type": norm_enum(d.get("type"), DRIVER_TYPES, default_type),
                "description": normalize_text(d.get("description") or d.get("event") or d.get("name")) or None,
                "status": norm_enum(d.get("status"), DRIVER_STATUS),
                "effect": norm_enum(d.get("effect"), DRIVER_EFFECT),
                "effective_date": parse_time(d.get("effective_date")),
                "source_ids": source_list(d.get("source_ids"), d.get("source_id")),
                "confidence": clamp(float(d.get("confidence", 0.55))),
                "limitations": list(d.get("limitations", []) or []) + [
                    "Announced regulation is not effective regulation.",
                    "Macro correlation is not causation.",
                    "Technology capability is not adoption.",
                ],
            })
    return out


# --------------------------------------------------------------------
# Time series / growth / maturity / forecast
# --------------------------------------------------------------------

def build_time_series(metrics: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    groups: Dict[Tuple[Any, ...], List[Dict[str, Any]]] = defaultdict(list)
    for m in metrics:
        if m.get("value") is None or not m.get("period_end"):
            continue
        key = (
            m.get("market_id"),
            m.get("segment_id"),
            m.get("geography"),
            m.get("metric_type"),
            m.get("currency"),
            m.get("unit"),
        )
        groups[key].append(m)

    series = []
    for key, items in groups.items():
        items.sort(key=lambda x: x["period_end"])
        points = [
            {
                "metric_id": m["metric_id"],
                "period_end": iso(m.get("period_end")),
                "value": m.get("value"),
                "method": m.get("method"),
                "source_ids": m.get("source_ids", []),
            }
            for m in items
        ]
        yoy = []
        for prev, curr in zip(items, items[1:]):
            if prev.get("value") in (None, 0) or curr.get("value") is None:
                continue
            d = days_between(prev.get("period_end"), curr.get("period_end"))
            years = d / 365.25 if d and d > 0 else None
            growth = (curr["value"] - prev["value"]) / abs(prev["value"])
            annualized = None
            if years and years > 0 and growth > -1:
                try:
                    annualized = (1.0 + growth) ** (1.0 / years) - 1.0
                except Exception:
                    annualized = None
            yoy.append({
                "from_metric_id": prev["metric_id"],
                "to_metric_id": curr["metric_id"],
                "from_period": iso(prev.get("period_end")),
                "to_period": iso(curr.get("period_end")),
                "growth": round(growth, 6),
                "annualized_growth": round(annualized, 6) if annualized is not None else None,
                "years": round(years, 4) if years is not None else None,
            })

        cagr = None
        if len(items) >= 2:
            first, last = items[0], items[-1]
            d = days_between(first.get("period_end"), last.get("period_end"))
            years = d / 365.25 if d and d > 0 else None
            if (
                years is not None
                and years > 0
                and first.get("value") is not None
                and first["value"] > 0
                and last.get("value") is not None
                and last["value"] > 0
            ):
                cagr = round((last["value"] / first["value"]) ** (1.0 / years) - 1.0, 6)

        series.append({
            "series_id": stable_id("SERIES", *key),
            "market_id": key[0],
            "segment_id": key[1],
            "geography": key[2],
            "metric_type": key[3],
            "currency": key[4],
            "unit": key[5],
            "points": points,
            "yoy": yoy,
            "cagr": cagr,
            "latest_value": items[-1].get("value") if items else None,
            "limitations": [
                "CAGR is smoothed growth, not yearly path.",
                "Historical growth is not future growth without drivers/scenarios.",
                "Series are only comparable if market boundary, metric, geography, period, currency, and unit match.",
            ],
        })
    return series


def analyze_maturity(manifest: Dict[str, Any], series: List[Dict[str, Any]]) -> Dict[str, Any]:
    provided = norm_enum(manifest.get("market_maturity"), MATURITY_STAGES)
    candidates = []
    for s in series:
        c = s.get("cagr")
        if c is None:
            continue
        if c > 0.25:
            candidates.append("HIGH_GROWTH_CANDIDATE")
        elif c > 0.10:
            candidates.append("EARLY_GROWTH_CANDIDATE")
        elif c < -0.05:
            candidates.append("DECLINING_CANDIDATE")
        else:
            candidates.append("STABLE_OR_MATURING_CANDIDATE")
    return {
        "state": provided,
        "candidates": list(dict.fromkeys(candidates)),
        "limitations": [
            "Maturity requires penetration, competitor count, consolidation, pricing pressure, standardization, and replacement-demand evidence.",
            "Growth rate alone is not maturity determination.",
        ],
    }


def ingest_forecasts(manifest: Dict[str, Any], market: Dict[str, Any]) -> List[Dict[str, Any]]:
    out = []
    for idx, f in enumerate(manifest.get("forecasts", []) or []):
        low = parse_float(f.get("value_low"))
        base = parse_float(f.get("value_base") or f.get("value"))
        high = parse_float(f.get("value_high"))
        if base is None and low is not None and high is not None:
            base = round((low + high) / 2.0, 6)
        out.append({
            "forecast_id": normalize_text(f.get("forecast_id") or f.get("id") or f"FC-{idx}"),
            "market_id": normalize_text(f.get("market_id")) or market.get("market_id"),
            "segment_id": normalize_text(f.get("segment_id")) or None,
            "geography": normalize_text(f.get("geography") or market.get("default_geography")) or "GLOBAL",
            "method": norm_enum(f.get("method"), FORECAST_METHODS),
            "scenario": norm_enum(f.get("scenario"), SCENARIOS),
            "metric_type": norm_enum(f.get("metric_type"), METRIC_TYPES),
            "base_period": normalize_text(f.get("base_period")) or None,
            "horizon": normalize_text(f.get("horizon")) or None,
            "value_low": low,
            "value_base": base,
            "value_high": high,
            "currency": normalize_text(f.get("currency") or market.get("currency")).upper() or "UNKNOWN",
            "unit": normalize_text(f.get("unit") or market.get("measurement_unit")) or "UNKNOWN",
            "assumptions": source_list(f.get("assumptions")),
            "drivers": source_list(f.get("drivers")),
            "actual_value": parse_float(f.get("actual_value")),
            "source_ids": source_list(f.get("source_ids"), f.get("source_id")),
            "confidence": clamp(float(f.get("confidence", 0.45))),
            "limitations": list(f.get("limitations", []) or []) + [
                "Forecast is not fact.",
                "Scenario is not prediction.",
                "Mechanical CAGR extension is weak unless drivers justify it.",
            ],
        })
    return out


def validate_forecasts(forecasts: List[Dict[str, Any]]) -> Dict[str, Any]:
    errors = []
    abs_errors = []
    pct_errors = []
    for f in forecasts:
        actual = f.get("actual_value")
        pred = f.get("value_base")
        if actual is None or pred is None:
            continue
        ae = abs(actual - pred)
        abs_errors.append(ae)
        row = {
            "forecast_id": f.get("forecast_id"),
            "actual_value": actual,
            "forecast_base": pred,
            "absolute_error": round(ae, 6),
        }
        if actual != 0:
            pe = ae / abs(actual)
            pct_errors.append(pe)
            row["percentage_error"] = round(pe, 6)
        errors.append(row)

    return {
        "validated_count": len(errors),
        "mae": safe_mean(abs_errors),
        "mape": safe_mean(pct_errors) if pct_errors else None,
        "errors": errors,
        "limitations": [
            "MAPE behaves poorly near zero; choose metrics according to data.",
            "Backtest requires comparable historical actuals and unchanged market definition.",
        ],
    }


def ingest_sensitivity(manifest: Dict[str, Any]) -> List[Dict[str, Any]]:
    out = []
    for idx, s in enumerate(manifest.get("sensitivity_analysis", []) or []):
        impact = parse_float(s.get("output_impact") or s.get("impact"))
        out.append({
            "sensitivity_id": normalize_text(s.get("sensitivity_id") or s.get("id") or f"SENS-{idx}"),
            "input": normalize_text(s.get("input") or s.get("assumption")) or None,
            "low": parse_float(s.get("low")),
            "base": parse_float(s.get("base")),
            "high": parse_float(s.get("high")),
            "output_impact": impact,
            "target_metric": normalize_text(s.get("target_metric")) or None,
            "source_ids": source_list(s.get("source_ids"), s.get("source_id")),
            "limitations": [
                "Sensitivity identifies assumption leverage; it does not validate the assumption.",
            ],
        })
    out.sort(key=lambda x: abs(x.get("output_impact") or 0.0), reverse=True)
    return out


# --------------------------------------------------------------------
# Contradictions / hypotheses / ACH
# --------------------------------------------------------------------

def detect_contradictions(
    metrics: List[Dict[str, Any]],
    sizing: List[Dict[str, Any]],
    shares: List[Dict[str, Any]],
    pricing: List[Dict[str, Any]],
) -> List[Dict[str, Any]]:
    contr = []

    # Metric conflicts.
    groups: Dict[Tuple[Any, ...], List[Dict[str, Any]]] = defaultdict(list)
    for m in metrics:
        if m.get("value") is None:
            continue
        key = (
            m.get("market_id"),
            m.get("segment_id"),
            m.get("geography"),
            m.get("metric_type"),
            m.get("currency"),
            m.get("unit"),
            iso(m.get("period_start")),
            iso(m.get("period_end")),
        )
        groups[key].append(m)
    for key, items in groups.items():
        vals = [float(x["value"]) for x in items]
        if len(vals) < 2:
            continue
        vmin, vmax = min(vals), max(vals)
        denom = max(abs(vmax), abs(vmin), 1e-9)
        if (vmax - vmin) / denom > 0.05:
            contr.append({
                "contradiction_id": stable_id("CTR", "metric", *key),
                "type": "METRIC_VALUE_CONFLICT",
                "severity": "MATERIAL",
                "detail": f"Same metric definition has divergent values: {sorted(set(vals))}.",
                "items": [{"metric_id": x.get("metric_id"), "value": x.get("value"), "method": x.get("method"), "source_ids": x.get("source_ids", [])} for x in items],
                "possible_causes": [
                    "different market boundary",
                    "different methodology",
                    "revision/backfill",
                    "currency or unit mismatch",
                    "shipment vs sales confusion",
                    "data error",
                ],
            })

    # Sizing conflicts.
    sgroups: Dict[Tuple[Any, ...], List[Dict[str, Any]]] = defaultdict(list)
    for e in sizing:
        if e.get("value_base") is None:
            continue
        key = (
            e.get("market_id"),
            e.get("method"),
            e.get("metric_type"),
            e.get("currency"),
            e.get("unit"),
            iso(e.get("period_start")),
            iso(e.get("period_end")),
        )
        sgroups[key].append(e)
    for key, items in sgroups.items():
        vals = [float(x["value_base"]) for x in items]
        if len(vals) < 2:
            continue
        vmin, vmax = min(vals), max(vals)
        denom = max(abs(vmax), abs(vmin), 1e-9)
        if (vmax - vmin) / denom > 0.10:
            contr.append({
                "contradiction_id": stable_id("CTR", "sizing", *key),
                "type": "SIZING_METHOD_CONFLICT",
                "severity": "MATERIAL",
                "detail": f"Same sizing method/category has divergent base estimates: {sorted(set(vals))}.",
                "items": [{"estimate_id": x.get("estimate_id"), "value_base": x.get("value_base"), "source_ids": x.get("source_ids", [])} for x in items],
                "possible_causes": ["different multipliers", "different denominator", "stale source", "definition drift"],
            })

    # Share conflicts.
    shgroups: Dict[Tuple[Any, ...], List[Dict[str, Any]]] = defaultdict(list)
    for s in shares:
        if s.get("value") is None:
            continue
        key = (s.get("competitor_id"), s.get("market_id"), s.get("basis"), s.get("period"))
        shgroups[key].append(s)
    for key, items in shgroups.items():
        vals = [float(x["value"]) for x in items]
        if len(vals) < 2:
            continue
        vmin, vmax = min(vals), max(vals)
        denom = max(abs(vmax), abs(vmin), 1e-9)
        if (vmax - vmin) / denom > 0.05:
            contr.append({
                "contradiction_id": stable_id("CTR", "share", *key),
                "type": "MARKET_SHARE_CONFLICT",
                "severity": "MATERIAL",
                "detail": f"Same competitor/share basis/period has divergent share values: {sorted(set(vals))}.",
                "items": [{"share_id": x.get("share_id"), "value": x.get("value"), "source_ids": x.get("source_ids", [])} for x in items],
                "possible_causes": ["different denominator scope", "private revenue estimate", "segment vs total company confusion"],
            })

    # Price conflicts.
    pgroups: Dict[Tuple[Any, ...], List[Tuple[str, float]]] = defaultdict(list)
    for p in pricing:
        for typ in ("list_price", "observed_contract_price", "estimated_realized_price", "promotional_price"):
            val = p.get(typ)
            if val is None:
                continue
            key = (
                p.get("market_id"),
                p.get("competitor_id"),
                p.get("product_id"),
                p.get("tier"),
                p.get("currency"),
                typ.upper(),
                iso(p.get("effective_date")),
            )
            pgroups[key].append((p.get("price_id"), float(val)))
    for key, items in pgroups.items():
        vals = [v for _, v in items]
        if len(vals) < 2:
            continue
        vmin, vmax = min(vals), max(vals)
        denom = max(abs(vmax), abs(vmin), 1e-9)
        if (vmax - vmin) / denom > 0.05:
            contr.append({
                "contradiction_id": stable_id("CTR", "price", *key),
                "type": "PRICE_CONFLICT",
                "severity": "MATERIAL",
                "detail": f"Same price type/date/tier has divergent values: {sorted(set(vals))}.",
                "items": [{"price_id": pid, "value": val} for pid, val in items],
                "possible_causes": ["promotion", "different geography", "bundle", "currency", "list vs realized confusion", "data error"],
            })

    return unique_preserve(contr)


def build_hypotheses(
    series: List[Dict[str, Any]],
    metrics: List[Dict[str, Any]],
    demand_signals: List[Dict[str, Any]],
    supply_signals: List[Dict[str, Any]],
    pricing_stats: List[Dict[str, Any]],
    competitors: Dict[str, Dict[str, Any]],
    shares: List[Dict[str, Any]],
    forecasts: List[Dict[str, Any]],
    contradictions: List[Dict[str, Any]],
    source_indep: Dict[str, Any],
) -> List[Dict[str, Any]]:
    hyp: List[Dict[str, Any]] = []

    def add(subject_type: str, subject_id: str, category: str, statement: str,
            support: List[str], opposition: List[str], unknowns: List[str],
            falsification: List[str]) -> None:
        hyp.append({
            "hypothesis_id": stable_id("HYP", subject_type, subject_id, category, statement),
            "subject_type": subject_type,
            "subject_id": subject_id,
            "category": category,
            "statement": statement,
            "support": support,
            "opposition": opposition,
            "unknowns": unknowns,
            "falsification_conditions": falsification,
            "status": "CANDIDATE",
        })

    demand_counts = Counter(s.get("signal_type") for s in demand_signals)
    supply_counts = Counter(s.get("signal_type") for s in supply_signals)
    price_types = {s.get("price_type") for s in pricing_stats}

    for s in series:
        if s.get("metric_type") != "REVENUE" or s.get("cagr") is None:
            continue
        if s["cagr"] <= 0.05:
            continue
        sid = s["series_id"]
        unit_series = [
            x for x in series
            if x.get("market_id") == s.get("market_id")
            and x.get("segment_id") == s.get("segment_id")
            and x.get("geography") == s.get("geography")
            and x.get("metric_type") == "UNIT_VOLUME"
        ]
        unit_cagr = unit_series[0].get("cagr") if unit_series else None

        add("REVENUE_SERIES", sid, "NEW_ADOPTION",
            "Revenue growth may be driven by new customer/unit adoption.",
            [f"revenue_cagr={s.get('cagr')}"],
            ["Revenue can grow from price increases or category redefinition."],
            ["unit volume trend", "customer count trend", "penetration"],
            [f"Unit/customer series flat or declining while revenue rises. unit_cagr={unit_cagr}"])
        add("REVENUE_SERIES", sid, "PRICE_INFLATION",
            "Revenue growth may reflect price increases/inflation rather than real volume growth.",
            [f"revenue_cagr={s.get('cagr')}", "pricing intelligence available" if price_types else "no price evidence yet"],
            ["Unit growth is strong and price stable."],
            ["realized price trend", "nominal vs real basis"],
            ["Unit volume grows at similar rate and prices remain stable."])
        add("REVENUE_SERIES", sid, "CATEGORY_REDEFINITION",
            "Apparent growth may reflect widened market definition or included categories.",
            ["market boundary sensitivity is material"],
            ["definition remained constant and source methodology verified"],
            ["included/excluded category history"],
            ["Restating prior periods under current definition removes growth spike."])
        if demand_counts.get("TRADE_SHIPMENT", 0) > 0 and demand_counts.get("SALES", 0) == 0:
            add("REVENUE_SERIES", sid, "CHANNEL_INVENTORY",
                "Growth may reflect channel inventory/shipments rather than end-user sales.",
                ["shipment/trade signal present without sales signal"],
                ["sales/orders/usage signals corroborate demand"],
                ["channel inventory", "sell-through"],
                ["Sell-through data confirms end-user purchases."])
        if source_indep.get("state") != "INDEPENDENT":
            add("REVENUE_SERIES", sid, "SOURCE_DEPENDENCY",
                "Apparent corroboration may derive from dependent sources.",
                [f"source_independence={source_indep.get('state')}"],
                ["Independent government/transaction/procurement sources exist."],
                ["upstream source pedigree"],
                ["Independent primary sources confirm trend."])

    if demand_counts.get("SEARCH_INTEREST", 0) > 0 or demand_counts.get("SOCIAL_SENTIMENT", 0) > 0:
        add("DEMAND_SIGNALS", "ATTENTION", "ATTENTION_NOT_DEMAND",
            "Search/social interest may reflect attention, news, or controversy rather than purchase demand.",
            ["low-weight attention signals present"],
            ["sales/orders/procurement/usage signals corroborate"],
            ["conversion", "purchase intent quality"],
            ["Transaction or procurement evidence shows no corresponding demand."])

    if demand_counts.get("PROCUREMENT_TENDER", 0) > 0:
        add("DEMAND_SIGNALS", "PROCUREMENT", "INSTITUTIONAL_DEMAND_CANDIDATE",
            "Procurement tenders may indicate institutional demand, but tender is not purchase.",
            ["procurement tender signals present"],
            ["tenders may be exploratory, cancelled, or unfunded"],
            ["award", "contract", "deployment"],
            ["Awards/deployments do not follow tenders or budgets are withdrawn."])

    if demand_counts.get("JOB_POSTING", 0) > 0:
        add("SUPPLY_OR_CAPABILITY_SIGNALS", "JOB_POSTING", "CAPABILITY_INTENT_CANDIDATE",
            "Job postings may indicate hiring/capability intent, not completed expansion.",
            ["job posting signals present"],
            ["postings may remain unfilled or re-scoped"],
            ["hires", "product launches", "geographic expansion"],
            ["No hires/launches/expansion materialize."])

    if demand_counts.get("PATENT", 0) > 0 or demand_counts.get("ACADEMIC", 0) > 0:
        add("TECHNOLOGY_SIGNALS", "RESEARCH_IP", "TECHNOLOGY_MATURITY_CANDIDATE",
            "Patent/academic activity may indicate technical interest, not commercial adoption.",
            ["patent/academic signals present"],
            ["research may not become product or demand"],
            ["standards", "cost curves", "productization"],
            ["No productization or adoption evidence emerges."])

    if not competitors:
        add("COMPETITIVE_LANDSCAPE", "EMPTY", "WHITE_SPACE_DATA_INCOMPLETE",
            "Absence of identified competitors may indicate white space or incomplete data.",
            ["no competitor records provided"],
            ["coverage may be incomplete"],
            ["private entrants", "substitutes", "adjacent solutions"],
            ["Independent discovery reveals active competitors/substitutes."])

    if competitors and not shares:
        add("MARKET_SHARE", "MISSING", "PRIVATE_REVENUE_UNRESOLVED",
            "Market share may be unresolved due to missing private-company segment revenue or denominator.",
            [f"competitor_count={len(competitors)}", "share_records=0"],
            ["public filings or transaction data may resolve shares"],
            ["segment revenue", "denominator scope"],
            ["Independent segment revenue and denominator resolve shares."])

    for f in forecasts:
        fid = f["forecast_id"]
        if not f.get("assumptions") or f.get("method") == "MECHANICAL_CAGR":
            add("FORECAST", fid, "FORECAST_DRIVER_WEAK",
                "Forecast may be weak if it mechanically extends history without explicit drivers.",
                [f"method={f.get('method')}", f"assumptions_count={len(f.get('assumptions', []))}"],
                ["Driver-based or bottom-up model with validated inputs exists."],
                ["adoption", "price", "capacity", "regulation"],
                ["Backtest and driver sensitivity show robust range."])

    for c in contradictions:
        cid = c["contradiction_id"]
        add("CONTRADICTION", cid, "RESOLUTION",
            "Contradiction may be resolved by market-definition, methodology, period, currency, or metric-semantics reconciliation.",
            [c.get("type", "")],
            ["One source may simply be wrong"],
            ["primary transaction data", "audited filings", "definition history"],
            ["Authoritative independent source reconciles conflict."])

    return hyp[:2000]


def build_ach(hypotheses: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    matrix = []
    for h in hypotheses[:100]:
        matrix.append({
            "hypothesis_id": h["hypothesis_id"],
            "statement": h.get("statement"),
            "evidence_rows": [
                {
                    "evidence": "Diagnostic evidence required",
                    "state": "UNKNOWN",
                    "note": "Starter does not fetch live evidence; populate with authorized sources before decision use.",
                }
            ],
            "diagnostic_tests": h.get("falsification_conditions", []),
            "limitations": [
                "ACH should use evidence that differentiates hypotheses, not merely confirms preferred narrative.",
            ],
        })
    return matrix


# --------------------------------------------------------------------
# Gaps / actions / handoffs
# --------------------------------------------------------------------

def build_gaps(
    market: Dict[str, Any],
    metrics: List[Dict[str, Any]],
    sizing: List[Dict[str, Any]],
    triangulation: Dict[str, Any],
    tam: Optional[Dict[str, Any]],
    sam: Optional[Dict[str, Any]],
    som: Optional[Dict[str, Any]],
    competitors: Dict[str, Dict[str, Any]],
    shares: List[Dict[str, Any]],
    pricing_stats: List[Dict[str, Any]],
    demand_signals: List[Dict[str, Any]],
    supply_signals: List[Dict[str, Any]],
    surveys: List[Dict[str, Any]],
    reviews: List[Dict[str, Any]],
    forecasts: List[Dict[str, Any]],
    drivers: List[Dict[str, Any]],
    source_indep: Dict[str, Any],
    mnpi_detected: bool,
) -> List[Dict[str, Any]]:
    gaps = []

    if not market.get("definition"):
        gaps.append({
            "gap_id": stable_id("GAP", "definition"),
            "type": "MARKET_DEFINITION_UNRESOLVED",
            "importance": "HIGH",
            "recommended_source": "Explicit product/customer/geography/time/channel definition.",
            "specialist": "MARKETINT",
            "expected_information_value": "Prevent sizing on undefined boundary.",
        })

    if not market.get("included_categories") or not market.get("excluded_categories"):
        gaps.append({
            "gap_id": stable_id("GAP", "boundary"),
            "type": "MARKET_BOUNDARY_INCOMPLETE",
            "importance": "HIGH",
            "recommended_source": "Inclusion/exclusion criteria and boundary sensitivity.",
            "specialist": "MARKETINT",
            "expected_information_value": "Make estimate reproducible and comparable.",
        })

    if not metrics and not sizing:
        gaps.append({
            "gap_id": stable_id("GAP", "no_size"),
            "type": "MARKET_SIZE_UNRESOLVED",
            "importance": "HIGH",
            "recommended_source": "Government statistics, filings, procurement, trade, transaction, or transparent bottom-up inputs.",
            "specialist": "MARKETINT / FININT / TRADEINT / PROCUREMENTINT",
            "expected_information_value": "Enable defensible sizing.",
        })

    if triangulation.get("state") != "TRIANGULATED":
        gaps.append({
            "gap_id": stable_id("GAP", "triangulation"),
            "type": "SIZING_TRIANGULATION_INCOMPLETE",
            "importance": "HIGH" if sizing else "MEDIUM",
            "recommended_source": "Independent top-down and bottom-up/supply/demand methods.",
            "specialist": "MARKETINT",
            "expected_information_value": "Reduce single-method bias.",
        })

    for layer, obj in (("TAM", tam), ("SAM", sam), ("SOM", som)):
        if not obj:
            gaps.append({
                "gap_id": stable_id("GAP", layer.lower()),
                "type": f"{layer}_UNRESOLVED",
                "importance": "MEDIUM",
                "recommended_source": f"Explicit {layer} definition, filters, assumptions, and period.",
                "specialist": "MARKETINT",
                "expected_information_value": f"Prevent {layer} confusion.",
            })
        elif obj.get("state") in {"INSUFFICIENT_DATA", "UNKNOWN"}:
            gaps.append({
                "gap_id": stable_id("GAP", layer.lower(), "state"),
                "type": f"{layer}_STATE_UNRESOLVED",
                "importance": "MEDIUM",
                "recommended_source": "Methodology and source documentation.",
                "specialist": "MARKETINT",
                "expected_information_value": f"Clarify whether {layer} is reported, derived, modelled, or scenario-based.",
            })

    if source_indep.get("state") in {"DEPENDENT", "PARTIALLY_DEPENDENT", "UNKNOWN"}:
        gaps.append({
            "gap_id": stable_id("GAP", "source_independence"),
            "type": "SOURCE_INDEPENDENCE_UNRESOLVED",
            "importance": "HIGH",
            "recommended_source": "Upstream source pedigree, original datasets, filings, transaction data.",
            "specialist": "MARKETINT / DATAINT",
            "expected_information_value": "Prevent copied reports from being treated as independent corroboration.",
        })

    if competitors and not shares:
        gaps.append({
            "gap_id": stable_id("GAP", "shares"),
            "type": "MARKET_SHARE_UNRESOLVED",
            "importance": "HIGH",
            "recommended_source": "Segment filings, transaction data, procurement awards, channel sell-through, licensed provider data.",
            "specialist": "MARKETINT / FININT / CORPINT",
            "expected_information_value": "Avoid false competitive ranking.",
        })

    for s in shares:
        if s.get("value") is not None and not s.get("denominator_metric_id"):
            gaps.append({
                "gap_id": stable_id("GAP", "share_denominator", s["share_id"]),
                "type": "MARKET_SHARE_DENOMINATOR_UNCERTAIN",
                "importance": "HIGH",
                "recommended_source": "Compatible market denominator with same scope/period/unit.",
                "specialist": "MARKETINT",
                "expected_information_value": "Ensure share formula is apples-to-apples.",
            })

    price_types = {s.get("price_type") for s in pricing_stats}
    if "LIST_PRICE" in price_types and "ESTIMATED_REALIZED_PRICE" not in price_types and "OBSERVED_CONTRACT_PRICE" not in price_types:
        gaps.append({
            "gap_id": stable_id("GAP", "realized_price"),
            "type": "REALIZED_PRICE_UNKNOWN",
            "importance": "MEDIUM",
            "recommended_source": "Authorized contract evidence, public procurement prices, transaction data.",
            "specialist": "MARKETINT / PROCUREMENTINT",
            "expected_information_value": "Avoid list-price-based competitive conclusions.",
        })

    demand_types = {s.get("signal_type") for s in demand_signals}
    if demand_signals and demand_types <= LOW_WEIGHT_DEMAND_TYPES:
        gaps.append({
            "gap_id": stable_id("GAP", "demand_weak"),
            "type": "DEMAND_EVIDENCE_WEAK",
            "importance": "HIGH",
            "recommended_source": "Sales, orders, usage, subscriptions, procurement awards, transaction data.",
            "specialist": "MARKETINT",
            "expected_information_value": "Separate attention from demand.",
        })

    if supply_signals and not demand_signals:
        gaps.append({
            "gap_id": stable_id("GAP", "demand_missing"),
            "type": "DEMAND_SIGNALS_MISSING",
            "importance": "MEDIUM",
            "recommended_source": "Customer/sales/procurement/usage evidence.",
            "specialist": "MARKETINT",
            "expected_information_value": "Avoid supply-only market conclusion.",
        })

    for sv in surveys:
        if sv.get("description") and not sv.get("sample_size"):
            gaps.append({
                "gap_id": stable_id("GAP", "survey_sample", sv["context_id"]),
                "type": "SURVEY_METHODOLOGY_MISSING",
                "importance": "MEDIUM",
                "recommended_source": "Sample size, sampling method, population, field dates, response rate.",
                "specialist": "MARKET_RESEARCH",
                "expected_information_value": "Avoid unrepresentative survey claims.",
            })

    if reviews and not demand_types.intersection({"SALES", "ORDERS", "USAGE", "SUBSCRIPTIONS", "PROCUREMENT_TENDER"}):
        gaps.append({
            "gap_id": stable_id("GAP", "review_bias"),
            "type": "REVIEW_SELECTION_BIAS",
            "importance": "MEDIUM",
            "recommended_source": "Representative survey/transaction evidence.",
            "specialist": "MARKETINT",
            "expected_information_value": "Avoid treating reviews as representative demand.",
        })

    for f in forecasts:
        if not f.get("assumptions"):
            gaps.append({
                "gap_id": stable_id("GAP", "forecast_assumptions", f["forecast_id"]),
                "type": "FORECAST_ASSUMPTIONS_MISSING",
                "importance": "HIGH",
                "recommended_source": "Driver-based assumptions, scenario definitions, backtest.",
                "specialist": "MARKETINT",
                "expected_information_value": "Prevent forecast-as-fact.",
            })

    for d in drivers:
        if d.get("type") == "REGULATORY" and d.get("status") == "UNKNOWN":
            gaps.append({
                "gap_id": stable_id("GAP", "reg_status", d["driver_id"]),
                "type": "REGULATORY_STATUS_UNRESOLVED",
                "importance": "MEDIUM",
                "recommended_source": "Official regulation/standard text, effective date, transition period.",
                "specialist": "LEGALINT / REGULATORY",
                "expected_information_value": "Distinguish announced vs effective requirements.",
            })

    if mnpi_detected:
        gaps.append({
            "gap_id": stable_id("GAP", "mnpi"),
            "type": "MNPI_REVIEW_REQUIRED",
            "importance": "HIGH",
            "recommended_source": "Compliance/legal review before any use; restrict processing.",
            "specialist": "LEGALINT / COMPLIANCE",
            "expected_information_value": "Prevent insider trading or unlawful use.",
        })

    return gaps[:1000]


def build_next_actions(gaps: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    actions = []
    priority_map = {"HIGH": 0, "MEDIUM": 1, "LOW": 2}
    for g in gaps:
        t = g.get("type")
        if t == "MARKET_DEFINITION_UNRESOLVED":
            action = "Define product/customer/geography/time/channel boundary before sizing; do not use industry taxonomy as market automatically."
        elif t == "MARKET_BOUNDARY_INCOMPLETE":
            action = "Document inclusion/exclusion criteria and run boundary sensitivity."
        elif t == "MARKET_SIZE_UNRESOLVED":
            action = "Retrieve authorized public statistics, filings, procurement, trade, or transparent bottom-up inputs."
        elif t == "SIZING_TRIANGULATION_INCOMPLETE":
            action = "Add independent top-down and bottom-up/supply/demand methods; investigate divergence."
        elif t.endswith("_UNRESOLVED") and any(x in t for x in ("TAM", "SAM", "SOM")):
            action = f"Specify {t.split('_')[0]} definition, filters, assumptions, period, and method."
        elif t == "SOURCE_INDEPENDENCE_UNRESOLVED":
            action = "Trace source pedigree to original datasets; do not count copied reports as independent estimates."
        elif t == "MARKET_SHARE_UNRESOLVED":
            action = "Resolve competitor segment revenue and compatible denominator before ranking shares."
        elif t == "MARKET_SHARE_DENOMINATOR_UNCERTAIN":
            action = "Verify share denominator scope, period, geography, metric, and unit."
        elif t == "REALIZED_PRICE_UNKNOWN":
            action = "Use authorized contract/procurement/transaction evidence; do not solicit confidential pricing deceptively."
        elif t == "DEMAND_EVIDENCE_WEAK":
            action = "Seek sales/orders/usage/procurement/transaction evidence; treat search/social as attention only."
        elif t == "DEMAND_SIGNALS_MISSING":
            action = "Add demand-side evidence before concluding market attractiveness."
        elif t == "SURVEY_METHODOLOGY_MISSING":
            action = "Retrieve survey sample size, method, population, field dates, and response rate."
        elif t == "REVIEW_SELECTION_BIAS":
            action = "Corroborate review themes with representative surveys or transaction evidence."
        elif t == "FORECAST_ASSUMPTIONS_MISSING":
            action = "Replace mechanical CAGR with driver-based scenarios and explicit assumptions."
        elif t == "REGULATORY_STATUS_UNRESOLVED":
            action = "Verify official regulation status, effective date, transition, and enforcement."
        elif t == "MNPI_REVIEW_REQUIRED":
            action = "Escalate to compliance/legal; restrict processing and do not use for trading."
        else:
            action = "Gather additional authorized market evidence."

        actions.append({
            "action": action,
            "gap_id": g.get("gap_id"),
            "priority": g.get("importance", "MEDIUM"),
            "expected_information_value": g.get("expected_information_value"),
            "prohibited_alternatives": [
                "Do not steal trade secrets or access private competitor systems.",
                "Do not use stolen credentials, phishing, impersonation, bribery, or blackmail.",
                "Do not use MNPI for trading or facilitate insider trading.",
                "Do not coordinate prices, bids, customers, territories, production, or cartels.",
                "Do not fabricate market data, sales, share, demand, or forecasts.",
            ],
        })
    actions.sort(key=lambda x: priority_map.get(x.get("priority", "LOW"), 9))
    return actions[:300]


def build_handoffs(
    market: Dict[str, Any],
    competitors: Dict[str, Dict[str, Any]],
    shares: List[Dict[str, Any]],
    pricing: List[Dict[str, Any]],
    demand_signals: List[Dict[str, Any]],
    supply_signals: List[Dict[str, Any]],
    contexts: Dict[str, List[Dict[str, Any]]],
    drivers: List[Dict[str, Any]],
    hhi: Optional[float],
    mnpi_detected: bool,
    internal_sensitive: bool,
) -> List[Dict[str, Any]]:
    hands = []
    seen = set()

    def add(spec: str, reason: str, payload: Dict[str, Any]) -> None:
        key = (spec, json_safe(payload))
        if key in seen:
            return
        seen.add(key)
        hands.append({"specialist": spec, "reason": reason, "payload": payload})

    if competitors or shares:
        add("CORPINT / OWNERSHIPINT", "Legal entity, brand, subsidiary, M&A, and ownership resolution may be material.", {
            "competitor_ids": list(competitors.keys())[:100],
        })
    if contexts.get("financial_data"):
        add("FININT", "Detailed financial statement analysis requires finance specialist.", {
            "context_count": len(contexts.get("financial_data", [])),
        })
    if contexts.get("trade_data") or any(s.get("signal_type") == "TRADE_SHIPMENT" for s in demand_signals + supply_signals):
        add("TRADEINT", "Import/export/shipment flow analysis requires trade specialist.", {
            "signal_count": sum(1 for s in demand_signals + supply_signals if s.get("signal_type") == "TRADE_SHIPMENT"),
        })
    if contexts.get("procurement_data") or any(s.get("signal_type") == "PROCUREMENT_TENDER" for s in demand_signals):
        add("PROCUREMENTINT", "Tender/RFP/contract award analysis requires procurement specialist.", {
            "signal_count": sum(1 for s in demand_signals if s.get("signal_type") == "PROCUREMENT_TENDER"),
        })
    if supply_signals or contexts.get("supply_chain_context"):
        add("SUPPLYCHAININT", "Capacity/vendor dependency/resilience requires supply-chain specialist.", {
            "supply_signal_count": len(supply_signals),
        })
    if contexts.get("academic_data") or any(s.get("signal_type") == "ACADEMIC" for s in demand_signals):
        add("ACADEMICINT", "Research ecosystem/publication trend analysis requires academic specialist.", {
            "context_count": len(contexts.get("academic_data", [])),
        })
    if contexts.get("patent_data") or any(s.get("signal_type") == "PATENT" for s in demand_signals):
        add("TECHINT / IP_SPECIALIST", "Patent/technical capability analysis requires technology/IP specialist.", {
            "context_count": len(contexts.get("patent_data", [])),
        })
    if hhi is not None and hhi >= 2500:
        add("LEGALINT / COMPETITION_COUNSEL", "High concentration may raise competition-law questions; concentration is not collusion.", {
            "hhi": hhi,
            "market_id": market.get("market_id"),
        })
    if mnpi_detected:
        add("LEGALINT / COMPLIANCE", "MNPI candidate requires compliance/legal review and restricted handling.", {
            "market_id": market.get("market_id"),
        })
    if internal_sensitive:
        add("PRIVACY_REVIEW / DATA_GOVERNANCE", "Internal/confidential market data requires purpose limitation and access controls.", {
            "market_id": market.get("market_id"),
        })
    if pricing:
        add("PRICING_STRATEGY / LEGALINT", "Pricing strategy conclusions may require legal review to avoid antitrust-sensitive coordination.", {
            "pricing_point_count": len(pricing),
        })
    return hands


# --------------------------------------------------------------------
# Graph memory
# --------------------------------------------------------------------

class GraphMemory:
    def __init__(self) -> None:
        self.nodes: List[Dict[str, Any]] = []
        self.edges: List[Dict[str, Any]] = []
        self._node_ids: Set[str] = set()

    def add_node(self, node_type: str, node_id: str, properties: Optional[Dict[str, Any]] = None) -> None:
        if not node_id or node_id in self._node_ids:
            return
        self._node_ids.add(node_id)
        self.nodes.append({"type": node_type, "id": node_id, "properties": properties or {}})

    def add_edge(self, from_id: str, to_id: str, edge_type: str, properties: Optional[Dict[str, Any]] = None) -> None:
        if not from_id or not to_id:
            return
        self.edges.append({
            "from": from_id,
            "to": to_id,
            "type": edge_type,
            "properties": properties or {},
        })

    def to_dict(self) -> Dict[str, Any]:
        return {
            "nodes": self.nodes[:3000],
            "edges": self.edges[:6000],
            "note": "Market graph preserves definitions, estimates, source dependence, uncertainty, and assumptions. It does not prove market size, share, demand, or forecast.",
        }


def build_graph_memory(
    market: Dict[str, Any],
    metrics: List[Dict[str, Any]],
    sizing: List[Dict[str, Any]],
    tam: Optional[Dict[str, Any]],
    sam: Optional[Dict[str, Any]],
    som: Optional[Dict[str, Any]],
    competitors: Dict[str, Dict[str, Any]],
    relationships: List[Dict[str, Any]],
    products: List[Dict[str, Any]],
    shares: List[Dict[str, Any]],
    pricing: List[Dict[str, Any]],
    demand_signals: List[Dict[str, Any]],
    supply_signals: List[Dict[str, Any]],
    drivers: List[Dict[str, Any]],
    forecasts: List[Dict[str, Any]],
    contradictions: List[Dict[str, Any]],
    hypotheses: List[Dict[str, Any]],
    gaps: List[Dict[str, Any]],
    sources: Dict[str, Dict[str, Any]],
) -> GraphMemory:
    g = GraphMemory()
    mid = market.get("market_id")
    g.add_node("Market", mid, {
        "name": market.get("name"),
        "definition": market.get("definition"),
        "currency": market.get("currency"),
        "unit": market.get("measurement_unit"),
    })

    for geo in market.get("geographies", []) or []:
        g.add_node("Geography", geo, {})
        g.add_edge(mid, geo, "SERVES_GEOGRAPHY", {})
    for seg in market.get("customer_scope", []) or []:
        g.add_node("CustomerSegment", seg, {})
        g.add_edge(mid, seg, "TARGETS_SEGMENT", {})
    for cat in market.get("included_categories", []) or []:
        g.add_node("ProductCategory", cat, {"scope": "INCLUDED"})
        g.add_edge(mid, cat, "PART_OF_MARKET", {})
    for cat in market.get("excluded_categories", []) or []:
        g.add_node("ProductCategory", cat, {"scope": "EXCLUDED"})
        g.add_edge(mid, cat, "EXCLUDED_FROM_MARKET", {})

    for m in metrics:
        g.add_node("Metric", m["metric_id"], {
            "metric_type": m.get("metric_type"),
            "value": m.get("value"),
            "currency": m.get("currency"),
            "unit": m.get("unit"),
            "period_end": iso(m.get("period_end")),
        })
        g.add_edge(m["metric_id"], mid, "MEASURES_MARKET", {})
        for sid in m.get("source_ids", []) or []:
            g.add_node("Source", sid, {"source_type": sources.get(sid, {}).get("source_type")})
            g.add_edge(m["metric_id"], sid, "SUPPORTED_BY_SOURCE", {})

    for e in sizing:
        g.add_node("SizingEstimate", e["estimate_id"], {
            "method": e.get("method"),
            "value_base": e.get("value_base"),
            "currency": e.get("currency"),
        })
        g.add_edge(e["estimate_id"], mid, "ESTIMATES_MARKET_SIZE", {})

    for layer in (tam, sam, som):
        if layer:
            lid = f"{layer['layer']}:{mid}"
            g.add_node(layer["layer"], lid, {
                "state": layer.get("state"),
                "value_base": layer.get("value_base"),
                "currency": layer.get("currency"),
            })
            g.add_edge(lid, mid, "LAYER_OF_MARKET", {})

    for cid, c in competitors.items():
        g.add_node("Competitor", cid, {
            "brand": c.get("brand"),
            "legal_entity": c.get("legal_entity"),
        })
        g.add_edge(cid, mid, "COMPETES_IN", {})
    for rel in relationships:
        cid = rel.get("competitor_id")
        if cid:
            g.add_edge(cid, rel.get("market_id") or mid, rel.get("relationship_type", "UNKNOWN"), {
                "relationship_id": rel.get("relationship_id"),
            })
    for p in products:
        pid = p.get("product_id")
        cid = p.get("competitor_id")
        if pid:
            g.add_node("Product", pid, {"name": p.get("name"), "availability_state": p.get("availability_state")})
        if cid and pid:
            g.add_edge(cid, pid, "OFFERS_PRODUCT", {})

    for s in shares:
        sid = s["share_id"]
        g.add_node("MarketShare", sid, {
            "basis": s.get("basis"),
            "value": s.get("value"),
            "period": s.get("period"),
        })
        if s.get("competitor_id"):
            g.add_edge(s["competitor_id"], sid, "HAS_MARKET_SHARE", {})
        if s.get("denominator_metric_id"):
            g.add_edge(sid, s["denominator_metric_id"], "USES_DENOMINATOR", {})

    for p in pricing:
        pid = p["price_id"]
        g.add_node("PricePoint", pid, {
            "price_type": p.get("price_type"),
            "list_price": p.get("list_price"),
            "estimated_realized_price": p.get("estimated_realized_price"),
            "currency": p.get("currency"),
        })
        if p.get("competitor_id"):
            g.add_edge(p["competitor_id"], pid, "PRICED_AT", {})

    for sig in demand_signals + supply_signals:
        g.add_node("Signal", sig["signal_id"], {
            "kind": sig.get("kind"),
            "signal_type": sig.get("signal_type"),
            "value": sig.get("value"),
        })
        g.add_edge(sig["signal_id"], mid, "SIGNAL_FOR_MARKET", {})

    for d in drivers:
        g.add_node("Driver", d["driver_id"], {
            "type": d.get("type"),
            "status": d.get("status"),
            "effect": d.get("effect"),
        })
        g.add_edge(d["driver_id"], mid, "AFFECTS_MARKET", {})

    for f in forecasts:
        g.add_node("Forecast", f["forecast_id"], {
            "method": f.get("method"),
            "scenario": f.get("scenario"),
            "value_base": f.get("value_base"),
        })
        g.add_edge(f["forecast_id"], mid, "FORECASTS_MARKET", {})

    for c in contradictions[:500]:
        g.add_node("Contradiction", c["contradiction_id"], {"type": c.get("type"), "severity": c.get("severity")})
    for h in hypotheses[:500]:
        g.add_node("Hypothesis", h["hypothesis_id"], {"category": h.get("category"), "statement": h.get("statement")})
    for gap in gaps[:500]:
        g.add_node("Gap", gap["gap_id"], {"type": gap.get("type"), "importance": gap.get("importance")})

    return g


def dual_ai_review_stub(
    contradictions: List[Dict[str, Any]],
    hypotheses: List[Dict[str, Any]],
    gaps: List[Dict[str, Any]],
    source_indep: Dict[str, Any],
    forecasts: List[Dict[str, Any]],
) -> Dict[str, Any]:
    review = {
        "status": "INSUFFICIENT_EVIDENCE",
        "primary_conclusions": [],
        "skeptic_challenges": [],
        "comparison": "NO_SECOND_MODEL_CONFIGURED",
        "notes": [
            "This starter does not call an independent second model.",
            "AI agreement is not market corroboration.",
            "Human review is required for consequential investment, market entry, pricing, antitrust, or public financial guidance decisions.",
        ],
    }
    if contradictions:
        review["primary_conclusions"].append(f"{len(contradictions)} market contradiction candidate(s) detected.")
        review["skeptic_challenges"].append("Contradictions may be definition, methodology, period, currency, metric-semantics, or revision differences.")
    if source_indep.get("state") != "INDEPENDENT":
        review["primary_conclusions"].append("Source independence is not fully established.")
        review["skeptic_challenges"].append("Do not count multiple articles quoting one market report as independent estimates.")
    if any(h.get("category") in {"PRICE_INFLATION", "CHANNEL_INVENTORY", "ATTENTION_NOT_DEMAND"} for h in hypotheses):
        review["primary_conclusions"].append("Alternative explanations for growth/demand remain active.")
        review["skeptic_challenges"].append("Separate revenue growth from unit growth, price effects, channel inventory, and attention signals.")
    if forecasts:
        review["primary_conclusions"].append(f"{len(forecasts)} forecast record(s) present; forecasts are not facts.")
        review["skeptic_challenges"].append("Require explicit drivers, scenarios, ranges, and backtest before decision use.")
    if review["primary_conclusions"]:
        review["status"] = "PARTIAL_AGREEMENT"
    return review


