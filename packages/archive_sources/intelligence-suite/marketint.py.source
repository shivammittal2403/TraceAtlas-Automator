PROHIBITED_PATTERNS: List[Tuple[re.Pattern[str], str]] = [
    (
        re.compile(
            r"(?i)\b(steal|exfiltrate|acquire|obtain|copy|download|lift)\s+"
            r"(trade\s+secret|confidential\s+customer\s+data|private\s+competitor\s+data|price\s+book|pipeline|customer\s+database)\b"
        ),
