        re.compile(
            r"(?i)\b(use|leverate|login\s+with|authenticate\s+with)\s+"
            r"(stolen|leaked|shared|borrowed)\s+(credential|password|token|api\s+key|cookie|vpn)\b"
        ),
        "STOLEN_CREDENTIAL_USE",
    ),
    (
        re.compile(
            r"(?i)\b(phish|social[- ]engineer|impersonate|pretend\s+to\s+be|masquerade)\s+"
            r"(competitor\s+employee|customer|vendor|insider|buyer|procurement)\b"
        ),
        "PHISHING_OR_SOCIAL_ENGINEERING",
    ),
    (
        re.compile(
            r"(?i)\b(bribe|blackmail|coerce|pay\s+off|induce)\s+"
            r"(insider|employee|source|customer|vendor|procurement\s+official)\b"
        ),
        "BRIBERY_OR_COERCION",
    ),
    (
        re.compile(
            r"(?i)\b(use|trade\s+on|act\s+on|profit\s+from)\s+"
            r"(mnpi|material\s+non[- ]public\s+information|insider\s+information)\b"
        ),
        "MNPI_OR_INSIDER_TRADING",
    ),
    (
        re.compile(
            r"(?i)\b(manipulat\w*\s+(securities|stock|market)|pump[- ]and[- ]dump|spoof|layering|wash\s+trade|spread\s+false\s+(market\s+)?information)\b"
        ),
        "SECURITIES_MARKET_MANIPULATION",
    ),
    (
        re.compile(
