        "MARKET_DATA_FABRICATION",
    ),
    (
        re.compile(
            r"(?i)\b(publish|spread|circulate)\s+(false|defamatory|misleading)\s+"
            r"(allegation|claim|statement|report)\s+(about|against|on)\s+(competitor|company|firm)\b"
        ),
        "DEFAMATORY_OR_FALSE_MARKET_CLAIM",
    ),
    (
        re.compile(
            r"(?i)\b(deceptive|undercover|covert)\s+(customer\s+research|survey|interview|call)\b.*"
            r"\b(confidential|protected|trade\s+secret|pricing)\b"
        ),
        "DECEPTIVE_CONFIDENTIAL_RESEARCH",
    ),
]

