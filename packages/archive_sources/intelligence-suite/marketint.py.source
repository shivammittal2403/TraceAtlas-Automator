def compute_source_bias(sources: Dict[str, Dict[str, Any]]) -> List[Dict[str, Any]]:
    out = []
    for sid, src in sources.items():
        st = normalize_text(src.get("source_type", "unknown")).lower()
        bias = []
        if st in {"market_research_provider", "industry_association", "analyst_commentary"}:
            bias.append("commercial/association bias; methodology may be opaque or sales-driven")
        if st in {"company_website", "company_filing"}:
            bias.append("self-reporting/marketing bias; segment scope may differ from market")
        if st in {"review_platform", "social_media"}:
            bias.append("selection/vocal-user bias; not representative demand")
        if st in {"survey"}:
            bias.append("sampling/question-wording/response-rate bias")
        if st in {"marketplace"}:
            bias.append("platform visibility/listing bias; listings are not sales")
        if st in {"government_statistics", "regulator", "audited_filing", "transaction_data"}:
            bias.append("coverage/definition bias; still requires market-boundary alignment")
        out.append({
            "source_id": sid,
            "source_type": st,
            "potential_bias": bias,
            "limitations": src.get("limitations", []),
        })
    return out


def analyze_adoption_penetration(metrics: List[Dict[str, Any]], signals: List[Dict[str, Any]]) -> Tuple[Dict[str, Any], List[Dict[str, Any]]]:
    adoption_types = {"USAGE", "SUBSCRIPTIONS", "INSTALLATIONS", "ACTIVE_USERS", "SEATS"}
    adoption_signals = [s for s in signals if s.get("signal_type") in adoption_types]
    penetration = []
    for m in metrics:
        if m.get("value") is not None and m.get("denominator") not in (None, 0):
            penetration.append({
                "metric_id": m["metric_id"],
                "market_id": m.get("market_id"),
                "segment_id": m.get("segment_id"),
                "geography": m.get("geography"),
                "metric_type": m.get("metric_type"),
                "numerator": m.get("value"),
                "denominator": m.get("denominator"),
                "penetration": round(m["value"] / m["denominator"], 6),
                "period_end": iso(m.get("period_end")),
                "limitations": ["Penetration denominator must be explicitly defined and compatible."],
            })
    return {
        "signal_count": len(adoption_signals),
        "signal_types": dict(Counter(s.get("signal_type") for s in adoption_signals)),
        "limitations": [
            "Adoption is not retention.",
            "Downloads/traffic/awareness are not paid use or renewal.",
        ],
    }, penetration


def finalize_status(
    result: Dict[str, Any],
    market: Dict[str, Any],
    metrics: List[Dict[str, Any]],
    sizing: List[Dict[str, Any]],
    auth_ok: bool,
    policy_blocked: List[str],
    mnpi_detected: bool,
) -> str:
    if policy_blocked:
        return "POLICY_BLOCKED"
    if not auth_ok:
        return "BLOCKED_PERMISSION"
    if not market.get("definition"):
        return "MARKET_DEFINITION_UNRESOLVED"
    if not metrics and not sizing:
        return "MARKET_SIZE_UNRESOLVED"
    if result.get("contradictions"):
        return "PARTIAL"
    if any(g.get("importance") == "HIGH" for g in result.get("knowledge_gaps", [])):
        return "PARTIAL"
    if mnpi_detected:
        return "HUMAN_REVIEW_REQUIRED"
    if result.get("knowledge_gaps"):
        return "PARTIAL"
    return "SUCCEEDED"


def analyze_marketint_manifest(manifest: Dict[str, Any]) -> Dict[str, Any]:
    result = empty_result(manifest)

    policy_blocked = policy_screen(manifest)
    if policy_blocked:
        result["status"] = "POLICY_BLOCKED"
        result["violations"] = policy_blocked
        result["limitations"] = [
            "MARKETINT does not steal trade secrets, access private competitor systems, use stolen credentials, phish/impersonate/bribe/blackmail, use MNPI for trading, manipulate markets, coordinate collusion, or fabricate market data."
        ]
        return result

    auth_ok, auth_reasons = authorization_check(manifest)
    mnpi_detected = detect_mnpi(manifest)
    internal_sensitive = has_internal_sensitive(manifest)
    if not auth_ok:
        result["status"] = "BLOCKED_PERMISSION"
        result["limitations"] = auth_reasons
        return result

    sources = ingest_sources(manifest)
    source_roots = build_source_roots(sources)

    market = ingest_market(manifest)
    metrics = ingest_metrics(manifest, market)
    metrics_by_id = {m["metric_id"]: m for m in metrics}
    sizing = ingest_sizing(manifest, market)
    tam = ingest_layer(manifest, "tam", market)
    sam = ingest_layer(manifest, "sam", market)
    som = ingest_layer(manifest, "som", market)
    triangulation = triangulate_sizing(sizing)

    competitors, relationships, products = ingest_competitors(manifest)
    shares = ingest_market_shares(manifest, metrics_by_id, competitors)
    hhi = compute_hhi(shares, "REVENUE_SHARE")
    if hhi is None:
        hhi = compute_hhi(shares, "UNIT_SHARE")
    top3 = compute_top_n(shares, "REVENUE_SHARE", 3)
    if top3 is None:
        top3 = compute_top_n(shares, "UNIT_SHARE", 3)
    top5 = compute_top_n(shares, "REVENUE_SHARE", 5)
    if top5 is None:
        top5 = compute_top_n(shares, "UNIT_SHARE", 5)

    pricing_points = ingest_pricing(manifest, market)
    pricing_stats, discounts = analyze_pricing(pricing_points)

    demand_signals = ingest_signals(manifest, ("demand_signals", "demand_signal_data"), "DEMAND")
    supply_signals = ingest_signals(manifest, ("supply_signals", "supply_signal_data"), "SUPPLY")
    demand_summary = analyze_signals(demand_signals, "DEMAND")
    supply_summary = analyze_signals(supply_signals, "SUPPLY")

    needs = ingest_items(manifest, "customer_needs", ("need", "description", "text"))
    pain_points = ingest_items(manifest, "pain_points", ("pain_point", "description", "text"))
    purchase_criteria = ingest_items(manifest, "purchase_criteria", ("criterion", "description", "text"))
    switching_factors = ingest_items(manifest, "switching_factors", ("factor", "description", "text"))

    surveys = ingest_generic_context(manifest, "survey_data")
    reviews = ingest_generic_context(manifest, "review_data")
    search_interest = ingest_generic_context(manifest, "search_interest_data")
    web_traffic = ingest_generic_context(manifest, "web_traffic_data")
    job_postings = ingest_generic_context(manifest, "job_posting_data")
    patents = ingest_generic_context(manifest, "patent_data")
    academic = ingest_generic_context(manifest, "academic_data")
    procurement = ingest_generic_context(manifest, "procurement_data")
    trade = ingest_generic_context(manifest, "trade_data")
    financial = ingest_generic_context(manifest, "financial_data")
    contexts = {
        "survey_data": surveys,
        "review_data": reviews,
        "search_interest_data": search_interest,
        "web_traffic_data": web_traffic,
        "job_posting_data": job_postings,
        "patent_data": patents,
        "academic_data": academic,
        "procurement_data": procurement,
        "trade_data": trade,
        "financial_data": financial,
    }

    drivers = ingest_drivers(manifest)
    series = build_time_series(metrics)
    maturity = analyze_maturity(manifest, series)
    forecasts = ingest_forecasts(manifest, market)
    forecast_validation = validate_forecasts(forecasts)
    scenarios = manifest.get("scenarios", []) or []
    sensitivities = ingest_sensitivity(manifest)
    adoption, penetration = analyze_adoption_penetration(metrics, demand_signals + supply_signals)

    source_indep = overall_source_independence(
        sources,
        source_roots,
        metrics,
        sizing,
        [tam, sam, som],
        list(competitors.values()),
        relationships,
        products,
        shares,
        pricing_points,
        demand_signals,
        supply_signals,
        drivers,
        forecasts,
        [market],
    )

    contradictions = detect_contradictions(metrics, sizing, shares, pricing_points)
    hypotheses = build_hypotheses(
        series, metrics, demand_signals, supply_signals, pricing_stats,
        competitors, shares, forecasts, contradictions, source_indep
    )
    ach = build_ach(hypotheses)
    gaps = build_gaps(
        market, metrics, sizing, triangulation, tam, sam, som,
        competitors, shares, pricing_stats, demand_signals, supply_signals,
        surveys, reviews, forecasts, drivers, source_indep, mnpi_detected
    )
    actions = build_next_actions(gaps)
    handoffs = build_handoffs(
        market, competitors, shares, pricing_points, demand_signals,
        supply_signals, contexts, drivers, hhi, mnpi_detected, internal_sensitive
    )
    graph = build_graph_memory(
        market, metrics, sizing, tam, sam, som, competitors, relationships,
        products, shares, pricing_points, demand_signals, supply_signals,
        drivers, forecasts, contradictions, hypotheses, gaps, sources
    )
    dual_review = dual_ai_review_stub(contradictions, hypotheses, gaps, source_indep, forecasts)

    observations = [
        f"Market definition ingested: {bool(market.get('definition'))}.",
        f"Market metrics ingested: {len(metrics)}.",
        f"Sizing estimates ingested: {len(sizing)}; methods={triangulation.get('methods', [])}.",
        f"TAM/SAM/SOM present: tam={bool(tam)}, sam={bool(sam)}, som={bool(som)}.",
        f"Competitors ingested: {len(competitors)}; relationships={len(relationships)}; products={len(products)}.",
        f"Market shares ingested: {len(shares)}; HHI={hhi}.",
        f"Pricing points ingested: {len(pricing_points)}; stats={len(pricing_stats)}; discounts={len(discounts)}.",
        f"Demand signals: {len(demand_signals)}; supply signals: {len(supply_signals)}.",
        f"Time series built: {len(series)}.",
        f"Forecasts ingested: {len(forecasts)}; validated={forecast_validation.get('validated_count', 0)}.",
        f"Contradiction candidates: {len(contradictions)}.",
        f"Competing hypotheses: {len(hypotheses)}.",
        "No trade-secret theft, private system access, stolen credentials, phishing, impersonation, bribery, blackmail, MNPI trading, market manipulation, collusion, or data fabrication was performed.",
        "Market definition precedes sizing; TAM is not expected revenue; SOM is not arbitrary % of TAM.",
        "Revenue, units, customers, shipments, install base, bookings, and GMV semantics are preserved separately.",
        "Attention signals are not treated as demand.",
        "Forecasts are labeled as scenarios/estimates, not facts.",
    ]

    unknowns = []
    if not market.get("definition"):
        unknowns.append("Market definition unresolved.")
    if not sizing:
        unknowns.append("Market size unresolved.")
    if triangulation.get("state") != "TRIANGULATED":
        unknowns.append("Market size triangulation incomplete.")
    if competitors and not shares:
        unknowns.append("Market share unresolved.")
    if source_indep.get("state") != "INDEPENDENT":
        unknowns.append("Source independence unresolved.")
    if forecasts:
        unknowns.append("Forecast outcomes remain uncertain and assumption-dependent.")
    unknowns.append("Private-company segment revenue may remain unknown without authorized primary evidence.")
    result["unknowns"] = list(dict.fromkeys(unknowns))[:500]

    result["market"] = market
    result["market_definition"] = market.get("definition")
    result["market_boundaries"] = {
        "included_categories": market.get("included_categories", []),
        "excluded_categories": market.get("excluded_categories", []),
        "customer_scope": market.get("customer_scope", []),
        "geographies": market.get("geographies", []),
        "channel_scope": market.get("channel_scope", []),
        "time_window": market.get("time_window", {}),
    }
    result["included_categories"] = market.get("included_categories", [])
    result["excluded_categories"] = market.get("excluded_categories", [])
    result["geographies"] = market.get("geographies", [])
    result["customer_segments"] = market.get("customer_scope", [])
    result["product_segments"] = market.get("included_categories", [])
    result["channels"] = market.get("channel_scope", [])
    result["market_metrics"] = metrics
    result["tam"] = tam
    result["sam"] = sam
    result["som"] = som
    result["sizing_methods"] = sorted({e.get("method") for e in sizing if e.get("method")})
    result["top_down_estimates"] = [e for e in sizing if e.get("method") == "TOP_DOWN"]
    result["bottom_up_estimates"] = [e for e in sizing if e.get("method") == "BOTTOM_UP"]
    result["supply_side_estimates"] = [e for e in sizing if e.get("method") == "SUPPLY_SIDE"]
    result["demand_side_estimates"] = [e for e in sizing if e.get("method") == "DEMAND_SIDE"]
    result["triangulated_market_size"] = triangulation
    result["market_size_range"] = {
        "low": triangulation.get("combined_low"),
        "base": triangulation.get("combined_base_median"),
        "high": triangulation.get("combined_high"),
        "currency": market.get("currency"),
        "unit": market.get("measurement_unit"),
    }
    result["historical_growth"] = series
    result["yoy_growth"] = [g for s in series for g in s.get("yoy", [])]
    result["cagr"] = [{"series_id": s["series_id"], "metric_type": s.get("metric_type"), "cagr": s.get("cagr")} for s in series if s.get("cagr") is not None]
    result["market_maturity"] = maturity
    result["adoption"] = adoption
    result["penetration"] = penetration
    result["competitors"] = list(competitors.values())
    result["direct_competitors"] = [r for r in relationships if r.get("relationship_type") == "DIRECT"]
    result["indirect_competitors"] = [r for r in relationships if r.get("relationship_type") == "INDIRECT"]
    result["substitutes"] = [r for r in relationships if r.get("relationship_type") == "SUBSTITUTE"]
    result["competitor_products"] = products
    result["market_shares"] = shares
    result["market_share_basis"] = sorted({s.get("basis") for s in shares if s.get("basis")})
    result["pricing"] = pricing_stats
    result["price_history"] = pricing_points
    result["discount_context"] = discounts
    result["tco_context"] = manifest.get("tco_context", []) or []
    result["customer_needs"] = needs
    result["pain_points"] = pain_points
    result["purchase_criteria"] = purchase_criteria
    result["switching_factors"] = switching_factors
    result["reviews_context"] = reviews
    result["survey_context"] = surveys
    result["search_interest_context"] = search_interest
    result["web_traffic_context"] = web_traffic
    result["job_posting_signals"] = [s for s in demand_signals if s.get("signal_type") == "JOB_POSTING"] + job_postings
    result["patent_signals"] = [s for s in demand_signals if s.get("signal_type") == "PATENT"] + patents
    result["academic_signals"] = [s for s in demand_signals if s.get("signal_type") == "ACADEMIC"] + academic
    result["procurement_demand"] = [s for s in demand_signals if s.get("signal_type") == "PROCUREMENT_TENDER"] + procurement
    result["trade_signals"] = [s for s in demand_signals + supply_signals if s.get("signal_type") == "TRADE_SHIPMENT"] + trade
    result["distribution"] = manifest.get("distribution_data", []) or []
    result["partner_ecosystem"] = manifest.get("partnerships", []) or []
    result["market_concentration"] = {
        "hhi": hhi,
        "top3_share": top3,
        "top5_share": top5,
        "share_count": len(shares),
        "limitations": [
            "HHI and top-n shares require compatible share basis and denominator coverage.",
            "Concentration is not collusion.",
        ],
    }
    result["hhi"] = hhi
    result["entry_barriers"] = manifest.get("entry_barriers", []) or []
    result["exit_barriers"] = manifest.get("exit_barriers", []) or []
    result["technology_drivers"] = [d for d in drivers if d.get("type") == "TECHNOLOGY"]
    result["regulatory_drivers"] = [d for d in drivers if d.get("type") == "REGULATORY"]
    result["macro_drivers"] = [d for d in drivers if d.get("type") == "MACROECONOMIC"]
    result["seasonality"] = {
        "state": "NOT_COMPUTED",
        "notes": "Seasonality requires multiple comparable cycles and consistent definitions.",
    }
    result["trends"] = series
    result["market_events"] = [d for d in drivers if d.get("type") == "EVENT"]
    result["adjacent_markets"] = manifest.get("adjacent_markets", []) or []
    result["white_space_candidates"] = manifest.get("white_space_candidates", []) or []
    if not competitors and not result["white_space_candidates"]:
        result["white_space_candidates"].append({
            "candidate_id": stable_id("WS", "no_competitors"),
            "statement": "No competitors provided; possible white space or incomplete coverage.",
            "state": "UNKNOWN",
            "limitations": ["Absence of known competitors is not proof of white space."],
        })
    result["scenarios"] = scenarios
    result["forecasts"] = forecasts
    result["forecast_ranges"] = [
        {
            "forecast_id": f["forecast_id"],
            "scenario": f.get("scenario"),
            "low": f.get("value_low"),
            "base": f.get("value_base"),
            "high": f.get("value_high"),
            "currency": f.get("currency"),
            "unit": f.get("unit"),
        }
        for f in forecasts
    ]
    result["forecast_metrics"] = forecast_validation
    result["sensitivity_analysis"] = sensitivities
    result["uncertainty_drivers"] = [
        {"input": s.get("input"), "output_impact": s.get("output_impact")}
        for s in sensitivities
    ] + [
        {"gap_id": g.get("gap_id"), "type": g.get("type"), "importance": g.get("importance")}
        for g in gaps if g.get("importance") == "HIGH"
    ]
    result["timeline_updates"] = [
        {"series_id": s["series_id"], "points": s.get("points", [])}
        for s in series
    ]
    result["observations"] = observations
    result["source_independence"] = source_indep
    result["contradictions"] = contradictions
    result["hypotheses"] = hypotheses
    result["ach_matrix"] = ach
    result["falsification_results"] = [
        {
            "hypothesis_id": h["hypothesis_id"],
            "category": h.get("category"),
            "opposition": h.get("opposition", []),
            "falsification_conditions": h.get("falsification_conditions", []),
        }
        for h in hypotheses
    ]
    result["knowledge_gaps"] = gaps
    result["recommended_next_actions"] = actions
    result["specialist_handoffs"] = handoffs
    result["dual_ai_review"] = dual_review
    result["graph_memory"] = graph.to_dict()

    for sid, src in sources.items():
        result["source_ids"].append(sid)
        result["source_reliability"].append({
            "source_id": sid,
            "source_type": src.get("source_type"),
            "reliability": src.get("reliability"),
        })
        result["source_limitations"].append({
            "source_id": sid,
            "limitations": src.get("limitations", []),
        })
        result["source_pedigree"].append({
            "source_id": sid,
            "upstream_source_id": src.get("upstream_source_id"),
            "root_source_id": source_roots.get(sid, sid),
        })
    result["source_bias"] = compute_source_bias(sources)

    for e in sizing:
        result["estimates"].append({
            "estimate_id": e["estimate_id"],
            "kind": "SIZING",
            "method": e.get("method"),
            "value_base": e.get("value_base"),
            "currency": e.get("currency"),
            "state": "ESTIMATED",
        })
    for f in forecasts:
        result["estimates"].append({
            "estimate_id": f["forecast_id"],
            "kind": "FORECAST",
            "method": f.get("method"),
            "scenario": f.get("scenario"),
            "value_base": f.get("value_base"),
            "currency": f.get("currency"),
            "state": "FORECAST",
        })

    if market.get("definition"):
        result["supported_facts"].append({
            "market_id": market.get("market_id"),
            "statement": "Market definition was explicitly provided in authorized manifest.",
        })
    for m in metrics:
        if m.get("value") is not None:
            result["candidate_facts"].append({
                "metric_id": m["metric_id"],
                "statement": f"Source reports {m.get('metric_type')} = {m.get('value')} {m.get('currency') or ''} {m.get('unit') or ''} for period {iso(m.get('period_end'))}.",
            })
    for c in contradictions:
        result["disputed_facts"].append({
            "contradiction_id": c["contradiction_id"],
            "statement": c.get("detail", "Market contradiction candidate."),
        })

    base_limits = [
        "MARKETINT starter uses only provided/local authorized records; no live search, private system access, or credential use was performed.",
        "Market definition must precede sizing; industry/category labels are not market definitions.",
        "TAM is not expected revenue; SAM is not SOM; SOM is not arbitrary percentage of TAM.",
        "Revenue is not units; shipments are not sales; install base is not annual sales; bookings are not revenue; GMV is not platform revenue.",
        "Total company revenue is not market-specific revenue without segment evidence.",
        "Search interest, social sentiment, website traffic, app downloads, job postings, patents, and academic activity are signals, not direct demand.",
        "List price is not realized price; promotional price is not normal price.",
        "Reviews and surveys require methodology and bias context.",
        "Forecasts and scenarios are not facts.",
        "Market concentration is not collusion.",
        "Multiple reports quoting one source are one evidence family.",
        "No trade-secret theft, competitor infiltration, phishing, impersonation, bribery, blackmail, MNPI trading, market manipulation, collusion, or fabrication was performed.",
    ]
    if auth_reasons:
        base_limits.extend(auth_reasons)
    if mnpi_detected:
        base_limits.append("MNPI candidate detected; processing restricted and compliance/legal review required.")
    if internal_sensitive:
        base_limits.append("Internal/confidential market data requires purpose limitation, access control, and no external cloud export without approval.")
    result["limitations"] = list(dict.fromkeys(base_limits))

    result["status"] = finalize_status(result, market, metrics, sizing, auth_ok, policy_blocked, mnpi_detected)
    return result


# --------------------------------------------------------------------
# Report generation
# --------------------------------------------------------------------

def generate_report(result: Dict[str, Any]) -> str:
    lines = []
    lines.append("# MARKETINT Evidence-Linked Market Intelligence Report")
    lines.append("")
    lines.append(f"- Case ID: `{result.get('case_id')}`")
    lines.append(f"- Task ID: `{result.get('task_id')}`")
    lines.append(f"- Generated: `{result.get('generated_at')}`")
    lines.append(f"- Version: `{result.get('version')}`")
    lines.append(f"- Status: `{result.get('status')}`")
    lines.append("")

    if result.get("status") == "POLICY_BLOCKED":
        lines.append("## POLICY BLOCKED")
        lines.append("The request violated MARKETINT hard restrictions:")
        for v in result.get("violations", []):
            lines.append(f"- `{v}`")
        lines.append("")
        lines.append("No market intelligence was performed.")
        return "\n".join(lines)

    lines.append("## Objective")
    lines.append(str(result.get("objective", "")))
    lines.append("")

    lines.append("## Required Analyst Summary")
    for s in result.get("observations", [])[:100]:
        lines.append(f"- {s}")
    lines.append("")

    lines.append("## Lawful / Competition / Privacy Boundaries")
    lines.append("- No trade-secret theft, private competitor system access, stolen credentials, phishing, impersonation, bribery, or blackmail.")
    lines.append("- No MNPI use for trading, insider trading facilitation, securities manipulation, or false market information.")
    lines.append("- No price fixing, bid rigging, customer/territory allocation, production coordination, or cartel facilitation.")
    lines.append("- Market definition first; TAM ≠ expected revenue; SAM ≠ SOM.")
    lines.append("- Revenue ≠ units; shipments ≠ sales; list price ≠ realized price; attention ≠ demand.")
    lines.append("- Forecast ≠ fact; scenario ≠ prediction; concentration ≠ collusion.")
    lines.append("")

    market = result.get("market", {})
    lines.append("## Market Definition")
    lines.append(f"- Market ID: `{market.get('market_id')}`")
    lines.append(f"- Name: `{market.get('name')}`")
    lines.append(f"- Definition: {market.get('definition')}")
    lines.append(f"- Currency/unit: `{market.get('currency')}` / `{market.get('measurement_unit')}`")
    lines.append(f"- Geographies: {', '.join(market.get('geographies', [])[:30]) or 'None'}")
    lines.append(f"- Customer scope: {', '.join(market.get('customer_scope', [])[:30]) or 'None'}")
    lines.append(f"- Included categories: {', '.join(market.get('included_categories', [])[:30]) or 'None'}")
    lines.append(f"- Excluded categories: {', '.join(market.get('excluded_categories', [])[:30]) or 'None'}")
    lines.append(f"- Channel scope: {', '.join(market.get('channel_scope', [])[:30]) or 'None'}")
    lines.append(f"- Time window: `{json.dumps(market.get('time_window', {}), ensure_ascii=False, default=str)}`")
    lines.append("")

    lines.append("## Market Sizing / TAM / SAM / SOM")
    tri = result.get("triangulated_market_size", {})
    lines.append(f"- Triangulation state: `{tri.get('state')}`")
    lines.append(f"- Methods: `{tri.get('methods', [])}`")
    lines.append(f"- Combined range: low=`{tri.get('combined_low')}` base=`{tri.get('combined_base_median')}` high=`{tri.get('combined_high')}`")
    lines.append(f"- Divergence: `{tri.get('divergence')}`")
    for r in tri.get("ranges", [])[:100]:
        lines.append(f"  - `{r.get('method')}` count={r.get('estimate_count')} low={r.get('low')} base_median={r.get('base_median')} high={r.get('high')}")
    for layer in ("tam", "sam", "som"):
        obj = result.get(layer)
        if obj:
            lines.append(f"- {layer.upper()}: state=`{obj.get('state')}` method=`{obj.get('method')}` base=`{obj.get('value_base')}` currency=`{obj.get('currency')}` assumptions={obj.get('assumptions', [])[:10]}")
        else:
            lines.append(f"- {layer.upper()}: not provided")
    lines.append("")

    lines.append("## Market Metrics / Historical Growth")
    for m in result.get("market_metrics", [])[:300]:
        lines.append(f"- Metric `{m.get('metric_id')}` type=`{m.get('metric_type')}` value=`{m.get('value')}` currency=`{m.get('currency')}` unit=`{m.get('unit')}` geography=`{m.get('geography')}` period_end=`{m.get('period_end')}` method=`{m.get('method')}`")
    for s in result.get("historical_growth", [])[:200]:
        lines.append(f"- Series `{s.get('series_id')}` type=`{s.get('metric_type')}` cagr=`{s.get('cagr')}` latest=`{s.get('latest_value')}`")
        for y in s.get("yoy", [])[:20]:
            lines.append(f"  - YoY {y.get('from_period')} → {y.get('to_period')}: growth={y.get('growth')} annualized={y.get('annualized_growth')}")
    lines.append("")

    lines.append("## Competitors / Products / Relationships")
    for c in result.get("competitors", [])[:200]:
        lines.append(f"### `{c.get('competitor_id')}`")
        lines.append(f"- Brand/legal entity: `{c.get('brand')}` / `{c.get('legal_entity')}`")
        lines.append(f"- Products: {', '.join(c.get('products', [])[:20]) or 'None'}")
        lines.append(f"- Segments: {', '.join(c.get('segments', [])[:20]) or 'None'}")
        lines.append(f"- Channels: {', '.join(c.get('channels', [])[:20]) or 'None'}")
        lines.append(f"- Positioning: {', '.join(c.get('positioning', [])[:20]) or 'None'}")
    for rel in result.get("direct_competitors", []) + result.get("indirect_competitors", []) + result.get("substitutes", [])[:200]:
        lines.append(f"- Relationship `{rel.get('relationship_id')}` competitor=`{rel.get('competitor_id')}` type=`{rel.get('relationship_type')}` evidence={rel.get('overlap_evidence')}")
    for p in result.get("competitor_products", [])[:200]:
        lines.append(f"- Product `{p.get('product_id')}` competitor=`{p.get('competitor_id')}` availability=`{p.get('availability_state')}` features={p.get('features', [])[:10]}")
    lines.append("")

    lines.append("## Market Share / Concentration")
    conc = result.get("market_concentration", {})
    lines.append(f"- HHI: `{conc.get('hhi')}` top3=`{conc.get('top3_share')}` top5=`{conc.get('top5_share')}`")
    for s in result.get("market_shares", [])[:300]:
        lines.append(f"- Share `{s.get('share_id')}` competitor=`{s.get('competitor_id')}` basis=`{s.get('basis')}` value=`{s.get('value')}` computed=`{s.get('computed_value')}` formula=`{s.get('formula')}` period=`{s.get('period')}`")
        if s.get("calculation_conflict"):
            lines.append(f"  - calculation conflict: `{json.dumps(s['calculation_conflict'], ensure_ascii=False, default=str)}`")
    lines.append("")

    lines.append("## Pricing / Discounts / TCO")
    for stat in result.get("pricing", [])[:200]:
        lines.append(f"- Price stat currency=`{stat.get('currency')}` tier=`{stat.get('tier')}` type=`{stat.get('price_type')}` count={stat.get('count')} min={stat.get('min')} median={stat.get('median')} max={stat.get('max')}")
    for d in result.get("discount_context", [])[:200]:
        lines.append(f"- Discount `{d.get('price_id')}` list={d.get('list_price')} realized/contract={d.get('realized_or_contract_price')} discount_pct={d.get('discount_pct')}")
    for t in result.get("tco_context", [])[:100]:
        lines.append(f"- TCO context: `{json.dumps(t, ensure_ascii=False, default=str)}`"[:500])
    lines.append("")

    lines.append("## Demand / Supply / Adoption / Penetration")
    lines.append(f"- Demand summary: `{json.dumps(result.get('adoption', {}), ensure_ascii=False, default=str)}`"[:1000])
    # Actually demand summary not stored separately; reconstruct from signals? We'll list signals.
    for s in result.get("procurement_demand", [])[:100]:
        lines.append(f"- Procurement signal `{s.get('signal_id') or s.get('context_id')}` type=`{s.get('signal_type') or 'PROCUREMENT_CONTEXT'}` value={s.get('value')}")
    for s in result.get("trade_signals", [])[:100]:
        lines.append(f"- Trade signal `{s.get('signal_id') or s.get('context_id')}` type=`{s.get('signal_type') or 'TRADE_CONTEXT'}` value={s.get('value')}")
    for p in result.get("penetration", [])[:200]:
        lines.append(f"- Penetration `{p.get('metric_id')}` = {p.get('penetration')} numerator={p.get('numerator')} denominator={p.get('denominator')}")
    lines.append("")

    lines.append("## Customer Needs / Pain Points / Switching Factors")
    for n in result.get("customer_needs", [])[:200]:
        lines.append(f"- Need `{n.get('item_id')}` state=`{n.get('evidence_state')}`: {n.get('text')}")
    for p in result.get("pain_points", [])[:200]:
        lines.append(f"- Pain `{p.get('item_id')}` state=`{p.get('evidence_state')}`: {p.get('text')}")
    for s in result.get("switching_factors", [])[:200]:
        lines.append(f"- Switching `{s.get('item_id')}` state=`{s.get('evidence_state')}`: {s.get('text')}")
    lines.append("")

    lines.append("## Reviews / Surveys / Attention Signals")
    for sv in result.get("survey_context", [])[:100]:
        lines.append(f"- Survey `{sv.get('context_id')}` sample={sv.get('sample_size')} method={sv.get('method')} population={sv.get('population')} response_rate={sv.get('response_rate')}")
    for rv in result.get("reviews_context", [])[:100]:
        lines.append(f"- Review `{rv.get('context_id')}` platform={rv.get('platform')} rating={rv.get('rating')} volume={rv.get('volume')}")
    for se in result.get("search_interest_context", [])[:100]:
        lines.append(f"- Search interest `{se.get('context_id')}`: {se.get('description')}")
    for wt in result.get("web_traffic_context", [])[:100]:
        lines.append(f"- Web traffic estimate `{wt.get('context_id')}`: {wt.get('description')}")
    lines.append("")

    lines.append("## Technology / Regulatory / Macro Drivers")
    for d in result.get("technology_drivers", [])[:100]:
        lines.append(f"- Technology `{d.get('driver_id')}` status=`{d.get('status')}` effect=`{d.get('effect')}`: {d.get('description')}")
    for d in result.get("regulatory_drivers", [])[:100]:
        lines.append(f"- Regulatory `{d.get('driver_id')}` status=`{d.get('status')}` effect=`{d.get('effect')}` effective={d.get('effective_date')}: {d.get('description')}")
    for d in result.get("macro_drivers", [])[:100]:
        lines.append(f"- Macro `{d.get('driver_id')}` status=`{d.get('status')}` effect=`{d.get('effect')}`: {d.get('description')}")
    lines.append("")

    lines.append("## Forecasts / Scenarios / Sensitivity")
    mat = result.get("market_maturity", {})
    lines.append(f"- Maturity state: `{mat.get('state')}` candidates={mat.get('candidates', [])}")
    for f in result.get("forecasts", [])[:200]:
        lines.append(f"- Forecast `{f.get('forecast_id')}` method=`{f.get('method')}` scenario=`{f.get('scenario')}` base={f.get('value_base')} low={f.get('value_low')} high={f.get('value_high')} assumptions={f.get('assumptions', [])[:10]}")
    fv = result.get("forecast_metrics", {})
    lines.append(f"- Forecast validation: validated={fv.get('validated_count')} MAE={fv.get('mae')} MAPE={fv.get('mape')}")
    for s in result.get("sensitivity_analysis", [])[:200]:
        lines.append(f"- Sensitivity `{s.get('sensitivity_id')}` input={s.get('input')} impact={s.get('output_impact')} low/base/high={s.get('low')}/{s.get('base')}/{s.get('high')}")
    lines.append("")

    lines.append("## Source Reliability / Independence / Bias")
    si = result.get("source_independence", {})
    lines.append(f"- Source independence state: `{si.get('state')}`")
    lines.append(f"- Source families: {si.get('source_families', [])[:50]}")
    lines.append(f"- Max/avg reliability: `{si.get('max_reliability')}` / `{si.get('avg_reliability')}`")
    for b in result.get("source_bias", [])[:200]:
        lines.append(f"- Source `{b.get('source_id')}` type=`{b.get('source_type')}` bias={b.get('potential_bias')}")
    lines.append("")

    lines.append("## Contradictions")
    for c in result.get("contradictions", [])[:300]:
        lines.append(f"- `{c.get('contradiction_id')}` [{c.get('severity')}] {c.get('type')}: {c.get('detail')}")
        if c.get("possible_causes"):
            lines.append(f"  - possible causes: {'; '.join(c['possible_causes'][:10])}")
    lines.append("")

    lines.append("## Competing Hypotheses / Falsification")
    for h in result.get("hypotheses", [])[:500]:
        lines.append(f"- `{h.get('hypothesis_id')}` [{h.get('category')}] {h.get('subject_type')} `{h.get('subject_id')}`: {h.get('statement')}")
        if h.get("support"):
            lines.append(f"  - support: {'; '.join(map(str, h['support'][:5]))}")
        if h.get("falsification_conditions"):
            lines.append(f"  - falsify if: {'; '.join(map(str, h['falsification_conditions'][:5]))}")
    lines.append("")

    lines.append("## Knowledge Gaps")
    for g in result.get("knowledge_gaps", [])[:500]:
        lines.append(f"- `{g.get('gap_id')}` [{g.get('importance')}] {g.get('type')}: {g.get('recommended_source')}")
    lines.append("")

    lines.append("## Recommended Next Actions")
    for a in result.get("recommended_next_actions", [])[:500]:
        lines.append(f"- [{a.get('priority')}] {a.get('action')}")
    lines.append("")

    lines.append("## Specialist Handoffs")
    for h in result.get("specialist_handoffs", []):
        lines.append(f"- {h.get('specialist')}: {h.get('reason')}")
        lines.append(f"  - payload: `{json.dumps(h.get('payload', {}), ensure_ascii=False, default=str)}`"[:1000])
    lines.append("")

    lines.append("## Dual-AI Review Stub")
    dr = result.get("dual_ai_review", {})
    lines.append(f"- Status: `{dr.get('status')}`")
    lines.append(f"- Comparison: `{dr.get('comparison')}`")
    for n in dr.get("notes", []):
        lines.append(f"- {n}")
        for c in dr.get("primary_conclusions", [])[:50]:
        lines.append(f"- Primary: {c}")
    for c in dr.get("skeptic_challenges", [])[:50]:
        lines.append(f"- Skeptic: {c}")
    lines.append("")

    lines.append("## Limitations")
    for lim in result.get("limitations", []):
        lines.append(f"- {lim}")
    lines.append("")

    lines.append("## Non-Negotiable Boundary")
    lines.append("- Define the market first.")
    lines.append("- Define the denominator.")
    lines.append("- Preserve the metric.")
    lines.append("- Separate demand from attention.")
    lines.append("- Separate shipments from sales.")
    lines.append("- Separate list price from realized price.")
    lines.append("- Triangulate market size.")
    lines.append("- Show the TAM/SAM/SOM math.")
    lines.append("- Show the forecast assumptions.")
    lines.append("- Measure uncertainty.")
    lines.append("- Forecast last.")

    return "\n".join(lines)


# --------------------------------------------------------------------
# CLI
# --------------------------------------------------------------------

def main() -> int:
    parser = argparse.ArgumentParser(description="TRACEATLAS MARKETINT safe starter")
    parser.add_argument("--manifest", required=True, help="Path to MARKETINT manifest JSON")
    parser.add_argument("--output", default="marketint_result.json", help="Output JSON path")
    parser.add_argument("--report", default="marketint_report.md", help="Output Markdown report path")
    args = parser.parse_args()

    try:
        manifest = json.loads(Path(args.manifest).read_text(encoding="utf-8"))
    except Exception as exc:
        print(f"ERROR reading manifest: {exc}", file=sys.stderr)
        return 2

    result = analyze_marketint_manifest(manifest)

    Path(args.output).write_text(
        json.dumps(json_safe(result), ensure_ascii=False, indent=2),
        encoding="utf-8",
    )
    Path(args.report).write_text(generate_report(result), encoding="utf-8")

    print(f"Wrote: {args.output}")
    print(f"Wrote: {args.report}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())




