# ==============================================================================
# CORE ANALYTICAL MODULES (Deterministic First Rule - Section 166)
# ==============================================================================

class HashingModule:
    @staticmethod
    def compute_sha256(data: str) -> str:
        return hashlib.sha256(data.encode('utf-8')).hexdigest()
    
    @staticmethod
    def compute_perceptual_hash(image_data: bytes) -> str:
        """
        Placeholder for actual pHash implementation.
        In production, use libraries like 'imagehash' or 'phash'.
        Deterministic output based on input bytes for simulation.
        """
        return hashlib.md5(image_data).hexdigest()[:16]

class TextNormalizationModule:
    @staticmethod
    def normalize(text: str) -> str:
        if not text:
            return ""
        # Lowercase, remove extra whitespace, basic punctuation cleanup
        cleaned = " ".join(text.lower().split())
        return cleaned.strip()

class CoordinationAnalyzer:
    """
    Analyzes temporal and structural signals for coordination.
    Does NOT assume malice. Tests organic alternatives.
    """
    
    @staticmethod
    def detect_synchronization(contents: List[ContentObject], threshold_seconds: int = 300) -> List[List[str]]:
        """
        Identifies groups of posts occurring within a tight time window.
        """
        sorted_contents = sorted(contents, key=lambda x: x.published_at)
        clusters = []
        current_cluster = []
        
        for i, c in enumerate(sorted_contents):
            if not current_cluster:
                current_cluster.append(c.content_id)
                continue
            
            prev_c = sorted_contents[i-1]
            diff = (c.published_at - prev_c.published_at).total_seconds()
            
            if diff <= threshold_seconds:
                current_cluster.append(c.content_id)
            else:
                if len(current_cluster) > 1:
                    clusters.append(current_cluster.copy())
                current_cluster = [c.content_id]
                
        if len(current_cluster) > 1:
            clusters.append(current_cluster)
            
        return clusters

    @staticmethod
    def analyze_source_independence(contents: List[ContentObject]) -> Dict[str, SourceIndependenceState]:
        """
        Checks if multiple contents derive from the same upstream URL or Media ID.
        Simplified logic: If URLs match exactly, they are dependent.
        """
        url_map = {}
        independence_states = {}
        
        for c in contents:
            primary_url = c.urls[0] if c.urls else None
            if primary_url:
                if primary_url not in url_map:
                    url_map[primary_url] = []
                url_map[primary_url].append(c.content_id)
        
        for url, ids in url_map.items():
            if len(ids) == 1:
                independence_states[ids[0]] = SourceIndependenceState.INDEPENDENT
            else:
                for cid in ids:
                    independence_states[cid] = SourceIndependenceState.DEPENDENT
                    
        return independence_states

class FactGate:
    """
    Routes claims to external verification modules (simulated here).
    Never fabricates truth status.
    """
    
    @staticmethod
    def verify_claim(claim: ClaimObject, existing_facts: Dict[str, bool]) -> ClaimVerificationState:
        # Simple lookup for demonstration. Real system would query OSINT/NEWSINT/DISINFOINT.
        claim_key = f"{claim.subject} {claim.predicate} {claim.object}"
        if claim_key in existing_facts:
            return ClaimVerificationState.SUPPORTED if existing_facts[claim_key] else ClaimVerificationState.UNSUPPORTED
        
        # Default to inconclusive if no data exists (Section 113)
        return ClaimVerificationState.INCONCLUSIVE

# ==============================================================================
# MAIN ENGINE: MEMEINT / INFLUENCEINT AI EMPLOYEE
# ==============================================================================

class MemeIntEmployee:
    def __init__(self, model_mode: str = "LOCAL_ONLY"):
        self.model_mode = model_mode
        self.hasher = HashingModule()
        self.normalizer = TextNormalizationModule()
        self.coord_analyzer = CoordinationAnalyzer()
        self.fact_gate = FactGate()
        self.memory_graph = {} # Graphical Memory placeholder
        logger.info(f"MemeInt Employee initialized in mode: {model_mode}")

    def process_case(self, 
                     objective: str, 
                     authorized_scope: Dict[str, Any],
                     raw_inputs: List[Dict[str, Any]],
                     existing_facts: Dict[str, bool] = None) -> Dict[str, Any]:
        
        # 1. Authorization & Policy Check (Section 4, 12)
        if not check_policy_compliance(objective):
            return {"status": "POLICY_BLOCKED", "reason": "Objective involves prohibited influence operations."}
        
        if existing_facts is None:
            existing_facts = {}

        logger.info(f"Starting Case Processing. Objective: {objective[:50]}...")

        # 2. Content Ingestion & Preservation (Section 26)
        contents: List[ContentObject] = []
        evidences: List[EvidenceObject] = []
        accounts: Dict[str, AccountObject] = {}
        memes: List[MemeVariantObject] = []
        templates: Dict[str, MemeTemplateObject] = {}
        claims: List[ClaimObject] = []
        narratives: List[NarrativeObject] = []

        now = datetime.now(timezone.utc)

        for idx, item in enumerate(raw_inputs):
            # Generate IDs
            content_id = f"C_{idx}_{item['platform']}"
            evidence_id = f"E_{idx}"
            
            # Normalize Data
            text_norm = self.normalizer.normalize(item.get('text', ''))
            media_hash = ""
            if 'media_bytes' in item:
                media_hash = self.hasher.compute_perceptual_hash(item['media_bytes'])
            elif 'media_id' in item:
                media_hash = self.hasher.compute_sha256(str(item['media_id']))
            
            # Create Evidence Object
            ev = EvidenceObject(
                evidence_id=evidence_id,
                case_id="CASE_001",
                source_id=item.get('source_id', 'UNKNOWN'),
                platform=item['platform'],
                content_id=content_id,
                published_at=datetime.fromisoformat(item['published_at']),
                first_seen=now, # Earliest observation in this batch
                retrieved_at=now,
                content_hash=self.hasher.compute_sha256(json.dumps(item)),
                authorization_context=authorized_scope.get('context', 'PUBLIC_DATA')
            )
            evidences.append(ev)

            # Create Content Object
            acc_id = item.get('account_id', 'ANON_USER')
            if acc_id not in accounts:
                accounts[acc_id] = AccountObject(
                    account_id=acc_id,
                    platform=item['platform'],
                    public_handle=item.get('handle', ''),
                    display_name=item.get('display_name', ''),
                    creation_time_if_public=None,
                    bio_if_public=item.get('bio', ''),
                    public_metrics={},
                    first_seen=now,
                    last_seen=now
                )

            cont = ContentObject(
                content_id=content_id,
                platform=item['platform'],
                author_account=acc_id,
                channel_or_page=item.get('channel_id'),
                content_type=item.get('type', 'TEXT'),
                text=text_norm,
                hashtags=item.get('hashtags', []),
                urls=item.get('urls', []),
                media_ids=[media_hash] if media_hash else [],
                language=item.get('language', 'en'),
                published_at=datetime.fromisoformat(item['published_at']),
                engagement_snapshot=item.get('engagement', {}),
                evidence_ids=[evidence_id]
            )
            contents.append(cont)

            # Extract Claims (Simplified NLP Simulation)
            # In real system, this uses advanced NLP/LLM locally or via hybrid cloud
            if item.get('extracted_claims'):
                for cl in item['extracted_claims']:
                    claim_obj = ClaimObject(
                        claim_id=f"CL_{len(claims)}",
                        subject=cl['subject'],
                        predicate=cl['predicate'],
                        object=cl['object'],
                        time_reference=cl.get('time_ref'),
                        location_reference=cl.get('loc_ref'),
                        claim_type=cl.get('type', 'FACTUAL'),
                        explicit_or_implied=cl.get('explicitness', 'EXPLICIT'),
                        source_content_id=content_id,
                        verification_state=ClaimVerificationState.INCONCLUSIVE # Will be updated by Fact Gate
                    )
                    claims.append(claim_obj)

        # 3. Meme Template Detection & Lineage (Section 32-34)
        # Group by media hash/perceptual signature
        template_groups: Dict[str, List[ContentObject]] = {}
        for c in contents:
            if c.media_ids:
                sig = c.media_ids[0][:8] # Use prefix as rough template ID
                if sig not in template_groups:
                    template_groups[sig] = []
                template_groups[sig].append(c)
        
        for sig, group in template_groups.items():
            tid = f"TPL_{sig}"
            variants = []
            for g in group:
                v = MemeVariantObject(
                    variant_id=f"VAR_{g.content_id}",
                    template_id=tid,
                    media_hash=g.media_ids[0],
                    perceptual_hash=g.media_ids[0],
                    caption=g.text,
                    language=g.language,
                    first_seen=g.published_at,
                    platform=g.platform,
                    source_content_id=g.content_id
                )
                variants.append(v)
                memes.append(v)
            
            tpl = MemeTemplateObject(
                template_id=tid,
                visual_signature=sig,
                layout_signature="SIMILAR_LAYOUT",
                text_regions=[], # OCR result integration point
                first_seen=min([v.first_seen for v in variants]),
                variant_count=len(variants),
                platforms=list(set([v.platform for v in variants])),
                related_narratives=[],
                confidence=0.9 if len(variants) > 1 else 0.5
            )
            templates[tid] = tpl

        # 4. Propagation & Coordination Analysis (Section 48-50)
        sync_clusters = self.coord_analyzer.detect_synchronization(contents)
        indep_states = self.coord_analyzer.analyze_source_independence(contents)
        
        coordination_signal_detected = len(sync_clusters) > 0
        inauthenticity_candidate = False
        
        # Heuristic for Inauthenticity (Section 51): 
        # Requires more than just sync. Look for fake persona indicators or undisclosed control.
        # Here we simulate: if many accounts post identical text AND share same URL AND created recently.
        if coordination_signal_detected:
            # Check if sources are independent
            non_independent_posts = sum(1 for s in indep_states.values() if s == SourceIndependenceState.DEPENDENT)
            if non_independent_posts > len(contents) * 0.5:
                inauthenticity_candidate = True # CANDIDATE ONLY, not proof

        # 5. Fact Gate Application (Section 112)
        for claim in claims:
            claim.verification_state = self.fact_gate.verify_claim(claim, existing_facts)

        # 6. Hypothesis Generation & ACH (Section 161-163)
        hypotheses = [
            {"id": "H1", "desc": "Organic Viral Spread", "support": ["High variance in captions"]},
            {"id": "H2", "desc": "Coordinated Authentic Campaign", "support": ["Sync posting", "Shared official URLs"]},
            {"id": "H3", "desc": "Inauthentic Bot Network", "support": ["Fake personas", "Mass account creation"], "refutation_needed": True},
            {"id": "H4", "desc": "News Syndication Artifact", "support": ["Identical press release text"]}
        ]
        
        # Determine Campaign State based on evidence weight
        campaign_state = CampaignState.NO_CAMPAIGN_EVIDENCE
        if coordination_signal_detected:
            if inauthenticity_candidate:
                campaign_state = CampaignState.INAUTHENTIC_CAMPAIGN_CANDIDATE
            else:
                campaign_state = CampaignState.COORDINATION_CANDIDATE
        elif len(memes) > 0:
            campaign_state = CampaignState.CONTENT_CLUSTER

        # 7. Construct Result Object (Section 186)
        result = {
            "case_id": "CASE_001",
            "task_id": "TASK_MEME_ANALYSIS",
            "objective": objective,
            "status": "COMPLETED",
            "summary": {
                "narrative_found": len(narratives) > 0,
                "meme_templates_identified": list(templates.keys()),
                "coordination_state": CoordinationState.UNKNOWN if not coordination_signal_detected else CoordinationState.ORGANIC_COORDINATION_CANDIDATE,
                "campaign_state": campaign_state.name,
                "inauthenticity_indicators": "PRESENT_AS_CANDIDATE" if inauthenticity_candidate else "ABSENT_INSUFFICIENT_EVIDENCE"
            },
            "artifacts": {
                "contents_processed": len(contents),
                "evidences_preserved": len(evidences),
                "accounts_mapped": list(accounts.keys()),
                "memes_variants": len(memes),
                "claims_extracted": len(claims)
            },
            "analysis_details": {
                "synchronization_clusters": sync_clusters,
                "source_independence_map": {k: v.name for k, v in indep_states.items()},
                "fact_check_results": [{c.claim_id: c.verification_state.name} for c in claims],
                "hypotheses_considered": hypotheses
            },
            "limitations": [
                "First-seen times are relative to collection start, not global origin.",
                "Automation detection is heuristic; humans can schedule posts.",
                "No private data accessed per LOCAL_ONLY/HYBRID policy."
            ],
            "next_best_action": [
                "Trace upstream source of shared URLs using WEBINT.",
                "Verify account creation dates for synchronization cluster members.",
                "Consult DISINFOINT for factual adjudication of disputed claims."
            ]
        }

        logger.info("Case processing complete. Defensive report generated.")
        return result

