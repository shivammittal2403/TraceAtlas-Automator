logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')
logger = logging.getLogger("MEMEINT_SYSTEM")

# Hard Restrictions Check Function
def check_policy_compliance(action: str) -> bool:
    """
    Ensures no prohibited actions are attempted.
    Returns True if allowed, False if blocked.
    """
    prohibited_actions = [
        "create_propaganda", "generate_disinformation", "run_bot", 
        "microtarget_user", "harass_target", "evade_platform_integrity",
        "identify_private_individual", "psychographic_profiling"
    ]
    
    if action.lower() in prohibited_actions or any(p in action.lower() for p in prohibited_actions):
        logger.warning(f"POLICY_BLOCKED: Action '{action}' violates INFLUENCEINT core principles.")
        return False
    
    return True

