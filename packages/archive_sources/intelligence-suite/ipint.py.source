                    "permitted_actions": [
                        "local IP evidence hashing",
                        "authorized/public RDAP/RIR/BGP/RPKI/PTR/pDNS/CT/service/reputation metadata parsing",
                        "IP normalization and special-use detection",
                        "prefix/ASN/provider candidate extraction",
                        "IP usage era construction",
                        "source independence review",
                        "defensive specialist handoff",
                    ],
                    "prohibited_actions": [
                        "unauthorized scanning",
                        "service enumeration",
                        "vulnerability scanning",
                        "exploitation",
                        "brute force",
                        "password spray",
                        "credential use/validation",
                        "authentication bypass",
                        "traffic interception",
                        "MITM",
                        "DDoS",
                        "routing modification",
                        "BGP hijack",
                        "DNS poisoning",
                        "intrusive origin discovery",
                        "private-person tracking",
                    ],
                },
                indent=2,
            ),
        )
        self.set_widget_value("source_limits", "")
        self.set_widget_value("budget", "")
        self.set_widget_value("deadline", "")
        self.set_widget_value(
            "configured_connectors",
            "None configured. No RDAP/RIR/BGP/RPKI/PTR/passive-DNS/CT/service-index/reputation connector invoked. Planning-only for external enrichment.",
        )

    def get_widget_value(self, key: str) -> str:
        widget = self.entries.get(key)
        if widget is None:
            return ""

        if isinstance(widget, tk.Text):
            return widget.get("1.0", "end-1c").strip()

        if isinstance(widget, ttk.Combobox):
            return widget.get().strip()

        if isinstance(widget, ttk.Entry):
            return widget.get().strip()

        return ""

    def set_widget_value(self, key: str, value: str) -> None:
        widget = self.entries.get(key)
        if widget is None:
            return

        if isinstance(widget, tk.Text):
            widget.delete("1.0", "end")
            widget.insert("1.0", value)
        elif isinstance(widget, ttk.Combobox):
            widget.set(value)
        elif isinstance(widget, ttk.Entry):
            widget.delete(0, "end")
            widget.insert(0, value)

    def collect_payload(self) -> Dict[str, Any]:
        payload: Dict[str, Any] = {}

        for key, _, _ in FIELDS:
            raw = self.get_widget_value(key)

            if key in LIST_FIELDS:
                payload[key] = parse_list(raw)
            elif key in DICT_FIELDS:
                payload[key] = parse_dict(raw)
            else:
                payload[key] = raw

        payload["generated_at"] = now_utc()
        payload["panel_version"] = APP_VERSION
        payload["operating_mode"] = "PLANNING_ONLY_PASSIVE_FIRST"
        payload["source_boundary"] = "PASSIVE_AUTHORIZED_EVIDENCE_FIRST_IPINT_ONLY"
        return payload

    def add_evidence_files(self) -> None:
        paths = filedialog.askopenfilenames(
            title="Select authorized/public IP evidence files",
            filetypes=[
                ("IP evidence", "*.json *.csv *.tsv *.txt *.log *.rdap *.whois *.bgp *.rpki *.ptr *.pdns *.ct *.pcap *.pcapng"),
                ("All files", "*.*"),
            ],
        )

        if not paths:
            return

        current = self.get_widget_value("evidence_paths")
        added = "\n".join(paths)
        new_value = current + ("\n" if current else "") + added
        self.set_widget_value("evidence_paths", new_value)
        messagebox.showinfo("IP Evidence Files Added", f"{len(paths)} path(s) added to Local Authorized IP Evidence Paths.")

    def run_policy_screen(self) -> None:
        payload = self.collect_payload()
        policy = policy_screen(payload)

        result = {
            "mode": "POLICY_SCREEN_ONLY",
            "panel_version": APP_VERSION,
            "policy_screen": policy,
            "payload_preview": {
                "case_id": payload.get("case_id"),
                "task_id": payload.get("task_id"),
                "objective": payload.get("objective"),
                "target_ip": payload.get("target_ip"),
                "target_type": payload.get("target_type"),
                "has_known_ips": bool(payload.get("known_ips")),
                "has_known_prefixes": bool(payload.get("known_prefixes")),
                "has_known_asns": bool(payload.get("known_asns")),
                "has_local_evidence": bool(payload.get("evidence_paths")),
                "has_threat_context": bool(payload.get("known_campaigns") or payload.get("known_malware")),
            },
        }

        self.last_result = result
        self._write_output(result)
        self.notebook.select(self.output_tab)

        if policy["status"] == "POLICY_BLOCKED":
            messagebox.showwarning(
                "Policy Blocked",
                "This IPINT request is policy-blocked.\n\n"
                + "\n".join(policy["reasons"])
                + "\n\nUse only passive/public/authorized defensive alternatives.",
            )
        elif policy["status"] == "HUMAN_REVIEW_REQUIRED":
            messagebox.showwarning(
                "Human Review Required",
                "No hard policy block detected, but sensitive IP reputation/threat/telemetry/special-use/attribution controls apply.",
            )
        else:
            messagebox.showinfo(
                "Policy Screen",
                "No obvious policy violation detected. Planning-only mode remains active.",
            )

    def analyze_local_ipint(self) -> None:
        payload = self.collect_payload()
        policy = policy_screen(payload)

        if policy["status"] == "POLICY_BLOCKED":
            result = {
                "mode": "POLICY_BLOCKED",
                "panel_version": APP_VERSION,
                "policy_screen": policy,
                "evidence_inventory": [],
                "ip_inventory_preview": [],
                "observations": [],
                "candidate_facts": [],
            }
            self.last_result = result
            self._write_output(result)
            messagebox.showwarning("Policy Blocked", "Local IPINT evidence analysis blocked by policy screen.")
            return

        paths = [str(p).strip() for p in payload.get("evidence_paths", []) if str(p).strip()]

        if not paths:
            messagebox.showwarning("No IP Evidence", "Add local authorized/public IP evidence files first.")
            return

        self.output.delete("1.0", "end")
        self.output.insert("1.0", "Analyzing local authorized/public IP evidence. Hashing and parsing may take time...\n")
        self.notebook.select(self.output_tab)

        files: List[Dict[str, Any]] = []
        parsed_list: List[Dict[str, Any]] = []

        for p in paths[:20]:
            f, parsed = analyze_ip_file(p, payload.get("case_id", ""), payload.get("task_id", ""))
            files.append(f)
            parsed_list.append(parsed)

        aggregated = aggregate_parsed(parsed_list)
        normalized = normalize_entities(aggregated.get("entities", []))
        usage_eras = build_usage_eras(normalized, aggregated.get("relationships", []))
        contradictions = build_contradictions(normalized, aggregated.get("relationships", []))

        self.analyzed_files = files
        self.parsed = aggregated
        self.normalized_entities = normalized
        self.usage_eras = usage_eras
        self.contradictions = contradictions

        report = self._build_local_analysis_report(files, aggregated, normalized, usage_eras, contradictions, payload, policy)
        self.last_result = report
        self._write_output(report)

        succeeded = sum(1 for f in files if f.get("status") == "SUCCEEDED")
        messagebox.showinfo(
            "Local IPINT Evidence Analysis Complete",
            f"Processed {len(files)} evidence file(s).\n"
            f"Succeeded: {succeeded}\n"
            f"IP entities: {sum(1 for e in normalized if e.get('type') == 'IP')}\n"
            f"Prefix entities: {sum(1 for e in normalized if e.get('type') == 'PREFIX')}\n"
            f"ASN entities: {sum(1 for e in normalized if e.get('type') == 'ASN')}\n"
            f"Relationships: {len(aggregated.get('relationships', []))}\n"
            f"Usage eras: {len(usage_eras)}\n"
            f"Contradictions: {len(contradictions)}\n"
            "Review output for limitations and next actions.",
        )

    def generate_plan(self) -> None:
        payload = self.collect_payload()
        warnings = validate_payload(payload)
        policy = policy_screen(payload)

        if policy["status"] == "POLICY_BLOCKED":
            result = {
                "mode": "POLICY_BLOCKED",
                "panel_version": APP_VERSION,
                "policy_screen": policy,
                "warnings": warnings,
                "payload": payload,
                "ipint_collection_plan": [],
                "next_best_action": {
                    "action": "Revise task to remove prohibited scanning/exploitation/interception/disruption/private-tracking behavior.",
                    "owner": "IPINT Manager / Cyber Intelligence Manager",
                    "expected_output": "Policy-compliant passive/authorized IPINT scope and question set.",
                },
            }
            self.last_result = result
            self._write_output(result)
            messagebox.showwarning(
                "Policy Blocked",
                "IPINT plan not generated because the request is policy-blocked.",
            )
            return

        questions = payload.get("questions") or default_questions(payload)

        files = self.analyzed_files
        parsed = self.parsed
        entities = self.normalized_entities or normalize_entities(parsed.get("entities", []))
        relationships = parsed.get("relationships", [])
        usage_eras = self.usage_eras or build_usage_eras(entities, relationships)
        contradictions = self.contradictions or build_contradictions(entities, relationships)

        hypotheses = build_hypotheses(payload, entities, relationships, contradictions)
        knowledge_gaps = build_knowledge_gaps(payload, files, entities, relationships, contradictions, usage_eras)
        handoffs = build_specialist_handoffs(payload, entities, relationships)
        next_action = build_next_best_action(payload, policy, files, entities, relationships, contradictions, usage_eras)

        overall_status = "PLANNING_ONLY"
        if policy["status"] == "HUMAN_REVIEW_REQUIRED":
            overall_status = "HUMAN_REVIEW_REQUIRED"
        if files or entities:
            overall_status = "PLANNING_PLUS_LOCAL_DETERMINISTIC_EVIDENCE"

        result = {
            "mode": overall_status,
            "panel_version": APP_VERSION,
            "policy": (
                "This output does not perform unauthorized port scanning, service enumeration, vulnerability scanning, exploitation, "
                "brute force, password spraying, credential stuffing, stolen/leaked credential use, authentication bypass, traffic interception, "
                "MITM, DDoS/SYN flood/reflection/amplification, remote system modification, routing modification, BGP hijack, DNS poisoning, "
                "intrusive origin discovery, unauthorized large-scale traceroute, or private-person tracking. Local deterministic analysis is limited to "
                "hashing, safe JSON/CSV/TXT IP metadata parsing, IP normalization, special-use detection, prefix/CIDR validation, ASN format validation, "
                "BGP/RPKI/PTR/pDNS/CT/service/reputation record parsing where supplied, temporal relationship extraction, IP usage era construction, "
                "contradiction detection, secret redaction, prompt-injection flagging, competing hypotheses, and defensive specialist handoff planning. "
                "Live RDAP/RIR/BGP/RPKI/PTR/pDNS/CT/service/reputation enrichment, active validation, tenant attribution, current maliciousness adjudication, "
                "and geolocation precision remain planning-only unless configured/authorized."
            ),
            "policy_screen": policy,
            "warnings": warnings,
            "payload": payload,
            "intelligence_questions": questions,
            "evidence_inventory": files,
            "ip_inventory_preview": [e for e in entities if e.get("type") == "IP"][:300],
            "prefix_inventory_preview": [e for e in entities if e.get("type") == "PREFIX"][:300],
            "asn_inventory_preview": [e for e in entities if e.get("type") == "ASN"][:300],
            "ptr_inventory_preview": [e for e in entities if e.get("type") == "PTR"][:300],
            "domain_inventory_preview": [e for e in entities if e.get("type") == "DOMAIN"][:300],
            "certificate_inventory_preview": [e for e in entities if e.get("type") == "CERTIFICATE"][:300],
            "service_inventory_preview": [e for e in entities if e.get("type") in {"SERVICE", "PORT"}][:300],
            "reputation_inventory_preview": [e for e in entities if e.get("type") in {"REPUTATION", "THREAT"}][:300],
            "provider_inventory_preview": [e for e in entities if e.get("type") == "PROVIDER"][:300],
            "relationship_preview": relationships[:300],
            "relationship_count": len(relationships),
            "ip_usage_eras": usage_eras[:1000],
            "contradictions": contradictions[:1000],
            "hypotheses": hypotheses,
            "knowledge_gaps": knowledge_gaps,
            "specialist_handoffs": handoffs,
            "next_best_action": next_action,
            "ipint_collection_plan": build_collection_plan(payload, questions, files, entities, relationships),
            **self._policy_sections(),
            **self._schemas(),
        }

        self.last_result = result
        self._write_output(result)
        self.notebook.select(self.output_tab)

        if warnings:
            messagebox.showwarning(
                "Validation Warnings",
                "IPINT plan generated with warnings:\n\n" + "\n".join(warnings),
            )

    def _build_local_analysis_report(
        self,
        files: List[Dict[str, Any]],
        parsed: Dict[str, Any],
        entities: List[Dict[str, Any]],
        usage_eras: List[Dict[str, Any]],
        contradictions: List[Dict[str, Any]],
        payload: Dict[str, Any],
        policy: Dict[str, Any],
    ) -> Dict[str, Any]:
        relationships = parsed.get("relationships", [])
        hypotheses = build_hypotheses(payload, entities, relationships, contradictions)
        knowledge_gaps = build_knowledge_gaps(payload, files, entities, relationships, contradictions, usage_eras)
        handoffs = build_specialist_handoffs(payload, entities, relationships)
        next_action = build_next_best_action(payload, policy, files, entities, relationships, contradictions, usage_eras)

        observations: List[Dict[str, Any]] = []

        for f in files:
            observations.append({
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": f"A local authorized/public IP evidence file was accessed and hashed: {f.get('filename')}.",
                "evidence_id": f.get("evidence_id"),
                "source_id": f.get("source_id"),
                "observed_at": now_utc(),
                "extraction_method": "local_deterministic_file_hash",
                "limitations": "File hash does not prove IP ownership, tenancy, current control, or maliciousness.",
            })

        observations.extend([
            {
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": f"{len(files)} IP evidence file(s) were parsed locally.",
                "evidence_id": "AGGREGATE",
                "source_id": "LOCAL_PARSER",
                "observed_at": now_utc(),
                "extraction_method": "safe_json_csv_text_ip_parser",
                "limitations": "Parser output is normalized evidence, not verified external reality.",
            },
            {
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": f"{sum(1 for e in entities if e.get('type') == 'IP')} valid IP candidate(s) were extracted/normalized.",
                "evidence_id": "AGGREGATE",
                "source_id": "LOCAL_IP_NORMALIZER",
                "observed_at": now_utc(),
                "extraction_method": "ipaddress_normalization",
                "limitations": "IP validity does not prove ownership, tenancy, operator control, or current maliciousness.",
            },
            {
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": f"{sum(1 for e in entities if e.get('type') == 'PREFIX')} prefix/CIDR candidate(s) were extracted/normalized.",
                "evidence_id": "AGGREGATE",
                "source_id": "LOCAL_PREFIX_NORMALIZER",
                "observed_at": now_utc(),
                "extraction_method": "ipaddress_network_validation",
                "limitations": "Prefix membership is not application ownership.",
            },
            {
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": f"{sum(1 for e in entities if e.get('type') == 'ASN')} ASN candidate(s) were extracted/validated.",
                "evidence_id": "AGGREGATE",
                "source_id": "LOCAL_ASN_VALIDATOR",
                "observed_at": now_utc(),
                "extraction_method": "asn_regex_validation",
                "limitations": "ASN announcement is not tenant/application ownership.",
            },
            {
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": f"{len(relationships)} conservative IP relationship candidate(s) were extracted.",
                "evidence_id": "AGGREGATE",
                "source_id": "LOCAL_RELATIONSHIP_PARSER",
                "observed_at": now_utc(),
                "extraction_method": "record_and_text_cooccurrence_with_temporal_fields",
                "limitations": "Co-occurrence relationships require independent temporal evidence before merging entities.",
            },
            {
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": f"{len(usage_eras)} IP usage-era candidate(s) were constructed.",
                "evidence_id": "AGGREGATE",
                "source_id": "LOCAL_TEMPORAL_ERAS",
                "observed_at": now_utc(),
                "extraction_method": "first_seen_last_seen_valid_from_valid_to_grouping",
                "limitations": "Usage eras are observational; reassignment must be checked before current attribution.",
            },
            {
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": f"{len(contradictions)} IP attribute contradiction candidate(s) were detected.",
                "evidence_id": "AGGREGATE",
                "source_id": "LOCAL_CONTRADICTION_DETECTOR",
                "observed_at": now_utc(),
                "extraction_method": "multi_value_ip_relationship_conflict_detection",
                "limitations": "Contradictions may reflect time, migration, anycast, CDN, NAT, VPN, reassignment, or source error.",
            },
            {
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": "No active scanning, exploitation, interception, routing modification, DDoS, BGP hijack, DNS poisoning, or private-person tracking was performed.",
                "evidence_id": "LOCAL_PANEL_POLICY",
                "source_id": "LOCAL_POLICY_GUARD",
                "observed_at": now_utc(),
                "extraction_method": "defensive_passive_policy",
                "limitations": "Planning/local deterministic panel only.",
            },
        ])

        observations, _ = truncate_list(observations, 500)

        candidate_facts: List[Dict[str, Any]] = []

        for f in files:
            if f.get("sha256"):
                candidate_facts.append({
                    "candidate_fact": f"The preserved local IP evidence artifact {f.get('filename')} has SHA256 {f.get('sha256')}.",
                    "status": "SUPPORTED",
                    "evidence_ids": [f.get("evidence_id")],
                    "notes": "Supported by deterministic local hashing. Does not prove IP truth, ownership, tenancy, or current maliciousness.",
                })

        candidate_facts.extend([
            {
                "candidate_fact": f"The parsed evidence set contains {sum(1 for e in entities if e.get('type') == 'IP')} valid IP candidate records.",
                "status": "SUPPORTED",
                "evidence_ids": ["AGGREGATE"],
                "notes": "Supported by local parser. Completeness and accuracy depend on source provenance.",
            },
            {
                "candidate_fact": f"{len(relationships)} IP relationship candidates were extracted, but ownership/tenancy/current control remain unresolved.",
                "status": "SUPPORTED_AS_CANDIDATE_ONLY",
                "evidence_ids": ["AGGREGATE"],
                "not_supported": [
                    "application ownership",
                    "tenant identity",
                    "operator control",
                    "current maliciousness",
                    "exact physical location",
                    "private-person identity",
                ],
            },
            {
                "candidate_fact": f"{len(usage_eras)} IP usage-era candidates were constructed; historical attributes must not be automatically applied to current state.",
                "status": "SUPPORTED_AS_TEMPORAL_CANDIDATE_ONLY",
                "evidence_ids": ["AGGREGATE"],
                "notes": "Requires independent temporal sources for reassignment/sinkhole/seizure/cloud tenant adjudication.",
            },
            {
                "candidate_fact": "No exploitation, scanning, interception, routing modification, DDoS, BGP hijack, DNS poisoning, or private-person tracking was performed.",
                "status": "SUPPORTED",
                "evidence_ids": ["LOCAL_PANEL_POLICY"],
                "notes": "Defensive/passive planning boundary.",
            },
        ])

        candidate_facts, _ = truncate_list(candidate_facts, 200)

        fact_gate = {
            "status": "LOCAL_DETERMINISTIC_ONLY" if files or entities else "NO_LOCAL_IPINT_EVIDENCE",
            "supported": [
                "file existence and SHA256 hash",
                "IPv4/IPv6 normalization",
                "special-use/non-public/documentation/CGNAT flags",
                "prefix/CIDR format validation",
                "ASN format validation",
                "parsed IP/prefix/ASN/PTR/domain/certificate/service/provider/reputation/threat candidates",
                "conservative relationship extraction",
                "temporal fields where supplied",
                "IP usage era candidates",
                "contradiction candidates",
                "secret redaction flags",
                "prompt-injection flags",
            ],
            "not_supported": [
                "verified IP ownership",
                "verified tenant identity",
                "verified application operator",
                "verified current control",
                "verified maliciousness",
                "verified BGP origin without routing evidence",
                "verified geolocation precision",
                "private-person identity",
                "exact physical location",
                "active service validation",
                "origin server identification",
                "offensive validation",
                "autonomous blocking action",
            ],
            "privacy_status": "No private-person tracking. No credential use. No payload execution. No traffic interception. No network access.",
        }

        return {
            "mode": "LOCAL_DETERMINISTIC_IPINT_ANALYSIS",
            "panel_version": APP_VERSION,
            "policy_screen": policy,
            "network_calls_performed": False,
            "active_scanning_performed": False,
            "exploitation_performed": False,
            "traffic_interception_performed": False,
            "ddos_or_flooding_performed": False,
            "routing_modification_performed": False,
            "bgp_hijack_performed": False,
            "dns_poisoning_performed": False,
            "private_person_tracking_performed": False,
            "evidence_inventory": files,
            "ip_inventory_preview": [e for e in entities if e.get("type") == "IP"][:300],
            "prefix_inventory_preview": [e for e in entities if e.get("type") == "PREFIX"][:300],
            "asn_inventory_preview": [e for e in entities if e.get("type") == "ASN"][:300],
            "ptr_inventory_preview": [e for e in entities if e.get("type") == "PTR"][:300],
            "domain_inventory_preview": [e for e in entities if e.get("type") == "DOMAIN"][:300],
            "certificate_inventory_preview": [e for e in entities if e.get("type") == "CERTIFICATE"][:300],
            "service_inventory_preview": [e for e in entities if e.get("type") in {"SERVICE", "PORT"}][:300],
            "reputation_inventory_preview": [e for e in entities if e.get("type") in {"REPUTATION", "THREAT"}][:300],
            "provider_inventory_preview": [e for e in entities if e.get("type") == "PROVIDER"][:300],
            "relationship_preview": relationships[:300],
            "relationship_count": len(relationships),
            "ip_usage_eras": usage_eras[:1000],
            "contradictions": contradictions[:1000],
            "hypotheses": hypotheses,
            "observations": observations,
            "candidate_facts": candidate_facts,
            "fact_gate": fact_gate,
            "knowledge_gaps": knowledge_gaps,
            "specialist_handoffs": handoffs,
            "recommended_next_actions": next_action,
            "limitations": [
                "Only local deterministic checks were performed.",
                "No network access was performed.",
                "No active scanning, service enumeration, or vulnerability scanning was performed.",
                "No exploitation, credential use, authentication bypass, or payload execution was performed.",
                "No traffic interception, MITM, DDoS, SYN flood, reflection, or amplification was performed.",
                "No routing modification, BGP hijack, or DNS poisoning was performed.",
                "No private-person tracking or exact home-location inference was performed.",
                "IP address is not a person.",
                "Allocation is not application ownership.",
                "ASN is not tenant identity.",
                "Hosting provider is not application operator.",
                "Cloud provider is not cloud tenant.",
                "CDN edge is not origin server.",
                "PTR is not verified ownership.",
                "Open port is not vulnerability.",
                "Service banner is not verified software version.",
                "Historical reputation is not current maliciousness.",
                "Multiple copied reputation sources are not independent evidence.",
                "Exposed secrets were redacted heuristically and not used.",
                "PTR, banners, logs, certificates, and threat reports were treated as untrusted evidence.",
            ],
        }

    def _write_output(self, result: Dict[str, Any]) -> None:
        self.output.delete("1.0", "end")
        self.output.insert("1.0", json.dumps(result, ensure_ascii=False, indent=2, default=str))

    def _policy_sections(self) -> Dict[str, Any]:
        return {
            "role": {
                "employee": "IPINT AI Employee",
                "hierarchy": [
                    "Chief Intelligence Manager",
                    "Cyber / Infrastructure Intelligence Manager",
                    "INFRAINT Manager",
                    "IPINT Manager",
                    "IPINT AI Employee",
                    "IP / Prefix / ASN / Routing / Exposure / Reputation Skills",
                ],
                "not": [
                    "unauthorized scanner",
                    "exploitation agent",
                    "credential attack system",
                    "port-scanning bot",
                    "traffic interception system",
                    "DDoS platform",
                    "firewall bypass agent",
                    "private-person tracker",
                    "autonomous threat-blocking system",
                ],
            },
            "primary_mission": [
                "Determine IP identity, address family, special-use status, prefix/RIR/ASN/BGP/RPKI context, PTR/pDNS/certificate relationships, service/exposure metadata, reputation/threat context, reassignment risk, and usage eras.",
                "Keep every material conclusion linked to IP, source, observation time, validity period, provider, evidence, confidence, and limitations.",
            ],
            "ipint_vs_other_intelligence": {
                "IPINT": "deep IP-specific identity/history/context",
                "INFRAINT": "broader Internet infrastructure synthesis",
                "ASNINT": "autonomous-system organization/prefix/portfolio/routing context",
                "BGPINT": "routing events, origin changes, MOAS, route leaks, RPKI, prefix history",
                "NETINT": "network flows, topology, telemetry, routing behavior",
                "DNSINT": "DNS records and DNS history",
                "CERTINT": "certificate intelligence",
