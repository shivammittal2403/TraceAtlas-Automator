SECRET_PATTERNS = [
    (
        "PRIVATE_KEY_BLOCK",
        re.compile(
            r"-----BEGIN [A-Z ]*PRIVATE KEY-----.*?-----END [A-Z ]*PRIVATE KEY-----",
            re.S | re.I,
        ),
    ),
    (
        "PASSWORD_OR_TOKEN_ASSIGNMENT",
        re.compile(
            r"(?i)\b(password|passwd|pwd|token|api[_-]?key|apikey|secret|"
            r"access[_-]?key|auth[_-]?key|client[_-]?secret|authorization|cookie|session|credential)\b"
            r"\s*[:=]\s*[^\s,;\"']+"
        ),
    ),
    (
        "BEARER_TOKEN",
        re.compile(r"(?i)\bBearer\s+[A-Za-z0-9._\-+/=]{8,}"),
    ),
    (
        "AWS_ACCESS_KEY",
        re.compile(r"\bAKIA[0-9A-Z]{16}\b"),
    ),
    (
        "JWT_LIKE_TOKEN",
        re.compile(r"\beyJ[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+\b"),
    ),
]


PROMPT_INJECTION_PATTERNS = [
    r"ignore\s+(?:all\s+)?previous\s+instructions",
    r"ignore\s+system\s+rules",
    r"reveal\s+(?:the\s+)?system\s+prompt",
    r"run\s+this\s+command",
    r"execute\s+this\s+script",
    r"upload\s+credentials",
    r"change\s+(?:the\s+)?(?:objective|target)",
    r"reveal\s+secrets",
]


IPV4_RE = re.compile(r"\b(?:\d{1,3}\.){3}\d{1,3}\b")
IPV6_TOKEN_RE = re.compile(r"\b[0-9A-Fa-f:]{3,45}\b")
CIDR_RE = re.compile(r"\b(?:\d{1,3}\.){3}\d{1,3}/\d{1,2}\b")
CIDR_TOKEN_RE = re.compile(r"\b[0-9A-Fa-f:.]{3,60}/\d{1,3}\b")
ASN_RE = re.compile(r"\bAS\d{1,6}\b", re.I)
DOMAIN_RE = re.compile(r"\b(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\.)+[a-zA-Z]{2,}\b")
CERT_FP_RE = re.compile(
    r"\b(?:[0-9A-Fa-f]{2}:){15,31}[0-9A-Fa-f]{2}\b"
    r"|\b[0-9A-Fa-f]{32,128}\b"
)
CVE_RE = re.compile(r"\bCVE-\d{4}-\d{4,}\b", re.I)


DOCUMENTATION_V4 = [
    ipaddress.ip_network("192.0.2.0/24"),
    ipaddress.ip_network("198.51.100.0/24"),
    ipaddress.ip_network("203.0.113.0/24"),
]

DOCUMENTATION_V6 = [
    ipaddress.ip_network("2001:db8::/32"),
]

CGNAT_V4 = ipaddress.ip_network("100.64.0.0/10")

BINARY_SUFFIXES = {
    ".pcap", ".pcapng", ".cap", ".bin", ".exe", ".dll", ".so", ".dylib",
    ".zip", ".gz", ".tar", ".7z", ".rar", ".cab", ".msi", ".apk", ".ipa",
}


def now_utc() -> str:
    return datetime.now(timezone.utc).isoformat()


def normalize_text(value: str) -> str:
    return re.sub(r"\s+", " ", value or "").strip().lower()


def parse_list(value: str) -> List[Any]:
    value = value.strip()
    if not value:
        return []

    try:
        parsed = json.loads(value)
        if isinstance(parsed, list):
            return parsed
        if isinstance(parsed, dict):
            return [parsed]
    except Exception:
        pass

    normalized = value.replace(",", "\n")
    parts = [p.strip() for p in normalized.splitlines()]
    return [p for p in parts if p]


def parse_dict(value: str) -> Dict[str, Any]:
    value = value.strip()
    if not value:
        return {}

    try:
        parsed = json.loads(value)
        if isinstance(parsed, dict):
            return parsed
    except Exception:
        pass

    result: Dict[str, Any] = {}
    for line in value.splitlines():
        line = line.strip()
        if not line or ":" not in line:
            continue
        key, val = line.split(":", 1)
        result[key.strip()] = val.strip()
    return result


def as_list(value: Any) -> List[str]:
    if value is None:
        return []
    if isinstance(value, list):
        return [str(x).strip() for x in value if str(x).strip()]
    if isinstance(value, dict):
        return [json.dumps(value, ensure_ascii=False, default=str)]
    text = str(value).strip()
    if not text:
        return []
    parts = re.split(r"[,;\n]+", text)
    return [p.strip() for p in parts if p.strip()]


def first_scalar(value: Any) -> Any:
    if isinstance(value, list):
        return first_scalar(value[0]) if value else None
    if isinstance(value, dict):
        return json.dumps(value, ensure_ascii=False, default=str)
    return value


def get_field(rec: Dict[str, Any], keys: List[str]) -> Any:
    if not isinstance(rec, dict):
        return None

    lower = {str(k).lower(): v for k, v in rec.items()}
    for key in keys:
        val = lower.get(key)
        if val not in (None, ""):
            return first_scalar(val)
    return None


def sha256_text(text: str) -> str:
    return hashlib.sha256((text or "").encode("utf-8", errors="replace")).hexdigest()


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def redact_secrets(text: str) -> Tuple[str, List[str]]:
    flags: List[str] = []
    if not text:
        return "", flags

    out = text
    for name, rx in SECRET_PATTERNS:
        if rx.search(out):
            flags.append(name)
            out = rx.sub("[REDACTED_SECRET]", out)

    return out, sorted(set(flags))


def detect_prompt_injection(text: str) -> List[str]:
    flags: List[str] = []
    low = normalize_text(text)
    for pattern in PROMPT_INJECTION_PATTERNS:
        if re.search(pattern, low, re.I):
            flags.append(pattern)
    return sorted(set(flags))


def normalize_domain(value: str) -> str:
    original = str(value or "").strip()
    if not original:
        return ""

    v = original.lower().rstrip(".")
    if "://" in v:
        try:
            from urllib.parse import urlparse
            parsed = urlparse(v)
            v = (parsed.netloc or "").lower()
            if ":" in v and not v.startswith("["):
                v = v.split(":", 1)[0]
        except Exception:
            pass

    if v.startswith("[") and v.endswith("]"):
        v = v[1:-1]

    try:
        v = v.encode("idna").decode("ascii")
    except Exception:
        pass

    return v


def normalize_asn(value: Any) -> Optional[str]:
    s = str(value or "").strip().upper()
    s = re.sub(r"^ASN[-_ ]?", "AS", s)
    s = re.sub(r"[^A-Z0-9]", "", s)
    m = re.fullmatch(r"AS(\d{1,6})", s)
    if not m:
        return None
    num = int(m.group(1))
    if 0 < num <= 4294967295:
        return f"AS{num}"
    return None


def classify_ip(value: Any) -> Dict[str, Any]:
    original = str(value or "").strip().strip("[]")
    result: Dict[str, Any] = {
        "original": original,
        "normalized": original,
        "version": "INVALID",
        "valid": False,
        "method": "ipaddress",
        "special_use": ["INVALID"],
        "requires_nonpublic_context": False,
        "is_private": False,
        "is_loopback": False,
        "is_link_local": False,
        "is_multicast": False,
        "is_reserved": False,
        "is_unspecified": False,
        "is_documentation": False,
        "is_cgnat": False,
        "is_ipv4_mapped_ipv6": False,
    }

    if not original:
        result["method"] = "empty"
        return result

    try:
        ip = ipaddress.ip_address(original)
    except Exception:
        result["method"] = "ipaddress_failed"
        return result

    special = set()

    bool_attrs = [
        ("is_private", "PRIVATE"),
        ("is_loopback", "LOOPBACK"),
        ("is_link_local", "LINK_LOCAL"),
        ("is_multicast", "MULTICAST"),
        ("is_reserved", "RESERVED"),
        ("is_unspecified", "UNSPECIFIED"),
    ]

    for attr, label in bool_attrs:
        try:
            val = bool(getattr(ip, attr, False))
            result[attr] = val
            if val:
                special.add(label)
        except Exception:
            pass

    if ip.version == 4:
        try:
            if ip in CGNAT_V4:
                special.add("CGNAT")
                result["is_cgnat"] = True
        except Exception:
            pass

        for net in DOCUMENTATION_V4:
            try:
                if ip in net:
                    special.add("DOCUMENTATION")
                    result["is_documentation"] = True
            except Exception:
                pass
    else:
        try:
            if bool(getattr(ip, "is_ipv4_mapped", False)):
                special.add("IPV4_MAPPED_IPV6")
                result["is_ipv4_mapped_ipv6"] = True
        except Exception:
            pass

        for net in DOCUMENTATION_V6:
            try:
                if ip in net:
                    special.add("DOCUMENTATION")
                    result["is_documentation"] = True
            except Exception:
                pass

    try:
        if bool(getattr(ip, "is_global", False)) and not special:
            special.add("PUBLICLY_ROUTABLE_CANDIDATE")
    except Exception:
        pass

    if not special:
        special.add("UNKNOWN_SPECIAL_USE")

    result.update({
        "normalized": str(ip),
        "version": f"IPV{ip.version}",
        "valid": True,
        "special_use": sorted(special),
        "requires_nonpublic_context": bool(
            special & {
                "PRIVATE",
                "LOOPBACK",
                "LINK_LOCAL",
                "UNSPECIFIED",
                "MULTICAST",
                "RESERVED",
                "CGNAT",
                "DOCUMENTATION",
                "IPV4_MAPPED_IPV6",
            }
        ),
    })

    return result


def valid_ip(value: Any) -> bool:
    return classify_ip(value)["valid"]


def classify_cidr(value: Any) -> Dict[str, Any]:
    original = str(value or "").strip()
    result: Dict[str, Any] = {
        "original": original,
        "normalized": original,
        "type": "INVALID_PREFIX",
        "valid": False,
        "method": "ip_network",
        "version": "INVALID",
        "network": None,
        "prefixlen": None,
        "num_addresses": None,
        "special_use": [],
    }

    if not original:
        result["method"] = "empty"
        return result

    try:
        net = ipaddress.ip_network(original, strict=False)
    except Exception:
        result["method"] = "ip_network_failed"
        return result

    special = []
    try:
        if net.is_private:
            special.append("PRIVATE")
        if net.is_loopback:
            special.append("LOOPBACK")
        if net.is_link_local:
            special.append("LINK_LOCAL")
        if net.is_multicast:
            special.append("MULTICAST")
        if net.is_reserved:
            special.append("RESERVED")
        if net.is_unspecified:
            special.append("UNSPECIFIED")
    except Exception:
        pass

    if net.version == 4:
        try:
            if net.subnet_of(CGNAT_V4):
                special.append("CGNAT")
        except Exception:
            pass
        for doc in DOCUMENTATION_V4:
            try:
                if net.subnet_of(doc):
                    special.append("DOCUMENTATION")
            except Exception:
                pass
    else:
        for doc in DOCUMENTATION_V6:
            try:
                if net.subnet_of(doc):
                    special.append("DOCUMENTATION")
            except Exception:
                pass

    result.update({
        "normalized": str(net),
        "type": f"IPV{net.version}_PREFIX",
        "valid": True,
        "version": f"IPV{net.version}",
        "network": str(net.network_address),
        "prefixlen": net.prefixlen,
        "num_addresses": net.num_addresses,
        "special_use": sorted(set(special)) or ["PUBLIC_PREFIX_CANDIDATE"],
    })

    return result


def empty_parsed() -> Dict[str, Any]:
    return {
        "entities": [],
        "relationships": [],
        "observations": [],
        "notes": [],
    }


def add_entity(
    parsed: Dict[str, Any],
    etype: str,
    value: Any,
    source_id: str,
    evidence_id: str,
    context: str = "",
    extra: Optional[Dict[str, Any]] = None,
) -> Optional[Dict[str, Any]]:
    if len(parsed.get("entities", [])) >= 100000:
        return None

    raw = str(value or "").strip()
    if not raw:
        return None

    redacted, secret_flags = redact_secrets(raw)
    injection_flags = detect_prompt_injection(raw)

    entity: Dict[str, Any] = {
        "entity_id": f"ENT-{uuid.uuid4()}",
        "type": str(etype or "UNKNOWN").upper(),
        "value": redacted[:300],
        "original": raw[:300],
        "source_id": source_id,
        "evidence_id": evidence_id,
        "context": context[:200],
        "state": "OBSERVED",
        "secret_flags": secret_flags,
        "prompt_injection_flags": injection_flags,
        "content_hash": sha256_text(raw),
        "parser_version": "0.1",
        "analysis_version": APP_VERSION,
        "limitations": [
            "Observed value only; allocation/ownership/tenant/operator not established.",
            "No active scanning, exploitation, interception, routing modification, or private-person tracking performed.",
        ],
    }

    if extra:
        temporal = extra.pop("temporal", None)
        for k, v in extra.items():
            if k not in entity:
                entity[k] = v
        if isinstance(temporal, dict):
            for k, v in temporal.items():
                if v not in (None, "") and k not in entity:
                    entity[k] = str(v)

    parsed["entities"].append(entity)

    if secret_flags:
        parsed["notes"].append({
            "type": "SECRET_REDACTION",
            "flags": secret_flags,
            "source_id": source_id,
            "evidence_id": evidence_id,
            "context": context[:120],
        })

    if injection_flags:
        parsed["notes"].append({
            "type": "PROMPT_INJECTION_FLAG",
            "flags": injection_flags,
            "source_id": source_id,
            "evidence_id": evidence_id,
            "context": context[:120],
            "caution": "PTR/banner/log/threat content is untrusted evidence, not instructions.",
        })

    return entity


def add_relationship(
    parsed: Dict[str, Any],
    src: Any,
    rel: str,
    tgt: Any,
    source_id: str,
    evidence_id: str,
    note: str = "",
    temporal: Optional[Dict[str, Any]] = None,
) -> Optional[Dict[str, Any]]:
    if len(parsed.get("relationships", [])) >= 100000:
        return None

    src_s = str(src or "").strip()
    tgt_s = str(tgt or "").strip()
    if not src_s or not tgt_s:
        return None

    rel_obj: Dict[str, Any] = {
        "relationship_id": f"REL-{uuid.uuid4()}",
        "source_ref": src_s[:200],
        "relationship": str(rel or "RELATED_TO").upper(),
        "target_ref": tgt_s[:200],
        "source_id": source_id,
        "evidence_id": evidence_id,
        "state": "OBSERVED",
        "note": note[:300],
        "content_hash": sha256_text(f"{src_s}|{rel}|{tgt_s}"),
        "parser_version": "0.1",
        "analysis_version": APP_VERSION,
        "limitations": [
            "Relationship is observational; does not prove ownership, tenancy, control, or current state.",
            "Temporal validity must be preserved.",
        ],
    }

    if temporal:
        clean = {k: str(v) for k, v in temporal.items() if v not in (None, "")}
        if clean:
            rel_obj["temporal"] = clean

    parsed["relationships"].append(rel_obj)
    return rel_obj


def add_observation(
    parsed: Dict[str, Any],
    subject: str,
    predicate: str,
    value: Any,
    source_id: str,
    evidence_id: str,
    temporal: Optional[Dict[str, Any]] = None,
) -> None:
    if len(parsed.get("observations", [])) >= 100000:
        return

    raw = str(value or "").strip()
    if not raw:
        return

    redacted, secret_flags = redact_secrets(raw)
    injection_flags = detect_prompt_injection(raw)

    obs: Dict[str, Any] = {
        "observation_id": f"OBS-{uuid.uuid4()}",
        "subject": str(subject or "")[:200],
        "predicate": str(predicate or "")[:200],
        "value": redacted[:500],
        "source_id": source_id,
        "evidence_id": evidence_id,
        "state": "SOURCE_OBSERVED",
        "secret_flags": secret_flags,
        "prompt_injection_flags": injection_flags,
        "content_hash": sha256_text(raw),
        "limitations": [
            "Source observation is not independently verified external truth.",
        ],
    }

    if temporal:
        clean = {k: str(v) for k, v in temporal.items() if v not in (None, "")}
        if clean:
            obs["temporal"] = clean

    parsed["observations"].append(obs)


def extract_ip_entities(
    text: str,
    source_id: str,
    evidence_id: str,
    context: str = "",
    limit: int = 10000,
) -> Tuple[List[Dict[str, Any]], List[str]]:
    parsed = empty_parsed()
    redacted, secret_flags = redact_secrets(text or "")

    seen = set()

    def push(etype: str, value: Any, extra: Optional[Dict[str, Any]] = None) -> None:
        if len(parsed["entities"]) >= limit:
            return
        key = (etype, str(value or "").strip())
        if key in seen:
            return
        seen.add(key)
        add_entity(parsed, etype, value, source_id, evidence_id, context, extra)

    for val in CIDR_RE.findall(redacted):
        cls = classify_cidr(val)
        if cls["valid"]:
            push("PREFIX", cls["normalized"], {
                "version": cls["version"],
                "prefixlen": cls["prefixlen"],
                "special_use": cls["special_use"],
            })

    for val in CIDR_TOKEN_RE.findall(redacted):
        cls = classify_cidr(val)
        if cls["valid"]:
            push("PREFIX", cls["normalized"], {
                "version": cls["version"],
                "prefixlen": cls["prefixlen"],
                "special_use": cls["special_use"],
            })

    for val in IPV4_RE.findall(redacted):
        cls = classify_ip(val)
        if cls["valid"]:
            push("IP", cls["normalized"], {
                "version": cls["version"],
                "special_use": cls["special_use"],
                "requires_nonpublic_context": cls["requires_nonpublic_context"],
            })
        else:
            push("INVALID_IP", val)

    for val in IPV6_TOKEN_RE.findall(redacted):
        if ":" not in val:
            continue
        cls = classify_ip(val)
        if cls["valid"] and cls["version"] == "IPV6":
            push("IP", cls["normalized"], {
                "version": cls["version"],
                "special_use": cls["special_use"],
                "requires_nonpublic_context": cls["requires_nonpublic_context"],
            })

    for val in ASN_RE.findall(redacted):
        asn = normalize_asn(val)
        if asn:
            push("ASN", asn)

    for val in DOMAIN_RE.findall(redacted):
        dom = normalize_domain(val)
        if dom and DOMAIN_RE.fullmatch(dom):
            push("DOMAIN", dom)

    for val in CERT_FP_RE.findall(redacted):
        push("CERTIFICATE", val.upper())

    for val in CVE_RE.findall(redacted):
        push("CVE", val.upper())

    return parsed["entities"], secret_flags


CORE_KEYS = {
    "ip", "address", "ipv4", "ipv6", "ip_address",
    "prefix", "cidr", "network", "netblock", "ip_network",
    "asn", "origin_as", "autonomous_system", "autonomous_system_number",
    "ptr", "reverse_dns", "reverse", "pointer", "hostname",
    "domain", "fqdn", "registered_domain", "qname", "query_name",
    "certificate", "fingerprint", "sha256", "cert", "tls_certificate",
    "port", "destination_port", "source_port",
    "service", "protocol", "banner", "product", "version", "server", "software",
    "reputation", "score", "verdict", "classification", "category",
    "threat", "campaign", "malware", "actor", "incident", "activity", "family",
    "provider", "organization", "org", "isp", "hosting_provider", "cloud_provider", "cdn", "owner", "company",
    "country", "country_code", "geo_country", "region", "state", "province", "city", "locality",
    "first_seen", "first_observed", "created", "registration_date",
    "last_seen", "last_observed", "updated", "modified",
    "observed_at", "timestamp", "time", "valid_from", "start", "valid_to", "end",
}


def collect_records(data: Any, out: List[Dict[str, Any]], depth: int = 0, limit: int = 50000) -> None:
    if depth > 12 or len(out) >= limit:
        return

    if isinstance(data, dict):
        keys = {str(k).lower() for k in data.keys()}
        if keys & CORE_KEYS:
            out.append(data)
        for val in data.values():
            collect_records(val, out, depth + 1, limit)
    elif isinstance(data, list):
        for item in data:
            collect_records(item, out, depth + 1, limit)


def build_temporal(rec: Dict[str, Any]) -> Dict[str, str]:
    temporal: Dict[str, str] = {}

    first = get_field(rec, ["first_seen", "first_observed", "created", "registration_date"])
    last = get_field(rec, ["last_seen", "last_observed", "updated", "modified"])
    observed = get_field(rec, ["observed_at", "timestamp", "time"])
    valid_from = get_field(rec, ["valid_from", "start"])
    valid_to = get_field(rec, ["valid_to", "end"])

    if first:
        temporal["first_seen"] = str(first)
    if last:
        temporal["last_seen"] = str(last)
    if observed:
        temporal["observed_at"] = str(observed)
    if valid_from:
        temporal["valid_from"] = str(valid_from)
    if valid_to:
        temporal["valid_to"] = str(valid_to)

    return temporal


def process_record(rec: Dict[str, Any], source_id: str, evidence_id: str, parsed: Dict[str, Any]) -> None:
    if not isinstance(rec, dict):
        return

    temporal = build_temporal(rec)

    ip_raw = get_field(rec, ["ip", "address", "ipv4", "ipv6", "ip_address"])
    prefix_raw = get_field(rec, ["prefix", "cidr", "network", "netblock", "ip_network"])
    asn_raw = get_field(rec, ["asn", "origin_as", "autonomous_system", "autonomous_system_number"])
    ptr_raw = get_field(rec, ["ptr", "reverse_dns", "reverse", "pointer", "hostname"])
    domain_raw = get_field(rec, ["domain", "fqdn", "registered_domain", "qname", "query_name"])
    cert_raw = get_field(rec, ["certificate", "fingerprint", "sha256", "cert", "tls_certificate"])
    port_raw = get_field(rec, ["port", "destination_port", "source_port"])
    service_raw = get_field(rec, ["service", "protocol", "banner", "product", "version", "server", "software"])
    rep_raw = get_field(rec, ["reputation", "score", "verdict", "classification", "category"])
    threat_raw = get_field(rec, ["threat", "campaign", "malware", "actor", "incident", "activity", "family"])
    provider_raw = get_field(rec, ["provider", "organization", "org", "isp", "hosting_provider", "cloud_provider", "cdn", "owner", "company"])
    country_raw = get_field(rec, ["country", "country_code", "geo_country"])
    region_raw = get_field(rec, ["region", "state", "province"])
    city_raw = get_field(rec, ["city", "locality"])

    ip_norm = None
    prefix_norm = None
    asn_norm = None
    ptr_norm = None
    domain_norm = None
    cert_norm = None
    service_norm = None
    provider_norm = None
    rep_norm = None
    threat_norm = None
    country_norm = None
    region_norm = None
    city_norm = None
    port_norm = None

    if ip_raw:
        cls = classify_ip(ip_raw)
        if cls["valid"]:
            ip_norm = cls["normalized"]
            add_entity(parsed, "IP", ip_norm, source_id, evidence_id, "record_ip", {
                "version": cls["version"],
                "special_use": cls["special_use"],
                "requires_nonpublic_context": cls["requires_nonpublic_context"],
                "temporal": temporal,
            })
        else:
            add_entity(parsed, "INVALID_IP", ip_raw, source_id, evidence_id, "record_ip", {"temporal": temporal})

    if prefix_raw:
        cls = classify_cidr(prefix_raw)
        if cls["valid"]:
            prefix_norm = cls["normalized"]
            add_entity(parsed, "PREFIX", prefix_norm, source_id, evidence_id, "record_prefix", {
                "version": cls["version"],
                "prefixlen": cls["prefixlen"],
                "special_use": cls["special_use"],
                "temporal": temporal,
            })

    if asn_raw:
        asn_norm = normalize_asn(asn_raw)
        if asn_norm:
            add_entity(parsed, "ASN", asn_norm, source_id, evidence_id, "record_asn", {"temporal": temporal})

    if ptr_raw:
        ptr_norm = normalize_domain(ptr_raw)
        if ptr_norm:
            add_entity(parsed, "PTR", ptr_norm, source_id, evidence_id, "record_ptr", {"temporal": temporal})

    if domain_raw:
        domain_norm = normalize_domain(domain_raw)
        if domain_norm:
            add_entity(parsed, "DOMAIN", domain_norm, source_id, evidence_id, "record_domain", {"temporal": temporal})

    if cert_raw:
        cert_norm = str(cert_raw).strip().upper()
        if cert_norm:
            add_entity(parsed, "CERTIFICATE", cert_norm, source_id, evidence_id, "record_certificate", {"temporal": temporal})

    if port_raw:
        port_norm = str(port_raw).strip()
        if port_norm:
            add_entity(parsed, "PORT", port_norm, source_id, evidence_id, "record_port", {"temporal": temporal})

    if service_raw:
        service_norm = str(service_raw).strip()
        if service_norm:
            add_entity(parsed, "SERVICE", service_norm, source_id, evidence_id, "record_service", {"temporal": temporal})

    if provider_raw:
        provider_norm = str(provider_raw).strip()
        if provider_norm:
            add_entity(parsed, "PROVIDER", provider_norm, source_id, evidence_id, "record_provider", {"temporal": temporal})

    if rep_raw:
        rep_norm = str(rep_raw).strip()
        if rep_norm:
            add_entity(parsed, "REPUTATION", rep_norm, source_id, evidence_id, "record_reputation", {"temporal": temporal})

    if threat_raw:
        threat_norm = str(threat_raw).strip()
        if threat_norm:
            add_entity(parsed, "THREAT", threat_norm, source_id, evidence_id, "record_threat", {"temporal": temporal})

    if country_raw:
        country_norm = str(country_raw).strip().upper()
        if country_norm:
            add_entity(parsed, "GEO_COUNTRY", country_norm, source_id, evidence_id, "record_geo", {"temporal": temporal})

    if region_raw:
        region_norm = str(region_raw).strip()
        if region_norm:
            add_entity(parsed, "GEO_REGION", region_norm, source_id, evidence_id, "record_geo", {"temporal": temporal})

    if city_raw:
        city_norm = str(city_raw).strip()
        if city_norm:
            add_entity(parsed, "GEO_CITY", city_norm, source_id, evidence_id, "record_geo", {"temporal": temporal})

    if ip_norm and prefix_norm:
        add_relationship(parsed, ip_norm, "PART_OF", prefix_norm, source_id, evidence_id, "Record IP-prefix co-occurrence.", temporal)

    if ip_norm and asn_norm:
        add_relationship(parsed, ip_norm, "ANNOUNCED_BY", asn_norm, source_id, evidence_id, "Record IP-ASN co-occurrence; BGP evidence required for routing confirmation.", temporal)

    if ip_norm and provider_norm:
        add_relationship(parsed, ip_norm, "HOSTED_BY_CANDIDATE", provider_norm, source_id, evidence_id, "Provider candidate from record; hosting != operator/tenant.", temporal)

    if ip_norm and ptr_norm:
        add_relationship(parsed, ip_norm, "PTR_TO", ptr_norm, source_id, evidence_id, "PTR is operator-configured metadata, not ownership proof.", temporal)

    if domain_norm and ip_norm:
        add_relationship(parsed, domain_norm, "RESOLVES_TO", ip_norm, source_id, evidence_id, "Domain-IP record co-occurrence; DNS timestamp required.", temporal)

    if ip_norm and cert_norm:
        add_relationship(parsed, ip_norm, "SERVED_CERTIFICATE", cert_norm, source_id, evidence_id, "Certificate association may be multi-tenant/shared.", temporal)

    if ip_norm and service_norm:
        add_relationship(parsed, ip_norm, "OBSERVED_SERVICE", service_norm, source_id, evidence_id, "Service metadata candidate; not active validation.", temporal)

    if ip_norm and port_norm:
        add_relationship(parsed, ip_norm, "PORT_OBSERVATION", port_norm, source_id, evidence_id, "Port observation is not vulnerability.", temporal)

    if ip_norm and rep_norm:
        add_relationship(parsed, ip_norm, "REPORTED_AS", rep_norm, source_id, evidence_id, "Reputation is source-reported and time-sensitive.", temporal)

    if ip_norm and threat_norm:
        add_relationship(parsed, ip_norm, "REPORTED_IN_CAMPAIGN", threat_norm, source_id, evidence_id, "Threat relationship is source-attributed; CTI adjudication required.", temporal)

    if ip_norm and country_norm:
        add_relationship(parsed, ip_norm, "GEO_COUNTRY_CANDIDATE", country_norm, source_id, evidence_id, "Geolocation is approximate and provider-dependent.", temporal)

    if ip_norm and region_norm:
        add_relationship(parsed, ip_norm, "GEO_REGION_CANDIDATE", region_norm, source_id, evidence_id, "Geolocation is approximate and provider-dependent.", temporal)

    if ip_norm and city_norm:
        add_relationship(parsed, ip_norm, "GEO_CITY_CANDIDATE", city_norm, source_id, evidence_id, "Geolocation is approximate; never exact person/home location.", temporal)

    if prefix_norm and asn_norm:
        add_relationship(parsed, prefix_norm, "ANNOUNCED_BY", asn_norm, source_id, evidence_id, "Prefix-ASN record co-occurrence.", temporal)

    if ip_norm:
        add_observation(parsed, ip_norm, "record_present", json.dumps(rec, ensure_ascii=False, default=str)[:1000], source_id, evidence_id, temporal)


def detect_format(path: Path) -> Dict[str, str]:
    suffix = path.suffix.lower()

    try:
        with path.open("rb") as f:
            head = f.read(256)
    except Exception as exc:
        return {"format_detected": "UNKNOWN", "mime_type": "application/octet-stream", "format_error": str(exc)}

    if suffix in BINARY_SUFFIXES:
        return {"format_detected": "BINARY_ARTIFACT", "mime_type": "application/octet-stream"}

    if head[:4] in {b"\xd4\xc3\xb2\xa1", b"\xa1\xb2\xc3\xd4", b"\x4d\x3c\xb2\xa1", b"\xa1\xb2\x3c\x4d"} or head.startswith(b"\x0a\x0d\x0d\x0a"):
        return {"format_detected": "PCAP", "mime_type": "application/vnd.tcpdump.pcap"}

    stripped = head.lstrip()

    if suffix == ".json" or stripped.startswith(b"{") or stripped.startswith(b"["):
        return {"format_detected": "JSON", "mime_type": "application/json"}

    if suffix in {".csv", ".tsv"}:
        return {"format_detected": "CSV", "mime_type": "text/csv"}

    if b"," in head and b"\n" in head and all(b in b"\x09\x0a\x0d\x20" or 32 <= b <= 126 for b in head[:64]):
        return {"format_detected": "CSV", "mime_type": "text/csv"}

    try:
        probe = head.decode("utf-8", errors="strict")
        if probe.strip():
            return {"format_detected": "TEXT", "mime_type": "text/plain"}
    except Exception:
        pass

    return {"format_detected": "UNKNOWN", "mime_type": "application/octet-stream"}


def process_json_file(path: Path, source_id: str, evidence_id: str) -> Tuple[str, Dict[str, Any]]:
    parsed = empty_parsed()
    raw = path.read_text(encoding="utf-8", errors="replace")[:20_000_000]
    data = json.loads(raw)

    records: List[Dict[str, Any]] = []
    collect_records(data, records)

    for rec in records[:50000]:
        process_record(rec, source_id, evidence_id, parsed)

    ents, secret_flags = extract_ip_entities(raw, source_id, evidence_id, "json_text", limit=10000)
    parsed["entities"].extend(ents)

    if secret_flags:
        parsed["notes"].append({
            "type": "SECRET_REDACTION",
            "flags": secret_flags,
            "source_id": source_id,
            "evidence_id": evidence_id,
        })

    return "JSON_IP_DATA", parsed


def process_csv_file(path: Path, source_id: str, evidence_id: str) -> Tuple[str, Dict[str, Any]]:
    parsed = empty_parsed()
    kind = "CSV_IP_DATA"

    with path.open("r", encoding="utf-8", errors="replace", newline="") as f:
        sample = f.read(1_000_000)
        f.seek(0)

        try:
            dialect = csv.Sniffer().sniff(sample, delimiters=",;\t| ")
        except csv.Error:
            dialect = csv.excel

        reader = csv.DictReader(f, dialect=dialect)
        header = reader.fieldnames or []
        lower_header = [str(h).lower() for h in header]

        if any(x in lower_header for x in ["ip", "address", "prefix", "cidr", "asn"]):
            kind = "CSV_IP_RECORDS"
        elif any(x in lower_header for x in ["domain", "fqdn", "ptr", "hostname"]):
            kind = "CSV_DNS_PTR_RECORDS"
        elif any(x in lower_header for x in ["reputation", "score", "threat", "campaign"]):
            kind = "CSV_REPUTATION_THREAT_RECORDS"

        for idx, row in enumerate(reader):
            if idx >= 100000:
                break
            process_record(row, source_id, evidence_id, parsed)

            joined = " ".join(str(v) for v in row.values() if v not in (None, ""))
            ents, secret_flags = extract_ip_entities(joined, source_id, evidence_id, f"csv_row_{idx}", limit=200)
            parsed["entities"].extend(ents)

            if secret_flags:
                parsed["notes"].append({
                    "type": "SECRET_REDACTION",
                    "flags": secret_flags,
                    "source_id": source_id,
                    "evidence_id": evidence_id,
                    "context": f"csv_row_{idx}",
                })

    return kind, parsed


def process_text_file(path: Path, source_id: str, evidence_id: str) -> Tuple[str, Dict[str, Any]]:
    parsed = empty_parsed()
    raw = path.read_text(encoding="utf-8", errors="replace")[:10_000_000]
    redacted, secret_flags = redact_secrets(raw)

    ents, _ = extract_ip_entities(redacted, source_id, evidence_id, "text_file", limit=20000)
    parsed["entities"].extend(ents)

    if secret_flags:
        parsed["notes"].append({
            "type": "SECRET_REDACTION",
            "flags": secret_flags,
            "source_id": source_id,
            "evidence_id": evidence_id,
        })

    for line_no, line in enumerate(redacted.splitlines()[:100000]):
        if not line.strip():
            continue

        ips = []
        for val in IPV4_RE.findall(line):
            cls = classify_ip(val)
            if cls["valid"]:
                ips.append(cls["normalized"])

        for val in IPV6_TOKEN_RE.findall(line):
            if ":" not in val:
                continue
            cls = classify_ip(val)
            if cls["valid"] and cls["version"] == "IPV6":
                ips.append(cls["normalized"])

        ips = sorted(set(ips))
        asns = sorted({normalize_asn(x) for x in ASN_RE.findall(line) if normalize_asn(x)})
        domains = sorted({normalize_domain(x) for x in DOMAIN_RE.findall(line) if normalize_domain(x)})
        certs = sorted({x.upper() for x in CERT_FP_RE.findall(line)})

        ctx = f"text_line_{line_no}"

        for ip in ips[:20]:
            add_entity(parsed, "IP", ip, source_id, evidence_id, ctx)

        for asn in asns[:20]:
            add_entity(parsed, "ASN", asn, source_id, evidence_id, ctx)

        for dom in domains[:20]:
            add_entity(parsed, "DOMAIN", dom, source_id, evidence_id, ctx)

        for cert in certs[:20]:
            add_entity(parsed, "CERTIFICATE", cert, source_id, evidence_id, ctx)

        for ip in ips[:20]:
            for asn in asns[:20]:
                add_relationship(parsed, ip, "ANNOUNCED_BY", asn, source_id, evidence_id, "Text line co-occurrence; BGP evidence required.")
            for cert in certs[:20]:
                add_relationship(parsed, ip, "SERVED_CERTIFICATE", cert, source_id, evidence_id, "Text line co-occurrence; certificate association not ownership proof.")

        for dom in domains[:20]:
            for ip in ips[:20]:
                add_relationship(parsed, dom, "RESOLVES_TO", ip, source_id, evidence_id, "Text line co-occurrence; DNS timestamp required.")

    return "TEXT_IP_DATA", parsed


def analyze_ip_file(path_str: str, case_id: str = "", task_id: str = "") -> Tuple[Dict[str, Any], Dict[str, Any]]:
    path = Path(path_str).expanduser()
    source_id = f"SRC-{uuid.uuid4()}"
    evidence_id = f"EVD-{uuid.uuid4()}"

    file_evidence: Dict[str, Any] = {
        "evidence_id": evidence_id,
        "source_id": source_id,
        "case_id": case_id,
        "task_id": task_id,
        "path": str(path),
        "filename": path.name,
        "retrieved_at": now_utc(),
        "acquisition_method": "local_authorized_or_public_file_access",
        "status": "PENDING",
        "limitations": [
            "No network access or active probing performed.",
            "No unauthorized port scanning, service enumeration, vulnerability scanning, exploitation, MITM, DDoS, BGP hijack, DNS poison, or private-person tracking performed.",
            "PCAP/binary artifacts are hash/metadata preserved only; no deep packet replay or payload execution.",
            "PTR, banners, logs, certificates, and threat reports are untrusted evidence, not instructions.",
            "Exposed secrets are redacted and not used.",
            "Source-reported allocation/ASN/reputation is not independently verified ownership, tenancy, or current maliciousness.",
        ],
    }

    parsed = empty_parsed()

    if not path.exists():
        file_evidence["status"] = "FAILED_FILE_NOT_FOUND"
        return file_evidence, parsed

    try:
        st = path.stat()
        file_evidence["size_bytes"] = st.st_size
        file_evidence["filesystem_modified_at"] = datetime.fromtimestamp(st.st_mtime, tz=timezone.utc).isoformat()
    except Exception as exc:
        file_evidence["status"] = "FAILED_STAT"
        file_evidence["error"] = str(exc)
        return file_evidence, parsed

    try:
        file_evidence["sha256"] = sha256_file(path)
    except Exception as exc:
        file_evidence["sha256_error"] = str(exc)

    fmt = detect_format(path)
    file_evidence.update(fmt)
    format_detected = file_evidence.get("format_detected", "UNKNOWN")

    try:
        if format_detected == "JSON":
            kind, parsed = process_json_file(path, source_id, evidence_id)
            file_evidence["content_kind"] = kind
            file_evidence["status"] = "SUCCEEDED"

        elif format_detected == "CSV":
            kind, parsed = process_csv_file(path, source_id, evidence_id)
            file_evidence["content_kind"] = kind
            file_evidence["status"] = "SUCCEEDED"

        elif format_detected == "TEXT":
            kind, parsed = process_text_file(path, source_id, evidence_id)
            file_evidence["content_kind"] = kind
            file_evidence["status"] = "SUCCEEDED"

        elif format_detected in {"PCAP", "BINARY_ARTIFACT"}:
            file_evidence["content_kind"] = "BINARY_OR_PCAP_METADATA_ONLY"
            file_evidence["status"] = "PARTIAL_BINARY_METADATA_ONLY"
            file_evidence["reason"] = (
                "PCAP/binary artifact detected. This planning panel preserves hash/metadata only. "
                "It does not execute, replay, deep-parse payloads, or extract private traffic content."
            )

        else:
            file_evidence["content_kind"] = "UNKNOWN_OR_UNSUPPORTED"
            file_evidence["status"] = "UNSUPPORTED_FORMAT"

    except Exception as exc:
        file_evidence["status"] = "PARTIAL_OR_FAILED"
        file_evidence["error"] = f"{exc.__class__.__name__}: {exc}"

    file_evidence["parsed_entity_count"] = len(parsed.get("entities", []))
    file_evidence["parsed_relationship_count"] = len(parsed.get("relationships", []))
    file_evidence["parsed_observation_count"] = len(parsed.get("observations", []))
    file_evidence["parsed_note_count"] = len(parsed.get("notes", []))

    return file_evidence, parsed


def aggregate_parsed(parsed_list: List[Dict[str, Any]]) -> Dict[str, Any]:
    agg = empty_parsed()

    for p in parsed_list:
        agg["entities"].extend(p.get("entities", []))
        agg["relationships"].extend(p.get("relationships", []))
        agg["observations"].extend(p.get("observations", []))
        agg["notes"].extend(p.get("notes", []))

    agg["entities"] = agg["entities"][:200000]
    agg["relationships"] = agg["relationships"][:200000]
    agg["observations"] = agg["observations"][:200000]
    agg["notes"] = agg["notes"][:10000]

    return agg


def min_or_none(values: List[Any]) -> Optional[str]:
    vals = [str(v) for v in values if v not in (None, "")]
    return min(vals) if vals else None


def max_or_none(values: List[Any]) -> Optional[str]:
    vals = [str(v) for v in values if v not in (None, "")]
    return max(vals) if vals else None


def normalize_entities(entities: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    buckets: Dict[Tuple[str, str], List[Dict[str, Any]]] = defaultdict(list)

    for e in entities:
        etype = str(e.get("type") or "UNKNOWN").upper()
        value = str(e.get("value") or e.get("original") or "").strip()
        if value:
            buckets[(etype, value)].append(e)

    out: List[Dict[str, Any]] = []

    for (etype, value), items in buckets.items():
        source_ids = sorted({str(i.get("source_id")) for i in items if i.get("source_id")})
        evidence_ids = sorted({str(i.get("evidence_id")) for i in items if i.get("evidence_id")})

        special_use = set()
        for i in items:
            su = i.get("special_use")
            if isinstance(su, list):
                special_use.update(str(x) for x in su)

        out.append({
            "normalized_entity_id": f"NENT-{uuid.uuid4()}",
            "type": etype,
            "value": value,
            "occurrence_count": len(items),
            "source_count": len(source_ids),
            "source_ids": source_ids[:100],
            "evidence_ids": evidence_ids[:100],
            "first_seen": min_or_none([i.get("first_seen") for i in items]),
            "last_seen": max_or_none([i.get("last_seen") for i in items]),
            "observed_at": min_or_none([i.get("observed_at") for i in items]),
            "valid_from": min_or_none([i.get("valid_from") for i in items]),
            "valid_to": max_or_none([i.get("valid_to") for i in items]),
            "special_use": sorted(special_use) if special_use else None,
            "requires_nonpublic_context": any(bool(i.get("requires_nonpublic_context")) for i in items),
            "confidence": "MODERATE_PENDING_INDEPENDENCE" if len(source_ids) > 1 else "LOW",
            "state": "OBSERVED",
            "limitations": [
                "Normalization does not verify allocation, ownership, tenancy, operator control, or current state.",
                "Multiple occurrences may still be dependent copies of one upstream source.",
            ],
        })

    out.sort(key=lambda x: (x.get("type", ""), -int(x.get("occurrence_count", 0))))
    return out[:50000]


def group_ip_relationships(
    entities: List[Dict[str, Any]],
    relationships: List[Dict[str, Any]],
) -> Tuple[Dict[str, Dict[str, Dict[str, List[Dict[str, Any]]]]], set, Dict[str, List[str]]]:
    ip_values = {str(e.get("value")) for e in entities if e.get("type") == "IP"}
    ip_special = {
        str(e.get("value")): list(e.get("special_use") or [])
        for e in entities
        if e.get("type") == "IP"
    }

    groups: Dict[str, Dict[str, Dict[str, List[Dict[str, Any]]]]] = defaultdict(lambda: defaultdict(lambda: defaultdict(list)))

    for r in relationships:
        src = str(r.get("source_ref") or "")
        tgt = str(r.get("target_ref") or "")

        for ip in (src, tgt):
            if not ip:
                continue
            if ip in ip_values or valid_ip(ip):
                other = tgt if ip == src else src
                rel = str(r.get("relationship") or "RELATED_TO").upper()
                groups[ip][rel][other].append(r)
                ip_values.add(ip)
                if ip not in ip_special:
                    cls = classify_ip(ip)
                    ip_special[ip] = cls.get("special_use", []) if cls.get("valid") else []

    return groups, ip_values, ip_special


def temporal_start(rel: Dict[str, Any]) -> Optional[str]:
    t = rel.get("temporal") or {}
    return min_or_none([t.get("first_seen"), t.get("valid_from"), t.get("observed_at")])


def temporal_end(rel: Dict[str, Any]) -> Optional[str]:
    t = rel.get("temporal") or {}
    return max_or_none([t.get("last_seen"), t.get("valid_to"), t.get("observed_at")])


def build_usage_eras(
    entities: List[Dict[str, Any]],
    relationships: List[Dict[str, Any]],
) -> List[Dict[str, Any]]:
    groups, ip_values, ip_special = group_ip_relationships(entities, relationships)
    eras: List[Dict[str, Any]] = []

    for ip in list(ip_values)[:1000]:
        by_rel = groups.get(ip, {})
        for rel_type, by_target in by_rel.items():
            distinct_targets = len(by_target)
            for target, rels in by_target.items():
                starts = [temporal_start(r) for r in rels]
                ends = [temporal_end(r) for r in rels]

                eras.append({
                    "era_id": f"ERA-{uuid.uuid4()}",
                    "ip": ip,
                    "relationship": rel_type,
                    "observed_entity": target,
                    "start": min_or_none(starts),
                    "end": max_or_none(ends),
                    "observation_count": len(rels),
                    "distinct_targets_for_relationship": distinct_targets,
                    "reassignment_candidate": distinct_targets > 1,
                    "special_use": ip_special.get(ip, []),
                    "state": "OBSERVED",
                    "caution": (
                        "Usage era is built from parsed observations. Provider/tenant/application ownership "
                        "and current control require independent authorized evidence."
                    ),
                })

    eras.sort(key=lambda x: (str(x.get("ip", "")), str(x.get("relationship", "")), str(x.get("start") or "")))
    return eras[:5000]


def build_contradictions(
    entities: List[Dict[str, Any]],
    relationships: List[Dict[str, Any]],
) -> List[Dict[str, Any]]:
    groups, ip_values, _ = group_ip_relationships(entities, relationships)
    contradictions: List[Dict[str, Any]] = []

    conflict_types = {
        "ANNOUNCED_BY": [
            "provider migration",
            "BGP change",
            "prefix reassignment",
            "multi-origin/MOAS",
            "routing anomaly",
            "different observation times",
        ],
        "HOSTED_BY_CANDIDATE": [
            "cloud reassignment",
            "shared hosting",
            "CDN/proxy front-end",
            "multi-tenant infrastructure",
            "provider naming difference",
        ],
        "PTR_TO": [
            "stale PTR",
            "generic provider naming",
            "customer-defined PTR",
            "migration",
        ],
        "REPORTED_AS": [
            "different reputation methodologies",
            "historical vs current reporting",
            "scanner/research infrastructure",
            "sinkhole/seizure",
            "duplicate upstream feed",
        ],
        "GEO_COUNTRY_CANDIDATE": [
            "registration country",
            "provider database difference",
            "anycast",
            "VPN/proxy",
            "cloud region mismatch",
        ],
        "GEO_REGION_CANDIDATE": [
            "provider database difference",
            "anycast",
            "VPN/proxy",
            "cloud region mismatch",
        ],
        "GEO_CITY_CANDIDATE": [
            "provider database difference",
            "anycast",
            "VPN/proxy",
            "cloud region mismatch",
        ],
    }

    for ip in list(ip_values)[:2000]:
        by_rel = groups.get(ip, {})
        for rel_type, by_target in by_rel.items():
            if rel_type not in conflict_types:
                continue
            if len(by_target) > 1:
                contradictions.append({
                    "contradiction_id": f"CON-{uuid.uuid4()}",
                    "type": f"{rel_type}_CONFLICT",
                    "subject": ip,
                    "relationship": rel_type,
                    "values": sorted(by_target.keys())[:50],
                    "possible_explanations": conflict_types.get(rel_type, ["different times", "source error", "migration"]),
                    "resolution_status": "UNRESOLVED",
                    "caution": "Preserve conflict. Do not silently choose one provider/tenant/reputation/geolocation claim.",
                })

    contradictions.sort(key=lambda x: (str(x.get("subject", "")), str(x.get("type", ""))))
    return contradictions[:1000]


def build_hypotheses(
    payload: Dict[str, Any],
    entities: List[Dict[str, Any]],
    relationships: List[Dict[str, Any]],
    contradictions: List[Dict[str, Any]],
) -> List[Dict[str, Any]]:
    groups, ip_values, ip_special = group_ip_relationships(entities, relationships)
    hyps: List[Dict[str, Any]] = []

    if not ip_values:
        hyps.append({
            "hypothesis_id": f"HYP-{uuid.uuid4()}",
            "statement": "Current local deterministic evidence is insufficient to establish IP identity, allocation, routing, exposure, or reputation.",
            "supporting_facts": ["No valid IP entities parsed."],
            "opposing_facts": [],
            "assumptions": ["Evidence may be missing, private, binary-only, or unsupported."],
            "unknowns": ["IP", "prefix", "ASN", "provider", "reputation", "temporal validity"],
            "falsification_conditions": ["New authorized RDAP/RIR/BGP/pDNS/CT/reputation evidence changes assessment."],
            "next_test": "Attach authorized/public IP evidence exports or configure connectors.",
            "status": "OPEN",
        })
        return hyps[:200]

    for ip in list(ip_values)[:50]:
        special = ip_special.get(ip, [])
        by_rel = groups.get(ip, {})

        if any(x in special for x in ["PRIVATE", "LOOPBACK", "LINK_LOCAL", "UNSPECIFIED", "MULTICAST", "RESERVED", "CGNAT", "DOCUMENTATION"]):
            hyps.append({
                "hypothesis_id": f"HYP-{uuid.uuid4()}",
                "statement": f"{ip} is special-use/non-public or documentation space and cannot be treated as a globally attributable asset.",
                "supporting_facts": [f"Special-use flags: {', '.join(special)}"],
                "opposing_facts": ["No public attribution should be inferred from this address alone."],
                "assumptions": ["Authorized internal context may be required."],
                "unknowns": ["internal network owner", "NAT context", "authorized asset mapping"],
                "falsification_conditions": ["Authorized internal inventory maps address to known asset."],
                "next_test": "Use authorized CMDB/asset inventory/internal DNS/flow telemetry only.",
                "status": "OPEN",
            })

        asn_targets = list((by_rel.get("ANNOUNCED_BY") or {}).keys())
        provider_targets = list((by_rel.get("HOSTED_BY_CANDIDATE") or {}).keys())
        rep_targets = list((by_rel.get("REPORTED_AS") or {}).keys())
        threat_targets = list((by_rel.get("REPORTED_IN_CAMPAIGN") or {}).keys())

        if asn_targets or provider_targets:
            hyps.append({
                "hypothesis_id": f"HYP-{uuid.uuid4()}",
                "statement": f"{ip} is associated with network/provider context but tenant/application ownership remains unresolved.",
                "supporting_facts": [
                    f"ASN candidates: {', '.join(asn_targets[:10])}" if asn_targets else "",
                    f"Provider candidates: {', '.join(provider_targets[:10])}" if provider_targets else "",
                ],
                "opposing_facts": ["Provider/ASN allocation does not prove application ownership or tenant identity."],
                "assumptions": ["Parsed RDAP/BGP/provider records are source-reported."],
                "unknowns": ["tenant", "application operator", "current control", "reassignment history"],
                "falsification_conditions": ["Cloud/CDN/shared hosting explains the relationship.", "Historical routing shows reassignment."],
                "next_test": "Resolve IP usage eras using BGP, passive DNS, certificates, service history, and authorized inventory.",
                "status": "OPEN",
            })

        if len(asn_targets) > 1 or len(provider_targets) > 1:
            hyps.append({
                "hypothesis_id": f"HYP-{uuid.uuid4}",
                "statement": f"{ip} may have been reassigned or observed under multiple providers/ASNs over time.",
                "supporting_facts": [
                    f"Multiple ASN candidates: {len(asn_targets)}",
                    f"Multiple provider candidates: {len(provider_targets)}",
                ],
                "opposing_facts": ["Differences may be source normalization, anycast, CDN, or simultaneous multi-origin."],
                "assumptions": ["Observations have temporal bounds."],
                "unknowns": ["valid_from", "valid_to", "origin changes"],
                "falsification_conditions": ["All observations refer to same era and same logical provider relationship."],
                "next_test": "Check BGP/RDAP/PTR/pDNS timeline before merging historical and current intelligence.",
                "status": "OPEN",
            })

        if rep_targets or threat_targets:
            hyps.append({
                "hypothesis_id": f"HYP-{uuid.uuid4()}",
                "statement": f"{ip} has source-reported reputation/threat context, but current maliciousness is not established.",
                "supporting_facts": [
                    f"Reputation candidates: {', '.join(rep_targets[:10])}" if rep_targets else "",
                    f"Threat/campaign candidates: {', '.join(threat_targets[:10])}" if threat_targets else "",
                ],
                "opposing_facts": [
                    "Reputation may be historical, duplicated, scanner/research, sinkholed, or reassigned.",
                ],
                "assumptions": ["Threat feeds are source-attributed, not verified current control."],
                "unknowns": ["reputation_start", "reputation_end", "source independence", "current tenant"],
                "falsification_conditions": ["Independent evidence shows benign scanner/research/sinkhole/current unrelated tenant."],
                "next_test": "Handoff threat interpretation to CTI and resolve IP usage eras before operational action.",
                "status": "OPEN",
            })

    if contradictions:
        hyps.append({
            "hypothesis_id": f"HYP-{uuid.uuid4()}",
            "statement": "Observed IP contradictions likely reflect temporal change, shared infrastructure, anycast/CDN, or source dependence rather than a single timeless attribute.",
            "supporting_facts": [f"{len(contradictions)} contradiction candidate(s) parsed."],
            "opposing_facts": ["Source error remains possible."],
            "assumptions": ["Timestamps and source provenance are preserved."],
            "unknowns": ["which claims are current", "which sources are independent"],
            "falsification_conditions": ["All contradictions resolve to same era with independent authoritative evidence."],
            "next_test": "Perform source-independence clustering and temporal era review.",
            "status": "OPEN",
        })

    hyps, _ = truncate_list(hyps, 200)
    return hyps


def truncate_list(items: List[Any], limit: int) -> Tuple[List[Any], bool]:
    if len(items) <= limit:
        return items, False
    return items[:limit], True


def build_knowledge_gaps(
    payload: Dict[str, Any],
    files: List[Dict[str, Any]],
    entities: List[Dict[str, Any]],
    relationships: List[Dict[str, Any]],
    contradictions: List[Dict[str, Any]],
    usage_eras: List[Dict[str, Any]],
) -> List[Dict[str, Any]]:
    gaps: List[Dict[str, Any]] = []
    groups, ip_values, ip_special = group_ip_relationships(entities, relationships)

    if not files:
        gaps.append({
            "gap_id": f"GAP-{uuid.uuid4()}",
            "question": "What authorized/public IP evidence exists?",
            "missing_evidence": "No local IP evidence file supplied.",
            "likely_source": "RDAP/RIR/BGP/RPKI/PTR/pDNS/CT/service/reputation export or authorized telemetry.",
            "specialist_owner": "IPINT AI Employee",
            "priority": "HIGH",
            "expected_information_value": "Enables IP identity, prefix/ASN context, exposure, and reputation planning.",
            "privacy_boundary": "Passive/public/authorized sources only. No unauthorized scanning or private-person tracking.",
        })

    if not ip_values:
        gaps.append({
            "gap_id": f"GAP-{uuid.uuid4()}",
            "question": "Which IP addresses are in scope?",
            "missing_evidence": "No valid IPv4/IPv6 entities parsed.",
            "likely_source": "Known IPs field, RDAP/RIR export, flow log, passive DNS, service metadata.",
            "specialist_owner": "IPINT AI Employee",
            "priority": "HIGH",
            "expected_information_value": "Establishes IP inventory.",
            "privacy_boundary": "Do not infer person identity from IP.",
        })

    for ip in list(ip_values)[:20]:
        special = ip_special.get(ip, [])
        if any(x in special for x in ["PRIVATE", "LOOPBACK", "LINK_LOCAL", "UNSPECIFIED", "MULTICAST", "RESERVED", "CGNAT", "DOCUMENTATION"]):
            gaps.append({
                "gap_id": f"GAP-{uuid.uuid4()}",
                "question": f"What authorized internal context applies to special-use IP {ip}?",
                "missing_evidence": "Address is special-use/non-public or documentation space.",
                "likely_source": "Authorized CMDB, internal DNS, DHCP/VPN/firewall logs, asset inventory.",
                "specialist_owner": "IPINT / NETINT / LOGINT",
                "priority": "HIGH_IF_ASSET_RELEVANT",
                "expected_information_value": "Prevents false public attribution.",
                "privacy_boundary": "No public lookup as if globally routable. No private-person tracking.",
            })

    has_prefix = any(e.get("type") == "PREFIX" for e in entities)
    has_asn = any(e.get("type") == "ASN" for e in entities)
    has_temporal = any(bool(r.get("temporal")) for r in relationships)

    if ip_values and not has_prefix:
        gaps.append({
            "gap_id": f"GAP-{uuid.uuid4()}",
            "question": "Which prefix/CIDR contains the observed IP?",
            "missing_evidence": "No prefix entities parsed.",
            "likely_source": "RDAP/RIR network record, BGP prefix, authorized IPAM.",
            "specialist_owner": "IPINT / ASNINT",
            "priority": "MEDIUM",
            "expected_information_value": "Supports allocation and routing context.",
            "privacy_boundary": "Allocation does not prove application ownership.",
        })

    if ip_values and not has_asn:
        gaps.append({
            "gap_id": f"GAP-{uuid.uuid4()}",
            "question": "Which ASN announces the prefix/IP?",
            "missing_evidence": "No ASN entities parsed.",
            "likely_source": "BGP/route collector, RDAP, ASN database.",
            "specialist_owner": "ASNINT / BGPINT",
            "priority": "MEDIUM",
            "expected_information_value": "Supports provider/routing context.",
            "privacy_boundary": "ASN != tenant/application owner.",
        })

    if relationships and not has_temporal:
        gaps.append({
            "gap_id": f"GAP-{uuid.uuid4()}",
            "question": "When were IP relationships observed/valid?",
            "missing_evidence": "Relationships lack first_seen/last_seen/observed_at/valid_from/valid_to.",
            "likely_source": "Passive DNS, BGP history, RDAP events, service index timestamps, authorized logs.",
            "specialist_owner": "IPINT / DNSINT / BGPINT",
            "priority": "HIGH",
            "expected_information_value": "Prevents stale/current confusion and reassignment errors.",
            "privacy_boundary": "Do not apply historical reputation to current tenant automatically.",
        })

    if any(e.get("type") == "REPUTATION" for e in entities) or any(e.get("type") == "THREAT" for e in entities):
        gaps.append({
            "gap_id": f"GAP-{uuid.uuid4()}",
            "question": "Are reputation/threat claims independent and temporally current?",
            "missing_evidence": "Reputation/threat records parsed, but source independence and decay not resolved.",
            "likely_source": "Independent CTI feeds, abuse reports with evidence, original research, authorized telemetry.",
            "specialist_owner": "CTI / IPINT",
            "priority": "HIGH_IF_CONSEQUENTIAL",
            "expected_information_value": "Reduces false current-maliciousness attribution.",
            "privacy_boundary": "Do not turn one reputation flag into actor attribution or blocking action.",
        })

    if contradictions:
        gaps.append({
            "gap_id": f"GAP-{uuid.uuid4()}",
            "question": "Which IP attribute conflicts are resolved?",
            "missing_evidence": f"{len(contradictions)} contradiction candidate(s) detected.",
            "likely_source": "RDAP history, BGP history, PTR history, pDNS, certificates, authorized inventory.",
            "specialist_owner": "IPINT / BGPINT / DNSINT / human reviewer",
            "priority": "HIGH_IF_IDENTIFICATION_CONSEQUENTIAL",
            "expected_information_value": "Prevents false ownership/tenant/reputation merging.",
            "privacy_boundary": "Do not hide NAT/VPN/proxy/anycast/cloud reassignment uncertainty.",
        })

    if any(f.get("status") == "PARTIAL_BINARY_METADATA_ONLY" for f in files):
        gaps.append({
            "gap_id": f"GAP-{uuid.uuid4()}",
            "question": "Can PCAP/binary network artifacts be safely converted to authorized flow/entity metadata?",
            "missing_evidence": "Binary/PCAP hash preserved, but no deep parsing/payload replay performed.",
            "likely_source": "Authorized flow extraction, SIEM/NDR export, Zeek/NetFlow/IPFIX metadata.",
            "specialist_owner": "NETINT / LOGINT / authorized lab workflow",
            "priority": "MEDIUM",
            "expected_information_value": "Improves temporal IP relationship evidence without payload exposure.",
            "privacy_boundary": "Payload inspection requires explicit authorization and privacy minimization.",
        })

    gaps, _ = truncate_list(gaps, 200)
    return gaps


def build_specialist_handoffs(
    payload: Dict[str, Any],
    entities: List[Dict[str, Any]],
    relationships: List[Dict[str, Any]],
) -> List[Dict[str, Any]]:
    handoffs: List[Dict[str, Any]] = []
    types = {str(e.get("type") or "").upper() for e in entities}
    rel_types = {str(r.get("relationship") or "").upper() for r in relationships}
    payload_text = normalize_text(json.dumps(payload, ensure_ascii=False, default=str))

    if "ASN" in types or "ANNOUNCED_BY" in rel_types:
        handoffs.append({
            "specialist": "ASNINT / BGPINT",
            "reason": "ASN/routing context detected.",
            "expected_output": "Origin ASN history, prefix portfolio, MOAS/route-leak/hijack adjudication, RPKI context.",
            "question": "Which ASN/prefix relationships are current, historical, multi-origin, or anomalous?",
        })

    if "PREFIX" in types:
        handoffs.append({
            "specialist": "IPINT / ASNINT",
            "reason": "Prefix/CIDR context detected.",
            "expected_output": "RIR allocation, prefix membership, provider context, historical allocation changes.",
            "question": "Which allocation/assignment/prefix relationships are supported by independent sources?",
        })

    if "DOMAIN" in types or "RESOLVES_TO" in rel_types or "PTR" in types:
        handoffs.append({
            "specialist": "DNSINT / DOMAININT",
            "reason": "DNS/PTR/domain relationship context detected.",
            "expected_output": "Timestamped passive DNS, PTR history, domain-IP temporal overlap.",
            "question": "Which domain/IP relationships are current vs historical, and could shared hosting/CDN explain them?",
        })

    if "CERTIFICATE" in types or "SERVED_CERTIFICATE" in rel_types:
        handoffs.append({
            "specialist": "CERTINT",
            "reason": "Certificate relationship detected.",
            "expected_output": "Certificate SAN/issuer/CT timeline and multi-tenant caution.",
            "question": "Which certificate relationships are temporally aligned and independent from shared infrastructure?",
        })

    if "PROVIDER" in types or "HOSTED_BY_CANDIDATE" in rel_types:
        handoffs.append({
            "specialist": "INFRAINT / CLOUDINT",
            "reason": "Hosting/cloud/provider context detected.",
            "expected_output": "Hosting/cloud/CDN/proxy context, front-end vs origin separation.",
            "question": "Which provider relationships are hosting/allocation only, and which have tenant/application evidence?",
        })

    if "SERVICE" in types or "PORT" in types or "OBSERVED_SERVICE" in rel_types:
        handoffs.append({
            "specialist": "NETINT / LOGINT / VULNINT",
            "reason": "Service/port metadata detected.",
            "expected_output": "Defensive service exposure context, freshness, and vulnerability relevance without exploitation.",
            "question": "Which service observations are current, authorized, and relevant to defensive risk?",
        })

    if "REPUTATION" in types or "THREAT" in types or "REPORTED_AS" in rel_types or "REPORTED_IN_CAMPAIGN" in rel_types:
        handoffs.append({
            "specialist": "CTI / CYBINT / THREATACTORINT",
            "reason": "Reputation/threat context detected.",
            "expected_output": "Source-independent threat interpretation, campaign/actor confidence, temporal relevance.",
            "question": "Is reported maliciousness current, independent, and supported beyond one feed?",
        })

    if payload.get("known_malware") or "malware" in payload_text:
        handoffs.append({
            "specialist": "MALWAREINT / CTI",
            "reason": "Malware/C2 reference context detected.",
            "expected_output": "Malware infrastructure context without C2 interaction or sample execution.",
            "question": "Which IP/malware relationships are source-reported and temporally valid?",
        })

    if payload.get("known_organizations") or "organization" in payload_text:
        handoffs.append({
            "specialist": "COMPANYINT / INFRAINT",
            "reason": "Organization/provider association context detected.",
            "expected_output": "Corporate/legal/operational ownership separation.",
            "question": "Which organization associations are supported by independent documentation rather than allocation alone?",
        })

    if not handoffs:
        handoffs.append({
            "specialist": "IPINT Manager",
            "reason": "No specialized handoff triggered from current local deterministic evidence alone.",
            "expected_output": "Review scope, approve authorized connectors, assign passive IP collection tasks.",
            "question": "What IP intelligence gap should be filled next?",
        })

    return handoffs


def build_next_best_action(
    payload: Dict[str, Any],
    policy: Dict[str, Any],
    files: List[Dict[str, Any]],
    entities: List[Dict[str, Any]],
    relationships: List[Dict[str, Any]],
    contradictions: List[Dict[str, Any]],
    usage_eras: List[Dict[str, Any]],
) -> Dict[str, str]:
    groups, ip_values, ip_special = group_ip_relationships(entities, relationships)

    if policy.get("status") == "POLICY_BLOCKED":
        return {
            "action": "Revise task to remove prohibited scanning/exploitation/interception/disruption/private-tracking behavior.",
            "reason": "IPINT is passive/authorized intelligence-first.",
            "owner": "IPINT Manager / Cyber Intelligence Manager",
            "expected_output": "Policy-compliant defensive IP intelligence scope.",
        }

    if policy.get("status") == "HUMAN_REVIEW_REQUIRED":
        return {
            "action": "Route to human IPINT reviewer before consequential ownership/tenant/threat attribution, critical-infrastructure, law-enforcement, or active-validation decisions.",
            "reason": "IP attribution and reputation conclusions can be consequential.",
            "owner": "IPINT Manager",
            "expected_output": "Approved passive plan, attribution confidence, and handoffs.",
        }

    if not files and not payload.get("known_ips"):
        return {
            "action": "Attach authorized/public IP evidence or supply known IPs before collection.",
            "reason": "No IP artifact or IP inventory is available for local deterministic analysis.",
            "owner": "IPINT AI Employee",
            "expected_output": "IP evidence inventory with hashes and provenance.",
        }

    for ip in list(ip_values)[:20]:
        special = ip_special.get(ip, [])
        if any(x in special for x in ["PRIVATE", "LOOPBACK", "LINK_LOCAL", "UNSPECIFIED", "MULTICAST", "RESERVED", "CGNAT", "DOCUMENTATION"]):
            return {
                "action": f"Use authorized internal inventory/telemetry for special-use IP {ip}; do not perform public attribution.",
                "reason": "Address is special-use/non-public or documentation space.",
                "owner": "IPINT / NETINT / LOGINT",
                "expected_output": "Internal asset/NAT/DHCP/VPN context without public probing.",
            }

    has_temporal = any(bool(r.get("temporal")) for r in relationships)
    if relationships and not has_temporal:
        return {
            "action": "Observe or import timestamped RDAP/BGP/PTR/pDNS/certificate/service/reputation evidence before making current-state claims.",
            "reason": "IP intelligence without time is defective intelligence.",
            "owner": "IPINT / DNSINT / BGPINT",
            "expected_output": "Temporal IP usage eras and valid_from/valid_to relationships.",
        }

    if contradictions:
        return {
            "action": "Resolve IP usage eras and source independence before merging ASN/provider/PTR/reputation/geolocation claims.",
            "reason": "Conflicting IP attributes can cause false ownership, tenant, or maliciousness attribution.",
            "owner": "IPINT / BGPINT / DNSINT / CTI / human reviewer",
            "expected_output": "Separated historical/current eras and disputed attribute states.",
        }

    if any(e.get("type") == "REPUTATION" for e in entities) or any(e.get("type") == "THREAT" for e in entities):
        return {
            "action": "Verify reputation/threat claims from independent sources and check reassignment/sinkhole/scanner context before operational action.",
            "reason": "Historical reputation is not current maliciousness, and copied feeds are not independent confirmation.",
            "owner": "CTI / IPINT",
            "expected_output": "SOURCE_ATTRIBUTED vs SUPPORTED threat-infrastructure states.",
        }

    if usage_eras:
        return {
            "action": "Proceed with authorized passive enrichment: RDAP/RIR, BGP/RPKI, PTR/pDNS, CT, service metadata, and independent reputation review.",
            "reason": "Local deterministic IP evidence exists, but attribution and current relevance require verified temporal sources.",
            "owner": "IPINT / ASNINT / BGPINT / DNSINT / CERTINT / CTI",
            "expected_output": "Evidence-linked IP identity, provider context, exposure, reputation, and usage eras.",
        }

    return {
        "action": "Supply typed IP evidence or configure authorized connectors before external enrichment.",
        "reason": "Generic text parsing may not produce reliable normalized IP/prefix/ASN/temporal relationships.",
        "owner": "IPINT AI Employee / Source Owner",
        "expected_output": "Normalized IP/prefix/ASN/provider objects with provenance.",
    }


def build_collection_plan(
    payload: Dict[str, Any],
    questions: List[Any],
    files: List[Dict[str, Any]],
    entities: List[Dict[str, Any]],
    relationships: List[Dict[str, Any]],
) -> List[Dict[str, Any]]:
    plan: List[Dict[str, Any]] = []
    priority = 1

    questions_limited, _ = truncate_list([str(q) for q in questions], 8)

    has_files = bool(files or payload.get("evidence_paths"))
    has_ips = any(e.get("type") == "IP" for e in entities)
    has_prefix = any(e.get("type") == "PREFIX" for e in entities)
    has_asn = any(e.get("type") == "ASN" for e in entities)
    has_ptr = any(e.get("type") in {"PTR", "DOMAIN"} for e in entities)
    has_cert = any(e.get("type") == "CERTIFICATE" for e in entities)
    has_service = any(e.get("type") in {"SERVICE", "PORT"} for e in entities)
    has_rep = any(e.get("type") in {"REPUTATION", "THREAT"} for e in entities)
    has_temporal = any(bool(r.get("temporal")) for r in relationships)

    configured_connectors = payload.get("configured_connectors") or []
    has_connectors = bool(configured_connectors) and not any("None configured" in str(x) for x in configured_connectors)

    def add(
        operation: str,
        tool: str,
        purpose: str,
        status: str,
        expected_output: str,
        privacy_risk: str = "LOW",
        policy_note: str = "Passive / authorized / defensive IP intelligence only.",
    ) -> None:
        nonlocal priority
        plan.append({
            "question": questions_limited[0] if questions_limited else "General IPINT requirement",
            "operation": operation,
            "tool_or_provider": tool,
            "purpose": purpose,
            "status": status,
            "expected_output": expected_output,
            "priority": priority,
            "privacy_risk": privacy_risk,
            "policy_note": policy_note,
            "authorization_status": "ALLOWED_PASSIVE_AUTHORIZED_PUBLIC",
            "execution_status": "NOT_EXECUTED_PLANNING_ONLY",
        })
        priority += 1

    add(
        "define_ipint_questions_scope",
        "IPINT Manager / IPINT AI Employee",
        "Convert objective into IP-specific questions, allowed sources, temporal scope, and privacy boundaries.",
        "COMPLETED_LOCAL" if payload.get("questions") else "REQUIRED_BEFORE_COLLECTION",
        "Requirement-driven passive IP collection plan.",
        policy_note="Do not scan or probe merely because passive evidence is incomplete.",
    )

    add(
        "preserve_original_ip_evidence",
        "local evidence store",
        "Store original RDAP/RIR/BGP/RPKI/PTR/pDNS/CT/service/reputation/flow artifacts and hashes.",
        "COMPLETED_LOCAL" if has_files else "PLANNED_REQUIRES_EVIDENCE",
        "IPEvidenceObject with SHA256 and provenance fields.",
    )

    add(
        "safe_parse_json_csv_text_ip_metadata",
        "local deterministic parser",
        "Parse authorized/public JSON/CSV/TXT IP metadata without active probing or payload execution.",
        "COMPLETED_LOCAL" if has_files else "PLANNED_REQUIRES_EVIDENCE",
        "Normalized IP/prefix/ASN/PTR/domain/cert/service/reputation entities.",
        policy_note="No unauthorized scanning, exploitation, interception, routing modification, or private-person tracking.",
    )

    add(
        "ip_normalization_special_use_check",
        "local deterministic IP parser",
        "Normalize IPv4/IPv6, detect private/loopback/link-local/multicast/reserved/documentation/CGNAT context.",
        "COMPLETED_LOCAL" if has_ips else "PLANNED_REQUIRES_IPS",
        "Valid IP inventory with special-use flags and nonpublic-context warnings.",
        policy_note="Do not query public attribution services as though private IPs were globally routable assets.",
    )

    add(
        "prefix_rir_rdap_context",
        "RDAP / RIR / IPAM connectors",
        "Determine containing prefix, RIR allocation, assignment, dates, status, and provider organization claims.",
        "BLOCKED_CONFIGURATION" if not has_connectors else "PLANNED_REQUIRES_CONNECTOR",
        "ALLOCATED_TO / ASSIGNED_TO relationships with temporal validity.",
        policy_note="Allocation != application ownership.",
    )

    add(
        "asn_bgp_rpki_context",
        "ASNINT / BGPINT / RPKI connectors",
        "Resolve origin ASN, BGP history, MOAS, route changes, and RPKI validation state.",
        "BLOCKED_CONFIGURATION" if not has_connectors else "PLANNED_REQUIRES_CONNECTOR",
        "ANNOUNCED_BY / PREFIX relationships, routing anomaly candidates, RPKI states.",
        policy_note="ASN != tenant. RPKI invalid != automatic hijack.",
    )

    add(
        "ptr_passive_dns_context",
        "DNSINT / passive DNS connector",
        "Correlate PTR and historical domain-to-IP / IP-to-domain relationships with timestamps.",
        "BLOCKED_CONFIGURATION" if not has_connectors else "PLANNED_REQUIRES_CONNECTOR",
        "PTR_TO / RESOLVES_TO temporal relationships.",
        policy_note="PTR is operator-configured metadata. Shared IP != common operator.",
    )

    add(
        "certificate_ct_context",
        "CERTINT / CT connector",
        "Correlate certificates/SANs/CT observations with IP/service history.",
        "BLOCKED_CONFIGURATION" if not has_connectors else "PLANNED_REQUIRES_CONNECTOR",
        "SERVED_CERTIFICATE relationships with multi-tenant caution.",
        policy_note="Shared certificate may be CDN/LB/multi-tenant, not ownership proof.",
    )

    add(
        "service_exposure_metadata",
        "authorized service index / prior scan / inventory",
        "Analyze publicly indexed or previously authorized service metadata, ports, banners, TLS context, and freshness.",
        "BLOCKED_CONFIGURATION" if not has_connectors else "PLANNED_REQUIRES_CONNECTOR",
        "PUBLICLY_OBSERVED / HISTORICAL_EXPOSURE / NO_CURRENT_OBSERVATION states.",
        privacy_risk="MEDIUM_IF_PAYLOAD_SENSITIVE",
        policy_note="Open port != vulnerability. Banner != verified version. Do not silently probe.",
    )

    add(
        "reputation_threat_independence",
        "CTI / reputation connectors / abuse reports",
        "Assess reputation, abuse reports, campaign/malware references, source independence, and temporal decay.",
        "BLOCKED_CONFIGURATION" if not has_connectors else "PLANNED_REQUIRES_CONNECTOR",
        "SOURCE_ATTRIBUTED reputation/threat records with confidence and limitations.",
        privacy_risk="HIGH_IF_FALSE_ATTRIBUTION",
        policy_note="One reputation flag != attacker identity. Historical reputation != current maliciousness.",
    )

    add(
        "ip_usage_era_reassignment",
        "IPINT temporal analyzer",
        "Build IP usage eras from RDAP/BGP/PTR/pDNS/cert/service/reputation timelines.",
        "COMPLETED_LOCAL" if has_temporal else "PLANNED_REQUIRES_TEMPORAL_EVIDENCE",
        "ERA_1/ERA_2 provider/tenant/threat states and reassignment candidates.",
        policy_note="Never carry old malicious reputation into new tenant without evidence.",
    )

    add(
        "source_reliability_bias_independence",
        "IPINT analyst + feed provenance",
        "Assess RIR/BGP/CT/pDNS/scanner/reputation sources and cluster same-upstream feeds.",
        "PLANNED_ANALYTIC",
        "INDEPENDENT / PARTIALLY_DEPENDENT / DEPENDENT / UNKNOWN states.",
    )

    add(
        "fact_gate_dual_ai_review",
        "Primary IP Analyst + Independent IP Skeptic",
        "Separate observations, normalized entities, candidate facts, hypotheses, and supported conclusions.",
        "PLANNED_ANALYTIC",
        "AGREE / PARTIAL_AGREEMENT / DISAGREE / INSUFFICIENT_EVIDENCE.",
    )

    return plan


def policy_screen(payload: Dict[str, Any]) -> Dict[str, Any]:
    scanned_text = " ".join(
        [
            str(payload.get("objective", "")),
            " ".join(str(q) for q in payload.get("questions", [])),
            str(payload.get("target_ip", "")),
            " ".join(str(s) for s in payload.get("known_campaigns", [])),
            " ".join(str(s) for s in payload.get("known_malware", [])),
        ]
    ).lower()

    blocked_reasons: List[str] = []

    for pattern in POLICY_BLOCK_PATTERNS:
        if re.search(pattern, scanned_text, re.IGNORECASE):
            blocked_reasons.append(pattern)

    human_review_required = False
    privacy_notes: List[str] = []

    if payload.get("target_type") in SENSITIVE_TARGET_TYPES:
        human_review_required = True
        privacy_notes.append(
            "Sensitive IPINT context detected. Analysis must remain passive, defensive, privacy-preserving, and evidence-linked. "
            "No scanning, exploitation, interception, routing modification, DDoS, or private-person tracking."
        )

    if payload.get("known_campaigns") or payload.get("known_malware"):
        human_review_required = True
        privacy_notes.append(
            "Threat/malware/campaign context detected. Reputation/threat relationships remain source-attributed until CTI review."
        )

    candidate_ips: List[str] = []
    candidate_ips.extend(as_list(payload.get("target_ip")))
    candidate_ips.extend(as_list(payload.get("known_ips")))

    for ip in candidate_ips[:100]:
        cls = classify_ip(ip)
        if cls["valid"] and cls["requires_nonpublic_context"]:
            human_review_required = True
            privacy_notes.append(
                f"Special-use/non-public IP detected: {cls['normalized']} ({', '.join(cls['special_use'])}). "
                "Use authorized internal context only; do not infer public ownership/location/person."
            )
            break

    if blocked_reasons:
        return {
            "status": "POLICY_BLOCKED",
            "reasons": sorted(set(blocked_reasons)),
            "human_review_required": True,
            "privacy_notes": privacy_notes,
            "explanation": (
                "The requested task appears to require unauthorized scanning/enumeration, exploitation, credential use, "
                "traffic interception/MITM, DDoS/flooding/reflection/amplification, routing/BGP modification, DNS poisoning, "
                "intrusive origin discovery, or private-person tracking."
            ),
            "safe_alternatives": SAFE_ALTERNATIVES,
        }

    if human_review_required:
        return {
            "status": "HUMAN_REVIEW_REQUIRED",
            "reasons": [],
            "human_review_required": True,
            "privacy_notes": privacy_notes,
            "explanation": (
                "No obvious hard policy violation detected, but sensitive IP reputation/threat, telemetry, special-use address, "
                "or attribution context applies. Conclusions must remain passive, evidence-linked, and human-reviewed."
            ),
            "safe_alternatives": SAFE_ALTERNATIVES,
        }

    return {
        "status": "ALLOWED_PASSIVE_AUTHORIZED",
        "reasons": [],
        "human_review_required": False,
        "privacy_notes": [],
        "explanation": (
            "No obvious policy violation detected. Execution remains planning-only unless authorized/public passive connectors, "
            "licensed feeds, or defensive analysis tools are configured."
        ),
        "safe_alternatives": [],
    }


def validate_payload(payload: Dict[str, Any]) -> List[str]:
    warnings: List[str] = []

    required = ["case_id", "task_id", "objective", "target_ip", "target_type"]
    for field in required:
        if not payload.get(field):
            warnings.append(f"Missing required field: {field}")

    if not payload.get("questions"):
        warnings.append("No IPINT questions provided. Default questions will be inferred.")

    if not payload.get("evidence_paths") and not payload.get("known_ips"):
        warnings.append("No local IP evidence paths or known IPs provided. Output remains planning-only.")

    if not payload.get("known_prefixes") and not payload.get("known_asns"):
        warnings.append("No prefix/ASN context provided. Allocation and routing intelligence may be incomplete.")

    if not payload.get("time_range"):
        warnings.append("No time range provided. IP intelligence is highly temporal.")

    if not payload.get("configured_connectors"):
        warnings.append("No RDAP/RIR/BGP/RPKI/PTR/pDNS/CT/service/reputation connectors configured. External enrichment remains planning-only.")

    candidate_ips = as_list(payload.get("target_ip")) + as_list(payload.get("known_ips"))
    for ip in candidate_ips[:100]:
        cls = classify_ip(ip)
        if cls["valid"] and cls["requires_nonpublic_context"]:
            warnings.append(
                f"Special-use/non-public IP detected: {cls['normalized']} ({', '.join(cls['special_use'])}). "
                "Use authorized internal context only."
            )
            break

    if payload.get("known_campaigns") or payload.get("known_malware"):
        warnings.append(
            "Threat/malware/campaign context detected. Reputation/threat relationships remain source-attributed until CTI review."
        )

    return warnings


def default_questions(payload: Dict[str, Any]) -> List[str]:
    target = payload.get("target_ip", "target IP")

    return [
        f"What is {target}'s address family, special-use status, and normalized form?",
        "Which prefix/CIDR contains the IP, and which RIR allocation/assignment is reported?",
        "Which ASN currently/historically announces the prefix/IP?",
        "What BGP origin/RPKI/routing anomalies are supported by evidence?",
        "What PTR/passive DNS domain relationships exist, and when were they valid?",
        "Which hosting/cloud/CDN/proxy contexts are supported, and how are front-end vs origin separated?",
        "What public/authorized service metadata/exposure was observed, and how fresh is it?",
        "What reputation/abuse/threat reports exist, and are they independent and temporally current?",
        "Could the IP have been reassigned, sinkholed, seized, or be scanner/research infrastructure?",
        "What organization/provider associations are supported versus merely allocation/hosting?",
        "What contradictions exist among sources?",
        "What next passive/authorized action provides the most intelligence value?",
    ]


class TraceAtlasIPINTPanel(tk.Tk):
    def __init__(self) -> None:
        super().__init__()
        self.title(APP_TITLE)
        self.geometry("1380x940")
        self.minsize(1100, 760)

        self.entries: Dict[str, Any] = {}
        self.last_result: Dict[str, Any] = {}
        self.analyzed_files: List[Dict[str, Any]] = []
        self.parsed: Dict[str, Any] = empty_parsed()
        self.normalized_entities: List[Dict[str, Any]] = []
        self.usage_eras: List[Dict[str, Any]] = []
        self.contradictions: List[Dict[str, Any]] = []

        self._configure_style()
        self._build_ui()
        self._set_defaults()

    def _configure_style(self) -> None:
        style = ttk.Style(self)

        try:
            style.theme_use("clam")
        except tk.TclError:
            pass

        self.configure(bg="#0b0f19")

        style.configure("TFrame", background="#0b0f19")
        style.configure("TLabel", background="#0b0f19", foreground="#e5e7eb", font=("Segoe UI", 10))
        style.configure(
            "Header.TLabel",
            background="#0b0f19",
            foreground="#22d3ee",
            font=("Segoe UI", 17, "bold"),
        )
        style.configure(
            "Subheader.TLabel",
            background="#0b0f19",
            foreground="#94a3b8",
            font=("Segoe UI", 9),
        )
        style.configure("TNotebook", background="#0b0f19", borderwidth=0)
        style.configure("TNotebook.Tab", padding=[14, 7], font=("Segoe UI", 10, "bold"))

        style.configure(
            "TEntry",
            fieldbackground="#111827",
            foreground="#e5e7eb",
            insertcolor="#ffffff",
            bordercolor="#334155",
            lightcolor="#334155",
            darkcolor="#334155",
        )

        style.configure(
            "TCombobox",
            fieldbackground="#111827",
            foreground="#e5e7eb",
            arrowcolor="#e5e7eb",
            bordercolor="#334155",
            lightcolor="#334155",
            darkcolor="#334155",
        )

        style.configure(
            "TButton",
            padding=7,
            font=("Segoe UI", 10, "bold"),
            background="#1f2937",
            foreground="#e5e7eb",
            bordercolor="#475569",
            lightcolor="#475569",
            darkcolor="#475569",
        )

        style.map(
            "TButton",
            background=[("active", "#334155")],
            foreground=[("active", "#ffffff")],
        )

        style.configure(
            "Vertical.TScrollbar",
            background="#1f2937",
            troughcolor="#0b0f19",
            arrowcolor="#e5e7eb",
        )

    def _build_ui(self) -> None:
        header = ttk.Frame(self)
        header.pack(fill="x", padx=16, pady=(14, 8))

        ttk.Label(header, text="TraceAtlas IPINT AI Employee", style="Header.TLabel").pack(anchor="w")

        ttk.Label(
            header,
            text=(
                "Passive-first / authorized / evidence-first IP intelligence • Planning-only by default • "
                "Local deterministic JSON/CSV/TXT metadata parsing only • No scanning/exploitation/MITM/DDoS/BGP-hijack/DNS-poison • "
                "IP != person • allocation != ownership • ASN != tenant • hosting != operator • CDN edge != origin • "
                "historical reputation != current maliciousness"
            ),
            style="Subheader.TLabel",
            wraplength=1280,
            justify="left",
        ).pack(anchor="w", pady=(2, 0))

        self.notebook = ttk.Notebook(self)
        self.notebook.pack(fill="both", expand=True, padx=16, pady=(8, 16))

        self.input_tab = ttk.Frame(self.notebook)
        self.output_tab = ttk.Frame(self.notebook)

        self.notebook.add(self.input_tab, text="IPINT Task Input")
        self.notebook.add(self.output_tab, text="Output / IPINT Plan / Evidence")

        self._build_input_tab()
        self._build_output_tab()

    def _build_input_tab(self) -> None:
        container = ttk.Frame(self.input_tab)
        container.pack(fill="both", expand=True)

        self.canvas = tk.Canvas(container, bg="#0b0f19", highlightthickness=0)
        scrollbar = ttk.Scrollbar(container, orient="vertical", command=self.canvas.yview)
        self.form = ttk.Frame(self.canvas)

        self.form.bind("<Configure>", lambda e: self.canvas.configure(scrollregion=self.canvas.bbox("all")))
        self.canvas_window = self.canvas.create_window((0, 0), window=self.form, anchor="nw")
        self.canvas.configure(yscrollcommand=scrollbar.set)

        self.canvas.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")

        row = 0

        for key, label, kind in FIELDS:
            ttk.Label(self.form, text=label).grid(row=row, column=0, sticky="nw", padx=10, pady=6)

            if kind == "entry":
                widget = ttk.Entry(self.form, width=102)

            elif kind == "combo":
                widget = ttk.Combobox(
                    self.form,
                    values=TARGET_TYPES if key == "target_type" else [],
                    width=100,
                    state="readonly",
                )

            else:
                widget = tk.Text(
                    self.form,
                    height=3,
                    width=102,
                    bg="#111827",
                    fg="#e5e7eb",
                    insertbackground="white",
                    relief="flat",
                    highlightthickness=1,
                    highlightbackground="#334155",
                    font=("Segoe UI", 10),
                    wrap="word",
                )

            widget.grid(row=row, column=1, sticky="ew", padx=10, pady=6)
            self.entries[key] = widget
            row += 1

        self.form.columnconfigure(1, weight=1)

        buttons = ttk.Frame(self.input_tab)
        buttons.pack(fill="x", padx=10, pady=12)

        ttk.Button(buttons, text="Add IP Evidence Files", command=self.add_evidence_files).pack(side="left", padx=4)
        ttk.Button(buttons, text="Analyze Local IP Evidence", command=self.analyze_local_ipint).pack(side="left", padx=4)
        ttk.Button(buttons, text="Run Policy Screen", command=self.run_policy_screen).pack(side="left", padx=4)
        ttk.Button(buttons, text="Generate IPINT Plan", command=self.generate_plan).pack(side="left", padx=4)
        ttk.Button(buttons, text="Export JSON", command=self.export_json).pack(side="left", padx=4)
        ttk.Button(buttons, text="Copy Output", command=self.copy_output).pack(side="left", padx=4)
        ttk.Button(buttons, text="Clear Form", command=self.clear_form).pack(side="left", padx=4)

    def _build_output_tab(self) -> None:
        container = ttk.Frame(self.output_tab)
        container.pack(fill="both", expand=True)

        self.output = tk.Text(
            container,
            wrap="word",
            bg="#020617",
            fg="#a5f3fc",
            insertbackground="white",
            relief="flat",
            highlightthickness=1,
            highlightbackground="#334155",
            font=("Consolas", 11),
        )

        output_scroll = ttk.Scrollbar(container, orient="vertical", command=self.output.yview)
        self.output.configure(yscrollcommand=output_scroll.set)

        self.output.pack(side="left", fill="both", expand=True)
        output_scroll.pack(side="right", fill="y")

    def _set_defaults(self) -> None:
