    def run_policy_screen(self) -> None:
        payload = self.collect_payload()
        policy = policy_screen(payload)

        result = {
            "mode": "POLICY_SCREEN_ONLY",
            "panel_version": APP_VERSION,
            "policy_screen": policy,
            "payload_preview": {
                "case_id": payload.get("case_id"),
                "task_id": payload.get("task_id"),
                "objective": payload.get("objective"),
                "target": payload.get("target"),
                "target_type": payload.get("target_type"),
                "has_report_paths": bool(payload.get("report_paths")),
                "has_incident_reports": bool(payload.get("incident_report_paths")),
                "has_malware_reports": bool(payload.get("malware_report_paths")),
                "has_actor_reports": bool(payload.get("actor_report_paths")),
                "has_campaign_reports": bool(payload.get("campaign_report_paths")),
                "has_tool_reports": bool(payload.get("tool_report_paths")),
                "has_telemetry": bool(payload.get("telemetry_paths")),
                "has_detection_rules": bool(payload.get("detection_rule_paths")),
                "has_sigma": bool(payload.get("sigma_paths")),
                "has_yara": bool(payload.get("yara_paths")),
                "has_mitre_attack_data": bool(payload.get("mitre_attack_data_paths")),
                "has_stix": bool(payload.get("stix_paths")),
                "has_misp": bool(payload.get("misp_paths")),
                "has_attack_techniques": bool(payload.get("attack_techniques")),
                "has_attack_version": bool(payload.get("attack_version")),
            },
        }

        self.last_result = result
        self._write_output(result)
        self.notebook.select(self.output_tab)

        if policy["status"] == "POLICY_BLOCKED":
            messagebox.showwarning(
                "Policy Blocked",
                "This TTPINT request is policy-blocked.\n\n"
                + "\n".join(policy["reasons"])
                + "\n\nUse only defensive/authorized alternatives.",
            )
        elif policy["status"] == "HUMAN_REVIEW_REQUIRED":
            messagebox.showwarning(
                "Human Review Required",
                "No hard policy block detected, but sensitive TTP/incident/malware/actor/campaign/telemetry/detection context applies.",
            )
        else:
            messagebox.showinfo(
                "Policy Screen",
                "No obvious policy violation detected. Planning-only mode remains active.",
            )

    def analyze_local_ttpint(self) -> None:
        payload = self.collect_payload()
        policy = policy_screen(payload)

        if policy["status"] == "POLICY_BLOCKED":
            result = {
                "mode": "POLICY_BLOCKED",
                "panel_version": APP_VERSION,
                "policy_screen": policy,
                "evidence_inventory": [],
                "procedure_preview": [],
                "mapping_preview": [],
                "sequence_preview": [],
                "telemetry_preview": [],
                "detection_preview": [],
                "observations": [],
                "candidate_facts": [],
            }
            self.last_result = result
            self._write_output(result)
            messagebox.showwarning("Policy Blocked", "Local TTPINT evidence analysis blocked by policy screen.")
            return

        path_fields = [
            "report_paths",
            "incident_report_paths",
            "malware_report_paths",
            "actor_report_paths",
            "campaign_report_paths",
            "tool_report_paths",
            "telemetry_paths",
            "detection_rule_paths",
            "sigma_paths",
            "yara_paths",
            "mitre_attack_data_paths",
            "stix_paths",
            "misp_paths",
        ]

        all_paths: List[str] = []
        seen = set()

        for field in path_fields:
            for p in payload.get(field, []):
                sp = str(p).strip()
                if sp and sp not in seen:
                    seen.add(sp)
                    all_paths.append(sp)

        if not all_paths:
            messagebox.showwarning("No TTPINT Evidence", "Add local authorized/public TTP evidence files first.")
            return

        self.output.delete("1.0", "end")
        self.output.insert("1.0", "Analyzing local authorized/public TTPINT evidence. Hashing and parsing may take time...\n")
        self.notebook.select(self.output_tab)

        files: List[Dict[str, Any]] = []
        parsed_list: List[Dict[str, Any]] = []
        attack_version_default = str(payload.get("attack_version") or "UNKNOWN")

        for p in all_paths[:30]:
            f, parsed = analyze_ttp_file(p, payload.get("case_id", ""), payload.get("task_id", ""), attack_version_default=attack_version_default)
            files.append(f)
            parsed_list.append(parsed)

        aggregated = finalize_parsed(aggregate_parsed(parsed_list))

        self.analyzed_files = files
        self.parsed = aggregated

        report = self._build_local_analysis_report(
            files=files,
            parsed=aggregated,
            payload=payload,
            policy=policy,
        )

        self.last_result = report
        self._write_output(report)

        succeeded = sum(1 for f in files if str(f.get("status", "")).startswith("SUCCEEDED"))
        messagebox.showinfo(
            "Local TTPINT Evidence Analysis Complete",
            f"Processed {len(files)} evidence file(s).\n"
            f"Succeeded/partial: {succeeded}\n"
            f"Behaviors: {len(aggregated.get('behaviors', []))}\n"
            f"Procedures: {len(aggregated.get('procedures', []))}\n"
            f"Mappings: {len(aggregated.get('mappings', []))}\n"
            f"Sequences: {len(aggregated.get('sequences', []))}\n"
            f"Telemetry requirements: {len(aggregated.get('telemetry_requirements', []))}\n"
            f"Detections: {len(aggregated.get('detections', []))}\n"
            "Review output for limitations and next actions.",
        )

    def generate_plan(self) -> None:
        payload = self.collect_payload()
        warnings = validate_payload(payload)
        policy = policy_screen(payload)

        if policy["status"] == "POLICY_BLOCKED":
            result = {
                "mode": "POLICY_BLOCKED",
                "panel_version": APP_VERSION,
                "policy_screen": policy,
                "warnings": warnings,
                "payload": payload,
                "ttpint_collection_plan": [],
                "next_best_action": {
                    "action": "Revise task to remove prohibited offensive playbook/intrusion procedure generation, exploitation, evasion, malware, unauthorized testing, or destructive behavior.",
                    "owner": "TTP Intelligence Manager",
                    "expected_output": "Policy-compliant defensive TTPINT scope and question set.",
                },
            }
            self.last_result = result
            self._write_output(result)
            messagebox.showwarning(
                "Policy Blocked",
                "TTPINT plan not generated because the request is policy-blocked.",
            )
            return

        questions = payload.get("questions") or default_questions(payload)

        if not self.parsed.get("procedures") and not self.parsed.get("mappings"):
            self.parsed = finalize_parsed(empty_parsed())

        files = self.analyzed_files
        parsed = self.parsed

        contradictions = parsed.get("contradictions", [])
        hypotheses = parsed.get("hypotheses", [])
        knowledge_gaps = parsed.get("knowledge_gaps", [])
        handoffs = parsed.get("specialist_handoffs", [])
        next_action = build_next_best_action(payload, policy, files, parsed)

        overall_status = "PLANNING_ONLY"
        if policy["status"] == "HUMAN_REVIEW_REQUIRED":
            overall_status = "HUMAN_REVIEW_REQUIRED"
        if files or parsed.get("procedures") or parsed.get("mappings"):
            overall_status = "PLANNING_PLUS_LOCAL_DETERMINISTIC_EVIDENCE"

        result = {
            "mode": overall_status,
            "panel_version": APP_VERSION,
            "policy": (
                "This output does not generate offensive playbooks, intrusion procedures, target-specific attack sequences, credential theft procedures, "
                "persistence deployment procedures, privilege escalation procedures, exploit instructions, defense-evasion optimization, EDR/AV/sandbox bypass, "
                "log-clearing/destruction guidance, malware, C2 deployment instructions, or execute techniques against real systems. "
                "Local deterministic analysis is limited to hashing, safe JSON/CSV/TXT behavior/procedure/ATT&CK/telemetry/detection/STIX/MISP metadata parsing, "
                "ATT&CK ID/version validation, procedure-first mapping, sequence/co-occurrence separation, telemetry/detection/mitigation/control mapping, "
                "diagnosticity assessment, source independence, contradiction detection, competing hypotheses, falsification, secret redaction, prompt-injection flagging, "
                "and defensive specialist handoff planning. "
                "Live ATT&CK/STIX/TAXII/MISP/SIEM/EDR/NDR enrichment, authorized testing, detection deployment, and consequential attribution remain planning-only unless configured/authorized/human-reviewed."
            ),
            "policy_screen": policy,
            "warnings": warnings,
            "payload": payload,
            "intelligence_questions": questions,
            "evidence_inventory": files,
            "behavior_preview": parsed.get("behaviors", [])[:300],
            "procedure_preview": parsed.get("procedures", [])[:300],
            "mapping_preview": parsed.get("mappings", [])[:300],
            "sequence_preview": parsed.get("sequences", [])[:300],
            "cooccurrence_preview": parsed.get("cooccurrences", [])[:300],
            "telemetry_preview": parsed.get("telemetry_requirements", [])[:300],
            "detection_preview": parsed.get("detections", [])[:300],
            "mitigation_preview": parsed.get("mitigations", [])[:300],
            "control_preview": parsed.get("controls", [])[:300],
            "technique_summary": parsed.get("technique_summary", {}),
            "procedure_profiles": parsed.get("procedure_profiles", [])[:300],
            "campaign_profiles": parsed.get("campaign_profiles", [])[:300],
            "actor_profiles": parsed.get("actor_profiles", [])[:300],
            "malware_profiles": parsed.get("malware_profiles", [])[:300],
            "incident_profiles": parsed.get("incident_profiles", [])[:300],
            "tool_profiles": parsed.get("tool_profiles", [])[:300],
            "sequence_summary": parsed.get("sequence_summary", {}),
            "cooccurrence_summary": parsed.get("cooccurrence_summary", {}),
            "telemetry_summary": parsed.get("telemetry_summary", {}),
            "detection_summary": parsed.get("detection_summary", {}),
            "behavioral_drift": parsed.get("behavioral_drift", [])[:300],
            "contradictions": contradictions[:1000],
            "hypotheses": hypotheses[:1000],
            "knowledge_gaps": knowledge_gaps[:500],
            "specialist_handoffs": handoffs[:500],
            "next_best_action": next_action,
            "ttpint_collection_plan": build_collection_plan(payload, questions, files, parsed),
            **self._policy_sections(),
            **self._schemas(),
        }

        self.last_result = result
        self._write_output(result)
        self.notebook.select(self.output_tab)

        if warnings:
            messagebox.showwarning(
                "Validation Warnings",
                "TTPINT plan generated with warnings:\n\n" + "\n".join(warnings),
            )

    def _build_local_analysis_report(
        self,
        files: List[Dict[str, Any]],
        parsed: Dict[str, Any],
        payload: Dict[str, Any],
        policy: Dict[str, Any],
    ) -> Dict[str, Any]:
        contradictions = parsed.get("contradictions", [])
        hypotheses = parsed.get("hypotheses", [])
        knowledge_gaps = parsed.get("knowledge_gaps", [])
        handoffs = parsed.get("specialist_handoffs", [])
        next_action = build_next_best_action(payload, policy, files, parsed)

        observations: List[Dict[str, Any]] = []

        for f in files:
            observations.append({
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": f"A local authorized/public TTPINT evidence file was accessed and hashed: {f.get('filename')}.",
                "evidence_id": f.get("evidence_id"),
                "source_id": f.get("source_id"),
                "observed_at": now_utc(),
                "extraction_method": "local_deterministic_file_hash",
                "limitations": "File hash does not prove behavior, procedure, ATT&CK mapping, sequence, detection coverage, or attribution.",
            })

        observations.extend([
            {
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": f"{len(files)} TTPINT evidence file(s) were parsed locally.",
                "evidence_id": "AGGREGATE",
                "source_id": "LOCAL_PARSER",
                "observed_at": now_utc(),
                "extraction_method": "safe_json_csv_text_ttpint_parser",
                "limitations": "Parser output is normalized evidence, not verified external reality.",
            },
            {
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": f"{len(parsed.get('behaviors', []))} behavior record(s) and {len(parsed.get('procedures', []))} procedure record(s) were extracted.",
                "evidence_id": "AGGREGATE",
                "source_id": "LOCAL_BEHAVIOR_PARSER",
                "observed_at": now_utc(),
                "extraction_method": "behavior_procedure_extraction_normalization",
                "limitations": "Behavior/procedure records may be source-reported, inferred, or capability-level.",
            },
            {
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": f"{len(parsed.get('mappings', []))} ATT&CK mapping candidate(s) were generated with ID/version validation.",
                "evidence_id": "AGGREGATE",
                "source_id": "LOCAL_ATTCK_MAPPER",
                "observed_at": now_utc(),
                "extraction_method": "attck_id_validation_mapping_candidate_generation",
                "limitations": "Technique ID presence alone is not procedure evidence. Ambiguous mappings are preserved.",
            },
            {
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": f"{len(parsed.get('sequences', []))} sequence candidate(s) and {len(parsed.get('cooccurrences', []))} co-occurrence candidate(s) were preserved separately.",
                "evidence_id": "AGGREGATE",
                "source_id": "LOCAL_SEQUENCE_PARSER",
                "observed_at": now_utc(),
                "extraction_method": "sequence_cooccurrence_separation",
                "limitations": "Co-occurrence is not sequence. ATT&CK tactic order is not incident timeline.",
            },
            {
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": f"{len(parsed.get('telemetry_requirements', []))} telemetry requirement(s) and {len(parsed.get('detections', []))} detection candidate(s) were mapped defensively.",
                "evidence_id": "AGGREGATE",
                "source_id": "LOCAL_DETECTION_MAPPER",
                "observed_at": now_utc(),
                "extraction_method": "telemetry_detection_coverage_mapping",
                "limitations": "Missing telemetry does not prove behavior absence. Detection deployment requires authorized review.",
            },
            {
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": "No offensive playbook generation, intrusion procedure generation, exploitation, defense evasion, malware creation/deployment, unauthorized testing, or destructive behavior was performed.",
                "evidence_id": "LOCAL_PANEL_POLICY",
                "source_id": "LOCAL_POLICY_GUARD",
                "observed_at": now_utc(),
                "extraction_method": "defensive_evidence_first_policy",
                "limitations": "Planning/local deterministic panel only.",
            },
        ])

        observations, _ = truncate_list(observations, 500)

        candidate_facts: List[Dict[str, Any]] = []

        for f in files:
            if f.get("sha256"):
                candidate_facts.append({
                    "candidate_fact": f"The preserved local TTPINT evidence artifact {f.get('filename')} has SHA256 {f.get('sha256')}.",
                    "status": "SUPPORTED",
                    "evidence_ids": [f.get("evidence_id")],
                    "notes": "Supported by deterministic local hashing. Does not prove behavior, procedure, mapping, sequence, or attribution.",
                })

        candidate_facts.extend([
            {
                "candidate_fact": f"{len(parsed.get('procedures', []))} procedure candidate(s) were extracted.",
                "status": "SUPPORTED_AS_CANDIDATE_ONLY",
                "evidence_ids": ["AGGREGATE"],
                "not_supported": [
                    "verified actor behavior",
                    "verified campaign ownership",
                    "verified incident execution",
                    "verified sequence",
                    "verified detection coverage",
                ],
            },
            {
                "candidate_fact": f"{len(parsed.get('mappings', []))} ATT&CK mapping candidate(s) were generated.",
                "status": "SUPPORTED_AS_MAPPING_CANDIDATE_ONLY",
                "evidence_ids": ["AGGREGATE"],
                "notes": "Mapping status, confidence, ATT&CK version, and procedure evidence remain preserved.",
            },
            {
                "candidate_fact": f"{len(parsed.get('sequences', []))} sequence candidate(s) were preserved separately from co-occurrence.",
                "status": "SUPPORTED_AS_SEQUENCE_CANDIDATE_ONLY",
                "evidence_ids": ["AGGREGATE"],
                "notes": "Sequence requires temporal or incident evidence.",
            },
            {
                "candidate_fact": "No offensive playbook generation, intrusion procedure generation, exploitation, defense evasion, malware creation/deployment, unauthorized testing, or destructive behavior was performed.",
                "status": "SUPPORTED",
                "evidence_ids": ["LOCAL_PANEL_POLICY"],
                "notes": "Defensive/evidence-first planning boundary.",
            },
        ])

        candidate_facts, _ = truncate_list(candidate_facts, 200)

        fact_gate = {
            "status": "LOCAL_DETERMINISTIC_ONLY" if files or parsed.get("procedures") or parsed.get("mappings") else "NO_LOCAL_TTPINT_EVIDENCE",
            "supported": [
                "file existence and SHA256 hash",
                "parsed behavior records",
                "parsed procedure candidates",
                "parsed ATT&CK ID/format validation",
                "parsed mapping candidates with status/confidence/version",
                "parsed sequence candidates",
                "parsed co-occurrence candidates",
                "parsed telemetry requirements",
                "parsed detection candidates",
                "parsed mitigation/control candidates",
                "contradiction candidates",
                "competing hypotheses",
                "secret redaction flags",
                "prompt-injection flags",
            ],
            "not_supported": [
                "verified actor attribution",
                "verified campaign ownership",
                "verified incident execution",
                "verified procedure sequence",
                "verified detection coverage",
                "verified mitigation effectiveness",
                "offensive playbook generation",
                "intrusion procedure generation",
                "exploitation",
                "defense evasion",
                "malware creation/deployment",
                "unauthorized testing",
                "destructive behavior",
            ],
            "safety_status": "No offensive playbook generation, intrusion procedure generation, exploitation, defense evasion, malware creation/deployment, unauthorized testing, or destructive behavior performed.",
        }

        return {
            "mode": "LOCAL_DETERMINISTIC_TTPINT_ANALYSIS",
            "panel_version": APP_VERSION,
            "policy_screen": policy,
            "offensive_playbook_generation_performed": False,
            "intrusion_procedure_generation_performed": False,
            "exploitation_performed": False,
            "defense_evasion_optimization_performed": False,
            "malware_creation_or_deployment_performed": False,
            "unauthorized_testing_performed": False,
            "destructive_behavior_performed": False,
            "evidence_inventory": files,
            "behavior_preview": parsed.get("behaviors", [])[:300],
            "procedure_preview": parsed.get("procedures", [])[:300],
            "mapping_preview": parsed.get("mappings", [])[:300],
            "sequence_preview": parsed.get("sequences", [])[:300],
            "cooccurrence_preview": parsed.get("cooccurrences", [])[:300],
            "telemetry_preview": parsed.get("telemetry_requirements", [])[:300],
            "detection_preview": parsed.get("detections", [])[:300],
            "mitigation_preview": parsed.get("mitigations", [])[:300],
            "control_preview": parsed.get("controls", [])[:300],
            "technique_summary": parsed.get("technique_summary", {}),
            "procedure_profiles": parsed.get("procedure_profiles", [])[:300],
            "campaign_profiles": parsed.get("campaign_profiles", [])[:300],
            "actor_profiles": parsed.get("actor_profiles", [])[:300],
            "malware_profiles": parsed.get("malware_profiles", [])[:300],
            "incident_profiles": parsed.get("incident_profiles", [])[:300],
            "tool_profiles": parsed.get("tool_profiles", [])[:300],
            "sequence_summary": parsed.get("sequence_summary", {}),
            "cooccurrence_summary": parsed.get("cooccurrence_summary", {}),
            "telemetry_summary": parsed.get("telemetry_summary", {}),
            "detection_summary": parsed.get("detection_summary", {}),
            "behavioral_drift": parsed.get("behavioral_drift", [])[:300],
            "contradictions": contradictions[:1000],
            "hypotheses": hypotheses[:1000],
            "observations": observations,
            "candidate_facts": candidate_facts,
            "fact_gate": fact_gate,
            "knowledge_gaps": knowledge_gaps[:500],
            "specialist_handoffs": handoffs[:500],
            "recommended_next_actions": next_action,
            "limitations": [
                "Only local deterministic checks were performed.",
                "No network access was performed.",
                "No offensive playbook generation, intrusion procedure generation, exploitation, defense evasion, malware creation/deployment, unauthorized testing, or destructive behavior was performed.",
                "Tactic is not technique.",
                "Technique is not procedure.",
                "Tool is not technique or actor.",
                "IOC is not TTP.",
                "Malware capability is not observed procedure.",
                "Static capability is not incident execution.",
                "Common technique is not actor identity.",
                "Shared ATT&CK profile is not same actor.",
                "Co-occurrence is not sequence.",
                "ATT&CK tactic order is not incident timeline.",
                "Missing telemetry is not absence of behavior.",
                "Source mapping is not TraceAtlas-verified mapping.",
                "Multiple copied ATT&CK tables are not independent evidence.",
                "AI agreement is not source corroboration.",
                "Exposed secrets were redacted heuristically and not used.",
                "Threat reports, malware strings, logs, repositories, rule descriptions, and incident notes were treated as untrusted evidence.",
            ],
        }

    def finalize_parsed(parsed: Dict[str, Any]) -> Dict[str, Any]:
        for m in parsed.get("mappings", []):
            tid = m.get("technique_id")
            m["generic_technique"] = bool(tid and tid in GENERIC_TECHNIQUE_IDS)
            if m.get("generic_technique"):
                m["diagnosticity"] = "LOW"
            elif m.get("subtechnique_id"):
                m["diagnosticity"] = "MEDIUM"
            else:
                m["diagnosticity"] = "UNKNOWN"

        parsed["technique_summary"] = build_technique_summary(parsed)
        parsed["procedure_profiles"] = build_procedure_profiles(parsed)
        parsed["campaign_profiles"] = build_scope_profiles(parsed, "campaign_scope")
        parsed["actor_profiles"] = build_scope_profiles(parsed, "actor_scope")
        parsed["malware_profiles"] = build_scope_profiles(parsed, "malware_scope")
        parsed["incident_profiles"] = build_scope_profiles(parsed, "incident_scope")
        parsed["tool_profiles"] = build_scope_profiles(parsed, "tool_scope")
        parsed["sequence_summary"] = build_sequence_summary(parsed)
        parsed["cooccurrence_summary"] = build_cooccurrence_summary(parsed)
        parsed["telemetry_summary"] = build_telemetry_summary(parsed)
        parsed["detection_summary"] = build_detection_summary(parsed)
        parsed["behavioral_drift"] = build_behavioral_drift(parsed)
        parsed["contradictions"] = build_contradictions(parsed)
        parsed["hypotheses"] = build_hypotheses(parsed, parsed["contradictions"])
        parsed["knowledge_gaps"] = build_knowledge_gaps({}, [], parsed)
        parsed["specialist_handoffs"] = build_specialist_handoffs(parsed)

        return parsed

    def _write_output(self, result: Dict[str, Any]) -> None:
        self.output.delete("1.0", "end")
        self.output.insert("1.0", json.dumps(result, ensure_ascii=False, indent=2, default=str))

