# =====================================================================
# RESULT BUILDER
# =====================================================================

def graph_version_hash(m: ModelInt) -> str:
    seed_obj = {
        "models": sorted((mid, mv.canonical_name, mv.version, mv.revision or "", mv.provenance_state.value) for mid, mv in m.model_versions.items()),
        "artifacts": sorted((aid, a.model_version_id, a.digest or "", a.signature_state) for aid, a in m.art
                            @dataclass
class Hypothesis:
    id: str
    statement: str
    kind: str
    supporting_finding_ids: List[str] = field(default_factory=list)
    supporting_evidence_ids: List[str] = field(default_factory=list)
    contradicting_finding_ids: List[str] = field(default_factory=list)
    contradicting_evidence_ids: List[str] = field(default_factory=list)
    assumptions: List[str] = field(default_factory=list)
    predictions: List[str] = field(default_factory=list)
    falsification_conditions: List[str] = field(default_factory=list)
    status: HypothesisStatus = HypothesisStatus.UNRESOLVED
    confidence: float = 0.0
    limitations: List[str] = field(default_factory=list)
    def graph_version_hash(m: ModelInt) -> str:
    seed_obj = {
        "models": sorted(
            (
                mid,
                mv.canonical_name,
                mv.version,
                mv.revision or "",
                mv.provenance_state.value,
                mv.lineage_state.value,
            )
            for mid, mv in m.model_versions.items()
        ),
        "artifacts": sorted(
            (
                aid,
                a.model_version_id,
                a.digest or "",
                a.signature_state,
                a.availability.value,
            )
            for aid, a in m.artifacts.items()
        ),
        "evals": sorted(
            (
                eid,
                er.model_version_id,
                er.benchmark_id,
                float(er.score) if er.score is not None else -1.0,
                er.reported_by.value,
                er.contamination_state.value,
            )
            for eid, er in m.eval_results.items()
        ),
        "safety": sorted(
            (
                sid,
                st.model_version_id,
                st.test_type.value,
                st.result.value,
                int(st.failed_cases or 0),
                int(st.total_cases or 0),
            )
            for sid, st in m.safety_tests.items()
        ),
        "findings": sorted(
            (
                fid,
                f.finding_type.value,
                f.subject_id,
                f.verification_state.value,
                round(float(f.confidence), 3),
            )
            for fid, f in m.findings.items()
        ),
        "deployments": sorted(
            (
                did,
                d.model_version_id,
                d.alias or "",
                d.resolved_version or "",
                d.resolution_time or "",
            )
            for did, d in m.deployments.items()
        ),
    }
    return sha256_short(json.dumps(jsonable(seed_obj), sort_keys=True))


def build_source_graph(m: ModelInt) -> Dict[str, Any]:
    edges = []
    for src in m.sources.values():
        if src.derived_from:
            edges.append({
                "source": src.derived_from,
                "target": src.id,
                "relationship_type": "DERIVED_FROM",
            })
    return {
        "nodes": [s.id for s in m.sources.values()],
        "edges": edges,
    }


def build_source_dependency_graph(m: ModelInt) -> Dict[str, List[str]]:
    families: Dict[str, List[str]] = defaultdict(list)
    for sid in m.sources:
        fam = m.get_source_family(sid) or "UNKNOWN"
        families[fam].append(sid)
    return {k: sorted(v) for k, v in families.items()}


def _first_observed_time(m: ModelInt, evidence_ids: List[str]) -> Optional[str]:
    for eid in evidence_ids:
        ev = m.evidence.get(eid)
        if ev and ev.observed_at:
            return ev.observed_at
    return None


def build_timeline(m: ModelInt) -> List[Dict[str, Any]]:
    events: List[Dict[str, Any]] = []

    for mv in m.model_versions.values():
        if mv.release_date:
            events.append({
                "time": mv.release_date,
                "type": "MODEL_RELEASE",
                "subject_id": mv.id,
                "description": f"Model version {mv.canonical_name} {mv.version} release date recorded.",
                "source_ids": mv.source_ids,
                "evidence_ids": mv.evidence_ids,
            })

    for dep in m.deployments.values():
        if dep.resolution_time:
            events.append({
                "time": dep.resolution_time,
                "type": "DEPLOYMENT_ALIAS_RESOLUTION",
                "subject_id": dep.id,
                "description": (
                    f"Alias '{dep.alias}' resolved to {dep.resolved_version}; "
                    f"tools={dep.tools_enabled}, rag={dep.rag_enabled}."
                ),
                "source_ids": dep.source_ids,
                "evidence_ids": dep.evidence_ids,
            })

    for er in m.eval_results.values():
        bm = m.benchmarks.get(er.benchmark_id)
        t = bm.date if bm and bm.date else _first_observed_time(m, er.evidence_ids)
        if t:
            events.append({
                "time": t,
                "type": "EVALUATION_RESULT",
                "subject_id": er.id,
                "description": (
                    f"Evaluation {er.id}: benchmark={er.benchmark_id}, score={er.score}, "
                    f"reported_by={er.reported_by.value}, contamination={er.contamination_state.value}."
                ),
                "source_ids": er.source_ids,
                "evidence_ids": er.evidence_ids,
            })

    for st in m.safety_tests.values():
        t = _first_observed_time(m, st.evidence_ids)
        if t:
            events.append({
                "time": t,
                "type": "SAFETY_TEST",
                "subject_id": st.id,
                "description": (
                    f"Safety test {st.id}: type={st.test_type.value}, result={st.result.value}, "
                    f"failed={st.failed_cases}/{st.total_cases}."
                ),
                "source_ids": st.source_ids,
                "evidence_ids": st.evidence_ids,
            })

    for inc in m.incidents.values():
        if inc.time:
            events.append({
                "time": inc.time,
                "type": "INCIDENT",
                "subject_id": inc.id,
                "description": f"Incident {inc.id}: {inc.incident_type}; {inc.summary}",
                "source_ids": inc.source_ids,
                "evidence_ids": inc.evidence_ids,
            })

    for dr in m.drift_observations.values():
        if dr.current_time:
            events.append({
                "time": dr.current_time,
                "type": "DRIFT_OBSERVATION",
                "subject_id": dr.id,
                "description": (
                    f"Drift metric '{dr.metric}': baseline={dr.baseline_value}, current={dr.current_value}; "
                    f"possible causes={dr.possible_causes}."
                ),
                "source_ids": dr.source_ids,
                "evidence_ids": dr.evidence_ids,
            })

    return sorted(events, key=lambda e: dt_or_min(e.get("time")))


def build_model_graph(m: ModelInt) -> Dict[str, Any]:
    nodes: List[Dict[str, Any]] = []
    edges: List[Dict[str, Any]] = []

    for fam in m.model_families.values():
        nodes.append({
            "id": fam.id,
            "type": "ModelFamily",
            "name": fam.name,
            "provider": fam.provider,
            "publisher": fam.publisher,
        })

    for mv in m.model_versions.values():
        nodes.append({
            "id": mv.id,
            "type": "ModelVersion",
            "canonical_name": mv.canonical_name,
            "version": mv.version,
            "revision": mv.revision,
            "access_type": mv.access_type.value,
            "artifact_type": mv.artifact_type.value,
            "provenance_state": mv.provenance_state.value,
            "lineage_state": mv.lineage_state.value,
        })
        edges.append({
            "source": mv.id,
            "target": mv.family_id,
            "relationship_type": "VERSION_OF",
        })
        if mv.base_model:
            edges.append({
                "source": mv.id,
                "target": mv.base_model,
                "relationship_type": "FINE_TUNED_FROM_OR_DERIVED_FROM_CANDIDATE",
            })

    for art in m.artifacts.values():
        nodes.append({
            "id": art.id,
            "type": "Artifact",
            "model_version_id": art.model_version_id,
            "artifact_type": art.artifact_type.value,
            "digest": art.digest,
            "signature_state": art.signature_state,
            "availability": art.availability.value,
        })
        edges.append({
            "source": art.model_version_id,
            "target": art.id,
            "relationship_type": "HAS_ARTIFACT",
        })

    for tok in m.tokenizers.values():
        nodes.append({
            "id": tok.id,
            "type": "Tokenizer",
            "model_version_id": tok.model_version_id,
            "family": tok.family,
            "vocab_version": tok.vocab_version,
            "hash": tok.hash,
        })
        edges.append({
            "source": tok.model_version_id,
            "target": tok.id,
            "relationship_type": "USES_TOKENIZER",
        })

    for cap in m.capabilities.values():
        nodes.append({
            "id": cap.id,
            "type": "Capability",
            "model_version_id": cap.model_version_id,
            "name": cap.name,
            "kind": cap.kind.value,
            "state": cap.state.value,
            "score": cap.score,
        })
        edges.append({
            "source": cap.model_version_id,
            "target": cap.id,
            "relationship_type": "HAS_CAPABILITY",
        })

    for bm in m.benchmarks.values():
        nodes.append({
            "id": bm.id,
            "type": "Benchmark",
            "name": bm.name,
            "version": bm.version,
            "task": bm.task,
            "tool_use": bm.tool_use,
            "rag_use": bm.rag_use,
        })

    for er in m.eval_results.values():
        nodes.append({
            "id": er.id,
            "type": "EvaluationResult",
            "model_version_id": er.model_version_id,
            "benchmark_id": er.benchmark_id,
            "score": er.score,
            "reported_by": er.reported_by.value,
            "contamination_state": er.contamination_state.value,
        })
        edges.append({
            "source": er.model_version_id,
            "target": er.id,
            "relationship_type": "EVALUATED_AS",
        })
        edges.append({
            "source": er.id,
            "target": er.benchmark_id,
            "relationship_type": "MEASURED_ON",
        })

    for st in m.safety_tests.values():
        nodes.append({
            "id": st.id,
            "type": "SafetyTest",
            "model_version_id": st.model_version_id,
            "test_type": st.test_type.value,
            "result": st.result.value,
            "failed_cases": st.failed_cases,
            "total_cases": st.total_cases,
        })
        edges.append({
            "source": st.model_version_id,
            "target": st.id,
            "relationship_type": "TESTED_BY",
        })

    for pr in m.privacy_risks.values():
        nodes.append({
            "id": pr.id,
            "type": "PrivacyRisk",
            "model_version_id": pr.model_version_id,
            "risk_type": pr.risk_type.value,
            "state": pr.state.value,
        })
        edges.append({
            "source": pr.model_version_id,
            "target": pr.id,
            "relationship_type": "HAS_PRIVACY_RISK",
        })

    for node in m.supply_nodes.values():
        nodes.append({
            "id": node.id,
            "type": "SupplyNode",
            "node_type": node.node_type.value,
            "name": node.name,
            "version": node.version,
            "digest": node.digest,
        })

    for edge in m.supply_edges.values():
        edges.append({
            "source": edge.from_node,
            "target": edge.to_node,
            "relationship_type": edge.relationship,
        })

    for dep in m.deployments.values():
        nodes.append({
            "id": dep.id,
            "type": "Deployment",
            "model_version_id": dep.model_version_id,
            "mode": dep.mode.value,
            "alias": dep.alias,
            "resolved_version": dep.resolved_version,
            "tools_enabled": dep.tools_enabled,
            "rag_enabled": dep.rag_enabled,
        })
        edges.append({
            "source": dep.model_version_id,
            "target": dep.id,
            "relationship_type": "DEPLOYED_AS",
        })

    for inc in m.incidents.values():
        nodes.append({
            "id": inc.id,
            "type": "Incident",
            "model_version_id": inc.model_version_id,
            "incident_type": inc.incident_type,
            "time": inc.time,
        })
        edges.append({
            "source": inc.model_version_id,
            "target": inc.id,
            "relationship_type": "EXPERIENCED_INCIDENT",
        })

    for dr in m.drift_observations.values():
        nodes.append({
            "id": dr.id,
            "type": "DriftObservation",
            "model_version_id": dr.model_version_id,
            "metric": dr.metric,
            "baseline_value": dr.baseline_value,
            "current_value": dr.current_value,
        })
        edges.append({
            "source": dr.model_version_id,
            "target": dr.id,
            "relationship_type": "DRIFT_OBSERVED",
        })

    return {
        "nodes": nodes,
        "edges": edges,
        "guardrails": [
            "Model family/version/artifact/deployment are separate nodes.",
            "Capability and safety results are version- and condition-bound.",
            "Tool/RAG-assisted capability is not native model capability.",
            "Alias deployment is not exact weight identity.",
        ],
    }


def build_facts_by_state(m: ModelInt) -> Dict[str, List[Finding]]:
    out: Dict[str, List[Finding]] = defaultdict(list)
    for f in m.findings.values():
        out[f.verification_state.value].append(f)
    return {k: v for k, v in out.items()}


def build_result(m: ModelInt, status: Status) -> Dict[str, Any]:
    dual = m.dual_ai_review()
    summary = m.analyst_summary(dual)
    source_families = build_source_dependency_graph(m)
    facts_by_state = build_facts_by_state(m)

    finding_independence = {
        fid: m.independence_state(f.source_ids)
        for fid, f in m.findings.items()
    }

    supported_facts = facts_by_state.get(VerificationState.SUPPORTED.value, [])
    partial_facts = facts_by_state.get(VerificationState.PARTIALLY_SUPPORTED.value, [])
    candidate_facts = facts_by_state.get(VerificationState.CANDIDATE.value, [])
    disputed_facts = facts_by_state.get(VerificationState.DISPUTED.value, [])
    observed_facts = facts_by_state.get(VerificationState.OBSERVED.value, [])

    aliases: Dict[str, List[Dict[str, Any]]] = defaultdict(list)
    for dep in m.deployments.values():
        if dep.alias:
            aliases[dep.alias].append({
                "deployment_id": dep.id,
                "model_version_id": dep.model_version_id,
                "resolved_version": dep.resolved_version,
                "resolution_time": dep.resolution_time,
                "tools_enabled": dep.tools_enabled,
                "rag_enabled": dep.rag_enabled,
                "source_ids": dep.source_ids,
                "evidence_ids": dep.evidence_ids,
            })
    aliases = {k: v for k, v in aliases.items()}

    providers = sorted({fam.provider for fam in m.model_families.values() if fam.provider})
    publishers = sorted({fam.publisher for fam in m.model_families.values() if fam.publisher})

    artifacts = list(m.artifacts.values())
    checkpoints = [
        a for a in artifacts
        if a.artifact_type in {
            ArtifactType.CHECKPOINT,
            ArtifactType.QUANTIZED_CHECKPOINT,
            ArtifactType.ADAPTER,
            ArtifactType.LORA,
        }
    ]
    weight_hashes = {a.id: a.digest for a in artifacts if a.digest}
    signatures = {a.id: a.signature_state for a in artifacts}

    provenance_states = {mv.id: mv.provenance_state.value for mv in m.model_versions.values()}
    base_models = {mv.id: mv.base_model for mv in m.model_versions.values()}
    parent_models = {mv.id: mv.parent_models for mv in m.model_versions.values()}
    lineage = {mv.id: mv.lineage_state.value for mv in m.model_versions.values()}
    fine_tunes = {mv.id: mv.fine_tune_type for mv in m.model_versions.values()}
    adapters = {mv.id: mv.adapters for mv in m.model_versions.values()}
    loras = {
        mv.id: [a for a in mv.adapters if "lora" in normalize_text(a)]
        for mv in m.model_versions.values()
    }
    quantizations = {mv.id: mv.quantization for mv in m.model_versions.values()}
    distillation_context = {}

    architecture_claims = {mv.id: mv.architecture_claim for mv in m.model_versions.values()}
    parameter_counts = {mv.id: mv.parameter_count_claim for mv in m.model_versions.values()}
    active_parameter_counts = {mv.id: mv.active_parameter_count_claim for mv in m.model_versions.values()}

    context_windows: Dict[str, Dict[str, Any]] = {}
    for mv in m.model_versions.values():
        effective = None
        for cap in m.capabilities.values():
            if cap.model_version_id == mv.id and "effective" in normalize_text(cap.name) and cap.score is not None:
                effective = float(cap.score)
        for er in m.eval_results.values():
            if er.model_version_id == mv.id and "effective" in normalize_text(er.metric) and er.score is not None:
                effective = float(er.score)
        context_windows[mv.id] = {
            "claimed_max_input_tokens": mv.context_window_claim,
            "output_limit_claim": mv.output_limit_claim,
            "measured_effective_retrieval_tokens": effective,
            "guardrails": [
                "API token acceptance is not reliable long-context reasoning.",
                "Effective context is task-, prompt-, and position-dependent.",
            ],
        }

    output_limits = {mv.id: mv.output_limit_claim for mv in m.model_versions.values()}
    modalities = {mv.id: [x.value for x in mv.modalities] for mv in m.model_versions.values()}
    licenses = {mv.id: mv.license for mv in m.model_versions.values()}
    repositories = {mv.id: mv.repository for mv in m.model_versions.values()}

    training_data_claims: Dict[str, str] = {}
    for ev in m.evidence.values():
        disc = ev.parsed_fields.get("training_data_disclosure")
        if disc:
            for mv in m.model_versions.values():
                if ev.source_id in mv.source_ids:
                    training_data_claims[mv.id] = str(disc)

    datasets = sorted({bm.dataset for bm in m.benchmarks.values() if bm.dataset})

    native_capabilities = [c for c in m.capabilities.values() if c.kind == CapabilityKind.NATIVE]
    system_capabilities = [c for c in m.capabilities.values() if c.kind in {
        CapabilityKind.TOOL,
        CapabilityKind.RAG,
        CapabilityKind.AGENT,
    }]
    tools = [c for c in m.capabilities.values() if c.kind == CapabilityKind.TOOL]
    function_calling = [
        c for c in m.capabilities.values()
        if "function" in normalize_text(c.name) or "tool" in normalize_text(c.name)
    ]
    structured_output = [
        c for c in m.capabilities.values()
        if "structured" in normalize_text(c.name) or "json" in normalize_text(c.name)
    ]
    agents = [dep for dep in m.deployments.values() if dep.tools_enabled]
    rag_systems = [dep for dep in m.deployments.values() if dep.rag_enabled]
    embedding_models = []
    rerankers = []

    benchmarks = list(m.benchmarks.values())
    benchmark_versions = {bm.id: bm.version for bm in m.benchmarks.values()}
    evaluation_harnesses = {bm.id: bm.harness_id for bm in m.benchmarks.values()}
    eval_results = list(m.eval_results.values())
    reproductions = {er.id: er.reproduction_state for er in m.eval_results.values()}
    contamination_risk = {er.id: er.contamination_state.value for er in m.eval_results.values()}

    capability_drift = list(m.drift_observations.values())

    hallucination_context = [
        st for st in m.safety_tests.values()
        if st.test_type == SafetyTestType.HALLUCINATION
    ]
    calibration = [
        st for st in m.safety_tests.values()
        if st.test_type == SafetyTestType.CALIBRATION
    ]
    abstention = [
        st for st in m.safety_tests.values()
        if st.test_type == SafetyTestType.ABSTENTION
    ]
    safety_evals = list(m.safety_tests.values())
    jailbreak_resilience = [
        st for st in m.safety_tests.values()
        if st.test_type == SafetyTestType.JAILBREAK_RESILIENCE
    ]
    prompt_injection_resilience = [
        st for st in m.safety_tests.values()
        if st.test_type in {
            SafetyTestType.PROMPT_INJECTION,
            SafetyTestType.INDIRECT_PROMPT_INJECTION,
        }
    ]
    tool_safety = [
        st for st in m.safety_tests.values()
        if st.test_type in {
            SafetyTestType.TOOL_SAFETY,
            SafetyTestType.EXCESSIVE_AGENCY,
        }
    ]

    privacy_risk = list(m.privacy_risks.values())
    memorization_risk = [
        pr for pr in m.privacy_risks.values()
        if pr.risk_type == PrivacyRiskType.MEMORIZATION
    ]
    model_extraction_risk = [
        pr for pr in m.privacy_risks.values()
        if pr.risk_type == PrivacyRiskType.MODEL_EXTRACTION
    ]
    model_inversion_context = [
        pr for pr in m.privacy_risks.values()
        if pr.risk_type == PrivacyRiskType.MODEL_INVERSION
    ]
    membership_inference_context = [
        pr for pr in m.privacy_risks.values()
        if pr.risk_type == PrivacyRiskType.MEMBERSHIP_INFERENCE
    ]
    poisoning_context = [
        f for f in m.findings.values()
        if "poison" in normalize_text(f.statement)
    ]
    backdoor_context = [
        f for f in m.findings.values()
        if "backdoor" in normalize_text(f.statement)
    ]

    supply_chain_context = {
        "nodes": list(m.supply_nodes.values()),
        "edges": list(m.supply_edges.values()),
        "guardrails": [
            "Model supply-chain observation is not compromise evidence.",
            "Runtime CVE applicability belongs to VULNINT.",
            "Attestation is not absolute truth.",
        ],
    }

    runtime_dependencies = [
        node for node in m.supply_nodes.values()
        if node.node_type in {
            SupplyNodeType.INFERENCE_SERVER,
            SupplyNodeType.TOKENIZER_LIBRARY,
            SupplyNodeType.CONTAINER_BASE,
            SupplyNodeType.PACKAGE,
            SupplyNodeType.RUNTIME,
        }
    ]

    deployment_modes = sorted({dep.mode.value for dep in m.deployments.values()})
    data_retention_context = {
        dep.id: dep.retention_claim
        for dep in m.deployments.values()
        if dep.retention_claim
    }

    incidents = list(m.incidents.values())
    risk_dimensions = m.risk_dimensions
    timeline_updates = build_timeline(m)
    observations = list(m.evidence.values())

    source_reliability = {sid: src.reliability for sid, src in m.sources.items()}
    source_bias = {sid: src.notes for sid, src in m.sources.items()}
    source_limitations = {
        sid: [src.notes]
        for sid, src in m.sources.items()
        if src.notes
    }
    source_pedigree = {sid: m.get_source_family(sid) for sid in m.sources}
    source_independence = {
        "source_families": source_families,
        "finding_independence": finding_independence,
    }

    falsification_results = [
        {
            "hypothesis_id": h.id,
            "statement": h.statement,
            "kind": h.kind,
            "status": h.status.value,
            "confidence": h.confidence,
            "supporting_finding_ids": h.supporting_finding_ids,
            "contradicting_finding_ids": h.contradicting_finding_ids,
            "assumptions": h.assumptions,
            "predictions": h.predictions,
            "falsification_conditions": h.falsification_conditions,
            "limitations": h.limitations,
        }
        for h in m.hypotheses
    ]

    privacy_flags = [
        PrivacyFlag.CASE_SCOPED.value,
        PrivacyFlag.AUTHORIZED_MODEL_ONLY.value,
        PrivacyFlag.NO_WEIGHT_THEFT.value,
        PrivacyFlag.NO_PROPRIETARY_EXTRACTION.value,
        PrivacyFlag.NO_API_ABUSE.value,
        PrivacyFlag.NO_JAILBREAK_OPTIMIZATION.value,
        PrivacyFlag.NO_POISONING.value,
        PrivacyFlag.NO_BACKDOOR_CREATION.value,
        PrivacyFlag.NO_TRAINING_DATA_EXFILTRATION.value,
        PrivacyFlag.NO_CREDENTIAL_USE.value,
        PrivacyFlag.NO_UNKNOWN_CODE_EXECUTION.value,
        PrivacyFlag.LOCAL_ONLY_DEFAULT.value,
    ]

    legal_flags = [
        "License and training-data disclosure ambiguity requires LEGALINT/counsel review.",
        "Consequential production model replacement or safety-control changes require human approval.",
        "Model compromise or provider misconduct allegations require independent evidence and human review.",
    ]

    unknowns = sorted(set(
        [g.description for g in m.gaps]
        + [
            h.statement
            for h in m.hypotheses
            if h.status in {
                HypothesisStatus.UNRESOLVED,
                HypothesisStatus.DISPUTED,
            }
        ]
    ))

    limitations = [
        "Local synthetic demo; no live model provider, API, registry, or inference-server access.",
        "Defensive authorized model intelligence only.",
        "No model weights were stolen, extracted, reconstructed, or exfiltrated.",
        "No API abuse, authentication bypass, rate-limit evasion, or billing evasion was performed.",
        "No malicious jailbreaks, safety bypasses, poisoning payloads, or backdoors were generated.",
        "No unknown checkpoint or repository code was executed.",
        "Model name is not model version.",
        "Model version is not exact deployed weights.",
        "Provider claim is not measured capability.",
        "Benchmark score is not general intelligence.",
        "Tool/RAG-assisted performance is not native model capability.",
        "Context-window acceptance is not effective long-context reasoning.",
        "Behavioral drift is not proof of weight change.",
        "Synthetic safety failures are environment/version-specific and not universal model defects.",
    ] + m.validation_errors

    replay_manifest = {
        "generated_at": now_iso(),
        "pipeline_version": PIPELINE_VERSION,
        "graph_version": graph_version_hash(m),
        "core_principle": (
            "MODEL REFERENCE -> EXACT MODEL RESOLUTION -> VERSION -> ARTIFACT / PROVIDER -> PROVENANCE -> "
            "LINEAGE -> DEPLOYMENT CONTEXT -> CLAIMED CAPABILITY -> MEASURED CAPABILITY -> "
            "SAFETY / RISK EVALUATION -> SOURCE RELIABILITY -> SOURCE INDEPENDENCE -> CONTRADICTIONS -> "
            "FACT GATE -> DEFENSIBLE MODEL ASSESSMENT"
        ),
        "as_of": m.as_of,
        "identity_rule": "Model name != model version != exact weights != deployed system behavior.",
        "capability_rule": "Native model capability must be separated from tool, RAG, system-prompt, and orchestration effects.",
        "evaluation_rule": "Benchmark scores are condition-bound: harness, prompt, sampling, tool use, RAG use, dataset version, and date matter.",
        "safety_rule": "Authorized synthetic safety testing only; no operational harmful bypass optimization.",
        "provenance_rule": "Hash/signature/attestation support integrity context, not benignness or absolute trust.",
        "drift_rule": "Alias/routing/behavior drift is not proof of weight change.",
        "policy_exclusions": [
            "No weight theft or proprietary model extraction.",
            "No training-data exfiltration.",
            "No private user-data extraction.",
            "No API abuse or authentication bypass.",
            "No malicious jailbreak generation or optimization.",
            "No safety-control disabling without authorization.",
            "No poisoning of training data, retrieval corpora, or models.",
            "No backdoor creation.",
            "No execution of unknown checkpoint/repository code.",
            "No deployment of untrusted checkpoints.",
        ],
        "source_lineage": source_families,
        "finding_independence": finding_independence,
    }

    return {
        "case_id": m.case.case_id,
        "task_id": m.case.task_id,
        "objective": m.case.objective,
        "questions": m.case.questions,
        "scope": m.case.scope,
        "authorization": m.case.authorization,
        "status": status.value,
        "as_of": m.as_of,

        "source_ids": sorted(m.sources.keys()),
        "evidence_ids": sorted(m.evidence.keys()),

        "models": list(m.model_versions.values()),
        "model_families": list(m.model_families.values()),
        "model_versions": list(m.model_versions.values()),
        "aliases": aliases,
        "providers": providers,
        "publishers": publishers,

        "artifacts": artifacts,
        "checkpoints": checkpoints,
        "weight_hashes": weight_hashes,
        "signatures": signatures,
        "provenance_states": provenance_states,

        "base_models": base_models,
        "parent_models": parent_models,
        "lineage": lineage,
        "fine_tunes": fine_tunes,
        "adapters": adapters,
        "loras": loras,
        "quantizations": quantizations,
        "distillation_context": distillation_context,

        "architecture_claims": architecture_claims,
        "parameter_counts": parameter_counts,
        "active_parameter_counts": active_parameter_counts,
        "tokenizers": list(m.tokenizers.values()),
        "context_windows": context_windows,
        "output_limits": output_limits,
        "modalities": modalities,
        "licenses": licenses,
        "repositories": repositories,

        "training_data_claims": training_data_claims,
        "datasets": datasets,

        "native_capabilities": native_capabilities,
        "system_capabilities": system_capabilities,
        "tools": tools,
        "function_calling": function_calling,
        "structured_output": structured_output,
        "agents": agents,
        "rag_systems": rag_systems,
        "embedding_models": embedding_models,
        "rerankers": rerankers,

        "benchmarks": benchmarks,
        "benchmark_versions": benchmark_versions,
        "evaluation_harnesses": evaluation_harnesses,
        "eval_results": eval_results,
        "reproductions": reproductions,
        "contamination_risk": contamination_risk,

        "capability_drift": capability_drift,
        "hallucination_context": hallucination_context,
        "calibration": calibration,
        "abstention": abstention,
        "safety_evals": safety_evals,
        "jailbreak_resilience": jailbreak_resilience,
        "prompt_injection_resilience": prompt_injection_resilience,
        "tool_safety": tool_safety,

        "privacy_risk": privacy_risk,
        "memorization_risk": memorization_risk,
        "model_extraction_risk": model_extraction_risk,
        "model_inversion_context": model_inversion_context,
        "membership_inference_context": membership_inference_context,
        "poisoning_context": poisoning_context,
        "backdoor_context": backdoor_context,

        "supply_chain_context": supply_chain_context,
        "runtime_dependencies": runtime_dependencies,
        "deployment_modes": deployment_modes,
        "data_retention_context": data_retention_context,
        "incidents": incidents,
        "risk_dimensions": risk_dimensions,

        "timeline_updates": timeline_updates,

        "observations": observations,
        "candidate_facts": candidate_facts,
        "supported_facts": supported_facts,
        "partial_facts": partial_facts,
        "disputed_facts": disputed_facts,
        "observed_facts": observed_facts,

        "source_reliability": source_reliability,
        "source_bias": source_bias,
        "source_limitations": source_limitations,
        "source_pedigree": source_pedigree,
        "source_independence": source_independence,

        "contradictions": m.contradictions,
        "hypotheses": m.hypotheses,
        "falsification_results": falsification_results,

        "privacy_flags": privacy_flags,
        "legal_flags": legal_flags,

        "unknowns": unknowns,
        "knowledge_gaps": m.gaps,
        "recommended_next_actions": m.actions,
        "recommendations": m.recommendations,
        "specialist_handoffs": m.handoffs,

        "limitations": limitations,
        "analyst_summary": summary,
        "dual_ai_review": dual,
        "model_graph": build_model_graph(m),
        "source_graph": build_source_graph(m),
        "source_dependency_graph": source_families,
        "replay_manifest": replay_manifest,
    }


# =====================================================================
# PIPELINES
# =====================================================================

def run_sample_pipeline() -> Dict[str, Any]:
    m = build_sample_modelint()
    return build_result(m, Status.PARTIAL)


def run_unconfigured_pipeline(case: Case) -> Dict[str, Any]:
    m = ModelInt(case)

    m.gaps.append(KnowledgeGap(
        id="GAP-NO-MODEL-EVIDENCE",
        gap_type=GapType.EXACT_VERSION_UNKNOWN,
        description=(
            "No configured public/authorized model-intelligence corpus is available. "
            "No model identity, version, artifact, provenance, capability, safety, privacy, "
            "supply-chain, or deployment conclusion can be resolved."
        ),
        importance="HIGH",
        recommended_source=(
            "Provide authorized model cards, provider documentation, release notes, artifact registry metadata, "
            "signed manifests, independent evaluation reports, red-team reports, runtime metadata, SBOMs, "
            "license metadata, and incident reports."
        ),
        specialist="MODELINT / SUPPLYCHAININT / VULNINT / LEGALINT",
        expected_information_value=0.95,
    ))

    m.actions = [
        NextAction(
            id="ACT-CONFIGURE-MODEL-EVIDENCE",
            description=(
                "Configure lawful public/authorized model-intelligence evidence or supply a sanitized local corpus. "
                "Do not steal/extract weights, abuse APIs, bypass safety, poison models/data/RAG, create backdoors, "
                "or execute unknown checkpoint code."
            ),
            priority=1,
            privacy_impact="LOW",
            expected_gain=0.95,
            specialist=None,
            requires_human_approval=False,
        )
    ]

    m.handoffs = []
    m.hypotheses = []
    m.risk_dimensions = {rd.value: "UNKNOWN" for rd in RiskDimension}

    dual = {
        "primary_model_analyst": "No evidence available.",
        "independent_model_skeptic_issues": [
            "No model sources configured.",
            "No exact model version can be resolved.",
            "No artifact/provenance can be verified.",
            "No capability or safety claim can be made.",
            "No model identity can be inferred from name alone.",
        ],
        "verdict": "INSUFFICIENT_EVIDENCE",
        "note": "AI agreement is not independent model evidence.",
    }

    summary = (
        "MODELINT UNRESOLVED: No configured public/authorized model evidence corpus. "
        "No model versions, weights, artifacts, capabilities, benchmarks, safety properties, incidents, "
        "providers, or lineage were fabricated. Provide authorized evidence or run sample mode."
    )

    result = build_result(m, Status.BLOCKED_CONFIGURATION)
    result["analyst_summary"] = summary
    result["dual_ai_review"] = dual
    return result


def blocked_policy_result(case: Case, violations: List[Dict[str, str]]) -> Dict[str, Any]:
    return {
        "case_id": case.case_id,
        "task_id": case.task_id,
        "objective": case.objective,
        "status": Status.BLOCKED_POLICY.value,
        "policy_violations": violations,
        "message": (
            "Prohibited AI model intelligence request detected. MODELINT supports lawful, defensive, "
            "authorized, evidence-first model intelligence only. It does not steal or extract model weights, "
            "abuse APIs, bypass authentication/rate limits/billing, exfiltrate training data, generate or optimize "
            "malicious jailbreaks, disable safety controls, poison models/data/RAG, create backdoors, "
            "execute unknown checkpoint code, or deploy untrusted artifacts."
        ),
        "lawful_alternatives": [
            "Resolve exact model identity/version from authorized provider metadata and artifact registries.",
            "Separate provider claims from independently measured capabilities.",
            "Separate native model capability from tool/RAG/system-prompt effects.",
            "Run authorized synthetic safety evaluations without publishing harmful bypasses.",
            "Assess provenance, attestations, signatures, and supply-chain dependencies defensively.",
            "Route license/training-data/legal questions to LEGALINT.",
            "Require human review for production model changes, autonomy expansion, or compromise allegations.",
        ],
        "privacy_flags": [
            PrivacyFlag.NO_WEIGHT_THEFT.value,
            PrivacyFlag.NO_PROPRIETARY_EXTRACTION.value,
            PrivacyFlag.NO_API_ABUSE.value,
            PrivacyFlag.NO_JAILBREAK_OPTIMIZATION.value,
            PrivacyFlag.NO_POISONING.value,
            PrivacyFlag.NO_BACKDOOR_CREATION.value,
            PrivacyFlag.NO_TRAINING_DATA_EXFILTRATION.value,
            PrivacyFlag.NO_CREDENTIAL_USE.value,
            PrivacyFlag.NO_UNKNOWN_CODE_EXECUTION.value,
        ],
        "limitations": [
            "No model-intelligence analysis performed.",
            "No models, versions, weights, capabilities, safety properties, or incidents fabricated.",
            "No weights extracted and no APIs abused.",
        ],
    }


def run_pipeline(case: Case) -> Dict[str, Any]:
    text = " ".join(
        [
            case.objective,
            *case.questions,
            *case.model_names,
            *case.model_ids,
            *case.providers,
            *case.versions,
            *case.artifacts,
            *case.repositories,
            case.authorization or "",
            " ".join(case.scope),
        ]
    )

    violations = policy_guard(text)
    if violations:
        return blocked_policy_result(case, violations)

    if case.sample:
        return run_sample_pipeline()

    return run_unconfigured_pipeline(case)


# =====================================================================
# CLI
# =====================================================================

def main() -> None:
    parser = argparse.ArgumentParser(
        description=(
            "TRACEATLAS MODELINT local defensive AI model intelligence pipeline. "
            "Sample mode uses synthetic authorized model-card/eval/red-team/runtime evidence."
        )
    )
    parser.add_argument("--sample", action="store_true", help="Run built-in synthetic MODELINT sample.")
    parser.add_argument("--objective", help="Defensive AI model intelligence objective.")
    parser.add_argument("--question", action="append", default=[], help="Analytic question. Repeatable.")
    parser.add_argument("--model", action="append", default=[], help="Model name. Repeatable.")
    parser.add_argument("--model-id", action="append", default=[], help="Model ID. Repeatable.")
    parser.add_argument("--provider", action="append", default=[], help="Provider name. Repeatable.")
    parser.add_argument("--version", action="append", default=[], help="Model version. Repeatable.")
    parser.add_argument("--artifact", action="append", default=[], help="Artifact ID/digest. Repeatable.")
    parser.add_argument("--repository", action="append", default=[], help="Repository URL/ID. Repeatable.")
    parser.add_argument("--time-range", help="Time range hint.")
    parser.add_argument("--as-of", default=DEFAULT_AS_OF, help="Analysis as-of timestamp.")

    args = parser.parse_args()

    if args.sample or not args.objective:
        case = sample_case()
    else:
        case = Case(
            case_id=new_id("CASE-", args.objective),
            task_id=new_id("TASK-", args.objective),
            objective=args.objective,
            questions=args.question,
            model_names=args.model,
            model_ids=args.model_id,
            providers=args.provider,
            versions=args.version,
            artifacts=args.artifact,
            repositories=args.repository,
            time_range=args.time_range,
            as_of=args.as_of,
            sample=False,
        )

    result = run_pipeline(case)
    print(json.dumps(jsonable(result), indent=2, ensure_ascii=False))


if __name__ == "__main__":
    main()