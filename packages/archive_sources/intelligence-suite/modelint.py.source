        self.handoffs = [
            {"specialist": "REPOINT", "reason": "Repository code, commits, model card files, training/inference code provenance."},
            {"specialist": "PACKAGEINT", "reason": "Package identity, registry metadata, dependency versions."},
            {"specialist": "SUPPLYCHAININT", "reason": "Build provenance, attestations, artifact registry, vendor risk."},
            {"specialist": "VULNINT", "reason": "Runtime/software CVE applicability and patch priority."},
            {"specialist": "DATASETINT", "reason": "Training dataset provenance, licensing, bias, contamination deep analysis."},
            {"specialist": "MALINT", "reason": "If checkpoint/repository artifact is suspected malicious."},
            {"specialist": "CLOUDINT", "reason": "Deployment/runtime cloud configuration and logging."},
            {"specialist": "INCIDENTINT", "reason": "If model routing/safety incident requires reconstruction."},
            {"specialist": "LEGALINT", "reason": "License, IP, training-data disclosure, and consequential legal review."},
            {"specialist": "CYBINT", "reason": "Broader AI system security risk and adversarial operation context."},
        ]

    def dual_ai_review(self) -> Dict[str, Any]:
        issues: List[str] = []

        if any(f.finding_type == FindingType.MODEL_IDENTITY_PARTIALLY_RESOLVED for f in self.findings.values()):
            issues.append("Exact model identity/production weights remain partially unresolved.")

        if any(f.finding_type in {FindingType.VERSION_ALIAS_DRIFT_CANDIDATE, FindingType.SILENT_UPDATE_SUSPECTED} for f in self.findings.values()):
            issues.append("Alias/version drift and silent-update suspicion remain open.")

        if any(f.finding_type == FindingType.CONTEXT_WINDOW_OVERCLAIM_CANDIDATE for f in self.findings.values()):
            issues.append("Context-window claim conflicts with measured effective retrieval.")

        if any(f.finding_type in {FindingType.TOOL_ASSISTED_SCORE_NOT_NATIVE, FindingType.RAG_ASSISTED_SCORE_NOT_NATIVE} for f in self.findings.values()):
            issues.append("Some benchmark performance is system-derived, not native model capability.")

        if any(f.finding_type in {
            FindingType.PROMPT_INJECTION_FAILURE_CANDIDATE,
            FindingType.INDIRECT_PROMPT_INJECTION_FAILURE_CANDIDATE,
            FindingType.TOOL_SAFETY_FAILURE_CANDIDATE,
        } for f in self.findings.values()):
            issues.append("Authorized synthetic safety tests identified tool/prompt-injection boundary failures.")

        if any(f.finding_type == FindingType.BENCHMARK_CONTAMINATION_POSSIBLE for f in self.findings.values()):
            issues.append("Benchmark contamination remains possible but unconfirmed.")

        if any(f.finding_type == FindingType.PROVENANCE_PARTIAL for f in self.findings.values()):
            issues.append("Artifact provenance is partial.")

        if any(f.finding_type == FindingType.LICENSE_AMBIGUITY for f in self.findings.values()):
            issues.append("License/training-data disclosure ambiguity requires LEGALINT.")

        if self.contradictions:
            issues.append(f"{len(self.contradictions)} contradiction(s) remain open.")

        if not issues:
            verdict = "AGREE"
        elif len(issues) <= 5:
            verdict = "PARTIAL_AGREEMENT"
        else:
            verdict = "INSUFFICIENT_EVIDENCE"

        return {
            "primary_model_analyst": (
                "Synthetic authorized corpus supports partial identity for ATLAS-7 2026.09.1, with alias drift, "
                "partial provenance, claimed long-context support, measured effective-context decline, tool/RAG-assisted "
                "benchmark inflation risk, and synthetic prompt-injection/tool-boundary failures. Model self-report is not authoritative."
            ),
            "independent_model_skeptic_issues": issues,
            "verdict": verdict,
            "adversarial_checks": [
                "Is model name treated as exact version? No.",
                "Is provider claim treated as measured capability? No.",
                "Is tool/RAG-assisted score attributed to native model? No.",
                "Is context window treated as effective recall? No.",
                "Is behavioral drift treated as weight-change proof? No.",
                "Is model self-report treated as identity evidence? No.",
                "Were weights extracted or APIs abused? No.",
                "Were malicious jailbreaks/poisoning/backdoors generated? No.",
                "Was unknown checkpoint code executed? No.",
            ],
            "note": "AI agreement is analytical agreement, not independent model evidence.",
        }

    def analyst_summary(self, dual: Dict[str, Any]) -> str:
        mv = next(iter(self.model_versions.values()), None)
        dep = next((d for d in self.deployments.values() if d.alias), None)
        ctx_overclaim = any(f.finding_type == FindingType.CONTEXT_WINDOW_OVERCLAIM_CANDIDATE for f in self.findings.values())
        tool_native = any(f.finding_type in {FindingType.TOOL_ASSISTED_SCORE_NOT_NATIVE, FindingType.RAG_ASSISTED_SCORE_NOT_NATIVE} for f in self.findings.values())
        pi_fail = any(f.finding_type in {
            FindingType.PROMPT_INJECTION_FAILURE_CANDIDATE,
            FindingType.INDIRECT_PROMPT_INJECTION_FAILURE_CANDIDATE,
            FindingType.TOOL_SAFETY_FAILURE_CANDIDATE,
        } for f in self.findings.values())

        lines = [
            f"MODEL: {mv.canonical_name if mv else 'UNKNOWN'}",
            f"PROVIDER / PUBLISHER: {self.model_families[mv.family_id].provider if mv and mv.family_id in self.model_families else 'UNKNOWN'}",
            f"EXACT VERSION / REVISION: {mv.version if mv else 'UNKNOWN'} / {mv.revision if mv else 'UNKNOWN'}",
            f"ACCESS TYPE: {mv.access_type.value if mv else 'UNKNOWN'}",
            f"ARTIFACT / HASH: {mv.artifact_hashes if mv else 'UNKNOWN'}",
            f"PROVENANCE: {mv.provenance_state.value if mv else 'UNKNOWN'}",
            f"BASE MODEL / LINEAGE: {mv.base_model if mv else 'UNKNOWN'} / {mv.lineage_state.value if mv else 'UNKNOWN'}",
            f"CONTEXT WINDOW CLAIM: {mv.context_window_claim if mv else 'UNKNOWN'}",
            f"DEPLOYMENT ALIAS: {dep.alias if dep else 'UNKNOWN'} resolved to {dep.resolved_version if dep else 'UNKNOWN'}",
            "",
            "ASSESSMENT:",
            f"- MODEL IDENTITY = {'PARTIALLY_RESOLVED' if any(f.finding_type == FindingType.MODEL_IDENTITY_PARTIALLY_RESOLVED for f in self.findings.values()) else 'RESOLVED'}.",
            f"- ALIAS DRIFT = {'CANDIDATE' if any(f.finding_type == FindingType.VERSION_ALIAS_DRIFT_CANDIDATE for f in self.findings.values()) else 'NOT_OBSERVED'}.",
            f"- LONG-CONTEXT ACCEPTANCE = {'SUPPORTED' if any('context' in normalize_text(c.name) and c.state == CapabilityState.MEASURED for c in self.capabilities.values()) else 'UNKNOWN'}.",
            f"- LONG-CONTEXT RELIABLE REASONING = {'NOT SUPPORTED / DISPUTED' if ctx_overclaim else 'UNKNOWN'}.",
            f"- NATIVE VS SYSTEM CAPABILITY = {'SEPARATION REQUIRED' if tool_native else 'UNKNOWN'}.",
            f"- PROMPT-INJECTION / TOOL-SAFETY RISK = {'SUPPORTED FOR TESTED CONFIGURATION' if pi_fail else 'NOT_OBSERVED'}.",
            "",
            "NOT ESTABLISHED:",
            "- Exact production weights behind API alias.",
            "- Universal safety failure from synthetic tests.",
            "- Benchmark contamination without stronger evidence.",
            "- Training-data memorization from output similarity alone.",
            "- Legal/license conclusions.",
            "",
            f"DUAL-AI REVIEW: {dual['verdict']}.",
            "PRIVACY/POLICY: Defensive authorized model intelligence only. No weight theft, proprietary extraction, API abuse, jailbreak optimization, poisoning, backdoor creation, or unknown checkpoint execution.",
            "NEXT ACTION: Pin exact model fingerprint, run normalized model-only/tool/RAG evals, maintain synthetic safety regression, harden tool gating, retrieve provenance, and route legal questions to LEGALINT.",
        ]
        return "\n".join(lines)

    def prepare(self) -> None:
        self.resolve_identity()
        self.assess_provenance()
        self.assess_lineage()
        self.assess_capabilities()
        self.assess_benchmarks()
        self.assess_safety()
        self.assess_privacy()
        self.assess_supply_chain()
        self.assess_deployment()
        self.assess_drift()
        self.detect_incidents()
        self.detect_model_self_report()
        self.detect_contradictions()
        self.fact_gate_findings()
        self.build_risk_dimensions()
        self.build_hypotheses()
        self.build_knowledge_gaps()
        self.build_next_actions()
        self.build_recommendations()
        self.build_handoffs()


