PROVENANCE_RANK: Dict[ProvenanceLevel, int] = {
    ProvenanceLevel.UNKNOWN: 0,
    ProvenanceLevel.UNVERIFIED: 1,
    ProvenanceLevel.SOURCE_CLAIMED: 2,
    ProvenanceLevel.REPOSITORY_LINKED: 3,
    ProvenanceLevel.HASH_MATCHED: 4,
    ProvenanceLevel.OFFICIALLY_PUBLISHED: 5,
    ProvenanceLevel.SIGNED_AND_VERIFIED: 6,
}

PROHIBITED_PATTERNS: List[Tuple[str, re.Pattern[str]]] = [
    (
        "MODEL_THEFT_OR_EXTRACTION",
        re.compile(
            r"\b(steal|extract|reconstruct|exfiltrate)\s+"
            r"(model\s+)?(weights|proprietary\s+model|training\s+data|private\s+user\s+data)\b",
            re.IGNORECASE,
        ),
    ),
    (
        "API_ABUSE_OR_AUTH_BYPASS",
        re.compile(
            r"\b(bypass|evade)\s+(model[- ]provider authentication|api authentication|rate limit|billing|quota)\b|"
            r"\buse stolen (api key|token|credential)\b",
            re.IGNORECASE,
        ),
    ),
    (
        "MALICIOUS_JAILBREAK_OR_SAFETY_BYPASS",
        re.compile(
            r"\b(generate|optimize|create|improve)\s+(malicious\s+)?(jailbreak|safety bypass|policy bypass)\b|"
            r"\bdisable safety controls\b",
            re.IGNORECASE,
        ),
    ),
    (
        "POISONING_OR_BACKDOOR",
        re.compile(
            r"\b(poison)\s+(training data|dataset|rag corpus|retrieval corpus)\b|"
            r"\b(insert|create|design)\s+(model backdoor|stealth backdoor|trigger backdoor)\b",
            re.IGNORECASE,
        ),
    ),
    (
        "UNAUTHORIZED_MODEL_DEPLOYMENT_OR_TAMPERING",
        re.compile(
            r"\b(tamper with|replace|modify)\s+(signed model artifact|production model|model routing)\b|"
            r"\bpublish malicious model\b|\bdeploy untrusted checkpoint\b",
            re.IGNORECASE,
        ),
    ),
    (
        "UNSAFE_CHECKPOINT_EXECUTION",
        re.compile(
            r"\b(execute|run|load)\s+(unknown|untrusted|suspicious)\s+(checkpoint|model code|repository code|binary)\b",
            re.IGNORECASE,
        ),
    ),
]


# =====================================================================
# UTILITIES
# =====================================================================

def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def new_id(prefix: str, seed: str) -> str:
    h = hashlib.sha256(seed.encode("utf-8")).hexdigest()[:10]
    return f"{prefix}{h}" if prefix else h


def stable_hash(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def sha256_short(text: str) -> str:
    return stable_hash(text)[:16]


def jsonable(obj: Any) -> Any:
    if isinstance(obj, Enum):
        return obj.value
    if is_dataclass(obj) and not isinstance(obj, type):
        return {f.name: jsonable(getattr(obj, f.name)) for f in fields(obj)}
    if isinstance(obj, (list, tuple, set)):
        return [jsonable(x) for x in obj]
    if isinstance(obj, dict):
        return {str(k): jsonable(v) for k, v in obj.items()}
    return obj


def normalize_text(value: str) -> str:
    s = unicodedata.normalize("NFKC", value or "")
    s = s.lower().strip()
    s = re.sub(r"[^\w\s\-'.:/@]", " ", s)
    s = re.sub(r"\s+", " ", s)
    return s


def parse_dt(value: Optional[str]) -> Optional[datetime]:
    if not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except Exception:
        return None


def dt_or_min(value: Optional[str]) -> datetime:
    dt = parse_dt(value)
    return dt if dt else datetime.min.replace(tzinfo=timezone.utc)


def days_between(a: Optional[str], b: Optional[str]) -> Optional[int]:
    da = parse_dt(a)
    db = parse_dt(b)
    if not da or not db:
        return None
    return abs((db - da).days)


def policy_guard(text: str) -> List[Dict[str, str]]:
    violations: List[Dict[str, str]] = []
    for rule, rx in PROHIBITED_PATTERNS:
        m = rx.search(text or "")
        if m:
            violations.append({"rule": rule, "matched": m.group(0)})
    return violations


# =====================================================================
# DATACLASSES
# =====================================================================

@dataclass
class Source:
    id: str
    title: str
    url: str
    source_type: SourceType
    independence_group: str = "UNKNOWN"
    reliability: float = 0.5
    derived_from: Optional[str] = None
    published_at: Optional[str] = None
    retrieved_at: Optional[str] = None
    notes: str = ""


@dataclass
class Evidence:
    id: str
    source_id: str
    artifact_type: str
    excerpt: str
    observed_at: Optional[str] = None
    content_hash: str = ""
    parsed_fields: Dict[str, Any] = field(default_factory=dict)
    limitations: List[str] = field(default_factory=list)


@dataclass
class ModelFamily:
    id: str
    name: str
    provider: str
    publisher: str
    description: str = ""
    source_ids: List[str] = field(default_factory=list)
    evidence_ids: List[str] = field(default_factory=list)
    confidence: float = 0.0
    limitations: List[str] = field(default_factory=list)


@dataclass
class ModelVersion:
    id: str
    family_id: str
    canonical_name: str
    version: str
    revision: Optional[str] = None
    release_date: Optional[str] = None
    artifact_type: ArtifactType = ArtifactType.UNKNOWN
    access_type: AccessType = AccessType.UNKNOWN
    base_model: Optional[str] = None
    parent_models: List[str] = field(default_factory=list)
    fine_tune_type: Optional[str] = None
    adapters: List[str] = field(default_factory=list)
    quantization: Optional[str] = None
    architecture_claim: Optional[str] = None
    parameter_count_claim: Optional[str] = None
    active_parameter_count_claim: Optional[str] = None
    context_window_claim: Optional[int] = None
    output_limit_claim: Optional[int] = None
    modalities: List[Modality] = field(default_factory=list)
    license: Optional[str] = None
    repository: Optional[str] = None
    artifact_hashes: Dict[str, str] = field(default_factory=dict)
    deployment_types: List[DeploymentMode] = field(default_factory=list)
    tokenizer_id: Optional[str] = None
    provenance_state: ProvenanceLevel = ProvenanceLevel.UNKNOWN
    lineage_state: LineageState = LineageState.UNKNOWN
    source_ids: List[str] = field(default_factory=list)
    evidence_ids: List[str] = field(default_factory=list)
    confidence: float = 0.0
    limitations: List[str] = field(default_factory=list)


@dataclass
class Artifact:
    id: str
    model_version_id: str
    artifact_type: ArtifactType = ArtifactType.UNKNOWN
    uri: str = ""
    digest: Optional[str] = None
    signature_state: str = "UNKNOWN"
    format: Optional[str] = None
    availability: AccessType = AccessType.UNKNOWN
    source_ids: List[str] = field(default_factory=list)
    evidence_ids: List[str] = field(default_factory=list)
    limitations: List[str] = field(default_factory=list)


