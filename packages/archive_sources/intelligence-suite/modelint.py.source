@dataclass
class NextAction:
    id: str
    description: str
    priority: int = 1
    privacy_impact: str = "LOW_IF_AUTHORIZED"
    expected_gain: float = 0.0
    specialist: Optional[str] = None
    requires_human_approval: bool = False


@dataclass
class Recommendation:
    id: str
    category: str
    action: str
    target: str
    rationale: str
    evidence_ids: List[str] = field(default_factory=list)
    finding_ids: List[str] = field(default_factory=list)
    approval: str = "HUMAN_APPROVAL_REQUIRED"
    business_impact: str = "REQUIRES_ENGINEERING_REVIEW"
    reversibility: str = "REQUIRES_VALIDATION"
    limitations: List[str] = field(default_factory=list)


@dataclass
class Case:
    case_id: str
    task_id: str
    objective: str
    questions: List[str] = field(default_factory=list)
    scope: List[str] = field(default_factory=lambda: ["authorized_defensive_model_intelligence", "evidence_first", "case_scoped"])
    authorization: str = "demo_authorized_model_intelligence"
    model_names: List[str] = field(default_factory=list)
    model_ids: List[str] = field(default_factory=list)
    providers: List[str] = field(default_factory=list)
    versions: List[str] = field(default_factory=list)
    artifacts: List[str] = field(default_factory=list)
    repositories: List[str] = field(default_factory=list)
    time_range: Optional[str] = None
    as_of: str = DEFAULT_AS_OF
    sample: bool = False
    budget: Optional[str] = None
    deadline: Optional[str] = None


# =====================================================================
# MODELINT ENGINE
# =====================================================================

class ModelInt:
    def __init__(self, case: Case) -> None:
        self.case = case
        self.as_of = case.as_of or DEFAULT_AS_OF

        self.sources: Dict[str, Source] = {}
        self.evidence: Dict[str, Evidence] = {}
        self.model_families: Dict[str, ModelFamily] = {}
        self.model_versions: Dict[str, ModelVersion] = {}
        self.artifacts: Dict[str, Artifact] = {}
        self.tokenizers: Dict[str, Tokenizer] = {}
        self.capabilities: Dict[str, Capability] = {}
        self.benchmarks: Dict[str, Benchmark] = {}
        self.eval_results: Dict[str, EvalResult] = {}
        self.safety_tests: Dict[str, SafetyTest] = {}
        self.privacy_risks: Dict[str, PrivacyRisk] = {}
        self.supply_nodes: Dict[str, SupplyNode] = {}
        self.supply_edges: Dict[str, SupplyEdge] = {}
        self.deployments: Dict[str, Deployment] = {}
        self.drift_observations: Dict[str, DriftObservation] = {}
        self.incidents: Dict[str, Incident] = {}
        self.findings: Dict[str, Finding] = {}
        self.hypotheses: List[Hypothesis] = []
        self.contradictions: List[Contradiction] = []
        self.gaps: List[KnowledgeGap] = []
        self.actions: List[NextAction] = []
        self.recommendations: List[Recommendation] = []
        self.handoffs: List[Dict[str, str]] = []
        self.risk_dimensions: Dict[str, str] = {}
        self.validation_errors: List[str] = []

    # -----------------------------------------------------------------
    # Adders
    # -----------------------------------------------------------------

    def add_source(self, source: Source) -> Source:
        self.sources[source.id] = source
        return source

    def add_evidence(self, evidence: Evidence) -> Evidence:
        if not evidence.content_hash:
            evidence.content_hash = stable_hash("|".join([
                evidence.source_id,
                evidence.artifact_type,
                evidence.excerpt,
            ]))
        self.evidence[evidence.id] = evidence
        return evidence

    def add_model_family(self, family: ModelFamily) -> ModelFamily:
        self.model_families[family.id] = family
        return family

    def add_model_version(self, mv: ModelVersion) -> ModelVersion:
        self.model_versions[mv.id] = mv
        return mv

    def add_artifact(self, art: Artifact) -> Artifact:
        self.artifacts[art.id] = art
        return art

    def add_tokenizer(self, tok: Tokenizer) -> Tokenizer:
        self.tokenizers[tok.id] = tok
        return tok

    def add_capability(self, cap: Capability) -> Capability:
        self.capabilities[cap.id] = cap
        return cap

    def add_benchmark(self, bm: Benchmark) -> Benchmark:
        self.benchmarks[bm.id] = bm
        return bm

    def add_eval_result(self, er: EvalResult) -> EvalResult:
        self.eval_results[er.id] = er
        return er

    def add_safety_test(self, st: SafetyTest) -> SafetyTest:
        self.safety_tests[st.id] = st
        return st

    def add_privacy_risk(self, pr: PrivacyRisk) -> PrivacyRisk:
        self.privacy_risks[pr.id] = pr
        return pr

    def add_supply_node(self, node: SupplyNode) -> SupplyNode:
        self.supply_nodes[node.id] = node
        return node

    def add_supply_edge(self, edge: SupplyEdge) -> SupplyEdge:
        self.supply_edges[edge.id] = edge
        return edge

    def add_deployment(self, dep: Deployment) -> Deployment:
        self.deployments[dep.id] = dep
        return dep

    def add_drift_observation(self, drift: DriftObservation) -> DriftObservation:
        self.drift_observations[drift.id] = drift
        return drift

    def add_incident(self, inc: Incident) -> Incident:
        self.incidents[inc.id] = inc
        return inc

    def add_finding(self, finding: Finding) -> Finding:
        if finding.id in self.findings:
            return self.findings[finding.id]
        self.findings[finding.id] = finding
        return finding

    def add_contradiction(self, contradiction: Contradiction) -> Contradiction:
        if any(c.description == contradiction.description for c in self.contradictions):
            return self.contradictions[0]
        self.contradictions.append(contradiction)
        return contradiction

    # -----------------------------------------------------------------
    # Source lineage / independence
    # -----------------------------------------------------------------

    def get_source_family(self, source_id: str) -> Optional[str]:
        src = self.sources.get(source_id)
        if not src:
            return None
        seen: Set[str] = set()
        cur = src
        while (
            cur
            and cur.derived_from
            and cur.derived_from in self.sources
            and cur.id not in seen
        ):
            seen.add(cur.id)
            cur = self.sources[cur.derived_from]
        if cur and cur.independence_group and cur.independence_group != "UNKNOWN":
            return cur.independence_group
        return cur.id if cur else source_id

    def source_families(self, source_ids: List[str]) -> Set[str]:
        families: Set[str] = set()
        for sid in source_ids:
            fam = self.get_source_family(sid)
            families.add(fam or sid)
        return families

    def independence_state(self, source_ids: List[str]) -> str:
        if not source_ids:
            return "UNKNOWN"
        families = self.source_families(source_ids)
        if len(source_ids) == 1:
            return "SINGLE_SOURCE"
        if len(families) == 1:
            return "DEPENDENT"
        if len(families) == len(source_ids):
            return "INDEPENDENT"
        return "PARTIALLY_DEPENDENT"

    # -----------------------------------------------------------------
    # Resolution / assessment
    # -----------------------------------------------------------------

    def resolve_identity(self) -> None:
        for mv in self.model_versions.values():
            missing: List[str] = []
            if not mv.revision:
                missing.append("revision")
            if not mv.artifact_hashes:
                missing.append("artifact hash")
            if not mv.release_date:
                missing.append("release date")

            if missing:
                self.add_finding(Finding(
                    id=new_id("FIND-ID-", mv.id),
                    finding_type=FindingType.MODEL_IDENTITY_PARTIALLY_RESOLVED,
                    subject_id=mv.id,
                    statement=(
                        f"Model version {mv.id} is partially resolved; missing exact identity evidence: {', '.join(missing)}."
                    ),
                    verification_state=VerificationState.PARTIALLY_SUPPORTED,
                    risk_dimension=RiskDimension.IDENTITY_RISK.value,
                    source_ids=mv.source_ids,
                    evidence_ids=mv.evidence_ids,
                    limitations=[
                        "Model name is not model version.",
                        "Provider API alias may not expose exact underlying weights.",
                        "Do not infer exact weights from product name alone.",
                    ],
                ))
            else:
                self.add_finding(Finding(
                    id=new_id("FIND-IDOK-", mv.id),
                    finding_type=FindingType.MODEL_IDENTITY_RESOLVED,
                    subject_id=mv.id,
                    statement=f"Model version {mv.id} has revision, artifact hash, and release date evidence.",
                    verification_state=VerificationState.SUPPORTED,
                    risk_dimension=RiskDimension.IDENTITY_RISK.value,
                    source_ids=mv.source_ids,
                    evidence_ids=mv.evidence_ids,
                    limitations=["Artifact hash supports byte identity relative to reference, not runtime behavior or safety."],
                ))

    def assess_provenance(self) -> None:
        for art in self.artifacts.values():
            mv = self.model_versions.get(art.model_version_id)
            if not mv:
                continue

            if art.signature_state == "VERIFIED" and art.digest:
                state = ProvenanceLevel.SIGNED_AND_VERIFIED
            elif art.digest:
                state = ProvenanceLevel.HASH_MATCHED
            elif mv.repository:
                state = ProvenanceLevel.REPOSITORY_LINKED
            else:
                state = ProvenanceLevel.SOURCE_CLAIMED

            if PROVENANCE_RANK.get(state, 0) > PROVENANCE_RANK.get(mv.provenance_state, 0):
                mv.provenance_state = state

            if state in {ProvenanceLevel.SOURCE_CLAIMED, ProvenanceLevel.UNVERIFIED, ProvenanceLevel.UNKNOWN}:
                self.add_finding(Finding(
                    id=new_id("FIND-PROV-", art.id),
                    finding_type=FindingType.PROVENANCE_PARTIAL,
                    subject_id=mv.id,
                    statement=f"Artifact {art.id} provenance state is {state.value}.",
                    verification_state=VerificationState.OBSERVED,
                    risk_dimension=RiskDimension.PROVENANCE_RISK.value,
                    source_ids=art.source_ids,
                    evidence_ids=art.evidence_ids,
                    limitations=[
                        "Hash proves artifact identity/integrity relative to reference, not publisher legitimacy or benignness.",
                        "Signed does not mean safe.",
                        "Unsigned does not mean malicious.",
                    ],
                ))
            elif state in {ProvenanceLevel.HASH_MATCHED, ProvenanceLevel.REPOSITORY_LINKED, ProvenanceLevel.OFFICIALLY_PUBLISHED}:
                self.add_finding(Finding(
                    id=new_id("FIND-PROVPART-", art.id),
                    finding_type=FindingType.PROVENANCE_PARTIAL,
                    subject_id=mv.id,
                    statement=f"Artifact {art.id} has partial provenance: {state.value}.",
                    verification_state=VerificationState.PARTIALLY_SUPPORTED,
                    risk_dimension=RiskDimension.PROVENANCE_RISK.value,
                    source_ids=art.source_ids,
                    evidence_ids=art.evidence_ids,
                    limitations=["Partial provenance is not compromise evidence."],
                ))
            else:
                self.add_finding(Finding(
                    id=new_id("FIND-PROVSTRONG-", art.id),
                    finding_type=FindingType.PROVENANCE_STRONG,
                    subject_id=mv.id,
                    statement=f"Artifact {art.id} has strong provenance: {state.value}.",
                    verification_state=VerificationState.SUPPORTED,
                    risk_dimension=RiskDimension.PROVENANCE_RISK.value,
                    source_ids=art.source_ids,
                    evidence_ids=art.evidence_ids,
                    limitations=["Strong provenance supports integrity/authorship context, not absence of vulnerabilities or unsafe behavior."],
                ))

    def assess_lineage(self) -> None:
        for mv in self.model_versions.values():
            if not mv.base_model and not mv.parent_models:
                continue

            official = any(
                self.sources[sid].source_type in {
                    SourceType.OFFICIAL_MODEL_CARD,
                    SourceType.TECHNICAL_REPORT,
                    SourceType.PROVIDER_DOCS,
                    SourceType.MODEL_REGISTRY,
                }
                for sid in mv.source_ids
                if sid in self.sources
            )

            if official:
                mv.lineage_state = LineageState.SUPPORTED
                ftype = FindingType.LINEAGE_SUPPORTED
                vstate = VerificationState.SUPPORTED
            else:
                mv.lineage_state = LineageState.POSSIBLE
                ftype = FindingType.LINEAGE_CLAIMED
                vstate = VerificationState.CANDIDATE

            self.add_finding(Finding(
                id=new_id("FIND-LIN-", mv.id),
                finding_type=ftype,
                subject_id=mv.id,
                statement=(
                    f"Model {mv.id} lineage: base_model={mv.base_model}, parents={mv.parent_models}, "
                    f"fine_tune_type={mv.fine_tune_type}, state={mv.lineage_state.value}."
                ),
                verification_state=vstate,
                risk_dimension=RiskDimension.LINEAGE_RISK.value,
                source_ids=mv.source_ids,
                evidence_ids=mv.evidence_ids,
                limitations=[
                    "Base model claim is not automatically verified lineage.",
                    "Fine-tune does not equal adapter.",
                    "Distillation does not imply weight lineage.",
                ],
            ))

    def assess_capabilities(self) -> None:
        for cap in self.capabilities.values():
            if cap.conditions.get("tool_use"):
                cap.kind = CapabilityKind.TOOL
            elif cap.conditions.get("rag_use"):
                cap.kind = CapabilityKind.RAG
            elif cap.conditions.get("agent_loop"):
                cap.kind = CapabilityKind.AGENT
            elif cap.kind == CapabilityKind.UNKNOWN:
                cap.kind = CapabilityKind.NATIVE

            if cap.state == CapabilityState.CLAIMED:
                self.add_finding(Finding(
                    id=new_id("FIND-CAPCLAIM-", cap.id),
                    finding_type=FindingType.MODEL_IDENTITY_PARTIALLY_RESOLVED,
                    subject_id=cap.id,
                    statement=f"Capability {cap.name} is provider/system claimed but not independently measured in this corpus.",
                    verification_state=VerificationState.CANDIDATE,
                    risk_dimension=RiskDimension.CAPABILITY_RISK.value,
                    source_ids=cap.source_ids,
                    evidence_ids=cap.evidence_ids,
                    limitations=[
                        "Provider claim is not measured capability.",
                        "System-derived capability must not be attributed solely to base model.",
                    ],
                ))
            elif cap.state in {CapabilityState.MEASURED, CapabilityState.SUPPORTED}:
                self.add_finding(Finding(
                    id=new_id("FIND-CAPMEAS-", cap.id),
                    finding_type=FindingType.EFFECTIVE_CONTEXT_MEASURED if "context" in normalize_text(cap.name) else FindingType.BENCHMARK_INDEPENDENT_REPRODUCED,
                    subject_id=cap.id,
                    statement=f"Capability {cap.name} measured with kind={cap.kind.value}, score={cap.score}, conditions={cap.conditions}.",
                    verification_state=VerificationState.SUPPORTED if cap.state == CapabilityState.SUPPORTED else VerificationState.OBSERVED,
                    risk_dimension=RiskDimension.CAPABILITY_RISK.value,
                    source_ids=cap.source_ids,
                    evidence_ids=cap.evidence_ids,
                    limitations=[
                        "Benchmark score is not general intelligence.",
                        "Tool/RAG-assisted score is not native model capability.",
                    ],
                ))

    def assess_benchmarks(self) -> None:
        for er in self.eval_results.values():
            bm = self.benchmarks.get(er.benchmark_id)
            if not bm:
                continue

            if er.reported_by == BenchmarkReportedBy.PROVIDER_REPORTED:
                self.add_finding(Finding(
                    id=new_id("FIND-BMPROV-", er.id),
                    finding_type=FindingType.BENCHMARK_PROVIDER_REPORTED,
                    subject_id=er.id,
                    statement=f"Benchmark result {er.id} for {bm.name} {bm.version} is provider-reported.",
                    verification_state=VerificationState.OBSERVED,
                    risk_dimension=RiskDimension.EVIDENCE_CONFIDENCE.value,
                    source_ids=er.source_ids,
                    evidence_ids=er.evidence_ids,
                    limitations=[
                        "Provider-reported benchmark is not independent verification.",
                        "Multiple leaderboards ingesting same submission are not independent evidence.",
                    ],
                ))

            if er.reported_by == BenchmarkReportedBy.INDEPENDENT_REPRODUCED:
                self.add_finding(Finding(
                    id=new_id("FIND-BMINDEP-", er.id),
                    finding_type=FindingType.BENCHMARK_INDEPENDENT_REPRODUCED,
                    subject_id=er.id,
                    statement=f"Benchmark result {er.id} for {bm.name} {bm.version} has independent reproduction evidence.",
                    verification_state=VerificationState.SUPPORTED,
                    risk_dimension=RiskDimension.EVIDENCE_CONFIDENCE.value,
                    source_ids=er.source_ids,
                    evidence_ids=er.evidence_ids,
                    limitations=["Independent reproduction still depends on harness, prompt, sampling, and dataset version."],
                ))

            if bm.tool_use or er.conditions.get("tool_use"):
                self.add_finding(Finding(
                    id=new_id("FIND-BMTOOL-", er.id),
                    finding_type=FindingType.TOOL_ASSISTED_SCORE_NOT_NATIVE,
                    subject_id=er.id,
                    statement=f"Benchmark result {er.id} used tool assistance; score must not be attributed solely to native model capability.",
                    verification_state=VerificationState.SUPPORTED,
                    risk_dimension=RiskDimension.CAPABILITY_RISK.value,
                    source_ids=er.source_ids,
                    evidence_ids=er.evidence_ids,
                    limitations=["Tool availability does not prove reliable tool use.", "Tool-assisted benchmark is not model-only benchmark."],
                ))

            if bm.rag_use or er.conditions.get("rag_use"):
                self.add_finding(Finding(
                    id=new_id("FIND-BMRAG-", er.id),
                    finding_type=FindingType.RAG_ASSISTED_SCORE_NOT_NATIVE,
                    subject_id=er.id,
                    statement=f"Benchmark result {er.id} used RAG/retrieval assistance; factual advantage may be system-derived.",
                    verification_state=VerificationState.SUPPORTED,
                    risk_dimension=RiskDimension.CAPABILITY_RISK.value,
                    source_ids=er.source_ids,
                    evidence_ids=er.evidence_ids,
                    limitations=["RAG performance is not model knowledge.", "Retrieval quality, corpus freshness, and citation behavior are system factors."],
                ))

            if er.contamination_state in {ContaminationState.POSSIBLE, ContaminationState.SUPPORTED, ContaminationState.CONFIRMED}:
                self.add_finding(Finding(
                    id=new_id("FIND-BMCONTAM-", er.id),
                    finding_type=FindingType.BENCHMARK_CONTAMINATION_POSSIBLE,
                    subject_id=er.id,
                    statement=f"Benchmark result {er.id} has contamination state {er.contamination_state.value}.",
                    verification_state=VerificationState.CANDIDATE,
                    risk_dimension=RiskDimension.CAPABILITY_RISK.value,
                    source_ids=er.source_ids,
                    evidence_ids=er.evidence_ids,
                    limitations=[
                        "Contamination is not proven without training-data or memorization evidence.",
                        "Saturated benchmark may have low diagnostic value.",
                    ],
                ))

    def assess_safety(self) -> None:
        mapping = {
            SafetyTestType.PROMPT_INJECTION: FindingType.PROMPT_INJECTION_FAILURE_CANDIDATE,
            SafetyTestType.INDIRECT_PROMPT_INJECTION: FindingType.INDIRECT_PROMPT_INJECTION_FAILURE_CANDIDATE,
            SafetyTestType.JAILBREAK_RESILIENCE: FindingType.JAILBREAK_RESILIENCE_PARTIAL,
            SafetyTestType.TOOL_SAFETY: FindingType.TOOL_SAFETY_FAILURE_CANDIDATE,
            SafetyTestType.EXCESSIVE_AGENCY: FindingType.EXCESSIVE_AGENCY_CANDIDATE,
            SafetyTestType.OVER_REFUSAL: FindingType.OVER_REFUSAL_OBSERVED,
            SafetyTestType.UNDER_REFUSAL: FindingType.UNDER_REFUSAL_OBSERVED,
            SafetyTestType.ABSTENTION: FindingType.ABSTENTION_OBSERVED,
            SafetyTestType.CALIBRATION: FindingType.CALIBRATION_ISSUE,
            SafetyTestType.HALLUCINATION: FindingType.HALLUCINATION_OBSERVED,
        }

        for st in self.safety_tests.values():
            if st.result in {SafetyResult.FAIL, SafetyResult.PARTIAL_FAIL}:
                ftype = mapping.get(st.test_type, FindingType.PROMPT_INJECTION_FAILURE_CANDIDATE)
                self.add_finding(Finding(
                    id=new_id("FIND-SAFETY-", st.id),
                    finding_type=ftype,
                    subject_id=st.id,
                    statement=(
                        f"Safety test {st.id} ({st.test_type.value}, {st.scenario_category}) result={st.result.value}; "
                        f"failed={st.failed_cases}/{st.total_cases}; synthetic_only={st.synthetic_only}."
                    ),
                    verification_state=VerificationState.CANDIDATE,
                    risk_dimension=RiskDimension.SAFETY_RISK.value,
                    source_ids=st.source_ids,
                    evidence_ids=st.evidence_ids,
                    limitations=[
                        "Defensive authorized synthetic evaluation only.",
                        "No reusable harmful bypass strings are published.",
                        "One failure is not universal safety failure.",
                        "Results are environment/version-specific.",
                    ],
                ))
            elif st.result == SafetyResult.PASS:
                self.add_finding(Finding(
                    id=new_id("FIND-SAFEPASS-", st.id),
                    finding_type=FindingType.ABSTENTION_OBSERVED if st.test_type == SafetyTestType.ABSTENTION else FindingType.JAILBREAK_RESILIENCE_PARTIAL,
                    subject_id=st.id,
                    statement=f"Safety test {st.id} passed in authorized synthetic environment.",
                    verification_state=VerificationState.OBSERVED,
                    risk_dimension=RiskDimension.SAFETY_RISK.value,
                    source_ids=st.source_ids,
                    evidence_ids=st.evidence_ids,
                    limitations=["One passed test is not robust safety proof."],
                ))

    def assess_privacy(self) -> None:
        for pr in self.privacy_risks.values():
            if pr.risk_type == PrivacyRiskType.MEMORIZATION:
                ftype = FindingType.MEMORIZATION_RISK_CANDIDATE
            elif pr.risk_type == PrivacyRiskType.MODEL_EXTRACTION:
                ftype = FindingType.MODEL_EXTRACTION_RISK_CANDIDATE
            elif pr.risk_type == PrivacyRiskType.TRAINING_DATA_LEAKAGE:
                ftype = FindingType.TRAINING_DATA_CLAIM_PARTIAL
            else:
                ftype = FindingType.MEMORIZATION_RISK_CANDIDATE

            self.add_finding(Finding(
                id=new_id("FIND-PRIV-", pr.id),
                finding_type=ftype,
                subject_id=pr.id,
                statement=f"Privacy risk {pr.id}: {pr.risk_type.value}; state={pr.state.value}; {pr.description}",
                verification_state=pr.state,
                risk_dimension=RiskDimension.PRIVACY_RISK.value,
                source_ids=pr.source_ids,
                evidence_ids=pr.evidence_ids,
                limitations=[
                    "Synthetic authorized testing only.",
                    "No private real-user data recovery attempted.",
                    "Training-data inclusion does not prove memorization.",
                    "Output similarity does not prove training-data membership.",
                ],
            ))

    def assess_supply_chain(self) -> None:
        for node in self.supply_nodes.values():
            if node.node_type == SupplyNodeType.ATTESTATION:
                self.add_finding(Finding(
                    id=new_id("FIND-ATTNODE-", node.id),
                    finding_type=FindingType.SUPPLY_CHAIN_ATTESTATION_PARTIAL,
                    subject_id=node.id,
                    statement=f"Supply-chain attestation node {node.id} observed: {node.name} {node.version or ''}.",
                    verification_state=VerificationState.OBSERVED,
                    risk_dimension=RiskDimension.SUPPLY_CHAIN_RISK.value,
                    source_ids=node.source_ids,
                    evidence_ids=node.evidence_ids,
                    limitations=[
                        "Attestation quality depends on issuer trust and build environment.",
                        "Attestation is not absolute truth.",
                    ],
                ))
            else:
                self.add_finding(Finding(
                    id=new_id("FIND-SUPNODE-", node.id),
                    finding_type=FindingType.RUNTIME_DEPENDENCY_OBSERVED,
                    subject_id=node.id,
                    statement=f"Model supply-chain dependency observed: {node.node_type.value} {node.name} {node.version or ''}.",
                    verification_state=VerificationState.OBSERVED,
                    risk_dimension=RiskDimension.SUPPLY_CHAIN_RISK.value,
                    source_ids=node.source_ids,
                    evidence_ids=node.evidence_ids,
                    limitations=[
                        "Runtime dependency observation is not CVE applicability.",
                        "Software CVE questions hand off to VULNINT.",
                    ],
                ))

    def assess_deployment(self) -> None:
        alias_groups: Dict[str, List[Deployment]] = defaultdict(list)
        for dep in self.deployments.values():
            if dep.alias:
                alias_groups[dep.alias].append(dep)

        for alias, deps in alias_groups.items():
            resolved = sorted({d.resolved_version for d in deps if d.resolved_version})
            if len(resolved) > 1:
                latest = max(deps, key=lambda d: dt_or_min(d.resolution_time))
                self.add_finding(Finding(
                    id=new_id("FIND-ALIAS-", alias),
                    finding_type=FindingType.VERSION_ALIAS_DRIFT_CANDIDATE,
                    subject_id=latest.model_version_id,
                    statement=(
                        f"Deployment alias '{alias}' resolved to multiple model versions over time: {resolved}. "
                        "Silent update or routing change is possible."
                    ),
                    verification_state=VerificationState.CANDIDATE,
                    risk_dimension=RiskDimension.DRIFT_RISK.value,
                    source_ids=sorted({sid for d in deps for sid in d.source_ids}),
                    evidence_ids=sorted({eid for d in deps for eid in d.evidence_ids}),
                    limitations=[
                        "Behavioral or routing drift is not proof of weight change.",
                        "Provider may change post-training, routing, system prompt, tools, or filters.",
                    ],
                ))
                self.add_finding(Finding(
                    id=new_id("FIND-SILENT-", alias),
                    finding_type=FindingType.SILENT_UPDATE_SUSPECTED,
                    subject_id=latest.model_version_id,
                    statement=f"Alias '{alias}' shows version movement; exact production weight identity remains unresolved.",
                    verification_state=VerificationState.INCONCLUSIVE,
                    risk_dimension=RiskDimension.DEPLOYMENT_RISK.value,
                    source_ids=sorted({sid for d in deps for sid in d.source_ids}),
                    evidence_ids=sorted({eid for d in deps for eid in d.evidence_ids}),
                    limitations=[
                        "Do not claim weight change solely from output variation.",
                        "Use release notes, fingerprints, and authorized regression evals.",
                    ],
                ))

        for dep in self.deployments.values():
            if dep.tools_enabled or dep.rag_enabled:
                self.add_finding(Finding(
                    id=new_id("FIND-DEPSYS-", dep.id),
                    finding_type=FindingType.TOOL_ASSISTED_SCORE_NOT_NATIVE,
                    subject_id=dep.model_version_id,
                    statement=(
                        f"Deployment {dep.id} enables tools={dep.tools_enabled}, rag={dep.rag_enabled}; "
                        "product behavior is system-level and not attributable solely to base model."
                    ),
                    verification_state=VerificationState.OBSERVED,
                    risk_dimension=RiskDimension.CAPABILITY_RISK.value,
                    source_ids=dep.source_ids,
                    evidence_ids=dep.evidence_ids,
                    limitations=[
                        "Model ≠ product.",
                        "System prompt, tools, RAG, memory, filters, and workflow logic contribute behavior.",
                    ],
                ))

    def assess_drift(self) -> None:
        for drift in self.drift_observations.values():
            ftype = FindingType.SAFETY_DRIFT_OBSERVED if "safety" in normalize_text(drift.metric) or "injection" in normalize_text(drift.metric) else FindingType.CAPABILITY_DRIFT_OBSERVED
            self.add_finding(Finding(
                id=new_id("FIND-DRIFT-", drift.id),
                finding_type=ftype,
                subject_id=drift.model_version_id,
                statement=(
                    f"Drift observed for metric '{drift.metric}': baseline={drift.baseline_value} at {drift.baseline_time}, "
                    f"current={drift.current_value} at {drift.current_time}. Possible causes: {drift.possible_causes}."
                ),
                verification_state=VerificationState.OBSERVED,
                risk_dimension=RiskDimension.DRIFT_RISK.value,
                source_ids=drift.source_ids,
                evidence_ids=drift.evidence_ids,
                limitations=[
                    "Drift is not weight-change proof.",
                    "Compare matched evals over time.",
                    "System prompt, routing, tools, retrieval, runtime, and provider changes may explain drift.",
                ],
            ))

    def detect_incidents(self) -> None:
        for inc in self.incidents.values():
            self.add_finding(Finding(
                id=new_id("FIND-INC-", inc.id),
                finding_type=FindingType.DEPLOYMENT_ROUTING_INCIDENT,
                subject_id=inc.model_version_id,
                statement=f"Incident {inc.id}: {inc.incident_type}; {inc.summary}",
                verification_state=VerificationState.OBSERVED,
                risk_dimension=RiskDimension.AVAILABILITY_RISK.value,
                source_ids=inc.source_ids,
                evidence_ids=inc.evidence_ids,
                limitations=[
                    "Incident report is not universal model defect.",
                    "Scope precisely; do not assume all projects/models affected.",
                ],
            ))

    def detect_model_self_report(self) -> None:
        for ev in self.evidence.values():
            if ev.artifact_type == "model_self_report":
                self.add_finding(Finding(
                    id=new_id("FIND-SELFREP-", ev.id),
                    finding_type=FindingType.MODEL_SELF_REPORT_NOT_AUTHORITATIVE,
                    subject_id=ev.id,
                    statement="Model/self-system identification in prompt trace is not authoritative model identity evidence.",
                    verification_state=VerificationState.SUPPORTED,
                    risk_dimension=RiskDimension.IDENTITY_RISK.value,
                    source_ids=[ev.source_id],
                    evidence_ids=[ev.id],
                    limitations=[
                        "Use runtime/provider metadata, artifact hashes, and release notes for identity.",
                        "Model saying 'I am X' is weak evidence.",
                    ],
                ))

    def detect_contradictions(self) -> None:
        existing = {c.description for c in self.contradictions}

        # Context claim vs effective retrieval.
        for mv in self.model_versions.values():
            claim = mv.context_window_claim
            if not claim:
                continue
            for er in self.eval_results.values():
                if er.model_version_id != mv.id:
                    continue
                eff = er.conditions.get("effective_retrieval_tokens")
                if eff and int(eff) < int(claim) * 0.5:
                    desc = (
                        f"Model {mv.id} claims context window {claim}, but evaluation {er.id} measures effective retrieval "
                        f"declining after {eff} tokens. Context acceptance is not reliable long-context reasoning."
                    )
                    if desc in existing:
                        continue
                    fid = new_id("FIND-CTXCON-", mv.id + er.id)
                    self.add_finding(Finding(
                        id=fid,
                        finding_type=FindingType.CONTEXT_WINDOW_OVERCLAIM_CANDIDATE,
                        subject_id=mv.id,
                        statement=desc,
                        verification_state=VerificationState.DISPUTED,
                        risk_dimension=RiskDimension.CAPABILITY_RISK.value,
                        source_ids=sorted(set(mv.source_ids + er.source_ids)),
                        evidence_ids=sorted(set(mv.evidence_ids + er.evidence_ids)),
                        limitations=[
                            "API acceptance of long input does not prove reliable recall across full window.",
                            "Evaluate retrieval position, lost-in-middle, and long-context reasoning separately.",
                        ],
                    ))
                    self.add_contradiction(Contradiction(
                        id=new_id("CON-", desc),
                        contradiction_type="CONTEXT_CLAIM_VS_EFFECTIVE_RETRIEVAL",
                        description=desc,
                        subject_ids=[mv.id, er.id],
                        finding_ids=[fid],
                        evidence_ids=sorted(set(mv.evidence_ids + er.evidence_ids)),
                        source_ids=sorted(set(mv.source_ids + er.source_ids)),
                        severity="MEDIUM",
                        status="OPEN",
                        recommended_resolution="Use measured long-context evaluation for capability claims; preserve provider claim separately.",
                    ))
                    existing.add(desc)

        # Native marketing claim vs tool/RAG-assisted eval.
        for cap in self.capabilities.values():
            if cap.kind != CapabilityKind.NATIVE or cap.state != CapabilityState.CLAIMED:
                continue
            if not cap.conditions.get("marketing_native"):
                continue
            for er in self.eval_results.values():
                if er.model_version_id != cap.model_version_id:
                    continue
                if er.conditions.get("tool_use") or er.conditions.get("rag_use"):
                    desc = (
                        f"Capability {cap.id} is presented as native {cap.name}, but evaluation {er.id} used "
                        f"tool_use={er.conditions.get('tool_use')} rag_use={er.conditions.get('rag_use')}. "
                        "Score contribution may be system-derived."
                    )
                    if desc in existing:
                        continue
                    fid = new_id("FIND-NATIVECON-", cap.id + er.id)
                    self.add_finding(Finding(
                        id=fid,
                        finding_type=FindingType.TOOL_ASSISTED_SCORE_NOT_NATIVE,
                        subject_id=cap.id,
                        statement=desc,
                        verification_state=VerificationState.DISPUTED,
                        risk_dimension=RiskDimension.CAPABILITY_RISK.value,
                        source_ids=sorted(set(cap.source_ids + er.source_ids)),
                        evidence_ids=sorted(set(cap.evidence_ids + er.evidence_ids)),
                        limitations=["Do not attribute tool/RAG-assisted performance solely to base model."],
                    ))
                    self.add_contradiction(Contradiction(
                        id=new_id("CON-", desc),
                        contradiction_type="NATIVE_CAPABILITY_CLAIM_VS_ASSISTED_EVAL",
                        description=desc,
                        subject_ids=[cap.id, er.id],
                        finding_ids=[fid],
                        evidence_ids=sorted(set(cap.evidence_ids + er.evidence_ids)),
                        source_ids=sorted(set(cap.source_ids + er.source_ids)),
                        severity="MEDIUM",
                        status="OPEN",
                        recommended_resolution="Run normalized model-only and system-enabled evaluations separately.",
                    ))
                    existing.add(desc)

        # Model card revision vs artifact revision.
        for ev in self.evidence.values():
            if ev.artifact_type != "model_card":
                continue
            card_rev = ev.parsed_fields.get("revision")
            if not card_rev:
                continue
            for mv in self.model_versions.values():
                if ev.source_id not in mv.source_ids:
                    continue
                if mv.revision and mv.revision != card_rev:
                    desc = (
                        f"Model card evidence {ev.id} references revision {card_rev}, but model version {mv.id} "
                        f"artifact/release evidence references revision {mv.revision}."
                    )
                    if desc in existing:
                        continue
                    fid = new_id("FIND-CARDREV-", mv.id + ev.id)
                    self.add_finding(Finding(
                        id=fid,
                        finding_type=FindingType.MODEL_CARD_REVISION_MISMATCH,
                        subject_id=mv.id,
                        statement=desc,
                        verification_state=VerificationState.DISPUTED,
                        risk_dimension=RiskDimension.PROVENANCE_RISK.value,
                        source_ids=sorted(set(mv.source_ids + [ev.source_id])),
                        evidence_ids=sorted(set(mv.evidence_ids + [ev.id])),
                        limitations=["Documentation lag or different revision may explain mismatch; preserve both."],
                    ))
                    self.add_contradiction(Contradiction(
                        id=new_id("CON-", desc),
                        contradiction_type="MODEL_CARD_VS_ARTIFACT_REVISION",
                        description=desc,
                        subject_ids=[mv.id, ev.id],
                        finding_ids=[fid],
                        evidence_ids=sorted(set(mv.evidence_ids + [ev.id])),
                        source_ids=sorted(set(mv.source_ids + [ev.source_id])),
                        severity="LOW",
                        status="OPEN",
                        recommended_resolution="Resolve exact deployed revision through provider release notes and artifact fingerprint.",
                    ))
                    existing.add(desc)

    # -----------------------------------------------------------------
    # Fact gate
    # -----------------------------------------------------------------

    def fact_gate_findings(self) -> None:
        for f in self.findings.values():
            srcs = [self.sources[sid] for sid in f.source_ids if sid in self.sources]
            if not srcs:
                f.confidence = 0.0
                if f.verification_state == VerificationState.OBSERVED:
                    f.verification_state = VerificationState.INCONCLUSIVE
                f.limitations.append("No mapped source for fact gate.")
                continue

            families = self.source_families(f.source_ids)
            max_rel = max((s.reliability for s in srcs), default=0.5)
            direct = max((SOURCE_FACTOR.get(s.source_type, 0.65) for s in srcs), default=0.65)
            base = max_rel * direct

            if len(families) >= 2:
                base = min(0.99, base * 1.05)
            elif len(families) == 1 and len(f.source_ids) > 1:
                base *= 0.90
                f.limitations.append("Multiple sources share one upstream source family.")

            # Semantic guards.
            if f.finding_type == FindingType.MODEL_IDENTITY_RESOLVED:
                f.verification_state = VerificationState.SUPPORTED if base >= 0.75 else VerificationState.PARTIALLY_SUPPORTED
                f.limitations.append("Identity is pinned to version/revision/artifact evidence, not product name.")

            elif f.finding_type == FindingType.MODEL_IDENTITY_PARTIALLY_RESOLVED:
                f.verification_state = VerificationState.PARTIALLY_SUPPORTED if base >= 0.60 else VerificationState.INCONCLUSIVE
                f.limitations.append("Exact production weights may remain unknown behind API alias.")

            elif f.finding_type in {
                FindingType.VERSION_ALIAS_DRIFT_CANDIDATE,
                FindingType.SILENT_UPDATE_SUSPECTED,
            }:
                f.verification_state = VerificationState.CANDIDATE
                base = min(base, 0.70)
                f.limitations.extend([
                    "Routing/alias movement is not proof of weight change.",
                    "Provider may change system prompt, tools, filters, routing, or post-training.",
                ])

            elif f.finding_type == FindingType.PROVENANCE_PARTIAL:
                f.verification_state = VerificationState.PARTIALLY_SUPPORTED if base >= 0.65 else VerificationState.INCONCLUSIVE
                f.limitations.append("Partial provenance is not compromise evidence.")

            elif f.finding_type == FindingType.PROVENANCE_STRONG:
                f.verification_state = VerificationState.SUPPORTED if base >= 0.75 else VerificationState.PARTIALLY_SUPPORTED
                f.limitations.append("Strong provenance does not prove safety or absence of vulnerabilities.")

            elif f.finding_type == FindingType.LINEAGE_CLAIMED:
                f.verification_state = VerificationState.CANDIDATE
                base = min(base, 0.65)
                f.limitations.append("Uploader/base-model claim is not verified lineage without artifact/config evidence.")

            elif f.finding_type == FindingType.LINEAGE_SUPPORTED:
                f.verification_state = VerificationState.SUPPORTED if base >= 0.72 else VerificationState.PARTIALLY_SUPPORTED
                f.limitations.append("Supported lineage still does not imply identical behavior or safety.")

            elif f.finding_type == FindingType.CONTEXT_WINDOW_OVERCLAIM_CANDIDATE:
                f.verification_state = VerificationState.DISPUTED
                base = min(base, 0.82)
                f.limitations.append("Context acceptance ≠ effective recall.")

            elif f.finding_type == FindingType.EFFECTIVE_CONTEXT_MEASURED:
                f.verification_state = VerificationState.SUPPORTED if base >= 0.70 else VerificationState.OBSERVED
                f.limitations.append("Measured under specific harness, prompt, sampling, and dataset version.")

            elif f.finding_type == FindingType.BENCHMARK_PROVIDER_REPORTED:
                f.verification_state = VerificationState.OBSERVED
                base = min(base, 0.78)
                f.limitations.append("Provider self-report has marketing bias risk.")

            elif f.finding_type == FindingType.BENCHMARK_INDEPENDENT_REPRODUCED:
                f.verification_state = VerificationState.SUPPORTED if base >= 0.72 else VerificationState.PARTIALLY_SUPPORTED
                f.limitations.append("Independent reproduction is stronger but still harness-dependent.")

            elif f.finding_type in {
                FindingType.TOOL_ASSISTED_SCORE_NOT_NATIVE,
                FindingType.RAG_ASSISTED_SCORE_NOT_NATIVE,
            }:
                f.verification_state = VerificationState.SUPPORTED
                f.limitations.append("System-derived capability must be separated from native model capability.")

            elif f.finding_type == FindingType.BENCHMARK_CONTAMINATION_POSSIBLE:
                f.verification_state = VerificationState.CANDIDATE
                base = min(base, 0.60)
                f.limitations.append("Contamination claim requires training-data/memorization evidence, not suspicion alone.")

            elif f.finding_type in {
                FindingType.PROMPT_INJECTION_FAILURE_CANDIDATE,
                FindingType.INDIRECT_PROMPT_INJECTION_FAILURE_CANDIDATE,
                FindingType.TOOL_SAFETY_FAILURE_CANDIDATE,
                FindingType.EXCESSIVE_AGENCY_CANDIDATE,
            }:
                f.verification_state = VerificationState.CANDIDATE
                base = min(base, 0.72)
                f.limitations.extend([
                    "Authorized synthetic testing only.",
                    "No operational harmful bypass instructions published.",
                    "Failure is environment/version-specific.",
                ])

            elif f.finding_type == FindingType.JAILBREAK_RESILIENCE_PARTIAL:
                f.verification_state = VerificationState.CANDIDATE
                base = min(base, 0.68)
                f.limitations.extend([
                    "One successful bypass is not universal safety failure.",
                    "One failed bypass is not robust safety.",
                ])

            elif f.finding_type in {
                FindingType.OVER_REFUSAL_OBSERVED,
                FindingType.UNDER_REFUSAL_OBSERVED,
            }:
                f.verification_state = VerificationState.OBSERVED
                f.limitations.append("Refusal rate alone is not safety quality.")

            elif f.finding_type in {
                FindingType.MEMORIZATION_RISK_CANDIDATE,
                FindingType.MODEL_EXTRACTION_RISK_CANDIDATE,
            }:
                f.verification_state = VerificationState.CANDIDATE
                base = min(base, 0.65)
                f.limitations.append("High-level defensive risk assessment only; no extraction or private data recovery performed.")

            elif f.finding_type == FindingType.TRAINING_DATA_CLAIM_PARTIAL:
                f.verification_state = VerificationState.PARTIALLY_SUPPORTED
                f.limitations.append("Training-data disclosure claims are not verified corpus membership.")

            elif f.finding_type == FindingType.LICENSE_AMBIGUITY:
                f.verification_state = VerificationState.OBSERVED
                f.specialist_handoff = f.specialist_handoff or "LEGALINT"
                f.limitations.append("Final license/legal interpretation requires LEGALINT/counsel.")

            elif f.finding_type == FindingType.SUPPLY_CHAIN_ATTESTATION_PARTIAL:
                f.verification_state = VerificationState.OBSERVED
                f.limitations.append("Attestation trust depends on issuer, build environment, and verification chain.")

            elif f.finding_type == FindingType.RUNTIME_DEPENDENCY_OBSERVED:
                f.verification_state = VerificationState.OBSERVED
                f.specialist_handoff = f.specialist_handoff or "VULNINT / SUPPLYCHAININT"
                f.limitations.append("Dependency presence is not CVE applicability or compromise.")

            elif f.finding_type == FindingType.DEPLOYMENT_ROUTING_INCIDENT:
                f.verification_state = VerificationState.OBSERVED
                f.limitations.append("Incident is scoped evidence, not universal model defect.")

            elif f.finding_type in {
                FindingType.CAPABILITY_DRIFT_OBSERVED,
                FindingType.SAFETY_DRIFT_OBSERVED,
            }:
                f.verification_state = VerificationState.OBSERVED
                f.limitations.append("Drift may have system, routing, prompt, tool, retrieval, or runtime causes.")

            elif f.finding_type == FindingType.MODEL_SELF_REPORT_NOT_AUTHORITATIVE:
                f.verification_state = VerificationState.SUPPORTED
                f.limitations.append("Model self-identification is weak identity evidence.")

            elif f.finding_type == FindingType.MODEL_CARD_REVISION_MISMATCH:
                f.verification_state = VerificationState.DISPUTED
                f.limitations.append("Preserve documentation and artifact revisions separately.")

            else:
                if base >= 0.75:
                    f.verification_state = VerificationState.SUPPORTED
                elif base >= 0.60:
                    f.verification_state = VerificationState.PARTIALLY_SUPPORTED
                elif base >= 0.40:
                    f.verification_state = VerificationState.INCONCLUSIVE
                else:
                    f.verification_state = VerificationState.UNSUPPORTED

            f.confidence = round(max(0.0, min(0.99, base)), 3)

    def build_risk_dimensions(self) -> None:
        def max_state(types: Set[FindingType]) -> str:
            vals = [f.verification_state.value for f in self.findings.values() if f.finding_type in types]
            if VerificationState.DISPUTED.value in vals:
                return "DISPUTED"
            if VerificationState.SUPPORTED.value in vals:
                return "SUPPORTED"
            if VerificationState.PARTIALLY_SUPPORTED.value in vals:
                return "PARTIALLY_SUPPORTED"
            if VerificationState.CANDIDATE.value in vals:
                return "CANDIDATE"
            if VerificationState.OBSERVED.value in vals:
                return "OBSERVED"
            if VerificationState.INCONCLUSIVE.value in vals:
                return "INCONCLUSIVE"
            return "UNKNOWN"

        self.risk_dimensions = {
            RiskDimension.IDENTITY_RISK.value: max_state({
                FindingType.MODEL_IDENTITY_PARTIALLY_RESOLVED,
                FindingType.MODEL_SELF_REPORT_NOT_AUTHORITATIVE,
            }),
            RiskDimension.PROVENANCE_RISK.value: max_state({
                FindingType.PROVENANCE_PARTIAL,
                FindingType.MODEL_CARD_REVISION_MISMATCH,
            }),
            RiskDimension.LINEAGE_RISK.value: max_state({
                FindingType.LINEAGE_CLAIMED,
                FindingType.LINEAGE_SUPPORTED,
            }),
            RiskDimension.CAPABILITY_RISK.value: max_state({
                FindingType.CONTEXT_WINDOW_OVERCLAIM_CANDIDATE,
                FindingType.TOOL_ASSISTED_SCORE_NOT_NATIVE,
                FindingType.RAG_ASSISTED_SCORE_NOT_NATIVE,
                FindingType.BENCHMARK_CONTAMINATION_POSSIBLE,
            }),
            RiskDimension.SAFETY_RISK.value: max_state({
                FindingType.PROMPT_INJECTION_FAILURE_CANDIDATE,
                FindingType.INDIRECT_PROMPT_INJECTION_FAILURE_CANDIDATE,
                FindingType.JAILBREAK_RESILIENCE_PARTIAL,
                FindingType.TOOL_SAFETY_FAILURE_CANDIDATE,
                FindingType.EXCESSIVE_AGENCY_CANDIDATE,
                FindingType.UNDER_REFUSAL_OBSERVED,
            }),
            RiskDimension.PRIVACY_RISK.value: max_state({
                FindingType.MEMORIZATION_RISK_CANDIDATE,
                FindingType.MODEL_EXTRACTION_RISK_CANDIDATE,
                FindingType.TRAINING_DATA_CLAIM_PARTIAL,
            }),
            RiskDimension.SECURITY_RISK.value: max_state({
                FindingType.PROMPT_INJECTION_FAILURE_CANDIDATE,
                FindingType.TOOL_SAFETY_FAILURE_CANDIDATE,
            }),
            RiskDimension.SUPPLY_CHAIN_RISK.value: max_state({
                FindingType.SUPPLY_CHAIN_ATTESTATION_PARTIAL,
                FindingType.RUNTIME_DEPENDENCY_OBSERVED,
            }),
            RiskDimension.DEPLOYMENT_RISK.value: max_state({
                FindingType.VERSION_ALIAS_DRIFT_CANDIDATE,
                FindingType.SILENT_UPDATE_SUSPECTED,
                FindingType.DEPLOYMENT_ROUTING_INCIDENT,
            }),
            RiskDimension.DRIFT_RISK.value: max_state({
                FindingType.CAPABILITY_DRIFT_OBSERVED,
                FindingType.SAFETY_DRIFT_OBSERVED,
            }),
            RiskDimension.LICENSE_RISK.value: max_state({FindingType.LICENSE_AMBIGUITY}),
            RiskDimension.AVAILABILITY_RISK.value: max_state({FindingType.DEPLOYMENT_ROUTING_INCIDENT}),
            RiskDimension.EVIDENCE_CONFIDENCE.value: "MEDIUM_AUTHORIZED_SYNTHETIC_CORPUS",
        }

    def build_hypotheses(self) -> None:
        hyps: List[Hypothesis] = []

        alias_findings = [f.id for f in self.findings.values() if f.finding_type == FindingType.VERSION_ALIAS_DRIFT_CANDIDATE]
        if alias_findings:
            hyps.append(Hypothesis(
                id="H-ALIAS-STABLE",
                statement="The production alias points to a stable exact model version.",
                kind="MODEL_IDENTITY",
                contradicting_finding_ids=alias_findings,
                assumptions=["Alias resolution metadata is complete."],
                predictions=["Release notes and fingerprints would show no version movement."],
                falsification_conditions=[
                    "Alias resolved to multiple revisions.",
                    "Provider release notes indicate silent update.",
                    "Regression evals shift without config change.",
                ],
                status=HypothesisStatus.DISPUTED,
                confidence=0.30,
                limitations=["Routing drift is not weight-change proof."],
            ))

        tool_findings = [f.id for f in self.findings.values() if f.finding_type in {
            FindingType.TOOL_ASSISTED_SCORE_NOT_NATIVE,
            FindingType.RAG_ASSISTED_SCORE_NOT_NATIVE,
        }]
        if tool_findings:
            hyps.append(Hypothesis(
                id="H-BENCHMARK-NATIVE",
                statement="Benchmark performance advantage is primarily native model capability.",
                kind="CAPABILITY_ATTRIBUTION",
                contradicting_finding_ids=tool_findings,
                assumptions=["Evaluation harness conditions are accurately recorded."],
                predictions=["Model-only normalized eval would retain most advantage."],
                falsification_conditions=[
                    "Tool/RAG-enabled eval substantially outperforms model-only eval.",
                    "Retrieval corpus explains factual advantage.",
                    "System prompt/tool schema drives performance.",
                ],
                status=HypothesisStatus.DISPUTED,
                confidence=0.35,
                limitations=["Model ≠ product."],
            ))

        contamination_findings = [f.id for f in self.findings.values() if f.finding_type == FindingType.BENCHMARK_CONTAMINATION_POSSIBLE]
        if contamination_findings:
            hyps.append(Hypothesis(
                id="H-CONTAMINATION",
                statement="Benchmark score may be inflated by contamination or benchmark-specific optimization.",
                kind="EVAL_VALIDITY",
                supporting_finding_ids=contamination_findings,
                assumptions=["Public benchmark exposure may overlap training data."],
                predictions=["Held-out/private-equivalent eval would show lower score."],
                falsification_conditions=[
                    "Training data disclosure excludes benchmark.",
                    "Memorization tests negative.",
                    "Novel paraphrase eval retains score.",
                ],
                status=HypothesisStatus.UNRESOLVED,
                confidence=0.45,
                limitations=["Contamination cannot be confirmed without stronger evidence."],
            ))

        safety_findings = [f.id for f in self.findings.values() if f.finding_type in {
            FindingType.PROMPT_INJECTION_FAILURE_CANDIDATE,
            FindingType.INDIRECT_PROMPT_INJECTION_FAILURE_CANDIDATE,
            FindingType.TOOL_SAFETY_FAILURE_CANDIDATE,
        }]
        if safety_findings:
            hyps.append(Hypothesis(
                id="H-PI-SYSTEM-CAUSE",
                statement="Prompt-injection/tool-safety failures may arise from system orchestration and tool gating rather than model alone.",
                kind="SAFETY_ATTRIBUTION",
                supporting_finding_ids=safety_findings,
                assumptions=["Agent/tool logs and policy gates are part of tested system."],
                predictions=["Hardening tool permissions and data/instruction separation would reduce failures without model change."],
                falsification_conditions=[
                    "Failures persist in model-only no-tool configuration.",
                    "Model ignores instruction hierarchy even without tools.",
                    "System logs show model-generated unauthorized action.",
                ],
                status=HypothesisStatus.POSSIBLE,
                confidence=0.55,
                limitations=["Do not blame model automatically; assess model vs system failure."],
            ))

        drift_findings = [f.id for f in self.findings.values() if f.finding_type in {
            FindingType.CAPABILITY_DRIFT_OBSERVED,
            FindingType.SAFETY_DRIFT_OBSERVED,
        }]
        if drift_findings:
            hyps.append(Hypothesis(
                id="H-DRIFT-WEIGHT-CHANGE",
                statement="Observed drift indicates underlying weights changed.",
                kind="DRIFT_CAUSE",
                supporting_finding_ids=drift_findings,
                assumptions=["No other system change occurred."],
                predictions=["Artifact fingerprint or provider release note would confirm weight/post-training change."],
                falsification_conditions=[
                    "System prompt changed.",
                    "Tool/RAG configuration changed.",
                    "Routing changed.",
                    "Sampling/runtime changed.",
                    "Evaluation harness changed.",
                ],
                status=HypothesisStatus.UNRESOLVED,
                confidence=0.35,
                limitations=["Behavioral drift is not weight-change proof."],
            ))

        self.hypotheses = hyps

    def build_knowledge_gaps(self) -> None:
        existing = {g.description for g in self.gaps}

        for mv in self.model_versions.values():
            if mv.access_type in {AccessType.PUBLIC_API, AccessType.HOSTED_UI} and not mv.artifact_hashes:
                desc = f"Exact production weights/artifact hash for {mv.id} are unavailable."
                if desc not in existing:
                    self.gaps.append(KnowledgeGap(
                        id=new_id("GAP-WEIGHT-", mv.id),
                        gap_type=GapType.WEIGHTS_UNAVAILABLE,
                        description=desc,
                        about_subject_ids=[mv.id],
                        importance="HIGH",
                        recommended_source="Provider signed manifest, artifact registry fingerprint, authorized deployment metadata",
                        specialist="MODELINT / SUPPLYCHAININT",
                        expected_information_value=0.85,
                    ))
                    existing.add(desc)

            if mv.base_model and mv.lineage_state in {LineageState.POSSIBLE, LineageState.UNKNOWN}:
                desc = f"Base-model lineage for {mv.id} is claimed but not fully verified."
                if desc not in existing:
                    self.gaps.append(KnowledgeGap(
                        id=new_id("GAP-LIN-", mv.id),
                        gap_type=GapType.BASE_MODEL_UNRESOLVED,
                        description=desc,
                        about_subject_ids=[mv.id],
                        importance="MEDIUM",
                        recommended_source="Config hash, tokenizer hash, upstream artifact comparison, official technical report",
                        specialist="MODELINT / REPOINT",
                        expected_information_value=0.70,
                    ))
                    existing.add(desc)

        for er in self.eval_results.values():
            if er.reported_by == BenchmarkReportedBy.PROVIDER_REPORTED:
                desc = f"Evaluation {er.id} lacks independent reproduction under normalized harness."
                if desc not in existing:
                    self.gaps.append(KnowledgeGap(
                        id=new_id("GAP-EVAL-", er.id),
                        gap_type=GapType.BENCHMARK_UNREPRODUCED,
                        description=desc,
                        about_subject_ids=[er.id],
                        importance="MEDIUM",
                        recommended_source="Independent benchmark harness with pinned model version and sampling config",
                        specialist="MODELINT / EVALINT",
                        expected_information_value=0.75,
                    ))
                    existing.add(desc)

        for st in self.safety_tests.values():
            if st.result in {SafetyResult.FAIL, SafetyResult.PARTIAL_FAIL}:
                desc = f"Safety test {st.id} requires authorized regression and system/tool gating validation."
                if desc not in existing:
                    self.gaps.append(KnowledgeGap(
                        id=new_id("GAP-SAFETY-", st.id),
                        gap_type=GapType.SAFETY_CONTROLS_UNKNOWN,
                        description=desc,
                        about_subject_ids=[st.id],
                        importance="HIGH",
                        recommended_source="Agent trace, tool permission logs, system prompt/config, regression suite",
                        specialist="MODELINT / CYBINT / INCIDENTINT",
                        expected_information_value=0.85,
                    ))
                    existing.add(desc)

        for dep in self.deployments.values():
            if dep.alias and len({d.resolved_version for d in self.deployments.values() if d.alias == dep.alias and d.resolved_version}) > 1:
                desc = f"Alias '{dep.alias}' exact production version is unresolved over time."
                if desc not in existing:
                    self.gaps.append(KnowledgeGap(
                        id=new_id("GAP-ALIAS-", dep.alias),
                        gap_type=GapType.SILENT_UPDATE_POSSIBLE,
                        description=desc,
                        about_subject_ids=[dep.id],
                        importance="HIGH",
                        recommended_source="Provider release notes, response fingerprints, authorized regression evals",
                        specialist="MODELINT",
                        expected_information_value=0.85,
                    ))
                    existing.add(desc)

        for node in self.supply_nodes.values():
            if node.node_type == SupplyNodeType.ATTESTATION:
                desc = f"Supply-chain attestation for {node.id} is partial and requires issuer/build environment trust review."
                if desc not in existing:
                    self.gaps.append(KnowledgeGap(
                        id=new_id("GAP-ATT-", node.id),
                        gap_type=GapType.ARTIFACT_SIGNATURE_UNAVAILABLE,
                        description=desc,
                        about_subject_ids=[node.id],
                        importance="MEDIUM",
                        recommended_source="Signed manifest, SLSA-like provenance, builder identity",
                        specialist="SUPPLYCHAININT / MODELINT",
                        expected_information_value=0.75,
                    ))
                    existing.add(desc)

