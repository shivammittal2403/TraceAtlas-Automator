def sample_case() -> Case:
    return Case(
        case_id="SAMPLE-MODELINT-001",
        task_id="TASK-MODELINT-001",
        objective=(
            "Authorized defensive model intelligence review for synthetic ATLAS-7: resolve exact version/alias, "
            "assess provenance/lineage, separate native vs tool/RAG capability, evaluate long-context and safety risks, "
            "identify drift/incidents, and produce defensive recommendations without extracting weights or bypassing safety."
        ),
        questions=[
            "What exact model/version is being assessed?",
            "Is the production alias stable?",
            "What provenance and lineage evidence exists?",
            "Which capabilities are native vs system-derived?",
            "Do benchmark scores prove general capability?",
            "Is advertised context window equal to effective recall?",
            "What safety/prompt-injection/tool-risk evidence exists?",
            "What privacy/memorization/extraction risks are supported?",
            "What supply-chain/deployment drift is observed?",
            "What remains unknown?",
        ],
        scope=["authorized_defensive_model_intelligence", "evidence_first", "case_scoped", "no_weight_extraction", "no_safety_bypass"],
        authorization="demo_authorized_model_intelligence",
        model_names=["ATLAS-7"],
        model_ids=["MV-ATLAS-7-2026.09.1"],
