    def run_policy_screen(self) -> None:
        payload = self.collect_payload()
        policy = policy_screen(payload)

        result = {
            "mode": "POLICY_SCREEN_ONLY",
            "panel_version": APP_VERSION,
            "policy_screen": policy,
            "payload_preview": {
                "case_id": payload.get("case_id"),
                "task_id": payload.get("task_id"),
                "objective": payload.get("objective"),
                "target": payload.get("target"),
                "target_type": payload.get("target_type"),
                "has_parties": bool(payload.get("payers") or payload.get("payees") or payload.get("merchants") or payload.get("processors")),
                "has_transactions": bool(payload.get("transactions") or payload.get("transaction_paths")),
                "has_invoices": bool(payload.get("invoices") or payload.get("invoice_paths")),
                "has_settlements": bool(payload.get("settlement_reports") or payload.get("settlement_paths")),
                "has_adjustments": bool(payload.get("refunds") or payload.get("reversals") or payload.get("chargebacks") or payload.get("disputes")),
                "has_instruments": bool(payload.get("accounts") or payload.get("payment_instruments") or payload.get("wallets")),
            },
        }

        self.last_result = result
        self._write_output(result)
        self.notebook.select(self.output_tab)

        if policy["status"] == "POLICY_BLOCKED":
            messagebox.showwarning(
                "Policy Blocked",
                "This PAYMENTINT request is policy-blocked.\n\n"
                + "\n".join(policy["reasons"])
                + "\n\nUse only defensive/authorized alternatives.",
            )
        elif policy["status"] == "HUMAN_REVIEW_REQUIRED":
            messagebox.showwarning(
                "Human Review Required",
                "No hard policy block detected, but sensitive payment/account/settlement/refund/dispute context applies.",
            )
        else:
            messagebox.showinfo(
                "Policy Screen",
                "No obvious policy violation detected. Planning-only mode remains active.",
            )

    def analyze_local_payment(self) -> None:
        payload = self.collect_payload()
        policy = policy_screen(payload)

        if policy["status"] == "POLICY_BLOCKED":
            result = {
                "mode": "POLICY_BLOCKED",
                "panel_version": APP_VERSION,
                "policy_screen": policy,
                "evidence_inventory": [],
                "parties_preview": [],
                "transactions_preview": [],
                "events_preview": [],
                "observations": [],
                "candidate_facts": [],
            }
            self.last_result = result
            self._write_output(result)
            messagebox.showwarning("Policy Blocked", "Local PAYMENTINT evidence analysis blocked by policy screen.")
            return

        path_fields = [
            "transaction_paths",
            "bank_statement_paths",
            "processor_export_paths",
            "merchant_export_paths",
            "invoice_paths",
            "settlement_paths",
            "dispute_paths",
            "stix_misp_paths",
        ]

        all_paths: List[str] = []
        seen = set()

        for field in path_fields:
            for p in payload.get(field, []):
                sp = str(p).strip()
                if sp and sp not in seen:
                    seen.add(sp)
                    all_paths.append(sp)

        if not all_paths:
            messagebox.showwarning("No PAYMENTINT Evidence", "Add local lawful/authorized/public payment evidence files first.")
            return

        self.output.delete("1.0", "end")
        self.output.insert("1.0", "Analyzing local defensive/authorized PAYMENTINT evidence. Hashing and parsing may take time...\n")
        self.notebook.select(self.output_tab)

        files: List[Dict[str, Any]] = []
        parsed_list: List[Dict[str, Any]] = []

        for p in all_paths[:30]:
            f, parsed = analyze_payment_file(p, payload.get("case_id", ""), payload.get("task_id", ""))
            files.append(f)
            parsed_list.append(parsed)

        aggregated = finalize_parsed(aggregate_parsed(parsed_list), payload, files)

        self.analyzed_files = files
        self.parsed = aggregated

        report = self._build_local_analysis_report(
            files=files,
            parsed=aggregated,
            payload=payload,
            policy=policy,
        )

        self.last_result = report
        self._write_output(report)

        succeeded = sum(1 for f in files if str(f.get("status", "")).startswith("SUCCEEDED"))
        messagebox.showinfo(
            "Local PAYMENTINT Evidence Analysis Complete",
            f"Processed {len(files)} evidence file(s).\n"
            f"Succeeded/partial: {succeeded}\n"
            f"Parties: {len(aggregated.get('parties', []))}\n"
            f"Transactions: {len(aggregated.get('transactions', []))}\n"
            f"Events: {len(aggregated.get('events', []))}\n"
            f"Invoices: {len(aggregated.get('invoices', []))}\n"
            f"Settlements: {len(aggregated.get('settlements', []))}\n"
            f"Refunds/reversals/chargebacks: {len(aggregated.get('refunds', [])) + len(aggregated.get('reversals', [])) + len(aggregated.get('chargebacks', []))}\n"
            "Review output for limitations and next actions.",
        )

    def generate_plan(self) -> None:
        payload = self.collect_payload()
        warnings = validate_payload(payload)
        policy = policy_screen(payload)

        if policy["status"] == "POLICY_BLOCKED":
            result = {
                "mode": "POLICY_BLOCKED",
                "panel_version": APP_VERSION,
                "policy_screen": policy,
                "warnings": warnings,
                "payload": payload,
                "payment_collection_plan": [],
                "next_best_action": {
                    "action": "Revise task to remove prohibited payment movement, credential use, card/account testing, carding, diversion, laundering/structuring/evasion, or fraud-coaching behavior.",
                    "owner": "PAYMENTINT Manager",
                    "expected_output": "Policy-compliant defensive payment-review scope and question set.",
                },
            }
            self.last_result = result
            self._write_output(result)
            messagebox.showwarning(
                "Policy Blocked",
                "PAYMENTINT plan not generated because the request is policy-blocked.",
            )
            return

        questions = payload.get("questions") or default_questions(payload)

        if not self.parsed.get("parties") and not self.parsed.get("transactions") and not self.parsed.get("events"):
            self.parsed = finalize_parsed(empty_parsed(), payload, self.analyzed_files)

        files = self.analyzed_files
        parsed = self.parsed

        next_action = build_next_best_action(payload, policy, files, parsed)
        collection_plan = build_collection_plan(payload, questions, files, parsed)

        overall_status = "PLANNING_ONLY"
        if policy["status"] == "HUMAN_REVIEW_REQUIRED":
            overall_status = "HUMAN_REVIEW_REQUIRED"
        if files or parsed.get("parties") or parsed.get("transactions") or parsed.get("events"):
            overall_status = "PLANNING_PLUS_LOCAL_DETERMINISTIC_EVIDENCE"

        result = {
            "mode": overall_status,
            "panel_version": APP_VERSION,
            "policy": (
                "This output does not initiate, authorize, capture, settle, refund, reverse, cancel, freeze, or block payments; does not test cards/bank accounts/wallets/payment handles; "
                "does not use card data, CVV, PIN, OTP, payment tokens, banking credentials, or API keys; does not conduct carding, account takeover, or payment diversion; "
                "does not create fake payment confirmations or fabricate transaction records; does not create laundering strategies, structuring guidance, threshold/sanctions/KYC/AML evasion, "
                "or chargeback/refund fraud coaching. Local deterministic analysis is limited to hashing, safe JSON/CSV/TXT payment metadata parsing, party/transaction/event normalization, "
                "deduplication, lifecycle reconstruction, fee/FX/net-effect arithmetic, invoice/payment/settlement reconciliation, anomaly detection, source independence, contradiction detection, "
                "competing hypotheses, falsification, secret redaction, prompt-injection flagging, and defensive specialist handoff planning. "
                "Live bank/processor/merchant/ledger/settlement enrichment, account blocking, fund recovery, refund/reversal execution, fraud attribution, AML/sanctions/legal action remain planning-only unless configured/authorized/human-reviewed."
            ),
            "policy_screen": policy,
            "warnings": warnings,
            "payload": payload,
            "intelligence_questions": questions,
            "evidence_inventory": files,
            "parties_preview": parsed.get("parties", [])[:300],
            "transactions_preview": parsed.get("transactions", [])[:300],
            "events_preview": parsed.get("events", [])[:300],
            "fees_preview": parsed.get("fees", [])[:300],
            "fx_events_preview": parsed.get("fx_events", [])[:300],
            "invoices_preview": parsed.get("invoices", [])[:300],
            "receipts_preview": parsed.get("receipts", [])[:300],
            "refunds_preview": parsed.get("refunds", [])[:300],
            "reversals_preview": parsed.get("reversals", [])[:300],
            "chargebacks_preview": parsed.get("chargebacks", [])[:300],
            "disputes_preview": parsed.get("disputes", [])[:300],
            "settlements_preview": parsed.get("settlements", [])[:300],
            "dedup_clusters": parsed.get("dedup_clusters", [])[:1000],
            "net_financial_effects": parsed.get("net_financial_effects", [])[:1000],
            "reconciliations": parsed.get("reconciliations", [])[:1000],
            "anomalies": parsed.get("anomalies", [])[:1000],
            "contradictions": parsed.get("contradictions", [])[:1000],
            "hypotheses": parsed.get("hypotheses", [])[:1000],
            "knowledge_gaps": parsed.get("knowledge_gaps", [])[:500],
            "specialist_handoffs": parsed.get("specialist_handoffs", [])[:500],
            "next_best_action": next_action,
            "payment_collection_plan": collection_plan,
            **self._policy_sections(),
            **self._schemas(),
        }

        self.last_result = result
        self._write_output(result)
        self.notebook.select(self.output_tab)

        if warnings:
            messagebox.showwarning(
                "Validation Warnings",
                "PAYMENTINT plan generated with warnings:\n\n" + "\n".join(warnings),
            )

    def _build_local_analysis_report(
        self,
        files: List[Dict[str, Any]],
        parsed: Dict[str, Any],
        payload: Dict[str, Any],
        policy: Dict[str, Any],
    ) -> Dict[str, Any]:
        next_action = build_next_best_action(payload, policy, files, parsed)
        collection_plan = build_collection_plan(payload, default_questions(payload), files, parsed)

        observations: List[Dict[str, Any]] = []

        for f in files:
            observations.append({
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": f"A local defensive/authorized PAYMENTINT evidence file was accessed and hashed: {f.get('filename')}.",
                "evidence_id": f.get("evidence_id"),
                "source_id": f.get("source_id"),
                "observed_at": now_utc(),
                    def _build_local_analysis_report(
        self,
        files: List[Dict[str, Any]],
        parsed: Dict[str, Any],
        payload: Dict[str, Any],
        policy: Dict[str, Any],
    ) -> Dict[str, Any]:
        next_action = build_next_best_action(payload, policy, files, parsed)
        collection_plan = build_collection_plan(payload, default_questions(payload), files, parsed)

        observations: List[Dict[str, Any]] = []

        for f in files:
            observations.append({
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": f"A local defensive/authorized PAYMENTINT evidence file was accessed and hashed: {f.get('filename')}.",
                "evidence_id": f.get("evidence_id"),
                "source_id": f.get("source_id"),
                "observed_at": now_utc(),
                "extraction_method": "local_deterministic_file_hash",
                "limitations": "File hash does not prove payment lifecycle, settlement, beneficiary identity, or fraud.",
            })

        observations.extend([
            {
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": f"{len(files)} PAYMENTINT evidence file(s) were parsed locally.",
                "evidence_id": "AGGREGATE",
                "source_id": "LOCAL_PARSER",
                "observed_at": now_utc(),
                "extraction_method": "safe_json_csv_text_payment_parser",
                "limitations": "Parser output is normalized evidence, not verified external reality.",
            },
            {
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": (
                    f"{len(parsed.get('parties', []))} party record(s), "
                    f"{len(parsed.get('transactions', []))} transaction record(s), "
                    f"{len(parsed.get('events', []))} payment event record(s), "
                    f"{len(parsed.get('invoices', []))} invoice record(s), "
                    f"{len(parsed.get('settlements', []))} settlement record(s), "
                    f"{len(parsed.get('refunds', []))} refund record(s), "
                    f"{len(parsed.get('reversals', []))} reversal record(s), and "
                    f"{len(parsed.get('chargebacks', []))} chargeback record(s) were extracted."
                ),
                "evidence_id": "AGGREGATE",
                "source_id": "LOCAL_PAYMENT_PARSER",
                "observed_at": now_utc(),
                "extraction_method": "party_transaction_event_invoice_settlement_adjustment_extraction",
                "limitations": "Source-reported payment records are not verified settlement, beneficiary identity, or fraud.",
            },
            {
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": "No payment initiation, authorization, capture, settlement, refund, reversal, cancellation, account freeze/block, card/account/wallet testing, credential use, carding, diversion, laundering, structuring, evasion guidance, or refund/chargeback fraud coaching was performed.",
                "evidence_id": "LOCAL_PANEL_POLICY",
                "source_id": "LOCAL_POLICY_GUARD",
                "observed_at": now_utc(),
                "extraction_method": "defensive_authorized_privacy_aware_policy",
                "limitations": "Planning/local deterministic panel only.",
            },
        ])

        observations, _ = truncate_list(observations, 500)

        candidate_facts: List[Dict[str, Any]] = []

        for f in files:
            if f.get("sha256"):
                candidate_facts.append({
                    "candidate_fact": f"The preserved local PAYMENTINT evidence artifact {f.get('filename')} has SHA256 {f.get('sha256')}.",
                    "status": "SUPPORTED",
                    "evidence_ids": [f.get("evidence_id")],
                    "notes": "Supported by deterministic local hashing. Does not prove payment lifecycle, settlement, beneficiary, or fraud.",
                })

        candidate_facts.extend([
            {
                "candidate_fact": f"{len(parsed.get('transactions', []))} transaction candidate(s) were extracted; {len([t for t in parsed.get('transactions', []) if t.get('is_representative', True)])} representative transaction(s) remain after deduplication heuristics.",
                "status": "SUPPORTED_AS_CANDIDATE_ONLY",
                "evidence_ids": ["AGGREGATE"],
                "not_supported": [
                    "verified settlement",
                    "verified ultimate beneficiary",
                    "verified payer operator identity",
                    "verified fraud",
                    "verified net loss",
                ],
            },
            {
                "candidate_fact": f"{len(parsed.get('events', []))} payment lifecycle event candidate(s) were extracted or derived.",
                "status": "SUPPORTED_AS_CANDIDATE_ONLY",
                "evidence_ids": ["AGGREGATE"],
                "not_supported": [
                    "authorization equals capture",
                    "capture equals settlement",
                    "settlement equals irreversibility",
                ],
            },
            {
                "candidate_fact": f"{len(parsed.get('net_financial_effects', []))} deterministic net-financial-effect candidate model(s) were computed by currency.",
                "status": "SUPPORTED_AS_CANDIDATE_ONLY",
                "evidence_ids": ["AGGREGATE"],
                "not_supported": [
                    "gross transfer equals net loss",
                    "attempted payment equals realized loss",
                    "refund promise equals settled recovery",
                ],
            },
            {
                "candidate_fact": "No payment movement, credential use, card/account testing, carding, diversion, laundering, structuring, evasion guidance, or refund/chargeback fraud coaching was performed.",
                "status": "SUPPORTED",
                "evidence_ids": ["LOCAL_PANEL_POLICY"],
                "notes": "Defensive/authorized/privacy-aware planning boundary.",
            },
        ])

        candidate_facts, _ = truncate_list(candidate_facts, 200)

        fact_gate = {
            "status": "LOCAL_DETERMINISTIC_ONLY" if files or parsed.get("parties") or parsed.get("transactions") or parsed.get("events") else "NO_LOCAL_PAYMENTINT_EVIDENCE",
            "supported": [
                "file/source existence and SHA256 hash",
                "parsed payer/payee/merchant/processor/bank/account/instrument/wallet candidates",
                "parsed transaction candidates",
                "parsed authorization/capture/clearing/settlement/decline/failure/reversal/refund/dispute/chargeback event candidates",
                "parsed fee/FX candidates",
                "parsed invoice/receipt candidates",
                "parsed settlement batch candidates",
                "transaction duplicate clusters",
                "deterministic net financial effect candidates",
                "invoice/payment reconciliation states",
                "payment anomaly candidates",
                "contradiction candidates",
                "competing hypotheses",
                "secret redaction flags",
                "prompt-injection flags",
            ],
            "not_supported": [
                "verified settlement",
                "verified ultimate beneficiary",
                "verified payer operator identity",
                "verified fraud",
                "verified net loss",
                "verified refund recovery",
                "verified chargeback outcome",
                "final legal/regulatory determination",
                "autonomous account blocking",
                "autonomous fund recovery",
                "autonomous refund/reversal execution",
                "autonomous public accusation",
                "autonomous law-enforcement referral",
            ],
            "safety_status": (
                "No payment initiation, authorization, capture, settlement, refund, reversal, cancellation, account freeze/block, card/account/wallet testing, "
                "credential use, carding, account takeover, payment diversion, fake confirmation, laundering, structuring, threshold/sanctions/KYC/AML evasion, "
                "or refund/chargeback fraud coaching performed."
            ),
        }

        return {
            "mode": "LOCAL_DETERMINISTIC_PAYMENTINT_ANALYSIS",
            "panel_version": APP_VERSION,
            "policy_screen": policy,
            "payment_initiation_performed": False,
            "payment_authorization_performed": False,
            "payment_capture_performed": False,
            "payment_settlement_performed": False,
            "refund_execution_performed": False,
            "reversal_execution_performed": False,
            "account_freeze_or_block_performed": False,
            "card_or_account_testing_performed": False,
            "credential_use_performed": False,
            "carding_performed": False,
            "payment_diversion_performed": False,
            "fake_confirmation_performed": False,
            "laundering_or_structuring_guidance_performed": False,
            "evasion_guidance_performed": False,
            "refund_or_chargeback_fraud_coaching_performed": False,
            "evidence_inventory": files,
            "parties_preview": parsed.get("parties", [])[:300],
            "transactions_preview": parsed.get("transactions", [])[:300],
            "events_preview": parsed.get("events", [])[:300],
            "fees_preview": parsed.get("fees", [])[:300],
            "fx_events_preview": parsed.get("fx_events", [])[:300],
            "invoices_preview": parsed.get("invoices", [])[:300],
            "receipts_preview": parsed.get("receipts", [])[:300],
            "refunds_preview": parsed.get("refunds", [])[:300],
            "reversals_preview": parsed.get("reversals", [])[:300],
            "chargebacks_preview": parsed.get("chargebacks", [])[:300],
            "disputes_preview": parsed.get("disputes", [])[:300],
            "settlements_preview": parsed.get("settlements", [])[:300],
            "dedup_clusters": parsed.get("dedup_clusters", [])[:1000],
            "net_financial_effects": parsed.get("net_financial_effects", [])[:1000],
            "reconciliations": parsed.get("reconciliations", [])[:1000],
            "anomalies": parsed.get("anomalies", [])[:1000],
            "contradictions": parsed.get("contradictions", [])[:1000],
            "hypotheses": parsed.get("hypotheses", [])[:1000],
            "knowledge_gaps": parsed.get("knowledge_gaps", [])[:500],
            "specialist_handoffs": parsed.get("specialist_handoffs", [])[:500],
            "observations": observations,
            "candidate_facts": candidate_facts,
            "fact_gate": fact_gate,
            "recommended_next_actions": next_action,
            "payment_collection_plan_preview": collection_plan[:20],
            "limitations": [
                "Only local deterministic checks were performed.",
                "No network access was performed.",
                "No payment movement, credential use, card/account testing, carding, diversion, laundering, structuring, evasion guidance, or refund/chargeback fraud coaching was performed.",
                "Payer is not automatically account holder or actual operator.",
                "Payee is not automatically ultimate beneficiary.",
                "Merchant is not automatically processor.",
                "Merchant is not automatically settlement entity.",
                "Payment facilitator is not automatically merchant.",
                "Aggregator is not automatically beneficiary.",
                "Intermediary bank is not automatically beneficiary.",
                "Authorization is not capture.",
                "Capture is not settlement.",
                "Settlement is not irreversible.",
                "Refund is not reversal.",
                "Dispute is not fraud.",
                "Chargeback is not fraud.",
                "Invoice is not payment.",
                "Receipt is not bank settlement.",
                "Screenshot is not primary transaction record.",
                "Gross payment is not net settlement.",
                "Gross transfer is not net loss.",
                "Multiple lifecycle records are not multiple payments.",
                "Authorization and settlement records are not two transactions.",
                "Historical payment account is not current control.",
                "Name match is not beneficiary identity.",
                "Cross-border payment is not automatically suspicious.",
                "Multiple downstream records from one processor are not independent sources.",
                "AI agreement is not payment corroboration.",
                "Exposed secrets were redacted heuristically and not used.",
                "Payment evidence was treated as untrusted data.",
            ],
        }

    def _write_output(self, result: Dict[str, Any]) -> None:
        self.output.delete("1.0", "end")
        self.output.insert("1.0", json.dumps(result, ensure_ascii=False, indent=2, default=str))

