def now_utc() -> str:
    return datetime.now(timezone.utc).isoformat()


def normalize_text(value: Any) -> str:
    return re.sub(r"\s+", " ", str(value or "")).strip().lower()


def normalize_key(value: Any) -> str:
    s = str(value or "").strip().lower()
    s = re.sub(r"[^a-z0-9]+", "_", s)
    return s.strip("_")


def parse_list(value: str) -> List[Any]:
    value = str(value or "").strip()
    if not value:
        return []

    try:
        parsed = json.loads(value)
        if isinstance(parsed, list):
            return parsed
        if isinstance(parsed, dict):
            return [parsed]
    except Exception:
        pass

    normalized = value.replace(",", "\n")
    parts = [p.strip() for p in normalized.splitlines()]
    return [p for p in parts if p]


def parse_dict(value: str) -> Dict[str, Any]:
    value = str(value or "").strip()
    if not value:
        return {}

    try:
        parsed = json.loads(value)
        if isinstance(parsed, dict):
            return parsed
    except Exception:
        pass

    result: Dict[str, Any] = {}
    for line in value.splitlines():
        line = line.strip()
        if not line or ":" not in line:
            continue
        key, val = line.split(":", 1)
        result[key.strip()] = val.strip()
    return result


def listify(value: Any) -> List[Any]:
    if value is None:
        return []
    if isinstance(value, list):
        return value
    if isinstance(value, dict):
        return [value]
    return [value]


def unique_preserve_order(items: List[Any]) -> List[Any]:
    seen = set()
    out = []
    for item in items:
        key = json.dumps(item, ensure_ascii=False, sort_keys=True, default=str) if isinstance(item, (dict, list)) else str(item)
        if key not in seen:
            seen.add(key)
            out.append(item)
    return out


def truncate_list(items: List[Any], limit: int) -> Tuple[List[Any], bool]:
    if len(items) <= limit:
        return items, False
    return items[:limit], True


def sha256_text(text: str) -> str:
    return hashlib.sha256((text or "").encode("utf-8", errors="replace")).hexdigest()


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def redact_secrets(text: str) -> Tuple[str, List[str]]:
    flags: List[str] = []
    if not text:
        return "", flags

    out = text
    for name, rx in SECRET_PATTERNS:
        if rx.search(out):
            flags.append(name)
            out = rx.sub("[REDACTED_SECRET]", out)

    return out, sorted(set(flags))


def detect_prompt_injection(text: str) -> List[str]:
    flags: List[str] = []
    low = normalize_text(text)
    for pattern in PROMPT_INJECTION_PATTERNS:
        if re.search(pattern, low, re.I):
            flags.append(pattern)
    return sorted(set(flags))


def safe_str(value: Any, limit: int = 300) -> str:
    return redact_secrets(str(value or ""))[0].strip()[:limit]


def content_tokens(text: str) -> List[str]:
    redacted, _ = redact_secrets(str(text or ""))
    low = normalize_text(redacted)
    return re.findall(r"[a-z0-9]+", low)


def content_fingerprint(text: str) -> str:
    tokens = content_tokens(text)
    if not tokens:
        return ""
    return sha256_text(" ".join(sorted(set(tokens))))[:32]


def get_field(rec: Dict[str, Any], keys: List[str], as_list: bool = False) -> Any:
    if not isinstance(rec, dict):
        return [] if as_list else None

    lower = {normalize_key(k): v for k, v in rec.items()}
    for key in keys:
        nk = normalize_key(key)
        if nk in lower and lower[nk] not in (None, ""):
            val = lower[nk]
            if as_list:
                return listify(val)
            if isinstance(val, list):
                return val[0] if val else None
            return val
    return [] if as_list else None


def extract_domains(text: str) -> List[str]:
    out = []
    for m in DOMAIN_RE.finditer(text or ""):
        d = m.group(1).lower()
        if d not in out:
            out.append(d)
    return out


def extract_emails(text: str) -> List[str]:
    out = []
    for m in EMAIL_RE.finditer(text or ""):
        e = m.group(0).lower()
        if e not in out:
            out.append(e)
    return out


def parse_money(value: Any) -> Tuple[Optional[Decimal], str]:
    if value is None:
        return None, ""

    if isinstance(value, Decimal):
        return value, ""

    s = str(value).strip()
    if not s:
        return None, ""

    currency = ""
    upper = s.upper()

    if "$" in s:
        currency = "USD"
    elif "€" in s:
        currency = "EUR"
    elif "£" in s:
        currency = "GBP"
    elif "₹" in s:
        currency = "INR"

    cur_match = re.search(r"\b(USD|EUR|GBP|INR|BTC|ETH|USDT|USDC)\b", upper)
    if cur_match:
        currency = cur_match.group(1)

    cleaned = re.sub(r"[^0-9.\-]", "", s)
    if not cleaned or cleaned in {"-", ".", "-."}:
        return None, currency

    try:
        dec = Decimal(cleaned)
    except InvalidOperation:
        return None, currency

    return dec, currency


def dec(value: Any) -> Decimal:
    if value in (None, ""):
        return Decimal("0")
    try:
        return Decimal(str(value))
    except InvalidOperation:
        return Decimal("0")


def map_status(value: Any) -> str:
    raw = safe_str(value, 100)
    norm = normalize_key(raw)
    return STATUS_MAP.get(norm, raw.upper() if raw else "UNKNOWN")


def empty_parsed() -> Dict[str, Any]:
    return {
        "sources": [],
        "parties": [],
        "transactions": [],
        "events": [],
        "fees": [],
        "fx_events": [],
        "invoices": [],
        "receipts": [],
        "refunds": [],
        "reversals": [],
        "chargebacks": [],
        "disputes": [],
        "settlements": [],
        "observations": [],
        "notes": [],
        "contradictions": [],
        "hypotheses": [],
        "knowledge_gaps": [],
        "specialist_handoffs": [],
        "anomalies": [],
        "reconciliations": [],
        "dedup_clusters": [],
        "net_financial_effects": [],
    }


def add_note(parsed: Dict[str, Any], note_type: str, **kwargs: Any) -> None:
    if len(parsed.get("notes", [])) >= 200000:
        return
    note = {"type": note_type}
    note.update(kwargs)
    parsed["notes"].append(note)


def add_observation(parsed: Dict[str, Any], statement: str, source_id: str, evidence_id: str, context: str = "") -> None:
    if len(parsed.get("observations", [])) >= 200000:
        return

    redacted, secret_flags = redact_secrets(str(statement or "")[:1000])
    injection_flags = detect_prompt_injection(str(statement or ""))

    parsed["observations"].append({
        "observation_id": f"OBS-{uuid.uuid4()}",
        "statement": redacted,
        "source_id": source_id,
        "evidence_id": evidence_id,
        "context": context[:200],
        "state": "SOURCE_OBSERVED",
        "secret_flags": secret_flags,
        "prompt_injection_flags": injection_flags,
        "content_hash": sha256_text(str(statement or "")),
        "limitations": [
            "Payment source statement is evidence about a payment event/claim, not verified settlement or beneficiary identity.",
            "Screenshots/messages/receipts are secondary evidence unless corroborated by primary payment records.",
        ],
    })

    if secret_flags:
        add_note(parsed, "SECRET_REDACTION", flags=secret_flags, source_id=source_id, evidence_id=evidence_id, context=context)
    if injection_flags:
        add_note(parsed, "PROMPT_INJECTION_FLAG", flags=injection_flags, source_id=source_id, evidence_id=evidence_id, context=context,
                 caution="Embedded instructions in payment evidence are ignored.")


def add_source(
    parsed: Dict[str, Any],
    source_id: str,
    evidence_id: str,
    filename: str = "",
    file_hash: str = "",
    publisher: str = "",
    title: str = "",
    source_type: str = "",
    markings: str = "",
    content_fp: str = "",
) -> None:
    for s in parsed["sources"]:
        if s.get("source_id") == source_id:
            if file_hash and not s.get("file_hash"):
                s["file_hash"] = file_hash
            if publisher and not s.get("publisher"):
                s["publisher"] = publisher
            if title and not s.get("title"):
                s["title"] = title
            if content_fp and not s.get("content_fingerprint"):
                s["content_fingerprint"] = content_fp
            return

    parsed["sources"].append({
        "source_id": source_id,
        "evidence_id": evidence_id,
        "filename": filename,
        "file_hash": file_hash,
        "publisher": publisher,
        "title": title,
        "source_type": source_type or "UNKNOWN",
        "markings": markings,
        "content_fingerprint": content_fp,
        "retrieved_at": now_utc(),
        "state": "SOURCE_REGISTERED",
        "source_independence_state": "UNKNOWN",
        "limitations": [
            "Source registration is local provenance metadata.",
            "Gateway/processor/merchant/dashboard/accounting exports may describe the same upstream payment event.",
        ],
    })


def add_party(
    parsed: Dict[str, Any],
    name: Any,
    party_type: Any,
    role: Any = "",
    jurisdiction: Any = "",
    location: Any = "",
    source_id: str = "",
    evidence_id: str = "",
    context: str = "",
) -> Optional[str]:
    n = safe_str(name, 200)
    if not n:
        return None

    norm = normalize_text(n)
    pt = safe_str(party_type, 100).upper() or "UNKNOWN"
    r = safe_str(role, 100).upper() or pt

    for p in parsed["parties"]:
        if p.get("normalized_name") == norm and p.get("party_type") == pt:
            if jurisdiction and not p.get("jurisdiction"):
                p["jurisdiction"] = safe_str(jurisdiction, 100)
            if location and not p.get("location"):
                p["location"] = safe_str(location, 300)
            if r and r != "UNKNOWN" and p.get("role") in ("", "UNKNOWN"):
                p["role"] = r
            return p.get("party_id")

    pid = f"PTY-{uuid.uuid4()}"
    parsed["parties"].append({
        "party_id": pid,
        "name": n,
        "normalized_name": norm,
        "party_type": pt,
        "role": r,
        "jurisdiction": safe_str(jurisdiction, 100),
        "location": safe_str(location, 300),
        "source_id": source_id,
        "evidence_id": evidence_id,
        "context": safe_str(context, 300),
        "state": "PARTY_CANDIDATE",
        "limitations": [
            "Party resolution requires corroboration. Name similarity alone is insufficient.",
            "Payer is not automatically account holder or actual operator.",
            "Payee is not automatically ultimate beneficiary.",
            "Merchant is not automatically processor, payment facilitator, aggregator, or settlement entity.",
        ],
    })
    return pid


def resolve_party_value(
    parsed: Dict[str, Any],
    value: Any,
    default_type: str,
    source_id: str,
    evidence_id: str,
    context: str = "",
) -> Optional[str]:
    if value is None or value == "":
        return None

    if isinstance(value, dict):
        name = (
            value.get("name")
            or value.get("legal_name")
            or value.get("display_name")
            or value.get("entity_name")
            or value.get("merchant_name")
            or value.get("processor_name")
            or value.get("account_id")
            or value.get("id")
        )
        pt = value.get("party_type") or value.get("type") or value.get("role") or default_type
        jurisdiction = value.get("jurisdiction") or value.get("country") or value.get("region")
        location = value.get("location") or value.get("address_summary") or value.get("site")
    else:
        name = str(value)
        pt = default_type
        jurisdiction = ""
        location = ""

    return add_party(
        parsed,
        name,
        pt,
        pt,
        jurisdiction,
        location,
        source_id,
        evidence_id,
        context,
    )


def add_event(
    parsed: Dict[str, Any],
    transaction_ref: Any,
    event_type: Any,
    time: Any,
    amount: Any,
    currency: Any,
    status: Any,
    party_refs: Optional[List[str]] = None,
    source_id: str = "",
    evidence_id: str = "",
    context: str = "",
) -> Optional[str]:
    et = safe_str(event_type, 100).upper() or map_status(status) or "UNKNOWN"
    if et == "UNKNOWN" and not time:
        return None

    parsed_amount, parsed_currency = parse_money(amount)
    if currency:
        parsed_currency = safe_str(currency, 20).upper() or parsed_currency

    ev_id = f"EVT-{uuid.uuid4()}"
    parsed["events"].append({
        "event_id": ev_id,
        "transaction_ref": safe_str(transaction_ref, 200),
        "event_type": et,
        "time": safe_str(time, 100),
        "amount_decimal": str(parsed_amount) if parsed_amount is not None else None,
        "amount_display": safe_str(amount, 100),
        "currency": parsed_currency or "UNKNOWN",
        "status": map_status(status) or et,
        "party_refs": unique_preserve_order(party_refs or [])[:100],
        "source_id": source_id,
        "evidence_id": evidence_id,
        "context": safe_str(context, 300),
        "state": "PAYMENT_EVENT_SOURCE_REPORTED",
        "limitations": [
            "Event type/status is source-reported until reconciled with primary records.",
            "Authorization, capture, clearing, and settlement are distinct lifecycle stages.",
        ],
    })
    return ev_id


def add_transaction(
    parsed: Dict[str, Any],
    transaction_id: Any,
    payer: Any,
    payee: Any,
    merchant: Any,
    beneficiary: Any,
    source_account: Any,
    destination_account: Any,
    payment_instrument: Any,
    wallet: Any,
    payment_rail: Any,
    issuer: Any,
    acquirer: Any,
    gateway: Any,
    processor: Any,
    payment_facilitator: Any,
    aggregator: Any,
    intermediary_bank: Any,
    settlement_entity: Any,
    amount: Any,
    currency: Any,
    fees: Any,
    fx_rate: Any,
    authorization_time: Any,
    capture_time: Any,
    clearing_time: Any,
    settlement_time: Any,
    status: Any,
    references: Any,
    invoice_reference: Any,
    source_id: str,
    evidence_id: str,
    context: str = "",
) -> Optional[str]:
    payer_ref = resolve_party_value(parsed, payer, "PAYER", source_id, evidence_id, f"{context}/payer") if payer else None
    payee_ref = resolve_party_value(parsed, payee, "PAYEE", source_id, evidence_id, f"{context}/payee") if payee else None
    merchant_ref = resolve_party_value(parsed, merchant, "MERCHANT", source_id, evidence_id, f"{context}/merchant") if merchant else None
    beneficiary_ref = resolve_party_value(parsed, beneficiary, "BENEFICIARY_CANDIDATE", source_id, evidence_id, f"{context}/beneficiary") if beneficiary else None
    source_account_ref = resolve_party_value(parsed, source_account, "ACCOUNT", source_id, evidence_id, f"{context}/source_account") if source_account else None
    destination_account_ref = resolve_party_value(parsed, destination_account, "ACCOUNT", source_id, evidence_id, f"{context}/destination_account") if destination_account else None
    instrument_ref = resolve_party_value(parsed, payment_instrument, "PAYMENT_INSTRUMENT", source_id, evidence_id, f"{context}/instrument") if payment_instrument else None
    wallet_ref = resolve_party_value(parsed, wallet, "WALLET", source_id, evidence_id, f"{context}/wallet") if wallet else None
    issuer_ref = resolve_party_value(parsed, issuer, "ISSUER", source_id, evidence_id, f"{context}/issuer") if issuer else None
    acquirer_ref = resolve_party_value(parsed, acquirer, "ACQUIRER", source_id, evidence_id, f"{context}/acquirer") if acquirer else None
    gateway_ref = resolve_party_value(parsed, gateway, "GATEWAY", source_id, evidence_id, f"{context}/gateway") if gateway else None
    processor_ref = resolve_party_value(parsed, processor, "PROCESSOR", source_id, evidence_id, f"{context}/processor") if processor else None
    payfac_ref = resolve_party_value(parsed, payment_facilitator, "PAYMENT_FACILITATOR", source_id, evidence_id, f"{context}/payfac") if payment_facilitator else None
    aggregator_ref = resolve_party_value(parsed, aggregator, "PAYMENT_AGGREGATOR", source_id, evidence_id, f"{context}/aggregator") if aggregator else None
    intermediary_ref = resolve_party_value(parsed, intermediary_bank, "INTERMEDIARY_BANK", source_id, evidence_id, f"{context}/intermediary_bank") if intermediary_bank else None
    settlement_ref = resolve_party_value(parsed, settlement_entity, "SETTLEMENT_ENTITY", source_id, evidence_id, f"{context}/settlement_entity") if settlement_entity else None

    parsed_amount, parsed_currency = parse_money(amount)
    if currency:
        parsed_currency = safe_str(currency, 20).upper() or parsed_currency

    status_raw = safe_str(status, 100)
    status_mapped = map_status(status_raw)
    ext_id = safe_str(transaction_id, 200)
    rec_id = f"TXNR-{uuid.uuid4()}"

    party_refs = [x for x in [
        payer_ref, payee_ref, merchant_ref, beneficiary_ref, source_account_ref,
        destination_account_ref, instrument_ref, wallet_ref, issuer_ref,
        acquirer_ref, gateway_ref, processor_ref, payfac_ref, aggregator_ref,
        intermediary_ref, settlement_ref,
    ] if x]

    parsed["transactions"].append({
        "transaction_record_id": rec_id,
        "external_transaction_id": ext_id,
        "payer_ref": payer_ref,
        "payer_display": safe_str(payer, 200),
        "payee_ref": payee_ref,
        "payee_display": safe_str(payee, 200),
        "merchant_ref": merchant_ref,
        "merchant_display": safe_str(merchant, 200),
        "beneficiary_ref": beneficiary_ref,
        "beneficiary_display": safe_str(beneficiary, 200),
        "source_account_ref": source_account_ref,
        "destination_account_ref": destination_account_ref,
        "payment_instrument_ref": instrument_ref,
        "wallet_ref": wallet_ref,
        "payment_rail": safe_str(payment_rail, 100).upper() or "UNKNOWN",
        "issuer_ref": issuer_ref,
        "acquirer_ref": acquirer_ref,
        "gateway_ref": gateway_ref,
        "processor_ref": processor_ref,
        "payment_facilitator_ref": payfac_ref,
        "aggregator_ref": aggregator_ref,
        "intermediary_bank_ref": intermediary_ref,
        "settlement_entity_ref": settlement_ref,
        "amount_decimal": str(parsed_amount) if parsed_amount is not None else None,
        "amount_display": safe_str(amount, 100),
        "currency": parsed_currency or "UNKNOWN",
        "fees_display": safe_str(fees, 200),
        "fx_rate_display": safe_str(fx_rate, 100),
        "authorization_time": safe_str(authorization_time, 100),
        "capture_time": safe_str(capture_time, 100),
        "clearing_time": safe_str(clearing_time, 100),
        "settlement_time": safe_str(settlement_time, 100),
        "status_raw": status_raw,
        "status_mapped": status_mapped,
        "references": unique_preserve_order(listify(references))[:100],
        "invoice_reference": safe_str(invoice_reference, 200),
        "party_refs": party_refs[:200],
        "source_id": source_id,
        "evidence_id": evidence_id,
        "context": safe_str(context, 300),
        "state": "TRANSACTION_SOURCE_REPORTED",
        "is_representative": True,
        "duplicate_cluster_id": None,
        "duplicate_state": "DISTINCT",
        "limitations": [
            "Transaction record must be corroborated by primary payment-system/bank/processor records where consequential.",
            "Authorization is not capture; capture is not settlement; settlement is not irreversible.",
            "Payee is not automatically ultimate beneficiary.",
            "Merchant descriptor is not automatically legal settlement entity.",
        ],
    })

    for event_type, event_time in [
        ("AUTHORIZED", authorization_time),
        ("CAPTURED", capture_time),
        ("CLEARED", clearing_time),
        ("SETTLED", settlement_time),
    ]:
        if event_time:
            add_event(
                parsed,
                ext_id or rec_id,
                event_type,
                event_time,
                amount,
                parsed_currency,
                event_type,
                party_refs,
                source_id,
                evidence_id,
                f"{context}/event/{event_type}",
            )

    if status_mapped in {"DECLINED", "FAILED", "CANCELLED", "VOIDED", "EXPIRED"}:
        add_event(
            parsed,
            ext_id or rec_id,
            status_mapped,
            authorization_time or settlement_time or now_utc(),
            amount,
            parsed_currency,
            status_mapped,
            party_refs,
            source_id,
            evidence_id,
            f"{context}/event/{status_mapped}",
        )

    return rec_id


def add_fee(
    parsed: Dict[str, Any],
    transaction_ref: Any,
    fee_type: Any,
    amount: Any,
    currency: Any,
    time: Any,
    source_id: str,
    evidence_id: str,
    context: str = "",
) -> None:
    parsed_amount, parsed_currency = parse_money(amount)
    if currency:
        parsed_currency = safe_str(currency, 20).upper() or parsed_currency

    parsed["fees"].append({
        "fee_id": f"FEE-{uuid.uuid4()}",
        "transaction_ref": safe_str(transaction_ref, 200),
        "fee_type": safe_str(fee_type, 100).upper() or "UNKNOWN",
        "amount_decimal": str(parsed_amount) if parsed_amount is not None else None,
        "amount_display": safe_str(amount, 100),
        "currency": parsed_currency or "UNKNOWN",
        "time": safe_str(time, 100),
        "source_id": source_id,
        "evidence_id": evidence_id,
        "context": safe_str(context, 300),
        "state": "FEE_SOURCE_REPORTED",
        "limitations": [
            "Fee type is source-reported unless supported by processor/contract evidence.",
            "Gross payer amount, merchant sale amount, and net settlement amount may differ.",
        ],
    })


def add_fx_event(
    parsed: Dict[str, Any],
    transaction_ref: Any,
    source_currency: Any,
    destination_currency: Any,
    source_amount: Any,
    destination_amount: Any,
    rate: Any,
    rate_source: Any,
    time: Any,
    source_id: str,
    evidence_id: str,
    context: str = "",
) -> None:
    src_dec, src_cur = parse_money(source_amount)
    dst_dec, dst_cur = parse_money(destination_amount)
    if source_currency:
        src_cur = safe_str(source_currency, 20).upper() or src_cur
    if destination_currency:
        dst_cur = safe_str(destination_currency, 20).upper() or dst_cur

    parsed["fx_events"].append({
        "fx_event_id": f"FX-{uuid.uuid4()}",
        "transaction_ref": safe_str(transaction_ref, 200),
        "source_currency": src_cur or "UNKNOWN",
        "destination_currency": dst_cur or "UNKNOWN",
        "source_amount_decimal": str(src_dec) if src_dec is not None else None,
        "destination_amount_decimal": str(dst_dec) if dst_dec is not None else None,
        "rate": safe_str(rate, 100),
        "rate_source": safe_str(rate_source, 200),
        "time": safe_str(time, 100),
        "source_id": source_id,
        "evidence_id": evidence_id,
        "context": safe_str(context, 300),
        "state": "FX_SOURCE_REPORTED",
        "limitations": [
            "Processor/bank FX rate may include spread/markup and is not necessarily market mid-rate.",
            "Do not compare amounts across currencies without explicit FX evidence.",
        ],
    })


def add_invoice(
    parsed: Dict[str, Any],
    invoice_id: Any,
    issuer: Any,
    recipient: Any,
    amount: Any,
    currency: Any,
    invoice_date: Any,
    due_date: Any,
    line_items: Any,
    document_hash: Any,
    transaction_reference: Any,
    source_id: str,
    evidence_id: str,
    context: str = "",
) -> None:
    issuer_ref = resolve_party_value(parsed, issuer, "MERCHANT", source_id, evidence_id, f"{context}/issuer") if issuer else None
    recipient_ref = resolve_party_value(parsed, recipient, "PAYER", source_id, evidence_id, f"{context}/recipient") if recipient else None
    parsed_amount, parsed_currency = parse_money(amount)
    if currency:
        parsed_currency = safe_str(currency, 20).upper() or parsed_currency

    parsed["invoices"].append({
        "invoice_record_id": f"INVR-{uuid.uuid4()}",
        "invoice_id": safe_str(invoice_id, 200),
        "issuer_ref": issuer_ref,
        "issuer_display": safe_str(issuer, 200),
        "recipient_ref": recipient_ref,
        "recipient_display": safe_str(recipient, 200),
        "amount_decimal": str(parsed_amount) if parsed_amount is not None else None,
        "amount_display": safe_str(amount, 100),
        "currency": parsed_currency or "UNKNOWN",
        "invoice_date": safe_str(invoice_date, 100),
        "due_date": safe_str(due_date, 100),
        "line_items": unique_preserve_order(listify(line_items))[:200],
        "document_hash": safe_str(document_hash, 120),
        "transaction_reference": safe_str(transaction_reference, 200),
        "source_id": source_id,
        "evidence_id": evidence_id,
        "context": safe_str(context, 300),
        "state": "INVOICE_SOURCE_REPORTED",
        "limitations": [
            "Invoice indicates amount requested; it does not prove payment.",
            "Document metadata can be edited/stripped/regenerated.",
        ],
    })


def add_receipt(
    parsed: Dict[str, Any],
    receipt_id: Any,
    issuer: Any,
    recipient: Any,
    amount: Any,
    currency: Any,
    time: Any,
    payment_reference: Any,
    document_hash: Any,
    source_id: str,
    evidence_id: str,
    context: str = "",
) -> None:
    issuer_ref = resolve_party_value(parsed, issuer, "MERCHANT", source_id, evidence_id, f"{context}/issuer") if issuer else None
    recipient_ref = resolve_party_value(parsed, recipient, "PAYER", source_id, evidence_id, f"{context}/recipient") if recipient else None
    parsed_amount, parsed_currency = parse_money(amount)
    if currency:
        parsed_currency = safe_str(currency, 20).upper() or parsed_currency

    parsed["receipts"].append({
        "receipt_record_id": f"RCT-{uuid.uuid4()}",
        "receipt_id": safe_str(receipt_id, 200),
        "issuer_ref": issuer_ref,
        "recipient_ref": recipient_ref,
        "amount_decimal": str(parsed_amount) if parsed_amount is not None else None,
        "amount_display": safe_str(amount, 100),
        "currency": parsed_currency or "UNKNOWN",
        "time": safe_str(time, 100),
        "payment_reference": safe_str(payment_reference, 200),
        "document_hash": safe_str(document_hash, 120),
        "source_id": source_id,
        "evidence_id": evidence_id,
        "context": safe_str(context, 300),
        "state": "RECEIPT_SOURCE_REPORTED",
        "limitations": [
            "Receipt is not necessarily bank settlement evidence.",
            "Merchant/platform-generated receipt may be pending, reversed, or fabricated.",
        ],
    })


def add_refund(
    parsed: Dict[str, Any],
    refund_id: Any,
    original_transaction_ref: Any,
    payer: Any,
    payee: Any,
    amount: Any,
    currency: Any,
    time: Any,
    status: Any,
    refund_type: Any,
    source_id: str,
    evidence_id: str,
    context: str = "",
) -> None:
    payer_ref = resolve_party_value(parsed, payer, "PAYER", source_id, evidence_id, f"{context}/payer") if payer else None
    payee_ref = resolve_party_value(parsed, payee, "PAYEE", source_id, evidence_id, f"{context}/payee") if payee else None
    parsed_amount, parsed_currency = parse_money(amount)
    if currency:
        parsed_currency = safe_str(currency, 20).upper() or parsed_currency

    rec_id = f"RFD-{uuid.uuid4()}"
    parsed["refunds"].append({
        "refund_record_id": rec_id,
        "refund_id": safe_str(refund_id, 200),
        "original_transaction_ref": safe_str(original_transaction_ref, 200),
        "payer_ref": payer_ref,
        "payee_ref": payee_ref,
        "amount_decimal": str(parsed_amount) if parsed_amount is not None else None,
        "amount_display": safe_str(amount, 100),
        "currency": parsed_currency or "UNKNOWN",
        "time": safe_str(time, 100),
        "status": map_status(status) or "REFUND_PENDING",
        "refund_type": safe_str(refund_type, 100).upper() or "UNKNOWN",
        "source_id": source_id,
        "evidence_id": evidence_id,
        "context": safe_str(context, 300),
        "state": "REFUND_SOURCE_REPORTED",
        "limitations": [
            "Refund is a new financial event linked to prior payment; it is not automatically a reversal.",
            "Promised/initiated refund is not settled recovery until evidenced.",
        ],
    })
    add_event(parsed, original_transaction_ref or refund_id, "REFUNDED", time, amount, parsed_currency, status, [x for x in [payer_ref, payee_ref] if x], source_id, evidence_id, f"{context}/event")


def add_reversal(
    parsed: Dict[str, Any],
    reversal_id: Any,
    original_transaction_ref: Any,
    amount: Any,
    currency: Any,
    time: Any,
    status: Any,
    source_id: str,
    evidence_id: str,
    context: str = "",
) -> None:
    parsed_amount, parsed_currency = parse_money(amount)
    if currency:
        parsed_currency = safe_str(currency, 20).upper() or parsed_currency

    parsed["reversals"].append({
        "reversal_record_id": f"RSV-{uuid.uuid4()}",
        "reversal_id": safe_str(reversal_id, 200),
        "original_transaction_ref": safe_str(original_transaction_ref, 200),
        "amount_decimal": str(parsed_amount) if parsed_amount is not None else None,
        "amount_display": safe_str(amount, 100),
        "currency": parsed_currency or "UNKNOWN",
        "time": safe_str(time, 100),
        "status": map_status(status) or "REVERSED",
        "source_id": source_id,
        "evidence_id": evidence_id,
        "context": safe_str(context, 300),
        "state": "REVERSAL_SOURCE_REPORTED",
        "limitations": [
            "Reversal may negate prior payment event; do not count original + reversal as two losses.",
            "Void typically cancels before final settlement depending on rail.",
        ],
    })
    add_event(parsed, original_transaction_ref or reversal_id, "REVERSED", time, amount, parsed_currency, status, [], source_id, evidence_id, f"{context}/event")


def add_chargeback(
    parsed: Dict[str, Any],
    chargeback_id: Any,
    original_transaction_ref: Any,
    dispute_id: Any,
    amount: Any,
    currency: Any,
    time: Any,
    status: Any,
    source_id: str,
    evidence_id: str,
    context: str = "",
) -> None:
    parsed_amount, parsed_currency = parse_money(amount)
    if currency:
        parsed_currency = safe_str(currency, 20).upper() or parsed_currency

    parsed["chargebacks"].append({
        "chargeback_record_id": f"CBK-{uuid.uuid4()}",
        "chargeback_id": safe_str(chargeback_id, 200),
        "original_transaction_ref": safe_str(original_transaction_ref, 200),
        "dispute_id": safe_str(dispute_id, 200),
        "amount_decimal": str(parsed_amount) if parsed_amount is not None else None,
        "amount_display": safe_str(amount, 100),
        "currency": parsed_currency or "UNKNOWN",
        "time": safe_str(time, 100),
        "status": safe_str(status, 100).upper() or "UNKNOWN",
        "source_id": source_id,
        "evidence_id": evidence_id,
        "context": safe_str(context, 300),
        "state": "CHARGEBACK_SOURCE_REPORTED",
        "limitations": [
            "Chargeback is a dispute/reversal mechanism; it is not automatically fraud.",
            "Merchant refund and issuer/card-network chargeback are separate mechanisms.",
        ],
    })
    add_event(parsed, original_transaction_ref or chargeback_id, "CHARGEDBACK", time, amount, parsed_currency, status, [], source_id, evidence_id, f"{context}/event")


def add_dispute(
    parsed: Dict[str, Any],
    dispute_id: Any,
    transaction_ref: Any,
    opened_by: Any,
    reason: Any,
    time: Any,
    status: Any,
    source_id: str,
    evidence_id: str,
    context: str = "",
) -> None:
    opened_by_ref = resolve_party_value(parsed, opened_by, "PAYER", source_id, evidence_id, f"{context}/opened_by") if opened_by else None

    parsed["disputes"].append({
        "dispute_record_id": f"DSP-{uuid.uuid4()}",
        "dispute_id": safe_str(dispute_id, 200),
        "transaction_ref": safe_str(transaction_ref, 200),
        "opened_by_ref": opened_by_ref,
        "opened_by_display": safe_str(opened_by, 200),
        "reason": safe_str(reason, 500),
        "time": safe_str(time, 100),
        "status": safe_str(status, 100).upper() or "UNKNOWN",
        "source_id": source_id,
        "evidence_id": evidence_id,
        "context": safe_str(context, 300),
        "state": "DISPUTE_SOURCE_REPORTED",
        "limitations": [
            "Dispute may arise from fraud claim, service disagreement, non-delivery, duplicate charge, incorrect amount, or quality issue.",
            "Dispute result is not automatically a fraud finding.",
        ],
    })
    add_event(parsed, transaction_ref or dispute_id, "DISPUTED", time, "", "", status, [opened_by_ref] if opened_by_ref else [], source_id, evidence_id, f"{context}/event")


def add_settlement_batch(
    parsed: Dict[str, Any],
    settlement_id: Any,
    transaction_ids: Any,
    gross_amount: Any,
    fees: Any,
    net_amount: Any,
    currency: Any,
    settlement_date: Any,
    recipient: Any,
    source_id: str,
    evidence_id: str,
    context: str = "",
) -> None:
    recipient_ref = resolve_party_value(parsed, recipient, "SETTLEMENT_ENTITY", source_id, evidence_id, f"{context}/recipient") if recipient else None
    gross_dec, gross_cur = parse_money(gross_amount)
    fee_dec, fee_cur = parse_money(fees)
    net_dec, net_cur = parse_money(net_amount)
    if currency:
        gross_cur = net_cur = fee_cur = safe_str(currency, 20).upper() or gross_cur

    parsed["settlements"].append({
        "settlement_record_id": f"STL-{uuid.uuid4()}",
        "settlement_id": safe_str(settlement_id, 200),
        "transaction_ids": unique_preserve_order(listify(transaction_ids))[:1000],
        "gross_amount_decimal": str(gross_dec) if gross_dec is not None else None,
        "fees_decimal": str(fee_dec) if fee_dec is not None else None,
        "net_amount_decimal": str(net_dec) if net_dec is not None else None,
        "currency": gross_cur or net_cur or "UNKNOWN",
        "settlement_date": safe_str(settlement_date, 100),
        "recipient_ref": recipient_ref,
        "recipient_display": safe_str(recipient, 200),
        "source_id": source_id,
        "evidence_id": evidence_id,
        "context": safe_str(context, 300),
        "state": "SETTLEMENT_BATCH_SOURCE_REPORTED",
        "limitations": [
            "Settlement batch may combine many transactions; do not map total blindly to one customer transaction.",
            "Net settlement may deduct fees, taxes, reserves, refunds, chargebacks, and adjustments.",
        ],
    })


def process_json_record(
    rec: Dict[str, Any],
    source_id: str,
    evidence_id: str,
    parsed: Dict[str, Any],
    context: str = "",
) -> None:
    if not isinstance(rec, dict):
        return

    rec_ctx = context or "json_record"

    text_blob = json.dumps(rec, ensure_ascii=False, default=str)[:12000]
    process_text_block(text_blob, source_id, evidence_id, parsed, context=rec_ctx)

    for key in PARTY_KEYS:
        vals = get_field(rec, [key], as_list=True)
        for val in vals:
            resolve_party_value(parsed, val, key.upper(), source_id, evidence_id, f"{rec_ctx}/{key}")

    txn_items = get_field(rec, TRANSACTION_KEYS, as_list=True)
    for item in txn_items:
        if isinstance(item, dict):
            add_transaction(
                parsed,
                item.get("transaction_id") or item.get("id") or item.get("reference"),
                item.get("payer") or item.get("from") or item.get("from_account") or item.get("source_account"),
                item.get("payee") or item.get("to") or item.get("to_account") or item.get("destination_account"),
                item.get("merchant") or item.get("merchant_name") or item.get("descriptor"),
                item.get("beneficiary") or item.get("beneficiary_candidate"),
                item.get("source_account") or item.get("account"),
                item.get("destination_account") or item.get("settlement_account"),
                item.get("payment_instrument") or item.get("instrument") or item.get("card_token"),
                item.get("wallet"),
                item.get("payment_rail") or item.get("rail") or item.get("method"),
                item.get("issuer"),
                item.get("acquirer"),
                item.get("gateway"),
                item.get("processor") or item.get("psp") or item.get("payment_service_provider"),
                item.get("payment_facilitator") or item.get("payfac"),
                item.get("payment_aggregator") or item.get("aggregator"),
                item.get("intermediary_bank") or item.get("correspondent_bank"),
                item.get("settlement_entity"),
                item.get("amount") or item.get("value"),
                item.get("currency"),
                item.get("fees") or item.get("fee"),
                item.get("fx_rate") or item.get("exchange_rate"),
                item.get("authorization_time") or item.get("auth_time"),
                item.get("capture_time"),
                item.get("clearing_time"),
                item.get("settlement_time"),
                item.get("status"),
                item.get("references") or item.get("reference") or item.get("txn_reference"),
                item.get("invoice_reference") or item.get("invoice_id"),
                source_id,
                evidence_id,
                f"{rec_ctx}/transaction",
            )

    if get_field(rec, ["amount"]) and (
        get_field(rec, ["payer", "from", "from_account", "source_account"])
        or get_field(rec, ["payee", "to", "to_account", "destination_account"])
        or get_field(rec, ["merchant", "transaction_id", "id", "status"])
    ):
        add_transaction(
            parsed,
            get_field(rec, ["transaction_id", "id", "reference"]),
            get_field(rec, ["payer", "from", "from_account", "source_account"]),
            get_field(rec, ["payee", "to", "to_account", "destination_account"]),
            get_field(rec, ["merchant", "merchant_name", "descriptor"]),
            get_field(rec, ["beneficiary", "beneficiary_candidate"]),
            get_field(rec, ["source_account", "account"]),
            get_field(rec, ["destination_account", "settlement_account"]),
            get_field(rec, ["payment_instrument", "instrument", "card_token"]),
            get_field(rec, ["wallet"]),
            get_field(rec, ["payment_rail", "rail", "method"]),
            get_field(rec, ["issuer"]),
            get_field(rec, ["acquirer"]),
            get_field(rec, ["gateway"]),
            get_field(rec, ["processor", "psp", "payment_service_provider"]),
            get_field(rec, ["payment_facilitator", "payfac"]),
            get_field(rec, ["payment_aggregator", "aggregator"]),
            get_field(rec, ["intermediary_bank", "correspondent_bank"]),
            get_field(rec, ["settlement_entity"]),
            get_field(rec, ["amount", "value"]),
            get_field(rec, ["currency"]),
            get_field(rec, ["fees", "fee"]),
            get_field(rec, ["fx_rate", "exchange_rate"]),
            get_field(rec, ["authorization_time", "auth_time"]),
            get_field(rec, ["capture_time"]),
            get_field(rec, ["clearing_time"]),
            get_field(rec, ["settlement_time"]),
            get_field(rec, ["status"]),
            get_field(rec, ["references", "reference", "txn_reference"]),
            get_field(rec, ["invoice_reference", "invoice_id"]),
            source_id,
            evidence_id,
            rec_ctx,
        )

    event_items = get_field(rec, EVENT_KEYS, as_list=True)
    for item in event_items:
        if isinstance(item, dict):
            add_event(
                parsed,
                item.get("transaction_ref") or item.get("transaction_id") or get_field(rec, ["transaction_id", "id"]),
                item.get("event_type") or item.get("type") or item.get("status"),
                item.get("time") or item.get("timestamp") or item.get("date"),
                item.get("amount") or get_field(rec, ["amount"]),
                item.get("currency") or get_field(rec, ["currency"]),
                item.get("status") or item.get("event_type") or item.get("type"),
                listify(item.get("party_refs") or item.get("parties")),
                source_id,
                evidence_id,
                f"{rec_ctx}/event",
            )

    fee_items = get_field(rec, FEE_KEYS, as_list=True)
    for item in fee_items:
        if isinstance(item, dict):
            add_fee(
                parsed,
                item.get("transaction_ref") or item.get("transaction_id") or get_field(rec, ["transaction_id", "id"]),
                item.get("fee_type") or item.get("type") or "FEE",
                item.get("amount") or item.get("value"),
                item.get("currency"),
                item.get("time") or item.get("date"),
                source_id,
                evidence_id,
                f"{rec_ctx}/fee",
            )
        elif item:
            add_fee(
                parsed,
                get_field(rec, ["transaction_id", "id"]),
                "FEE",
                item,
                get_field(rec, ["currency"]),
                get_field(rec, ["time", "date"]),
                source_id,
                evidence_id,
                f"{rec_ctx}/fee",
            )

    fx_items = get_field(rec, FX_KEYS, as_list=True)
    for item in fx_items:
        if isinstance(item, dict):
            add_fx_event(
                parsed,
                item.get("transaction_ref") or item.get("transaction_id") or get_field(rec, ["transaction_id", "id"]),
                item.get("source_currency") or item.get("from_currency"),
                item.get("destination_currency") or item.get("to_currency"),
                item.get("source_amount"),
                item.get("destination_amount"),
                item.get("rate") or item.get("fx_rate"),
                item.get("rate_source"),
                item.get("time") or item.get("date"),
                source_id,
                evidence_id,
                f"{rec_ctx}/fx",
            )

    inv_items = get_field(rec, INVOICE_KEYS, as_list=True)
    for item in inv_items:
        if isinstance(item, dict):
            add_invoice(
                parsed,
                item.get("invoice_id") or item.get("invoice_number") or item.get("number"),
                item.get("issuer") or item.get("vendor") or item.get("merchant") or item.get("seller"),
                item.get("recipient") or item.get("customer") or item.get("buyer") or item.get("payer"),
                item.get("amount") or item.get("total"),
                item.get("currency"),
                item.get("invoice_date") or item.get("date"),
                item.get("due_date"),
                item.get("line_items") or item.get("items"),
                item.get("document_hash") or item.get("hash"),
                item.get("transaction_reference") or item.get("payment_reference"),
                source_id,
                evidence_id,
                f"{rec_ctx}/invoice",
            )

    if get_field(rec, ["invoice_id", "invoice_number"]):
        add_invoice(
            parsed,
            get_field(rec, ["invoice_id", "invoice_number", "number"]),
            get_field(rec, ["issuer", "vendor", "merchant", "seller"]),
            get_field(rec, ["recipient", "customer", "buyer", "payer"]),
            get_field(rec, ["amount", "total"]),
            get_field(rec, ["currency"]),
            get_field(rec, ["invoice_date", "date"]),
            get_field(rec, ["due_date"]),
            get_field(rec, ["line_items", "items"]),
            get_field(rec, ["document_hash", "hash"]),
            get_field(rec, ["transaction_reference", "payment_reference"]),
            source_id,
            evidence_id,
            rec_ctx,
        )

    receipt_items = get_field(rec, RECEIPT_KEYS, as_list=True)
    for item in receipt_items:
        if isinstance(item, dict):
            add_receipt(
                parsed,
                item.get("receipt_id") or item.get("id"),
                item.get("issuer") or item.get("merchant") or item.get("vendor"),
                item.get("recipient") or item.get("customer") or item.get("payer"),
                item.get("amount") or item.get("total"),
                item.get("currency"),
                item.get("time") or item.get("date"),
                item.get("payment_reference") or item.get("transaction_reference"),
                item.get("document_hash") or item.get("hash"),
                source_id,
                evidence_id,
                f"{rec_ctx}/receipt",
            )

    refund_items = get_field(rec, REFUND_KEYS, as_list=True)
    for item in refund_items:
        if isinstance(item, dict):
            add_refund(
                parsed,
                item.get("refund_id") or item.get("id"),
                item.get("original_transaction_ref") or item.get("transaction_id") or item.get("original_transaction_id"),
                item.get("payer") or item.get("from"),
                item.get("payee") or item.get("to"),
                item.get("amount") or item.get("value"),
                item.get("currency"),
                item.get("time") or item.get("date"),
                item.get("status"),
                item.get("refund_type") or item.get("type"),
                source_id,
                evidence_id,
                f"{rec_ctx}/refund",
            )

    reversal_items = get_field(rec, REVERSAL_KEYS, as_list=True)
    for item in reversal_items:
        if isinstance(item, dict):
            add_reversal(
                parsed,
                item.get("reversal_id") or item.get("void_id") or item.get("id"),
                item.get("original_transaction_ref") or item.get("transaction_id") or item.get("original_transaction_id"),
                item.get("amount") or item.get("value"),
                item.get("currency"),
                item.get("time") or item.get("date"),
                item.get("status"),
                source_id,
                evidence_id,
                f"{rec_ctx}/reversal",
            )

    cb_items = get_field(rec, CHARGEBACK_KEYS, as_list=True)
    for item in cb_items:
        if isinstance(item, dict):
            add_chargeback(
                parsed,
                item.get("chargeback_id") or item.get("id"),
                item.get("original_transaction_ref") or item.get("transaction_id") or item.get("original_transaction_id"),
                item.get("dispute_id"),
                item.get("amount") or item.get("value"),
                item.get("currency"),
                item.get("time") or item.get("date"),
                item.get("status") or item.get("state"),
                source_id,
                evidence_id,
                f"{rec_ctx}/chargeback",
            )

    dispute_items = get_field(rec, DISPUTE_KEYS, as_list=True)
    for item in dispute_items:
        if isinstance(item, dict):
            add_dispute(
                parsed,
                item.get("dispute_id") or item.get("id"),
                item.get("transaction_ref") or item.get("transaction_id"),
                item.get("opened_by") or item.get("customer") or item.get("payer"),
                item.get("reason") or item.get("type"),
                item.get("time") or item.get("date") or item.get("opened_at"),
                item.get("status"),
                source_id,
                evidence_id,
                f"{rec_ctx}/dispute",
            )

    settlement_items = get_field(rec, SETTLEMENT_KEYS, as_list=True)
    for item in settlement_items:
        if isinstance(item, dict):
            add_settlement_batch(
                parsed,
                item.get("settlement_id") or item.get("batch_id") or item.get("payout_id") or item.get("id"),
                item.get("transaction_ids") or item.get("transactions") or item.get("transaction_references"),
                item.get("gross_amount") or item.get("gross"),
                item.get("fees") or item.get("fee"),
                item.get("net_amount") or item.get("net"),
                item.get("currency"),
                item.get("settlement_date") or item.get("date") or item.get("payout_date"),
                item.get("recipient") or item.get("settlement_entity") or item.get("merchant") or item.get("payee"),
                source_id,
                evidence_id,
                f"{rec_ctx}/settlement",
            )


def process_text_block(
    text: str,
    source_id: str,
    evidence_id: str,
    parsed: Dict[str, Any],
    context: str = "",
) -> None:
    raw = str(text or "")
    if not raw.strip():
        return

    redacted, secret_flags = redact_secrets(raw)
    injection_flags = detect_prompt_injection(raw)

    if secret_flags:
        add_note(parsed, "SECRET_REDACTION", flags=secret_flags, source_id=source_id, evidence_id=evidence_id, context=context)
    if injection_flags:
        add_note(parsed, "PROMPT_INJECTION_FLAG", flags=injection_flags, source_id=source_id, evidence_id=evidence_id, context=context,
                 caution="Payment descriptions/invoices/exports/statements are untrusted data.")

    add_observation(parsed, redacted[:1000], source_id, evidence_id, context=context)

    low = normalize_text(redacted)
    signals = []

    if any(k in low for k in ["authorization", "authorized", "capture", "captured", "clearing", "settlement", "settled", "payout"]):
        signals.append("PAYMENT_LIFECYCLE_CONTEXT")
    if any(k in low for k in ["refund", "reversal", "void", "chargeback", "dispute"]):
        signals.append("REFUND_REVERSAL_DISPUTE_CONTEXT")
    if any(k in low for k in ["processor", "gateway", "psp", "payment facilitator", "payfac", "aggregator", "acquirer", "issuer"]):
        signals.append("PAYMENT_INTERMEDIARY_CONTEXT")
    if any(k in low for k in ["merchant descriptor", "merchant id", "mcc", "store", "shop"]):
        signals.append("MERCHANT_DESCRIPTOR_CONTEXT")
    if any(k in low for k in ["invoice", "receipt", "payment confirmation", "proof of payment"]):
        signals.append("INVOICE_RECEIPT_CONFIRMATION_CONTEXT")
    if any(k in low for k in ["fx", "exchange rate", "currency conversion", "cross-border", "wire", "correspondent bank"]):
        signals.append("CROSS_BORDER_FX_CONTEXT")
    if any(k in low for k in ["card", "cvv", "pin", "token", "upi", "vpa", "wallet"]):
        signals.append("INSTRUMENT_OR_RAIL_CONTEXT")
    if any(k in low for k in ["duplicate", "retry", "failed", "declined", "reversal pair", "double count"]):
        signals.append("DUPLICATE_OR_RETRY_RISK_CONTEXT")

    if signals:
        add_note(parsed, "PAYMENT_SIGNAL", signals=unique_preserve_order(signals), source_id=source_id, evidence_id=evidence_id, context=context,
                 caution="Signals indicate analytical attention, not verified payment lifecycle or beneficiary identity.")

    domains = extract_domains(redacted)
    emails = extract_emails(redacted)
    if domains:
        add_note(parsed, "DOMAIN_MENTION", domains=domains[:20], source_id=source_id, evidence_id=evidence_id, context=context,
                 caution="Domain mention is not verified merchant/processor identity.")
    if emails:
        add_note(parsed, "EMAIL_MENTION", email_count=len(emails), source_id=source_id, evidence_id=evidence_id, context=context,
                 caution="Email mention is not verified payer/payee identity and is not stored raw in notes.")


def classify_json_payload(data: Any, filename: str = "") -> str:
    if isinstance(data, list):
        return "JSON_ARRAY"
    if not isinstance(data, dict):
        return "GENERIC_JSON"

    keys = {normalize_key(k) for k in data.keys()}
    low = json.dumps(data, ensure_ascii=False, default=str)[:30000].lower()
    fname = normalize_text(filename)

    if "settlement" in fname or "payout" in fname or "settlement" in keys:
        return "SETTLEMENT_BATCH_RECORD"
    if "refund" in fname or "reversal" in fname or "chargeback" in fname or "dispute" in fname:
        return "REFUND_REVERSAL_CHARGEBACK_DISPUTE_RECORD"
    if "invoice" in fname or "receipt" in fname or "invoice" in keys:
        return "INVOICE_OR_RECEIPT_RECORD"
    if "bank" in fname or "statement" in fname:
        return "BANK_STATEMENT_RECORD"
    if "processor" in fname or "gateway" in fname or "psp" in fname:
        return "PROCESSOR_OR_GATEWAY_RECORD"
    if "merchant" in fname or "transaction" in fname or "payment" in fname:
        return "TRANSACTION_OR_PAYMENT_RECORD"
    if "transaction" in keys or "payment" in keys or "amount" in keys:
        return "GENERIC_PAYMENT_RECORD"

    return "GENERIC_PAYMENT_EVIDENCE"


def walk_json(
    data: Any,
    source_id: str,
    evidence_id: str,
    parsed: Dict[str, Any],
    depth: int = 0,
    path: str = "",
) -> None:
    if depth > 14 or len(parsed.get("observations", [])) > 200000:
        return

    if isinstance(data, dict):
        process_json_record(data, source_id, evidence_id, parsed, context=path or "json")
        for k, v in data.items():
            new_path = f"{path}.{k}" if path else str(k)
            walk_json(v, source_id, evidence_id, parsed, depth + 1, new_path)
    elif isinstance(data, list):
        for item in data[:100000]:
            walk_json(item, source_id, evidence_id, parsed, depth + 1, path)
    elif isinstance(data, str):
        process_text_block(data, source_id, evidence_id, parsed, context=path or "json_string")


def process_json_file(path: Path, source_id: str, evidence_id: str) -> Tuple[str, Dict[str, Any]]:
    parsed = empty_parsed()
    raw = path.read_text(encoding="utf-8", errors="replace")[:30_000_000]
    redacted_raw, _ = redact_secrets(raw)
    fp = content_fingerprint(redacted_raw)
    data = json.loads(raw)
    kind = classify_json_payload(data, path.name)

    add_source(
        parsed,
        source_id,
        evidence_id,
        filename=path.name,
        file_hash=sha256_file(path),
        source_type=kind,
        content_fp=fp,
    )

    walk_json(data, source_id, evidence_id, parsed)
    return kind, parsed


def process_csv_file(path: Path, source_id: str, evidence_id: str) -> Tuple[str, Dict[str, Any]]:
    parsed = empty_parsed()
    raw = path.read_text(encoding="utf-8", errors="replace")[:30_000_000]
    redacted_raw, _ = redact_secrets(raw)
    fp = content_fingerprint(redacted_raw)
    kind = "CSV_PAYMENT_EVIDENCE"

    add_source(
        parsed,
        source_id,
        evidence_id,
        filename=path.name,
        file_hash=sha256_file(path),
        source_type=kind,
        content_fp=fp,
    )

    with path.open("r", encoding="utf-8", errors="replace", newline="") as f:
        sample = f.read(1_000_000)
        f.seek(0)
        try:
            dialect = csv.Sniffer().sniff(sample, delimiters=",;\t| ")
        except csv.Error:
            dialect = csv.excel

        reader = csv.DictReader(f, dialect=dialect)
        for idx, row in enumerate(reader):
            if idx >= 200000:
                break
            process_json_record(row, source_id, evidence_id, parsed, context=f"csv_row_{idx}")

    return kind, parsed


def process_text_file(path: Path, source_id: str, evidence_id: str) -> Tuple[str, Dict[str, Any]]:
    parsed = empty_parsed()
    raw = path.read_text(encoding="utf-8", errors="replace")[:10_000_000]
    redacted_raw, _ = redact_secrets(raw)
    fp = content_fingerprint(redacted_raw)

    low = redacted_raw.lower()[:30000]
    if "settlement" in low or "payout" in low:
        kind = "TEXT_SETTLEMENT_NOTE"
    elif "refund" in low or "chargeback" in low or "dispute" in low:
        kind = "TEXT_REFUND_DISPUTE_NOTE"
    elif "invoice" in low or "receipt" in low:
        kind = "TEXT_INVOICE_RECEIPT_NOTE"
    elif "bank statement" in low or "transaction" in low or "payment" in low:
        kind = "TEXT_TRANSACTION_NOTE"
    else:
        kind = "TEXT_PAYMENT_EVIDENCE_NOTE"

    add_source(
        parsed,
        source_id,
        evidence_id,
        filename=path.name,
        file_hash=sha256_file(path),
        source_type=kind,
        content_fp=fp,
    )

    for line_no, line in enumerate(raw.splitlines()[:200000]):
        if line.strip():
            process_text_block(line, source_id, evidence_id, parsed, context=f"text_line_{line_no}")

    return kind, parsed


def detect_format(path: Path) -> Dict[str, str]:
    suffix = path.suffix.lower()

    try:
        with path.open("rb") as f:
            head = f.read(256)
    except Exception as exc:
        return {"format_detected": "UNKNOWN", "mime_type": "application/octet-stream", "format_error": str(exc)}

    binary_suffixes = {
        ".exe", ".dll", ".sys", ".elf", ".so", ".dylib", ".bin", ".fw", ".img",
        ".iso", ".apk", ".jar", ".class", ".zip", ".gz", ".tar", ".7z", ".rar",
        ".pcap", ".pcapng", ".cap", ".msi", ".cab", ".pdf", ".docx", ".xlsx",
        ".pptx", ".mp3", ".wav", ".mp4", ".avi",
    }

    if suffix in binary_suffixes:
        return {"format_detected": "BINARY_ARTIFACT", "mime_type": "application/octet-stream"}

    stripped = head.lstrip()

    if suffix == ".json" or stripped.startswith(b"{") or stripped.startswith(b"["):
        return {"format_detected": "JSON", "mime_type": "application/json"}

    if suffix in {".csv", ".tsv"}:
        return {"format_detected": "CSV", "mime_type": "text/csv"}

    if b"," in head and b"\n" in head and all(b in b"\x09\x0a\x0d\x20" or 32 <= b <= 126 for b in head[:64]):
        return {"format_detected": "CSV", "mime_type": "text/csv"}

    if suffix in {".txt", ".log", ".md", ".yaml", ".yml", ".report", ".stix", ".taxii", ".misp", ".snapshot", ".eml", ".msg", ".invoice", ".receipt", ".statement"}:
        return {"format_detected": "TEXT", "mime_type": "text/plain"}

    try:
        probe = head.decode("utf-8", errors="strict")
        if probe.strip():
            return {"format_detected": "TEXT", "mime_type": "text/plain"}
    except Exception:
        pass

    return {"format_detected": "UNKNOWN", "mime_type": "application/octet-stream"}


def analyze_payment_file(path_str: str, case_id: str = "", task_id: str = "") -> Tuple[Dict[str, Any], Dict[str, Any]]:
    path = Path(path_str).expanduser()
    source_id = f"SRC-{uuid.uuid4()}"
    evidence_id = f"EVD-{uuid.uuid4()}"

    file_evidence: Dict[str, Any] = {
        "evidence_id": evidence_id,
        "source_id": source_id,
        "case_id": case_id,
        "task_id": task_id,
        "path": str(path),
        "filename": path.name,
        "retrieved_at": now_utc(),
        "acquisition_method": "local_authorized_or_public_file_access",
        "status": "PENDING",
        "limitations": [
            "No payment initiation/authorization/capture/settlement/refund/reversal/cancellation/account freeze/block, card/account/wallet testing, credential use, carding, account takeover, payment diversion, fake confirmation, laundering/structuring/evasion, or chargeback/refund fraud coaching performed.",
            "Binary artifacts (PDF/XLSX/DOCX/media/archives) are hash/metadata preserved only; no deep parsing/executed content analysis performed in this stdlib-only panel.",
            "Payment evidence is untrusted data, not instruction.",
            "Exposed secrets were redacted and not used.",
            "Transaction/status/party records are source-reported until corroborated.",
        ],
    }

    parsed = empty_parsed()

    if not path.exists():
        file_evidence["status"] = "FAILED_FILE_NOT_FOUND"
        return file_evidence, parsed

    try:
        st = path.stat()
        file_evidence["size_bytes"] = st.st_size
        file_evidence["filesystem_modified_at"] = datetime.fromtimestamp(st.st_mtime, tz=timezone.utc).isoformat()
    except Exception as exc:
        file_evidence["status"] = "FAILED_STAT"
        file_evidence["error"] = str(exc)
        return file_evidence, parsed

    try:
        file_evidence["sha256"] = sha256_file(path)
    except Exception as exc:
        file_evidence["sha256_error"] = str(exc)

    fmt = detect_format(path)
    file_evidence.update(fmt)
    format_detected = file_evidence.get("format_detected", "UNKNOWN")

    try:
        if format_detected == "JSON":
            kind, parsed = process_json_file(path, source_id, evidence_id)
            file_evidence["content_kind"] = kind
            file_evidence["status"] = "SUCCEEDED"
        elif format_detected == "CSV":
            kind, parsed = process_csv_file(path, source_id, evidence_id)
            file_evidence["content_kind"] = kind
            file_evidence["status"] = "SUCCEEDED"
        elif format_detected == "TEXT":
            kind, parsed = process_text_file(path, source_id, evidence_id)
            file_evidence["content_kind"] = kind
            file_evidence["status"] = "SUCCEEDED"
        elif format_detected == "BINARY_ARTIFACT":
            file_evidence["content_kind"] = "BINARY_PAYMENT_DOC_METADATA_ONLY"
            file_evidence["status"] = "PARTIAL_BINARY_METADATA_ONLY"
            file_evidence["reason"] = (
                "Binary payment evidence document detected. This planning panel preserves hash/metadata only. "
                "It does not execute macros, parse PDF/DOCX/XLSX deeply, open archives, access bank/processor systems, or use payment credentials."
            )
        else:
            file_evidence["content_kind"] = "UNKNOWN_OR_UNSUPPORTED"
            file_evidence["status"] = "UNSUPPORTED_FORMAT"
    except Exception as exc:
        file_evidence["status"] = "PARTIAL_OR_FAILED"
        file_evidence["error"] = f"{exc.__class__.__name__}: {exc}"

    file_evidence["parsed_party_count"] = len(parsed.get("parties", []))
    file_evidence["parsed_transaction_count"] = len(parsed.get("transactions", []))
    file_evidence["parsed_event_count"] = len(parsed.get("events", []))
    file_evidence["parsed_invoice_count"] = len(parsed.get("invoices", []))
    file_evidence["parsed_refund_count"] = len(parsed.get("refunds", []))
    file_evidence["parsed_settlement_count"] = len(parsed.get("settlements", []))

    return file_evidence, parsed


def aggregate_parsed(parsed_list: List[Dict[str, Any]]) -> Dict[str, Any]:
    agg = empty_parsed()
    for p in parsed_list:
        for key in agg.keys():
            if isinstance(agg[key], list) and isinstance(p.get(key), list):
                agg[key].extend(p[key])
        for key in agg.keys():
            if isinstance(agg[key], list):
                agg[key] = unique_preserve_order(agg[key])[:200000]
    return agg


def build_source_independence(parsed: Dict[str, Any]) -> None:
    sources = parsed.get("sources", [])
    hash_groups: Dict[str, List[str]] = defaultdict(list)
    fp_groups: Dict[str, List[str]] = defaultdict(list)
    publisher_groups: Dict[str, List[str]] = defaultdict(list)

    for s in sources:
        sid = s.get("source_id")
        fh = s.get("file_hash")
        fp = s.get("content_fingerprint")
        pub = normalize_text(s.get("publisher") or "")
        if fh:
            hash_groups[fh].append(sid)
        if fp:
            fp_groups[fp].append(sid)
        if pub:
            publisher_groups[pub].append(sid)

    for s in sources:
        fh = s.get("file_hash")
        fp = s.get("content_fingerprint")
        pub = normalize_text(s.get("publisher") or "")

        if fh and len(hash_groups.get(fh, [])) > 1:
            s["source_independence_state"] = "DEPENDENT_COPIES"
            s["source_family_count"] = 1
        elif fp and len(fp_groups.get(fp, [])) > 1:
            s["source_independence_state"] = "DEPENDENT_CONTENT_FAMILY"
            s["source_family_count"] = 1
        elif pub and len(publisher_groups.get(pub, [])) > 1:
            s["source_independence_state"] = "PARTIALLY_DEPENDENT_PENDING_REVIEW"
            s["source_family_count"] = 1
        elif len(sources) > 1:
            s["source_independence_state"] = "UNKNOWN_POTENTIALLY_INDEPENDENT"
            s["source_family_count"] = len(sources)
        else:
            s["source_independence_state"] = "SINGLE_SOURCE"
            s["source_family_count"] = 1


def party_by_id(parsed: Dict[str, Any]) -> Dict[str, Dict[str, Any]]:
    return {p.get("party_id"): p for p in parsed.get("parties", []) if p.get("party_id")}


def transaction_fingerprint(t: Dict[str, Any]) -> str:
    return sha256_text("|".join([
        str(t.get("external_transaction_id") or ""),
        str(t.get("amount_decimal") or ""),
        str(t.get("currency") or ""),
        str(t.get("authorization_time") or t.get("capture_time") or t.get("clearing_time") or t.get("settlement_time") or ""),
        str(t.get("references") or ""),
        str(t.get("payer_ref") or ""),
        str(t.get("payee_ref") or ""),
        str(t.get("merchant_ref") or ""),
        str(t.get("processor_ref") or ""),
    ]))


def deduplicate_transactions(parsed: Dict[str, Any]) -> None:
    transactions = parsed.get("transactions", [])
    clusters = []

    by_ext: Dict[str, List[Dict[str, Any]]] = defaultdict(list)
    by_fp: Dict[str, List[Dict[str, Any]]] = defaultdict(list)

    for t in transactions:
        ext = t.get("external_transaction_id")
        if ext:
            by_ext[ext].append(t)
        by_fp[transaction_fingerprint(t)].append(t)

    assigned = set()

    def mark_group(group: List[Dict[str, Any]], cluster_id: str, state: str) -> None:
        if len(group) <= 1:
            return
        sorted_group = sorted(
            group,
            key=lambda x: (
                STATUS_RANK.get(x.get("status_mapped", "UNKNOWN"), 0),
                str(x.get("settlement_time") or x.get("clearing_time") or x.get("capture_time") or x.get("authorization_time") or ""),
            ),
            reverse=True,
        )
        for idx, t in enumerate(sorted_group):
            t["duplicate_cluster_id"] = cluster_id
            t["duplicate_state"] = state
            t["is_representative"] = idx == 0
            assigned.add(t["transaction_record_id"])
        clusters.append({
            "cluster_id": cluster_id,
            "state": state,
            "transaction_record_ids": [t["transaction_record_id"] for t in group][:200],
            "representative_transaction_record_id": sorted_group[0]["transaction_record_id"],
            "limitations": [
                "Duplicate/probable duplicate/authorization-capture pair should not be double-counted as multiple payments.",
                "Amount/status conflicts require source semantics review before merging.",
            ],
        })

    for ext, group in by_ext.items():
        if len(group) > 1:
            amounts = {g.get("amount_decimal") for g in group if g.get("amount_decimal")}
            statuses = {g.get("status_mapped") for g in group if g.get("status_mapped")}
            lifecycle_only = statuses.issubset({"INITIATED", "AUTHORIZATION_REQUESTED", "AUTHORIZED", "CAPTURED", "CLEARED", "SETTLED"})
            if len(amounts) > 1:
                state = "UNKNOWN_AMOUNT_CONFLICT"
            elif lifecycle_only and len(statuses) > 1:
                state = "AUTHORIZATION_CAPTURE_PAIR"
            elif len(set(transaction_fingerprint(g) for g in group)) == 1:
                state = "EXACT_DUPLICATE"
            else:
                state = "PROBABLE_DUPLICATE"
            mark_group(group, f"CLU-{uuid.uuid4()}", state)

    for fp, group in by_fp.items():
        unassigned = [g for g in group if g["transaction_record_id"] not in assigned]
        if len(unassigned) > 1:
            mark_group(unassigned, f"CLU-{uuid.uuid4()}", "EXACT_DUPLICATE")

    for t in transactions:
        if t["transaction_record_id"] not in assigned:
            t["is_representative"] = True
            t["duplicate_state"] = "DISTINCT"

    parsed["dedup_clusters"] = clusters[:5000]


def calculate_net_financial_effect(parsed: Dict[str, Any]) -> None:
    by_currency: Dict[str, Dict[str, Any]] = defaultdict(lambda: {
        "attempted_or_failed": Decimal("0"),
        "authorized": Decimal("0"),
        "captured": Decimal("0"),
        "cleared": Decimal("0"),
        "settled": Decimal("0"),
        "refunded_txn": Decimal("0"),
        "reversed_txn": Decimal("0"),
        "chargeback_txn": Decimal("0"),
        "refund_records": Decimal("0"),
        "reversal_records": Decimal("0"),
        "chargeback_records": Decimal("0"),
        "fees": Decimal("0"),
        "transaction_count": 0,
    })

    for t in parsed.get("transactions", []):
        if not t.get("is_representative", True):
            continue
        amt = dec(t.get("amount_decimal"))
        cur = (t.get("currency") or "UNKNOWN").upper()
        status = t.get("status_mapped") or "UNKNOWN"
        bucket = by_currency[cur]
        bucket["transaction_count"] += 1

        if status in {"INITIATED", "DECLINED", "FAILED", "EXPIRED", "CANCELLED", "VOIDED"}:
            bucket["attempted_or_failed"] += amt
        if status == "AUTHORIZED":
            bucket["authorized"] += amt
        if status == "CAPTURED":
            bucket["captured"] += amt
        if status == "CLEARED":
            bucket["cleared"] += amt
        if status == "SETTLED":
            bucket["settled"] += amt
        if status == "REFUNDED":
            bucket["refunded_txn"] += amt
        if status == "REVERSED":
            bucket["reversed_txn"] += amt
        if status == "CHARGEDBACK":
            bucket["chargeback_txn"] += amt

    for f in parsed.get("fees", []):
        amt = dec(f.get("amount_decimal"))
        cur = (f.get("currency") or "UNKNOWN").upper()
        by_currency[cur]["fees"] += amt

    for r in parsed.get("refunds", []):
        amt = dec(r.get("amount_decimal"))
        cur = (r.get("currency") or "UNKNOWN").upper()
        by_currency[cur]["refund_records"] += amt

    for r in parsed.get("reversals", []):
        amt = dec(r.get("amount_decimal"))
        cur = (r.get("currency") or "UNKNOWN").upper()
        by_currency[cur]["reversal_records"] += amt

    for c in parsed.get("chargebacks", []):
        amt = dec(c.get("amount_decimal"))
        cur = (c.get("currency") or "UNKNOWN").upper()
        by_currency[cur]["chargeback_records"] += amt

    effects = []
    for cur, b in by_currency.items():
        refund_adj = b["refunded_txn"] if b["refunded_txn"] > 0 else b["refund_records"]
        reversal_adj = b["reversed_txn"] if b["reversed_txn"] > 0 else b["reversal_records"]
        chargeback_adj = b["chargeback_txn"] if b["chargeback_txn"] > 0 else b["chargeback_records"]

        net_candidate = b["settled"] - refund_adj - reversal_adj - chargeback_adj

        effects.append({
            "currency": cur,
            "attempted_or_failed_amount": str(b["attempted_or_failed"]),
            "authorized_amount": str(b["authorized"]),
            "captured_amount": str(b["captured"]),
            "cleared_amount": str(b["cleared"]),
            "settled_amount": str(b["settled"]),
            "refunded_amount": str(refund_adj),
            "reversed_amount": str(reversal_adj),
            "chargeback_amount": str(chargeback_adj),
            "fees_amount": str(b["fees"]),
            "net_financial_effect_candidate": str(net_candidate),
            "transaction_count": b["transaction_count"],
            "formula": "net_candidate = settled - refunded - reversed - chargeback; fees reported separately",
            "limitations": [
                "Net candidate uses representative deduplicated transactions and source-reported statuses.",
                "Gross transfer is not net loss; attempted payment is not realized loss.",
                "Refund/reversal/chargeback records and transaction statuses may describe the same adjustment; heuristic avoids obvious double counting but requires reconciliation.",
                "Fees, taxes, reserves, FX spreads, and split settlements are not silently netted unless evidenced.",
            ],
        })

    parsed["net_financial_effects"] = effects[:1000]


def reconcile_invoice_payment(parsed: Dict[str, Any]) -> None:
    results = []
    txn_by_ext = {t.get("external_transaction_id"): t for t in parsed.get("transactions", []) if t.get("external_transaction_id")}
    representatives = [t for t in parsed.get("transactions", []) if t.get("is_representative", True)]

    for inv in parsed.get("invoices", []):
        best = None
        best_score = 0
        reasons = []

        inv_amt = dec(inv.get("amount_decimal"))
        inv_cur = (inv.get("currency") or "").upper()
        inv_id = inv.get("invoice_id")
        inv_ref = inv.get("transaction_reference")

        for t in representatives:
            score = 0
            local_reasons = []

            if inv_ref and inv_ref == t.get("external_transaction_id"):
                score += 100
                local_reasons.append("explicit_transaction_reference_match")

            if inv_id and any(inv_id in str(r) for r in t.get("references", [])):
                score += 70
                local_reasons.append("invoice_id_in_transaction_reference")

            if inv_id and inv_id == t.get("invoice_reference"):
                score += 80
                local_reasons.append("invoice_reference_match")

            if dec(t.get("amount_decimal")) == inv_amt and inv_amt != 0:
                score += 40
                local_reasons.append("amount_match")

            if (t.get("currency") or "").upper() == inv_cur and inv_cur:
                score += 20
                local_reasons.append("currency_match")

            if t.get("merchant_ref") and t.get("merchant_ref") == inv.get("issuer_ref"):
                score += 30
                local_reasons.append("merchant_issuer_match")

            if score > best_score:
                best_score = score
                best = t
                reasons = local_reasons

        if best is None:
            state = "NO_MATCH"
        elif best_score >= 100:
            state = "EXACT_MATCH"
        elif best_score >= 70:
            state = "STRONG_MATCH"
        elif best_score >= 40:
            state = "PARTIAL_MATCH"
        else:
            state = "AMBIGUOUS"

        results.append({
            "reconciliation_id": f"REC-{uuid.uuid4()}",
            "invoice_record_id": inv.get("invoice_record_id"),
            "invoice_id": inv.get("invoice_id"),
            "transaction_record_id": best.get("transaction_record_id") if best else None,
            "external_transaction_id": best.get("external_transaction_id") if best else None,
            "match_state": state,
            "score": best_score,
            "reasons": reasons[:50],
            "amount_difference": str(dec(inv.get("amount_decimal")) - dec(best.get("amount_decimal") if best else 0)),
            "limitations": [
                "Invoice does not prove payment.",
                "Amount mismatch may be explained by fees, tax, partial payment, FX, credit note, discount, withholding, or multiple invoices.",
            ],
        })

    parsed["reconciliations"] = results[:5000]


def detect_anomalies(parsed: Dict[str, Any]) -> None:
    anomalies = []
    representatives = [t for t in parsed.get("transactions", []) if t.get("is_representative", True)]
    txn_by_ext = {t.get("external_transaction_id"): t for t in parsed.get("transactions", []) if t.get("external_transaction_id")}

    dup_groups: Dict[Tuple[Any, Any, Any, Any], List[Dict[str, Any]]] = defaultdict(list)
    for t in representatives:
        key = (
            t.get("payer_ref"),
            t.get("payee_ref") or t.get("merchant_ref"),
            t.get("amount_decimal"),
            t.get("currency"),
        )
        if all(key):
            dup_groups[key].append(t)

    for key, group in dup_groups.items():
        if len(group) > 1:
            anomalies.append({
                "anomaly_id": f"ANOM-{uuid.uuid4()}",
                "type": "DUPLICATE_PAYMENT_CANDIDATE",
                "state": "MATERIALLY_UNUSUAL",
                "subject": {
                    "payer_ref": key[0],
                    "payee_or_merchant_ref": key[1],
                    "amount": key[2],
                    "currency": key[3],
                },
                "transaction_record_ids": [t.get("transaction_record_id") for t in group][:100],
                "limitations": [
                    "Duplicate payment may be system retry, manual duplicate, processor duplication, partial fulfillment, accounting error, or fraud.",
                    "Anomaly is not fraud.",
                ],
            })

    for r in parsed.get("refunds", []):
        orig = txn_by_ext.get(r.get("original_transaction_ref"))
        if orig:
            orig_amt = dec(orig.get("amount_decimal"))
            refund_amt = dec(r.get("amount_decimal"))
            if refund_amt > orig_amt and orig_amt > 0:
                anomalies.append({
                    "anomaly_id": f"ANOM-{uuid.uuid4()}",
                    "type": "REFUND_EXCEEDS_ORIGINAL_CANDIDATE",
                    "state": "REVIEW_REQUIRED",
                    "subject": {
                        "refund_record_id": r.get("refund_record_id"),
                        "original_transaction_ref": r.get("original_transaction_ref"),
                        "original_amount": str(orig_amt),
                        "refund_amount": str(refund_amt),
                    },
                    "limitations": [
                        "May reflect multiple partial refunds, data error, currency mismatch, or separate adjustment.",
                        "Do not infer fraud automatically.",
                    ],
                })

    for t in representatives:
        if t.get("status_mapped") == "SETTLED" and not t.get("capture_time") and not any(
            e.get("transaction_ref") == t.get("external_transaction_id") and e.get("event_type") == "CAPTURED"
            for e in parsed.get("events", [])
        ):
            anomalies.append({
                "anomaly_id": f"ANOM-{uuid.uuid4()}",
                "type": "SETTLEMENT_WITHOUT_CAPTURE_EVIDENCE",
                "state": "UNUSUAL",
                "subject": {
                    "transaction_record_id": t.get("transaction_record_id"),
                    "external_transaction_id": t.get("external_transaction_id"),
                },
                "limitations": [
                    "Some rails/ledgers may not expose capture event separately.",
                    "Timing/source semantics may explain gap.",
                ],
            })

    for fx in parsed.get("fx_events", []):
        anomalies.append({
            "anomaly_id": f"ANOM-{uuid.uuid4()}",
            "type": "CROSS_BORDER_OR_FX_CONTEXT",
            "state": "EXPECTED_IF_RELEVANT",
            "subject": {
                "fx_event_id": fx.get("fx_event_id"),
                "source_currency": fx.get("source_currency"),
                "destination_currency": fx.get("destination_currency"),
            },
            "limitations": [
                "Cross-border/FX context is not automatically suspicious.",
                "Sanctions/legal interpretation requires SANCTIONSINT/LEGALINT.",
            ],
        })

    parsed["anomalies"] = unique_preserve_order(anomalies)[:5000]


def build_contradictions(parsed: Dict[str, Any]) -> List[Dict[str, Any]]:
    contradictions = []

    by_ext: Dict[str, List[Dict[str, Any]]] = defaultdict(list)
    for t in parsed.get("transactions", []):
        ext = t.get("external_transaction_id")
        if ext:
            by_ext[ext].append(t)

    for ext, group in by_ext.items():
        if len(group) > 1:
            amounts = {g.get("amount_decimal") for g in group if g.get("amount_decimal")}
            statuses = {g.get("status_mapped") for g in group if g.get("status_mapped")}
            currencies = {g.get("currency") for g in group if g.get("currency")}
            if len(amounts) > 1 or len(currencies) > 1 or len(statuses) > 1:
                contradictions.append({
                    "contradiction_id": f"CON-{uuid.uuid4()}",
                    "type": "TRANSACTION_RECORD_CONFLICT",
                    "subject": ext,
                    "values": {
                        "amounts": list(amounts)[:20],
                        "currencies": list(currencies)[:20],
                        "statuses": list(statuses)[:20],
                    },
                    "possible_explanations": [
                        "Authorization/settlement pair",
                        "Partial capture/refund",
                        "Processor transformation",
                        "Duplicate ledger copy",
                        "Different source status semantics",
                        "Timezone/batching difference",
                    ],
                    "resolution_status": "UNRESOLVED",
                    "caution": "Do not silently pick one status or double-count lifecycle records.",
                })

    for rec in parsed.get("reconciliations", []):
        if rec.get("match_state") in {"PARTIAL_MATCH", "AMBIGUOUS"} and rec.get("amount_difference") not in (None, "0", "0E-8"):
            contradictions.append({
                "contradiction_id": f"CON-{uuid.uuid4()}",
                "type": "INVOICE_PAYMENT_AMOUNT_MISMATCH",
                "subject": {
                    "invoice_record_id": rec.get("invoice_record_id"),
                    "transaction_record_id": rec.get("transaction_record_id"),
                },
                "values": {"amount_difference": rec.get("amount_difference")},
                "possible_explanations": [
                    "Fees",
                    "Tax",
                    "Partial payment",
                    "FX",
                    "Credit note",
                    "Discount",
                    "Withholding",
                    "Multiple invoices",
                ],
                "resolution_status": "UNRESOLVED",
                "caution": "Do not label fraud immediately.",
            })

    contradictions, _ = truncate_list(contradictions, 5000)
    return contradictions


def build_hypotheses(parsed: Dict[str, Any]) -> List[Dict[str, Any]]:
    hyps = []
    parties = parsed.get("parties", [])
    transactions = parsed.get("transactions", [])
    events = parsed.get("events", [])
    settlements = parsed.get("settlements", [])
    refunds = parsed.get("refunds", [])
    reversals = parsed.get("reversals", [])
    chargebacks = parsed.get("chargebacks", [])
    contradictions = parsed.get("contradictions", [])
    anomalies = parsed.get("anomalies", [])

    if not parties and not transactions and not events:
        hyps.append({
            "hypothesis_id": f"HYP-{uuid.uuid4()}",
            "statement": "Current local deterministic evidence is insufficient to reconstruct payment lifecycle, parties, settlement, refunds, or net financial effect.",
            "supporting_facts": ["No payment party/transaction/event records parsed."],
            "opposing_facts": [],
            "assumptions": ["Evidence may be missing, binary-only, unsupported, unauthorized, or unavailable."],
            "unknowns": ["payer", "payee", "merchant", "processor", "authorization", "capture", "settlement", "refund", "net effect"],
            "falsification_conditions": ["New authorized payment evidence changes assessment."],
            "next_test": "Attach bank statement, processor export, merchant export, settlement report, invoice, refund/reversal/chargeback/dispute record.",
            "status": "OPEN",
        })
        return hyps[:1000]

    if contradictions:
        hyps.append({
            "hypothesis_id": f"HYP-{uuid.uuid4()}",
            "statement": "Multiple records may describe stages/copies of the same payment rather than distinct payments.",
            "supporting_facts": [f"{len(contradictions)} transaction/invoice conflict(s) detected."],
            "opposing_facts": ["Records may genuinely represent separate payments or adjustments."],
            "unknowns": ["source semantics", "authorization vs settlement", "partial capture", "batching", "timezone"],
            "falsification_conditions": ["Primary processor/bank records show distinct transaction IDs and settlement events."],
            "next_test": "Reconcile external transaction IDs, authorization/capture/settlement timestamps, and source pedigree.",
            "status": "OPEN",
        })

    if settlements:
        hyps.append({
            "hypothesis_id": f"HYP-{uuid.uuid4}()",
            "statement": "Settlement batch may aggregate multiple transactions; individual payment settlement may not be directly visible.",
            "supporting_facts": [f"{len(settlements)} settlement batch record(s) parsed."],
            "opposing_facts": ["Some settlement reports may be transaction-level."],
            "unknowns": ["batch composition", "fees", "reserves", "refunds", "chargebacks", "recipient legal entity"],
            "falsification_conditions": ["Transaction-level settlement evidence maps each payment explicitly."],
            "next_test": "Match settlement batch transaction IDs to captured/settled transactions and reconcile gross/fees/net.",
            "status": "OPEN",
        })

    if refunds or reversals or chargebacks:
        hyps.append({
            "hypothesis_id": f"HYP-{uuid.uuid4()}",
            "statement": "Apparent payment may be reduced or negated by refund, reversal, void, or chargeback.",
            "supporting_facts": [f"{len(refunds)} refund(s), {len(reversals)} reversal(s), {len(chargebacks)} chargeback(s)."],
            "opposing_facts": ["Adjustments may be pending, failed, partial, or unrelated."],
            "unknowns": ["settled recovery status", "original transaction linkage", "partial vs full", "dispute outcome"],
            "falsification_conditions": ["Adjustment records are pending/failed or linked to different transactions."],
            "next_test": "Verify refund/reversal/chargeback settlement status and original transaction linkage.",
            "status": "OPEN",
        })

    if anomalies:
        hyps.append({
            "hypothesis_id": f"HYP-{uuid.uuid4()}",
            "statement": "Payment anomalies may reflect technical/accounting patterns rather than fraud.",
            "supporting_facts": [f"{len(anomalies)} anomaly candidate(s) detected."],
            "opposing_facts": ["Some anomalies may merit fraud review."],
            "unknowns": ["baseline", "retry logic", "processor behavior", "beneficiary change context"],
            "falsification_conditions": ["Authorized logs/processor records explain anomaly as normal operation."],
            "next_test": "Compare against same account/merchant/customer/vendor/rail baseline and handoff fraud interpretation to FRAUDINT if needed.",
            "status": "OPEN",
        })

    hyps, _ = truncate_list(hyps, 1000)
    return hyps


def build_knowledge_gaps(payload: Dict[str, Any], files: List[Dict[str, Any]], parsed: Dict[str, Any]) -> List[Dict[str, Any]]:
    gaps = []
    parties = parsed.get("parties", [])
    transactions = parsed.get("transactions", [])
    events = parsed.get("events", [])
    settlements = parsed.get("settlements", [])
    invoices = parsed.get("invoices", [])
    refunds = parsed.get("refunds", [])
    net_effects = parsed.get("net_financial_effects", [])

    if not files:
        gaps.append({
            "gap_id": f"GAP-{uuid.uuid4()}",
            "question": "What lawful/authorized payment evidence exists?",
            "missing_evidence": "No local PAYMENTINT artifact supplied.",
            "likely_source": "Bank statement, processor export, merchant export, settlement report, invoice, refund/reversal/chargeback/dispute record.",
            "specialist_owner": "PAYMENTINT AI Employee",
            "priority": "HIGH",
            "expected_information_value": "Enables baseline payment reconstruction planning.",
            "safety_boundary": "No payment movement, credential use, card/account testing, laundering, or evasion guidance.",
        })

    if not parties:
        gaps.append({
            "gap_id": f"GAP-{uuid.uuid4()}",
            "question": "Which payers, payees, merchants, processors, banks, accounts, or instruments are involved?",
            "missing_evidence": "No party records parsed.",
            "likely_source": "Transaction metadata, bank statement, processor export, merchant descriptor, invoice.",
            "specialist_owner": "PAYMENTINT / CORPINT",
            "priority": "HIGH",
            "expected_information_value": "Establishes payment party candidates without beneficiary attribution.",
            "safety_boundary": "Do not invent payers, payees, merchants, or beneficiaries.",
        })

    if parties and not transactions:
        gaps.append({
            "gap_id": f"GAP-{uuid.uuid4()}",
            "question": "What actual payment events occurred?",
            "missing_evidence": "Transaction records missing.",
            "likely_source": "Primary bank/processor/merchant transaction export.",
            "specialist_owner": "PAYMENTINT / FININT",
            "priority": "HIGH",
            "expected_information_value": "Converts party list into transaction evidence.",
            "safety_boundary": "Invoice/receipt/screenshot is not primary payment evidence.",
        })

    if transactions and not events:
        gaps.append({
            "gap_id": f"GAP-{uuid.uuid4()}",
            "question": "What authorization/capture/clearing/settlement lifecycle stages are evidenced?",
            "missing_evidence": "Payment event records missing.",
            "likely_source": "Processor lifecycle logs, bank posting records, settlement reports.",
            "specialist_owner": "PAYMENTINT",
            "priority": "HIGH",
            "expected_information_value": "Separates authorization from capture and settlement.",
            "safety_boundary": "Authorized is not captured; captured is not settled.",
        })

    if transactions and not settlements:
        gaps.append({
            "gap_id": f"GAP-{uuid.uuid4()}",
            "question": "Did captured/authorized amounts settle, and to which settlement account/entity?",
            "missing_evidence": "Settlement evidence missing.",
            "likely_source": "Settlement batch report, bank credit, merchant payout, PSP payout.",
            "specialist_owner": "PAYMENTINT / FININT",
            "priority": "HIGH",
            "expected_information_value": "Supports beneficiary/settlement resolution.",
            "safety_boundary": "Payee is not automatically ultimate beneficiary.",
        })

    if invoices and not any(r.get("match_state") in {"EXACT_MATCH", "STRONG_MATCH"} for r in parsed.get("reconciliations", [])):
        gaps.append({
            "gap_id": f"GAP-{uuid.uuid4()}",
            "question": "Which invoices are actually paid, partially paid, overpaid, or unmatched?",
            "missing_evidence": "Invoice-payment reconciliation incomplete.",
            "likely_source": "ERP/accounting records, processor references, bank statement memos.",
            "specialist_owner": "PAYMENTINT / PROCUREMENTINT",
            "priority": "MEDIUM_HIGH",
            "expected_information_value": "Separates invoice request from payment evidence.",
            "safety_boundary": "Invoice is not payment.",
        })

    if refunds and not net_effects:
        gaps.append({
            "gap_id": f"GAP-{uuid.uuid4()}",
            "question": "What is net financial effect after refunds/reversals/chargebacks?",
            "missing_evidence": "Net effect inputs incomplete.",
            "likely_source": "Settled refund records, reversal records, chargeback decisions.",
            "specialist_owner": "PAYMENTINT / FININT",
            "priority": "HIGH",
            "expected_information_value": "Prevents gross-transfer overstatement.",
            "safety_boundary": "Claimed/gross amount is not verified net loss.",
        })

    gaps, _ = truncate_list(gaps, 500)
    return gaps


def build_specialist_handoffs(parsed: Dict[str, Any]) -> List[Dict[str, Any]]:
    handoffs = []
    parties = parsed.get("parties", [])
    transactions = parsed.get("transactions", [])
    invoices = parsed.get("invoices", [])
    refunds = parsed.get("refunds", [])
    chargebacks = parsed.get("chargebacks", [])
    disputes = parsed.get("disputes", [])
    fx_events = parsed.get("fx_events", [])
    notes = parsed.get("notes", [])
    anomalies = parsed.get("anomalies", [])

    if any(p.get("party_type") in {"MERCHANT", "PAYEE", "BENEFICIARY_CANDIDATE", "SETTLEMENT_ENTITY", "PROCESSOR", "BANK"} for p in parties):
        handoffs.append({
            "specialist": "CORPINT / OWNERSHIPINT",
            "reason": "Legal entity/ownership resolution may be needed for merchant/payee/settlement entity.",
            "expected_output": "Legal entity resolution, parent/subsidiary context, beneficiary ownership separation.",
            "question": "Is the recorded payee/settlement account tied to the claimed merchant or an intermediary/processor?",
        })

    if transactions or invoices:
        handoffs.append({
            "specialist": "FININT",
            "reason": "Payment transactions/invoices detected.",
            "expected_output": "Broader money-flow context, account relationships, financial pattern analysis.",
            "question": "How do these payment events fit broader financial flows?",
        })

    if any(n.get("type") == "SECRET_REDACTION" for n in notes):
        handoffs.append({
            "specialist": "CREDINT",
            "reason": "Secret-like payment material was detected and redacted.",
            "expected_output": "Authorized credential/token rotation and exposure assessment.",
            "question": "Are exposed payment credentials/tokens rotated through authorized workflow without using them?",
        })

    if disputes or chargebacks:
        handoffs.append({
            "specialist": "FRAUDINT / LEGALINT",
            "reason": "Dispute/chargeback context detected.",
            "expected_output": "Fraud interpretation, dispute evidence, legal/compliance review.",
            "question": "Does dispute/chargeback context support fraud hypothesis or benign dispute?",
        })

    if anomalies:
        handoffs.append({
            "specialist": "FRAUDINT",
            "reason": "Payment anomaly candidates detected.",
            "expected_output": "Fraud/non-fraud interpretation with benign explanations.",
            "question": "Are anomalies explained by technical/accounting behavior or do they support fraud review?",
        })

    if fx_events:
        handoffs.append({
            "specialist": "SANCTIONSINT / LEGALINT / FININT",
            "reason": "Cross-border/FX context detected.",
            "expected_output": "Jurisdictional/sanctions/legal interpretation, FX rate context.",
            "question": "Does cross-border payment context trigger sanctions/export-control/legal review?",
        })

    if invoices:
        handoffs.append({
            "specialist": "PROCUREMENTINT / DOCINT",
            "reason": "Invoice/document context detected.",
            "expected_output": "Procurement match, document authenticity, purchase-to-pay reconciliation.",
            "question": "Do invoices/orders/receipts reconcile to actual payment and delivery evidence?",
        })

    if refunds:
        handoffs.append({
            "specialist": "FININT / PAYMENT OPERATIONS",
            "reason": "Refund records detected.",
            "expected_output": "Refund settlement status, recovery tracking, double-count prevention.",
            "question": "Which refunds are promised, initiated, settled, failed, or already reflected in transaction status?",
        })

    if not handoffs:
        handoffs.append({
            "specialist": "PAYMENTINT Manager",
            "reason": "No immediate specialist trigger detected from current local deterministic evidence alone.",
            "expected_output": "Review scope, approve authorized connectors, assign transaction/settlement collection tasks.",
            "question": "What payment-intelligence gap should be filled next?",
        })

    return handoffs


def finalize_parsed(parsed: Dict[str, Any], payload: Optional[Dict[str, Any]] = None, files: Optional[List[Dict[str, Any]]] = None) -> Dict[str, Any]:
    payload = payload or {}
    build_source_independence(parsed)
    deduplicate_transactions(parsed)
    calculate_net_financial_effect(parsed)
    reconcile_invoice_payment(parsed)
    detect_anomalies(parsed)
    parsed["contradictions"] = build_contradictions(parsed)
    parsed["hypotheses"] = build_hypotheses(parsed)
    parsed["knowledge_gaps"] = build_knowledge_gaps(payload, files or [], parsed)
    parsed["specialist_handoffs"] = build_specialist_handoffs(parsed)
    return parsed


def build_next_best_action(
    payload: Dict[str, Any],
    policy: Dict[str, Any],
    files: List[Dict[str, Any]],
    parsed: Dict[str, Any],
) -> Dict[str, str]:
    parties = parsed.get("parties", [])
    transactions = parsed.get("transactions", [])
    events = parsed.get("events", [])
    settlements = parsed.get("settlements", [])
    invoices = parsed.get("invoices", [])
    refunds = parsed.get("refunds", [])
    net_effects = parsed.get("net_financial_effects", [])
    anomalies = parsed.get("anomalies", [])

    if policy.get("status") == "POLICY_BLOCKED":
        return {
            "action": "Revise task to remove prohibited payment initiation/authorization/capture/settlement/refund/reversal, account testing, credential use, carding, diversion, laundering/structuring/evasion, or fraud-coaching behavior.",
            "reason": "PAYMENTINT is defensive payment evidence intelligence, not payment execution or abuse.",
            "owner": "PAYMENTINT Manager",
            "expected_output": "Policy-compliant defensive payment-review scope and question set.",
        }

    if policy.get("status") == "HUMAN_REVIEW_REQUIRED":
        return {
            "action": "Route to human payment/finance/legal/compliance reviewer before account blocking, fund recovery, refund/reversal execution, fraud allegation, AML/sanctions escalation, or consequential beneficiary attribution.",
            "reason": "Payment findings can be financially and legally consequential.",
            "owner": "PAYMENTINT Manager",
            "expected_output": "Approved defensive verification plan, evidence gaps, and handoffs.",
        }

    if not files:
        return {
            "action": "Attach lawful/authorized bank statement, processor export, merchant export, settlement report, invoice, refund/reversal/chargeback/dispute record before analysis.",
            "reason": "No PAYMENTINT evidence artifact is available for local deterministic analysis.",
            "owner": "PAYMENTINT AI Employee",
            "expected_output": "Payment evidence inventory with hashes and provenance.",
        }

    if not parties:
        return {
            "action": "Resolve payer/payee/merchant/processor/bank/account parties from transaction metadata, bank statement, processor export, or invoice.",
            "reason": "Party resolution is prerequisite to payment trail reconstruction.",
            "owner": "PAYMENTINT / CORPINT",
            "expected_output": "Canonical payment party candidates.",
        }

    if parties and not transactions:
        return {
            "action": "Retrieve primary transaction records from authorized bank/processor/merchant systems.",
            "reason": "Party list alone does not prove payment events.",
            "owner": "PAYMENTINT / FININT",
            "expected_output": "Normalized transaction objects.",
        }

    if transactions and not events:
        return {
            "action": "Retrieve authorization/capture/clearing/settlement lifecycle events from processor/bank records.",
            "reason": "Payment lifecycle stages must be separated.",
            "owner": "PAYMENTINT",
            "expected_output": "Lifecycle event graph.",
        }

    if transactions and not settlements:
        return {
            "action": "Retrieve settlement batch/payout records and reconcile gross/fees/net to transactions.",
            "reason": "Settlement evidence is needed for beneficiary/net effect analysis.",
            "owner": "PAYMENTINT / FININT",
            "expected_output": "Settlement reconciliation register.",
        }

    if invoices and not any(r.get("match_state") in {"EXACT_MATCH", "STRONG_MATCH"} for r in parsed.get("reconciliations", [])):
        return {
            "action": "Improve invoice-payment matching using transaction references, ERP/accounting records, and amount/currency/merchant context.",
            "reason": "Invoice is not payment.",
            "owner": "PAYMENTINT / PROCUREMENTINT",
            "expected_output": "Invoice payment reconciliation states.",
        }

    if refunds and not net_effects:
        return {
            "action": "Complete refund/reversal/chargeback settlement status inputs and recalculate net financial effect deterministically.",
            "reason": "Gross transfer is not net loss.",
            "owner": "PAYMENTINT / FININT",
            "expected_output": "Transparent net financial effect model.",
        }

    if anomalies:
        return {
            "action": "Baseline anomalies against same account/merchant/customer/vendor/rail and handoff fraud interpretation to FRAUDINT only if evidence warrants.",
            "reason": "Payment anomaly is not fraud.",
            "owner": "PAYMENTINT / FRAUDINT",
            "expected_output": "Anomaly disposition and benign explanations.",
        }

    return {
        "action": "Proceed with payment trail reconstruction, beneficiary attribution ladder, source pedigree/independence validation, and defensible payment report.",
        "reason": "Local evidence exists, but settlement/beneficiary/net effect remain source-reported until corroborated.",
        "owner": "PAYMENTINT / FININT / CORPINT / FRAUDINT as authorized",
        "expected_output": "Evidence-linked payment intelligence report with limitations and next actions.",
    }


def build_collection_plan(
    payload: Dict[str, Any],
    questions: List[Any],
    files: List[Dict[str, Any]],
    parsed: Dict[str, Any],
) -> List[Dict[str, Any]]:
    plan = []
    priority = 1
    questions_limited, _ = truncate_list([str(q) for q in questions], 8)

    has_files = bool(files)
    has_parties = bool(parsed.get("parties"))
    has_txns = bool(parsed.get("transactions"))
    has_events = bool(parsed.get("events"))
    has_settlements = bool(parsed.get("settlements"))
    has_invoices = bool(parsed.get("invoices"))
    has_refunds = bool(parsed.get("refunds") or parsed.get("reversals") or parsed.get("chargebacks"))
    has_net = bool(parsed.get("net_financial_effects"))

    def add(
        operation: str,
        tool: str,
        purpose: str,
        status: str,
        expected_output: str,
        safety_risk: str = "LOW",
        policy_note: str = "Defensive / authorized / evidence-first / privacy-aware payment intelligence only.",
    ) -> None:
        nonlocal priority
        plan.append({
            "question": questions_limited[0] if questions_limited else "General PAYMENTINT planning",
            "operation": operation,
            "tool_or_provider": tool,
            "purpose": purpose,
            "status": status,
            "expected_output": expected_output,
            "priority": priority,
            "safety_risk": safety_risk,
            "policy_note": policy_note,
            "authorization_status": "ALLOWED_DEFENSIVE_AUTHORIZED",
            "execution_status": "NOT_EXECUTED_PLANNING_ONLY",
        })
        priority += 1

    add(
        "define_payment_questions_scope",
        "PAYMENTINT Manager / PAYMENTINT AI Employee",
        "Convert objective into payment questions, allowed sources, privacy boundaries, and safety boundaries.",
        "COMPLETED_LOCAL" if payload.get("questions") else "REQUIRED_BEFORE_COLLECTION",
        "Requirement-driven defensive payment collection plan.",
        policy_note="No payment movement, credential use, card/account testing, laundering, or evasion guidance.",
    )

    add(
        "preserve_original_payment_evidence",
        "local evidence store",
        "Store original bank statements, processor exports, merchant exports, settlement reports, invoices, and hashes without modifying originals.",
        "COMPLETED_LOCAL" if has_files else "PLANNED_REQUIRES_EVIDENCE",
        "PaymentEvidenceObject with SHA256 and provenance fields.",
    )

    add(
        "safe_parse_json_csv_text_payment_metadata",
        "local deterministic parser",
        "Parse lawful/authorized/public JSON/CSV/TXT payment metadata without executing attachments/scripts/macros or accessing bank/processor systems.",
        "COMPLETED_LOCAL" if has_files else "PLANNED_REQUIRES_EVIDENCE",
        "Normalized parties, transactions, events, fees, FX, invoices, refunds, reversals, chargebacks, disputes, and settlements.",
        safety_risk="HIGH_IF_UNTRUSTED_CONTENT_TREATED_AS_INSTRUCTION",
        policy_note="Payment evidence is untrusted data.",
    )

    add(
        "payment_party_resolution",
        "local resolver",
        "Resolve payer/payee/merchant/processor/gateway/bank/account/instrument/wallet candidates while avoiding false beneficiary attribution.",
        "COMPLETED_LOCAL" if has_parties else "PLANNED_REQUIRES_PARTY_EVIDENCE",
        "Canonical payment party candidates.",
        safety_risk="HIGH_PRIVACY_SENSITIVE",
        policy_note="Payer != account holder; payee != beneficiary; merchant != processor.",
    )

    add(
        "transaction_identity_deduplication",
        "local deterministic matcher",
        "Deduplicate bank/processor/merchant/gateway/ledger copies and authorization/capture/settlement pairs.",
        "COMPLETED_LOCAL" if has_txns else "PLANNED_REQUIRES_TRANSACTION_EVIDENCE",
        "Representative transaction set and duplicate clusters.",
        safety_risk="HIGH_IF_DOUBLE_COUNTED",
        policy_note="Multiple lifecycle records are not multiple payments.",
    )

    add(
        "payment_lifecycle_event_reconstruction",
        "local event builder",
        "Separate initiation, authorization, capture, clearing, settlement, decline, failure, reversal, refund, dispute, and chargeback events.",
        "COMPLETED_LOCAL" if has_events else "PLANNED_REQUIRES_EVENT_EVIDENCE",
        "Temporal payment event graph.",
        safety_risk="HIGH_IF_AUTHORIZATION_TAKEN_AS_SETTLEMENT",
        policy_note="Authorized != captured; captured != settled; settled != irreversible.",
    )

    add(
        "fee_fx_net_financial_effect",
        "local deterministic finance engine",
        "Calculate fees, FX context, refunds, reversals, chargebacks, and net financial effect candidates without LLM arithmetic.",
        "COMPLETED_LOCAL" if has_net else "PLANNED_REQUIRES_FINANCIAL_EVIDENCE",
        "Transparent net financial effect model by currency.",
        safety_risk="HIGH_IF_GROSS_TAKEN_AS_NET",
        policy_note="Gross transfer is not net loss.",
    )

    add(
        "invoice_payment_settlement_reconciliation",
        "local matcher + PAYMENTINT Analyst",
        "Reconcile invoice/order/receipt to authorization/capture/settlement and identify partial/over/under payment.",
        "COMPLETED_LOCAL" if has_invoices or has_settlements else "PLANNED_ANALYTIC",
        "Reconciliation states and mismatches.",
        safety_risk="MEDIUM_IF_INVOICE_TAKEN_AS_PAYMENT",
        policy_note="Invoice is not payment; receipt is not bank settlement.",
    )

    add(
        "anomaly_baseline_and_fraud_handoff",
        "PAYMENTINT / FRAUDINT",
        "Detect payment anomalies, compare relevant baselines, and hand off fraud interpretation without asserting fraud.",
        "COMPLETED_LOCAL" if parsed.get("anomalies") else "PLANNED_ANALYTIC",
        "Anomaly register and defensive handoff.",
        safety_risk="HIGH_IF_ANOMALY_CALLED_FRAUD",
        policy_note="Anomaly is not fraud.",
    )

    return plan


def policy_screen(payload: Dict[str, Any]) -> Dict[str, Any]:
    scanned_fields = [
        "objective",
        "target",
        "questions",
        "payers",
        "payees",
        "beneficiaries",
        "merchants",
        "banks",
        "issuers",
        "acquirers",
        "processors",
        "gateways",
        "payment_service_providers",
        "payment_facilitators",
        "aggregators",
        "intermediary_banks",
        "settlement_entities",
        "accounts",
        "payment_instruments",
        "wallets",
        "transactions",
        "transaction_references",
        "invoices",
        "receipts",
        "refunds",
        "reversals",
        "chargebacks",
        "disputes",
        "settlement_reports",
    ]

    parts: List[str] = []
    for key in scanned_fields:
        val = payload.get(key)
        if isinstance(val, list):
            parts.extend(str(x) for x in val)
        elif isinstance(val, dict):
            parts.append(json.dumps(val, ensure_ascii=False, default=str))
        else:
            parts.append(str(val or ""))

    scanned = " \n ".join(parts).lower()

    blocked_reasons: List[str] = []
    for pat in POLICY_BLOCK_PATTERNS:
        rx = re.compile(pat, re.I)
        for m in rx.finditer(scanned):
            start = max(0, m.start() - 180)
            prefix = scanned[start:m.start()]
            if NEGATION_RE.search(prefix):
                continue
            blocked_reasons.append(pat)
            break

    human_review_required = False
    safety_notes: List[str] = []

    if payload.get("target_type") in SENSITIVE_TARGET_TYPES:
        human_review_required = True
        safety_notes.append(
            "Sensitive payment/transaction context detected. Analysis must remain defensive, authorized, evidence-first, and privacy-aware. "
            "No payment movement, credential use, card/account testing, laundering, structuring, evasion, or fraud coaching."
        )

    if payload.get("accounts") or payload.get("payment_instruments") or payload.get("wallets"):
        human_review_required = True
        safety_notes.append(
            "Account/instrument/wallet context detected. Apply masking/minimization and never use exposed payment credentials."
        )

    if payload.get("refunds") or payload.get("reversals") or payload.get("chargebacks") or payload.get("disputes"):
        human_review_required = True
        safety_notes.append(
            "Refund/reversal/chargeback/dispute context detected. Do not execute refunds/reversals or infer fraud from dispute/chargeback alone."
        )

    if payload.get("settlement_reports") or payload.get("processors") or payload.get("payment_facilitators") or payload.get("aggregators"):
        human_review_required = True
        safety_notes.append(
            "Settlement/processor/payfac/aggregator context detected. Separate processor/aggregator/intermediary from ultimate beneficiary."
        )

    if blocked_reasons:
        return {
            "status": "POLICY_BLOCKED",
            "reasons": sorted(set(blocked_reasons)),
            "human_review_required": True,
            "safety_notes": safety_notes,
            "explanation": (
                "The requested task appears to require initiating/moving/authorizing/capturing/settling/refunding/reversing payments, testing cards/accounts/wallets, "
                "using payment credentials, carding, account takeover, payment diversion, fake confirmations, laundering/structuring/evasion, or coaching refund/chargeback fraud."
            ),
            "safe_alternatives": SAFE_ALTERNATIVES,
        }

    if human_review_required:
        return {
            "status": "HUMAN_REVIEW_REQUIRED",
            "reasons": [],
            "human_review_required": True,
            "safety_notes": safety_notes,
            "explanation": (
                "No obvious hard policy violation detected, but sensitive payment/account/settlement/refund/dispute context applies. "
                "Conclusions must remain defensive, evidence-linked, privacy-aware, and human-reviewed before consequential financial/legal action."
            ),
            "safe_alternatives": SAFE_ALTERNATIVES,
        }

    return {
        "status": "ALLOWED_DEFENSIVE_AUTHORIZED",
        "reasons": [],
        "human_review_required": False,
        "safety_notes": [],
        "explanation": (
            "No obvious policy violation detected. Execution remains planning-only unless authorized/public/lawful payment evidence or connectors are configured."
        ),
        "safe_alternatives": [],
    }


def validate_payload(payload: Dict[str, Any]) -> List[str]:
    warnings: List[str] = []

    required = ["case_id", "task_id", "objective", "target", "target_type"]
    for field in required:
        if not payload.get(field):
            warnings.append(f"Missing required field: {field}")

    if not payload.get("questions"):
        warnings.append("No PAYMENTINT questions provided. Default questions will be inferred.")

    evidence_keys = [
        "payers",
        "payees",
        "merchants",
        "processors",
        "accounts",
        "payment_instruments",
        "wallets",
        "transactions",
        "invoices",
        "receipts",
        "refunds",
        "reversals",
        "chargebacks",
        "disputes",
        "settlement_reports",
        "transaction_paths",
        "bank_statement_paths",
        "processor_export_paths",
        "merchant_export_paths",
        "invoice_paths",
        "settlement_paths",
        "dispute_paths",
    ]

    if not any(payload.get(k) for k in evidence_keys):
        warnings.append("No payment evidence provided. Output remains planning-only.")

    if not payload.get("time_range"):
        warnings.append("No time range provided. Payment lifecycle, settlement batching, refunds, and disputes are highly temporal.")

    if not payload.get("configured_connectors"):
        warnings.append("No bank/processor/merchant/ledger/settlement connector configured. External correlation remains planning-only.")

    if payload.get("payment_instruments") or payload.get("accounts") or payload.get("wallets"):
        warnings.append("Account/instrument/wallet context triggers masking/minimization controls. Do not use exposed payment credentials.")

    if payload.get("refunds") or payload.get("reversals") or payload.get("chargebacks"):
        warnings.append("Refund/reversal/chargeback context triggers deterministic net-effect controls. Do not execute adjustments autonomously.")

    return warnings


def default_questions(payload: Dict[str, Any]) -> List[str]:
    return [
        "What payment event occurred, and which records refer to the same transaction?",
        "Who was payer, payee, merchant, processor, gateway, issuer, acquirer, and settlement entity?",
        "Which party is account holder versus actual operator, if evidenced?",
        "Was the payment initiated, authorized, captured, cleared, settled, declined, failed, reversed, refunded, disputed, or charged back?",
        "What amount, currency, fees, and FX events are evidenced?",
        "What is gross settled amount and net financial effect candidate after refunds/reversals/chargebacks?",
        "Which invoices/orders/receipts match payments, partially match, or remain unmatched?",
        "Which payee/settlement account is ultimate beneficiary candidate, and what evidence supports or limits that?",
        "Which sources are independent versus downstream copies of the same processor/bank event?",
        "What payment anomalies exist, and what benign explanations remain?",
        "What fraud-context handoff is warranted without asserting fraud from payment facts alone?",
        "What defensive next action obtains authoritative payment evidence without moving money or testing instruments?",
    ]


class TraceAtlasPAYMENTINTPanel(tk.Tk):
    def __init__(self) -> None:
        super().__init__()
        self.title(APP_TITLE)
        self.geometry("1380x940")
        self.minsize(1100, 760)

        self.entries: Dict[str, Any] = {}
        self.last_result: Dict[str, Any] = {}

        self.analyzed_files: List[Dict[str, Any]] = []
        self.parsed: Dict[str, Any] = empty_parsed()

        self._configure_style()
        self._build_ui()
        self._set_defaults()

    def _configure_style(self) -> None:
        style = ttk.Style(self)

        try:
            style.theme_use("clam")
        except tk.TclError:
            pass

        self.configure(bg="#0b0f19")

        style.configure("TFrame", background="#0b0f19")
        style.configure("TLabel", background="#0b0f19", foreground="#e5e7eb", font=("Segoe UI", 10))
        style.configure(
            "Header.TLabel",
            background="#0b0f19",
            foreground="#22d3ee",
            font=("Segoe UI", 17, "bold"),
        )
        style.configure(
            "Subheader.TLabel",
            background="#0b0f19",
            foreground="#94a3b8",
            font=("Segoe UI", 9),
        )
        style.configure("TNotebook", background="#0b0f19", borderwidth=0)
        style.configure("TNotebook.Tab", padding=[14, 7], font=("Segoe UI", 10, "bold"))

        style.configure(
            "TEntry",
            fieldbackground="#111827",
            foreground="#e5e7eb",
            insertcolor="#ffffff",
            bordercolor="#334155",
            lightcolor="#334155",
            darkcolor="#334155",
        )

        style.configure(
            "TCombobox",
            fieldbackground="#111827",
            foreground="#e5e7eb",
            arrowcolor="#e5e7eb",
            bordercolor="#334155",
            lightcolor="#334155",
            darkcolor="#334155",
        )

        style.configure(
            "TButton",
            padding=7,
            font=("Segoe UI", 10, "bold"),
            background="#1f2937",
            foreground="#e5e7eb",
            bordercolor="#475569",
            lightcolor="#475569",
            darkcolor="#475569",
        )

        style.map(
            "TButton",
            background=[("active", "#334155")],
            foreground=[("active", "#ffffff")],
        )

        style.configure(
            "Vertical.TScrollbar",
            background="#1f2937",
            troughcolor="#0b0f19",
            arrowcolor="#e5e7eb",
        )

    def _build_ui(self) -> None:
        header = ttk.Frame(self)
        header.pack(fill="x", padx=16, pady=(14, 8))

        ttk.Label(header, text="TraceAtlas PAYMENTINT AI Employee", style="Header.TLabel").pack(anchor="w")

        ttk.Label(
            header,
            text=(
                "Defensive / authorized / evidence-first / privacy-aware payment intelligence • Planning-only by default • "
                "Local deterministic JSON/CSV/TXT transaction/bank/processor/merchant/invoice/settlement/refund/dispute parsing only • "
                "No payment movement / no credential use / no card/account testing / no carding / no diversion / no laundering/structuring/evasion / no refund/chargeback fraud coaching • "
                "Authorization != Capture != Settlement • Payee != Beneficiary • Merchant != Processor • Invoice != Payment • Gross != Net"
            ),
            style="Subheader.TLabel",
            wraplength=1280,
            justify="left",
        ).pack(anchor="w", pady=(2, 0))

        self.notebook = ttk.Notebook(self)
        self.notebook.pack(fill="both", expand=True, padx=16, pady=(8, 16))

        self.input_tab = ttk.Frame(self.notebook)
        self.output_tab = ttk.Frame(self.notebook)

        self.notebook.add(self.input_tab, text="PAYMENTINT Task Input")
        self.notebook.add(self.output_tab, text="Output / PAYMENTINT Plan / Evidence")

        self._build_input_tab()
        self._build_output_tab()

    def _build_input_tab(self) -> None:
        container = ttk.Frame(self.input_tab)
        container.pack(fill="both", expand=True)

        self.canvas = tk.Canvas(container, bg="#0b0f19", highlightthickness=0)
        scrollbar = ttk.Scrollbar(container, orient="vertical", command=self.canvas.yview)
        self.form = ttk.Frame(self.canvas)

        self.form.bind("<Configure>", lambda e: self.canvas.configure(scrollregion=self.canvas.bbox("all")))
        self.canvas_window = self.canvas.create_window((0, 0), window=self.form, anchor="nw")
        self.canvas.configure(yscrollcommand=scrollbar.set)

        self.canvas.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")

        row = 0

        for key, label, kind in FIELDS:
            ttk.Label(self.form, text=label).grid(row=row, column=0, sticky="nw", padx=10, pady=6)

            if kind == "entry":
                widget = ttk.Entry(self.form, width=102)

            elif kind == "combo":
                widget = ttk.Combobox(
                    self.form,
                    values=TARGET_TYPES if key == "target_type" else [],
                    width=100,
                    state="readonly",
                )

            else:
                widget = tk.Text(
                    self.form,
                    height=3,
                    width=102,
                    bg="#111827",
                    fg="#e5e7eb",
                    insertbackground="white",
                    relief="flat",
                    highlightthickness=1,
                    highlightbackground="#334155",
                    font=("Segoe UI", 10),
                    wrap="word",
                )

            widget.grid(row=row, column=1, sticky="ew", padx=10, pady=6)
            self.entries[key] = widget
            row += 1

        self.form.columnconfigure(1, weight=1)

        buttons1 = ttk.Frame(self.input_tab)
        buttons1.pack(fill="x", padx=10, pady=(12, 4))

        buttons2 = ttk.Frame(self.input_tab)
        buttons2.pack(fill="x", padx=10, pady=(0, 12))

        ttk.Button(buttons1, text="Add Transactions", command=self.add_transactions).pack(side="left", padx=4)
        ttk.Button(buttons1, text="Add Bank Statements", command=self.add_bank_statements).pack(side="left", padx=4)
        ttk.Button(buttons1, text="Add Processor / Gateway Exports", command=self.add_processor_exports).pack(side="left", padx=4)
        ttk.Button(buttons1, text="Add Merchant Exports", command=self.add_merchant_exports).pack(side="left", padx=4)
        ttk.Button(buttons1, text="Add Invoices / Receipts", command=self.add_invoices).pack(side="left", padx=4)
        ttk.Button(buttons1, text="Add Settlement Reports", command=self.add_settlements).pack(side="left", padx=4)
        ttk.Button(buttons1, text="Add Refunds / Disputes", command=self.add_disputes).pack(side="left", padx=4)
        ttk.Button(buttons1, text="Add STIX / MISP", command=self.add_stix_misp).pack(side="left", padx=4)

        ttk.Button(buttons2, text="Analyze Local PAYMENTINT Evidence", command=self.analyze_local_payment).pack(side="left", padx=4)
        ttk.Button(buttons2, text="Run Policy Screen", command=self.run_policy_screen).pack(side="left", padx=4)
        ttk.Button(buttons2, text="Generate PAYMENTINT Plan", command=self.generate_plan).pack(side="left", padx=4)
        ttk.Button(buttons2, text="Export JSON", command=self.export_json).pack(side="left", padx=4)
        ttk.Button(buttons2, text="Copy Output", command=self.copy_output).pack(side="left", padx=4)
        ttk.Button(buttons2, text="Clear Form", command=self.clear_form).pack(side="left", padx=4)

    def _build_output_tab(self) -> None:
        container = ttk.Frame(self.output_tab)
        container.pack(fill="both", expand=True)

        self.output = tk.Text(
            container,
            wrap="word",
            bg="#020617",
            fg="#a5f3fc",
            insertbackground="white",
            relief="flat",
            highlightthickness=1,
            highlightbackground="#334155",
            font=("Consolas", 11),
        )

        output_scroll = ttk.Scrollbar(container, orient="vertical", command=self.output.yview)
        self.output.configure(yscrollcommand=output_scroll.set)

        self.output.pack(side="left", fill="both", expand=True)
        output_scroll.pack(side="right", fill="y")

