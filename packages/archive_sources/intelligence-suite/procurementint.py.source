def now_utc() -> str:
    return datetime.now(timezone.utc).isoformat()


def normalize_text(value: Any) -> str:
    return re.sub(r"\s+", " ", str(value or "")).strip().lower()


def normalize_key(value: Any) -> str:
    s = str(value or "").strip().lower()
    s = re.sub(r"[^a-z0-9]+", "_", s)
    return s.strip("_")


def parse_list(value: str) -> List[Any]:
    value = str(value or "").strip()
    if not value:
        return []

    try:
        parsed = json.loads(value)
        if isinstance(parsed, list):
            return parsed
        if isinstance(parsed, dict):
            return [parsed]
    except Exception:
        pass

    normalized = value.replace(",", "\n")
    parts = [p.strip() for p in normalized.splitlines()]
    return [p for p in parts if p]


def parse_dict(value: str) -> Dict[str, Any]:
    value = str(value or "").strip()
    if not value:
        return {}

    try:
        parsed = json.loads(value)
        if isinstance(parsed, dict):
            return parsed
    except Exception:
        pass

    result: Dict[str, Any] = {}
    for line in value.splitlines():
        line = line.strip()
        if not line or ":" not in line:
            continue
        key, val = line.split(":", 1)
        result[key.strip()] = val.strip()
    return result


def listify(value: Any) -> List[Any]:
    if value is None:
        return []
    if isinstance(value, list):
        return value
    if isinstance(value, dict):
        return [value]
    return [value]


def unique_preserve_order(items: List[Any]) -> List[Any]:
    seen = set()
    out = []
    for item in items:
        key = json.dumps(item, ensure_ascii=False, sort_keys=True, default=str) if isinstance(item, (dict, list)) else str(item)
        if key not in seen:
            seen.add(key)
            out.append(item)
    return out


def truncate_list(items: List[Any], limit: int) -> Tuple[List[Any], bool]:
    if len(items) <= limit:
        return items, False
    return items[:limit], True


def sha256_text(text: str) -> str:
    return hashlib.sha256((text or "").encode("utf-8", errors="replace")).hexdigest()


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def redact_secrets(text: str) -> Tuple[str, List[str]]:
    flags: List[str] = []
    if not text:
        return "", flags

    out = text
    for name, rx in SECRET_PATTERNS:
        if rx.search(out):
            flags.append(name)
            out = rx.sub("[REDACTED_SECRET]", out)

    return out, sorted(set(flags))


def detect_prompt_injection(text: str) -> List[str]:
    flags: List[str] = []
    low = normalize_text(text)
    for pattern in PROMPT_INJECTION_PATTERNS:
        if re.search(pattern, low, re.I):
            flags.append(pattern)
    return sorted(set(flags))


def safe_str(value: Any, limit: int = 300) -> str:
    return redact_secrets(str(value or ""))[0].strip()[:limit]


def content_tokens(text: str) -> List[str]:
    redacted, _ = redact_secrets(str(text or ""))
    low = normalize_text(redacted)
    return re.findall(r"[a-z0-9]+", low)


def content_fingerprint(text: str) -> str:
    tokens = content_tokens(text)
    if not tokens:
        return ""
    return sha256_text(" ".join(sorted(set(tokens))))[:32]


def get_field(rec: Dict[str, Any], keys: List[str], as_list: bool = False) -> Any:
    if not isinstance(rec, dict):
        return [] if as_list else None

    lower = {normalize_key(k): v for k, v in rec.items()}
    for key in keys:
        nk = normalize_key(key)
        if nk in lower and lower[nk] not in (None, ""):
            val = lower[nk]
            if as_list:
                return listify(val)
            if isinstance(val, list):
                return val[0] if val else None
            return val
    return [] if as_list else None


def parse_money(value: Any) -> Tuple[Optional[Decimal], str]:
    if value is None:
        return None, ""

    s = str(value).strip()
    if not s:
        return None, ""

    currency = ""
    upper = s.upper()

    if "$" in s:
        currency = "USD"
    elif "€" in s:
        currency = "EUR"
    elif "£" in s:
        currency = "GBP"
    elif "₹" in s:
        currency = "INR"

    cur_match = re.search(r"\b(USD|EUR|GBP|INR|CAD|AUD|JPY|CHF)\b", upper)
    if cur_match:
        currency = cur_match.group(1)

    cleaned = re.sub(r"[^0-9.\-]", "", s)
    if not cleaned or cleaned in {"-", ".", "-."}:
        return None, currency

    try:
        dec = Decimal(cleaned)
    except InvalidOperation:
        return None, currency

    return dec, currency


def dec(value: Any) -> Decimal:
    if value in (None, ""):
        return Decimal("0")
    try:
        return Decimal(str(value))
    except InvalidOperation:
        return Decimal("0")


def empty_parsed() -> Dict[str, Any]:
    return {
        "sources": [],
        "entities": [],
        "procurements": [],
        "lots": [],
        "bids": [],
        "awards": [],
        "contracts": [],
        "amendments": [],
        "invoices": [],
        "deliverables": [],
        "observations": [],
        "notes": [],
        "contradictions": [],
        "hypotheses": [],
        "knowledge_gaps": [],
        "specialist_handoffs": [],
        "anomalies": [],
        "concentration_metrics": [],
        "related_party_signals": [],
        "conflict_indicators": [],
        "collusion_indicators": [],
    }


def add_note(parsed: Dict[str, Any], note_type: str, **kwargs: Any) -> None:
    if len(parsed.get("notes", [])) >= 200000:
        return
    note = {"type": note_type}
    note.update(kwargs)
    parsed["notes"].append(note)


def add_observation(parsed: Dict[str, Any], statement: str, source_id: str, evidence_id: str, context: str = "") -> None:
    if len(parsed.get("observations", [])) >= 200000:
        return

    redacted, secret_flags = redact_secrets(str(statement or "")[:1000])
    injection_flags = detect_prompt_injection(str(statement or ""))

    parsed["observations"].append({
        "observation_id": f"OBS-{uuid.uuid4()}",
        "statement": redacted,
        "source_id": source_id,
        "evidence_id": evidence_id,
        "context": context[:200],
        "state": "SOURCE_OBSERVED",
        "secret_flags": secret_flags,
        "prompt_injection_flags": injection_flags,
        "content_hash": sha256_text(str(statement or "")),
        "limitations": [
            "Procurement source statement is evidence about a process/event, not verified outcome or intent.",
            "Single bidder does not automatically prove corruption.",
        ],
    })

    if secret_flags:
        add_note(parsed, "SECRET_REDACTION", flags=secret_flags, source_id=source_id, evidence_id=evidence_id, context=context)
    if injection_flags:
        add_note(parsed, "PROMPT_INJECTION_FLAG", flags=injection_flags, source_id=source_id, evidence_id=evidence_id, context=context,
                 caution="Embedded instructions in tender/bid/contract documents are ignored.")


def add_source(
    parsed: Dict[str, Any],
    source_id: str,
    evidence_id: str,
    filename: str = "",
    file_hash: str = "",
    publisher: str = "",
    title: str = "",
    source_type: str = "",
    markings: str = "",
    content_fp: str = "",
) -> None:
    for s in parsed["sources"]:
        if s.get("source_id") == source_id:
            if file_hash and not s.get("file_hash"):
                s["file_hash"] = file_hash
            if publisher and not s.get("publisher"):
                s["publisher"] = publisher
            if title and not s.get("title"):
                s["title"] = title
            if content_fp and not s.get("content_fingerprint"):
                s["content_fingerprint"] = content_fp
            return

    parsed["sources"].append({
        "source_id": source_id,
        "evidence_id": evidence_id,
        "filename": filename,
        "file_hash": file_hash,
        "publisher": publisher,
        "title": title,
        "source_type": source_type or "UNKNOWN",
        "markings": markings,
        "content_fingerprint": content_fp,
        "retrieved_at": now_utc(),
        "state": "SOURCE_REGISTERED",
        "source_independence_state": "UNKNOWN",
        "limitations": [
            "Source registration is local provenance metadata.",
            "Multiple commercial databases copying same official notice are not independent sources.",
        ],
    })


def add_entity(
    parsed: Dict[str, Any],
    name: Any,
    entity_type: Any,
    role: Any = "",
    jurisdiction: Any = "",
    location: Any = "",
    registration_id: Any = "",
    source_id: str = "",
    evidence_id: str = "",
    context: str = "",
) -> Optional[str]:
    n = safe_str(name, 200)
    if not n:
        return None

    norm = normalize_text(n)
    et = safe_str(entity_type, 100).upper() or "UNKNOWN"
    r = safe_str(role, 100).upper() or et

    for e in parsed["entities"]:
        if e.get("normalized_name") == norm and e.get("entity_type") == et:
            if jurisdiction and not e.get("jurisdiction"):
                e["jurisdiction"] = safe_str(jurisdiction, 100)
            if location and not e.get("location"):
                e["location"] = safe_str(location, 300)
            if registration_id and not e.get("registration_id"):
                e["registration_id"] = safe_str(registration_id, 100)
            if r and r != "UNKNOWN" and e.get("role") in ("", "UNKNOWN"):
                e["role"] = r
            return e.get("entity_id")

    eid = f"ENT-{uuid.uuid4()}"
    parsed["entities"].append({
        "entity_id": eid,
        "name": n,
        "normalized_name": norm,
        "entity_type": et,
        "role": r,
        "jurisdiction": safe_str(jurisdiction, 100),
        "location": safe_str(location, 300),
        "registration_id": safe_str(registration_id, 100),
        "source_id": source_id,
        "evidence_id": evidence_id,
        "context": safe_str(context, 300),
        "state": "ENTITY_CANDIDATE",
        "limitations": [
            "Entity resolution requires corroboration. Name similarity alone is insufficient.",
            "Buyer is not necessarily end-user. Procuring authority may act on behalf of buyer.",
            "Bidder is not necessarily contractor until contract signing is evidenced.",
        ],
    })
    return eid


def resolve_entity_value(
    parsed: Dict[str, Any],
    value: Any,
    default_type: str,
    source_id: str,
    evidence_id: str,
    context: str = "",
) -> Optional[str]:
    if value is None or value == "":
        return None

    if isinstance(value, dict):
        name = (
            value.get("name")
            or value.get("legal_name")
            or value.get("display_name")
            or value.get("entity_name")
            or value.get("supplier_name")
            or value.get("vendor_name")
            or value.get("id")
        )
        et = value.get("entity_type") or value.get("type") or value.get("role") or default_type
        jurisdiction = value.get("jurisdiction") or value.get("country") or value.get("region")
        location = value.get("location") or value.get("address_summary") or value.get("site")
        reg_id = value.get("registration_number") or value.get("tax_id") or value.get("lei")
    else:
        name = str(value)
        et = default_type
        jurisdiction = ""
        location = ""
        reg_id = ""

    return add_entity(
        parsed,
        name,
        et,
        et,
        jurisdiction,
        location,
        reg_id,
        source_id,
        evidence_id,
        context,
    )


def add_procurement(
    parsed: Dict[str, Any],
    procurement_id: Any,
    title: Any,
    buyer_ref: Any,
    procuring_authority_ref: Any,
    procedure_type: Any,
    category: Any,
    estimated_value: Any,
    currency: Any,
    publication_date: Any,
    submission_deadline: Any,
    status: Any,
    lots: Any,
    eligibility_requirements: Any,
    evaluation_criteria: Any,
    source_id: str,
    evidence_id: str,
    context: str = "",
) -> Optional[str]:
    pid = safe_str(procurement_id, 200)
    if not pid:
        return None

    est_val, est_cur = parse_money(estimated_value)
    if currency:
        est_cur = safe_str(currency, 20).upper() or est_cur

    rec_id = f"PROC-{uuid.uuid4()}"
    
    # Resolve Lots recursively if needed, but for simplicity we store lot refs here
    lot_refs = []
    if lots:
        for lot in listify(lots):
            if isinstance(lot, dict):
                lot_pid = lot.get("lot_id") or lot.get("id")
                if lot_pid:
                    lot_refs.append(add_lot(parsed, lot_pid, rec_id, lot.get("title"), lot.get("scope"), lot.get("estimated_value"), lot.get("currency"), source_id, evidence_id, f"{context}/lot"))

    parsed["procurements"].append({
        "procurement_record_id": rec_id,
        "external_procurement_id": pid,
        "title": safe_str(title, 300),
        "buyer_ref": buyer_ref,
        "procuring_authority_ref": procuring_authority_ref,
        "procedure_type": safe_str(procedure_type, 100).upper() or "UNKNOWN",
        "category": safe_str(category, 200),
        "estimated_value_decimal": str(est_val) if est_val is not None else None,
        "estimated_currency": est_cur or "UNKNOWN",
        "publication_date": safe_str(publication_date, 100),
        "submission_deadline": safe_str(submission_deadline, 100),
        "status": safe_str(status, 100).upper() or "UNKNOWN",
        "lot_refs": lot_refs,
        "eligibility_requirements": safe_str(eligibility_requirements, 1000),
        "evaluation_criteria": safe_str(evaluation_criteria, 1000),
        "source_id": source_id,
        "evidence_id": evidence_id,
        "context": safe_str(context, 300),
        "state": "PROCUREMENT_SOURCE_REPORTED",
        "limitations": [
            "Tender is opportunity/process. It does not prove contract existence.",
            "Estimated value is planning data, not final award or paid amount.",
        ],
    })
    return rec_id


def add_lot(
    parsed: Dict[str, Any],
    lot_id: Any,
    procurement_ref: Any,
    title: Any,
    scope: Any,
    estimated_value: Any,
    currency: Any,
    source_id: str,
    evidence_id: str,
    context: str = "",
) -> Optional[str]:
    lid = safe_str(lot_id, 200)
    if not lid:
        return None
    
    est_val, est_cur = parse_money(estimated_value)
    if currency:
        est_cur = safe_str(currency, 20).upper() or est_cur

    rec_id = f"LOT-{uuid.uuid4()}"
    parsed["lots"].append({
        "lot_record_id": rec_id,
        "external_lot_id": lid,
        "procurement_ref": procurement_ref,
        "title": safe_str(title, 300),
        "scope": safe_str(scope, 1000),
        "estimated_value_decimal": str(est_val) if est_val is not None else None,
        "estimated_currency": est_cur or "UNKNOWN",
        "source_id": source_id,
        "evidence_id": evidence_id,
        "context": safe_str(context, 300),
        "state": "LOT_SOURCE_REPORTED",
        "limitations": [
            "One procurement can have multiple lots with different winners/values.",
        ],
    })
    return rec_id


def add_bid(
    parsed: Dict[str, Any],
    bid_id: Any,
    procurement_ref: Any,
    lot_ref: Any,
    bidder_ref: Any,
    submission_time: Any,
    bid_value: Any,
    currency: Any,
    technical_score: Any,
    financial_score: Any,
    total_score: Any,
    qualification_status: Any,
    source_id: str,
    evidence_id: str,
    context: str = "",
) -> Optional[str]:
    bid_raw_id = safe_str(bid_id, 200)
    if not bid_raw_id:
        return None
    
    val, cur = parse_money(bid_value)
    if currency:
        cur = safe_str(currency, 20).upper() or cur

    rec_id = f"BID-{uuid.uuid4()}"
    parsed["bids"].append({
        "bid_record_id": rec_id,
        "external_bid_id": bid_raw_id,
        "procurement_ref": procurement_ref,
        "lot_ref": lot_ref,
        "bidder_ref": bidder_ref,
        "submission_time": safe_str(submission_time, 100),
        "bid_value_decimal": str(val) if val is not None else None,
        "bid_currency": cur or "UNKNOWN",
        "technical_score": safe_str(technical_score, 50),
        "financial_score": safe_str(financial_score, 50),
        "total_score": safe_str(total_score, 50),
        "qualification_status": safe_str(qualification_status, 100).upper() or "UNKNOWN",
        "source_id": source_id,
        "evidence_id": evidence_id,
        "context": safe_str(context, 300),
        "state": "BID_SOURCE_REPORTED",
        "limitations": [
            "Bid participation does not imply award or contract.",
            "Scores are evaluator-dependent, not universal truth.",
        ],
    })
    return rec_id


def add_award(
    parsed: Dict[str, Any],
    award_id: Any,
    procurement_ref: Any,
    lot_ref: Any,
    winner_ref: Any,
    award_value: Any,
    currency: Any,
    award_date: Any,
    award_status: Any,
    source_id: str,
    evidence_id: str,
    context: str = "",
) -> Optional[str]:
    aw_raw_id = safe_str(award_id, 200)
    if not aw_raw_id:
        return None
    
    val, cur = parse_money(award_value)
    if currency:
        cur = safe_str(currency, 20).upper() or cur

    rec_id = f"AWD-{uuid.uuid4()}"
    parsed["awards"].append({
        "award_record_id": rec_id,
        "external_award_id": aw_raw_id,
        "procurement_ref": procurement_ref,
        "lot_ref": lot_ref,
        "winner_ref": winner_ref,
        "award_value_decimal": str(val) if val is not None else None,
        "award_currency": cur or "UNKNOWN",
        "award_date": safe_str(award_date, 100),
        "award_status": safe_str(award_status, 100).upper() or "UNKNOWN",
        "source_id": source_id,
        "evidence_id": evidence_id,
        "context": safe_str(context, 300),
        "state": "AWARD_SOURCE_REPORTED",
        "limitations": [
            "Award notice represents selection decision. It does not prove signed contract.",
            "Provisional award may be challenged/cancelled before contract formation.",
        ],
    })
    return rec_id


def add_contract(
    parsed: Dict[str, Any],
    contract_id: Any,
    award_ref: Any,
    buyer_ref: Any,
    supplier_ref: Any,
    signed_date: Any,
    effective_date: Any,
    end_date: Any,
    initial_value: Any,
    current_value: Any,
    currency: Any,
    ceiling_value: Any,
    status: Any,
    source_id: str,
    evidence_id: str,
    context: str = "",
) -> Optional[str]:
    ct_raw_id = safe_str(contract_id, 200)
    if not ct_raw_id:
        return None
    
    init_val, init_cur = parse_money(initial_value)
    curr_val, curr_cur = parse_money(current_value)
    ceil_val, ceil_cur = parse_money(ceiling_value)
    
    if currency:
        c_upper = safe_str(currency, 20).upper()
        init_cur = c_upper or init_cur
        curr_cur = c_upper or curr_cur
        ceil_cur = c_upper or ceil_cur

    rec_id = f"CTR-{uuid.uuid4()}"
    parsed["contracts"].append({
        "contract_record_id": rec_id,
        "external_contract_id": ct_raw_id,
        "award_ref": award_ref,
        "buyer_ref": buyer_ref,
        "supplier_ref": supplier_ref,
        "signed_date": safe_str(signed_date, 100),
        "effective_date": safe_str(effective_date, 100),
        "end_date": safe_str(end_date, 100),
        "initial_value_decimal": str(init_val) if init_val is not None else None,
        "current_value_decimal": str(curr_val) if curr_val is not None else None,
        "ceiling_value_decimal": str(ceil_val) if ceil_val is not None else None,
        "currency": init_cur or curr_cur or ceil_cur or "UNKNOWN",
        "status": safe_str(status, 100).upper() or "UNKNOWN",
        "source_id": source_id,
        "evidence_id": evidence_id,
        "context": safe_str(context, 300),
        "state": "CONTRACT_SOURCE_REPORTED",
        "limitations": [
            "Signed contract does not prove full performance or payment.",
            "Ceiling value is maximum potential, not actual expenditure.",
        ],
    })
    return rec_id


def add_amendment(
    parsed: Dict[str, Any],
    amendment_id: Any,
    contract_ref: Any,
    date: Any,
    type: Any,
    value_change: Any,
    duration_change: Any,
    reason: Any,
    source_id: str,
    evidence_id: str,
    context: str = "",
) -> None:
    am_raw_id = safe_str(amendment_id, 200)
    if not am_raw_id:
        return
        
    val_chg, cur = parse_money(value_change)

    parsed["amendments"].append({
        "amendment_record_id": f"AMD-{uuid.uuid4()}",
        "external_amendment_id": am_raw_id,
        "contract_ref": contract_ref,
        "date": safe_str(date, 100),
        "type": safe_str(type, 100).upper() or "UNKNOWN",
        "value_change_decimal": str(val_chg) if val_chg is not None else None,
        "currency": cur or "UNKNOWN",
        "duration_change": safe_str(duration_change, 100),
        "reason": safe_str(reason, 500),
        "source_id": source_id,
        "evidence_id": evidence_id,
        "context": safe_str(context, 300),
        "state": "AMENDMENT_SOURCE_REPORTED",
        "limitations": [
            "Amendments are common administrative changes. They do not automatically imply wrongdoing.",
        ],
    })


def add_invoice(
    parsed: Dict[str, Any],
    invoice_id: Any,
    supplier_ref: Any,
    buyer_ref: Any,
    contract_ref: Any,
    po_ref: Any,
    amount: Any,
    currency: Any,
    date: Any,
    status: Any,
    source_id: str,
    evidence_id: str,
    context: str = "",
) -> None:
    inv_raw_id = safe_str(invoice_id, 200)
    if not inv_raw_id:
        return
        
    amt, cur = parse_money(amount)
    if currency:
        cur = safe_str(currency, 20).upper() or cur

    parsed["invoices"].append({
        "invoice_record_id": f"INV-{uuid.uuid4()}",
        "external_invoice_id": inv_raw_id,
        "supplier_ref": supplier_ref,
        "buyer_ref": buyer_ref,
        "contract_ref": contract_ref,
        "po_ref": po_ref,
        "amount_decimal": str(amt) if amt is not None else None,
        "currency": cur or "UNKNOWN",
        "date": safe_str(date, 100),
        "status": safe_str(status, 100).upper() or "UNKNOWN",
        "source_id": source_id,
        "evidence_id": evidence_id,
        "context": safe_str(context, 300),
        "state": "INVOICE_SOURCE_REPORTED",
        "limitations": [
            "Invoice is a claim/request. It does not prove payment was made.",
        ],
    })


def add_deliverable(
    parsed: Dict[str, Any],
    deliverable_id: Any,
    contract_ref: Any,
    description: Any,
    due_date: Any,
    delivered_date: Any,
    accepted_date: Any,
    status: Any,
    source_id: str,
    evidence_id: str,
    context: str = "",
) -> None:
    dl_raw_id = safe_str(deliverable_id, 200)
    if not dl_raw_id:
        return

    parsed["deliverables"].append({
        "deliverable_record_id": f"DLV-{uuid.uuid4()}",
        "external_deliverable_id": dl_raw_id,
        "contract_ref": contract_ref,
        "description": safe_str(description, 500),
        "due_date": safe_str(due_date, 100),
        "delivered_date": safe_str(delivered_date, 100),
        "accepted_date": safe_str(accepted_date, 100),
        "status": safe_str(status, 100).upper() or "UNKNOWN",
        "source_id": source_id,
        "evidence_id": evidence_id,
        "context": safe_str(context, 300),
        "state": "DELIVERABLE_SOURCE_REPORTED",
        "limitations": [
            "Delivery note supports receipt. It does not prove quality/compliance unless accepted.",
        ],
    })


def process_json_record(
    rec: Dict[str, Any],
    source_id: str,
    evidence_id: str,
    parsed: Dict[str, Any],
    context: str = "",
) -> None:
    if not isinstance(rec, dict):
        return

    rec_ctx = context or "json_record"

    text_blob = json.dumps(rec, ensure_ascii=False, default=str)[:12000]
    process_text_block(text_blob, source_id, evidence_id, parsed, context=rec_ctx)

    # Resolve Entities
    for key in ENTITY_ROLE_KEYS:
        vals = get_field(rec, [key], as_list=True)
        for val in vals:
            resolve_entity_value(parsed, val, key.upper(), source_id, evidence_id, f"{rec_ctx}/{key}")

    # Process Procurement Objects
    proc_items = get_field(rec, PROCUREMENT_OBJECT_KEYS, as_list=True)
    for item in proc_items:
        if isinstance(item, dict):
            buyer_ref = resolve_entity_value(parsed, item.get("buyer") or item.get("authority"), "BUYER", source_id, evidence_id, f"{rec_ctx}/buyer")
            pa_ref = resolve_entity_value(parsed, item.get("procuring_authority"), "PROCURING_AUTHORITY", source_id, evidence_id, f"{rec_ctx}/pa")
            
            add_procurement(
                parsed,
                item.get("procurement_id") or item.get("id") or item.get("tender_id"),
                item.get("title"),
                buyer_ref,
                pa_ref,
                item.get("procedure_type") or item.get("method"),
                item.get("category") or item.get("cpv_code"),
                item.get("estimated_value") or item.get("budget"),
                item.get("currency"),
                item.get("publication_date") or item.get("published_at"),
                item.get("submission_deadline") or item.get("deadline"),
                item.get("status"),
                item.get("lots"),
                item.get("eligibility_requirements") or item.get("qualifications"),
                item.get("evaluation_criteria"),
                source_id,
                evidence_id,
                f"{rec_ctx}/procurement",
            )

    # Process Bids
    bid_items = get_field(rec, BID_KEYS, as_list=True)
    for item in bid_items:
        if isinstance(item, dict):
            bidder_ref = resolve_entity_value(parsed, item.get("bidder") or item.get("supplier"), "SUPPLIER", source_id, evidence_id, f"{rec_ctx}/bidder")
            proc_ref = item.get("procurement_ref") or item.get("tender_id")
            lot_ref = item.get("lot_ref") or item.get("lot_id")
            
            add_bid(
                parsed,
                item.get("bid_id") or item.get("id"),
                proc_ref,
                lot_ref,
                bidder_ref,
                item.get("submission_time") or item.get("submitted_at"),
                item.get("bid_value") or item.get("price"),
                item.get("currency"),
                item.get("technical_score"),
                item.get("financial_score"),
                item.get("total_score"),
                item.get("qualification_status") or item.get("status"),
                source_id,
                evidence_id,
                f"{rec_ctx}/bid",
            )

    # Process Awards
    award_items = get_field(rec, AWARD_KEYS, as_list=True)
    for item in award_items:
        if isinstance(item, dict):
            winner_ref = resolve_entity_value(parsed, item.get("winner") or item.get("supplier"), "SUPPLIER", source_id, evidence_id, f"{rec_ctx}/winner")
            proc_ref = item.get("procurement_ref") or item.get("tender_id")
            lot_ref = item.get("lot_ref") or item.get("lot_id")
            
            add_award(
                parsed,
                item.get("award_id") or item.get("id"),
                proc_ref,
                lot_ref,
                winner_ref,
                item.get("award_value") or item.get("value"),
                item.get("currency"),
                item.get("award_date") or item.get("awarded_at"),
                item.get("award_status") or item.get("status"),
                source_id,
                evidence_id,
                f"{rec_ctx}/award",
            )

    # Process Contracts
    contract_items = get_field(rec, CONTRACT_KEYS, as_list=True)
    for item in contract_items:
        if isinstance(item, dict):
            supplier_ref = resolve_entity_value(parsed, item.get("supplier") or item.get("contractor"), "SUPPLIER", source_id, evidence_id, f"{rec_ctx}/contractor")
            buyer_ref = resolve_entity_value(parsed, item.get("buyer"), "BUYER", source_id, evidence_id, f"{rec_ctx}/cbuyer")
            award_ref = item.get("award_ref") or item.get("award_id")
            
            add_contract(
                parsed,
                item.get("contract_id") or item.get("id"),
                award_ref,
                buyer_ref,
                supplier_ref,
                item.get("signed_date") or item.get("executed_at"),
                item.get("effective_date") or item.get("start_date"),
                item.get("end_date") or item.get("expiry_date"),
                item.get("initial_value") or item.get("value"),
                item.get("current_value"),
                item.get("currency"),
                item.get("ceiling_value"),
                item.get("status"),
                source_id,
                evidence_id,
                f"{rec_ctx}/contract",
            )

    # Process Amendments
    amd_items = get_field(rec, AMENDMENT_KEYS, as_list=True)
    for item in amd_items:
        if isinstance(item, dict):
            ct_ref = item.get("contract_ref") or item.get("contract_id")
            add_amendment(
                parsed,
                item.get("amendment_id") or item.get("id"),
                ct_ref,
                item.get("date") or item.get("effective_date"),
                item.get("type") or item.get("category"),
                item.get("value_change") or item.get("delta_value"),
                item.get("duration_change") or item.get("extension_months"),
                item.get("reason") or item.get("justification"),
                source_id,
                evidence_id,
                f"{rec_ctx}/amendment",
            )

    # Process Invoices
    inv_items = get_field(rec, INVOICE_KEYS, as_list=True)
    for item in inv_items:
        if isinstance(item, dict):
            sup_ref = resolve_entity_value(parsed, item.get("supplier"), "SUPPLIER", source_id, evidence_id, f"{rec_ctx}/isupplier")
            buy_ref = resolve_entity_value(parsed, item.get("buyer"), "BUYER", source_id, evidence_id, f"{rec_ctx}/ibuyer")
            ct_ref = item.get("contract_ref") or item.get("contract_id")
            po_ref = item.get("po_ref") or item.get("purchase_order_id")
            
            add_invoice(
                parsed,
                item.get("invoice_id") or item.get("number"),
                sup_ref,
                buy_ref,
                ct_ref,
                po_ref,
                item.get("amount") or item.get("total"),
                item.get("currency"),
                item.get("date") or item.get("issued_at"),
                item.get("status"),
                source_id,
                evidence_id,
                f"{rec_ctx}/invoice",
            )

    # Process Deliverables
    del_items = get_field(rec, DELIVERY_KEYS, as_list=True)
    for item in del_items:
        if isinstance(item, dict):
            ct_ref = item.get("contract_ref") or item.get("contract_id")
            add_deliverable(
                parsed,
                item.get("deliverable_id") or item.get("id"),
                ct_ref,
                item.get("description") or item.get("item"),
                item.get("due_date"),
                item.get("delivered_date") or item.get("received_date"),
                item.get("accepted_date"),
                item.get("status"),
                source_id,
                evidence_id,
                f"{rec_ctx}/deliverable",
            )


def process_text_block(
    text: str,
    source_id: str,
    evidence_id: str,
    parsed: Dict[str, Any],
    context: str = "",
) -> None:
    raw = str(text or "")
    if not raw.strip():
        return

    redacted, secret_flags = redact_secrets(raw)
    injection_flags = detect_prompt_injection(raw)

    if secret_flags:
        add_note(parsed, "SECRET_REDACTION", flags=secret_flags, source_id=source_id, evidence_id=evidence_id, context=context)
    if injection_flags:
        add_note(parsed, "PROMPT_INJECTION_FLAG", flags=injection_flags, source_id=source_id, evidence_id=evidence_id, context=context,
                 caution="Embedded instructions in procurement docs are ignored.")

    add_observation(parsed, redacted[:1000], source_id, evidence_id, context=context)

    low = normalize_text(redacted)
    signals = []

    if any(k in low for k in ["tender", "rfp", "itt", "ifb", "notice"]):
        signals.append("TENDER_CONTEXT")
    if any(k in low for k in ["bid", "offer", "proposal", "submission"]):
        signals.append("BID_CONTEXT")
    if any(k in low for k in ["award", "winner", "selected"]):
        signals.append("AWARD_CONTEXT")
    if any(k in low for k in ["contract", "signed", "agreement"]):
        signals.append("CONTRACT_CONTEXT")
    if any(k in low for k in ["amendment", "change order", "extension"]):
        signals.append("AMENDMENT_CONTEXT")
    if any(k in low for k in ["invoice", "billing", "payment request"]):
        signals.append("INVOICE_CONTEXT")
    if any(k in low for k in ["delivery", "milestone", "acceptance"]):
        signals.append("DELIVERY_CONTEXT")
    if any(k in low for k in ["conflict of interest", "related party", "director", "owner"]):
        signals.append("RELATED_PARTY_CONTEXT")
    if any(k in low for k in ["collusion", "bid rigging", "cartel", "rotation"]):
        signals.append("COLLUSION_INDICATOR_KEYWORD")
    if any(k in low for k in ["debarred", "excluded", "blacklisted", "sanctioned"]):
        signals.append("EXCLUSION_CONTEXT")

    if signals:
        add_note(parsed, "PROCUREMENT_SIGNAL", signals=unique_preserve_order(signals), source_id=source_id, evidence_id=evidence_id, context=context,
                 caution="Signals indicate analytical attention, not verified outcomes or violations.")


def classify_json_payload(data: Any, filename: str = "") -> str:
    if isinstance(data, list):
        return "JSON_ARRAY"
    if not isinstance(data, dict):
        return "GENERIC_JSON"

    keys = {normalize_key(k) for k in data.keys()}
    low = json.dumps(data, ensure_ascii=False, default=str)[:30000].lower()
    fname = normalize_text(filename)

    if "tender" in fname or "rfp" in fname or "procurement" in keys:
        return "TENDER_RECORD"
    if "bid" in fname or "offer" in fname or "proposal" in fname:
        return "BID_RECORD"
    if "award" in fname or "winner" in fname:
        return "AWARD_RECORD"
    if "contract" in fname or "agreement" in fname:
        return "CONTRACT_RECORD"
    if "invoice" in fname or "bill" in fname:
        return "INVOICE_RECORD"
    if "amendment" in fname or "change" in fname:
        return "AMENDMENT_RECORD"
    if "debarment" in fname or "exclusion" in fname:
        return "DEBARMENT_RECORD"

    return "GENERIC_PROCUREMENT_EVIDENCE"


def walk_json(
    data: Any,
    source_id: str,
    evidence_id: str,
    parsed: Dict[str, Any],
    depth: int = 0,
    path: str = "",
) -> None:
    if depth > 14 or len(parsed.get("observations", [])) > 200000:
        return

    if isinstance(data, dict):
        process_json_record(data, source_id, evidence_id, parsed, context=path or "json")
        for k, v in data.items():
            new_path = f"{path}.{k}" if path else str(k)
            walk_json(v, source_id, evidence_id, parsed, depth + 1, new_path)
    elif isinstance(data, list):
        for item in data[:100000]:
            walk_json(item, source_id, evidence_id, parsed, depth + 1, path)
    elif isinstance(data, str):
        process_text_block(data, source_id, evidence_id, parsed, context=path or "json_string")


def process_json_file(path: Path, source_id: str, evidence_id: str) -> Tuple[str, Dict[str, Any]]:
    parsed = empty_parsed()
    raw = path.read_text(encoding="utf-8", errors="replace")[:30_000_000]
    redacted_raw, _ = redact_secrets(raw)
    fp = content_fingerprint(redacted_raw)
    data = json.loads(raw)
    kind = classify_json_payload(data, path.name)

    add_source(
        parsed,
        source_id,
        evidence_id,
        filename=path.name,
        file_hash=sha256_file(path),
        source_type=kind,
        content_fp=fp,
    )

    walk_json(data, source_id, evidence_id, parsed)
    return kind, parsed


def process_csv_file(path: Path, source_id: str, evidence_id: str) -> Tuple[str, Dict[str, Any]]:
    parsed = empty_parsed()
    raw = path.read_text(encoding="utf-8", errors="replace")[:30_000_000]
    redacted_raw, _ = redact_secrets(raw)
    fp = content_fingerprint(redacted_raw)
    kind = "CSV_PROCUREMENT_EVIDENCE"

    add_source(
        parsed,
        source_id,
        evidence_id,
        filename=path.name,
        file_hash=sha256_file(path),
        source_type=kind,
        content_fp=fp,
    )

    with path.open("r", encoding="utf-8", errors="replace", newline="") as f:
        sample = f.read(1_000_000)
        f.seek(0)
        try:
            dialect = csv.Sniffer().sniff(sample, delimiters=",;\t| ")
        except csv.Error:
            dialect = csv.excel

        reader = csv.DictReader(f, dialect=dialect)
        for idx, row in enumerate(reader):
            if idx >= 200000:
                break
            process_json_record(row, source_id, evidence_id, parsed, context=f"csv_row_{idx}")

    return kind, parsed


def process_text_file(path: Path, source_id: str, evidence_id: str) -> Tuple[str, Dict[str, Any]]:
    parsed = empty_parsed()
    raw = path.read_text(encoding="utf-8", errors="replace")[:10_000_000]
    redacted_raw, _ = redact_secrets(raw)
    fp = content_fingerprint(redacted_raw)

    low = redacted_raw.lower()[:30000]
    if "tender" in low or "rfp" in low:
        kind = "TEXT_TENDER_NOTE"
    elif "contract" in low or "agreement" in low:
        kind = "TEXT_CONTRACT_NOTE"
    elif "invoice" in low:
        kind = "TEXT_INVOICE_NOTE"
    else:
        kind = "TEXT_PROCUREMENT_EVIDENCE_NOTE"

    add_source(
        parsed,
        source_id,
        evidence_id,
        filename=path.name,
        file_hash=sha256_file(path),
        source_type=kind,
        content_fp=fp,
    )

    for line_no, line in enumerate(raw.splitlines()[:200000]):
        if line.strip():
            process_text_block(line, source_id, evidence_id, parsed, context=f"text_line_{line_no}")

    return kind, parsed


def detect_format(path: Path) -> Dict[str, str]:
    suffix = path.suffix.lower()

    try:
        with path.open("rb") as f:
            head = f.read(256)
    except Exception as exc:
        return {"format_detected": "UNKNOWN", "mime_type": "application/octet-stream", "format_error": str(exc)}

    binary_suffixes = {
        ".exe", ".dll", ".sys", ".elf", ".so", ".dylib", ".bin", ".fw", ".img",
        ".iso", ".apk", ".jar", ".class", ".zip", ".gz", ".tar", ".7z", ".rar",
        ".pcap", ".pcapng", ".cap", ".msi", ".cab", ".pdf", ".docx", ".xlsx",
        ".pptx", ".mp3", ".wav", ".mp4", ".avi",
    }

    if suffix in binary_suffixes:
        return {"format_detected": "BINARY_ARTIFACT", "mime_type": "application/octet-stream"}

    stripped = head.lstrip()

    if suffix == ".json" or stripped.startswith(b"{") or stripped.startswith(b"["):
        return {"format_detected": "JSON", "mime_type": "application/json"}

    if suffix in {".csv", ".tsv"}:
        return {"format_detected": "CSV", "mime_type": "text/csv"}

    if b"," in head and b"\n" in head and all(b in b"\x09\x0a\x0d\x20" or 32 <= b <= 126 for b in head[:64]):
        return {"format_detected": "CSV", "mime_type": "text/csv"}

    if suffix in {".txt", ".log", ".md", ".yaml", ".yml", ".report", ".stix", ".taxii", ".misp", ".snapshot", ".eml", ".msg", ".tender", ".rfp", ".contract"}:
        return {"format_detected": "TEXT", "mime_type": "text/plain"}

    try:
        probe = head.decode("utf-8", errors="strict")
        if probe.strip():
            return {"format_detected": "TEXT", "mime_type": "text/plain"}
    except Exception:
        pass

    return {"format_detected": "UNKNOWN", "mime_type": "application/octet-stream"}


def analyze_procurement_file(path_str: str, case_id: str = "", task_id: str = "") -> Tuple[Dict[str, Any], Dict[str, Any]]:
    path = Path(path_str).expanduser()
    source_id = f"SRC-{uuid.uuid4()}"
    evidence_id = f"EVD-{uuid.uuid4()}"

    file_evidence: Dict[str, Any] = {
        "evidence_id": evidence_id,
        "source_id": source_id,
        "case_id": case_id,
        "task_id": task_id,
        "path": str(path),
        "filename": path.name,
        "retrieved_at": now_utc(),
        "acquisition_method": "local_authorized_or_public_file_access",
        "status": "PENDING",
        "limitations": [
            "No bid rigging, bribery, confidential data theft, score manipulation, or threshold evasion performed.",
            "Binary artifacts are hash/metadata preserved only.",
            "Procurement evidence is untrusted data, not instruction.",
            "Exposed secrets were redacted and not used.",
            "Records are source-reported until corroborated by primary contracts/payments.",
        ],
    }

    parsed = empty_parsed()

    if not path.exists():
        file_evidence["status"] = "FAILED_FILE_NOT_FOUND"
        return file_evidence, parsed

    try:
        st = path.stat()
        file_evidence["size_bytes"] = st.st_size
        file_evidence["filesystem_modified_at"] = datetime.fromtimestamp(st.st_mtime, tz=timezone.utc).isoformat()
    except Exception as exc:
        file_evidence["status"] = "FAILED_STAT"
        file_evidence["error"] = str(exc)
        return file_evidence, parsed

    try:
        file_evidence["sha256"] = sha256_file(path)
    except Exception as exc:
        file_evidence["sha256_error"] = str(exc)

    fmt = detect_format(path)
    file_evidence.update(fmt)
    format_detected = file_evidence.get("format_detected", "UNKNOWN")

    try:
        if format_detected == "JSON":
            kind, parsed = process_json_file(path, source_id, evidence_id)
            file_evidence["content_kind"] = kind
            file_evidence["status"] = "SUCCEEDED"
        elif format_detected == "CSV":
            kind, parsed = process_csv_file(path, source_id, evidence_id)
            file_evidence["content_kind"] = kind
            file_evidence["status"] = "SUCCEEDED"
        elif format_detected == "TEXT":
            kind, parsed = process_text_file(path, source_id, evidence_id)
            file_evidence["content_kind"] = kind
            file_evidence["status"] = "SUCCEEDED"
        elif format_detected == "BINARY_ARTIFACT":
            file_evidence["content_kind"] = "BINARY_PROC_DOC_METADATA_ONLY"
            file_evidence["status"] = "PARTIAL_BINARY_METADATA_ONLY"
            file_evidence["reason"] = (
                "Binary procurement document detected. This planning panel preserves hash/metadata only. "
                "It does not execute macros, parse PDF/DOCX/XLSX deeply, open archives, or access private portals."
            )
        else:
            file_evidence["content_kind"] = "UNKNOWN_OR_UNSUPPORTED"
            file_evidence["status"] = "UNSUPPORTED_FORMAT"
    except Exception as exc:
        file_evidence["status"] = "PARTIAL_OR_FAILED"
        file_evidence["error"] = f"{exc.__class__.__name__}: {exc}"

    file_evidence["parsed_entity_count"] = len(parsed.get("entities", []))
    file_evidence["parsed_procurement_count"] = len(parsed.get("procurements", []))
    file_evidence["parsed_bid_count"] = len(parsed.get("bids", []))
    file_evidence["parsed_award_count"] = len(parsed.get("awards", []))
    file_evidence["parsed_contract_count"] = len(parsed.get("contracts", []))
    file_evidence["parsed_invoice_count"] = len(parsed.get("invoices", []))

    return file_evidence, parsed


def aggregate_parsed(parsed_list: List[Dict[str, Any]]) -> Dict[str, Any]:
    agg = empty_parsed()
    for p in parsed_list:
        for key in agg.keys():
            if isinstance(agg[key], list) and isinstance(p.get(key), list):
                agg[key].extend(p[key])
        for key in agg.keys():
            if isinstance(agg[key], list):
                agg[key] = unique_preserve_order(agg[key])[:200000]
    return agg


def build_source_independence(parsed: Dict[str, Any]) -> None:
    sources = parsed.get("sources", [])
    hash_groups: Dict[str, List[str]] = defaultdict(list)
    fp_groups: Dict[str, List[str]] = defaultdict(list)
    publisher_groups: Dict[str, List[str]] = defaultdict(list)

    for s in sources:
        sid = s.get("source_id")
        fh = s.get("file_hash")
        fp = s.get("content_fingerprint")
        pub = normalize_text(s.get("publisher") or "")
        if fh:
            hash_groups[fh].append(sid)
        if fp:
            fp_groups[fp].append(sid)
        if pub:
            publisher_groups[pub].append(sid)

    for s in sources:
        fh = s.get("file_hash")
        fp = s.get("content_fingerprint")
        pub = normalize_text(s.get("publisher") or "")

        if fh and len(hash_groups.get(fh, [])) > 1:
            s["source_independence_state"] = "DEPENDENT_COPIES"
            s["source_family_count"] = 1
        elif fp and len(fp_groups.get(fp, [])) > 1:
            s["source_independence_state"] = "DEPENDENT_CONTENT_FAMILY"
            s["source_family_count"] = 1
        elif pub and len(publisher_groups.get(pub, [])) > 1:
            s["source_independence_state"] = "PARTIALLY_DEPENDENT_PENDING_REVIEW"
            s["source_family_count"] = 1
        elif len(sources) > 1:
            s["source_independence_state"] = "UNKNOWN_POTENTIALLY_INDEPENDENT"
            s["source_family_count"] = len(sources)
        else:
            s["source_independence_state"] = "SINGLE_SOURCE"
            s["source_family_count"] = 1


def calculate_concentration_metrics(parsed: Dict[str, Any]) -> None:
    """Calculates supplier share of awards/value."""
    metrics = []
    
    # Group awards by supplier
    supplier_awards: Dict[str, List[Dict[str, Any]]] = defaultdict(list)
    for aw in parsed.get("awards", []):
        w_ref = aw.get("winner_ref")
        if w_ref:
            supplier_awards[w_ref].append(aw)
            
    total_awards = len(parsed.get("awards", []))
    if total_awards == 0:
        return
        
    for s_ref, awards in supplier_awards.items():
        count_share = len(awards) / total_awards
        # Sum values where available
        total_val = sum(dec(a.get("award_value_decimal")) for a in awards if a.get("award_value_decimal"))
        
        metrics.append({
            "metric_id": f"MET-{uuid.uuid4()}",
            "supplier_ref": s_ref,
            "award_count": len(awards),
            "total_award_count": total_awards,
            "count_share_percent": round(count_share * 100, 2),
            "total_award_value": str(total_val),
            "limitations": [
                "Share calculated on observed dataset only. Market coverage may be incomplete.",
                "High share does not automatically imply favoritism; could reflect specialization/performance.",
            ],
        })
        
    parsed["concentration_metrics"] = metrics[:1000]


def detect_anomalies(parsed: Dict[str, Any]) -> None:
    anomalies = []
    
    # Single Bid Detection
    for proc in parsed.get("procurements", []):
        p_id = proc.get("procurement_record_id")
        bids_for_proc = [b for b in parsed.get("bids", []) if b.get("procurement_ref") == p_id]
        
        if len(bids_for_proc) == 1:
            anomalies.append({
                "anomaly_id": f"ANOM-{uuid.uuid4()}",
                "type": "SINGLE_BID_OBSERVED",
                "subject": p_id,
                "details": f"Only 1 bid recorded for procurement {p_id}.",
                "benign_explanations": [
                    "Specialized requirement",
                    "Limited market",
                    "Emergency procurement",
                    "Technical compatibility",
                    "Poor tender design",
                ],
                "limitations": [
                    "Single bid is an observation, not proof of corruption.",
                ],
            })
            
    # Value Escalation Detection
    for ct in parsed.get("contracts", []):
        init_v = dec(ct.get("initial_value_decimal"))
        curr_v = dec(ct.get("current_value_decimal"))
        
        if init_v > 0 and curr_v > init_v:
            pct_change = ((curr_v - init_v) / init_v) * 100
            if pct_change > 20: # Threshold for review
                anomalies.append({
                    "anomaly_id": f"ANOM-{uuid.uuid4()}",
                    "type": "CONTRACT_VALUE_ESCALATION",
                    "subject": ct.get("contract_record_id"),
                    "details": f"Current value increased by {round(pct_change, 2)}% over initial value.",
                    "benign_explanations": [
                        "Documented scope expansion",
                        "Inflation adjustment",
                        "Unforeseen conditions",
                        "Change orders",
                    ],
                    "limitations": [
                        "Escalation merits review, not automatic accusation.",
                    ],
                })

    parsed["anomalies"] = anomalies[:1000]


def detect_related_party_signals(parsed: Dict[str, Any]) -> None:
    """Checks for shared directors/addresses among bidders in same tender."""
    signals = []
    
    # Map Procurement -> Bidders
    proc_bidders: Dict[str, Set[str]] = defaultdict(set)
    for bid in parsed.get("bids", []):
        p_ref = bid.get("procurement_ref")
        b_ref = bid.get("bidder_ref")
        if p_ref and b_ref:
            proc_bidders[p_ref].add(b_ref)
            
    # Get Entity Details
    ent_map = {e["entity_id"]: e for e in parsed.get("entities", [])}
    
    for p_id, bidders in proc_bidders.items():
        if len(bidders) < 2:
            continue
            
        # Compare pairs
        b_list = list(bidders)
        for i in range(len(b_list)):
            for j in range(i+1, len(b_list)):
                e1 = ent_map.get(b_list[i])
                e2 = ent_map.get(b_list[j])
                
                if not e1 or not e2:
                    continue
                    
                # Check Address
                addr1 = normalize_text(e1.get("location", ""))
                addr2 = normalize_text(e2.get("location", ""))
                
                if addr1 and addr2 and addr1 == addr2:
                    signals.append({
                        "signal_id": f"SIG-{uuid.uuid4()}",
                        "type": "SHARED_ADDRESS_CANDIDATE",
                        "procurement_ref": p_id,
                        "entities": [b_list[i], b_list[j]],
                        "details": f"Two bidders in {p_id} share identical normalized address.",
                        "benign_explanations": [
                            "Coworking space",
                            "Accountant office",
                            "Formation agent",
                            "Group companies",
                        ],
                        "limitations": [
                            "Shared address alone does not prove collusion.",
                        ],
                    })
                    
                # Check Registration ID (if distinct entities shouldn't share it usually, but maybe typo/group)
                reg1 = normalize_text(e1.get("registration_id", ""))
                reg2 = normalize_text(e2.get("registration_id", ""))
                if reg1 and reg2 and reg1 == reg2 and b_list[i] != b_list[j]:
                     signals.append({
                        "signal_id": f"SIG-{uuid.uuid4()}",
                        "type": "SHARED_REGISTRATION_ID_CANDIDATE",
                        "procurement_ref": p_id,
                        "entities": [b_list[i], b_list[j]],
                        "details": f"Two distinct bidder records share registration ID in {p_id}.",
                        "benign_explanations": [
                            "Data entry error",
                            "Parent/Subsidiary confusion",
                            "Branch offices",
                        ],
                        "limitations": [
                            "Requires entity resolution verification.",
                        ],
                    })

    parsed["related_party_signals"] = signals[:1000]


def build_contradictions(parsed: Dict[str, Any]) -> List[Dict[str, Any]]:
    contradictions = []
    
    # Award vs Contract Value Conflict
    award_map = {a["award_record_id"]: a for a in parsed.get("awards", [])}
    
    for ct in parsed.get("contracts", []):
        aw_ref = ct.get("award_ref")
        if aw_ref and aw_ref in award_map:
            aw_val = dec(award_map[aw_ref].get("award_value_decimal"))
            ct_init_val = dec(ct.get("initial_value_decimal"))
            
            if aw_val > 0 and ct_init_val > 0 and aw_val != ct_init_val:
                contradictions.append({
                    "contradiction_id": f"CON-{uuid.uuid4()}",
                    "type": "AWARD_CONTRACT_VALUE_MISMATCH",
                    "subject": ct.get("contract_record_id"),
                    "values": {"award_value": str(aw_val), "contract_initial_value": str(ct_init_val)},
                    "possible_explanations": [
                        "Tax inclusion/exclusion difference",
                        "Currency conversion",
                        "Negotiated reduction/increase post-award",
                        "Lot aggregation difference",
                    ],
                    "resolution_status": "UNRESOLVED",
                    "caution": "Do not assume fraud; check tax/currency/terms.",
                })
                
    contradictions, _ = truncate_list(contradictions, 5000)
    return contradictions


def build_hypotheses(parsed: Dict[str, Any]) -> List[Dict[str, Any]]:
    hyps = []
    anomalies = parsed.get("anomalies", [])
    signals = parsed.get("related_party_signals", [])
    
    if not anomalies and not signals:
        hyps.append({
            "hypothesis_id": f"HYP-{uuid.uuid4()}",
            "statement": "No significant procurement anomalies or related-party signals detected in local dataset.",
            "supporting_facts": ["Clean scan results."],
            "opposing_facts": [],
            "unknowns": ["External market data", "Private evaluations"],
            "next_test": "Expand dataset coverage or verify specific high-value contracts manually.",
            "status": "OPEN",
        })
        return hyps[:1000]

    if any(a["type"] == "SINGLE_BID_OBSERVED" for a in anomalies):
        hyps.extend([
            {
                "hypothesis_id": f"HYP-{uuid.uuid4()}",
                "statement": "Single-bid scenario reflects specialized market/emergency need.",
                "supporting_facts": ["Market structure analysis pending."],
                "opposing_facts": ["Restrictive specs candidate."],
                "unknowns": ["Justification documentation", "Competitor feedback"],
                "falsification_conditions": ["Specs found non-restrictive and market broad."],
                "next_test": "Review tender specifications for brand-specific/unreasonable constraints.",
                "status": "OPEN",
            },
            {
                "hypothesis_id": f"HYP-{uuid.uuid4()}",
                "statement": "Single-bid scenario reflects procedural irregularity or lack of outreach.",
                "supporting_facts": ["Publication timing/channel analysis pending."],
                "opposing_facts": ["Valid emergency exemption."],
                "unknowns": ["Notification logs", "Waiver approvals"],
                "falsification_conditions": ["Proper notification and waiver evidence exists."],
                "next_test": "Verify publication compliance and exemption justification.",
                "status": "OPEN",
            },
        ])

    if any(s["type"] == "SHARED_ADDRESS_CANDIDATE" for s in signals):
        hyps.append({
            "hypothesis_id": f"HYP-{uuid.uuid4()}",
            "statement": "Shared address between bidders suggests potential group affiliation or administrative convenience.",
            "supporting_facts": ["Address match detected."],
            "opposing_facts": ["Coworking/Agent address."],
            "unknowns": ["Beneficial ownership link", "Independence declaration"],
            "falsification_conditions": ["Entities confirmed unrelated via registry/BO check."],
            "next_test": "Handoff to OWNERSHIPINT/CORPINT for beneficial ownership resolution.",
            "status": "OPEN",
        })

    hyps, _ = truncate_list(hyps, 1000)
    return hyps


def build_knowledge_gaps(payload: Dict[str, Any], files: List[Dict[str, Any]], parsed: Dict[str, Any]) -> List[Dict[str, Any]]:
    gaps = []
    procurements = parsed.get("procurements", [])
    contracts = parsed.get("contracts", [])
    invoices = parsed.get("invoices", [])
    
    if not files:
        gaps.append({
            "gap_id": f"GAP-{uuid.uuid4()}",
            "question": "What lawful/authorized procurement evidence exists?",
            "missing_evidence": "No local PROCUREMENTINT artifact supplied.",
            "likely_source": "Official portal export, ERP dump, public register CSV.",
            "specialist_owner": "PROCUREMENTINT AI Employee",
            "priority": "HIGH",
            "expected_information_value": "Enables baseline procurement analysis.",
            "safety_boundary": "No confidential bid access, no portal bypass.",
        })

    if procurements and not contracts:
        gaps.append({
            "gap_id": f"GAP-{uuid.uuid4()}",
            "question": "Which awarded tenders resulted in signed contracts?",
            "missing_evidence": "Contract records missing.",
            "likely_source": "Contract register, signed PDF metadata, PO system.",
            "specialist_owner": "PROCUREMENTINT / LEGALINT",
            "priority": "HIGH",
            "expected_information_value": "Links award to obligation.",
            "safety_boundary": "Award notice is not contract.",
        })

    if contracts and not invoices:
        gaps.append({
            "gap_id": f"GAP-{uuid.uuid4()}",
            "question": "Which active contracts have corresponding invoices?",
            "missing_evidence": "Invoice records missing.",
            "likely_source": "AP ledger, ERP invoice table.",
            "specialist_owner": "PROCUREMENTINT / PAYMENTINT",
            "priority": "MEDIUM_HIGH",
            "expected_information_value": "Verifies billing against contract.",
            "safety_boundary": "Contract does not prove invoicing.",
        })

    gaps, _ = truncate_list(gaps, 500)
    return gaps


def build_specialist_handoffs(parsed: Dict[str, Any]) -> List[Dict[str, Any]]:
    handoffs = []
    entities = parsed.get("entities", [])
    signals = parsed.get("related_party_signals", [])
    anomalies = parsed.get("anomalies", [])
    
    if signals:
        handoffs.append({
            "specialist": "OWNERSHIPINT / CORPINT",
            "reason": "Related-party/address-sharing signals detected.",
            "expected_output": "Beneficial ownership resolution, corporate relationship mapping.",
            "question": "Are the bidders legally/operationally independent?",
        })
        
    if any(a["type"] == "CONTRACT_VALUE_ESCALATION" for a in anomalies):
        handoffs.append({
            "specialist": "FININT / AUDITINT",
            "reason": "Significant contract value escalation detected.",
            "expected_output": "Financial variance analysis, audit trail verification.",
            "question": "Is the value increase supported by documented change orders?",
        })
        
    if any(e.get("entity_type") == "SUPPLIER" for e in entities):
        handoffs.append({
            "specialist": "SUPPLYCHAININT",
            "reason": "Supplier dependencies identified.",
            "expected_output": "Fourth-party risk, resilience assessment.",
            "question": "What are the upstream/downstream dependencies of these suppliers?",
        })

    if not handoffs:
        handoffs.append({
            "specialist": "PROCUREMENTINT Manager",
            "reason": "Standard analysis completed.",
            "expected_output": "Review findings, approve closure or deep dive.",
            "question": "Are current insights sufficient for decision making?",
        })

    return handoffs


def finalize_parsed(parsed: Dict[str, Any], payload: Optional[Dict[str, Any]] = None, files: Optional[List[Dict[str, Any]]] = None) -> Dict[str, Any]:
    payload = payload or {}
    build_source_independence(parsed)
    calculate_concentration_metrics(parsed)
    detect_anomalies(parsed)
    detect_related_party_signals(parsed)
    parsed["contradictions"] = build_contradictions(parsed)
    parsed["hypotheses"] = build_hypotheses(parsed)
    parsed["knowledge_gaps"] = build_knowledge_gaps(payload, files or [], parsed)
    parsed["specialist_handoffs"] = build_specialist_handoffs(parsed)
    return parsed


def build_next_best_action(
    payload: Dict[str, Any],
    policy: Dict[str, Any],
    files: List[Dict[str, Any]],
    parsed: Dict[str, Any],
) -> Dict[str, str]:
    anomalies = parsed.get("anomalies", [])
    signals = parsed.get("related_party_signals", [])
    
    if policy.get("status") == "POLICY_BLOCKED":
        return {
            "action": "Revise task to remove prohibited bid-rigging, bribery, confidential data theft, or evasion behavior.",
            "reason": "PROCUREMENTINT is defensive transparency intelligence, not manipulation tool.",
            "owner": "PROCUREMENTINT Manager",
            "expected_output": "Policy-compliant defensive scope.",
        }

    if not files:
        return {
            "action": "Attach lawful/authorized tender/contract/invoice exports before analysis.",
            "reason": "No PROCUREMENTINT evidence artifact available.",
            "owner": "PROCUREMENTINT AI Employee",
            "expected_output": "Evidence inventory.",
        }

    if signals:
        return {
            "action": "Resolve beneficial ownership relationships for flagged bidders via CORPINT/OWNERSHIPINT.",
            "reason": "Shared address/reg-id candidates require identity verification.",
            "owner": "PROCUREMENTINT / OWNERSHIPINT",
            "expected_output": "Confirmed independence or related-party finding.",
        }

    if any(a["type"] == "SINGLE_BID_OBSERVED" for a in anomalies):
        return {
            "action": "Review tender specifications for restrictiveness and verify emergency/sole-source justifications.",
            "reason": "Single bid requires contextual validation.",
            "owner": "PROCUREMENTINT / LEGALINT",
            "expected_output": "Justified exception or control weakness finding.",
        }

    return {
        "action": "Proceed with standard reconciliation of awards to contracts and payments.",
        "reason": "No immediate high-risk triggers detected.",
        "owner": "PROCUREMENTINT / FININT",
        "expected_output": "Verified lifecycle report.",
    }


def build_collection_plan(
    payload: Dict[str, Any],
    questions: List[Any],
    files: List[Dict[str, Any]],
    parsed: Dict[str, Any],
) -> List[Dict[str, Any]]:
    plan = []
    priority = 1
    questions_limited, _ = truncate_list([str(q) for q in questions], 8)

    has_files = bool(files)
    has_procs = bool(parsed.get("procurements"))
    has_contracts = bool(parsed.get("contracts"))
    has_invoices = bool(parsed.get("invoices"))

    def add(operation: str, tool: str, purpose: str, status: str, expected_output: str, safety_risk: str = "LOW") -> None:
        nonlocal priority
        plan.append({
            "question": questions_limited[0] if questions_limited else "General PROCUREMENTINT planning",
            "operation": operation,
            "tool_or_provider": tool,
            "purpose": purpose,
            "status": status,
            "expected_output": expected_output,
            "priority": priority,
            "safety_risk": safety_risk,
            "policy_note": "Lawful / authorized / public-record / evidence-first procurement intelligence only.",
            "authorization_status": "ALLOWED_DEFENSIVE_AUTHORIZED",
            "execution_status": "NOT_EXECUTED_PLANNING_ONLY",
        })
        priority += 1

    add(
        "define_procurement_questions_scope",
        "PROCUREMENTINT Manager",
        "Convert objective into procurement questions, allowed sources, and privacy boundaries.",
        "COMPLETED_LOCAL" if payload.get("questions") else "REQUIRED_BEFORE_COLLECTION",
        "Requirement-driven collection plan.",
    )

    add(
        "preserve_original_procurement_evidence",
        "local evidence store",
        "Store original tenders/bids/contracts/invoices and hashes without modification.",
        "COMPLETED_LOCAL" if has_files else "PLANNED_REQUIRES_EVIDENCE",
        "ProcurementEvidenceObject with SHA256.",
    )

    add(
        "parse_tender_bid_award_contract_records",
        "local deterministic parser",
        "Parse JSON/CSV/TXT procurement metadata safely.",
        "COMPLETED_LOCAL" if has_files else "PLANNED_REQUIRES_EVIDENCE",
        "Normalized procurements/bids/awards/contracts/invoices.",
    )

    add(
        "resolve_buyer_supplier_entities",
        "local resolver",
        "Resolve buyers, authorities, suppliers, bidders while avoiding false identity merging.",
        "COMPLETED_LOCAL" if has_procs else "PLANNED_REQUIRES_ENTITY_EVIDENCE",
        "Canonical entity candidates.",
    )

    add(
        "analyze_competition_and_anomalies",
        "local analyzer",
        "Detect single-bid patterns, value escalations, and related-party signals.",
        "COMPLETED_LOCAL" if parsed.get("anomalies") or parsed.get("related_party_signals") else "PLANNED_ANALYTIC",
        "Anomaly register and benign explanations.",
        safety_risk="HIGH_IF_OVERCLAIMED_AS_CORRUPTION",
    )

    add(
        "reconcile_contract_invoice_payment",
        "PROCUREMENTINT / PAYMENTINT",
        "Link contracts to invoices and verify payment status (handoff).",
        "COMPLETED_LOCAL" if has_invoices else "PLANNED_HANDOFF",
        "Lifecycle reconciliation states.",
    )

    return plan


def policy_screen(payload: Dict[str, Any]) -> Dict[str, Any]:
    scanned_fields = [
        "objective",
        "target",
        "questions",
        "buyers",
        "suppliers",
        "bids",
        "awards",
        "contracts",
        "ownership_data",
    ]

    parts: List[str] = []
    for key in scanned_fields:
        val = payload.get(key)
        if isinstance(val, list):
            parts.extend(str(x) for x in val)
        elif isinstance(val, dict):
            parts.append(json.dumps(val, ensure_ascii=False, default=str))
        else:
            parts.append(str(val or ""))

    scanned = " \n ".join(parts).lower()

    blocked_reasons: List[str] = []
    for pat in POLICY_BLOCK_PATTERNS:
        rx = re.compile(pat, re.I)
        for m in rx.finditer(scanned):
            start = max(0, m.start() - 180)
            prefix = scanned[start:m.start()]
            if NEGATION_RE.search(prefix):
                continue
            blocked_reasons.append(pat)
            break

    human_review_required = False
    safety_notes: List[str] = []

    if payload.get("target_type") in SENSITIVE_TARGET_TYPES:
        human_review_required = True
        safety_notes.append(
            "Sensitive procurement context detected. Analysis must remain lawful, authorized, and evidence-first. "
            "No bid rigging, bribery, confidential theft, or manipulation."
        )

    if payload.get("ownership_data") or payload.get("related_party_signals"):
        human_review_required = True
        safety_notes.append(
            "Ownership/Related-party context detected. Consequential conflict/collusion findings require human/legal review."
        )

    if blocked_reasons:
        return {
            "status": "POLICY_BLOCKED",
            "reasons": sorted(set(blocked_reasons)),
            "human_review_required": True,
            "safety_notes": safety_notes,
            "explanation": (
                "The requested task appears to require illegal procurement manipulation, confidential data theft, bribery, or collusion coordination."
            ),
            "safe_alternatives": SAFE_ALTERNATIVES,
        }

    if human_review_required:
        return {
            "status": "HUMAN_REVIEW_REQUIRED",
            "reasons": [],
            "human_review_required": True,
            "safety_notes": safety_notes,
            "explanation": (
                "No obvious hard policy violation detected, but sensitive ownership/competition/fraud context applies. "
                "Conclusions must remain defensive, evidence-linked, and human-reviewed before consequential action."
            ),
            "safe_alternatives": SAFE_ALTERNATIVES,
        }

    return {
        "status": "ALLOWED_DEFENSIVE_AUTHORIZED",
        "reasons": [],
        "human_review_required": False,
        "safety_notes": [],
        "explanation": (
            "No obvious policy violation detected. Execution remains planning-only unless authorized/public/lawful procurement evidence is configured."
        ),
        "safe_alternatives": [],
    }


def validate_payload(payload: Dict[str, Any]) -> List[str]:
    warnings: List[str] = []

    required = ["case_id", "task_id", "objective", "target", "target_type"]
    for field in required:
        if not payload.get(field):
            warnings.append(f"Missing required field: {field}")

    if not payload.get("questions"):
        warnings.append("No PROCUREMENTINT questions provided. Default questions will be inferred.")

    evidence_keys = [
        "buyers",
        "suppliers",
        "procurement_ids",
        "tender_paths",
        "bid_paths",
        "award_paths",
        "invoice_paths",
    ]

    if not any(payload.get(k) for k in evidence_keys):
        warnings.append("No procurement evidence provided. Output remains planning-only.")

    if not payload.get("time_range"):
        warnings.append("No time range provided. Procurement lifecycles are highly temporal.")

    if not payload.get("configured_connectors"):
        warnings.append("No portal/ERP/registry connector configured. External correlation remains planning-only.")

    return warnings


def default_questions(payload: Dict[str, Any]) -> List[str]:
    return [
        "What procurement processes exist and which stage is each at?",
        "Who are the verified buyers, procuring authorities, and suppliers?",
        "Which bidders participated and what were their bid values?",
        "Were there single-bid scenarios, and what are the benign explanations?",
        "Which awards resulted in signed contracts?",
        "Have contract values escalated significantly since initial award/signing?",
        "Are there related-party signals (shared address/directors) among bidders?",
        "Which invoices match which contracts/POs?",
        "What remains unknown regarding delivery or payment status?",
        "What defensive next actions preserve integrity without accessing confidential data?",
    ]


class TraceAtlasPROCUREMENTINTPanel(tk.Tk):
    def __init__(self) -> None:
        super().__init__()
        self.title(APP_TITLE)
        self.geometry("1380x940")
        self.minsize(1100, 760)

        self.entries: Dict[str, Any] = {}
        self.last_result: Dict[str, Any] = {}

        self.analyzed_files: List[Dict[str, Any]] = []
        self.parsed: Dict[str, Any] = empty_parsed()

        self._configure_style()
        self._build_ui()
        self._set_defaults()

    def _configure_style(self) -> None:
        style = ttk.Style(self)
        try:
            style.theme_use("clam")
        except tk.TclError:
            pass

        self.configure(bg="#0b0f19")
        style.configure("TFrame", background="#0b0f19")
        style.configure("TLabel", background="#0b0f19", foreground="#e5e7eb", font=("Segoe UI", 10))
        style.configure("Header.TLabel", background="#0b0f19", foreground="#fb923c", font=("Segoe UI", 17, "bold")) # Orange accent
        style.configure("Subheader.TLabel", background="#0b0f19", foreground="#94a3b8", font=("Segoe UI", 9))
        style.configure("TNotebook", background="#0b0f19", borderwidth=0)
        style.configure("TNotebook.Tab", padding=[14, 7], font=("Segoe UI", 10, "bold"))
        style.configure("TEntry", fieldbackground="#111827", foreground="#e5e7eb", insertcolor="#ffffff", bordercolor="#334155")
        style.configure("TCombobox", fieldbackground="#111827", foreground="#e5e7eb", arrowcolor="#e5e7eb", bordercolor="#334155")
        style.configure("TButton", padding=7, font=("Segoe UI", 10, "bold"), background="#1f2937", foreground="#e5e7eb", bordercolor="#475569")
        style.map("TButton", background=[("active", "#334155")], foreground=[("active", "#ffffff")])
        style.configure("Vertical.TScrollbar", background="#1f2937", troughcolor="#0b0f19", arrowcolor="#e5e7eb")

    def _build_ui(self) -> None:
        header = ttk.Frame(self)
        header.pack(fill="x", padx=16, pady=(14, 8))
        ttk.Label(header, text="TraceAtlas PROCUREMENTINT AI Employee", style="Header.TLabel").pack(anchor="w")
        ttk.Label(
            header,
            text=(
                "Lawful / authorized / public-record / evidence-first procurement intelligence • Planning-only by default • "
                "Local deterministic JSON/CSV/TXT tender/bid/award/contract/invoice parsing only • "
                "No bid rigging / no bribery / no confidential theft / no score manipulation / no threshold evasion • "
                "Tender != Contract • Bid != Award • Award != Signed Contract • Single Bidder != Corruption"
            ),
            style="Subheader.TLabel",
            wraplength=1280,
            justify="left",
        ).pack(anchor="w", pady=(2, 0))

        self.notebook = ttk.Notebook(self)
        self.notebook.pack(fill="both", expand=True, padx=16, pady=(8, 16))

        self.input_tab = ttk.Frame(self.notebook)
        self.output_tab = ttk.Frame(self.notebook)

        self.notebook.add(self.input_tab, text="PROCUREMENTINT Task Input")
        self.notebook.add(self.output_tab, text="Output / Procurement Plan / Evidence")

        self._build_input_tab()
        self._build_output_tab()

    def _build_input_tab(self) -> None:
        container = ttk.Frame(self.input_tab)
        container.pack(fill="both", expand=True)

        self.canvas = tk.Canvas(container, bg="#0b0f19", highlightthickness=0)
        scrollbar = ttk.Scrollbar(container, orient="vertical", command=self.canvas.yview)
        self.form = ttk.Frame(self.canvas)

        self.form.bind("<Configure>", lambda e: self.canvas.configure(scrollregion=self.canvas.bbox("all")))
        self.canvas_window = self.canvas.create_window((0, 0), window=self.form, anchor="nw")
        self.canvas.configure(yscrollcommand=scrollbar.set)

        self.canvas.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")

        row = 0
        for key, label, kind in FIELDS:
            ttk.Label(self.form, text=label).grid(row=row, column=0, sticky="nw", padx=10, pady=6)
            if kind == "entry":
                widget = ttk.Entry(self.form, width=102)
            elif kind == "combo":
                widget = ttk.Combobox(self.form, values=TARGET_TYPES if key == "target_type" else [], width=100, state="readonly")
            else:
                widget = tk.Text(self.form, height=3, width=102, bg="#111827", fg="#e5e7eb", insertbackground="white", relief="flat", highlightthickness=1, highlightbackground="#334155", font=("Segoe UI", 10), wrap="word")
            widget.grid(row=row, column=1, sticky="ew", padx=10, pady=6)
            self.entries[key] = widget
            row += 1

        self.form.columnconfigure(1, weight=1)

        buttons1 = ttk.Frame(self.input_tab)
        buttons1.pack(fill="x", padx=10, pady=(12, 4))
        buttons2 = ttk.Frame(self.input_tab)
        buttons2.pack(fill="x", padx=10, pady=(0, 12))

        ttk.Button(buttons1, text="Add Tenders / Notices", command=self.add_tenders).pack(side="left", padx=4)
        ttk.Button(buttons1, text="Add Bids / Participation", command=self.add_bids).pack(side="left", padx=4)
        ttk.Button(buttons1, text="Add Awards / Contracts", command=self.add_awards_contracts).pack(side="left", padx=4)
        ttk.Button(buttons1, text="Add Invoices / Payments", command=self.add_invoices_payments).pack(side="left", padx=4)
        ttk.Button(buttons1, text="Add STIX / MISP", command=self.add_stix_misp).pack(side="left", padx=4)

        ttk.Button(buttons2, text="Analyze Local PROCUREMENTINT Evidence", command=self.analyze_local_procurement).pack(side="left", padx=4)
        ttk.Button(buttons2, text="Run Policy Screen", command=self.run_policy_screen).pack(side="left", padx=4)
        ttk.Button(buttons2, text="Generate Procurement Plan", command=self.generate_plan).pack(side="left", padx=4)
        ttk.Button(buttons2, text="Export JSON", command=self.export_json).pack(side="left", padx=4)
        ttk.Button(buttons2, text="Copy Output", command=self.copy_output).pack(side="left", padx=4)
        ttk.Button(buttons2, text="Clear Form", command=self.clear_form).pack(side="left", padx=4)

    def _build_output_tab(self) -> None:
        container = ttk.Frame(self.output_tab)
        container.pack(fill="both", expand=True)
        self.output = tk.Text(container, wrap="word", bg="#020617", fg="#ffedd5", insertbackground="white", relief="flat", highlightthickness=1, highlightbackground="#334155", font=("Consolas", 11))
        output_scroll = ttk.Scrollbar(container, orient="vertical", command=self.output.yview)
        self.output.configure(yscrollcommand=output_scroll.set)
        self.output.pack(side="left", fill="both", expand=True)
        output_scroll.pack(side="right", fill="y")

    def _set_defaults(self) -> None:
        self.set_widget_value("case_id", "PROCUREMENT-CASE-001")
        self.set_widget_value("task_id", "PROC-TASK-001")
        self.set_widget_value("objective", "Analyze lawful/authorized/defensive procurement intelligence using evidence-first methods.")
        self.set_widget_value("target", "Illustrative example.com / authorized procurement context")
        self.set_widget_value("target_type", "tender_analysis")
        self.set_widget_value("questions", "\n".join(default_questions({"target": "Illustrative example.com"})))
        
        for field in LIST_FIELDS.union(DICT_FIELDS):
            if field not in ["questions", "scope", "authorization", "time_range"]:
                 self.set_widget_value(field, "")
                 
        self.set_widget_value("time_range", json.dumps({"from": "", "to": "", "timezone": "UTC"}, indent=2))
        self.set_widget_value("scope", json.dumps({"allowed_sources": ["public_portal", "erp_export"], "prohibited_actions": ["steal_bid", "rig_price"]}, indent=2))
        self.set_widget_value("authorization", json.dumps({"basis": "internal_audit_compliance"}, indent=2))
        self.set_widget_value("configured_connectors", "None configured.")

    def get_widget_value(self, key: str) -> str:
        widget = self.entries.get(key)
        if widget is None: return ""
        if isinstance(widget, tk.Text): return widget.get("1.0", "end-1c").strip()
        if isinstance(widget, ttk.Combobox): return widget.get().strip()
        if isinstance(widget, ttk.Entry): return widget.get().strip()
        return ""

    def set_widget_value(self, key: str, value: str) -> None:
        widget = self.entries.get(key)
        if widget is None: return
        if isinstance(widget, tk.Text):
            widget.delete("1.0", "end")
            widget.insert("1.0", value)
        elif isinstance(widget, ttk.Combobox):
            widget.set(value)
        elif isinstance(widget, ttk.Entry):
            widget.delete(0, "end")
            widget.insert(0, value)

    def collect_payload(self) -> Dict[str, Any]:
        payload: Dict[str, Any] = {}
        for key, _, _ in FIELDS:
            raw = self.get_widget_value(key)
            if key in LIST_FIELDS: payload[key] = parse_list(raw)
            elif key in DICT_FIELDS: payload[key] = parse_dict(raw)
            else: payload[key] = raw
        payload["generated_at"] = now_utc()
        payload["panel_version"] = APP_VERSION
        payload["operating_mode"] = "PLANNING_ONLY_LAWFUL_AUTHORIZED_EVIDENCE_FIRST"
        return payload

    def _append_paths(self, field: str, paths: Tuple[str, ...], title: str) -> None:
        if not paths: return
        current = self.get_widget_value(field)
        added = "\n".join(paths)
        new_value = current + ("\n" if current else "") + added
        self.set_widget_value(field, new_value)
        messagebox.showinfo(title, f"{len(paths)} path(s) added.")

    def add_tenders(self): self._append_paths("tender_paths", filedialog.askopenfilenames(title="Select Tenders", filetypes=[("Docs", "*.json *.csv *.txt"), ("All", "*.*")]), "Added")
    def add_bids(self): self._append_paths("bid_paths", filedialog.askopenfilenames(title="Select Bids", filetypes=[("Docs", "*.json *.csv *.txt"), ("All", "*.*")]), "Added")
    def add_awards_contracts(self): self._append_paths("award_paths", filedialog.askopenfilenames(title="Select Awards/Contracts", filetypes=[("Docs", "*.json *.csv *.txt"), ("All", "*.*")]), "Added")
    def add_invoices_payments(self): self._append_paths("invoice_paths", filedialog.askopenfilenames(title="Select Invoices", filetypes=[("Docs", "*.json *.csv *.txt"), ("All", "*.*")]), "Added")
    def add_stix_misp(self): self._append_paths("stix_misp_paths", filedialog.askopenfilenames(title="Select STIX/MISP", filetypes=[("Intel", "*.json *.xml"), ("All", "*.*")]), "Added")

    def run_policy_screen(self) -> None:
        payload = self.collect_payload()
        policy = policy_screen(payload)
        result = {"mode": "POLICY_SCREEN_ONLY", "policy_screen": policy}
        self.last_result = result
        self._write_output(result)
        self.notebook.select(self.output_tab)
        if policy["status"] == "POLICY_BLOCKED":
            messagebox.showwarning("Blocked", "Policy Blocked.")
        elif policy["status"] == "HUMAN_REVIEW_REQUIRED":
            messagebox.showwarning("Review", "Human Review Required.")
        else:
            messagebox.showinfo("OK", "Allowed.")

    def analyze_local_procurement(self) -> None:
        payload = self.collect_payload()
        policy = policy_screen(payload)
        if policy["status"] == "POLICY_BLOCKED":
            messagebox.showwarning("Blocked", "Analysis blocked.")
            return

        path_fields = ["tender_paths", "bid_paths", "award_paths", "invoice_paths", "stix_misp_paths"]
        all_paths = []
        seen = set()
        for field in path_fields:
            for p in payload.get(field, []):
                sp = str(p).strip()
                if sp and sp not in seen:
                    seen.add(sp)
                    all_paths.append(sp)

        if not all_paths:
            messagebox.showwarning("No Evidence", "Add files first.")
            return

        self.output.delete("1.0", "end")
        self.output.insert("1.0", "Analyzing...\n")
        self.notebook.select(self.output_tab)
        self.update()

        files = []
        parsed_list = []
        for p in all_paths[:30]:
            f, parsed = analyze_procurement_file(p, payload.get("case_id", ""), payload.get("task_id", ""))
            files.append(f)
            parsed_list.append(parsed)

        aggregated = finalize_parsed(aggregate_parsed(parsed_list), payload, files)
        self.analyzed_files = files
        self.parsed = aggregated

        report = self._build_local_analysis_report(files, aggregated, payload, policy)
        self.last_result = report
        self._write_output(report)
        
        messagebox.showinfo("Done", f"Parsed {len(files)} files.\nProcurements: {len(aggregated['procurements'])}\nContracts: {len(aggregated['contracts'])}")

    def generate_plan(self) -> None:
        payload = self.collect_payload()
        warnings = validate_payload(payload)
        policy = policy_screen(payload)
        if policy["status"] == "POLICY_BLOCKED":
            messagebox.showwarning("Blocked", "Plan blocked.")
            return

        questions = payload.get("questions") or default_questions(payload)
        if not self.parsed.get("procurements") and not self.parsed.get("contracts"):
            self.parsed = finalize_parsed(empty_parsed(), payload, self.analyzed_files)

        next_action = build_next_best_action(payload, policy, self.analyzed_files, self.parsed)
        collection_plan = build_collection_plan(payload, questions, self.analyzed_files, self.parsed)

        result = {
            "mode": "PLANNING_PLUS_LOCAL_DETERMINISTIC_EVIDENCE" if self.analyzed_files else "PLANNING_ONLY",
            "policy_screen": policy,
            "warnings": warnings,
            "payload": payload,
            "evidence_inventory": self.analyzed_files,
            "procurements_preview": self.parsed.get("procurements", [])[:100],
            "bids_preview": self.parsed.get("bids", [])[:100],
            "awards_preview": self.parsed.get("awards", [])[:100],
            "contracts_preview": self.parsed.get("contracts", [])[:100],
            "invoices_preview": self.parsed.get("invoices", [])[:100],
            "anomalies": self.parsed.get("anomalies", []),
            "related_party_signals": self.parsed.get("related_party_signals", []),
            "concentration_metrics": self.parsed.get("concentration_metrics", []),
            "hypotheses": self.parsed.get("hypotheses", []),
            "knowledge_gaps": self.parsed.get("knowledge_gaps", []),
            "specialist_handoffs": self.parsed.get("specialist_handoffs", []),
            "next_best_action": next_action,
            "collection_plan": collection_plan,
        }
        self.last_result = result
        self._write_output(result)
        self.notebook.select(self.output_tab)

    def _build_local_analysis_report(self, files, parsed, payload, policy) -> Dict[str, Any]:
        return {
            "mode": "LOCAL_DETERMINISTIC_PROCUREMENTINT_ANALYSIS",
            "policy_screen": policy,
            "evidence_inventory": files,
            "procurements": parsed.get("procurements", [])[:300],
            "bids": parsed.get("bids", [])[:300],
            "awards": parsed.get("awards", [])[:300],
            "contracts": parsed.get("contracts", [])[:300],
            "invoices": parsed.get("invoices", [])[:300],
            "anomalies": parsed.get("anomalies", []),
            "related_party_signals": parsed.get("related_party_signals", []),
            "concentration_metrics": parsed.get("concentration_metrics", []),
            "hypotheses": parsed.get("hypotheses", []),
            "contradictions": parsed.get("contradictions", []),
            "limitations": [
                "Only local deterministic checks performed.",
                "No network access.",
                "No bid rigging, bribery, or confidential theft.",
                "Single bidder != corruption.",
                "Shared address != collusion.",
                "Value escalation != fraud.",
            ],
        }

    def _write_output(self, result: Dict[str, Any]) -> None:
        self.output.delete("1.0", "end")
        self.output.insert("1.0", json.dumps(result, ensure_ascii=False, indent=2, default=str))

    def export_json(self) -> None:
        if not self.last_result: self.generate_plan()
        data = self.last_result
        path = filedialog.asksaveasfilename(defaultextension=".json", filetypes=[("JSON", "*.json")])
        if path:
            with open(path, "w", encoding="utf-8") as f:
                json.dump(data, f, ensure_ascii=False, indent=2, default=str)
            messagebox.showinfo("Saved", path)

    def copy_output(self) -> None:
        text = self.output.get("1.0", "end-1c").strip()
        if text:
            self.clipboard_clear()
            self.clipboard_append(text)
            messagebox.showinfo("Copied", "Output copied.")

    def clear_form(self) -> None:
        if messagebox.askyesno("Confirm", "Clear all?"):
            self._set_defaults()
            self.output.delete("1.0", "end")
            self.last_result = {}
            self.analyzed_files = []
            self.parsed = empty_parsed()


if __name__ == "__main__":
    try:
        app = TraceAtlasPROCUREMENTINTPanel()
        app.mainloop()
    except tk.TclError as exc:
        print(f"GUI Error: {exc}")
        print("Logic usable as library.")