# =====================================================================
# POLICY GUARD
# =====================================================================

PROHIBITED_PATTERNS = [
    (
        "PHYSICAL_INTRUSION_OR_BYPASS",
        re.compile(
            r"\b(plan|recommend|show|explain how to|provide|optimize|support|help me)\s+"
            r"(physical intrusion|break[- ]in|covert entry|lock bypass|badge bypass|"
            r"access control bypass|alarm bypass|camera blind spot|guard evasion|"
            r"perimeter breach|tailgating|impersonate maintenance|rooftop intrusion|"
            r"tunnel intrusion|drainage intrusion)\b",
            re.IGNORECASE,
        ),
    ),
    (
        "SABOTAGE_OR_DISRUPTION",
        re.compile(
            r"\b(plan|recommend|show|explain how to|provide|optimize|support|help me)\s+"
            r"(sabotage|power disruption|water disruption|telecom disruption|HVAC sabotage|"
            r"fire system tampering|generator sabotage|explosive placement|arson|"
            r"disable safety system|control system attack|OT attack|disruption sequence)\b",
            re.IGNORECASE,
        ),
    ),
    (
        "TARGETING_OR_HOSTILE_RECONNAISSANCE",
        re.compile(
            r"\b(attack plan|targeting coordinates|weapon targeting|hostile reconnaissance|"
            r"critical infrastructure attack|chokepoint for attack|surveillance evasion|"
            r"track employee routine|track guard schedule|low-security window)\b",
            re.IGNORECASE,
        ),
    ),
    (
        "PRIVATE_RESIDENCE_OR_PERSON_TRACKING",
        re.compile(
            r"\b(private residence tracking|home layout exposure|occupancy routine|"
            r"person movement pattern|stalking|identify anonymous critic at facility)\b",
            re.IGNORECASE,
        ),
    ),
    (
        "SENSITIVE_CONTROL_EVASION_OR_COMMAND",
        re.compile(
            r"\b(disable alarm|open door|send floor plan|expose security weakness|"
            r"ignore policy and enter|bypass building management)\b",
            re.IGNORECASE,
        ),
    ),
]


# =====================================================================
# UTILITIES
# =====================================================================

def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def new_id(prefix: str, seed: str) -> str:
    h = hashlib.sha256(seed.encode("utf-8")).hexdigest()[:10]
    return f"{prefix}{h}"


def stable_hash(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def sha256_short(text: str) -> str:
    return stable_hash(text)[:16]


def jsonable(obj: Any) -> Any:
    if isinstance(obj, Enum):
        return obj.value
    if is_dataclass(obj) and not isinstance(obj, type):
        return {f.name: jsonable(getattr(obj, f.name)) for f in fields(obj)}
    if isinstance(obj, (list, tuple, set)):
        return [jsonable(x) for x in obj]
    if isinstance(obj, dict):
        return {str(k): jsonable(v) for k, v in obj.items()}
    return obj


def normalize_text(value: str) -> str:
    s = unicodedata.normalize("NFKC", value or "")
    s = s.lower().strip()
    s = re.sub(r"[^\w\s\-'.:/@]", " ", s)
    s = re.sub(r"\s+", " ", s)
    return s


def parse_dt(value: Optional[str]) -> Optional[datetime]:
    if not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except Exception:
        return None


def dt_or_min(value: Optional[str]) -> datetime:
    dt = parse_dt(value)
    return dt if dt else datetime.min.replace(tzinfo=timezone.utc)


def days_since(date_str: Optional[str], as_of: str) -> Optional[int]:
    dt = parse_dt(date_str)
    ref = parse_dt(as_of) or datetime.now(timezone.utc)
    if not dt:
        return None
    return (ref - dt).days


def policy_guard(text: str) -> List[Dict[str, str]]:
    violations: List[Dict[str, str]] = []
    for rule, rx in PROHIBITED_PATTERNS:
        m = rx.search(text or "")
        if m:
            violations.append({"rule": rule, "matched": m.group(0)})
    return violations


