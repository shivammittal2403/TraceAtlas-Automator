    incidents: List[Incident] = field(default_factory=list)
    changes: List[Change] = field(default_factory=list)
    permits: List[Permit] = field(default_factory=list)
    inspections: List[Inspection] = field(default_factory=list)
    certifications: List[Certification] = field(default_factory=list)
    resilience_evidence: List[ResilienceEvidence] = field(default_factory=list)
    imagery_observations: List[Dict[str, Any]] = field(default_factory=list)
    source_ids: List[str] = field(default_factory=list)
    evidence_ids: List[str] = field(default_factory=list)
    confidence: float = 0.0
    valid_from: Optional[str] = None
    valid_to: Optional[str] = None
    limitations: List[str] = field(default_factory=list)


@dataclass
class Finding:
    id: str
    finding_type: FindingType
    subject_id: str
    statement: str
    verification_state: VerificationState = VerificationState.INCONCLUSIVE
    confidence: float = 0.0
    facility_id: Optional[str] = None
    risk_dimension: str = "EVIDENCE_CONFIDENCE"
    source_ids: List[str] = field(default_factory=list)
    evidence_ids: List[str] = field(default_factory=list)
    sensitivity_flags: List[str] = field(default_factory=list)
    limitations: List[str] = field(default_factory=list)
    specialist_handoff: Optional[str] = None


@dataclass
class Hypothesis:
    id: str
    statement: str
    kind: str
    supporting_finding_ids: List[str] = field(default_factory=list)
    contradicting_finding_ids: List[str] = field(default_factory=list)
    assumptions: List[str] = field(default_factory=list)
    predictions: List[str] = field(default_factory=list)
    falsification_conditions: List[str] = field(default_factory=list)
    status: HypothesisStatus = HypothesisStatus.UNRESOLVED
    confidence: float = 0.0
    limitations: List[str] = field(default_factory=list)


@dataclass
class Contradiction:
    id: str
    contradiction_type: str
    description: str
    subject_ids: List[str] = field(default_factory=list)
    finding_ids: List[str] = field(default_factory=list)
    evidence_ids: List[str] = field(default_factory=list)
    source_ids: List[str] = field(default_factory=list)
    severity: str = "MEDIUM"
    status: str = "OPEN"
    recommended_resolution: str = ""


@dataclass
class KnowledgeGap:
    id: str
    gap_type: GapType
    description: str
    about_subject_ids: List[str] = field(default_factory=list)
    about_finding_ids: List[str] = field(default_factory=list)
    importance: str = "MEDIUM"
    recommended_source: str = ""
    specialist: Optional[str] = None
    expected_information_value: float = 0.0


@dataclass
class NextAction:
    id: str
    description: str
    priority: int = 1
    privacy_impact: str = "LOW_IF_AUTHORIZED"
    expected_gain: float = 0.0
    specialist: Optional[str] = None
    requires_human_approval: bool = False


@dataclass
class Recommendation:
    id: str
    category: str
    action: str
    target: str
    rationale: str
    evidence_ids: List[str] = field(default_factory=list)
    finding_ids: List[str] = field(default_factory=list)
    approval: str = "HUMAN_APPROVAL_REQUIRED"
    limitations: List[str] = field(default_factory=list)


@dataclass
class Case:
    case_id: str
    task_id: str
    objective: str
    questions: List[str] = field(default_factory=list)
    scope: List[str] = field(default_factory=lambda: [
        "lawful_authorized_defensive_facility_intelligence",
        "evidence_first",
        "no_intrusion_planning",
        "no_sabotage_planning",
        "no_targeting",
        "privacy_aware",
    ])
    authorization: str = "demo_authorized_facility_intelligence"
    facility_names: List[str] = field(default_factory=list)
    organization_names: List[str] = field(default_factory=list)
    addresses: List[str] = field(default_factory=list)
    coordinates: List[str] = field(default_factory=list)
    parcels: List[str] = field(default_factory=list)
    buildings: List[str] = field(default_factory=list)
    campuses: List[str] = field(default_factory=list)
    time_range: Optional[str] = None
    as_of: str = DEFAULT_AS_OF
    sample: bool = False


# =====================================================================
# FACILITYINT ENGINE
# =====================================================================

class FacilityInt:
    def __init__(self, case: Case) -> None:
        self.case = case
        self.as_of = case.as_of or DEFAULT_AS_OF

        self.sources: Dict[str, Source] = {}
        self.evidence: Dict[str, Evidence] = {}
        self.facilities: Dict[str, Facility] = {}
        self.sites: Dict[str, Site] = {}
        self.parcels: Dict[str, Parcel] = {}
        self.buildings: Dict[str, Building] = {}
        self.findings: Dict[str, Finding] = {}
        self.contradictions: List[Contradiction] = []
        self.hypotheses: List[Hypothesis] = []
        self.gaps: List[KnowledgeGap] = []
        self.actions: List[NextAction] = []
        self.recommendations: List[Recommendation] = []
        self.handoffs: List[Dict[str, str]] = []
        self.validation_errors: List[str] = []

    # -----------------------------------------------------------------
    # Adders
    # -----------------------------------------------------------------

    def add_source(self, source: Source) -> Source:
        self.sources[source.id] = source
        return source

    def add_evidence(self, evidence: Evidence) -> Evidence:
        if not evidence.content_hash:
            evidence.content_hash = stable_hash("|".join([
                evidence.source_id,
                evidence.artifact_type,
                evidence.excerpt,
            ]))
        self.evidence[evidence.id] = evidence
        return evidence

    def add_facility(self, facility: Facility) -> Facility:
        self.facilities[facility.id] = facility
        return facility

    def add_site(self, site: Site) -> Site:
        self.sites[site.id] = site
        return site

    def add_parcel(self, parcel: Parcel) -> Parcel:
        self.parcels[parcel.id] = parcel
        return parcel

    def add_building(self, building: Building) -> Building:
        self.buildings[building.id] = building
        return building

    def add_finding(self, finding: Finding) -> Finding:
        if finding.id in self.findings:
            return self.findings[finding.id]
        self.findings[finding.id] = finding
        return finding

    def add_contradiction(self, contradiction: Contradiction) -> Contradiction:
        if any(c.description == contradiction.description for c in self.contradictions):
            return self.contradictions[0]
        self.contradictions.append(contradiction)
        return contradiction

    # -----------------------------------------------------------------
    # Source lineage / independence
    # -----------------------------------------------------------------

    def get_source_family(self, source_id: str) -> Optional[str]:
        src = self.sources.get(source_id)
        if not src:
            return None
        seen: Set[str] = set()
        cur = src
        while (
            cur
            and cur.derived_from
            and cur.derived_from in self.sources
            and cur.id not in seen
        ):
            seen.add(cur.id)
            cur = self.sources[cur.derived_from]
        if cur and cur.independence_group and cur.independence_group != "UNKNOWN":
            return cur.independence_group
        return cur.id if cur else source_id

    def source_families(self, source_ids: List[str]) -> Set[str]:
        families: Set[str] = set()
        for sid in source_ids:
            fam = self.get_source_family(sid)
            families.add(fam or sid)
        return families

    def independence_state(self, source_ids: List[str]) -> str:
        if not source_ids:
            return "UNKNOWN"
        families = self.source_families(source_ids)
        if len(source_ids) == 1:
            return "SINGLE_SOURCE"
        if len(families) == 1:
            return "DEPENDENT"
        if len(families) == len(source_ids):
            return "INDEPENDENT"
        return "PARTIALLY_DEPENDENT"

    # -----------------------------------------------------------------
    # Analysis stages
    # -----------------------------------------------------------------

    def resolve_identity(self) -> None:
        for fac in self.facilities.values():
            missing: List[str] = []
            if not fac.site_id:
                missing.append("site")
            if not fac.addresses:
                missing.append("address")
            if not fac.coordinates:
                missing.append("coordinate")
            if not fac.building_ids:
                missing.append("buildings")
            if fac.facility_type == FacilityType.UNKNOWN:
                missing.append("facility type")
            if fac.function_state == FunctionState.UNKNOWN:
                missing.append("function")

            if missing:
                self.add_finding(Finding(
                    id=new_id("FIND-ID-", fac.id),
                    finding_type=FindingType.FACILITY_IDENTITY_PARTIALLY_RESOLVED,
                    subject_id=fac.id,
                    facility_id=fac.id,
                    statement=f"Facility {fac.id} is partially resolved; missing identity evidence: {', '.join(missing)}.",
                    verification_state=VerificationState.PARTIALLY_SUPPORTED,
                    risk_dimension="IDENTITY_RISK",
                    source_ids=fac.source_ids,
                    evidence_ids=fac.evidence_ids,
                    limitations=[
                        "Facility is not a single building.",
                        "Address is not facility identity.",
                        "Registered office may not be operational facility.",
                        "Coordinate precision must not exceed evidence.",
                    ],
                ))
            else:
                self.add_finding(Finding(
                    id=new_id("FIND-IDOK-", fac.id),
                    finding_type=FindingType.FACILITY_IDENTITY_RESOLVED,
                    subject_id=fac.id,
                    facility_id=fac.id,
                    statement=f"Facility {fac.id} has site, address, coordinate, building, type, and function evidence.",
                    verification_state=VerificationState.SUPPORTED,
                    risk_dimension="IDENTITY_RISK",
                    source_ids=fac.source_ids,
                    evidence_ids=fac.evidence_ids,
                    limitations=[
                        "Resolved identity is time-bound and source-bound.",
                        "Do not treat geocoder point as exact building entrance without evidence.",
                    ],
                ))

    def separate_owner_operator_occupant(self) -> None:
        for fac in self.facilities.values():
            owners = sorted(set(fac.owner_candidates))
            operators = sorted(set(fac.operator_candidates))
            occupants = sorted(set(fac.occupants + fac.tenants))

            if owners:
                state = VerificationState.PARTIALLY_SUPPORTED if len(owners) > 1 else VerificationState.SUPPORTED
                self.add_finding(Finding(
                    id=new_id("FIND-OWNER-", fac.id),
                    finding_type=FindingType.OWNER_SUPPORT,
                    subject_id=fac.id,
                    facility_id=fac.id,
                    statement=f"Property owner candidates: {owners}. Owner must not be merged with operator or occupant.",
                    verification_state=state,
                    risk_dimension="OWNERSHIP_RISK",
                    source_ids=fac.source_ids,
                    evidence_ids=fac.evidence_ids,
                    limitations=[
                        "Legal owner may lease site to another organization.",
                        "Parcel ownership does not automatically identify facility operator.",
                    ],
                ))
            else:
                self.add_finding(Finding(
                    id=new_id("FIND-OWNERUNK-", fac.id),
                    finding_type=FindingType.FACILITY_IDENTITY_PARTIALLY_RESOLVED,
                    subject_id=fac.id,
                    facility_id=fac.id,
                    statement="Property owner is unresolved.",
                    verification_state=VerificationState.INCONCLUSIVE,
                    risk_dimension="OWNERSHIP_RISK",
                    source_ids=fac.source_ids,
                    evidence_ids=fac.evidence_ids,
                    limitations=["Do not infer owner from facility name or signage alone."],
                ))

            if operators:
                state = VerificationState.PARTIALLY_SUPPORTED if len(operators) > 1 else VerificationState.SUPPORTED
                self.add_finding(Finding(
                    id=new_id("FIND-OPERATOR-", fac.id),
                    finding_type=FindingType.OPERATOR_SUPPORT,
                    subject_id=fac.id,
                    facility_id=fac.id,
                    statement=f"Facility operator candidates: {operators}. Operator must not be merged with owner or occupant.",
                    verification_state=state,
                    risk_dimension="OPERATION_RISK",
                    source_ids=fac.source_ids,
                    evidence_ids=fac.evidence_ids,
                    limitations=[
                        "Operator may manage site while multiple tenants occupy portions.",
                        "Company website or signage is operator evidence context, not legal ownership.",
                    ],
                ))
            else:
                self.add_finding(Finding(
                    id=new_id("FIND-OPERUNK-", fac.id),
                    finding_type=FindingType.FACILITY_IDENTITY_PARTIALLY_RESOLVED,
                    subject_id=fac.id,
                    facility_id=fac.id,
                    statement="Facility operator is unresolved. Do not infer operator from property owner.",
                    verification_state=VerificationState.INCONCLUSIVE,
                    risk_dimension="OPERATION_RISK",
                    source_ids=fac.source_ids,
                    evidence_ids=fac.evidence_ids,
                    limitations=["Owner != operator."],
                ))

            if occupants:
                self.add_finding(Finding(
                    id=new_id("FIND-OCC-", fac.id),
                    finding_type=FindingType.OCCUPANT_SUPPORT,
                    subject_id=fac.id,
                    facility_id=fac.id,
                    statement=f"Occupant/tenant candidates: {occupants}.",
                    verification_state=VerificationState.PARTIALLY_SUPPORTED,
                    risk_dimension="OCCUPANCY_RISK",
                    source_ids=fac.source_ids,
                    evidence_ids=fac.evidence_ids,
                    limitations=[
                        "Occupancy is time-bound.",
                        "Historical occupant is not current occupant.",
                        "Multi-tenant campus may contain multiple organizations.",
                    ],
                ))

            if owners and operators and set(owners) == set(operators):
                self.add_finding(Finding(
                    id=new_id("FIND-OWNERSAME-", fac.id),
                    finding_type=FindingType.OWNER_SUPPORT,
                    subject_id=fac.id,
                    facility_id=fac.id,
                    statement="Owner and operator candidates currently match, but relationships remain represented separately.",
                    verification_state=VerificationState.OBSERVED,
                    risk_dimension="OWNERSHIP_RISK",
                    source_ids=fac.source_ids,
                    evidence_ids=fac.evidence_ids,
                    limitations=["Matching names do not erase legal distinction between owner and operator."],
                ))

    def assess_function(self) -> None:
        for fac in self.facilities.values():
            if fac.function_state in {FunctionState.OFFICIALLY_DECLARED, FunctionState.SUPPORTED}:
                self.add_finding(Finding(
                    id=new_id("FIND-FUNC-", fac.id),
                    finding_type=FindingType.FUNCTION_SUPPORT,
                    subject_id=fac.id,
                    facility_id=fac.id,
                    statement=f"Facility function is supported: {fac.function}.",
                    verification_state=VerificationState.SUPPORTED,
                    risk_dimension="FUNCTION_RISK",
                    source_ids=fac.source_ids,
                    evidence_ids=fac.evidence_ids,
                    limitations=[
                        "Facility type is not exact function.",
                        "Declared function may be broad or outdated.",
                        "No internal process detail is inferred.",
                    ],
                ))
            elif fac.function_state in {FunctionState.OBSERVED, FunctionState.PROBABLE, FunctionState.POSSIBLE}:
                self.add_finding(Finding(
                    id=new_id("FIND-FUNCC-", fac.id),
                    finding_type=FindingType.FUNCTION_CANDIDATE,
                    subject_id=fac.id,
                    facility_id=fac.id,
                    statement=f"Facility function is candidate only: {fac.function}; state={fac.function_state.value}.",
                    verification_state=VerificationState.CANDIDATE,
                    risk_dimension="FUNCTION_RISK",
                    source_ids=fac.source_ids,
                    evidence_ids=fac.evidence_ids,
                    limitations=["Do not convert visual or type evidence into exact production/process function."],
                ))
            elif fac.function_state == FunctionState.DISPUTED:
                self.add_finding(Finding(
                    id=new_id("FIND-FUNCD-", fac.id),
                    finding_type=FindingType.FUNCTION_CANDIDATE,
                    subject_id=fac.id,
                    facility_id=fac.id,
                    statement=f"Facility function is disputed: {fac.function}.",
                    verification_state=VerificationState.DISPUTED,
                    risk_dimension="FUNCTION_RISK",
                    source_ids=fac.source_ids,
                    evidence_ids=fac.evidence_ids,
                    limitations=["Preserve competing functional interpretations."],
                ))

    def assess_dependencies(self) -> None:
        critical_types = {
            DependencyType.POWER,
            DependencyType.WATER,
            DependencyType.TELECOM,
            DependencyType.NETWORK,
            DependencyType.FUEL,
        }

        for fac in self.facilities.values():
            for dep in fac.dependencies:
                if dep.evidence_state in {
                    VerificationState.SUPPORTED,
                    VerificationState.PARTIALLY_SUPPORTED,
                    VerificationState.OBSERVED,
                }:
                    vstate = dep.evidence_state
                else:
                    vstate = VerificationState.CANDIDATE

                self.add_finding(Finding(
                    id=new_id("FIND-DEP-", dep.id),
                    finding_type=FindingType.DEPENDENCY_OBSERVED,
                    subject_id=dep.id,
                    facility_id=fac.id,
                    statement=(
                        f"High-level dependency observed: type={dep.dep_type.value}, provider={dep.provider}, "
                        f"scope={dep.service_scope}, redundancy={dep.redundancy_state}."
                    ),
                    verification_state=vstate,
                    risk_dimension="DEPENDENCY_RISK",
                    source_ids=dep.source_ids,
                    evidence_ids=dep.evidence_ids,
                    limitations=[
                        "Dependency is for resilience/business continuity only.",
                        "Do not convert dependency into attack vector.",
                        "Provider relationship may be regional rather than facility-specific.",
                    ],
                ))

                if dep.dep_type in critical_types and dep.redundancy_state in {"NONE_DOCUMENTED", "UNKNOWN"}:
                    self.add_finding(Finding(
                        id=new_id("FIND-SPOF-", dep.id),
                        finding_type=FindingType.RESILIENCE_UNVERIFIED,
                        subject_id=dep.id,
                        facility_id=fac.id,
                        statement=(
                            f"Single documented dependency candidate for {dep.dep_type.value}; "
                            "resilience review required. This is not an attack recommendation."
                        ),
                        verification_state=VerificationState.CANDIDATE,
                        risk_dimension="RESILIENCE_RISK",
                        source_ids=dep.source_ids,
                        evidence_ids=dep.evidence_ids,
                        sensitivity_flags=[SensitivityFlag.CRITICAL_INFRASTRUCTURE_HIGH_LEVEL_ONLY.value],
                        limitations=[
                            "SPOF analysis is for risk reduction only.",
                            "Never optimize disruption or targeting.",
                            "Redundancy may exist but be undocumented.",
                        ],
                        specialist_handoff="SUPPLYCHAININT / FACILITY MANAGEMENT / HUMAN REVIEW",
                    ))

    def assess_resilience(self) -> None:
        for fac in self.facilities.values():
            for res in fac.resilience_evidence:
                if res.state == ResilienceState.DOCUMENTED:
                    vstate = VerificationState.OBSERVED
                    stmt = f"Resilience control documented but not independently verified: {res.control_type}. {res.description}"
                elif res.state == ResilienceState.TESTED_REPORTED:
                    vstate = VerificationState.PARTIALLY_SUPPORTED
                    stmt = f"Resilience control tested/reported: {res.control_type}. {res.description}"
                elif res.state == ResilienceState.AUTHORIZED_VERIFIED:
                    vstate = VerificationState.SUPPORTED
                    stmt = f"Resilience control authorized-verified: {res.control_type}. {res.description}"
                else:
                    vstate = VerificationState.INCONCLUSIVE
                    stmt = f"Resilience control state unknown: {res.control_type}. {res.description}"

                self.add_finding(Finding(
                    id=new_id("FIND-RES-", res.id),
                    finding_type=(
                        FindingType.RESILIENCE_DOCUMENTED
                        if res.state != ResilienceState.UNKNOWN
                        else FindingType.RESILIENCE_UNVERIFIED
                    ),
                    subject_id=res.id,
                    facility_id=fac.id,
                    statement=stmt,
                    verification_state=vstate,
                    risk_dimension="RESILIENCE_RISK",
                    source_ids=res.source_ids,
                    evidence_ids=res.evidence_ids,
                    limitations=[
                        "Documented resilience is not tested resilience.",
                        "Generator/UPS/redundancy claims require authorized validation.",
                        "No bypass or disruption guidance is provided.",
                    ],
                ))

    def assess_hazards(self) -> None:
        for fac in self.facilities.values():
            for hz in fac.hazards:
                self.add_finding(Finding(
                    id=new_id("FIND-HAZ-", hz.id),
                    finding_type=FindingType.HAZARD_EXPOSURE_OBSERVED,
                    subject_id=hz.id,
                    facility_id=fac.id,
                    statement=(
                        f"Natural/environmental hazard context: type={hz.hazard_type.value}, "
                        f"exposure={hz.exposure.value}, source={hz.source}."
                    ),
                    verification_state=VerificationState.OBSERVED,
                    risk_dimension="HAZARD_RISK",
                    source_ids=hz.source_ids,
                    evidence_ids=hz.evidence_ids,
                    limitations=[
                        "Hazard exposure is not facility failure.",
                        "Mitigation may exist.",
                        "Regional risk does not determine exact building performance.",
                    ],
                ))

    def assess_incidents(self) -> None:
        for fac in self.facilities.values():
            for inc in fac.incidents:
                current_impact = (
                    "NO_CURRENT_DISRUPTION_EVIDENCED"
                    if inc.recovery_status == "COMPLETE"
                    else "UNKNOWN_OR_POTENTIAL_IMPACT"
                )
                self.add_finding(Finding(
                    id=new_id("FIND-INC-", inc.id),
                    finding_type=FindingType.INCIDENT_OBSERVED,
                    subject_id=inc.id,
                    facility_id=fac.id,
                    statement=(
                        f"Incident observed: {inc.incident_type}; summary={inc.summary}; "
                        f"damage={inc.damage_state}; recovery={inc.recovery_status}; current_impact={current_impact}."
                    ),
                    verification_state=VerificationState.OBSERVED,
                    risk_dimension="INCIDENT_RISK",
                    source_ids=inc.source_ids,
                    evidence_ids=inc.evidence_ids,
                    limitations=[
                        "Historical incident is not current disruption.",
                        "Visual damage state is not engineering certification.",
                        "Recovery status requires authoritative source.",
                    ],
                ))

    def assess_changes(self) -> None:
        for fac in self.facilities.values():
            for ch in fac.changes:
                self.add_finding(Finding(
                    id=new_id("FIND-CHG-", ch.id),
                    finding_type=FindingType.CHANGE_OBSERVED,
                    subject_id=ch.id,
                    facility_id=fac.id,
                    statement=(
                        f"Facility change observed: type={ch.change_type}; old={ch.old_state}; "
                        f"new={ch.new_state}; effective={ch.effective_at}; observed={ch.observed_at}."
                    ),
                    verification_state=VerificationState.OBSERVED,
                    risk_dimension="CHANGE_RISK",
                    source_ids=ch.source_ids,
                    evidence_ids=ch.evidence_ids,
                    limitations=[
                        "Ownership change is not operator change.",
                        "Operator change is not function change.",
                        "Tenant change is not facility repurpose.",
                        "Construction start is not completion.",
                    ],
                ))

    def assess_imagery(self) -> None:
        for fac in self.facilities.values():
            for idx, obs in enumerate(fac.imagery_observations):
                capture = obs.get("capture_date")
                age = days_since(capture, self.as_of)
                if age is None or age > 365:
                    self.add_finding(Finding(
                        id=new_id("FIND-IMG-", f"{fac.id}-{idx}"),
                        finding_type=FindingType.IMAGERY_STALE,
                        subject_id=fac.id,
                        facility_id=fac.id,
                        statement=(
                            f"Imagery observation capture_date={capture} is stale or undated relative to as_of={self.as_of}. "
                            "Do not describe archived imagery as current or real-time."
                        ),
                        verification_state=VerificationState.SUPPORTED,
                        risk_dimension="IMAGERY_RISK",
                        source_ids=fac.source_ids,
                        evidence_ids=fac.evidence_ids,
                        limitations=[
                            "Imagery age must be preserved.",
                            "Visible change does not establish internal function or capacity.",
                        ],
                    ))

    def detect_source_dependencies(self) -> None:
        for src in self.sources.values():
            if src.derived_from and src.derived_from in self.sources:
                self.add_finding(Finding(
                    id=new_id("FIND-SRCDEP-", src.id),
                    finding_type=FindingType.SOURCE_DEPENDENCY,
                    subject_id=src.id,
                    statement=(
                        f"Source {src.id} derives from {src.derived_from}; "
                        "downstream copies are not independent corroboration."
                    ),
                    verification_state=VerificationState.SUPPORTED,
                    risk_dimension="EVIDENCE_CONFIDENCE",
                    source_ids=[src.id, src.derived_from],
                    evidence_ids=[],
                    limitations=[
                        "Property record -> commercial database -> mapping portal is one pedigree.",
                        "Do not count dependent sources as multiple confirmations.",
                    ],
                ))

    def detect_contradictions(self) -> None:
        existing = {c.description for c in self.contradictions}

        for fac in self.facilities.values():
            owners = sorted(set(fac.owner_candidates))
            if len(owners) > 1:
                desc = f"Conflicting property owner candidates for {fac.id}: {owners}."
                if desc not in existing:
                    fid = new_id("FIND-CONOWNER-", fac.id)
                    self.add_finding(Finding(
                        id=fid,
                        finding_type=FindingType.CONTRADICTION_OBSERVED,
                        subject_id=fac.id,
                        facility_id=fac.id,
                        statement=desc,
                        verification_state=VerificationState.DISPUTED,
                        risk_dimension="OWNERSHIP_RISK",
                        source_ids=fac.source_ids,
                        evidence_ids=fac.evidence_ids,
                        limitations=[
                            "Do not silently pick one owner.",
                            "Stale mapping, sale, lease, or database lag may explain conflict.",
                            "Owner != operator.",
                        ],
                    ))
                    self.add_contradiction(Contradiction(
                        id=new_id("CON-", desc),
                        contradiction_type="OWNER_CONFLICT",
                        description=desc,
                        subject_ids=[fac.id],
                        finding_ids=[fid],
                        evidence_ids=fac.evidence_ids,
                        source_ids=fac.source_ids,
                        severity="HIGH",
                        status="OPEN",
                        recommended_resolution="Retrieve current official property/parcel record and preserve historical ownership timeline.",
                    ))
                    existing.add(desc)

            operators = sorted(set(fac.operator_candidates))
            if len(operators) > 1:
                desc = f"Conflicting facility operator candidates for {fac.id}: {operators}."
                if desc not in existing:
                    fid = new_id("FIND-CONOPER-", fac.id)
                    self.add_finding(Finding(
                        id=fid,
                        finding_type=FindingType.CONTRADICTION_OBSERVED,
                        subject_id=fac.id,
                        facility_id=fac.id,
                        statement=desc,
                        verification_state=VerificationState.DISPUTED,
                        risk_dimension="OPERATION_RISK",
                        source_ids=fac.source_ids,
                        evidence_ids=fac.evidence_ids,
                        limitations=["Operator change may be temporal; preserve control era."],
                    ))
                    self.add_contradiction(Contradiction(
                        id=new_id("CON-", desc),
                        contradiction_type="OPERATOR_CONFLICT",
                        description=desc,
                        subject_ids=[fac.id],
                        finding_ids=[fid],
                        evidence_ids=fac.evidence_ids,
                        source_ids=fac.source_ids,
                        severity="MEDIUM",
                        status="OPEN",
                        recommended_resolution="Verify current operator through authorized facility management, permits, and organization disclosures.",
                    ))
                    existing.add(desc)

            groups: Dict[Tuple[str, str], List[CapacityClaim]] = defaultdict(list)
            for cc in fac.capacity_claims:
                groups[(cc.capacity_type, cc.unit)].append(cc)
            for key, items in groups.items():
                values = [float(x.value) for x in items if x.value is not None]
                if len(values) >= 2 and max(values) > 0 and (max(values) - min(values)) / max(values) > 0.10:
                    desc = f"Conflicting capacity claims for {fac.id} {key}: {values}."
                    if desc not in existing:
                        fid = new_id("FIND-CONCAP-", fac.id + key[0])
                        self.add_finding(Finding(
                            id=fid,
                            finding_type=FindingType.CONTRADICTION_OBSERVED,
                            subject_id=fac.id,
                            facility_id=fac.id,
                            statement=desc,
                            verification_state=VerificationState.DISPUTED,
                            risk_dimension="CAPACITY_RISK",
                            source_ids=sorted({sid for x in items for sid in x.source_ids}),
                            evidence_ids=sorted({eid for x in items for eid in x.evidence_ids}),
                            limitations=[
                                "Design, licensed, installed, available, and utilized capacity are different.",
                                "Do not average incompatible capacity claims.",
                            ],
                        ))
                        self.add_contradiction(Contradiction(
                            id=new_id("CON-", desc),
                            contradiction_type="CAPACITY_CONFLICT",
                            description=desc,
                            subject_ids=[x.id for x in items],
                            finding_ids=[fid],
                            evidence_ids=sorted({eid for x in items for eid in x.evidence_ids}),
                            source_ids=sorted({sid for x in items for sid in x.source_ids}),
                            severity="MEDIUM",
                            status="OPEN",
                            recommended_resolution="Separate capacity basis and verify with authorized operational records.",
                        ))
                        existing.add(desc)

    def withhold_sensitive_detail(self) -> None:
        sensitive_types = {
            FacilityType.DATA_CENTER,
            FacilityType.ENERGY_FACILITY,
            FacilityType.WATER_FACILITY,
            FacilityType.TELECOM_FACILITY,
            FacilityType.PUBLIC_SAFETY_SITE,
            FacilityType.GOVERNMENT_OFFICE,
            FacilityType.LABORATORY,
            FacilityType.RESEARCH_CENTER,
            FacilityType.HOSPITAL,
        }
        critical_types = {
            FacilityType.DATA_CENTER,
            FacilityType.ENERGY_FACILITY,
            FacilityType.WATER_FACILITY,
            FacilityType.TELECOM_FACILITY,
            FacilityType.PUBLIC_SAFETY_SITE,
            FacilityType.TRANSPORT_FACILITY,
            FacilityType.PORT_FACILITY,
            FacilityType.AIRPORT_FACILITY,
            FacilityType.RAIL_FACILITY,
        }

        for fac in self.facilities.values():
            if fac.facility_type in sensitive_types:
                self.add_finding(Finding(
                    id=new_id("FIND-SENS-", fac.id),
                    finding_type=FindingType.SENSITIVE_DETAIL_WITHHELD,
                    subject_id=fac.id,
                    facility_id=fac.id,
                    statement=(
                        f"Facility type {fac.facility_type.value} is treated as sensitive. "
                        "Detailed security controls, cage/rack layouts, access-control locations, "
                        "guard positions, camera coverage, internal process topology, and disruption sequences are withheld."
                    ),
                    verification_state=VerificationState.SUPPORTED,
                    risk_dimension="SENSITIVITY_RISK",
                    source_ids=fac.source_ids,
                    evidence_ids=fac.evidence_ids,
                    sensitivity_flags=[
                        SensitivityFlag.SECURITY_CONTROL_DETAILS_WITHHELD.value,
                        SensitivityFlag.CRITICAL_INFRASTRUCTURE_HIGH_LEVEL_ONLY.value,
                        SensitivityFlag.NON_PUBLIC_PLANS_RESTRICTED.value,
                    ],
                    limitations=[
                        "High-level public/authorized defensive context only.",
                        "No tactical security map is produced.",
                    ],
                ))

            if fac.facility_type in critical_types:
                self.add_finding(Finding(
                    id=new_id("FIND-HR-", fac.id),
                    finding_type=FindingType.HUMAN_REVIEW_REQUIRED,
                    subject_id=fac.id,
                    facility_id=fac.id,
                    statement="Critical or sensitive facility assessment requires qualified human review before consequential operational, legal, or safety decisions.",
                    verification_state=VerificationState.SUPPORTED,
                    risk_dimension="GOVERNANCE_RISK",
                    source_ids=fac.source_ids,
                    evidence_ids=fac.evidence_ids,
                    sensitivity_flags=[SensitivityFlag.CRITICAL_INFRASTRUCTURE_HIGH_LEVEL_ONLY.value],
                    limitations=["AI assists; humans govern consequential actions."],
                    specialist_handoff="HUMAN_FACILITY_SAFETY / LEGALINT / OPERATIONS",
                ))

    def add_governance_findings(self) -> None:
        governance = [
            (
                "FIND-GOV-NOINTRUSION",
                FindingType.NO_INTRUSION_PLANNING,
                "No physical intrusion, covert entry, lock/badge/alarm bypass, camera-blind-spot mapping, guard evasion, tailgating, or impersonation is planned or recommended.",
            ),
            (
                "FIND-GOV-NOSABOTAGE",
                FindingType.NO_SABOTAGE_PLANNING,
                "No sabotage, power/water/telecom disruption, HVAC/fire-system tampering, generator sabotage, explosive placement, or safety-system defeat is planned or recommended.",
            ),
            (
                "FIND-GOV-NOTARGETING",
                FindingType.NO_TARGETING,
                "No weapon targeting, hostile reconnaissance, attack path optimization, or critical-infrastructure attack planning is produced.",
            ),
            (
                "FIND-GOV-PRIVATE",
                FindingType.PRIVATE_RESIDENCE_BOUNDARY_ENFORCED,
                "Private-person residences, employee routines, guard schedules, and individual movement patterns are excluded.",
            ),
            (
                "FIND-GOV-NOPHYSICAL",
                FindingType.NO_PHYSICAL_ACTION,
                "FACILITYINT analyzes and recommends only; it does not unlock doors, change access control, disable alarms, operate building systems, dispatch personnel, or enter property.",
            ),
        ]
        for fid, ftype, stmt in governance:
            self.add_finding(Finding(
                id=fid,
                finding_type=ftype,
                subject_id="GOVERNANCE",
                statement=stmt,
                verification_state=VerificationState.SUPPORTED,
                confidence=0.99,
                risk_dimension="POLICY_RISK",
                limitations=["Defensive lawful facility intelligence boundary."],
            ))

    def fact_gate_findings(self) -> None:
        policy_supported = {
            FindingType.NO_INTRUSION_PLANNING,
            FindingType.NO_SABOTAGE_PLANNING,
            FindingType.NO_TARGETING,
            FindingType.PRIVATE_RESIDENCE_BOUNDARY_ENFORCED,
            FindingType.NO_PHYSICAL_ACTION,
            FindingType.SENSITIVE_DETAIL_WITHHELD,
            FindingType.HUMAN_REVIEW_REQUIRED,
        }

        for f in self.findings.values():
            if f.finding_type in policy_supported:
                f.verification_state = VerificationState.SUPPORTED
                f.confidence = 0.99
                continue

            srcs = [self.sources[sid] for sid in f.source_ids if sid in self.sources]
            if not srcs:
                f.confidence = 0.0
                if f.verification_state == VerificationState.OBSERVED:
                    f.verification_state = VerificationState.INCONCLUSIVE
                f.limitations.append("No mapped source for fact gate.")
                continue

            families = self.source_families(f.source_ids)
            max_rel = max((s.reliability for s in srcs), default=0.5)
            base = max_rel

            if len(families) >= 2:
                base = min(0.99, base * 1.05)
            elif len(families) == 1 and len(f.source_ids) > 1:
                base *= 0.90
                f.limitations.append("Multiple sources share one upstream source family.")

            ft = f.finding_type
            if ft == FindingType.FACILITY_IDENTITY_RESOLVED:
                f.verification_state = VerificationState.SUPPORTED if base >= 0.75 else VerificationState.PARTIALLY_SUPPORTED
                f.limitations.append("Identity is time-bound and source-bound.")

            elif ft == FindingType.FACILITY_IDENTITY_PARTIALLY_RESOLVED:
                f.verification_state = VerificationState.PARTIALLY_SUPPORTED if base >= 0.60 else VerificationState.INCONCLUSIVE
                f.limitations.append("Do not infer missing facility identity from name alone.")

            elif ft == FindingType.OWNER_SUPPORT:
                f.verification_state = VerificationState.SUPPORTED if base >= 0.75 else VerificationState.PARTIALLY_SUPPORTED
                base = min(base, 0.88)
                f.limitations.append("Owner is legal property context, not operator or occupant.")

            elif ft == FindingType.OPERATOR_SUPPORT:
                f.verification_state = VerificationState.SUPPORTED if base >= 0.72 else VerificationState.PARTIALLY_SUPPORTED
                base = min(base, 0.84)
                f.limitations.append("Operator evidence may be organizational rather than property-legal.")

            elif ft == FindingType.OCCUPANT_SUPPORT:
                f.verification_state = VerificationState.PARTIALLY_SUPPORTED
                base = min(base, 0.80)
                f.limitations.append("Occupancy is time-bound and may be multi-tenant.")

            elif ft == FindingType.FUNCTION_SUPPORT:
                f.verification_state = VerificationState.SUPPORTED if base >= 0.72 else VerificationState.PARTIALLY_SUPPORTED
                base = min(base, 0.86)
                f.limitations.append("Function is high-level; no internal process topology is inferred.")

            elif ft == FindingType.FUNCTION_CANDIDATE:
                f.verification_state = VerificationState.CANDIDATE
                base = min(base, 0.65)
                f.limitations.append("Function candidate is not verified function.")

            elif ft == FindingType.DEPENDENCY_OBSERVED:
                f.verification_state = VerificationState.OBSERVED if base >= 0.65 else VerificationState.CANDIDATE
                base = min(base, 0.82)
                f.limitations.append("Dependency is resilience context, not attack vector.")

            elif ft == FindingType.RESILIENCE_DOCUMENTED:
                f.verification_state = VerificationState.OBSERVED
                base = min(base, 0.74)
                f.limitations.append("Documented resilience is not tested resilience.")

            elif ft == FindingType.RESILIENCE_UNVERIFIED:
                f.verification_state = VerificationState.INCONCLUSIVE
                base = min(base, 0.62)
                f.limitations.append("Resilience requires authorized validation.")

            elif ft == FindingType.HAZARD_EXPOSURE_OBSERVED:
                f.verification_state = VerificationState.OBSERVED
                base = min(base, 0.78)
                f.limitations.append("Hazard exposure is not facility failure.")

            elif ft == FindingType.INCIDENT_OBSERVED:
                f.verification_state = VerificationState.OBSERVED
                base = min(base, 0.82)
                f.limitations.append("Historical incident is not current disruption.")

            elif ft == FindingType.CHANGE_OBSERVED:
                f.verification_state = VerificationState.OBSERVED
                base = min(base, 0.80)
                f.limitations.append("Change type must preserve owner/operator/occupant/function distinctions.")

            elif ft == FindingType.IMAGERY_STALE:
                f.verification_state = VerificationState.SUPPORTED
                base = 0.95
                f.limitations.append("Imagery is not real-time.")

            elif ft == FindingType.SOURCE_DEPENDENCY:
                f.verification_state = VerificationState.SUPPORTED
                base = 0.90
                f.limitations.append("Dependent sources are one evidence family.")

            elif ft == FindingType.CONTRADICTION_OBSERVED:
                f.verification_state = VerificationState.DISPUTED
                base = min(base, 0.82)
                f.limitations.append("Preserve competing records; do not average incompatible facts.")

            else:
                if base >= 0.75:
                    f.verification_state = VerificationState.SUPPORTED
                elif base >= 0.60:
                    f.verification_state = VerificationState.PARTIALLY_SUPPORTED
                elif base >= 0.40:
                    f.verification_state = VerificationState.INCONCLUSIVE
                else:
                    f.verification_state = VerificationState.UNSUPPORTED

            f.confidence = round(max(0.0, min(0.99, base)), 3)

    def build_hypotheses(self) -> None:
        fac = next(iter(self.facilities.values()), None)
        if not fac:
            self.hypotheses = []
            return

        owner = fac.owner_candidates[0] if fac.owner_candidates else "UNKNOWN"
        operator = fac.operator_candidates[0] if fac.operator_candidates else "UNKNOWN"
        has_owner_conflict = len(set(fac.owner_candidates)) > 1
        has_operator = bool(fac.operator_candidates)
        has_construction = any(ch.change_type == "CONSTRUCTION_START" for ch in fac.changes)

        self.hypotheses = [
            Hypothesis(
                id="H-ACTIVE-FACILITY",
                statement=f"{fac.name or fac.id} is an active facility operated by {operator}.",
                kind="FACILITY_IDENTITY",
                supporting_finding_ids=[f.id for f in self.findings.values() if f.finding_type in {
                    FindingType.FACILITY_IDENTITY_RESOLVED,
                    FindingType.OPERATOR_SUPPORT,
                    FindingType.FUNCTION_SUPPORT,
                }],
                contradicting_finding_ids=[f.id for f in self.findings.values() if f.finding_type == FindingType.CONTRADICTION_OBSERVED],
                assumptions=["Current operator evidence is valid as of as_of date."],
                predictions=["Authorized facility records and organization disclosures would agree on current operation."],
                falsification_conditions=[
                    "Current operator is different.",
                    "Facility is leased to another operator.",
                    "Function has changed historically.",
                ],
                status=HypothesisStatus.PROBABLE if has_operator else HypothesisStatus.UNRESOLVED,
                confidence=0.68 if has_operator else 0.35,
                limitations=["Operator evidence is not property ownership evidence."],
            ),
            Hypothesis(
                id="H-OWNER-LEASES-OPERATOR",
                statement=f"{owner} owns the parcel but {operator} operates the facility under lease/management arrangement.",
                kind="OWNERSHIP_OPERATION",
                supporting_finding_ids=[f.id for f in self.findings.values() if f.finding_type in {
                    FindingType.OWNER_SUPPORT,
                    FindingType.OPERATOR_SUPPORT,
                }],
                assumptions=["Owner and operator are distinct legal/operational roles."],
                predictions=["Property record and facility management records would show separate entities."],
                falsification_conditions=[
                    "Same entity owns and operates with documented legal unity.",
                    "Operator evidence is stale.",
                    "Mapping database misassociates owner and operator.",
                ],
                status=HypothesisStatus.POSSIBLE,
                confidence=0.60,
                limitations=["Owner != operator must remain explicit."],
            ),
            Hypothesis(
                id="H-STALE-MAPPING",
                statement="Conflicting owner candidate arises from stale commercial mapping/database lag.",
                kind="SOURCE_QUALITY",
                supporting_finding_ids=[f.id for f in self.findings.values() if f.finding_type in {
                    FindingType.CONTRADICTION_OBSERVED,
                    FindingType.SOURCE_DEPENDENCY,
                }],
                assumptions=["Official property record is more current than aggregator mapping."],
                predictions=["Current parcel record would resolve owner to one entity for as_of date."],
                falsification_conditions=[
                    "Official record shows recent sale to alternate owner.",
                    "Multiple legal parcels explain different owner labels.",
                ],
                status=HypothesisStatus.POSSIBLE if has_owner_conflict else HypothesisStatus.UNRESOLVED,
                confidence=0.55 if has_owner_conflict else 0.30,
                limitations=["Do not silently choose one source."],
            ),
            Hypothesis(
                id="H-CONSTRUCTION-CAPACITY",
                statement="Observed construction will increase facility capacity or change function.",
                kind="CHANGE_INTERPRETATION",
                supporting_finding_ids=[f.id for f in self.findings.values() if f.finding_type == FindingType.CHANGE_OBSERVED],
                assumptions=["Permitted construction reaches completion and is put into service."],
                predictions=["Completion certificate, authorized inventory, or current imagery would confirm operational change."],
                falsification_conditions=[
                    "Construction is paused or cancelled.",
                    "New structure is support/utility only.",
                    "Function remains unchanged.",
                    "Capacity claim is design rather than actual.",
                ],
                status=HypothesisStatus.UNRESOLVED,
                confidence=0.40 if has_construction else 0.20,
                limitations=[
                    "Permit is not completion.",
                    "Visible footprint change does not establish internal function or capacity.",
                ],
            ),
        ]

    def build_knowledge_gaps(self) -> None:
        existing = {g.description for g in self.gaps}

        for fac in self.facilities.values():
            if not fac.owner_candidates:
                desc = f"Property owner for {fac.id} is unknown."
                if desc not in existing:
                    self.gaps.append(KnowledgeGap(
                        id=new_id("GAP-OWNER-", fac.id),
                        gap_type=GapType.OWNER_UNKNOWN,
                        description=desc,
                        about_subject_ids=[fac.id],
                        importance="HIGH",
                        recommended_source="Official property/land registry or authorized legal record",
                        specialist="FACILITYINT / CORPINT / OWNERSHIPINT / LEGALINT",
                        expected_information_value=0.85,
                    ))
                    existing.add(desc)

            if not fac.operator_candidates:
                desc = f"Facility operator for {fac.id} is unknown."
                if desc not in existing:
                    self.gaps.append(KnowledgeGap(
                        id=new_id("GAP-OPER-", fac.id),
                        gap_type=GapType.OPERATOR_UNKNOWN,
                        description=desc,
                        about_subject_ids=[fac.id],
                        importance="HIGH",
                        recommended_source="Authorized facility management system, permits, organization disclosure",
                        specialist="FACILITYINT / ORGINT",
                        expected_information_value=0.85,
                    ))
                    existing.add(desc)

            if fac.function_state in {FunctionState.UNKNOWN, FunctionState.POSSIBLE, FunctionState.DISPUTED}:
                desc = f"Facility function for {fac.id} is uncertain or disputed."
                if desc not in existing:
                    self.gaps.append(KnowledgeGap(
                        id=new_id("GAP-FUNC-", fac.id),
                        gap_type=GapType.FUNCTION_UNCERTAIN,
                        description=desc,
                        about_subject_ids=[fac.id],
                        importance="MEDIUM",
                        recommended_source="Official organization disclosure, permit scope, authorized operational record",
                        specialist="FACILITYINT / TECHINT",
                        expected_information_value=0.70,
                    ))
                    existing.add(desc)

            for cc in fac.capacity_claims:
                if cc.basis in {"DESIGN", "LICENSED", "SOURCE_CLAIMED", "UNKNOWN"}:
                    desc = f"Capacity claim {cc.id} is {cc.basis} and not verified actual utilization."
                    if desc not in existing:
                        self.gaps.append(KnowledgeGap(
                            id=new_id("GAP-CAP-", cc.id),
                            gap_type=GapType.CAPACITY_UNVERIFIED,
                            description=desc,
                            about_subject_ids=[cc.id, fac.id],
                            importance="MEDIUM",
                            recommended_source="Authorized operational records or engineering/facility management verification",
                            specialist="FACILITYINT / TECHINT",
                            expected_information_value=0.70,
                        ))
                        existing.add(desc)

            for dep in fac.dependencies:
                if dep.evidence_state in {VerificationState.INCONCLUSIVE, VerificationState.CANDIDATE}:
                    desc = f"Dependency {dep.id} evidence is unresolved."
                    if desc not in existing:
                        self.gaps.append(KnowledgeGap(
                            id=new_id("GAP-DEP-", dep.id),
                            gap_type=GapType.UTILITY_DEPENDENCY_UNCLEAR,
                            description=desc,
                            about_subject_ids=[dep.id, fac.id],
                            importance="MEDIUM",
                            recommended_source="Authorized utility/provider record or facility service contract metadata",
                            specialist="FACILITYINT / SUPPLYCHAININT",
                            expected_information_value=0.70,
                        ))
                        existing.add(desc)

            for res in fac.resilience_evidence:
                if res.state in {ResilienceState.DOCUMENTED, ResilienceState.UNKNOWN}:
                    desc = f"Resilience evidence {res.id} is documented/unverified rather than tested/authorized-verified."
                    if desc not in existing:
                        self.gaps.append(KnowledgeGap(
                            id=new_id("GAP-RES-", res.id),
                            gap_type=GapType.RESILIENCE_UNVERIFIED,
                            description=desc,
                            about_subject_ids=[res.id, fac.id],
                            importance="HIGH",
                            recommended_source="Authorized test record, maintenance log, or facility management verification",
                            specialist="FACILITYINT / INCIDENTINT",
                            expected_information_value=0.80,
                        ))
                        existing.add(desc)

            for ch in fac.changes:
                if ch.change_type == "CONSTRUCTION_START":
                    desc = f"Construction change {ch.id} lacks completion/operational evidence."
                    if desc not in existing:
                        self.gaps.append(KnowledgeGap(
                            id=new_id("GAP-CONST-", ch.id),
                            gap_type=GapType.PERMIT_STATUS_UNCLEAR,
                            description=desc,
                            about_subject_ids=[ch.id, fac.id],
                            importance="MEDIUM",
                            recommended_source="Current permit status, completion certificate, authorized inspection record",
                            specialist="FACILITYINT / LEGALINT",
                            expected_information_value=0.75,
                        ))
                        existing.add(desc)

            for obs in fac.imagery_observations:
                capture = obs.get("capture_date")
                age = days_since(capture, self.as_of)
                if age is None or age > 365:
                    desc = f"Imagery observation dated {capture} is stale for {fac.id}."
                    if desc not in existing:
                        self.gaps.append(KnowledgeGap(
                            id=new_id("GAP-IMG-", fac.id + str(capture)),
                            gap_type=GapType.IMAGERY_STALE,
                            description=desc,
                            about_subject_ids=[fac.id],
                            importance="MEDIUM",
                            recommended_source="Current authorized/public imagery with capture metadata",
                            specialist="SATINT / IMINT / FACILITYINT",
                            expected_information_value=0.65,
                        ))
                        existing.add(desc)

    def build_next_actions(self) -> None:
        fac = next(iter(self.facilities.values()), None)
        actions: List[NextAction] = [
            NextAction(
                id="ACT-NO-PHYSICAL-TESTING",
                description="Do not test physical access, probe guards, walk perimeter deceptively, map blind spots, disable systems, or enter property.",
                priority=99,
                privacy_impact="PROTECTIVE",
                expected_gain=0.0,
                specialist=None,
                requires_human_approval=False,
            ),
            NextAction(
                id="ACT-MAINTAIN-SEPARATION",
                description="Maintain separate records for owner, operator, occupant, tenant, facility type, and function.",
                priority=1,
                privacy_impact="LOW",
                expected_gain=0.85,
                specialist="FACILITYINT / ORGINT / CORPINT",
                requires_human_approval=False,
            ),
            NextAction(
                id="ACT-TEMPORAL-VALIDATION",
                description="Attach valid_from/valid_to and as_of dates to every facility relationship and change event.",
                priority=2,
                privacy_impact="LOW",
                expected_gain=0.80,
                specialist="FACILITYINT",
                requires_human_approval=False,
            ),
            NextAction(
                id="ACT-RESILIENCE-REVIEW",
                description="Review documented resilience evidence through authorized testing/maintenance records; do not provide disruption paths.",
                priority=3,
                privacy_impact="LOW",
                expected_gain=0.85,
                specialist="FACILITY MANAGEMENT / INCIDENTINT",
                requires_human_approval=True,
            ),
            NextAction(
                id="ACT-HAZARD-MITIGATION",
                description="Compare hazard exposure with mitigation, emergency plan, and inspection records.",
                priority=4,
                privacy_impact="LOW",
                expected_gain=0.75,
                specialist="FACILITYINT / EMERGENCY MANAGEMENT",
                requires_human_approval=False,
            ),
            NextAction(
                id="ACT-SENSITIVE-HUMAN-REVIEW",
                description="Route sensitive/critical facility conclusions to qualified human review before operational, legal, or safety decisions.",
                priority=5,
                privacy_impact="PROTECTIVE",
                expected_gain=0.90,
                specialist="HUMAN_FACILITY_SAFETY / LEGALINT",
                requires_human_approval=True,
            ),
        ]

        if fac:
            if len(set(fac.owner_candidates)) > 1 or not fac.owner_candidates:
                actions.insert(0, NextAction(
                    id="ACT-RETRIEVE-PARCEL",
                    description="Retrieve current official parcel/property record and preserve ownership history.",
                    priority=0,
                    privacy_impact="LOW",
                    expected_gain=0.90,
                    specialist="FACILITYINT / OWNERSHIPINT / LEGALINT",
                    requires_human_approval=False,
                ))
            if not fac.operator_candidates:
                actions.insert(0, NextAction(
                    id="ACT-VERIFY-OPERATOR",
                    description="Verify current operator through authorized facility management, permits, and organization disclosures.",
                    priority=0,
                    privacy_impact="LOW",
                    expected_gain=0.90,
                    specialist="FACILITYINT / ORGINT",
                    requires_human_approval=False,
                ))
            if any(ch.change_type == "CONSTRUCTION_START" for ch in fac.changes):
                actions.insert(0, NextAction(
                    id="ACT-VERIFY-COMPLETION",
                    description="Retrieve current permit status and completion/inspection evidence before treating construction as operational.",
                    priority=0,
                    privacy_impact="LOW",
                    expected_gain=0.85,
                    specialist="FACILITYINT / LEGALINT",
                    requires_human_approval=False,
                ))
            if any(res.state == ResilienceState.DOCUMENTED for res in fac.resilience_evidence):
                actions.insert(0, NextAction(
                    id="ACT-VALIDATE-BACKUP",
                    description="Validate backup power/network/water resilience through authorized test records only.",
                    priority=0,
                    privacy_impact="LOW",
                    expected_gain=0.88,
                    specialist="FACILITY MANAGEMENT",
                    requires_human_approval=True,
                ))

        self.actions = actions

    def build_recommendations(self) -> None:
        self.recommendations = [
            Recommendation(
                id="REC-UPDATE-INVENTORY",
                category="FACILITY_MANAGEMENT",
                action="Update authorized facility inventory with time-bound owner/operator/occupant/function records.",
                target="Facility records",
                rationale="Prevents historical-to-current contamination and owner/operator merge errors.",
                approval="HUMAN_APPROVAL_REQUIRED",
                limitations=["Do not expose non-public plans outside authorized systems."],
            ),
            Recommendation(
                id="REC-LOCAL-ONLY",
                category="PRIVACY",
                action="Keep non-public floor plans, schematics, access-control data, BMS data, and emergency-site details in LOCAL_ONLY restricted storage.",
                target="Sensitive facility documents",
                rationale="Cloud routing may expose sensitive physical infrastructure context.",
                approval="HUMAN_APPROVAL_REQUIRED",
                limitations=["Only public/sanitized/aggregated data may be routed externally under policy."],
            ),
            Recommendation(
                id="REC-RESILIENCE-TEST",
                category="RESILIENCE",
                action="Convert documented resilience claims into tested/authorized-verified evidence through authorized maintenance and exercise programs.",
                target="Backup power/network/water controls",
                rationale="Documented redundancy is not proven resilience.",
                approval="HUMAN_APPROVAL_REQUIRED",
                limitations=["No disruption or bypass guidance is provided."],
            ),
            Recommendation(
                id="REC-ENGINEERING-REVIEW",
                category="SAFETY",
                action="Commission qualified engineering review for structural safety, capacity, or hazard-mitigation conclusions.",
                target="Buildings/site structures",
                rationale="Imagery and public records cannot certify structural condition.",
                approval="HUMAN_APPROVAL_REQUIRED",
                limitations=["FACILITYINT does not make definitive engineering safety judgments."],
            ),
            Recommendation(
                id="REC-LEGAL-REVIEW",
                category="LEGAL",
                action="Route property rights, permit interpretation, zoning, and regulatory obligations to LEGALINT where consequential.",
                target="Ownership/permit records",
                rationale="FACILITYINT identifies evidence, not final legal determinations.",
                approval="HUMAN_APPROVAL_REQUIRED",
                limitations=["Legal interpretation requires qualified counsel."],
            ),
        ]

    def build_handoffs(self) -> None:
        self.handoffs = [
            {"specialist": "GEOINT", "reason": "Administrative boundaries, terrain, travel corridors, environmental layers without private-person locations."},
            {"specialist": "MAPINT", "reason": "Roads, land use, mapped features, and map-version context."},
            {"specialist": "SATINT", "reason": "Satellite imagery, remote sensing, and change observation."},
            {"specialist": "IMINT", "reason": "Individual image evidence and visual object/scene observations."},
            {"specialist": "ORGINT", "reason": "Organizational units and responsibilities associated with facility."},
            {"specialist": "CORPINT", "reason": "Legal company/entity resolution."},
            {"specialist": "OWNERSHIPINT", "reason": "Property ownership, transfers, and corporate ownership context."},
            {"specialist": "SUPPLYCHAININT", "reason": "Supplier, vendor, logistics, and critical third-party dependencies."},
            {"specialist": "TRANSPORTINT", "reason": "Transport movement and logistics network context."},
            {"specialist": "TRADEINT", "reason": "Port/trade dependency context."},
            {"specialist": "NETINT", "reason": "Network dependency deeper analysis; no scanning or intrusion."},
            {"specialist": "INFRAINT", "reason": "Internet-facing infrastructure context; no exploitation."},
            {"specialist": "OTINT", "reason": "Operational technology context; no control-system attack."},
            {"specialist": "INCIDENTINT", "reason": "Incident reconstruction and recovery verification."},
            {"specialist": "LEGALINT", "reason": "Property, permit, zoning, regulatory, and liability review."},
            {"specialist": "DOCINT / MALINT", "reason": "Safe ingestion of facility documents/CAD/GIS/images; no macro/script execution."},
        ]

    def dual_ai_review(self) -> Dict[str, Any]:
        issues: List[str] = []

        if any(g.gap_type in {
            GapType.OWNER_UNKNOWN,
            GapType.OPERATOR_UNKNOWN,
            GapType.FUNCTION_UNCERTAIN,
            GapType.CAPACITY_UNVERIFIED,
        } for g in self.gaps):
            issues.append("Core facility identity, ownership, operation, function, or capacity remains unresolved.")

        if self.contradictions:
            issues.append(f"{len(self.contradictions)} contradiction(s) remain open.")

        if any(f.finding_type == FindingType.RESILIENCE_DOCUMENTED for f in self.findings.values()):
            issues.append("Resilience is documented but not independently tested/verified in this corpus.")

        if any(f.finding_type == FindingType.HAZARD_EXPOSURE_OBSERVED for f in self.findings.values()):
            issues.append("Natural/environmental hazard exposure is present but does not establish facility failure.")

        if any(f.finding_type == FindingType.IMAGERY_STALE for f in self.findings.values()):
            issues.append="Some imagery is stale or undated; current-state claims are constrained."

        if any(f.finding_type == FindingType.SENSITIVE_DETAIL_WITHHELD for f in self.findings.values()):
            issues.append="Sensitive facility details are withheld; assessment is high-level defensive only.")

        if any(f.finding_type == FindingType.SOURCE_DEPENDENCY for f in self.findings.values()):
            issues.append="Some sources are dependent and must not be counted as independent corroboration.")

        if not issues:
            verdict = "AGREE"
        elif len(issues) <= 5:
            verdict = "PARTIAL_AGREEMENT"
        else:
            verdict = "INSUFFICIENT_EVIDENCE"

        return {
            "primary_facility_analyst": (
                "Synthetic authorized corpus supports partial identity for Helios Northbridge Campus: "
                "parcel owner candidate is Northgate Property Trust, operator candidate is Helios Compute Services, "
                "occupants include Helios and Aurora Analytics. Function is supported at high level as data-processing/colocation support. "
                "Dependencies and resilience are documented but not fully tested. Regional flood/heat hazard context exists without established site failure. "
                "Construction change is permitted/observed but not completion-verified. Sensitive security/control topology is withheld."
            ),
            "independent_facility_skeptic_issues": issues,
            "verdict": verdict,
            "adversarial_checks": [
                "Are owner and operator confused? No; kept separate.",
                "Is address treated as operational facility? No; resolved with site/parcel/building evidence.",
                "Is imagery treated as real-time? No; capture dates and staleness checked.",
                "Is visible change treated as exact function/capacity? No.",
                "Are dependencies converted into attack vectors? No.",
                "Are security observations converted into weaknesses? No.",
                "Are historical states overwritten? No; temporal changes preserved.",
                "Was tactical intrusion/sabotage/targeting produced? No.",
            ],
            "note": "AI agreement is analytical agreement, not independent facility corroboration.",
        }

    def analyst_summary(self, dual: Dict[str, Any]) -> str:
        fac = next(iter(self.facilities.values()), None)
        if not fac:
            return (
                "FACILITYINT UNRESOLVED: No configured authorized/public facility corpus. "
                "No facility, site, parcel, building, owner, operator, occupant, function, dependency, "
                "hazard, incident, or resilience claim was fabricated."
            )

        owner = ", ".join(fac.owner_candidates) if fac.owner_candidates else "UNKNOWN"
        operator = ", ".join(fac.operator_candidates) if fac.operator_candidates else "UNKNOWN"
        occupants = ", ".join(sorted(set(fac.occupants + fac.tenants))) if (fac.occupants or fac.tenants) else "UNKNOWN"
        deps = ", ".join(sorted({d.dep_type.value for d in fac.dependencies})) if fac.dependencies else "UNKNOWN"
        hazards = ", ".join(sorted({h.hazard_type.value for h in fac.hazards})) if fac.hazards else "UNKNOWN"
        resilience_states = ", ".join(sorted({r.state.value for r in fac.resilience_evidence})) if fac.resilience_evidence else "UNKNOWN"

        lines = [
            f"FACILITY: {fac.name or fac.id}",
            f"SITE / CAMPUS: {fac.site_id or 'UNKNOWN'}",
            f"ADDRESS / LOCATION: {fac.addresses[0].normalized if fac.addresses else 'UNKNOWN'}",
            f"GEOSPATIAL PRECISION: {fac.coordinates[0].precision.value if fac.coordinates else 'UNKNOWN'}",
            f"FACILITY TYPE: {fac.facility_type.value}",
            f"PROPERTY OWNER CANDIDATES: {owner}",
            f"OPERATOR CANDIDATES: {operator}",
            f"OCCUPANTS / TENANTS: {occupants}",
            f"PRIMARY FUNCTION: {fac.function or 'UNKNOWN'} ({fac.function_state.value})",
            f"OPERATING STATUS: {fac.operating_status.value}",
            f"BUILDINGS: {', '.join(fac.building_ids) if fac.building_ids else 'UNKNOWN'}",
            f"CAPACITY CLAIMS: {', '.join(f'{c.capacity_type}={c.value}{c.unit} ({c.basis})' for c in fac.capacity_claims) if fac.capacity_claims else 'UNKNOWN'}",
            f"UTILITY / SERVICE DEPENDENCIES: {deps}",
            f"ENVIRONMENTAL / NATURAL HAZARDS: {hazards}",
            f"RESILIENCE EVIDENCE STATES: {resilience_states}",
            f"RECENT CHANGES: {', '.join(ch.change_type for ch in fac.changes) if fac.changes else 'UNKNOWN'}",
            "",
            "ASSESSMENT:",
            "- OWNER, OPERATOR, AND OCCUPANT ARE REPRESENTED SEPARATELY.",
            "- FUNCTION IS HIGH-LEVEL ONLY; NO INTERNAL PROCESS TOPOLOGY IS INFERRED.",
            "- HAZARD EXPOSURE IS NOT FACILITY FAILURE.",
            "- DOCUMENTED RESILIENCE IS NOT TESTED RESILIENCE.",
            "- IMAGERY IS TIME-BOUND AND NOT REAL-TIME.",
            "- SENSITIVE SECURITY/CONTROL DETAILS ARE WITHHELD.",
            "",
            "NOT ESTABLISHED:",
            "- Exact current legal owner if conflicting records remain.",
            "- Exact internal function or capacity of new construction.",
            "- Tested backup power/network/water resilience.",
            "- Current structural safety or engineering condition.",
            "- Any tactical access, bypass, sabotage, or targeting information.",
            "",
            f"DUAL-AI REVIEW: {dual['verdict']}.",
            "PRIVACY/SENSITIVITY: No private-person location, employee routine, guard schedule, camera blind spot, access-control bypass, or real-time occupancy exposure.",
            "NEXT ACTION: Retrieve current parcel/operator records, verify construction completion, validate resilience through authorized tests, review hazard mitigation, and route sensitive/critical conclusions to human review.",
        ]
        return "\n".join(lines)

    def prepare(self) -> None:
        self.resolve_identity()
        self.separate_owner_operator_occupant()
        self.assess_function()
        self.assess_dependencies()
        self.assess_resilience()
        self.assess_hazards()
        self.assess_incidents()
        self.assess_changes()
        self.assess_imagery()
        self.detect_source_dependencies()
        self.detect_contradictions()
        self.withhold_sensitive_detail()
        self.add_governance_findings()
        self.fact_gate_findings()
        self.build_hypotheses()
        self.build_knowledge_gaps()
        self.build_next_actions()
        self.build_recommendations()
        self.build_handoffs()


