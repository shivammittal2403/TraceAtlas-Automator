        "specialist_handoffs": [
            {"specialist": "LEGALINT", "reason": "Property, permit, zoning, regulatory, and liability review where consequential."},
            {"specialist": "HUMAN_FACILITY_SAFETY", "reason": "Critical or sensitive facility decisions require qualified human review."},
        ],

        "limitations": [
            "No facility-intelligence analysis performed.",
            "No facility, site, parcel, building, owner, operator, occupant, function, capacity, dependency, hazard, incident, or resilience claim was fabricated.",
            "No physical intrusion, bypass, sabotage, targeting, hostile reconnaissance, private-person tracking, or security-control evasion was planned.",
            "No non-public floor plan, access-control detail, guard schedule, camera blind spot, or tactical route was exposed.",
        ],

        "analyst_summary": (
            "FACILITYINT POLICY BLOCKED: Request involved prohibited physical-intrusion, sabotage, targeting, "
            "privacy-violating, or security-evasion intent. Safe lawful defensive facility intelligence remains available: "
            "facility identity, site/parcel/building resolution, owner/operator/occupant separation, high-level function, "
            "dependencies for resilience, hazard exposure, incident history, change detection, and human-governed safety/compliance analysis."
        ),

        "dual_ai_review": {
            "primary_facility_analyst": "Request blocked by policy guard.",
            "independent_facility_skeptic_issues": [
                "No lawful defensive facility analysis can proceed under prohibited intent.",
                "No tactical security detail may be produced.",
                "No private-person location or routine may be exposed.",
                "No dependency analysis may be converted into disruption guidance.",
            ],
            "verdict": "BLOCKED_POLICY",
            "note": "AI agreement is irrelevant when the request violates lawful defensive boundaries.",
        },

        "replay_manifest": {
            "generated_at": now_iso(),
            "pipeline_version": PIPELINE_VERSION,
            "core_principle": (
                "LAWFUL AUTHORIZED DEFENSIVE FACILITY INTELLIGENCE ONLY: "
                "resolve identity, separate relationships, verify function, preserve time, model resilience, "
                "withhold tactical detail, and route consequential decisions to humans."
            ),
            "as_of": case.as_of,
            "policy_exclusions": [
                "No physical intrusion planning.",
                "No lock/badge/alarm/camera/guard bypass.",
                "No sabotage or utility disruption planning.",
                "No weapon targeting or hostile reconnaissance.",
                "No private residence/person tracking.",
                "No autonomous building-system control or physical action.",
            ],
        },
    }


def run_pipeline(case: Case) -> Dict[str, Any]:
    text = " ".join(
        [
            case.objective,
            *case.questions,
            *case.facility_names,
            *case.organization_names,
            *case.addresses,
            *case.coordinates,
            *case.parcels,
            *case.buildings,
            *case.campuses,
            case.time_range or "",
            case.authorization or "",
            " ".join(case.scope),
        ]
    )

    violations = policy_guard(text)
    if violations:
        return blocked_policy_result(case, violations)

    if case.sample:
        return run_sample_pipeline()

    return run_unconfigured_pipeline(case)


# =====================================================================
# CLI
# =====================================================================

def main() -> None:
    parser = argparse.ArgumentParser(
        description=(
            "TRACEATLAS FACILITYINT local lawful defensive facility & site intelligence pipeline. "
            "Sample mode uses synthetic authorized/public-style facility, parcel, building, imagery, "
            "utility, hazard, inspection, and facility-management metadata."
        )
    )
    parser.add_argument("--sample", action="store_true", help="Run built-in synthetic FACILITYINT sample.")
    parser.add_argument("--objective", help="Lawful defensive facility-intelligence objective.")
    parser.add_argument("--question", action="append", default=[], help="Analytic question. Repeatable.")
    parser.add_argument("--facility", action="append", default=[], help="Facility name. Repeatable.")
    parser.add_argument("--organization", action="append", default=[], help="Organization name. Repeatable.")
    parser.add_argument("--address", action="append", default=[], help="Address hint. Repeatable.")
    parser.add_argument("--coordinate", action="append", default=[], help="Coordinate hint. Repeatable.")
    parser.add_argument("--parcel", action="append", default=[], help="Parcel identifier. Repeatable.")
    parser.add_argument("--building", action="append", default=[], help="Building identifier/name. Repeatable.")
    parser.add_argument("--campus", action="append", default=[], help="Campus identifier/name. Repeatable.")
    parser.add_argument("--time-range", help="Time range hint.")
    parser.add_argument("--as-of", default=DEFAULT_AS_OF, help="Analysis as-of timestamp.")

    args = parser.parse_args()

    if args.sample or not args.objective:
        case = sample_case()
    else:
        case = Case(
            case_id=new_id("CASE-", args.objective),
            task_id=new_id("TASK-", args.objective),
            objective=args.objective,
            questions=args.question,
            facility_names=args.facility,
            organization_names=args.organization,
            addresses=args.address,
            coordinates=args.coordinate,
            parcels=args.parcel,
            buildings=args.building,
            campuses=args.campus,
            time_range=args.time_range,
            as_of=args.as_of,
            sample=False,
        )

    result = run_pipeline(case)
    print(json.dumps(jsonable(result), indent=2, ensure_ascii=False))


if __name__ == "__main__":
    main()
    