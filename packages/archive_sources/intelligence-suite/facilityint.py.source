def graph_version_hash(h: FacilityInt) -> str:
    seed_obj = {
        "facilities": sorted(
            (
                fid,
                f.name,
                f.facility_type.value,
                f.function_state.value,
                f.operating_status.value,
                tuple(sorted(f.owner_candidates)),
                tuple(sorted(f.operator_candidates)),
            )
            for fid, f in h.facilities.items()
        ),
        "sites": sorted((sid, s.name, s.land_use, s.site_area or 0.0) for sid, s in h.sites.items()),
        "parcels": sorted((pid, p.identifier, p.legal_owner_candidate, p.land_use) for pid, p in h.parcels.items()),
        "buildings": sorted((bid, b.site_id, b.name, b.status.value, b.floor_count or 0) for bid, b in h.buildings.items()),
        "findings": sorted(
            (fid, f.finding_type.value, f.subject_id, f.verification_state.value, round(float(f.confidence), 3))
            for fid, f in h.findings.items()
        ),
    }
    return sha256_short(json.dumps(jsonable(seed_obj), sort_keys=True))


def build_source_graph(h: FacilityInt) -> Dict[str, Any]:
    edges = []
    for src in h.sources.values():
        if src.derived_from:
            edges.append({"source": src.derived_from, "target": src.id, "relationship_type": "DERIVED_FROM"})
    return {"nodes": [s.id for s in h.sources.values()], "edges": edges}


def build_source_dependency_graph(h: FacilityInt) -> Dict[str, List[str]]:
    families: Dict[str, List[str]] = defaultdict(list)
    for sid in h.sources:
        fam = h.get_source_family(sid) or "UNKNOWN"
        families[fam].append(sid)
    return {k: sorted(v) for k, v in families.items()}


def build_facility_graph(h: FacilityInt) -> Dict[str, Any]:
    nodes: List[Dict[str, Any]] = []
    edges: List[Dict[str, Any]] = []

    for fac in h.facilities.values():
        nodes.append({
            "id": fac.id,
            "type": "Facility",
            "name": fac.name,
            "facility_type": fac.facility_type.value,
            "function_state": fac.function_state.value,
            "operating_status": fac.operating_status.value,
        })
        for owner in fac.owner_candidates:
            nodes.append({"id": f"OWNER-{owner}", "type": "Owner", "name": owner})
            edges.append({"source": fac.id, "target": f"OWNER-{owner}", "relationship_type": "OWNED_BY_CANDIDATE"})
        for oper in fac.operator_candidates:
            nodes.append({"id": f"OPERATOR-{oper}", "type": "Operator", "name": oper})
            edges.append({"source": fac.id, "target": f"OPERATOR-{oper}", "relationship_type": "OPERATED_BY_CANDIDATE"})
        for occ in set(fac.occupants + fac.tenants):
            nodes.append({"id": f"OCCUPANT-{occ}", "type": "Occupant/Tenant", "name": occ})
            edges.append({"source": fac.id, "target": f"OCCUPANT-{occ}", "relationship_type": "OCCUPIED_BY_OR_TENANT"})
        if fac.site_id:
            edges.append({"source": fac.id, "target": fac.site_id, "relationship_type": "PART_OF_SITE"})
        for pid in fac.parcel_ids:
            edges.append({"source": fac.id, "target": pid, "relationship_type": "LOCATED_ON_PARCEL"})
        for bid in fac.building_ids:
            edges.append({"source": fac.id, "target": bid, "relationship_type": "USES_BUILDING"})
        for dep in fac.dependencies:
            nodes.append({"id": dep.id, "type": "Dependency", "dep_type": dep.dep_type.value, "provider": dep.provider})
            edges.append({"source": fac.id, "target": dep.id, "relationship_type": "DEPENDS_ON"})
        for hz in fac.hazards:
            nodes.append({"id": hz.id, "type": "Hazard", "hazard_type": hz.hazard_type.value, "exposure": hz.exposure.value})
            edges.append({"source": fac.id, "target": hz.id, "relationship_type": "EXPOSED_TO_HAZARD"})
        for inc in fac.incidents:
            nodes.append({"id": inc.id, "type": "Incident", "incident_type": inc.incident_type, "recovery_status": inc.recovery_status})
            edges.append({"source": fac.id, "target": inc.id, "relationship_type": "AFFECTED_BY"})
        for ch in fac.changes:
            nodes.append({"id": ch.id, "type": "Change", "change_type": ch.change_type, "new_state": ch.new_state})
            edges.append({"source": fac.id, "target": ch.id, "relationship_type": "CHANGED_BY"})

    for site in h.sites.values():
        nodes.append({"id": site.id, "type": "Site", "name": site.name, "land_use": site.land_use})
    for parcel in h.parcels.values():
        nodes.append({"id": parcel.id, "type": "Parcel", "identifier": parcel.identifier, "legal_owner_candidate": parcel.legal_owner_candidate})
        for fid in h.facilities:
            if parcel.id in h.facilities[fid].parcel_ids:
                edges.append({"source": fid, "target": parcel.id, "relationship_type": "LOCATED_ON_PARCEL"})
    for b in h.buildings.values():
        nodes.append({"id": b.id, "type": "Building", "name": b.name, "status": b.status.value})
        edges.append({"source": b.id, "target": b.site_id, "relationship_type": "PART_OF_SITE"})

    return {
        "nodes": nodes,
        "edges": edges,
        "guardrails": [
            "Facility, site, parcel, and building are distinct node types.",
            "Owner, operator, occupant, and tenant relationships are separate.",
            "Dependencies and hazards are resilience context, not attack vectors.",
            "No tactical security-control map is represented.",
        ],
    }


def build_timeline(h: FacilityInt) -> List[Dict[str, Any]]:
    events: List[Dict[str, Any]] = []

    for fac in h.facilities.values():
        for ch in fac.changes:
            t = ch.effective_at or ch.observed_at
            if t:
                events.append({
                    "time": t,
                    "type": "FACILITY_CHANGE",
                    "subject_id": ch.id,
                    "description": f"{ch.change_type}: {ch.old_state} -> {ch.new_state}",
                    "source_ids": ch.source_ids,
                    "evidence_ids": ch.evidence_ids,
                })
        for inc in fac.incidents:
            if inc.started_at:
                events.append({
                    "time": inc.started_at,
                    "type": "INCIDENT",
                    "subject_id": inc.id,
                    "description": f"{inc.incident_type}: {inc.summary}; recovery={inc.recovery_status}",
                    "source_ids": inc.source_ids,
                    "evidence_ids": inc.evidence_ids,
                })
        for p in fac.permits:
            if p.issued_at:
                events.append({
                    "time": p.issued_at,
                    "type": "PERMIT",
                    "subject_id": p.id,
                    "description": f"Permit {p.permit_type} status={p.status}; scope={p.scope_summary}",
                    "source_ids": p.source_ids,
                    "evidence_ids": p.evidence_ids,
                })
        for insp in fac.inspections:
            if insp.date:
                events.append({
                    "time": insp.date,
                    "type": "INSPECTION",
                    "subject_id": insp.id,
                    "description": f"{insp.inspection_type} outcome={insp.outcome}",
                    "source_ids": insp.source_ids,
                    "evidence_ids": insp.evidence_ids,
                })
        for obs in fac.imagery_observations:
            t = obs.get("capture_date")
            if t:
                events.append({
                    "time": t,
                    "type": "IMAGERY_OBSERVATION",
                    "subject_id": obs.get("observation_id", fac.id),
                    "description": obs.get("summary", ""),
                    "source_ids": [obs.get("provider", "")],
                    "evidence_ids": [],
                })

    return sorted(events, key=lambda e: dt_or_min(e.get("time")))


def build_facts_by_state(h: FacilityInt) -> Dict[str, List[Finding]]:
    out: Dict[str, List[Finding]] = defaultdict(list)
    for f in h.findings.values():
        out[f.verification_state.value].append(f)
    return {k: v for k, v in out.items()}


def build_result(h: FacilityInt, status: Status) -> Dict[str, Any]:
    dual = h.dual_ai_review()
    summary = h.analyst_summary(dual)
    source_families = build_source_dependency_graph(h)
    facts_by_state = build_facts_by_state(h)

    finding_independence = {
        fid: h.independence_state(f.source_ids)
        for fid, f in h.findings.items()
    }

    supported_facts = facts_by_state.get(VerificationState.SUPPORTED.value, [])
    partial_facts = facts_by_state.get(VerificationState.PARTIALLY_SUPPORTED.value, [])
    candidate_facts = facts_by_state.get(VerificationState.CANDIDATE.value, [])
    disputed_facts = facts_by_state.get(VerificationState.DISPUTED.value, [])
    observed_facts = facts_by_state.get(VerificationState.OBSERVED.value, [])

    dependencies = [d for f in h.facilities.values() for d in f.dependencies]
    hazards = [x for f in h.facilities.values() for x in f.hazards]
    incidents = [x for f in h.facilities.values() for x in f.incidents]
    changes = [x for f in h.facilities.values() for x in f.changes]
    permits = [x for f in h.facilities.values() for x in f.permits]
    inspections = [x for f in h.facilities.values() for x in f.inspections]
    certifications = [x for f in h.facilities.values() for x in f.certifications]
    resilience = [x for f in h.facilities.values() for x in f.resilience_evidence]
    capacity_claims = [x for f in h.facilities.values() for x in f.capacity_claims]
    imagery = [x for f in h.facilities.values() for x in f.imagery_observations]

    addresses = [a for f in h.facilities.values() for a in f.addresses]
    coordinates = [c for f in h.facilities.values() for c in f.coordinates]

    sensitivity_flags = sorted({
        flag
        for f in h.findings.values()
        for flag in f.sensitivity_flags
    } | {
        SensitivityFlag.NON_PUBLIC_PLANS_RESTRICTED.value,
        SensitivityFlag.PRIVATE_RESIDENCE_EXCLUDED.value,
        SensitivityFlag.TACTICAL_ROUTE_ANALYSIS_WITHHELD.value,
    })

    privacy_flags = [
        PrivacyFlag.CASE_SCOPED.value,
        PrivacyFlag.NO_PRIVATE_PERSON_LOCATION.value,
        PrivacyFlag.NO_EMPLOYEE_ROUTINE.value,
        PrivacyFlag.NO_REALTIME_OCCUPANCY.value,
        PrivacyFlag.PURPOSE_LIMITATION.value,
        PrivacyFlag.LOCAL_ONLY_DEFAULT.value,
    ]

    legal_flags = [
        LegalFlag.PROPERTY_RECORD_REVIEW_REQUIRED.value,
        LegalFlag.PERMIT_INTERPRETATION_LEGALINT.value,
        LegalFlag.REGULATORY_LEGAL_REVIEW.value,
        LegalFlag.HUMAN_REVIEW_FOR_CRITICAL_INFRA.value,
    ]

    limitations = [
        "Local synthetic demo; no live property, GIS, permit, imagery, facility-management, or sensor access.",
        "Lawful authorized defensive facility intelligence only.",
        "No physical intrusion, bypass, sabotage, targeting, hostile reconnaissance, or security-control evasion was planned.",
        "No private-person residence, employee routine, guard schedule, camera blind spot, or real-time occupancy was exposed.",
        "Facility is not building; site is not parcel; address is not facility identity.",
        "Owner is not operator; operator is not occupant; tenant is not property owner.",
        "Permit is not completion; design capacity is not actual utilization.",
        "Imagery is not real-time; visible change does not establish internal function.",
        "Hazard exposure is not facility failure; documented resilience is not tested resilience.",
        "Dependency analysis is for resilience/business continuity, not attack optimization.",
        "Sensitive/critical facility details are withheld and require human review.",
    ] + h.validation_errors

    replay_manifest = {
        "generated_at": now_iso(),
        "pipeline_version": PIPELINE_VERSION,
        "graph_version": graph_version_hash(h),
        "core_principle": (
            "FACILITY REFERENCE -> SITE RESOLUTION -> LOCATION VALIDATION -> OWNER / OPERATOR / OCCUPANT RESOLUTION -> "
            "FACILITY TYPE -> FUNCTION -> SITE / BUILDING RELATIONSHIPS -> AUTHORIZED PHYSICAL CONTEXT -> DEPENDENCIES -> "
            "ENVIRONMENTAL / RESILIENCE CONTEXT -> TEMPORAL VALIDATION -> SOURCE RELIABILITY -> SOURCE INDEPENDENCE -> "
            "FACT GATE -> DEFENSIBLE FACILITY ASSESSMENT"
        ),
        "as_of": h.as_of,
        "identity_rule": "Facility != building; site != parcel; address != facility; registered office != operational site.",
        "relationship_rule": "Owner, operator, occupant, and tenant are separate time-bound relationships.",
        "function_rule": "Facility type and imagery do not establish exact internal function or process topology.",
        "temporal_rule": "Historical owner/operator/occupant/function/footprint must not contaminate current state.",
        "imagery_rule": "Imagery capture date and staleness are preserved; archived imagery is not real-time.",
        "dependency_rule": "Dependencies are modeled for resilience and business continuity, never as attack vectors.",
        "hazard_rule": "Hazard exposure is not facility failure; mitigation and engineering evidence matter.",
        "resilience_rule": "Documented resilience is not tested resilience.",
        "security_rule": "Security observations are not converted into weaknesses, bypasses, blind spots, or targeting.",
        "privacy_rule": "No private-person residence, employee routine, guard schedule, or real-time occupancy exposure.",
        "policy_exclusions": [
            "No physical intrusion planning.",
            "No lock/badge/alarm/camera/guard bypass.",
            "No sabotage or utility disruption planning.",
            "No weapon targeting or hostile reconnaissance.",
            "No private residence/person tracking.",
            "No autonomous building-system control or physical action.",
        ],
        "source_lineage": source_families,
        "finding_independence": finding_independence,
    }

    return {
        "case_id": h.case.case_id,
        "task_id": h.case.task_id,
        "objective": h.case.objective,
        "questions": h.case.questions,
        "scope": h.case.scope,
        "authorization": h.case.authorization,
        "status": status.value,
        "as_of": h.as_of,

        "source_ids": sorted(h.sources.keys()),
        "evidence_ids": sorted(h.evidence.keys()),

        "facilities": list(h.facilities.values()),
        "sites": list(h.sites.values()),
        "campuses": [s for s in h.sites.values() if len(s.facility_ids) > 1],
        "parcels": list(h.parcels.values()),
        "buildings": list(h.buildings.values()),

        "addresses": addresses,
        "coordinates": coordinates,
        "geospatial_precision": sorted({c.precision.value for c in coordinates}) if coordinates else [],

        "facility_types": sorted({f.facility_type.value for f in h.facilities.values()}),
        "property_owners": sorted({o for f in h.facilities.values() for o in f.owner_candidates}),
        "operators": sorted({o for f in h.facilities.values() for o in f.operator_candidates}),
        "occupants": sorted({o for f in h.facilities.values() for o in f.occupants}),
        "tenants": sorted({t for f in h.facilities.values() for t in f.tenants}),

        "facility_functions": {f.id: f.function for f in h.facilities.values()},
        "functional_zones": {
            "policy": "High-level functional zones only; no intrusion-routing, least-protected-route, or asset-access guidance."
        },
        "operating_status": {f.id: f.operating_status.value for f in h.facilities.values()},
        "site_boundaries": {s.id: s.boundary_geometry for s in h.sites.values()},
        "building_relationships": [
            {"building_id": b.id, "site_id": b.site_id, "relationship": "PART_OF_SITE"}
            for b in h.buildings.values()
        ],
        "site_areas": {s.id: s.site_area for s in h.sites.values()},
        "floor_areas": {b.id: b.floor_area for b in h.buildings.values()},
        "floor_counts": {b.id: b.floor_count for b in h.buildings.values()},
        "capacity_claims": capacity_claims,

        "construction_history": [ch for ch in changes if ch.change_type in {"CONSTRUCTION_START", "RENOVATION", "EXPANSION", "DEMOLITION"}],
        "permit_context": permits,
        "renovations": [ch for ch in changes if ch.change_type == "RENOVATION"],
        "expansions": [ch for ch in changes if ch.change_type in {"EXPANSION", "CONSTRUCTION_START"}],
        "demolitions": [ch for ch in changes if ch.change_type == "DEMOLITION"],
        "facility_lifecycle": {
            f.id: {
                "opening_date": f.opening_date,
                "closing_date": f.closing_date,
                "operating_status": f.operating_status.value,
                "changes": [ch.change_type for ch in f.changes],
            }
            for f in h.facilities.values()
        },

        "imagery_observations": imagery,
        "satellite_observations": [x for x in imagery if "satellite" in str(x).lower()],
        "change_detection": [ch for ch in changes if ch.change_type in {"CONSTRUCTION_START", "DEMOLITION", "EXPANSION", "RENOVATION"}],

        "transport_context": {s.id: s.public_transport_context for s in h.sites.values()},
        "logistics_context": {s.id: s.logistics_context for s in h.sites.values()},
        "utility_dependencies": [d for d in dependencies if d.dep_type in {
            DependencyType.POWER, DependencyType.WATER, DependencyType.TELECOM, DependencyType.GAS, DependencyType.FUEL
        }],
        "power_context": [d for d in dependencies if d.dep_type == DependencyType.POWER],
        "water_context": [d for d in dependencies if d.dep_type == DependencyType.WATER],
        "telecom_context": [d for d in dependencies if d.dep_type == DependencyType.TELECOM],
        "network_context": [d for d in dependencies if d.dep_type == DependencyType.NETWORK],
        "supplier_context": [d for d in dependencies if d.dep_type == DependencyType.SUPPLIER],
        "asset_context": {
            "policy": "Authorized asset context remains high-level; sensitive exact placement is withheld."
        },
        "capability_context": {
            "policy": "Capability claims are source-bound; equipment presence does not prove operational capability."
        },

        "environmental_context": {s.id: s.environmental_context for s in h.sites.values()},
        "natural_hazard_context": hazards,
        "flood_context": [x for x in hazards if x.hazard_type == HazardType.FLOOD],
        "earthquake_context": [x for x in hazards if x.hazard_type == HazardType.EARTHQUAKE],
        "wildfire_context": [x for x in hazards if x.hazard_type == HazardType.WILDFIRE],
        "storm_context": [x for x in hazards if x.hazard_type == HazardType.STORM],
        "heat_context": [x for x in hazards if x.hazard_type == HazardType.HEAT],

        "business_continuity_context": [r for r in resilience if r.control_type in {"alternate_site", "disaster_recovery", "backup_power", "telecom_redundancy"}],
        "resilience_context": resilience,
        "redundancy_context": [d.redundancy_state for d in dependencies],

        "inspection_context": inspections,
        "certification_context": certifications,
        "incident_context": incidents,
        "damage_context": [i.damage_state for i in incidents],
        "recovery_context": [i.recovery_status for i in incidents],

        "timeline_updates": build_timeline(h),
        "observations": list(h.evidence.values()),

        "candidate_facts": candidate_facts,
        "supported_facts": supported_facts,
        "partial_facts": partial_facts,
        "disputed_facts": disputed_facts,
        "observed_facts": observed_facts,

        "source_reliability": {sid: src.reliability for sid, src in h.sources.items()},
        "source_bias": {sid: src.notes for sid, src in h.sources.items()},
        "source_limitations": {sid: [src.notes] for sid, src in h.sources.items() if src.notes},
        "source_pedigree": {sid: h.get_source_family(sid) for sid in h.sources},
        "source_independence": {
            "source_families": source_families,
            "finding_independence": finding_independence,
        },

        "contradictions": h.contradictions,
        "hypotheses": h.hypotheses,
        "falsification_results": [
            {
                "hypothesis_id": hy.id,
                "statement": hy.statement,
                "kind": hy.kind,
                "status": hy.status.value,
                "confidence": hy.confidence,
                "supporting_finding_ids": hy.supporting_finding_ids,
                "contradicting_finding_ids": hy.contradicting_finding_ids,
                "assumptions": hy.assumptions,
                "predictions": hy.predictions,
                "falsification_conditions": hy.falsification_conditions,
                "limitations": hy.limitations,
            }
            for hy in h.hypotheses
        ],

        "sensitivity_flags": sensitivity_flags,
        "privacy_flags": privacy_flags,
        "legal_flags": legal_flags,

        "unknowns": sorted(set(
            [g.description for g in h.gaps]
            + [hy.statement for hy in h.hypotheses if hy.status in {HypothesisStatus.UNRESOLVED, HypothesisStatus.DISPUTED}]
        )),
        "knowledge_gaps": h.gaps,
        "recommended_next_actions": h.actions,
        "specialist_handoffs": h.handoffs,
        "recommendations": h.recommendations,
        "limitations": limitations,

        "analyst_summary": summary,
        "dual_ai_review": dual,
        "facility_graph": build_facility_graph(h),
        "source_graph": build_source_graph(h),
        "source_dependency_graph": source_families,
        "replay_manifest": replay_manifest,
    }


# =====================================================================
# PIPELINES
# =====================================================================

def run_sample_pipeline() -> Dict[str, Any]:
    h = build_sample_facilityint()
    return build_result(h, Status.PARTIAL)


def run_unconfigured_pipeline(case: Case) -> Dict[str, Any]:
    h = FacilityInt(case)

    h.gaps.append(KnowledgeGap(
        id="GAP-NO-FACILITY-EVIDENCE",
        gap_type=GapType.FACILITY_IDENTITY_UNRESOLVED,
        description=(
            "No configured authorized/public facility corpus is available. "
            "No facility, site, parcel, building, owner, operator, occupant, function, dependency, "
            "hazard, incident, change, or resilience claim can be resolved."
        ),
        importance="HIGH",
        recommended_source=(
            "Provide authorized/public property records, GIS metadata, permits, organization disclosures, "
            "licensed/public imagery, utility records, emergency-management hazard maps, inspection records, "
            "and authorized facility-management summaries."
        ),
        specialist="FACILITYINT / GEOINT / CORPINT / OWNERSHIPINT / LEGALINT",
        expected_information_value=0.95,
    ))

    h.actions = [NextAction(
        id="ACT-CONFIGURE-FACILITY-EVIDENCE",
        description=(
            "Configure lawful public/authorized facility evidence or sanitized local corpus. "
            "Do not plan intrusion, bypass, sabotage, targeting, hostile reconnaissance, private-person tracking, "
            "or security-control evasion."
        ),
        priority=1,
        privacy_impact="LOW",
        expected_gain=0.95,
        specialist=None,
        requires_human_approval=False,
    )]

    h.handoffs = []
    h.recommendations = []
    h.hypotheses = []
    h.contradictions = []

    dual = {
        "primary_facility_analyst": "No evidence available.",
        "independent_facility_skeptic_issues": [
            "No facility corpus configured.",
            "No site/parcel/building resolved.",
            "No owner/operator/occupant relationship can be assessed.",
            "No dependency, hazard, incident, change, or resilience claim can be made.",
            "No tactical security detail may be fabricated.",
        ],
        "verdict": "INSUFFICIENT_EVIDENCE",
        "note": "AI agreement is not independent facility corroboration.",
    }

    summary = (
        "FACILITYINT UNRESOLVED: No configured authorized/public facility corpus. "
        "No facility, site, parcel, building, owner, operator, occupant, function, capacity, dependency, "
        "hazard, incident, resilience, intrusion route, sabotage plan, or targeting data was fabricated. "
        "Provide lawful evidence or run sample mode."
    )

    result = build_result(h, Status.BLOCKED_CONFIGURATION)
    result["analyst_summary"] = summary
    result["dual_ai_review"] = dual
    return result


def blocked_policy_result(case: Case, violations: List[Dict[str, str]]) -> Dict[str, Any]:
    return {
        "case_id": case.case_id,
        "task_id": case.task_id,
        "objective": case.objective,
        "questions": case.questions,
        "status": Status.BLOCKED_POLICY.value,
        "policy_violations": violations,
        "message": (
            "Prohibited facility-intelligence request detected. FACILITYINT supports lawful, authorized, "
            "defensive, evidence-first facility and site intelligence only. It does not plan physical intrusion, "
            "covert entry, lock/badge/alarm/camera/guard bypass, sabotage, power/water/telecom disruption, "
            "weapon targeting, hostile reconnaissance, private-person tracking, or security-control evasion."
        ),
        "lawful_alternatives": [
            "Resolve facility/site/parcel/building identity from public/authorized records.",
            "Separate owner, operator, occupant, and tenant relationships.",
            "Assess high-level function, capacity basis, construction lifecycle, and temporal changes.",
            "Analyze utility/logistics dependencies for resilience and business continuity only.",
            "Compare hazard exposure with mitigation, inspections, and emergency planning.",
            "Use imagery for change detection with capture-date discipline; do not treat as real-time.",
            "Withhold sensitive security/control topology and route critical/sensitive cases to human review.",
            "Hand network/OT/supply-chain/legal questions to appropriate specialists.",
        ],
        "sensitivity_flags": [
            SensitivityFlag.SECURITY_CONTROL_DETAILS
            def blocked_policy_result(case: Case, violations: List[Dict[str, str]]) -> Dict[str, Any]:
    return {
