def sample_case() -> Case:
    return Case(
        case_id="SAMPLE-FACILITYINT-001",
        task_id="TASK-FACILITYINT-001",
        objective=(
            "Authorized defensive facility and site intelligence for synthetic Helios Northbridge Campus. "
            "Resolve facility/site/parcel/building identity, separate owner/operator/occupant, assess high-level function, "
            "dependencies, hazards, resilience, incidents, and changes using public/authorized-style evidence only."
        ),
        questions=[
            "What facility/site/parcel/building relationships are evidenced?",
            "Who is the property owner candidate?",
            "Who is the facility operator candidate?",
            "Who occupies or tenants the site?",
            "What high-level function is supported?",
            "What utility/service/logistics dependencies are documented?",
            "What natural/environmental hazard context applies?",
            "What resilience evidence is documented versus tested?",
            "What incidents and changes occurred over time?",
            "What remains unknown and what defensive next actions are appropriate?",
        ],
        scope=[
            "lawful_authorized_defensive_facility_intelligence",
            "evidence_first",
            "high_level_only",
            "no_intrusion_planning",
            "no_sabotage_planning",
            "no_targeting",
            "privacy_aware",
        ],
        authorization="demo_authorized_facility_intelligence",
        facility_names=["Helios Northbridge Campus"],
        organization_names=["Helios Compute Services", "Northgate Property Trust", "Aurora Analytics"],
        addresses=["Northbridge Industrial Park, Sector 7"],
        time_range="2019-01-01/2026-10-09",
        as_of=DEFAULT_AS_OF,
        sample=True,
    )


