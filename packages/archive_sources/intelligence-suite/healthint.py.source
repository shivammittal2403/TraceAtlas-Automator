    def fact_gate_findings(self) -> None:
        for f in self.findings.values():
            srcs = [self.sources[sid] for sid in f.source_ids if sid in self.sources]
            if not srcs:
                f.confidence = 0.0 if f.finding_type not in {
                    FindingType.NO_INDIVIDUAL_DIAGNOSIS,
                    FindingType.BIOSECURITY_BOUNDARY_ENFORCED,
                    FindingType.STIGMATIZATION_CONTROL,
                    FindingType.OFFICIAL_OUTBREAK_NOT_DECLARED,
                    FindingType.PRIVACY_AGGREGATION_ENFORCED,
                } else 0.99
                if f.verification_state == VerificationState.OBSERVED:
                    f.verification_state = VerificationState.INCONCLUSIVE
                f.limitations.append("No mapped source for fact gate; governance finding may still be policy-supported.")
                continue

            families = self.source_families(f.source_ids)
            max_rel = max((s.reliability for s in srcs), default=0.5)
            direct = max((SOURCE_FACTOR.get(s.source_type, 0.65) for s in srcs), default=0.65)
            base = max_rel * direct

            if len(families) >= 2:
                base = min(0.99, base * 1.05)
            elif len(families) == 1 and len(f.source_ids) > 1:
                base *= 0.90
                f.limitations.append("Multiple sources share one upstream source family.")

            ft = f.finding_type
            if ft == FindingType.POPULATION_LEVEL_SIGNAL_OBSERVED:
                f.verification_state = VerificationState.SUPPORTED if base >= 0.70 else VerificationState.PARTIALLY_SUPPORTED
                f.limitations.append("Population-level only; no individual inference.")

            elif ft == FindingType.ELEVATED_RESPIRATORY_ACTIVITY:
                f.verification_state = VerificationState.SUPPORTED if base >= 0.72 else VerificationState.PARTIALLY_SUPPORTED
                f.limitations.extend([
                    "Syndromic increase is not disease-specific diagnosis.",
                    "Alternative explanations must be tested.",
                ])

            elif ft == FindingType.LAB_POSITIVITY_INCREASE:
                f.verification_state = VerificationState.PARTIALLY_SUPPORTED
                base = min(base, 0.82)
                f.limitations.append("Positivity depends on testing volume, criteria, and selection effects.")

            elif ft == FindingType.WASTEWATER_UPWARD_SIGNAL:
                f.verification_state = VerificationState.SUPPORTED if base >= 0.70 else VerificationState.OBSERVED
                f.limitations.append("Wastewater is not exact case count.")

            elif ft == FindingType.HOSPITAL_CAPACITY_STRESS_CANDIDATE:
                f.verification_state = VerificationState.CANDIDATE
                base = min(base, 0.78)
                f.limitations.append("Capacity stress requires staffing/operational bed context.")

            elif ft == FindingType.MEDICINE_SUPPLY_CONSTRAINT_OBSERVED:
                f.verification_state = VerificationState.OBSERVED
                f.specialist_handoff = f.specialist_handoff or "SUPPLYCHAININT"
                f.limitations.append("Supply claim is not inventory or individual treatment guidance.")

            elif ft == FindingType.VACCINATION_COVERAGE_OBSERVED:
                f.verification_state = VerificationState.SUPPORTED if base >= 0.72 else VerificationState.OBSERVED
                f.limitations.append("Coverage is not individual immunity or effectiveness.")

            elif ft == FindingType.ENVIRONMENTAL_CORRELATION_CANDIDATE:
                f.verification_state = VerificationState.CANDIDATE
                base = min(base, 0.65)
                f.limitations.append("Population correlation is not individual causation.")

            elif ft in {FindingType.MISINFORMATION_REACH_OBSERVED, FindingType.PUBLIC_CONCERN_NOT_PREVALENCE}:
                f.verification_state = VerificationState.OBSERVED
                base = min(base, 0.65)
                f.limitations.append("Public concern is not disease prevalence.")

            elif ft == FindingType.OUTBREAK_CANDIDATE:
                f.verification_state = VerificationState.CANDIDATE
                base = min(base, 0.75)
                f.specialist_handoff = "HUMAN_PUBLIC_HEALTH_AUTHORITY"
                f.limitations.extend([
                    "Not an official outbreak declaration.",
                    "Requires epidemiological investigation and independent corroboration.",
                ])

            elif ft == FindingType.SOURCE_DEPENDENCY_OBSERVED:
                f.verification_state = VerificationState.SUPPORTED
                f.limitations.append("Do not count dependent sources as independent confirmation.")

            elif ft == FindingType.SMALL_CELL_SUPPRESSED:
                f.verification_state = VerificationState.SUPPORTED
                base = 0.99
                f.limitations.append("Privacy suppression enforced.")

            elif ft == FindingType.CONTRADICTION_OBSERVED:
                f.verification_state = VerificationState.DISPUTED
                base = min(base, 0.80)
                f.limitations.append("Preserve contradictory counts and definitions.")

            elif ft == FindingType.PROVISIONAL_DATA_OBSERVED:
                f.verification_state = VerificationState.SUPPORTED
                f.limitations.append("Provisional data may be revised.")

            elif ft in {
                FindingType.NO_INDIVIDUAL_DIAGNOSIS,
                FindingType.BIOSECURITY_BOUNDARY_ENFORCED,
                FindingType.STIGMATIZATION_CONTROL,
                FindingType.OFFICIAL_OUTBREAK_NOT_DECLARED,
                FindingType.PRIVACY_AGGREGATION_ENFORCED,
            }:
                f.verification_state = VerificationState.SUPPORTED
                f.confidence = 0.99
                continue

            else:
                if base >= 0.75:
                    f.verification_state = VerificationState.SUPPORTED
                elif base >= 0.60:
                    f.verification_state = VerificationState.PARTIALLY_SUPPORTED
                elif base >= 0.40:
                    f.verification_state = VerificationState.INCONCLUSIVE
                else:
                    f.verification_state = VerificationState.UNSUPPORTED

            f.confidence = round(max(0.0, min(0.99, base)), 3)

    def build_data_quality(self) -> None:
        total = len(self.observations)
        suppressed = sum(1 for o in self.observations.values() if o.suppressed)
        provisional = sum(1 for o in self.observations.values() if o.provisional and not o.suppressed)
        missing_denom = sum(1 for o in self.observations.values() if not o.suppressed and o.denominator is None and o.metric in {
            MetricType.RESPIRATORY_PRESENTATIONS,
            MetricType.LAB_CONFIRMED_CASES,
            MetricType.HOSPITALIZATIONS,
            MetricType.DEATHS,
        })
        self.data_quality = {
            "as_of": self.as_of,
            "observation_count": total,
            "suppressed_count": suppressed,
            "provisional_count": provisional,
            "missing_denominator_count": missing_denom,
            "small_cell_threshold": SMALL_CELL_THRESHOLD,
            "state": DataQualityState.FAIR.value if missing_denom == 0 and provisional < total * 0.5 else DataQualityState.POOR.value,
            "guardrails": [
                "Data quality does not justify individual inference.",
                "Provisional data must be labeled and revised historically.",
                "Missing data is not imputed silently.",
            ],
        }

    def dual_ai_review(self) -> Dict[str, Any]:
        issues: List[str] = []

        if any(f.finding_type == FindingType.OUTBREAK_CANDIDATE for f in self.findings.values()):
            issues.append("Outbreak candidate remains candidate-only; official declaration requires human authority.")

        if any(f.finding_type == FindingType.LAB_POSITIVITY_INCREASE for f in self.findings.values()):
            issues.append("Laboratory positivity must be interpreted with testing volume/criteria.")

        if any(f.finding_type == FindingType.SOURCE_DEPENDENCY_OBSERVED for f in self.findings.values()):
            issues.append("Some public/news sources are dependent on official bulletin.")

        if any(f.finding_type == FindingType.SMALL_CELL_SUPPRESSED for f in self.findings.values()):
            issues.append("Small-cell suppression limits finer pediatric/rare analysis.")

        if any(f.finding_type == FindingType.PROVISIONAL_DATA_OBSERVED for f in self.findings.values()):
            issues.append("Provisional surveillance may be revised.")

        if self.contradictions:
            issues.append(f"{len(self.contradictions)} contradiction(s) remain open.")

        if not issues:
            verdict = "AGREE"
        elif len(issues) <= 5:
            verdict = "PARTIAL_AGREEMENT"
        else:
            verdict = "INSUFFICIENT_EVIDENCE"

        return {
            "primary_public_health_analyst": (
                "Synthetic authorized aggregated corpus supports elevated respiratory activity in Northbridge, "
                "with partial laboratory and wastewater corroboration and hospital occupancy stress candidate. "
                "Signal is population-level only and not an official outbreak declaration."
            ),
            "independent_epidemiology_skeptic_issues": issues,
            "verdict": verdict,
            "adversarial_checks": [
                "Is individual diagnosis performed? No.",
                "Are small cells suppressed? Yes.",
                "Are dependent sources counted as independent? No.",
                "Is syndromic case treated as confirmed disease? No.",
                "Is wastewater treated as case count? No.",
                "Is correlation treated as causation? No.",
                "Is pathogen engineering or biological harm enabled? No.",
                "Is stigmatizing group attribution avoided? Yes.",
            ],
            "note": "AI agreement is analytical agreement, not independent epidemiological evidence.",
        }

    def analyst_summary(self, dual: Dict[str, Any]) -> str:
        syndromic = self.latest_observation(MetricType.RESPIRATORY_PRESENTATIONS, CaseDefinitionType.SYNDROMIC_RESPIRATORY)
        lab = self.latest_observation(MetricType.TEST_POSITIVITY, CaseDefinitionType.LAB_CONFIRMED)
        ww = self.latest_observation(MetricType.WASTEWATER_SIGNAL)
        hosp = self.latest_observation(MetricType.HOSPITAL_OCCUPANCY)
        vax = self.latest_observation(MetricType.VACCINATION_COVERAGE)
        stock = self.latest_observation(MetricType.MEDICINE_STOCKOUT_RATE)

        lines = [
            "PUBLIC-HEALTH QUESTION: Is elevated respiratory activity supported by independent population-level signals in Northbridge?",
            "POPULATION: Northbridge all ages, aggregate denominator used.",
            "GEOGRAPHY: Region-level aggregation; no private-person locations.",
            "TIME PERIOD: 2026-09-07 to 2026-10-05 weekly surveillance.",
            "CONDITION / SYNDROME: Respiratory illness syndrome; pathogen-specific confirmation incomplete.",
            "CASE DEFINITION: SYNDROMIC_RESPIRATORY; not individual diagnosis.",
            "",
            "CURRENT SIGNAL:",
            f"- Syndromic respiratory presentations latest: {syndromic.numerator if syndromic else 'UNKNOWN'}.",
            f"- Laboratory positivity latest: {lab.percentage if lab and lab.percentage is not None else 'UNKNOWN'}%.",
            f"- Wastewater normalized signal latest: {ww.value if ww else 'UNKNOWN'} {ww.unit if ww else ''}.",
            f"- Hospital occupancy latest: {hosp.percentage if hosp and hosp.percentage is not None else 'UNKNOWN'}%.",
            f"- Vaccination coverage latest: {vax.percentage if vax and vax.percentage is not None else 'UNKNOWN'}%.",
            f"- Medicine stockout rate latest: {stock.percentage if stock and stock.percentage is not None else 'UNKNOWN'}%.",
            "",
            "ASSESSMENT:",
            f"- OUTBREAK_SIGNAL_STATE = {self.outbreak_state.value}.",
            "- ELEVATED_RESPIRATORY_ACTIVITY = SUPPORTED at population level.",
            "- PATHOGEN_SPECIFIC_OUTBREAK = PARTIALLY_SUPPORTED / requires laboratory verification.",
            "- OFFICIAL_OUTBREAK_DECLARATION = NOT MADE / human authority required.",
            "- INDIVIDUAL_DIAGNOSIS = NOT PERMITTED / NOT INFERRED.",
            "",
            "ALTERNATIVE EXPLANATIONS:",
            "- Testing volume/criteria change.",
            "- Reporting delay/backfill.",
            "- Case-definition change.",
            "- Seasonality.",
            "- Healthcare-seeking behavior/media coverage.",
            "",
            "PRIVACY / BIOSECURITY:",
            "- Small-cell sensitive pediatric/rare signal suppressed.",
            "- No reidentification, no covert surveillance, no pathogen engineering, no biological attack planning.",
            "",
            f"DUAL-AI REVIEW: {dual['verdict']}.",
            "NEXT ACTION: Validate pathogen-specific lab data, reporting-delay metadata, case-definition versions, and operational hospital capacity; hand supply questions to SUPPLYCHAININT; route declaration/action to human public-health authority.",
        ]
        return "\n".join(lines)

    def prepare(self) -> None:
        self.privacy_gate()
        self.compute_rates_and_percentages()
        self.temporal_analysis()
        self.assess_outbreak_signal()
        self.build_core_findings()
        self.detect_source_dependencies_and_contradictions()
        self.build_hypotheses()
        self.build_knowledge_gaps()
        self.build_next_actions()
        self.build_recommendations()
        self.build_handoffs()
        self.fact_gate_findings()
        self.build_data_quality()


