    SourceType.NEWS_REPORT: 0.62,
    SourceType.SOCIAL_PUBLIC_SIGNAL: 0.50,
    SourceType.NGO_PUBLIC_HEALTH: 0.78,
    SourceType.OTHER: 0.65,
}

PROHIBITED_PATTERNS: List[Tuple[str, re.Pattern[str]]] = [
    (
        "INDIVIDUAL_DIAGNOSIS_OR_MEDICAL_ADVICE",
        re.compile(
            r"\b(diagnose|tell me whether|does (this|the|that) person|individual.*(has|infected|disease)|"
            r"prescribe|medication dosage|change treatment|personal medical profile)\b",
            re.IGNORECASE,
        ),
    ),
    (
        "REIDENTIFICATION_OR_PATIENT_TRACKING",
        re.compile(
            r"\b(reidentif\w+|identify patient|find who has|named individual.*health|"
            r"track.*patient|covert.*health surveillance|private person.*health)\b",
            re.IGNORECASE,
        ),
    ),
    (
        "UNAUTHORIZED_MEDICAL_RECORDS_OR_CREDENTIALS",
        re.compile(
            r"\b(access medical records|obtain health records|stolen health credential|"
            r"patient portal|electronic health record without authorization)\b",
            re.IGNORECASE,
        ),
    ),
    (
        "PATHOGEN_ENGINEERING_OR_BIOLOGICAL_HARM",
        re.compile(
            r"\b(engineer|enhance|optimize|design|weaponize|disseminate)\s+"
            r"(pathogen|virus|bacterium|bacteria|virulence|transmissibility|host range|"
            r"immune evasion|diagnostic evasion|biological attack|contamination method)\b",
            re.IGNORECASE,
        ),
    ),
    (
        "HEALTH_DISCRIMINATION_OR_AUTOMATED_ELIGIBILITY",
        re.compile(
            r"\b(health data.*(employment|insurance|immigration|law enforcement|marketing)|"
            r"deny insurance|deny employment|rank individual worth|risk score.*person)\b",
            re.IGNORECASE,
        ),
    ),
    (
        "SMALL_CELL_OR_SENSITIVE_HEALTH_DISCLOSURE",
        re.compile(
            r"\b(expose|publish|reveal).*(small cell|HIV status|STI status|pregnancy status|"
            r"psychiatric diagnosis|genetic disease status|individual vaccination status)\b",
            re.IGNORECASE,
        ),
    ),
]


# =====================================================================
# UTILITIES
# =====================================================================

def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def new_id(prefix: str, seed: str) -> str:
    h = hashlib.sha256(seed.encode("utf-8")).hexdigest()[:10]
    return f"{prefix}{h}" if prefix else h


def stable_hash(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def sha256_short(text: str) -> str:
    return stable_hash(text)[:16]


def jsonable(obj: Any) -> Any:
    if isinstance(obj, Enum):
        return obj.value
    if is_dataclass(obj) and not isinstance(obj, type):
        return {f.name: jsonable(getattr(obj, f.name)) for f in fields(obj)}
    if isinstance(obj, (list, tuple, set)):
        return [jsonable(x) for x in obj]
    if isinstance(obj, dict):
        return {str(k): jsonable(v) for k, v in obj.items()}
    return obj


def normalize_text(value: str) -> str:
    s = unicodedata.normalize("NFKC", value or "")
    s = s.lower().strip()
    s = re.sub(r"[^\w\s\-'.:/@]", " ", s)
    s = re.sub(r"\s+", " ", s)
    return s


def parse_dt(value: Optional[str]) -> Optional[datetime]:
    if not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except Exception:
        return None


def dt_or_min(value: Optional[str]) -> datetime:
    dt = parse_dt(value)
    return dt if dt else datetime.min.replace(tzinfo=timezone.utc)


def safe_div(n: Optional[float], d: Optional[float]) -> Optional[float]:
    if n is None or d is None or d == 0:
        return None
    return float(n) / float(d)


def pct_change(latest: Optional[float], baseline: Optional[float]) -> Optional[float]:
    if latest is None or baseline is None or baseline == 0:
        return None
    return ((latest - baseline) / baseline) * 100.0


def policy_guard(text: str) -> List[Dict[str, str]]:
    violations: List[Dict[str, str]] = []
    for rule, rx in PROHIBITED_PATTERNS:
        m = rx.search(text or "")
        if m:
            violations.append({"rule": rule, "matched": m.group(0)})
    return violations


# =====================================================================
# DATACLASSES
# =====================================================================

@dataclass
class Source:
    id: str
    title: str
    url: str
    source_type: SourceType
    independence_group: str = "UNKNOWN"
    reliability: float = 0.5
    derived_from: Optional[str] = None
    published_at: Optional[str] = None
    retrieved_at: Optional[str] = None
    notes: str = ""


@dataclass
class Evidence:
    id: str
    source_id: str
    artifact_type: str
    excerpt: str
    observed_at: Optional[str] = None
    content_hash: str = ""
    parsed_fields: Dict[str, Any] = field(default_factory=dict)
    limitations: List[str] = field(default_factory=list)


@dataclass
class Population:
    id: str
    geography: str
    time_period: str
    definition: str
    denominator: Optional[int] = None
    denominator_source: str = ""
    denominator_quality: DenominatorQuality = DenominatorQuality.UNKNOWN
    age_band: Optional[str] = None
    sex_category: Optional[str] = None
    coverage: str = ""
    limitations: List[str] = field(default_factory=list)


@dataclass
class Observation:
    id: str
    source_id: str
    population_id: str
    geography: str
    time_period: str
    metric: MetricType
    case_definition: CaseDefinitionType = CaseDefinitionType.OTHER
    numerator: Optional[float] = None
    denominator: Optional[float] = None
    value: Optional[float] = None
    unit: str = ""
    rate_per_100k: Optional[float] = None
    percentage: Optional[float] = None
    provisional: bool = False
    revised: bool = False
    privacy_classification: PrivacyClassification = PrivacyClassification.PUBLIC
    privacy_sensitive: bool = False
    suppressed: bool = False
    limitations: List[str] = field(default_factory=list)
    evidence_ids: List[str] = field(default_factory=list)


@dataclass
class Finding:
    id: str
    finding_type: FindingType
    subject_id: str
    statement: str
    verification_state: VerificationState = VerificationState.INCONCLUSIVE
    confidence: float = 0.0
    population_id: Optional[str] = None
    geography: Optional[str] = None
    time_period: Optional[str] = None
    metric: Optional[str] = None
    case_definition: Optional[str] = None
    denominator: Optional[float] = None
    source_ids: List[str] = field(default_factory=list)
    evidence_ids: List[str] = field(default_factory=list)
    privacy_classification: PrivacyClassification = PrivacyClassification.PUBLIC
    limitations: List[str] = field(default_factory=list)
    specialist_handoff: Optional[str] = None


@dataclass
class Hypothesis:
    id: str
    statement: str
    kind: str
    supporting_finding_ids: List[str] = field(default_factory=list)
    supporting_evidence_ids: List[str] = field(default_factory=list)
    contradicting_finding_ids: List[str] = field(default_factory=list)
    contradicting_evidence_ids: List[str] = field(default_factory=list)
    assumptions: List[str] = field(default_factory=list)
    predictions: List[str] = field(default_factory=list)
    falsification_conditions: List[str] = field(default_factory=list)
    status: HypothesisStatus = HypothesisStatus.UNRESOLVED
    confidence: float = 0.0
    limitations: List[str] = field(default_factory=list)


@dataclass
class Contradiction:
    id: str
    contradiction_type: str
    description: str
    subject_ids: List[str] = field(default_factory=list)
    finding_ids: List[str] = field(default_factory=list)
    evidence_ids: List[str] = field(default_factory=list)
    source_ids: List[str] = field(default_factory=list)
    severity: str = "MEDIUM"
    status: str = "OPEN"
    recommended_resolution: str = ""


@dataclass
class KnowledgeGap:
    id: str
    gap_type: GapType
    description: str
    about_subject_ids: List[str] = field(default_factory=list)
    about_finding_ids: List[str] = field(default_factory=list)
    importance: str = "MEDIUM"
    recommended_source: str = ""
    specialist: Optional[str] = None
    expected_information_value: float = 0.0


@dataclass
class NextAction:
    id: str
    description: str
    priority: int = 1
    privacy_impact: str = "LOW_IF_AUTHORIZED"
    expected_gain: float = 0.0
    specialist: Optional[str] = None
    requires_human_approval: bool = False


@dataclass
class Recommendation:
    id: str
    category: str
    action: str
    target: str
    rationale: str
    evidence_ids: List[str] = field(default_factory=list)
    finding_ids: List[str] = field(default_factory=list)
    approval: str = "HUMAN_PUBLIC_HEALTH_REVIEW_REQUIRED"
    limitations: List[str] = field(default_factory=list)


@dataclass
class Case:
    case_id: str
    task_id: str
    objective: str
    questions: List[str] = field(default_factory=list)
    scope: List[str] = field(default_factory=lambda: [
        "authorized_population_level_public_health",
        "privacy_first",
        "evidence_first",
        "human_governed",
        "no_individual_diagnosis",
        "no_biosecurity_harm",
    ])
    authorization: str = "demo_authorized_public_health_intelligence"
    region: Optional[str] = None
    population: Optional[str] = None
    condition: Optional[str] = None
    time_range: Optional[str] = None
    as_of: str = DEFAULT_AS_OF
    sample: bool = False
    budget: Optional[str] = None
    deadline: Optional[str] = None


# =====================================================================
# HEALTHINT ENGINE
# =====================================================================

class HealthInt:
    def __init__(self, case: Case) -> None:
        self.case = case
        self.as_of = case.as_of or DEFAULT_AS_OF

        self.sources: Dict[str, Source] = {}
        self.evidence: Dict[str, Evidence] = {}
        self.populations: Dict[str, Population] = {}
        self.observations: Dict[str, Observation] = {}
        self.findings: Dict[str, Finding] = {}
        self.hypotheses: List[Hypothesis] = []
        self.contradictions: List[Contradiction] = []
        self.gaps: List[KnowledgeGap] = []
        self.actions: List[NextAction] = []
        self.recommendations: List[Recommendation] = []
        self.handoffs: List[Dict[str, str]] = []
        self.trends: Dict[str, Dict[str, Any]] = {}
        self.outbreak_state: OutbreakSignalState = OutbreakSignalState.UNKNOWN
        self.data_quality: Dict[str, Any] = {}
        self.validation_errors: List[str] = []

    # -----------------------------------------------------------------
    # Adders
    # -----------------------------------------------------------------

    def add_source(self, source: Source) -> Source:
        self.sources[source.id] = source
        return source

    def add_evidence(self, evidence: Evidence) -> Evidence:
        if not evidence.content_hash:
            evidence.content_hash = stable_hash("|".join([
                evidence.source_id,
                evidence.artifact_type,
                evidence.excerpt,
            ]))
        self.evidence[evidence.id] = evidence
        return evidence

    def add_population(self, population: Population) -> Population:
        self.populations[population.id] = population
        return population

    def add_observation(self, obs: Observation) -> Observation:
        self.observations[obs.id] = obs
        return obs

    def add_finding(self, finding: Finding) -> Finding:
        if finding.id in self.findings:
            return self.findings[finding.id]
        self.findings[finding.id] = finding
        return finding

    def add_contradiction(self, contradiction: Contradiction) -> Contradiction:
        if any(c.description == contradiction.description for c in self.contradictions):
            return self.contradictions[0]
        self.contradictions.append(contradiction)
        return contradiction

    # -----------------------------------------------------------------
    # Source lineage / independence
    # -----------------------------------------------------------------

    def get_source_family(self, source_id: str) -> Optional[str]:
        src = self.sources.get(source_id)
        if not src:
            return None
        seen: Set[str] = set()
        cur = src
        while (
            cur
            and cur.derived_from
            and cur.derived_from in self.sources
            and cur.id not in seen
        ):
            seen.add(cur.id)
            cur = self.sources[cur.derived_from]
        if cur and cur.independence_group and cur.independence_group != "UNKNOWN":
            return cur.independence_group
        return cur.id if cur else source_id

    def source_families(self, source_ids: List[str]) -> Set[str]:
        families: Set[str] = set()
        for sid in source_ids:
            fam = self.get_source_family(sid)
            families.add(fam or sid)
        return families

    def independence_state(self, source_ids: List[str]) -> str:
        if not source_ids:
            return "UNKNOWN"
        families = self.source_families(source_ids)
        if len(source_ids) == 1:
            return "SINGLE_SOURCE"
        if len(families) == 1:
            return "DEPENDENT"
        if len(families) == len(source_ids):
            return "INDEPENDENT"
        return "PARTIALLY_DEPENDENT"

    # -----------------------------------------------------------------
    # Privacy / normalization / analytics
    # -----------------------------------------------------------------

    def privacy_gate(self) -> None:
        for obs in self.observations.values():
            if obs.suppressed:
                continue

            # Suppress small sensitive cells.
            if (
                obs.privacy_sensitive
                and obs.numerator is not None
                and float(obs.numerator) < SMALL_CELL_THRESHOLD
            ):
                obs.suppressed = True
                obs.privacy_classification = PrivacyClassification.SUPPRESSED
                obs.rate_per_100k = None
                obs.percentage = None
                obs.value = None
                obs.limitations.append(
                    "Small-cell suppression applied to reduce reidentification risk."
                )
                self.add_finding(Finding(
                    id=new_id("FIND-SMALLCELL-", obs.id),
                    finding_type=FindingType.SMALL_CELL_SUPPRESSED,
                    subject_id=obs.id,
                    statement=(
                        f"Observation {obs.id} suppressed because numerator is below "
                        f"small-cell threshold {SMALL_CELL_THRESHOLD} for sensitive health signal."
                    ),
                    verification_state=VerificationState.SUPPORTED,
                    population_id=obs.population_id,
                    geography=obs.geography,
                    time_period=obs.time_period,
                    metric=obs.metric.value,
                    case_definition=obs.case_definition.value,
                    source_ids=[obs.source_id],
                    evidence_ids=obs.evidence_ids,
                    privacy_classification=PrivacyClassification.SUPPRESSED,
                    limitations=[
                        "Suppressed data must not be used for individual inference.",
                        "Aggregate reporting only.",
                    ],
                ))
                continue

            # Enforce region-level geography; reject precise private location language in sample metadata.
            if obs.geography and any(token in normalize_text(obs.geography) for token in ["home", "residence", "address", "gps"]):
                obs.suppressed = True
                obs.privacy_classification = PrivacyClassification.SUPPRESSED
                obs.limitations.append("Precise private-location geography blocked; aggregation required.")

    def compute_rates_and_percentages(self) -> None:
        for obs in self.observations.values():
            if obs.suppressed:
                continue

            pop = self.populations.get(obs.population_id)
            denom = obs.denominator
            if denom is None and pop and pop.denominator is not None:
                denom = float(pop.denominator)
                obs.denominator = denom

            if obs.numerator is not None and denom is not None and denom > 0:
                if obs.metric in {
                    MetricType.RESPIRATORY_PRESENTATIONS,
                    MetricType.LAB_CONFIRMED_CASES,
                    MetricType.HOSPITALIZATIONS,
                    MetricType.DEATHS,
                    MetricType.PEDIATRIC_RARE_SYNDROME,
                }:
                    obs.rate_per_100k = round((float(obs.numerator) / float(denom)) * 100000.0, 3)

                if obs.metric in {
                    MetricType.TEST_POSITIVITY,
                    MetricType.HOSPITAL_OCCUPANCY,
                    MetricType.ICU_OCCUPANCY,
                    MetricType.MEDICINE_STOCKOUT_RATE,
                    MetricType.VACCINATION_COVERAGE,
                }:
                    obs.percentage = round((float(obs.numerator) / float(denom)) * 100.0, 3)

            if obs.metric == MetricType.TEST_POSITIVITY and obs.numerator is not None and obs.denominator is not None:
                obs.percentage = round((float(obs.numerator) / float(obs.denominator)) * 100.0, 3)

    def temporal_analysis(self) -> None:
        series: Dict[str, List[Observation]] = defaultdict(list)

        for obs in self.observations.values():
            if obs.suppressed:
                continue
            key = "|".join([
                obs.population_id,
                obs.geography,
                obs.metric.value,
                obs.case_definition.value,
            ])
            series[key].append(obs)

        for key, obs_list in series.items():
            obs_list = sorted(obs_list, key=lambda o: dt_or_min(o.time_period))
            values: List[float] = []
            for o in obs_list:
                v = o.numerator if o.numerator is not None else o.value
                if v is not None:
                    values.append(float(v))

            if not values:
                self.trends[key] = {
                    "state": TrendState.INSUFFICIENT_DATA.value,
                    "latest": None,
                    "baseline": None,
                    "percent_change": None,
                    "series_length": len(obs_list),
                }
                continue

            latest = values[-1]
            baseline_values = values[:-1][-4:] if len(values) > 1 else []
            baseline = sum(baseline_values) / len(baseline_values) if baseline_values else None
            change = pct_change(latest, baseline)

            if change is None:
                state = TrendState.INSUFFICIENT_DATA
            elif abs(change) < 5:
                state = TrendState.STABLE
            elif change > 15:
                state = TrendState.INCREASING
            elif change < -15:
                state = TrendState.DECREASING
            else:
                state = TrendState.VOLATILE

            self.trends[key] = {
                "state": state.value,
                "latest": latest,
                "baseline": round(baseline, 3) if baseline is not None else None,
                "percent_change": round(change, 3) if change is not None else None,
                "series_length": len(values),
                "time_periods": [o.time_period for o in obs_list],
                "raw_values": values,
                "guardrails": [
                    "Trend is population-level and does not identify individuals.",
                    "Trend does not establish cause.",
                    "Provisional data may be revised.",
                ],
            }

    def latest_observation(
        self,
        metric: MetricType,
        case_definition: Optional[CaseDefinitionType] = None,
        population_id: Optional[str] = None,
    ) -> Optional[Observation]:
        candidates = [
            o for o in self.observations.values()
            if o.metric == metric
            and not o.suppressed
            and (case_definition is None or o.case_definition == case_definition)
            and (population_id is None or o.population_id == population_id)
        ]
        if not candidates:
            return None
        return max(candidates, key=lambda o: dt_or_min(o.time_period))

    def trend_for(
        self,
        metric: MetricType,
        case_definition: Optional[CaseDefinitionType] = None,
        population_id: Optional[str] = None,
    ) -> Optional[Dict[str, Any]]:
        for key, val in self.trends.items():
            parts = key.split("|")
            if len(parts) != 4:
                continue
            pop, geo, met, cd = parts
            if met != metric.value:
                continue
            if case_definition is not None and cd != case_definition.value:
                continue
            if population_id is not None and pop != population_id:
                continue
            return val
        return None

    def assess_outbreak_signal(self) -> None:
        syndromic = self.trend_for(
            MetricType.RESPIRATORY_PRESENTATIONS,
            CaseDefinitionType.SYNDROMIC_RESPIRATORY,
        )
        lab_pos = self.trend_for(
            MetricType.TEST_POSITIVITY,
            CaseDefinitionType.LAB_CONFIRMED,
        )
        wastewater = self.trend_for(MetricType.WASTEWATER_SIGNAL)
        hosp_occ = self.latest_observation(MetricType.HOSPITAL_OCCUPANCY)

        syndromic_increase = bool(
            syndromic
            and syndromic.get("state") == TrendState.INCREASING.value
            and (syndromic.get("percent_change") or 0) >= 20
        )
        lab_increase = bool(
            lab_pos
            and lab_pos.get("state") in {TrendState.INCREASING.value, TrendState.VOLATILE.value}
            and (lab_pos.get("percent_change") or 0) >= 5
        )
        ww_increase = bool(wastewater and wastewater.get("state") == TrendState.INCREASING.value)
        capacity_stress = bool(hosp_occ and hosp_occ.percentage is not None and hosp_occ.percentage >= 85)

        independent_support = sum([syndromic_increase, lab_increase, ww_increase, capacity_stress])

        if independent_support >= 3:
            self.outbreak_state = OutbreakSignalState.OUTBREAK_CANDIDATE
        elif independent_support == 2:
            self.outbreak_state = OutbreakSignalState.ELEVATED_SIGNAL
        elif independent_support == 1:
            self.outbreak_state = OutbreakSignalState.WEAK_SIGNAL
        else:
            self.outbreak_state = OutbreakSignalState.NO_SIGNAL

    def build_core_findings(self) -> None:
        pop = self.populations.get("POP-NB-ALL")
        geo = pop.geography if pop else "UNKNOWN"
        latest_syndromic = self.latest_observation(
            MetricType.RESPIRATORY_PRESENTATIONS,
            CaseDefinitionType.SYNDROMIC_RESPIRATORY,
        )
        latest_lab = self.latest_observation(MetricType.TEST_POSITIVITY, CaseDefinitionType.LAB_CONFIRMED)
        latest_ww = self.latest_observation(MetricType.WASTEWATER_SIGNAL)
        latest_hosp = self.latest_observation(MetricType.HOSPITAL_OCCUPANCY)
        latest_icu = self.latest_observation(MetricType.ICU_OCCUPANCY)
        latest_vax = self.latest_observation(MetricType.VACCINATION_COVERAGE)
        latest_stock = self.latest_observation(MetricType.MEDICINE_STOCKOUT_RATE)
        latest_air = self.latest_observation(MetricType.AIR_PM25)
        latest_heat = self.latest_observation(MetricType.HEAT_INDEX)
        latest_misinfo = self.latest_observation(MetricType.MISINFORMATION_REACH)

        if latest_syndromic:
            self.add_finding(Finding(
                id="FIND-POP-SIGNAL",
                finding_type=FindingType.POPULATION_LEVEL_SIGNAL_OBSERVED,
                subject_id=latest_syndromic.id,
                statement=(
                    f"Population-level syndromic respiratory presentations are observed in {geo}; "
                    f"this is not an individual diagnosis."
                ),
                verification_state=VerificationState.SUPPORTED,
                population_id=latest_syndromic.population_id,
                geography=geo,
                time_period=latest_syndromic.time_period,
                metric=latest_syndromic.metric.value,
                case_definition=latest_syndromic.case_definition.value,
                denominator=latest_syndromic.denominator,
                source_ids=[latest_syndromic.source_id],
                evidence_ids=latest_syndromic.evidence_ids,
                limitations=[
                    "Syndromic case definition is not disease-specific.",
                    "Population-level only.",
                ],
            ))

        syndromic_trend = self.trend_for(MetricType.RESPIRATORY_PRESENTATIONS, CaseDefinitionType.SYNDROMIC_RESPIRATORY)
        if syndromic_trend and syndromic_trend.get("state") == TrendState.INCREASING.value:
            self.add_finding(Finding(
                id="FIND-ELEVATED-RESP",
                finding_type=FindingType.ELEVATED_RESPIRATORY_ACTIVITY,
                subject_id="REGION-NORTHBRIDGE-RESP",
                statement=(
                    f"Respiratory presentations increased {syndromic_trend.get('percent_change')}% "
                    f"relative to recent baseline in {geo}."
                ),
                verification_state=VerificationState.SUPPORTED,
                population_id="POP-NB-ALL",
                geography=geo,
                time_period=self.as_of,
                metric=MetricType.RESPIRATORY_PRESENTATIONS.value,
                case_definition=CaseDefinitionType.SYNDROMIC_RESPIRATORY.value,
                denominator=float(pop.denominator) if pop and pop.denominator else None,
                source_ids=["SRC-MOH"],
                evidence_ids=["EV-MOH-WEEKLY"],
                limitations=[
                    "Increase may reflect transmission, care-seeking, reporting, seasonality, or definition change.",
                    "Does not diagnose individuals.",
                ],
            ))

        lab_trend = self.trend_for(MetricType.TEST_POSITIVITY, CaseDefinitionType.LAB_CONFIRMED)
        if latest_lab and lab_trend:
            self.add_finding(Finding(
                id="FIND-LAB-POS",
                finding_type=FindingType.LAB_POSITIVITY_INCREASE,
                subject_id=latest_lab.id,
                statement=(
                    f"Laboratory positivity changed {lab_trend.get('percent_change')}% relative to baseline; "
                    f"latest percentage {latest_lab.percentage}%."
                ),
                verification_state=VerificationState.PARTIALLY_SUPPORTED,
                population_id=latest_lab.population_id,
                geography=geo,
                time_period=latest_lab.time_period,
                metric=latest_lab.metric.value,
                case_definition=latest_lab.case_definition.value,
                denominator=latest_lab.denominator,
                source_ids=[latest_lab.source_id],
                evidence_ids=latest_lab.evidence_ids,
                limitations=[
                    "Test positivity depends on testing criteria, volume, and population selection.",
                    "Positive test is not severity or individual prognosis.",
                ],
            ))

        ww_trend = self.trend_for(MetricType.WASTEWATER_SIGNAL)
        if latest_ww and ww_trend:
            self.add_finding(Finding(
                id="FIND-WW",
                finding_type=FindingType.WASTEWATER_UPWARD_SIGNAL,
                subject_id=latest_ww.id,
                statement=(
                    f"Wastewater signal trend is {ww_trend.get('state')} with latest normalized value "
                    f"{latest_ww.value} {latest_ww.unit}."
                ),
                verification_state=VerificationState.SUPPORTED,
                population_id=latest_ww.population_id,
                geography=geo,
                time_period=latest_ww.time_period,
                metric=latest_ww.metric.value,
                case_definition=latest_ww.case_definition.value,
                source_ids=[latest_ww.source_id],
                evidence_ids=latest_ww.evidence_ids,
                limitations=[
                    "Wastewater signal is population-level and not an exact case count.",
                    "Catchment, dilution, rainfall, and normalization affect interpretation.",
                ],
            ))

        if latest_hosp and latest_hosp.percentage is not None and latest_hosp.percentage >= 85:
            self.add_finding(Finding(
                id="FIND-HOSP-STRESS",
                finding_type=FindingType.HOSPITAL_CAPACITY_STRESS_CANDIDATE,
                subject_id=latest_hosp.id,
                statement=(
                    f"Hospital occupancy {latest_hosp.percentage}% indicates potential capacity stress candidate in {geo}."
                ),
                verification_state=VerificationState.CANDIDATE,
                population_id=latest_hosp.population_id,
                geography=geo,
                time_period=latest_hosp.time_period,
                metric=latest_hosp.metric.value,
                case_definition=latest_hosp.case_definition.value,
                source_ids=[latest_hosp.source_id],
                evidence_ids=latest_hosp.evidence_ids,
                limitations=[
                    "Occupancy is not automatically outbreak.",
                    "Licensed beds, staffed beds, operational beds, and available beds are distinct.",
                    "Staffing and regional referral patterns matter.",
                ],
                specialist_handoff="ORGINT / SUPPLYCHAININT / HUMAN_PUBLIC_HEALTH",
            ))

        if latest_icu and latest_icu.percentage is not None and latest_icu.percentage >= 75:
            self.add_finding(Finding(
                id="FIND-ICU",
                finding_type=FindingType.HOSPITAL_CAPACITY_STRESS_CANDIDATE,
                subject_id=latest_icu.id,
                statement=f"ICU occupancy {latest_icu.percentage}% observed as aggregate capacity context.",
                verification_state=VerificationState.OBSERVED,
                population_id=latest_icu.population_id,
                geography=geo,
                time_period=latest_icu.time_period,
                metric=latest_icu.metric.value,
                source_ids=[latest_icu.source_id],
                evidence_ids=latest_icu.evidence_ids,
                limitations=["ICU occupancy requires staffing and baseline context."],
            ))

        if latest_vax and latest_vax.percentage is not None:
            self.add_finding(Finding(
                id="FIND-VAX",
                finding_type=FindingType.VACCINATION_COVERAGE_OBSERVED,
                subject_id=latest_vax.id,
                statement=f"Aggregate vaccination coverage {latest_vax.percentage}% observed for eligible population.",
                verification_state=VerificationState.SUPPORTED,
                population_id=latest_vax.population_id,
                geography=geo,
                time_period=latest_vax.time_period,
                metric=latest_vax.metric.value,
                denominator=latest_vax.denominator,
                source_ids=[latest_vax.source_id],
                evidence_ids=latest_vax.evidence_ids,
                limitations=[
                    "Doses allocated, delivered, and administered are distinct.",
                    "Coverage does not equal individual immunity or effectiveness without studies.",
                ],
            ))

        if latest_stock and latest_stock.percentage is not None and latest_stock.percentage >= 10:
            self.add_finding(Finding(
                id="FIND-SUPPLY",
                finding_type=FindingType.MEDICINE_SUPPLY_CONSTRAINT_OBSERVED,
                subject_id=latest_stock.id,
                statement=f"Aggregate medicine stockout rate {latest_stock.percentage}% observed.",
                verification_state=VerificationState.OBSERVED,
                population_id=latest_stock.population_id,
                geography=geo,
                time_period=latest_stock.time_period,
                metric=latest_stock.metric.value,
                source_ids=[latest_stock.source_id],
                evidence_ids=latest_stock.evidence_ids,
                limitations=[
                    "Shortage is not zero availability everywhere.",
                    "Supply chain root cause requires SUPPLYCHAININT.",
                    "No individual medication recommendation is made.",
                ],
                specialist_handoff="SUPPLYCHAININT / PROCUREMENTINT",
            ))

        if latest_air or latest_heat:
            self.add_finding(Finding(
                id="FIND-ENV",
                finding_type=FindingType.ENVIRONMENTAL_CORRELATION_CANDIDATE,
                subject_id="ENV-CONTEXT",
                statement=(
                    f"Environmental health context observed: PM2.5={latest_air.value if latest_air else 'UNKNOWN'} "
                    f"{latest_air.unit if latest_air else ''}, heat index={latest_heat.value if latest_heat else 'UNKNOWN'} "
                    f"{latest_heat.unit if latest_heat else ''}."
                ),
                verification_state=VerificationState.CANDIDATE,
                population_id="POP-NB-ALL",
                geography=geo,
                time_period=self.as_of,
                source_ids=sorted({x.source_id for x in [latest_air, latest_heat] if x}),
                evidence_ids=sorted({eid for x in [latest_air, latest_heat] if x for eid in x.evidence_ids}),
                limitations=[
                    "Environmental exposure correlation is not individual causation.",
                    "Ecological fallacy avoided.",
                    "No harmful contamination methods are provided.",
                ],
            ))

        if latest_misinfo:
            self.add_finding(Finding(
                id="FIND-MISINFO",
                finding_type=FindingType.MISINFORMATION_REACH_OBSERVED,
                subject_id=latest_misinfo.id,
                statement=(
                    f"Public misinformation/concern signal reach {latest_misinfo.value} {latest_misinfo.unit} observed; "
                    "this is not disease prevalence."
                ),
                verification_state=VerificationState.OBSERVED,
                population_id=latest_misinfo.population_id,
                geography=geo,
                time_period=latest_misinfo.time_period,
                metric=latest_misinfo.metric.value,
                source_ids=[latest_misinfo.source_id],
                evidence_ids=latest_misinfo.evidence_ids,
                limitations=[
                    "Search/social activity may reflect concern, media coverage, or information seeking.",
                    "No named-user health inference.",
                    "Intent is not inferred as disinformation without evidence.",
                ],
                specialist_handoff="DISINFOINT / SOCMINT",
            ))

        if self.outbreak_state in {
            OutbreakSignalState.ELEVATED_SIGNAL,
            OutbreakSignalState.OUTBREAK_CANDIDATE,
            OutbreakSignalState.OUTBREAK_SUPPORTED,
        }:
            self.add_finding(Finding(
                id="FIND-OUTBREAK-SIGNAL",
                finding_type=FindingType.OUTBREAK_CANDIDATE,
                subject_id="OUTBREAK-SIGNAL-NORTHBRIDGE",
                statement=(
                    f"Population-level outbreak signal state is {self.outbreak_state.value} based on syndromic, "
                    "laboratory, wastewater, and hospital capacity context."
                ),
                verification_state=VerificationState.CANDIDATE,
                population_id="POP-NB-ALL",
                geography=geo,
                time_period=self.as_of,
                source_ids=["SRC-MOH", "SRC-LAB", "SRC-WW", "SRC-HOSP"],
                evidence_ids=["EV-MOH-WEEKLY", "EV-LAB-WEEKLY", "EV-WW-WEEKLY", "EV-HOSP-WEEKLY"],
                limitations=[
                    "HEALTHINT does not officially declare outbreaks.",
                    "Alternative explanations remain: testing change, reporting artifact, seasonality, case-definition change, healthcare-seeking behavior.",
                    "Human public-health authority required for consequential action.",
                ],
                specialist_handoff="HUMAN_PUBLIC_HEALTH_AUTHORITY",
            ))

        self.add_finding(Finding(
            id="FIND-NO-OFFICIAL-DECLARATION",
            finding_type=FindingType.OFFICIAL_OUTBREAK_NOT_DECLARED,
            subject_id="GOVERNANCE",
            statement="No autonomous official outbreak declaration is made by HEALTHINT.",
            verification_state=VerificationState.SUPPORTED,
            source_ids=[],
            evidence_ids=[],
            limitations=["Only competent public-health authorities may declare official emergencies/outbreaks where relevant."],
        ))

        self.add_finding(Finding(
            id="FIND-NO-DIAGNOSIS",
            finding_type=FindingType.NO_INDIVIDUAL_DIAGNOSIS,
            subject_id="GOVERNANCE",
            statement="No individual diagnosis, prescription, treatment change, or personal medical profiling is performed.",
            verification_state=VerificationState.SUPPORTED,
            source_ids=[],
            evidence_ids=[],
            limitations=["Clinical care belongs to qualified healthcare professionals and appropriate clinical systems."],
        ))

        self.add_finding(Finding(
            id="FIND-BIOSECURITY",
            finding_type=FindingType.BIOSECURITY_BOUNDARY_ENFORCED,
            subject_id="GOVERNANCE",
            statement="No pathogen engineering, virulence/transmissibility optimization, immune-evasion engineering, biological attack planning, or contamination methods are provided.",
            verification_state=VerificationState.SUPPORTED,
            source_ids=[],
            evidence_ids=[],
            limitations=["Analysis remains public-health, biosafety, preparedness, surveillance, and response oriented."],
        ))

        self.add_finding(Finding(
            id="FIND-STIGMA",
            finding_type=FindingType.STIGMATIZATION_CONTROL,
            subject_id="GOVERNANCE",
            statement="No ethnic, religious, national, occupational, or neighborhood group is labeled as disease carrier.",
            verification_state=VerificationState.SUPPORTED,
            source_ids=[],
            evidence_ids=[],
            limitations=["Neutral epidemiological language required."],
        ))

    def detect_source_dependencies_and_contradictions(self) -> None:
        # News derived from ministry bulletin.
        news = self.sources.get("SRC-NEWS")
        moh = self.sources.get("SRC-MOH")
        if news and moh and news.derived_from == moh.id:
            self.add_finding(Finding(
                id="FIND-NEWS-DEP",
                finding_type=FindingType.SOURCE_DEPENDENCY_OBSERVED,
                subject_id="SRC-NEWS",
                statement="News report derives from the same ministry bulletin and is not independent corroboration.",
                verification_state=VerificationState.SUPPORTED,
                source_ids=["SRC-NEWS", "SRC-MOH"],
                evidence_ids=["EV-NEWS", "EV-MOH-WEEKLY"],
                limitations=["Multiple dashboards/articles using same upstream data count as one evidence family."],
            ))

        # Contradiction: news count vs ministry count due case definition / dependency.
        latest_moh = self.latest_observation(MetricType.RESPIRATORY_PRESENTATIONS, CaseDefinitionType.SYNDROMIC_RESPIRATORY)
        latest_news = self.latest_observation(MetricType.RESPIRATORY_PRESENTATIONS, CaseDefinitionType.SELF_REPORTED)
        if latest_moh and latest_news and latest_moh.numerator is not None and latest_news.numerator is not None:
            if abs(float(latest_moh.numerator) - float(latest_news.numerator)) > 20:
                desc = (
                    f"News-reported respiratory presentations ({latest_news.numerator}) differ from ministry syndromic count "
                    f"({latest_moh.numerator}); case definition and source dependency may explain difference."
                )
                fid = new_id("FIND-CONTRA-NEWS-", desc)
                self.add_finding(Finding(
                    id=fid,
                    finding_type=FindingType.CONTRADICTION_OBSERVED,
                    subject_id="NEWS-VS-MOH",
                    statement=desc,
                    verification_state=VerificationState.DISPUTED,
                    population_id="POP-NB-ALL",
                    geography="Northbridge",
                    time_period=self.as_of,
                    source_ids=["SRC-MOH", "SRC-NEWS"],
                    evidence_ids=["EV-MOH-WEEKLY", "EV-NEWS"],
                    limitations=[
                        "Do not average incompatible metrics.",
                        "Preserve case-definition differences.",
                    ],
                ))
                self.add_contradiction(Contradiction(
                    id=new_id("CON-", desc),
                    contradiction_type="COUNT_CASE_DEFINITION_SOURCE_DEPENDENCY",
                    description=desc,
                    subject_ids=[latest_moh.id, latest_news.id],
                    finding_ids=[fid],
                    evidence_ids=["EV-MOH-WEEKLY", "EV-NEWS"],
                    source_ids=["SRC-MOH", "SRC-NEWS"],
                    severity="MEDIUM",
                    status="OPEN",
                    recommended_resolution="Use official syndromic definition for trend; treat news as dependent/public-concern context.",
                ))

        # Provisional data limitation.
        provisional = [o for o in self.observations.values() if o.provisional and not o.suppressed]
        if provisional:
            self.add_finding(Finding(
                id="FIND-PROVISIONAL",
                finding_type=FindingType.PROVISIONAL_DATA_OBSERVED,
                subject_id="DATA_QUALITY",
                statement=f"{len(provisional)} observations are provisional and may be revised by backfill.",
                verification_state=VerificationState.SUPPORTED,
                source_ids=sorted({o.source_id for o in provisional}),
                evidence_ids=sorted({eid for o in provisional for eid in o.evidence_ids}),
                limitations=["Provisional surveillance must not be treated as final."],
            ))

    def build_hypotheses(self) -> None:
        self.hypotheses = [
            Hypothesis(
                id="H-TRUE-TRANSMISSION",
                statement="Observed increase represents true population-level disease transmission increase.",
                kind="OUTBREAK_CAUSE",
                supporting_finding_ids=["FIND-ELEVATED-RESP", "FIND-LAB-POS", "FIND-WW"],
                assumptions=["Signals are independent and case definitions stable."],
                predictions=["Hospitalizations and lab pathogen-specific confirmations would rise with matched timing."],
                falsification_conditions=[
                    "Testing volume alone explains case increase.",
                    "Reporting backlog released.",
                    "Case definition changed.",
                    "Seasonal baseline explains pattern.",
                ],
                status=HypothesisStatus.POSSIBLE,
                confidence=0.58,
                limitations=["Correlation is not causation.", "Human epidemiological investigation required."],
            ),
            Hypothesis(
                id="H-TESTING-ARTIFACT",
                statement="Increase is mainly due to expanded testing or changed testing criteria.",
                kind="REPORTING_ARTIFACT",
                contradicting_finding_ids=["FIND-LAB-POS"],
                assumptions=["Test volume increased substantially."],
                predictions=["Positivity would remain flat or decline if purely testing artifact."],
                falsification_conditions=["Positivity rises alongside volume and wastewater/hospital signals move."],
                status=HypothesisStatus.UNRESOLVED,
                confidence=0.35,
