                statement="Increase reflects reporting backlog rather than new events.",
                kind="DATA_QUALITY",
                assumptions=["Specimen/event dates differ from report dates."],
                predictions=["Backfilled historical periods would show delayed spike."],
                falsification_conditions=["Event-date series shows same recent increase."],
                status=HypothesisStatus.UNRESOLVED,
                confidence=0.30,
                limitations=["Reporting delay metadata unavailable in sample."],
            ),
            Hypothesis(
                id="H-SEASONALITY",
