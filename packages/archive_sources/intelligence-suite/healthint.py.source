    SourceType.MINISTRY_HEALTH: 0.92,
    SourceType.INTERNATIONAL_HEALTH: 0.88,
    SourceType.LABORATORY_NETWORK: 0.90,
    SourceType.HOSPITAL_DASHBOARD: 0.88,
