                kind="SEASONALITY",
                supporting_finding_ids=["FIND-ELEVATED-RESP"],
                assumptions=["Historical seasonal baseline is appropriate."],
                predictions=["Similar pattern would appear in prior years."],
                falsification_conditions=["Current level exceeds historical seasonal envelope."],
                status=HypothesisStatus.POSSIBLE,
                confidence=0.45,
                limitations=["Seasonality does not exclude outbreak signal."],
            ),
            Hypothesis(
                id="H-CASE-DEFINITION-CHANGE",
                finding_ids_placeholder := None,  # intentionally removed below
            ),
        ]
        # Replace malformed last hypothesis cleanly.
        self.hypotheses[-1] = Hypothesis(
            id="H-CASE-DEFINITION-CHANGE",
            statement="Increase is partly due to case-definition or coding change.",
            kind="SURVEILLANCE_CHANGE",
            assumptions=["Definition version history is available."],
            predictions=["Stratified series by old/new definition would show discontinuity."],
            falsification_conditions=["Definition unchanged and lab/wastewater move independently."],
            status=HypothesisStatus.UNRESOLVED,
            confidence=0.25,
            limitations=["Case-definition versioning is required for trend interpretation."],
        )

