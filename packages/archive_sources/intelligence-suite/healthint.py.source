def sample_case() -> Case:
    return Case(
        case_id="SAMPLE-HEALTHINT-001",
        task_id="TASK-HEALTHINT-001",
        objective=(
            "Authorized population-level public-health intelligence review for respiratory illness signals in "
            "Northbridge region using synthetic aggregated public/authorized-style surveillance, laboratory, "
            "wastewater, hospital capacity, vaccination, supply, environmental, and public-communication context."
        ),
        questions=[
            "Is elevated respiratory activity supported at population level?",
            "Which signals are independent versus dependent?",
            "What alternative explanations remain?",
            "Is healthcare capacity stressed?",
            "What privacy and biosecurity boundaries apply?",
            "What human public-health actions should be considered?",
        ],
        scope=[
            "authorized_population_level_public_health",
            "privacy_first",
            "evidence_first",
            "human_governed",
            "no_individual_diagnosis",
            "no_biosecurity_harm",
        ],
        authorization="demo_authorized_public_health_intelligence",
        region="Northbridge",
        population="POP-NB-ALL",
        condition="respiratory illness",
        time_range="2026-09-07/2026-10-05",
        as_of=DEFAULT_AS_OF,
        sample=True,
    )


