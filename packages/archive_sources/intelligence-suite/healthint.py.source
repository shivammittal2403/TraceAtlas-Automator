# =====================================================================
# RESULT BUILDER
# =====================================================================

def graph_version_hash(h: HealthInt) -> str:
    seed_obj = {
        "populations": sorted((pid, p.geography, p.time_period, p.denominator or 0) for pid, p in h.populations.items()),
        "observations": sorted(
            (oid, o.population_id, o.geography, o.time_period, o.metric.value, o.case_definition.value,
             o.numerator if not o.suppressed else None, o.suppressed)
            for oid, o in h.observations.items()
        ),
        "trends": sorted((k, v.get("state"), v.get("latest"), v.get("percent_change")) for k, v in h.trends.items()),
        "findings": sorted((fid, f.finding_type.value, f.subject_id, f.verification_state.value, round(float(f.confidence), 3)) for fid, f in h.findings.items()),
        "outbreak": h.outbreak_state.value,
    }
    return sha256_short(json.dumps(jsonable(seed_obj), sort_keys=True))


def build_source_graph(h: HealthInt) -> Dict[str, Any]:
    edges = []
    for src in h.sources.values():
        if src.derived_from:
            edges.append({"source": src.derived_from, "target": src.id, "relationship_type": "DERIVED_FROM"})
    return {"nodes": [s.id for s in h.sources.values()], "edges": edges}


def build_source_dependency_graph(h: HealthInt) -> Dict[str, List[str]]:
    families: Dict[str, List[str]] = defaultdict(list)
    for sid in h.sources:
        fam = h.get_source_family(sid) or "UNKNOWN"
        families[fam].append(sid)
    return {k: sorted(v) for k, v in families.items()}


def build_health_graph(h: HealthInt) -> Dict[str, Any]:
    nodes: List[Dict[str, Any]] = []
    edges: List[Dict[str, Any]] = []

    for pop in h.populations.values():
        nodes.append({
            "id": pop.id,
            "type": "Population",
            "geography": pop.geography,
            "time_period": pop.time_period,
            "denominator": pop.denominator,
            "denominator_quality": pop.denominator_quality.value,
        })
        nodes.append({"id": f"GEO-{pop.geography}", "type": "Region", "name": pop.geography})
        edges.append({"source": pop.id, "target": f"GEO-{pop.geography}", "relationship_type": "LOCATED_IN"})

    nodes.append({"id": "COND-RESPIRATORY", "type": "Syndrome", "name": "Respiratory illness"})
    nodes.append({"id": "SIGNAL-NB-RESP", "type": "HealthSignal", "state": h.outbreak_state.value})
    edges.append({"source": "SIGNAL-NB-RESP", "target": "COND-RESPIRATORY", "relationship_type": "OBSERVED_IN"})
    edges.append({"source": "SIGNAL-NB-RESP", "target": "POP-NB-ALL", "relationship_type": "AFFECTS_POPULATION"})

    for obs in h.observations.values():
        if obs.suppressed:
            continue
        nodes.append({
            "id": obs.id,
            "type": "Observation",
            "metric": obs.metric.value,
            "case_definition": obs.case_definition.value,
            "time_period": obs.time_period,
            "geography": obs.geography,
            "privacy_classification": obs.privacy_classification.value,
        })
        edges.append({
            "source": obs.id,
            "target": obs.population_id,
            "relationship_type": "MEASURED_IN_POPULATION",
        })
        edges.append({
            "source": obs.id,
            "target": obs.source_id,
            "relationship_type": "REPORTED_BY",
        })

    return {
        "nodes": nodes,
        "edges": edges,
        "guardrails": [
            "No named patient diagnosis nodes.",
            "No private medical history.",
            "Population-level graph only.",
            "Privacy classification preserved on edges/nodes where applicable.",
        ],
    }


def build_timeline(h: HealthInt) -> List[Dict[str, Any]]:
    events: List[Dict[str, Any]] = []
    for obs in h.observations.values():
        if obs.suppressed:
            continue
        events.append({
            "time": obs.time_period,
            "type": "HEALTH_OBSERVATION",
            "subject_id": obs.id,
            "description": (
                f"{obs.metric.value} ({obs.case_definition.value}) in {obs.geography}: "
                f"numerator={obs.numerator}, denominator={obs.denominator}, "
                f"rate_per_100k={obs.rate_per_100k}, percentage={obs.percentage}, value={obs.value}."
            ),
            "source_ids": [obs.source_id],
            "evidence_ids": obs.evidence_ids,
            "privacy_classification": obs.privacy_classification.value,
        })
    return sorted(events, key=lambda e: dt_or_min(e.get("time")))


def build_facts_by_state(h: HealthInt) -> Dict[str, List[Finding]]:
    out: Dict[str, List[Finding]] = defaultdict(list)
    for f in h.findings.values():
        out[f.verification_state.value].append(f)
    return {k: v for k, v in out.items()}


def latest_metric_summary(h: HealthInt, metric: MetricType, case_definition: Optional[CaseDefinitionType] = None) -> Dict[str, Any]:
    obs = h.latest_observation(metric, case_definition)
    trend = h.trend_for(metric, case_definition)
    if not obs:
        return {"state": "MISSING"}
    return {
        "observation_id": obs.id,
        "time_period": obs.time_period,
        "geography": obs.geography,
        "population_id": obs.population_id,
        "numerator": obs.numerator,
        "denominator": obs.denominator,
        "rate_per_100k": obs.rate_per_100k,
        "percentage": obs.percentage,
        "value": obs.value,
        "unit": obs.unit,
        "case_definition": obs.case_definition.value,
        "provisional": obs.provisional,
        "privacy_classification": obs.privacy_classification.value,
        "trend": trend,
        "limitations": obs.limitations,
    }


def build_result(h: HealthInt, status: Status) -> Dict[str, Any]:
    dual = h.dual_ai_review()
    summary = h.analyst_summary(dual)
    source_families = build_source_dependency_graph(h)
    facts_by_state = build_facts_by_state(h)

    finding_independence = {
        fid: h.independence_state(f.source_ids)
        for fid, f in h.findings.items()
    }

    supported_facts = facts_by_state.get(VerificationState.SUPPORTED.value, [])
    partial_facts = facts_by_state.get(VerificationState.PARTIALLY_SUPPORTED.value, [])
    candidate_facts = facts_by_state.get(VerificationState.CANDIDATE.value, [])
    disputed_facts = facts_by_state.get(VerificationState.DISPUTED.value, [])
    observed_facts = facts_by_state.get(VerificationState.OBSERVED.value, [])

    counts = {
        "respiratory_presentations_latest": h.latest_observation(MetricType.RESPIRATORY_PRESENTATIONS, CaseDefinitionType.SYNDROMIC_RESPIRATORY).numerator if h.latest_observation(MetricType.RESPIRATORY_PRESENTATIONS, CaseDefinitionType.SYNDROMIC_RESPIRATORY) else None,
        "lab_confirmed_cases_latest": h.latest_observation(MetricType.LAB_CONFIRMED_CASES, CaseDefinitionType.LAB_CONFIRMED).numerator if h.latest_observation(MetricType.LAB_CONFIRMED_CASES, CaseDefinitionType.LAB_CONFIRMED) else None,
        "hospitalizations_latest": h.latest_observation(MetricType.HOSPITALIZATIONS).numerator if h.latest_observation(MetricType.HOSPITALIZATIONS) else None,
        "deaths_latest": None,
        "tests_performed_latest": h.latest_observation(MetricType.TESTS_PERFORMED).numerator if h.latest_observation(MetricType.TESTS_PERFORMED) else None,
        "vaccine_doses_administered_latest": h.latest_observation(MetricType.VACCINE_DOSES_ADMINISTERED).numerator if h.latest_observation(MetricType.VACCINE_DOSES_ADMINISTERED) else None,
    }

    rates = {
        "respiratory_presentations_rate_per_100k": latest_metric_summary(h, MetricType.RESPIRATORY_PRESENTATIONS, CaseDefinitionType.SYNDROMIC_RESPIRATORY).get("rate_per_100k"),
        "lab_confirmed_cases_rate_per_100k": latest_metric_summary(h, MetricType.LAB_CONFIRMED_CASES, CaseDefinitionType.LAB_CONFIRMED).get("rate_per_100k"),
        "hospitalizations_rate_per_100k": latest_metric_summary(h, MetricType.HOSPITALIZATIONS).get("rate_per_100k"),
        "test_positivity_percent": latest_metric_summary(h, MetricType.TEST_POSITIVITY, CaseDefinitionType.LAB_CONFIRMED).get("percentage"),
        "hospital_occupancy_percent": latest_metric_summary(h, MetricType.HOSPITAL_OCCUPANCY).get("percentage"),
        "icu_occupancy_percent": latest_metric_summary(h, MetricType.ICU_OCCUPANCY).get("percentage"),
        "vaccination_coverage_percent": latest_metric_summary(h, MetricType.VACCINATION_COVERAGE).get("percentage"),
        "medicine_stockout_percent": latest_metric_summary(h, MetricType.MEDICINE_STOCKOUT_RATE).get("percentage"),
    }

    replay_manifest = {
        "generated_at": now_iso(),
        "pipeline_version": PIPELINE_VERSION,
        "graph_version": graph_version_hash(h),
        "core_principle": (
            "RAW HEALTH SIGNAL -> PRIVACY GATE -> SOURCE PRESERVATION -> POPULATION DEFINITION -> "
            "CASE / METRIC DEFINITION -> DENOMINATOR VALIDATION -> TEMPORAL NORMALIZATION -> "
            "GEOGRAPHIC NORMALIZATION -> DATA-QUALITY REVIEW -> SOURCE RELIABILITY -> SOURCE INDEPENDENCE -> "
            "BIAS ANALYSIS -> ALTERNATIVE EXPLANATIONS -> FACT GATE -> PUBLIC-HEALTH ASSESSMENT -> HUMAN REVIEW"
        ),
        "as_of": h.as_of,
        "population_rule": "Default unit of analysis is population/cohort/region/facility aggregate, not named individual.",
        "case_definition_rule": "Syndromic, probable, confirmed, lab-confirmed, clinical, administrative, and self-reported definitions preserved separately.",
        "denominator_rule": "Counts are converted to rates only with validated denominators; denominator quality stored.",
        "temporal_rule": "Event/specimen/report/publication dates should be preserved separately; provisional data labeled.",
        "privacy_rule": "Small-cell suppression, aggregation, location generalization, purpose limitation, and no reidentification enforced.",
        "biosecurity_rule": "No pathogen engineering, virulence/transmissibility optimization, immune-evasion engineering, biological attack planning, or contamination methods.",
        "governance_rule": "Outbreak/emergency declaration and consequential health actions require human public-health authority.",
        "policy_exclusions": [
            "No individual diagnosis.",
            "No prescription or treatment change.",
            "No private medical record access.",
            "No reidentification.",
            "No covert health surveillance.",
            "No health discrimination for employment/insurance/immigration/law enforcement/marketing.",
            "No pathogen enhancement or biological harm enablement.",
        ],
        "source_lineage": source_families,
        "finding_independence": finding_independence,
        "formulas": {
            "rate_per_100k": "numerator / denominator * 100000",
            "percentage": "numerator / denominator * 100",
            "test_positivity": "positive_tests / tests_performed * 100",
            "baseline": "mean of up to previous four non-supervised observations",
            "percent_change": "(latest - baseline) / baseline * 100",
        },
    }

    return {
        "case_id": h.case.case_id,
        "task_id": h.case.task_id,
        "objective": h.case.objective,
        "questions": h.case.questions,
        "scope": h.case.scope,
        "authorization": h.case.authorization,
        "status": status.value,
        "as_of": h.as_of,

        "source_ids": sorted(h.sources.keys()),
        "evidence_ids": sorted(h.evidence.keys()),

        "populations": list(h.populations.values()),
        "cohorts": [p for p in h.populations.values() if p.age_band or p.sex_category],
        "geographies": sorted({p.geography for p in h.populations.values()}),

        "conditions": ["respiratory illness"],
        "diseases": [],
        "disease_note": "Pathogen-specific disease attribution not established without laboratory/epidemiological confirmation.",
        "syndromes": ["respiratory syndrome"],
        "case_definitions": sorted({o.case_definition.value for o in h.observations.values()}),
        "case_definition_versions": {
            "SYNDROMIC_RESPIRATORY": {
                "definition": "Aggregate respiratory presentations under syndromic surveillance",
                "version": "synthetic-v1",
                "limitation": "Not pathogen-specific; not individual diagnosis.",
            },
            "LAB_CONFIRMED": {
                "definition": "Aggregate laboratory-confirmed detections",
                "version": "synthetic-v1",
                "limitation": "Positive test is not severity or prognosis.",
            },
        },

        "counts": counts,
        "rates": rates,
        "incidence": {
            "respiratory_presentations_incidence_rate_per_100k_weekly": rates["respiratory_presentations_rate_per_100k"],
            "lab_confirmed_incidence_rate_per_100k_weekly": rates["lab_confirmed_cases_rate_per_100k"],
            "note": "Incidence proxies based on surveillance definitions; not clinical incidence for individuals.",
        },
        "prevalence": {
            "state": "NOT_CALCULATED",
            "reason": "Point prevalence requires existing-case definition and population snapshot not available in sample.",
        },
        "mortality": {
            "state": "NO_MORTALITY_SIGNAL_IN_SAMPLE",
            "note": "All-cause/cause-specific/excess mortality not calculated without mortality registry baseline.",
        },
        "morbidity": {
            "respiratory_presentations": latest_metric_summary(h, MetricType.RESPIRATORY_PRESENTATIONS, CaseDefinitionType.SYNDROMIC_RESPIRATORY),
            "hospitalizations": latest_metric_summary(h, MetricType.HOSPITALIZATIONS),
        },
        "hospitalizations": latest_metric_summary(h, MetricType.HOSPITALIZATIONS),
        "test_volume": latest_metric_summary(h, MetricType.TESTS_PERFORMED),
        "test_positivity": latest_metric_summary(h, MetricType.TEST_POSITIVITY, CaseDefinitionType.LAB_CONFIRMED),
        "laboratory_signals": [
            latest_metric_summary(h, MetricType.LAB_CONFIRMED_CASES, CaseDefinitionType.LAB_CONFIRMED),
            latest_metric_summary(h, MetricType.TEST_POSITIVITY, CaseDefinitionType.LAB_CONFIRMED),
        ],
        "wastewater_signals": [latest_metric_summary(h, MetricType.WASTEWATER_SIGNAL)],
        "vaccination_coverage": latest_metric_summary(h, MetricType.VACCINATION_COVERAGE),
        "program_coverage": {
            "vaccination_program": latest_metric_summary(h, MetricType.VACCINATION_COVERAGE),
            "note": "Program output/coverage is not health outcome proof.",
        },
        "hospital_capacity": latest_metric_summary(h, MetricType.HOSPITAL_OCCUPANCY),
        "icu_context": latest_metric_summary(h, MetricType.ICU_OCCUPANCY),
        "healthcare_staffing_context": {
            "state": "UNAVAILABLE",
            "reason": "Aggregate staffing/absenteeism/vacancy data not configured in sample.",
            "privacy_note": "Named worker medical status never exposed.",
        },
        "medicine_availability": latest_metric_summary(h, MetricType.MEDICINE_STOCKOUT_RATE),
        "medical_supply_context": {
            "stockout_signal": latest_metric_summary(h, MetricType.MEDICINE_STOCKOUT_RATE),
            "handoff": "SUPPLYCHAININT / PROCUREMENTINT for root cause and dependency analysis.",
        },
        "environmental_health_signals": {
            "air_quality": latest_metric_summary(h, MetricType.AIR_PM25),
            "heat_health": latest_metric_summary(h, MetricType.HEAT_INDEX),
        },
        "air_quality_context": latest_metric_summary(h, MetricType.AIR_PM25),
        "water_quality_context": {"state": "NOT_CONFIGURED_IN_SAMPLE"},
        "heat_health_context": latest_metric_summary(h, MetricType.HEAT_INDEX),
        "vector_surveillance": {"state": "NOT_CONFIGURED_IN_SAMPLE"},
        "foodborne_context": {"state": "NOT_CONFIGURED_IN_SAMPLE"},
        "maternal_child_health_context": {
            "pediatric_rare_syndrome": "SUPPRESSED_SMALL_CELL",
            "privacy_note": "Sensitive pediatric aggregate suppressed to prevent reidentification.",
        },
        "mental_health_population_context": {"state": "NOT_CONFIGURED_IN_SAMPLE", "boundary": "No individual mental-health inference."},
        "occupational_health_context": {"state": "NOT_CONFIGURED_IN_SAMPLE", "boundary": "No punitive individual employment use."},
        "health_access": {
            "state": "PARTIAL",
            "note": "Facility capacity observed; distance/travel time/insurance/wait times not configured.",
        },
        "health_disparities": {
            "state": "NOT_ANALYZED",
            "note": "Aggregate lawful strata required; no stigmatizing group attribution.",
        },
        "genomic_surveillance_context": {"state": "NOT_CONFIGURED_IN_SAMPLE", "boundary": "Descriptive public-health summaries only; no engineering."},
        "variant_context": {"state": "NOT_CONFIGURED_IN_SAMPLE", "boundary": "Variant prevalence is not severity proof."},
        "amr_context": {"state": "NOT_CONFIGURED_IN_SAMPLE", "boundary": "Population AMR patterns do not determine individual therapy."},
        "public_health_programs": [
            {
                "program_id": "PROG-VAX-NB",
                "name": "Northbridge respiratory vaccination program",
                "coverage": latest_metric_summary(h, MetricType.VACCINATION_COVERAGE),
                "note": "Coverage is program output; outcome effectiveness requires studies.",
            }
        ],
        "public_health_interventions": [
            "testing",
            "vaccination",
            "public communication",
            "infection prevention guidance",
            "capacity monitoring",
        ],
        "health_policies": {"state": "NOT_CONFIGURED_IN_SAMPLE", "note": "Policy announcement is not implementation."},
        "misinformation_context": [latest_metric_summary(h, MetricType.MISINFORMATION_REACH)],
        "outbreak_signals": {
            "state": h.outbreak_state.value,
            "official_declaration": False,
            "signals": {
                "syndromic": h.trend_for(MetricType.RESPIRATORY_PRESENTATIONS, CaseDefinitionType.SYNDROMIC_RESPIRATORY),
                "lab_positivity": h.trend_for(MetricType.TEST_POSITIVITY, CaseDefinitionType.LAB_CONFIRMED),
                "wastewater": h.trend_for(MetricType.WASTEWATER_SIGNAL),
                "hospital_occupancy": latest_metric_summary(h, MetricType.HOSPITAL_OCCUPANCY),
            },
            "guardrails": [
                "Outbreak candidate is not confirmed outbreak.",
                "Only competent authorities declare official outbreaks.",
                "Alternative explanations remain.",
            ],
        },
        "public_health_event_states": {
            "current_state": h.outbreak_state.value,
            "early_warning_state": "ELEVATED" if h.outbreak_state in {OutbreakSignalState.ELEVATED_SIGNAL, OutbreakSignalState.OUTBREAK_CANDIDATE} else "WATCH",
        },
        "baseline": {
            "method": "mean of up to previous four observations per metric/population/geography/case-definition series",
            "trends": h.trends,
        },
        "seasonality": {
            "state": "POSSIBLE_CONFOUNDER",
            "note": "Historical seasonal envelope not fully configured; seasonality hypothesis retained.",
        },
        "forecast_context": {
            "state": "NOT_PRODUCED",
            "reason": "Forecast requires model registry, training window, validation, and uncertainty; not fabricated.",
            "safe_scenarios": [
                "Hospital demand under continued case increase",
                "Medicine supply under sustained stockout",
                "Vaccination uptake under misinformation exposure",
            ],
        },
        "timeline_updates": build_timeline(h),
        "observations": list(h.observations.values()),
        "candidate_facts": candidate_facts,
        "supported_facts": supported_facts,
        "partial_facts": partial_facts,
        "disputed_facts": disputed_facts,
        "observed_facts": observed_facts,
        "source_reliability": {sid: src.reliability for sid, src in h.sources.items()},
        "source_bias": {sid: src.notes for sid, src in h.sources.items()},
        "source_limitations": {sid: [src.notes] for sid, src in h.sources.items() if src.notes},
        "source_pedigree": {sid: h.get_source_family(sid) for sid in h.sources},
        "source_independence": {
            "source_families": source_families,
            "finding_independence": finding_independence,
        },
        "data_quality": h.data_quality,
        "coverage": {
            "geographic_coverage": "Northbridge region aggregate",
            "laboratory_coverage": "Partial laboratory network",
            "hospital_coverage": "Aggregate hospital dashboard",
            "wastewater_coverage": "Two or more synthetic surveillance sites implied",
            "limitations": h.data_quality.get("guardrails", []),
        },
        "reporting_delays": {
            "state": "UNRESOLVED",
            "note": "Event/specimen/report/publication date metadata not fully available.",
        },
        "confounders": [
            "testing volume/criteria",
            "reporting delay/backfill",
            "case-definition change",
            "seasonality",
            "healthcare-seeking behavior",
            "media coverage/public concern",
            "environmental heat/air exposure",
            "migration/denominator change",
        ],
        "contradictions": h.contradictions,
        "hypotheses": h.hypotheses,
        "falsification_results": [
            {
                "hypothesis_id": hy.id,
                "statement": hy.statement,
                "kind": hy.kind,
                "status": hy.status.value,
                "confidence": hy.confidence,
                "supporting_finding_ids": hy.supporting_finding_ids,
                "contradicting_finding_ids": hy.contradicting_finding_ids,
                "assumptions": hy.assumptions,
                "predictions": hy.predictions,
                "falsification_conditions": hy.falsification_conditions,
                "limitations": hy.limitations,
            }
            for hy in h.hypotheses
        ],
        "privacy_flags": [
            PrivacyFlag.CASE_SCOPED.value,
            PrivacyFlag.POPULATION_LEVEL_ONLY.value,
            PrivacyFlag.NO_INDIVIDUAL_DIAGNOSIS.value,
            PrivacyFlag.NO_MEDICAL_RECORD_ACCESS.value,
            PrivacyFlag.NO_REIDENTIFICATION.value,
            PrivacyFlag.SMALL_CELL_SUPPRESSION.value,
            PrivacyFlag.LOCATION_GENERALIZATION.value,
            PrivacyFlag.PURPOSE_LIMITATION.value,
            PrivacyFlag.NO_COVERT_HEALTH_SURVEILLANCE.value,
            PrivacyFlag.LOCAL_ONLY_DEFAULT.value,
        ],
        "legal_flags": [
            LegalFlag.HEALTH_PRIVACY_REVIEW_REQUIRED.value,
            LegalFlag.DATA_USE_AGREEMENT_REVIEW_REQUIRED.value,
            LegalFlag.LEGALINT_HANDOFF_REQUIRED.value,
            LegalFlag.HUMAN_PUBLIC_HEALTH_AUTHORITY_REQUIRED.value,
        ],
        "biosecurity_flags": [
            BiosecurityFlag.NO_PATHogen_ENGINEERING.value,
            BiosecurityFlag.NO_VIRULENCE_OPTIMIZATION.value,
            BiosecurityFlag.NO_TRANSMISSIBILITY_OPTIMIZATION.value,
            BiosecurityFlag.NO_IMMUNE_EVASION_ENGINEERING.value,
            BiosecurityFlag.NO_BIOLOGICAL_ATTACK_PLANNING.value,
            BiosecurityFlag.NO_CONTAMINATION_METHODS.value,
            BiosecurityFlag.PUBLIC_HEALTH_ORIENTATION_ONLY.value,
        ],
        "unknowns": sorted(set(
            [g.description for g in h.gaps]
            + [hy.statement for hy in h.hypotheses if hy.status in {HypothesisStatus.UNRESOLVED, HypothesisStatus.DISPUTED}]
        )),
        "knowledge_gaps": h.gaps,
        "recommended_next_actions": h.actions,
        "recommendations": h.recommendations,
        "specialist_handoffs": h.handoffs,
        "limitations": [
            "Local synthetic demo; no live public-health system access.",
            "Population-level privacy-first analysis only.",
            "No individual diagnosis, prescription, treatment change, or personal medical profiling.",
            "No medical record access, reidentification, or covert surveillance.",
            "No pathogen engineering, biological attack planning, or contamination methods.",
            "Syndromic surveillance is not pathogen-specific diagnosis.",
            "Wastewater signal is not exact case count.",
            "Hospital occupancy is not outbreak proof.",
            "Provisional data may be revised.",
            "Source dependency preserved; multiple dashboards using same data are not independent evidence.",
            "Outbreak declaration and consequential actions require human public-health authority.",
        ] + h.validation_errors,
        "analyst_summary": summary,
        "dual_ai_review": dual,
        "health_graph": build_health_graph(h),
        "source_graph": build_source_graph(h),
        "source_dependency_graph": source_families,
        "replay_manifest": replay_manifest,
    }


# =====================================================================
# PIPELINES
# =====================================================================

def run_sample_pipeline() -> Dict[str, Any]:
    h = build_sample_healthint()
    return build_result(h, Status.PARTIAL)


def run_unconfigured_pipeline(case: Case) -> Dict[str, Any]:
    h = HealthInt(case)

    h.gaps.append(KnowledgeGap(
        id="GAP-NO-HEALTH-EVIDENCE",
        gap_type=GapType.CASE_DEFINITION_UNCLEAR,
        description=(
            "No configured authorized/public aggregated public-health corpus is available. "
            "No population signal, case count, rate, hospital capacity, laboratory summary, wastewater signal, "
            "vaccination coverage, supply constraint, or outbreak candidate can be resolved."
        ),
        importance="HIGH",
        recommended_source=(
            "Provide authorized aggregated surveillance reports, laboratory summaries, hospital capacity dashboards, "
            "wastewater data, vaccination coverage, supply notices, environmental data, and public-health guidance."
        ),
        specialist="HEALTHINT / ORGINT / SUPPLYCHAININT / LEGALINT",
        expected_information_value=0.95,
    ))

    h.actions = [NextAction(
        id="ACT-CONFIGURE-HEALTH-EVIDENCE",
        description=(
            "Configure lawful authorized/public aggregated health evidence or sanitized local corpus. "
            "Do not diagnose individuals, access private records, reidentify patients, expose small cells, "
            "conduct covert surveillance, or enable biological harm."
        ),
        priority=1,
        privacy_impact="LOW",
        expected_gain=0.95,
        specialist=None,
        requires_human_approval=False,
    )]

    h.handoffs = []
    h.recommendations = []
    h.hypotheses = []
    h.contradictions = []
    h.outbreak_state = OutbreakSignalState.UNKNOWN
    h.data_quality = {
        "as_of": h.as_of,
        "observation_count": 0,
        "suppressed_count": 0,
        "provisional_count": 0,
        "missing_denominator_count": 0,
        "state": DataQualityState.MISSING.value,
        "guardrails": ["No health evidence configured.", "No cases, deaths, outbreaks, capacities, or rates fabricated."],
    }

    dual = {
        "primary_public_health_analyst": "No evidence available.",
        "independent_epidemiology_skeptic_issues": [
            "No authorized/public aggregated health corpus configured.",
            "No population or case definition resolved.",
            "No denominator validated.",
            "No outbreak signal possible.",
            "No individual health inference permitted.",
        ],
        "verdict": "INSUFFICIENT_EVIDENCE",
        "note": "AI agreement is not independent epidemiological evidence.",
    }

    summary = (
        "HEALTHINT UNRESOLVED: No configured authorized/public aggregated health corpus. "
        "No cases, deaths, outbreaks, hospital capacities, vaccination rates, test positivities, wastewater signals, "
        "environmental causal claims, or individual diagnoses were fabricated. "
        "Provide lawful aggregated evidence or run sample mode."
    )

    result = build_result(h, Status.BLOCKED_CONFIGURATION)
    result["analyst_summary"] = summary
    result["dual_ai_review"] = dual
    return result


def blocked_policy_result(case: Case, violations: List[Dict[str, str]]) -> Dict[str, Any]:
    return {
        "case_id": case.case_id,
        "task_id": case.task_id,
        "objective": case.objective,
        "questions": case.questions,
        "status": Status.BLOCKED_POLICY.value,
        "policy_violations": violations,
        "message": (
            "Prohibited public-health intelligence request detected. HEALTHINT supports authorized, population-level, "
            "privacy-first, evidence-first, human-governed public-health intelligence only. It does not diagnose individuals, "
            "prescribe treatment, access private medical records, reidentify patients, expose small-cell sensitive health data, "
            "conduct covert health surveillance, use health data for discrimination, engineer pathogens, optimize virulence/"
            "transmissibility/immune evasion, or provide biological attack/contamination methods."
        ),
        "lawful_alternatives": [
            "Analyze authorized aggregated surveillance counts/rates with population and case definitions.",
            "Validate denominators and reporting-delay metadata.",
            "Separate syndromic, probable, confirmed, lab-confirmed, and self-reported definitions.",
            "Correlate laboratory, wastewater, hospital capacity, vaccination, supply, and environmental context defensively.",
            "Suppress small cells and aggregate further when reidentification risk exists.",
            "Route outbreak declaration, quarantine/isolation, rationing, and consequential actions to human public-health authority.",
            "Hand supply dependencies to SUPPLYCHAININT and legal/privacy questions to LEGALINT/privacy officer.",
        ],
        "privacy_flags": [
            PrivacyFlag.NO_INDIVIDUAL_DIAGNOSIS.value,
            PrivacyFlag.NO_MEDICAL_RECORD_ACCESS.value,
            PrivacyFlag.NO_REIDENTIFICATION.value,
            PrivacyFlag.SMALL_CELL_SUPPRESSION.value,
            PrivacyFlag.NO_COVERT_HEALTH_SURVEILLANCE.value,
            PrivacyFlag.PURPOSE_LIMITATION.value,
        ],
        "biosecurity_flags": [
            BiosecurityFlag.NO_PATHogen_ENGINEERING.value,
            BiosecurityFlag.NO_VIRULENCE_OPTIMIZATION.value,
            BiosecurityFlag.NO_TRANSMISSIBILITY_OPTIMIZATION.value,
            BiosecurityFlag.NO_IMMUNE_EVASION_ENGINEERING.value,
            BiosecurityFlag.NO_BIOLOGICAL_ATTACK_PLANNING.value,
            BiosecurityFlag.NO_CONTAMINATION_METHODS.value,
        ],
        "limitations": [
            "No public-health analysis performed.",
            "No cases, deaths, outbreaks, capacities, vaccinations, rates, or individual health states fabricated.",
            "No private records accessed and no biological harm enabled.",
        ],
    }


def run_pipeline(case: Case) -> Dict[str, Any]:
    text = " ".join(
        [
            case.objective,
            *case.questions,
            case.region or "",
            case.population or "",
            case.condition or "",
            case.authorization or "",
            " ".join(case.scope),
        ]
    )

    violations = policy_guard(text)
    if violations:
        return blocked_policy_result(case, violations)

    if case.sample:
        return run_sample_pipeline()

    return run_unconfigured_pipeline(case)


# =====================================================================
# CLI
# =====================================================================

def main() -> None:
    parser = argparse.ArgumentParser(
        description=(
            "TRACEATLAS HEALTHINT local privacy-first public-health intelligence pipeline. "
            "Sample mode uses synthetic authorized aggregated surveillance data."
        )
    )
    parser.add_argument("--sample", action="store_true", help="Run built-in synthetic HEALTHINT sample.")
    parser.add_argument("--objective", help="Authorized population-level public-health objective.")
    parser.add_argument("--question", action="append", default=[], help="Public-health question. Repeatable.")
    parser.add_argument("--region", help="Geographic region.")
    parser.add_argument("--population", help="Population ID/name.")
    parser.add_argument("--condition", help="Condition or syndrome category.")
    parser.add_argument("--time-range", help="Time range hint.")
    parser.add_argument("--as-of", default=DEFAULT_AS_OF, help="Analysis as-of timestamp.")

    args = parser.parse_args()

    if args.sample or not args.objective:
        case = sample_case()
    else:
        case = Case(
            case_id=new_id("CASE-", args.objective),
            task_id=new_id("TASK-", args.objective),
            objective=args.objective,
            questions=args.question,
            region=args.region,
            population=args.population,
            condition=args.condition,
            time_range=args.time_range,
            as_of=args.as_of,
            sample=False,
        )

    result = run_pipeline(case)
    print(json.dumps(jsonable(result), indent=2, ensure_ascii=False))


if __name__ == "__main__":
    main()




    