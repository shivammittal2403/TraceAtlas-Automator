def extract_provider_labels(text: str) -> List[Tuple[str, str]]:
    out: List[Tuple[str, str]] = []
    seen = set()

    def push(label: Any, provider: Any = "") -> None:
        lab = str(label or "").strip()
        prov = str(provider or "").strip()
        if normalize_text(prov) == "source_text":
            prov = ""
        if not lab:
            return
        key = (normalize_text(prov), normalize_text(lab))
        if key in seen:
            return
        seen.add(key)
        out.append((lab, prov))

    for m in re.finditer(r"\b([A-Za-z0-9_.-]{2,40})::([A-Za-z0-9_.\- ]{2,80})\b", text):
        push(m.group(2).strip(), m.group(1).strip())

    for m in APT_RE.finditer(text):
        push(m.group(0).upper(), "")

    for m in UNC_RE.finditer(text):
        push(m.group(0).upper(), "")

    for v in match_explicit(text, r"(?i)\b(?:threat actor|actor|group|intrusion set)\s*[:=]\s*([^\n,;]{2,120})"):
        push(v, "")

    return out


def process_text_block(
    text: str,
    source_id: str,
    evidence_id: str,
    parsed: Dict[str, Any],
    context: str = "",
    actor_hint: Optional[str] = None,
    campaign_hint: Optional[str] = None,
    temporal: Optional[Dict[str, Any]] = None,
) -> None:
    raw = str(text or "")
    if not raw.strip():
        return

    redacted, _ = redact_secrets(raw)
    source = context or "text_block"

    labels = extract_provider_labels(redacted)
    for lab, prov in labels[:100]:
        add_actor_label(parsed, lab, prov, source_id, evidence_id, source, temporal, state="SOURCE_OBSERVED_LABEL")

    for lab in match_explicit(redacted, r"(?i)\bintrusion set\s*[:=]\s*([^\n,;]{2,120})"):
        add_intrusion_set(parsed, lab, provider="", source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    for name in match_explicit(redacted, r"(?i)\bcampaign\s*[:=]\s*([^\n,;]{2,120})"):
        add_campaign(parsed, name, actor_labels=[actor_hint] if actor_hint else [], source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    for name in match_explicit(redacted, r"(?i)\boperation\s*[:=]\s*([^\n,;]{2,120})"):
        add_operation(parsed, name, actor_labels=[actor_hint] if actor_hint else [], source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    for mal in match_explicit(redacted, r"(?i)\b(?:malware|family)\s*[:=]\s*([^\n,;]{2,120})"):
        add_malware_link(parsed, mal, actor_label=actor_hint, campaign=campaign_hint, source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    for tool in match_explicit(redacted, r"(?i)\b(?:tool|utility)\s*[:=]\s*([^\n,;]{2,120})"):
        add_tool_link(parsed, tool, actor_label=actor_hint, campaign=campaign_hint, source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    domains = sorted({normalize_domain(x) for x in DOMAIN_RE.findall(redacted) if normalize_domain(x)})
    ips = sorted({x for x in IPV4_RE.findall(redacted) if valid_ip(x)})
    urls = sorted(set(URL_RE.findall(redacted)))
    certs = sorted(set(CERT_FP_RE.findall(redacted)))

    for dom in domains[:100]:
        add_infrastructure_link(parsed, actor_label=actor_hint, campaign=campaign_hint, domain=dom, source_id=source_id, evidence_id=evidence_id, temporal=temporal)
    for ip in ips[:100]:
        add_infrastructure_link(parsed, actor_label=actor_hint, campaign=campaign_hint, ip=ip, source_id=source_id, evidence_id=evidence_id, temporal=temporal)
    for url in urls[:100]:
        add_infrastructure_link(parsed, actor_label=actor_hint, campaign=campaign_hint, url=url, source_id=source_id, evidence_id=evidence_id, temporal=temporal)
    for cert in certs[:100]:
        add_infrastructure_link(parsed, actor_label=actor_hint, campaign=campaign_hint, certificate=cert, source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    cves = sorted({normalize_cve(x) for x in CVE_RE.findall(redacted) if normalize_cve(x)})
    for cve in cves[:100]:
        add_vulnerability_link(parsed, cve, actor_label=actor_hint, campaign=campaign_hint, source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    attacks = sorted({m.upper() for m in ATTACK_RE.findall(redacted)})
    for tech in attacks[:200]:
        add_ttp(parsed, technique=tech, actor_label=actor_hint, campaign=campaign_hint, source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    for proc in match_explicit(redacted, r"(?i)\b(?:procedure|behavior)\s*[:=]\s*([^\n,;]{2,300})"):
        add_procedure(parsed, proc, actor_label=actor_hint, campaign=campaign_hint, source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    for sector in match_explicit(redacted, r"(?i)\bsector\s*[:=]\s*([^\n,;]{2,120})"):
        add_victimology(parsed, sector=sector, actor_label=actor_hint, campaign=campaign_hint, source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    for country in match_explicit(redacted, r"(?i)\bcountry\s*[:=]\s*([^\n,;]{2,120})"):
        add_victimology(parsed, country=country, actor_label=actor_hint, campaign=campaign_hint, source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    for region in match_explicit(redacted, r"(?i)\bregion\s*[:=]\s*([^\n,;]{2,120})"):
        add_victimology(parsed, region=region, actor_label=actor_hint, campaign=campaign_hint, source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    for victim in match_explicit(redacted, r"(?i)\b(?:victim|organization)\s*[:=]\s*([^\n,;]{2,160})"):
        add_victimology(parsed, victim=victim, actor_label=actor_hint, campaign=campaign_hint, source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    for obj in match_explicit(redacted, r"(?i)\b(?:objective|goal)\s*[:=]\s*([^\n,;]{2,200})"):
        add_objective(parsed, obj, actor_label=actor_hint, campaign=campaign_hint, source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    for mot in match_explicit(redacted, r"(?i)\bmotivation\s*[:=]\s*([^\n,;]{2,200})"):
        add_motivation(parsed, mot, actor_label=actor_hint, campaign=campaign_hint, source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    low = normalize_text(redacted)
    if any(re.search(p, low, re.I) for p in SPONSORSHIP_PATTERNS):
        add_sponsorship(parsed, actor_hint or campaign_hint or "actor/campaign context", redacted[:300], actor_label=actor_hint, campaign=campaign_hint, source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    if any(re.search(p, low, re.I) for p in RESPONSIBILITY_PATTERNS):
        add_source_claim(parsed, "CLAIM_OF_RESPONSIBILITY", redacted[:300], actor_label=actor_hint, campaign=campaign_hint, source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    for persona in match_explicit(redacted, r"(?i)\b(?:persona|public persona)\s*[:=]\s*([^\n,;]{2,120})"):
        add_persona(parsed, persona, actor_label=actor_hint, source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    for handle in match_explicit(redacted, r"(?i)\b(?:handle|username|alias)\s*[:=]\s*([^\n,;]{2,120})"):
        add_handle(parsed, handle, actor_label=actor_hint, source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    if labels or campaign_hint or actor_hint:
        add_observation(parsed, f"Threat actor/campaign context text: {redacted[:300]}", source_id, evidence_id, context=source)


def classify_json_payload(data: Any, filename: str = "") -> str:
    if not isinstance(data, dict):
        return "GENERIC_JSON"

    keys = {normalize_key(k) for k in data.keys()}
    low = json.dumps(data, ensure_ascii=False, default=str)[:20000].lower()
    fname = normalize_text(filename)

    actor_keys = {
        "actor_label", "threat_actor", "actor", "group", "cluster",
        "intrusion_set", "campaign", "operation", "malware", "tool",
        "victimology", "sector", "country", "region", "sponsorship",
        "objective", "motivation", "responsibility", "persona", "handle",
        "attack_technique", "procedure", "aliases", "provider",
    }

    if keys & actor_keys:
        return "THREAT_ACTOR_REPORT"
    if "objects" in keys and isinstance(data.get("objects"), list):
        return "STIX_LIKE"
    if "threat" in fname or "actor" in fname or "campaign" in fname:
        return "THREAT_ACTOR_REPORT"
    if "malware" in low or "campaign" in low or "actor" in low:
        return "THREAT_ACTOR_REPORT"
    return "GENERIC_JSON"


def process_json_record(rec: Dict[str, Any], source_id: str, evidence_id: str, parsed: Dict[str, Any], path: str = "") -> None:
    if not isinstance(rec, dict):
        return

    temporal = extract_temporal(rec)
    provider = get_field(rec, ["provider", "vendor", "publisher", "source_org", "organization", "reporting_org"])
    source = str(get_field(rec, ["source", "publisher", "report_title", "provider", "vendor"]) or path or "json_record")

    actor_label = get_field(rec, ["actor_label", "threat_actor", "actor", "group", "cluster"])
    actor_labels = clean_list(get_field(rec, ["actor_labels", "actors", "threat_actors", "groups"]))
    aliases = get_field(rec, ["aliases", "also_known_as", "aka"])
    description = get_field(rec, ["description", "summary", "details", "text"])

    intrusion_set = get_field(rec, ["intrusion_set", "intrusion_set_name"])
    campaign = get_field(rec, ["campaign", "campaign_name", "operation_name"])
    operation = get_field(rec, ["operation"])

    malware = get_field(rec, ["malware", "malware_family", "family"])
    variant = get_field(rec, ["variant", "malware_variant"])
    tool = get_field(rec, ["tool", "utility"])

    domain = get_field(rec, ["domain", "hostname", "host"])
    ip = get_field(rec, ["ip", "address", "ipv4", "ipv6"])
    url = get_field(rec, ["url", "uri", "endpoint"])
    certificate = get_field(rec, ["certificate", "cert", "fingerprint"])
    asn = get_field(rec, ["asn", "autonomous_system"])

    cve = get_field(rec, ["cve", "cve_id", "vulnerability_id"])
    tactic = get_field(rec, ["tactic"])
    technique = get_field(rec, ["attack_technique", "technique", "technique_id"])
    subtechnique = get_field(rec, ["subtechnique", "sub_technique"])
    procedure = get_field(rec, ["procedure", "behavior"])

    sector = get_field(rec, ["sector"])
    country = get_field(rec, ["country"])
    region = get_field(rec, ["region"])
    victim = get_field(rec, ["victim", "organization", "target_organization"])
    technology = get_field(rec, ["technology", "platform"])

    objective = get_field(rec, ["objective", "goal"])
    motivation = get_field(rec, ["motivation"])
    sponsorship = get_field(rec, ["sponsorship", "state_link", "government_link"])
    responsibility = get_field(rec, ["responsibility_claim", "claimed_responsibility", "claim_of_responsibility"])

    persona = get_field(rec, ["persona", "public_persona"])
    handle = get_field(rec, ["handle", "username"])

    all_actor_labels = []
    if actor_label:
        all_actor_labels.append(str(actor_label))
    all_actor_labels.extend(actor_labels)
    all_actor_labels = clean_list(all_actor_labels)

    for al in all_actor_labels[:50]:
        add_actor_label(parsed, al, provider=provider, source_id=source_id, evidence_id=evidence_id, context=source, temporal=temporal, aliases=aliases, description=description)

    if intrusion_set:
        add_intrusion_set(parsed, intrusion_set, provider=provider, source_id=source_id, evidence_id=evidence_id, temporal=temporal, campaigns=[campaign] if campaign else [], malware=[malware] if malware else [], ttps=[technique] if technique else [])

    if campaign:
        add_campaign(
            parsed,
            campaign,
            aliases=get_field(rec, ["campaign_aliases"]),
            start_time=temporal.get("first_seen"),
            end_time=temporal.get("last_seen"),
            sectors=[sector] if sector else [],
            regions=[region] if region else [],
            victims=[victim] if victim else [],
            malware=[malware] if malware else [],
            tools=[tool] if tool else [],
            infrastructure=[x for x in [domain, ip, url, certificate, asn] if x],
            vulnerabilities=[cve] if cve else [],
            ttps=[technique] if technique else [],
            procedures=[procedure] if procedure else [],
            actor_labels=all_actor_labels,
            source_id=source_id,
            evidence_id=evidence_id,
            temporal=temporal,
        )

    if operation:
        add_operation(parsed, operation, actor_labels=all_actor_labels, campaigns=[campaign] if campaign else [], source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    if malware:
        add_malware_link(parsed, malware, variant=variant, actor_label=first(all_actor_labels), campaign=campaign, source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    if tool:
        add_tool_link(parsed, tool, actor_label=first(all_actor_labels), campaign=campaign, source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    if any([domain, ip, url, certificate, asn]):
        add_infrastructure_link(
            parsed,
            actor_label=first(all_actor_labels),
            campaign=campaign,
            domain=domain,
            ip=ip,
            url=url,
            certificate=certificate,
            asn=asn,
            source_id=source_id,
            evidence_id=evidence_id,
            temporal=temporal,
        )

    if cve:
        add_vulnerability_link(parsed, cve, actor_label=first(all_actor_labels), campaign=campaign, source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    if any([tactic, technique, subtechnique, procedure]):
        add_ttp(
            parsed,
            tactic=tactic,
            technique=technique,
            subtechnique=subtechnique,
            procedure=procedure,
            actor_label=first(all_actor_labels),
            campaign=campaign,
            source_id=source_id,
            evidence_id=evidence_id,
            temporal=temporal,
            attack_version=str(get_field(rec, ["attack_version", "mitre_version"]) or "UNKNOWN"),
        )

    if procedure:
        add_procedure(parsed, procedure, actor_label=first(all_actor_labels), campaign=campaign, source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    if any([victim, sector, country, region, technology]):
        add_victimology(
            parsed,
            victim=victim,
            sector=sector,
            country=country,
            region=region,
            technology=technology,
            actor_label=first(all_actor_labels),
            campaign=campaign,
            source_id=source_id,
            evidence_id=evidence_id,
            temporal=temporal,
        )

    if objective:
        add_objective(parsed, objective, actor_label=first(all_actor_labels), campaign=campaign, source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    if motivation:
        add_motivation(parsed, motivation, actor_label=first(all_actor_labels), campaign=campaign, source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    if sponsorship:
        add_sponsorship(parsed, first(all_actor_labels) or campaign, sponsorship, actor_label=first(all_actor_labels), campaign=campaign, source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    if responsibility:
        add_source_claim(parsed, "CLAIM_OF_RESPONSIBILITY", responsibility, actor_label=first(all_actor_labels), campaign=campaign, source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    if persona:
        add_persona(parsed, persona, platform=get_field(rec, ["platform"]), actor_label=first(all_actor_labels), source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    if handle:
        add_handle(parsed, handle, platform=get_field(rec, ["platform"]), actor_label=first(all_actor_labels), source_id=source_id, evidence_id=evidence_id, temporal=temporal)

    rec_text = json.dumps(rec, ensure_ascii=False, default=str)[:5000]
    process_text_block(rec_text, source_id, evidence_id, parsed, context=f"json:{path}", actor_hint=first(all_actor_labels), campaign_hint=campaign, temporal=temporal)


def walk_json(data: Any, source_id: str, evidence_id: str, parsed: Dict[str, Any], depth: int = 0, path: str = "") -> None:
    if depth > 12 or len(parsed.get("observations", [])) > 200000:
        return

    if isinstance(data, dict):
        process_json_record(data, source_id, evidence_id, parsed, path=path)
        for k, v in data.items():
            new_path = f"{path}.{k}" if path else str(k)
            walk_json(v, source_id, evidence_id, parsed, depth + 1, new_path)
    elif isinstance(data, list):
        for item in data[:100000]:
            walk_json(item, source_id, evidence_id, parsed, depth + 1, path)
    elif isinstance(data, str):
        process_text_block(data, source_id, evidence_id, parsed, context=f"json_scalar:{path}")


def process_json_file(path: Path, source_id: str, evidence_id: str) -> Tuple[str, Dict[str, Any]]:
    parsed = empty_parsed()
    raw = path.read_text(encoding="utf-8", errors="replace")[:30_000_000]
    data = json.loads(raw)
    kind = classify_json_payload(data, path.name)
    walk_json(data, source_id, evidence_id, parsed)
    return kind, parsed


def process_csv_file(path: Path, source_id: str, evidence_id: str) -> Tuple[str, Dict[str, Any]]:
    parsed = empty_parsed()
    kind = "CSV_THREAT_ACTOR_DATA"

    with path.open("r", encoding="utf-8", errors="replace", newline="") as f:
        sample = f.read(1_000_000)
        f.seek(0)
        try:
            dialect = csv.Sniffer().sniff(sample, delimiters=",;\t| ")
        except csv.Error:
            dialect = csv.excel

        reader = csv.DictReader(f, dialect=dialect)
        for idx, row in enumerate(reader):
            if idx >= 200000:
                break
            process_json_record(row, source_id, evidence_id, parsed, path=f"csv_row_{idx}")

    return kind, parsed


def process_text_file(path: Path, source_id: str, evidence_id: str) -> Tuple[str, Dict[str, Any]]:
    parsed = empty_parsed()
    raw = path.read_text(encoding="utf-8", errors="replace")[:10_000_000]
    redacted, secret_flags = redact_secrets(raw)

    if secret_flags:
        add_note(parsed, "SECRET_REDACTION", flags=secret_flags, source_id=source_id, evidence_id=evidence_id)

    kind = "TEXT_THREAT_ACTOR_REPORT"
    low = redacted.lower()[:20000]
    if "intrusion set" in low or "apt" in low or "unc" in low:
        kind = "TEXT_ACTOR_LABEL_REPORT"
    elif "campaign" in low or "operation" in low:
        kind = "TEXT_CAMPAIGN_REPORT"
    elif "victim" in low or "sector" in low or "country" in low:
        kind = "TEXT_VICTIMOLOGY_REPORT"
    elif "att&ck" in low or "technique" in low or "procedure" in low:
        kind = "TEXT_TTP_PROCEDURE_REPORT"
    elif "domain" in low or "ip" in low or "certificate" in low:
        kind = "TEXT_INFRASTRUCTURE_REPORT"

    for line_no, line in enumerate(redacted.splitlines()[:200000]):
        if line.strip():
            process_text_block(line, source_id, evidence_id, parsed, context=f"text_line_{line_no}")

    return kind, parsed


def detect_format(path: Path) -> Dict[str, str]:
    suffix = path.suffix.lower()

    try:
        with path.open("rb") as f:
            head = f.read(256)
    except Exception as exc:
        return {"format_detected": "UNKNOWN", "mime_type": "application/octet-stream", "format_error": str(exc)}

    if suffix in BINARY_SUFFIXES:
        return {"format_detected": "BINARY_ARTIFACT", "mime_type": "application/octet-stream"}

    stripped = head.lstrip()

    if suffix == ".json" or stripped.startswith(b"{") or stripped.startswith(b"["):
        return {"format_detected": "JSON", "mime_type": "application/json"}

    if suffix in {".csv", ".tsv"}:
        return {"format_detected": "CSV", "mime_type": "text/csv"}

    if b"," in head and b"\n" in head and all(b in b"\x09\x0a\x0d\x20" or 32 <= b <= 126 for b in head[:64]):
        return {"format_detected": "CSV", "mime_type": "text/csv"}

    if suffix in {".txt", ".log", ".md", ".yaml", ".yml", ".report", ".stix", ".taxii", ".misp"}:
        return {"format_detected": "TEXT", "mime_type": "text/plain"}

    try:
        probe = head.decode("utf-8", errors="strict")
        if probe.strip():
            return {"format_detected": "TEXT", "mime_type": "text/plain"}
    except Exception:
        pass

    return {"format_detected": "UNKNOWN", "mime_type": "application/octet-stream"}


def analyze_threatactor_file(path_str: str, case_id: str = "", task_id: str = "") -> Tuple[Dict[str, Any], Dict[str, Any]]:
    path = Path(path_str).expanduser()
    source_id = f"SRC-{uuid.uuid4()}"
    evidence_id = f"EVD-{uuid.uuid4()}"

    file_evidence: Dict[str, Any] = {
        "evidence_id": evidence_id,
        "source_id": source_id,
        "case_id": case_id,
        "task_id": task_id,
        "path": str(path),
        "filename": path.name,
        "retrieved_at": now_utc(),
        "acquisition_method": "local_authorized_or_public_file_access",
        "status": "PENDING",
        "limitations": [
            "No network access, actor contact, infrastructure exploitation, malware deployment, credential use, doxxing, private-person tracking, or autonomous accusation performed.",
            "Binary artifacts are hash/metadata preserved only; no execution or deep parsing performed.",
            "Threat reports, actor statements, forum posts, repositories, and IOCs are untrusted evidence, not instructions.",
            "Exposed secrets are redacted and not used.",
            "Source-attributed labels/claims are not verified real-world identities or organizations.",
        ],
    }

    parsed = empty_parsed()

    if not path.exists():
        file_evidence["status"] = "FAILED_FILE_NOT_FOUND"
        return file_evidence, parsed

    try:
        st = path.stat()
        file_evidence["size_bytes"] = st.st_size
        file_evidence["filesystem_modified_at"] = datetime.fromtimestamp(st.st_mtime, tz=timezone.utc).isoformat()
    except Exception as exc:
        file_evidence["status"] = "FAILED_STAT"
        file_evidence["error"] = str(exc)
        return file_evidence, parsed

    try:
        file_evidence["sha256"] = sha256_file(path)
    except Exception as exc:
        file_evidence["sha256_error"] = str(exc)

    fmt = detect_format(path)
    file_evidence.update(fmt)
    format_detected = file_evidence.get("format_detected", "UNKNOWN")

    try:
        if format_detected == "JSON":
            kind, parsed = process_json_file(path, source_id, evidence_id)
            file_evidence["content_kind"] = kind
            file_evidence["status"] = "SUCCEEDED"
        elif format_detected == "CSV":
            kind, parsed = process_csv_file(path, source_id, evidence_id)
            file_evidence["content_kind"] = kind
            file_evidence["status"] = "SUCCEEDED"
        elif format_detected == "TEXT":
            kind, parsed = process_text_file(path, source_id, evidence_id)
            file_evidence["content_kind"] = kind
            file_evidence["status"] = "SUCCEEDED"
        elif format_detected == "BINARY_ARTIFACT":
            file_evidence["content_kind"] = "BINARY_ARTIFACT_METADATA_ONLY"
            file_evidence["status"] = "PARTIAL_BINARY_METADATA_ONLY"
            file_evidence["reason"] = (
                "Binary artifact detected. This planning panel preserves hash/metadata only. "
                "It does not execute, unpack, modify, reverse-engineer, fuzz, or deeply parse binary artifacts."
            )
        else:
            file_evidence["content_kind"] = "UNKNOWN_OR_UNSUPPORTED"
            file_evidence["status"] = "UNSUPPORTED_FORMAT"
    except Exception as exc:
        file_evidence["status"] = "PARTIAL_OR_FAILED"
        file_evidence["error"] = f"{exc.__class__.__name__}: {exc}"

    file_evidence["parsed_actor_label_count"] = len(parsed.get("actor_labels", []))
    file_evidence["parsed_campaign_count"] = len(parsed.get("campaigns", []))
    file_evidence["parsed_intrusion_set_count"] = len(parsed.get("intrusion_sets", []))
    file_evidence["parsed_ttp_count"] = len(parsed.get("ttps", []))
    file_evidence["parsed_procedure_count"] = len(parsed.get("procedures", []))
    file_evidence["parsed_victimology_count"] = len(parsed.get("victimology", []))
    file_evidence["parsed_infrastructure_count"] = len(parsed.get("infrastructure_links", []))

    return file_evidence, parsed


def aggregate_parsed(parsed_list: List[Dict[str, Any]]) -> Dict[str, Any]:
    agg = empty_parsed()
    for p in parsed_list:
        for key in agg.keys():
            if isinstance(agg[key], list) and isinstance(p.get(key), list):
                agg[key].extend(p[key])
        for key in agg.keys():
            if isinstance(agg[key], list):
                agg[key] = agg[key][:200000]
    return agg


def new_profile(namespace: str, provider: Optional[str] = None, display: Optional[str] = None) -> Dict[str, Any]:
    return {
        "namespace": namespace,
        "provider": provider,
        "display_label": display or namespace,
        "aliases": set(),
        "campaigns": set(),
        "operations": set(),
        "intrusion_sets": set(),
        "malware": set(),
        "tools": set(),
        "infrastructure": set(),
        "vulnerabilities": set(),
        "ttps": set(),
        "procedures": set(),
        "sectors": set(),
        "countries": set(),
        "regions": set(),
        "victims": set(),
        "source_ids": set(),
        "date_values": [],
        "sponsorship_claims": [],
        "objective_claims": [],
        "motivation_claims": [],
        "personas": set(),
        "handles": set(),
        "source_claims": [],
    }


def ensure_profile(profiles: Dict[str, Dict[str, Any]], namespace: Any, provider: Optional[str] = None) -> Optional[Dict[str, Any]]:
    ns = str(namespace or "").strip()
    if not ns:
        return None
    if ns not in profiles:
        profiles[ns] = new_profile(ns, provider)
    return profiles[ns]


def add_to_profile(profile: Dict[str, Any], field: str, value: Any) -> None:
    if value in (None, ""):
        return
    s = redact_secrets(str(value))[0].strip()
    if s:
        profile[field].add(s[:200])


def add_date_values(profile: Dict[str, Any], temporal: Optional[Dict[str, Any]]) -> None:
    if not temporal:
        return
    for v in temporal.values():
        if v:
            profile["date_values"].append(str(v))


def build_actor_profiles(parsed: Dict[str, Any]) -> List[Dict[str, Any]]:
    profiles: Dict[str, Dict[str, Any]] = {}

    for lab in parsed.get("actor_labels", []):
        ns = lab.get("namespace") or lab.get("display_label")
        p = ensure_profile(profiles, ns, lab.get("provider"))
        if not p:
            continue
        p["display_label"] = lab.get("display_label") or p["display_label"]
        for al in lab.get("aliases", []):
            add_to_profile(p, "aliases", al)
        add_to_profile(p, "source_ids", lab.get("source_id"))
        add_date_values(p, lab.get("temporal"))

    for rec in parsed.get("intrusion_sets", []):
        ns = rec.get("namespace") or rec.get("label")
        p = ensure_profile(profiles, ns, rec.get("provider"))
        if p:
            add_to_profile(p, "intrusion_sets", rec.get("label"))
            add_to_profile(p, "source_ids", rec.get("source_id"))
            add_date_values(p, rec.get("temporal"))
            for c in rec.get("campaigns", []):
                add_to_profile(p, "campaigns", c)
            for m in rec.get("malware", []):
                add_to_profile(p, "malware", m)
            for t in rec.get("ttps", []):
                add_to_profile(p, "ttps", t)
            for i in rec.get("infrastructure", []):
                add_to_profile(p, "infrastructure", i)

    for rec in parsed.get("campaigns", []):
        for al in rec.get("actor_labels", []):
            p = ensure_profile(profiles, al)
            if p:
                add_to_profile(p, "campaigns", rec.get("name"))
                add_to_profile(p, "source_ids", rec.get("source_id"))
                add_date_values(p, rec.get("temporal"))
                for m in rec.get("malware", []):
                    add_to_profile(p, "malware", m)
                for t in rec.get("tools", []):
                    add_to_profile(p, "tools", t)
                for i in rec.get("infrastructure", []):
                    add_to_profile(p, "infrastructure", i)
                for v in rec.get("vulnerabilities", []):
                    add_to_profile(p, "vulnerabilities", v)
                for ttp in rec.get("ttps", []):
                    add_to_profile(p, "ttps", ttp)
                for proc in rec.get("procedures", []):
                    add_to_profile(p, "procedures", proc)
                for s in rec.get("sectors", []):
                    add_to_profile(p, "sectors", s)
                for c in rec.get("countries", []):
                    add_to_profile(p, "countries", c)
                for r in rec.get("regions", []):
                    add_to_profile(p, "regions", r)
                for v in rec.get("victims", []):
                    add_to_profile(p, "victims", v)

    for rec in parsed.get("operations", []):
        for al in rec.get("actor_labels", []):
            p = ensure_profile(profiles, al)
            if p:
                add_to_profile(p, "operations", rec.get("name"))
                add_to_profile(p, "source_ids", rec.get("source_id"))
                add_date_values(p, rec.get("temporal"))

    for rec in parsed.get("malware_links", []):
        p = ensure_profile(profiles, rec.get("actor_label"))
        if p:
            add_to_profile(p, "malware", rec.get("malware_family"))
            add_to_profile(p, "malware", rec.get("variant"))
            add_to_profile(p, "source_ids", rec.get("source_id"))
            add_date_values(p, rec.get("temporal"))

    for rec in parsed.get("tool_links", []):
        p = ensure_profile(profiles, rec.get("actor_label"))
        if p:
            add_to_profile(p, "tools", rec.get("tool"))
            add_to_profile(p, "source_ids", rec.get("source_id"))
            add_date_values(p, rec.get("temporal"))

    for rec in parsed.get("infrastructure_links", []):
        p = ensure_profile(profiles, rec.get("actor_label"))
        if p:
            for key in ["domain", "ip", "url", "certificate", "asn"]:
                add_to_profile(p, "infrastructure", rec.get(key))
            add_to_profile(p, "source_ids", rec.get("source_id"))
            add_date_values(p, rec.get("temporal"))

    for rec in parsed.get("vulnerability_links", []):
        p = ensure_profile(profiles, rec.get("actor_label"))
        if p:
            add_to_profile(p, "vulnerabilities", rec.get("cve"))
            add_to_profile(p, "source_ids", rec.get("source_id"))
            add_date_values(p, rec.get("temporal"))

    for rec in parsed.get("ttps", []):
        p = ensure_profile(profiles, rec.get("actor_label"))
        if p:
            add_to_profile(p, "ttps", rec.get("technique"))
            add_to_profile(p, "ttps", rec.get("subtechnique"))
            add_to_profile(p, "procedures", rec.get("procedure"))
            add_to_profile(p, "source_ids", rec.get("source_id"))
            add_date_values(p, rec.get("temporal"))

    for rec in parsed.get("procedures", []):
        p = ensure_profile(profiles, rec.get("actor_label"))
        if p:
            add_to_profile(p, "procedures", rec.get("description"))
            add_to_profile(p, "source_ids", rec.get("source_id"))
            add_date_values(p, rec.get("temporal"))

    for rec in parsed.get("victimology", []):
        p = ensure_profile(profiles, rec.get("actor_label"))
        if p:
            add_to_profile(p, "sectors", rec.get("sector"))
            add_to_profile(p, "countries", rec.get("country"))
            add_to_profile(p, "regions", rec.get("region"))
            add_to_profile(p, "victims", rec.get("victim"))
            add_to_profile(p, "source_ids", rec.get("source_id"))
            add_date_values(p, rec.get("temporal"))

    for rec in parsed.get("source_claims", []):
        p = ensure_profile(profiles, rec.get("actor_label"))
        if p:
            p["source_claims"].append(rec)
            add_to_profile(p, "source_ids", rec.get("source_id"))
            add_date_values(p, rec.get("temporal"))

    for rec in parsed.get("sponsorships", []):
        p = ensure_profile(profiles, rec.get("actor_label"))
        if p:
            p["sponsorship_claims"].append(rec)
            add_to_profile(p, "source_ids", rec.get("source_id"))
            add_date_values(p, rec.get("temporal"))

    for rec in parsed.get("objectives", []):
        p = ensure_profile(profiles, rec.get("actor_label"))
        if p:
            p["objective_claims"].append(rec)
            add_to_profile(p, "source_ids", rec.get("source_id"))

    for rec in parsed.get("motivations", []):
        p = ensure_profile(profiles, rec.get("actor_label"))
        if p:
            p["motivation_claims"].append(rec)
            add_to_profile(p, "source_ids", rec.get("source_id"))

    for rec in parsed.get("personas", []):
        p = ensure_profile(profiles, rec.get("actor_label"))
        if p:
            add_to_profile(p, "personas", rec.get("name"))
            add_to_profile(p, "source_ids", rec.get("source_id"))

    for rec in parsed.get("handles", []):
        p = ensure_profile(profiles, rec.get("actor_label"))
        if p:
            add_to_profile(p, "handles", rec.get("handle"))
            add_to_profile(p, "source_ids", rec.get("source_id"))

    out: List[Dict[str, Any]] = []
    for p in profiles.values():
        dates = [parse_datetime(x) for x in p.get("date_values", [])]
        dates = [d for d in dates if d]
        first_seen = min(dates).isoformat() if dates else None
        last_seen = max(dates).isoformat() if dates else None

        finalized: Dict[str, Any] = {}
        for k, v in p.items():
            if isinstance(v, set):
                finalized[k] = sorted(v)
            else:
                finalized[k] = v

        finalized["first_seen"] = first_seen
        finalized["last_seen"] = last_seen
        finalized["source_count"] = len(finalized.get("source_ids", []))
        finalized["state"] = "SOURCE_OBSERVED_ACTOR_LABEL_PROFILE"
        finalized["limitations"] = [
            "Actor label profile is source-observed and analytical, not verified real-world identity.",
            "Provider namespace preserved; label may represent only a provider cluster.",
            "Source independence and upstream pedigree remain unresolved without further evidence.",
        ]
        out.append(finalized)

    out.sort(key=lambda x: str(x.get("namespace", "")))
    return out


def temporal_overlap(a: Dict[str, Any], b: Dict[str, Any]) -> Optional[bool]:
    a1 = parse_datetime(a.get("first_seen"))
    a2 = parse_datetime(a.get("last_seen"))
    b1 = parse_datetime(b.get("first_seen"))
    b2 = parse_datetime(b.get("last_seen"))

    if not all([a1, a2, b1, b2]):
        return None

    start = max(a1, b1)
    end = min(a2, b2)
    return start <= end


def intersect(a: List[str], b: List[str]) -> List[str]:
    return sorted(set(a or []) & set(b or []))


def build_alias_resolution(profiles: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    pairs: List[Dict[str, Any]] = []

    for i in range(len(profiles)):
        for j in range(i + 1, len(profiles)):
            a = profiles[i]
            b = profiles[j]

            a_core = label_core(a.get("namespace"))
            b_core = label_core(b.get("namespace"))
            core_same = bool(a_core and a_core == b_core)

            explicit_alias = (
                b.get("namespace") in a.get("aliases", [])
                or a.get("namespace") in b.get("aliases", [])
                or b_core in {label_core(x) for x in a.get("aliases", [])}
                or a_core in {label_core(x) for x in b.get("aliases", [])}
            )

            shared_campaigns = intersect(a.get("campaigns", []), b.get("campaigns", []))
            shared_malware = intersect(a.get("malware", []), b.get("malware", []))
            shared_tools = intersect(a.get("tools", []), b.get("tools", []))
            shared_infra = intersect(a.get("infrastructure", []), b.get("infrastructure", []))
            shared_vulns = intersect(a.get("vulnerabilities", []), b.get("vulnerabilities", []))
            shared_ttps = intersect(a.get("ttps", []), b.get("ttps", []))
            shared_procs = intersect(a.get("procedures", []), b.get("procedures", []))
            shared_sectors = intersect(a.get("sectors", []), b.get("sectors", []))
            shared_countries = intersect(a.get("countries", []), b.get("countries", []))
            shared_regions = intersect(a.get("regions", []), b.get("regions", []))
            shared_victims = intersect(a.get("victims", []), b.get("victims", []))

            generic_ttps = [t for t in shared_ttps if str(t).split(".")[0].upper() in GENERIC_TTPS]
            discriminating_ttps = [t for t in shared_ttps if t not in generic_ttps]

            overlap = temporal_overlap(a, b)

            score = 0
            supporting: List[str] = []
            weak: List[str] = []

            if explicit_alias:
                score += 50
                supporting.append("Explicit alias/cross-reference observed in source metadata.")
            elif core_same:
                score += 30
                supporting.append("Identical label string appears across different provider namespaces.")
                weak.append("Same label string may reflect shared naming convention, not verified alias.")

            if shared_procs:
                score += min(40, len(shared_procs) * 20)
                supporting.append(f"Procedure overlap: {len(shared_procs)} shared procedure candidate(s).")

            if shared_malware:
                score += min(20, len(shared_malware) * 10)
                supporting.append(f"Shared malware/variant candidates: {len(shared_malware)}.")
                weak.append("Commodity malware/shared tooling may explain overlap without same actor.")

            if shared_tools:
                score += min(10, len(shared_tools) * 5)
                supporting.append(f"Shared tool candidates: {len(shared_tools)}.")
                weak.append("Dual-use/administrative tools are weak actor evidence.")

            if shared_infra:
                score += min(15, len(shared_infra) * 5)
                supporting.append(f"Shared infrastructure candidates: {len(shared_infra)}.")
                weak.append("Infrastructure may be leased, compromised, cloud, CDN, VPN, shared, or reassigned.")

            if shared_campaigns:
                score += min(15, len(shared_campaigns) * 5)
                supporting.append(f"Shared campaign candidates: {len(shared_campaigns)}.")

            if discriminating_ttps:
                score += min(15, len(discriminating_ttps) * 5)
                supporting.append(f"Discriminating TTP overlap: {len(discriminating_ttps)}.")

            if generic_ttps:
                score += min(5, len(generic_ttps) * 1)
                weak.append(f"Generic TTP overlap: {len(generic_ttps)}. Generic TTPs are weak attribution evidence.")

            victim_shared = len(shared_sectors) + len(shared_countries) + len(shared_regions) + len(shared_victims)
            if victim_shared:
                score += min(10, victim_shared * 2)
                supporting.append(f"Victimology overlap candidates: {victim_shared}.")
                weak.append("Victimology overlap may reflect prevalence, opportunistic impact, disclosure bias, or coincidence.")

            if shared_vulns:
                weak.append("Shared CVE exploitation is usually weak actor-attribution evidence.")

            if overlap is True:
                score += 5
                supporting.append("Temporal windows overlap.")
            elif overlap is False:
                score -= 10
                weak.append("Temporal windows do not overlap.")
            else:
                weak.append("Temporal alignment unresolved.")

            if score >= 70 and (explicit_alias or len(shared_procs) >= 2):
                state = "PROBABLE_ALIAS"
            elif score >= 45:
                state = "POSSIBLE_ALIAS"
            elif score >= 25:
                state = "OVERLAPPING_CLUSTER"
            else:
                state = "UNRESOLVED"

            pairs.append({
                "alias_pair_id": f"ALP-{uuid.uuid4()}",
                "label_a": a.get("namespace"),
                "label_b": b.get("namespace"),
                "state": state,
                "score": score,
                "explicit_alias": explicit_alias,
                "core_same": core_same,
                "shared_campaigns": shared_campaigns[:50],
                "shared_malware": shared_malware[:50],
                "shared_tools": shared_tools[:50],
                "shared_infrastructure": shared_infra[:50],
                "shared_vulnerabilities": shared_vulns[:50],
                "shared_ttps": shared_ttps[:50],
                "shared_procedures": shared_procs[:50],
                "shared_generic_ttps": generic_ttps[:50],
                "shared_discriminating_ttps": discriminating_ttps[:50],
                "shared_sectors": shared_sectors[:50],
                "shared_countries": shared_countries[:50],
                "shared_regions": shared_regions[:50],
                "shared_victims": shared_victims[:50],
                "temporal_overlap": overlap,
                "supporting_evidence": supporting[:50],
                "weak_or_alternative_explanations": weak[:50],
                "limitations": [
                    "Alias resolution is analytical and source-dependent.",
                    "Actor label does not equal real-world actor, organization, or person.",
                    "Source independence remains unresolved unless upstream pedigree is verified.",
                ],
            })

    pairs.sort(key=lambda x: (-int(x.get("score", 0)), str(x.get("label_a", "")), str(x.get("label_b", ""))))
    return pairs[:5000]


def build_canonical_candidates(profiles: List[Dict[str, Any]], alias_pairs: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    parent = {p["namespace"]: p["namespace"] for p in profiles}

    def find(x: str) -> str:
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x

    def union(a: str, b: str) -> None:
        ra, rb = find(a), find(b)
        if ra != rb:
            parent[rb] = ra

    for pair in alias_pairs:
        if pair.get("state") == "PROBABLE_ALIAS" or (pair.get("state") == "POSSIBLE_ALIAS" and pair.get("explicit_alias")):
            la = pair.get("label_a")
            lb = pair.get("label_b")
            if la in parent and lb in parent:
                union(la, lb)

    groups: Dict[str, List[str]] = defaultdict(list)
    for p in profiles:
        groups[find(p["namespace"])].append(p["namespace"])

    profile_by_ns = {p["namespace"]: p for p in profiles}
    candidates: List[Dict[str, Any]] = []

    for root, members in groups.items():
        member_profiles = [profile_by_ns[m] for m in members if m in profile_by_ns]
        if len(members) > 1:
            state = "PROBABLE_ALIAS_CLUSTER"
            confidence = "MODERATE_PENDING_INDEPENDENCE"
        else:
            state = "UNRESOLVED_SINGLE_LABEL"
            confidence = "LOW"

        candidates.append({
            "canonical_candidate_id": f"CAC-{uuid.uuid4()}",
            "root_label": root,
            "member_labels": sorted(members),
            "state": state,
            "confidence": confidence,
            "providers": sorted({p.get("provider") for p in member_profiles if p.get("provider")}),
            "campaigns": sorted({c for p in member_profiles for c in p.get("campaigns", [])}),
            "malware": sorted({m for p in member_profiles for m in p.get("malware", [])}),
            "infrastructure": sorted({i for p in member_profiles for i in p.get("infrastructure", [])})[:200],
            "ttps": sorted({t for p in member_profiles for t in p.get("ttps", [])})[:200],
            "procedures": sorted({x for p in member_profiles for x in p.get("procedures", [])})[:200],
            "sectors": sorted({s for p in member_profiles for s in p.get("sectors", [])}),
            "countries": sorted({c for p in member_profiles for c in p.get("countries", [])}),
            "regions": sorted({r for p in member_profiles for r in p.get("regions", [])}),
            "source_count": len({sid for p in member_profiles for sid in p.get("source_ids", [])}),
            "limitations": [
                "Canonical candidate is an analytical cluster, not verified real-world identity.",
                "Member labels may remain distinct under different provider taxonomies.",
                "Source independence and upstream pedigree remain unresolved.",
            ],
        })

    candidates.sort(key=lambda x: (-len(x.get("member_labels", [])), str(x.get("root_label", ""))))
    return candidates[:5000]


def build_campaign_profiles(parsed: Dict[str, Any]) -> List[Dict[str, Any]]:
    by_name: Dict[str, Dict[str, Any]] = defaultdict(lambda: {
        "name": "",
        "aliases": set(),
        "actor_labels": set(),
        "malware": set(),
        "tools": set(),
        "infrastructure": set(),
        "vulnerabilities": set(),
        "ttps": set(),
        "procedures": set(),
        "sectors": set(),
        "countries": set(),
        "regions": set(),
        "victims": set(),
        "source_ids": set(),
        "date_values": [],
        "start_time": None,
        "end_time": None,
    })

    for c in parsed.get("campaigns", []):
        key = normalize_text(c.get("name"))
        if not key:
            continue
        cp = by_name[key]
        cp["name"] = c.get("name")
        for a in c.get("aliases", []):
            cp["aliases"].add(str(a))
        for al in c.get("actor_labels", []):
            cp["actor_labels"].add(str(al))
        for m in c.get("malware", []):
            cp["malware"].add(str(m))
        for t in c.get("tools", []):
            cp["tools"].add(str(t))
        for i in c.get("infrastructure", []):
            cp["infrastructure"].add(str(i))
        for v in c.get("vulnerabilities", []):
            cp["vulnerabilities"].add(str(v))
        for t in c.get("ttps", []):
            cp["ttps"].add(str(t))
        for p in c.get("procedures", []):
            cp["procedures"].add(str(p))
        for s in c.get("sectors", []):
            cp["sectors"].add(str(s))
        for co in c.get("countries", []):
            cp["countries"].add(str(co))
        for r in c.get("regions", []):
            cp["regions"].add(str(r))
        for v in c.get("victims", []):
            cp["victims"].add(str(v))
        if c.get("source_id"):
            cp["source_ids"].add(str(c.get("source_id")))
        if c.get("start_time"):
            cp["start_time"] = c.get("start_time")
            cp["date_values"].append(str(c.get("start_time")))
        if c.get("end_time"):
            cp["end_time"] = c.get("end_time")
            cp["date_values"].append(str(c.get("end_time")))
        add_date_values(cp, c.get("temporal"))

    out: List[Dict[str, Any]] = []
    for cp in by_name.values():
        dates = [parse_datetime(x) for x in cp.get("date_values", [])]
        dates = [d for d in dates if d]
        finalized: Dict[str, Any] = {}
        for k, v in cp.items():
            finalized[k] = sorted(v) if isinstance(v, set) else v
        finalized["first_seen"] = min(dates).isoformat() if dates else None
        finalized["last_seen"] = max(dates).isoformat() if dates else None
        finalized["source_count"] = len(finalized.get("source_ids", []))
        finalized["state"] = "SOURCE_REPORTED_CAMPAIGN_PROFILE"
        finalized["limitations"] = [
            "Campaign profile is source-reported and may be incomplete, overlapping, or differently scoped by providers.",
            "Campaign does not automatically equal actor, operation, or intrusion set.",
        ]
        out.append(finalized)

    out.sort(key=lambda x: str(x.get("name", "")))
    return out


def build_campaign_resolution(campaign_profiles: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    pairs: List[Dict[str, Any]] = []

    for i in range(len(campaign_profiles)):
        for j in range(i + 1, len(campaign_profiles)):
            a = campaign_profiles[i]
            b = campaign_profiles[j]

            explicit_alias = (
                b.get("name") in a.get("aliases", [])
                or a.get("name") in b.get("aliases", [])
                or normalize_text(a.get("name")) == normalize_text(b.get("name"))
            )

            shared_procs = intersect(a.get("procedures", []), b.get("procedures", []))
            shared_malware = intersect(a.get("malware", []), b.get("malware", []))
            shared_infra = intersect(a.get("infrastructure", []), b.get("infrastructure", []))
            shared_ttps = intersect(a.get("ttps", []), b.get("ttps", []))
            shared_sectors = intersect(a.get("sectors", []), b.get("sectors", []))
            shared_regions = intersect(a.get("regions", []), b.get("regions", []))
            shared_victims = intersect(a.get("victims", []), b.get("victims", []))

            a1 = parse_datetime(a.get("first_seen"))
            a2 = parse_datetime(a.get("last_seen"))
            b1 = parse_datetime(b.get("first_seen"))
            b2 = parse_datetime(b.get("last_seen"))
            overlap = None
            if all([a1, a2, b1, b2]):
                overlap = max(a1, b1) <= min(a2, b2)

            score = 0
            if explicit_alias:
                score += 50
            if shared_procs:
                score += min(40, len(shared_procs) * 20)
            if shared_malware:
                score += min(20, len(shared_malware) * 10)
            if shared_infra:
                score += min(15, len(shared_infra) * 5)
            if shared_ttps:
                score += min(10, len(shared_ttps) * 2)
            if shared_sectors or shared_regions or shared_victims:
                score += min(10, (len(shared_sectors) + len(shared_regions) + len(shared_victims)) * 2)
            if overlap is True:
                score += 5
            elif overlap is False:
                score -= 10

            if score >= 70 and (explicit_alias or len(shared_procs) >= 2):
                state = "PROBABLE_SAME"
            elif score >= 45:
                state = "POSSIBLE_SAME"
            elif score >= 25:
                state = "OVERLAPPING"
            else:
                state = "UNRESOLVED"

            pairs.append({
                "campaign_pair_id": f"CRP-{uuid.uuid4()}",
                "campaign_a": a.get("name"),
                "campaign_b": b.get("name"),
                "state": state,
                "score": score,
                "shared_procedures": shared_procs[:50],
                "shared_malware": shared_malware[:50],
                "shared_infrastructure": shared_infra[:50],
                "shared_ttps": shared_ttps[:50],
                "temporal_overlap": overlap,
                "limitations": [
                    "Campaign resolution is analytical and source-dependent.",
                    "Different providers may split or merge campaign activity differently.",
                ],
            })

    pairs.sort(key=lambda x: (-int(x.get("score", 0)), str(x.get("campaign_a", ""))))
    return pairs[:5000]


def build_ttp_summary(parsed: Dict[str, Any]) -> Dict[str, Any]:
    tech_counter: Counter = Counter()
    proc_counter: Counter = Counter()
    generic: List[str] = []
    discriminating: List[str] = []

    for t in parsed.get("ttps", []):
        tech = t.get("technique")
        if tech:
            tech_counter[tech] += 1
            base = str(tech).split(".")[0].upper()
            if base in GENERIC_TTPS:
                if tech not in generic:
                    generic.append(tech)
            else:
                if tech not in discriminating:
                    discriminating.append(tech)

    for p in parsed.get("procedures", []):
        desc = p.get("description")
        if desc:
            proc_counter[desc] += 1

    return {
        "technique_counts": dict(tech_counter.most_common(500)),
        "generic_ttps": sorted(generic)[:500],
        "discriminating_ttps": sorted(discriminating)[:500],
        "procedure_counts": dict(proc_counter.most_common(500)),
        "limitations": [
            "Generic TTPs are weak actor-attribution evidence.",
            "Procedure-level evidence is more discriminating but still requires corroboration.",
            "ATT&CK version and source scope must be preserved.",
        ],
    }


def build_victimology_summary(parsed: Dict[str, Any]) -> Dict[str, Any]:
    sectors = Counter(str(x.get("sector")).strip() for x in parsed.get("sectors", []) if x.get("sector"))
    countries = Counter(str(x.get("country")).strip() for x in parsed.get("countries", []) if x.get("country"))
    regions = Counter(str(x.get("region")).strip() for x in parsed.get("regions", []) if x.get("region"))
    victims = Counter(str(x.get("victim")).strip() for x in parsed.get("victimology", []) if x.get("victim"))

    return {
        "sector_counts": dict(sectors.most_common(500)),
        "country_counts": dict(countries.most_common(500)),
        "region_counts": dict(regions.most_common(500)),
        "victim_counts": dict(victims.most_common(500)),
        "limitations": [
            "Victim lists are visibility-biased and not complete targeting pictures.",
            "Sector prevalence may be opportunistic impact rather than deliberate targeting.",
            "Do not infer attacker nationality from victim geography.",
        ],
    }


def build_attribution_assessment(profiles: List[Dict[str, Any]], alias_pairs: List[Dict[str, Any]], parsed: Dict[str, Any]) -> List[Dict[str, Any]]:
    alias_by_label: Dict[str, List[Dict[str, Any]]] = defaultdict(list)
    for pair in alias_pairs:
        alias_by_label[pair.get("label_a", "")].append(pair)
        alias_by_label[pair.get("label_b", "")].append(pair)

    assessments: List[Dict[str, Any]] = []

    for p in profiles:
        ns = p.get("namespace")
        pair_states = [x.get("state") for x in alias_by_label.get(ns, [])]

        if "PROBABLE_ALIAS" in pair_states:
            actor_label_match_confidence = "MODERATE"
        elif "POSSIBLE_ALIAS" in pair_states or "OVERLAPPING_CLUSTER" in pair_states:
            actor_label_match_confidence = "LOW"
        else:
            actor_label_match_confidence = "UNKNOWN"

        source_count = int(p.get("source_count", 0))
        if source_count <= 1:
            source_independence = "SINGLE_SOURCE"
        else:
            source_independence = "MULTIPLE_SOURCES_PENDING_INDEPENDENCE"

        sponsor_count = len(p.get("sponsorship_claims", []))
        if sponsor_count:
            if source_count >= 2:
                sponsorship_state = "MULTI_SOURCE_STATE_LINK_PENDING_INDEPENDENCE"
            else:
                sponsorship_state = "SOURCE_ALLEGED_STATE_LINK"
        else:
            sponsorship_state = "UNSUPPORTED"

        assessments.append({
            "assessment_id": f"ATR-{uuid.uuid4()}",
            "actor_label": ns,
            "campaign_cluster_confidence": "MODERATE_PENDING_INDEPENDENCE" if p.get("campaigns") and source_count > 1 else "LOW",
            "intrusion_set_confidence": "LOW" if p.get("intrusion_sets") else "UNKNOWN",
            "actor_label_match_confidence": actor_label_match_confidence,
            "provider_alias_confidence": "MODERATE" if any(x.get("explicit_alias") for x in alias_by_label.get(ns, [])) else "LOW",
            "real_world_organization_confidence": "INCONCLUSIVE",
            "state_sponsorship_confidence": sponsorship_state,
            "person_identity_confidence": "UNSUPPORTED",
            "source_count": source_count,
            "source_independence": source_independence,
            "limitations": [
                "Real-world organization attribution requires high evidentiary threshold and human review.",
                "Real-person attribution is unsupported by this panel.",
                "State sponsorship is high-consequence and must not be casual.",
                "Source independence remains unresolved without upstream pedigree review.",
            ],
        })

    return assessments[:5000]


def build_contradictions(parsed: Dict[str, Any], profiles: List[Dict[str, Any]], alias_pairs: List[Dict[str, Any]], campaign_profiles: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    contradictions: List[Dict[str, Any]] = []

    alias_pair_by_labels = {
        (pair.get("label_a"), pair.get("label_b")): pair
        for pair in alias_pairs
    }

    for cp in campaign_profiles:
        labels = cp.get("actor_labels", [])
        if len(labels) > 1:
            probable = False
            for i in range(len(labels)):
                for j in range(i + 1, len(labels)):
                    pair = alias_pair_by_labels.get((labels[i], labels[j])) or alias_pair_by_labels.get((labels[j], labels[i]))
                    if pair and pair.get("state") == "PROBABLE_ALIAS":
                        probable = True
            if not probable:
                contradictions.append({
                    "contradiction_id": f"CON-{uuid.uuid4()}",
                    "type": "PROVIDER_TAXONOMY_CONFLICT",
                    "subject": cp.get("name"),
                    "values": labels[:100],
                    "possible_explanations": [
                        "different providers split/merge activity differently",
                        "campaign name reused",
                        "shared commodity tooling",
                        "shared infrastructure provider",
                        "access broker/affiliate structure",
                        "source dependence",
                    ],
                    "resolution_status": "UNRESOLVED",
                    "caution": "Do not force one universal actor taxonomy or collapse campaign to single actor without evidence.",
                })

    for p in profiles:
        first_dt = parse_datetime(p.get("first_seen"))
        last_dt = parse_datetime(p.get("last_seen"))
        if first_dt and last_dt and first_dt > last_dt:
            contradictions.append({
                "contradiction_id": f"CON-{uuid.uuid4()}",
                "type": "TIMELINE_CONFLICT",
                "subject": p.get("namespace"),
                "values": [p.get("first_seen"), p.get("last_seen")],
                "possible_explanations": [
                    "source date error",
                    "timezone parsing issue",
                    "mixed campaign windows",
                    "historical vs current reporting",
                ],
                "resolution_status": "UNRESOLVED",
                "caution": "Do not treat inconsistent timeline as reliable operational tempo.",
            })

    for pair in alias_pairs:
        if pair.get("state") in {"POSSIBLE_ALIAS", "OVERLAPPING_CLUSTER", "UNRESOLVED"}:
            if pair.get("shared_infrastructure") and not pair.get("shared_procedures") and not pair.get("shared_malware") and not pair.get("shared_campaigns"):
                contradictions.append({
                    "contradiction_id": f"CON-{uuid.uuid4()}",
                    "type": "INFRASTRUCTURE_ONLY_CORRELATION_CAUTION",
                    "subject": f"{pair.get('label_a')} vs {pair.get('label_b')}",
                    "values": pair.get("shared_infrastructure", [])[:50],
                    "possible_explanations": [
                        "shared cloud/CDN/VPN/hosting provider",
                        "compromised infrastructure",
                        "leased infrastructure",
                        "reassigned IP/domain",
                        "sinkhole/seizure",
                    ],
                    "resolution_status": "UNRESOLVED",
                    "caution": "Infrastructure overlap alone is weak actor-attribution evidence.",
                })

    contradictions, _ = truncate_list(contradictions, 5000)
    return contradictions


def build_hypotheses(parsed: Dict[str, Any], profiles: List[Dict[str, Any]], alias_pairs: List[Dict[str, Any]], campaign_profiles: List[Dict[str, Any]], contradictions: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    hyps: List[Dict[str, Any]] = []

    if not profiles and not campaign_profiles:
        hyps.append({
            "hypothesis_id": f"HYP-{uuid.uuid4()}",
            "statement": "Current local deterministic evidence is insufficient to establish actor-label relationships, campaign clustering, TTP/procedure similarity, victimology, or attribution confidence.",
            "supporting_facts": ["No actor labels or campaign profiles parsed."],
            "opposing_facts": [],
            "assumptions": ["Evidence may be missing, unsupported, binary-only, or unavailable."],
            "unknowns": ["actor labels", "provider namespaces", "campaigns", "intrusion sets", "TTPs", "procedures", "victimology", "infrastructure", "source independence"],
            "falsification_conditions": ["New authorized/public threat reports, STIX/TAXII/MISP exports, or incident evidence changes assessment."],
            "next_test": "Attach threat/actor/campaign/TTP/victimology/infrastructure reports or configure connectors.",
            "status": "OPEN",
        })
        return hyps[:1000]

    for pair in alias_pairs[:50]:
        if pair.get("state") in {"PROBABLE_ALIAS", "POSSIBLE_ALIAS", "OVERLAPPING_CLUSTER"}:
            hyps.extend([
                {
                    "hypothesis_id": f"HYP-{uuid.uuid4()}",
                    "statement": f"{pair.get('label_a')} and {pair.get('label_b')} may refer to the same or overlapping actor cluster.",
                    "supporting_facts": pair.get("supporting_evidence", [])[:20],
                    "opposing_facts": pair.get("weak_or_alternative_explanations", [])[:20],
                    "assumptions": ["Source labels refer to comparable activity windows and scopes."],
                    "unknowns": ["source independence", "upstream incident pedigree", "procedure uniqueness", "infrastructure control era"],
                    "falsification_conditions": [
                        "Overlap explained by commodity malware/shared tooling.",
                        "Infrastructure shared/leased/compromised/reassigned.",
                        "Provider taxonomy differs without behavioral overlap.",
                        "Temporal windows do not overlap.",
                    ],
                    "next_test": "Compare procedure-level evidence and seek independent source rather than additional generic IOC overlap.",
                    "status": "OPEN",
                },
                {
                    "hypothesis_id": f"HYP-{uuid.uuid4()}",
                    "statement": f"{pair.get('label_a')} and {pair.get('label_b')} may remain distinct clusters despite observed overlap.",
                    "supporting_facts": pair.get("weak_or_alternative_explanations", [])[:20],
                    "opposing_facts": pair.get("supporting_evidence", [])[:20],
                    "unknowns": ["whether overlap is discriminating or generic"],
                    "falsification_conditions": ["Rare procedure/configuration/infrastructure-control evidence independently links them."],
                    "next_test": "Request MALINT similarity, INFRAINT control-era review, and independent CTI source comparison.",
                    "status": "OPEN",
                },
            ])

    for cp in campaign_profiles[:50]:
        if cp.get("actor_labels"):
            hyps.extend([
                {
                    "hypothesis_id": f"HYP-{uuid.uuid4()}",
                    "statement": f"Campaign {cp.get('name')} may be associated with actor label(s): {', '.join(cp.get('actor_labels', [])[:5])}.",
                    "supporting_facts": [f"Source-reported actor labels: {len(cp.get('actor_labels', []))}."],
                    "opposing_facts": ["Campaign may involve multiple teams, affiliates, access brokers, or commodity tooling."],
                    "unknowns": ["campaign boundary", "actor taxonomy", "source independence"],
                    "falsification_conditions": ["Independent evidence shows different actor cluster or unknown actor."],
                    "next_test": "Resolve campaign timeline and compare procedure-level behavior; handoff campaign identity to CTI.",
                    "status": "OPEN",
                },
                {
                    "hypothesis_id": f"HYP-{uuid.uuid4()}",
                    "statement": f"Campaign {cp.get('name')} may be operated by a previously unknown actor cluster or intermediary.",
                    "supporting_facts": ["Provider labels may be incomplete or taxonomy-dependent."],
                    "opposing_facts": [f"Existing source-reported labels: {', '.join(cp.get('actor_labels', [])[:5])}."],
                    "unknowns": ["operator identity", "affiliate structure", "access broker involvement"],
                    "falsification_conditions": ["Strong multi-source procedure/infrastructure/malware linkage to known cluster."],
                    "next_test": "Avoid forcing known actor label; seek independent incident/CTI evidence.",
                    "status": "OPEN",
                },
            ])

    if parsed.get("sponsorships"):
        hyps.append({
            "hypothesis_id": f"HYP-{uuid.uuid4()}",
            "statement": "State-sponsorship claims in current evidence are source-attributed and not independently verified by this panel.",
            "supporting_facts": [f"{len(parsed.get('sponsorships', []))} sponsorship claim(s) parsed."],
            "opposing_facts": ["Sponsorship may reflect provider judgment, false-flag artifacts, shared infrastructure, criminal activity, or source dependence."],
            "unknowns": ["multi-source independence", "primary evidence", "operational control", "human review outcome"],
            "falsification_conditions": ["Independent evidence supports criminal, opportunistic, false-flag, or shared-infrastructure explanation."],
            "next_test": "Route to human review; require strong multi-source evidence and clear source pedigree before consequential state-link language.",
            "status": "OPEN",
        })

    if contradictions:
        hyps.append({
            "hypothesis_id": f"HYP-{uuid.uuid4()}",
            "statement": "Observed actor/campaign/infrastructure contradictions likely reflect provider taxonomy differences, source dependence, shared commodity tooling, infrastructure reuse, or temporal mismatches.",
            "supporting_facts": [f"{len(contradictions)} contradiction candidate(s) detected."],
            "opposing_facts": ["Source error remains possible."],
            "unknowns": ["which claims are independent", "which relationships are discriminating"],
            "falsification_conditions": ["Independent procedure-level and source-pedigree review resolves conflicts."],
            "next_test": "Perform source-independence and ACH-style competing-hypothesis review.",
            "status": "OPEN",
        })

    hyps, _ = truncate_list(hyps, 1000)
    return hyps


def build_ach_matrix(alias_pairs: List[Dict[str, Any]], profiles: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    profile_by_ns = {p.get("namespace"): p for p in profiles}
    matrices: List[Dict[str, Any]] = []

    for pair in alias_pairs[:20]:
        if pair.get("state") == "UNRESOLVED":
            continue

        a = profile_by_ns.get(pair.get("label_a"))
        b = profile_by_ns.get(pair.get("label_b"))
        if not a or not b:
            continue

        hypotheses = [
            "SAME_ACTOR_CLUSTER",
            "DISTINCT_ACTORS",
            "COMMODITY_OR_SHARED_TOOLING",
            "PROVIDER_TAXONOMY_DIFFERENCE",
            "UNKNOWN_OR_BROKER",
        ]

        rows: List[Dict[str, Any]] = []

        def add_row(name: str, values: List[str], diagnosticity: str) -> None:
            rows.append({
                "evidence": name,
                "assessment": dict(zip(hypotheses, values)),
                "diagnosticity": diagnosticity,
            })

        explicit = bool(pair.get("explicit_alias"))
        core_same = bool(pair.get("core_same"))
        add_row(
            "explicit_alias_or_same_label",
            [
                "CONSISTENT" if explicit else "NEUTRAL",
                "INCONSISTENT" if explicit else "NEUTRAL",
                "NEUTRAL",
                "CONSISTENT" if core_same and not explicit else "NEUTRAL",
                "NEUTRAL",
            ],
            "HIGH" if explicit else "LOW",
        )

        procs = pair.get("shared_procedures", [])
        add_row(
            "procedure_overlap",
            [
                "CONSISTENT" if procs else "UNKNOWN",
                "INCONSISTENT" if len(procs) >= 2 else "NEUTRAL",
                "INCONSISTENT" if len(procs) >= 2 else "NEUTRAL",
                "NEUTRAL",
                "NEUTRAL",
            ],
            "HIGH" if procs else "MEDIUM",
        )

        malware = pair.get("shared_malware", [])
        add_row(
            "malware_overlap",
            [
                "CONSISTENT" if malware else "NEUTRAL",
                "NEUTRAL",
                "CONSISTENT" if malware else "NEUTRAL",
                "NEUTRAL",
                "NEUTRAL",
            ],
            "MEDIUM",
        )

        infra = pair.get("shared_infrastructure", [])
        add_row(
            "infrastructure_overlap",
            [
                "CONSISTENT" if infra else "NEUTRAL",
                "NEUTRAL",
                "CONSISTENT" if infra else "NEUTRAL",
                "NEUTRAL",
                "CONSISTENT" if infra else "NEUTRAL",
            ],
            "LOW",
        )

        generic = pair.get("shared_generic_ttps", [])
        add_row(
            "generic_ttp_overlap",
            [
                "NEUTRAL",
                "NEUTRAL",
                "CONSISTENT" if generic else "NEUTRAL",
                "NEUTRAL",
                "NEUTRAL",
            ],
            "LOW",
        )

        overlap = pair.get("temporal_overlap")
        add_row(
            "temporal_alignment",
            [
                "CONSISTENT" if overlap is True else "INCONSISTENT" if overlap is False else "UNKNOWN",
                "CONSISTENT" if overlap is False else "NEUTRAL",
                "NEUTRAL",
                "NEUTRAL",
                "NEUTRAL",
            ],
            "MEDIUM",
        )

        matrices.append({
            "matrix_id": f"ACH-{uuid.uuid4()}",
            "subject": f"{pair.get('label_a')} vs {pair.get('label_b')}",
            "hypotheses": hypotheses,
            "rows": rows,
            "leading_hypothesis": pair.get("state"),
            "limitations": [
                "ACH-style matrix is analytical support, not proof.",
                "One strongly inconsistent diagnostic fact may outweigh many generic similarities.",
                "Source independence must be resolved before treating multiple claims as corroboration.",
            ],
        })

    return matrices[:100]


def build_knowledge_gaps(
    payload: Dict[str, Any],
    files: List[Dict[str, Any]],
    parsed: Dict[str, Any],
    profiles: List[Dict[str, Any]],
    alias_pairs: List[Dict[str, Any]],
    campaign_profiles: List[Dict[str, Any]],
    contradictions: List[Dict[str, Any]],
) -> List[Dict[str, Any]]:
    gaps: List[Dict[str, Any]] = []

    if not files:
        gaps.append({
            "gap_id": f"GAP-{uuid.uuid4()}",
            "question": "What authorized/public threat-actor evidence exists?",
            "missing_evidence": "No local threat report/actor/campaign/TTP/victimology/infrastructure artifact supplied.",
            "likely_source": "Government advisory, vendor CTI, incident report, MITRE ATT&CK, MISP/STIX/TAXII, public research.",
            "specialist_owner": "THREATACTORINT AI Employee",
            "priority": "HIGH",
            "expected_information_value": "Enables actor-label and campaign intelligence planning.",
            "safety_boundary": "Defensive/public/authorized intelligence only. No hacking, contact, doxxing, or private-person tracking.",
        })

    if not profiles:
        gaps.append({
            "gap_id": f"GAP-{uuid.uuid4()}",
            "question": "Which actor labels/provider namespaces are in scope?",
            "missing_evidence": "No actor label profiles parsed.",
            "likely_source": "Vendor CTI reports, government advisories, MITRE intrusion sets, MISP/STIX/TAXII exports.",
            "specialist_owner": "THREATACTORINT AI Employee",
            "priority": "HIGH",
            "expected_information_value": "Establishes provider-namespace label baseline.",
            "safety_boundary": "Do not invent actors or strip provider namespace.",
        })

    if profiles and not parsed.get("procedures"):
        gaps.append({
            "gap_id": f"GAP-{uuid.uuid4()}",
            "question": "Are procedure-level behaviors available rather than only generic TTPs?",
            "missing_evidence": "No procedure records parsed.",
            "likely_source": "Primary incident reports, malware analysis, vendor behavioral reporting, ATT&CK procedures.",
            "specialist_owner": "THREATACTORINT / MALINT / INCIDENTINT",
            "priority": "HIGH_IF_ATTRIBUTION_CONSEQUENTIAL",
            "expected_information_value": "Improves discriminating attribution evidence.",
            "safety_boundary": "Do not reproduce offensive procedures or create emulation payloads automatically.",
        })

    if alias_pairs and all(p.get("state") in {"UNRESOLVED", "POSSIBLE_ALIAS", "OVERLAPPING_CLUSTER"} for p in alias_pairs):
        gaps.append({
            "gap_id": f"GAP-{uuid.uuid4()}",
            "question": "Can actor-label alias relationships be resolved with independent evidence?",
            "missing_evidence": "Alias candidates unresolved or weakly supported.",
            "likely_source": "Original provider reports, independent CTI, procedure-level comparison, infrastructure control-era evidence.",
            "specialist_owner": "THREATACTORINT Manager / human reviewer",
            "priority": "HIGH_IF_ATTRIBUTION_CONSEQUENTIAL",
            "expected_information_value": "Reduces false alias/false actor attribution.",
            "safety_boundary": "Do not merge labels based on one weak similarity.",
        })

    if parsed.get("sponsorships"):
        gaps.append({
            "gap_id": f"GAP-{uuid.uuid4()}",
            "question": "Are state-sponsorship claims supported by strong multi-source independent evidence?",
            "missing_evidence": "Sponsorship claims parsed, but independence/primary evidence unresolved.",
            "likely_source": "Government advisories, primary incident reports, independent vendor analyses, lawful public statements.",
            "specialist_owner": "THREATACTORINT Manager / human reviewer / CTI",
            "priority": "HIGH_CONSEQUENCE",
            "expected_information_value": "Prevents casual or false state-link attribution.",
            "safety_boundary": "Human review mandatory. Do not autonomously publish accusation.",
        })

    if campaign_profiles and not parsed.get("infrastructure_links"):
        gaps.append({
            "gap_id": f"GAP-{uuid.uuid4()}",
            "question": "What infrastructure relationships and control eras support campaign clustering?",
            "missing_evidence": "No infrastructure links parsed.",
            "likely_source": "DNSINT/IPINT/CERTINT/INFRAINT historical records, authorized telemetry, public DNS/RDAP/CT data.",
            "specialist_owner": "THREATACTORINT / INFRAINT / IPINT / DNSINT",
            "priority": "MEDIUM_HIGH",
            "expected_information_value": "Separates genuine reuse from shared/leased/compromised infrastructure.",
            "safety_boundary": "No infrastructure exploitation or active probing.",
        })

    if contradictions:
        gaps.append({
            "gap_id": f"GAP-{uuid.uuid4()}",
            "question": "Which actor/campaign/timeline/infrastructure contradictions are resolved?",
            "missing_evidence": f"{len(contradictions)} contradiction candidate(s) detected.",
            "likely_source": "Original reports, independent CTI, procedure evidence, infrastructure history.",
            "specialist_owner": "THREATACTORINT / human reviewer",
            "priority": "HIGH_IF_IDENTIFICATION_CONSEQUENTIAL",
            "expected_information_value": "Prevents false alias/campaign/actor merging.",
            "safety_boundary": "Do not hide provider taxonomy conflict or partial overlap.",
        })

    gaps, _ = truncate_list(gaps, 500)
    return gaps


def build_specialist_handoffs(payload: Dict[str, Any], parsed: Dict[str, Any], profiles: List[Dict[str, Any]], campaign_profiles: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    handoffs: List[Dict[str, Any]] = []
    payload_text = normalize_text(json.dumps(payload, ensure_ascii=False, default=str))

    if parsed.get("malware_links") or "malware" in payload_text:
        handoffs.append({
            "specialist": "MALINT",
            "reason": "Malware relationship context detected.",
            "expected_output": "Defensive malware family/variant/capability context without executing or weaponizing malware.",
            "question": "Which malware families/variants are reported, and are they commodity or discriminating?",
        })

    if parsed.get("vulnerability_links") or "cve" in payload_text:
        handoffs.append({
            "specialist": "VULNINT / EXPLOITINT",
            "reason": "Vulnerability/exploitation relationship context detected.",
            "expected_output": "Vulnerability applicability and exploitation trend context without exploit development.",
            "question": "Which CVE relationships are supported, and is exploitation generic or actor-discriminating?",
        })

    if parsed.get("infrastructure_links") or "domain" in payload_text or "ip" in payload_text:
        handoffs.append({
            "specialist": "DOMAININT / DNSINT / IPINT / CERTINT / INFRAINT",
            "reason": "Infrastructure relationship context detected.",
            "expected_output": "Historical/current control era, shared/leased/compromised/CDN/cloud caution.",
            "question": "Which infrastructure relationships are actor-relevant versus shared/commodity?",
        })

    if parsed.get("victimology") or "victim" in payload_text or "sector" in payload_text:
        handoffs.append({
            "specialist": "CTI / CYBINT",
            "reason": "Victimology/targeting context detected.",
            "expected_output": "Campaign/actor victimology interpretation with disclosure/visibility bias caution.",
            "question": "Is observed victimology deliberate targeting, prevalence, or opportunistic impact?",
        })

    if parsed.get("sponsorships") or "state" in payload_text:
        handoffs.append({
            "specialist": "CTI / human governance reviewer",
            "reason": "State-sponsorship claim context detected.",
            "expected_output": "High-consequence attribution review, source pedigree, independence, and calibrated language.",
            "question": "Are state-link claims independently supported and appropriate for human-reviewed reporting?",
        })

    if parsed.get("personas") or parsed.get("handles") or "persona" in payload_text or "handle" in payload_text:
        handoffs.append({
            "specialist": "SOCMINT under privacy restrictions",
            "reason": "Public persona/handle context detected.",
            "expected_output": "Lawful public persona context without real-person identification, tracking, or doxxing.",
            "question": "Which persona relationships are publicly verifiable without privacy harm?",
        })

    if parsed.get("source_claims") and any(c.get("claim_type") == "CLAIM_OF_RESPONSIBILITY" for c in parsed.get("source_claims", [])):
        handoffs.append({
            "specialist": "INCIDENTINT / CTI",
            "reason": "Claim-of-responsibility context detected.",
            "expected_output": "Independent incident verification; claims may be exaggerated, copied, or false-flag.",
            "question": "Is claimed responsibility independently supported by incident evidence?",
        })

    if not handoffs:
        handoffs.append({
            "specialist": "THREATACTORINT Manager",
            "reason": "No specialized handoff triggered from current local deterministic evidence alone.",
            "expected_output": "Review scope, approve authorized connectors, assign actor/campaign/TTP collection tasks.",
            "question": "What threat-actor intelligence gap should be filled next?",
        })

    return handoffs


def build_next_best_action(
    payload: Dict[str, Any],
    policy: Dict[str, Any],
    files: List[Dict[str, Any]],
    parsed: Dict[str, Any],
    profiles: List[Dict[str, Any]],
    alias_pairs: List[Dict[str, Any]],
    campaign_profiles: List[Dict[str, Any]],
    contradictions: List[Dict[str, Any]],
) -> Dict[str, str]:
    if policy.get("status") == "POLICY_BLOCKED":
        return {
            "action": "Revise task to remove prohibited offensive, retaliatory, deceptive, private-person targeting, doxxing, credential-use, malware-deployment, or autonomous accusation behavior.",
            "reason": "THREATACTORINT is defensive threat-actor intelligence and attribution support, not offensive operations or private-person targeting.",
            "owner": "Threat Actor Intelligence Manager",
            "expected_output": "Policy-compliant defensive THREATACTORINT scope and question set.",
        }

    if policy.get("status") == "HUMAN_REVIEW_REQUIRED":
        return {
            "action": "Route to human THREATACTORINT/privacy/safety reviewer before consequential actor attribution, state-sponsorship language, public accusation, law-enforcement referral, or private-person-adjacent analysis.",
            "reason": "Threat-actor attribution and victimology can be consequential and privacy-sensitive.",
            "owner": "Threat Actor Intelligence Manager",
            "expected_output": "Approved defensive attribution-support plan, evidence gaps, and handoffs.",
        }

    if not files:
        return {
            "action": "Attach authorized/public threat reports, actor-label reports, campaign reports, TTP/procedure reports, victimology reports, infrastructure reports, or STIX/TAXII/MISP exports before collection.",
            "reason": "No THREATACTORINT evidence artifact is available for local deterministic analysis.",
            "owner": "THREATACTORINT AI Employee",
            "expected_output": "Threat-actor evidence inventory with hashes and provenance.",
        }

        if not profiles:
        return {
            "action": "Collect actor-label/provider-namespace evidence from government/vendor CTI/MITRE/MISP/STIX/TAXII or authorized reports before alias/campaign assessment.",
            "reason": "No actor label profiles were parsed.",
            "owner": "THREATACTORINT AI Employee",
            "expected_output": "Provider-namespaced actor labels and source pedigree.",
        }

    if not parsed.get("procedures"):
        return {
            "action": "Obtain procedure-level evidence from primary incident/vendor reports rather than relying on generic TTP counts.",
            "reason": "Generic TTPs are weak actor-attribution evidence.",
            "owner": "THREATACTORINT / MALINT / INCIDENTINT",
            "expected_output": "Discriminating procedure candidates and ATT&CK versioned mappings.",
        }

    if alias_pairs and all(p.get("state") in {"UNRESOLVED", "POSSIBLE_ALIAS", "OVERLAPPING_CLUSTER"} for p in alias_pairs):
        return {
            "action": "Compare procedure-level behavior and seek independent source evidence before treating actor labels as aliases.",
            "reason": "Alias resolution remains weak or unresolved.",
            "owner": "THREATACTORINT Manager / human reviewer",
            "expected_output": "Resolved or explicitly disputed alias relationships.",
        }

    if parsed.get("sponsorships"):
        return {
            "action": "Route state-sponsorship claims to human review and verify source pedigree/independence before consequential attribution language.",
            "reason": "State sponsorship is high-consequence and must not be casual.",
            "owner": "Threat Actor Intelligence Manager / CTI / human reviewer",
            "expected_output": "Calibrated sponsorship assessment or INCONCLUSIVE.",
        }

    if campaign_profiles and not parsed.get("infrastructure_links"):
        return {
            "action": "Obtain infrastructure relationship and control-era evidence from DNSINT/IPINT/CERTINT/INFRAINT or authorized telemetry before campaign/actor correlation.",
            "reason": "Infrastructure overlap alone is weak actor evidence, and historical domains/IPs may be reassigned.",
            "owner": "THREATACTORINT / INFRAINT / IPINT / DNSINT",
            "expected_output": "Temporally qualified infrastructure relationships.",
        }

    if contradictions:
        return {
            "action": "Resolve provider-taxonomy/timeline/infrastructure-only contradictions using independent procedure evidence before final attribution support.",
            "reason": "Contradictions may cause false alias/campaign/actor merging.",
            "owner": "THREATACTORINT / human reviewer",
            "expected_output": "Resolved or explicitly disputed relationships.",
        }

    return {
        "action": "Proceed with defensive detection/hunting mapping, source-independence review, competing-hypothesis/ACH analysis, and specialist handoffs.",
        "reason": "Local actor-label/campaign evidence exists, but attribution remains source-dependent until independent corroboration.",
        "owner": "THREATACTORINT / CTI / MALINT / INFRAINT / INCIDENTINT",
        "expected_output": "Evidence-linked threat-actor intelligence report with limitations and next actions.",
    }


def build_collection_plan(
    payload: Dict[str, Any],
    questions: List[Any],
    files: List[Dict[str, Any]],
    parsed: Dict[str, Any],
    profiles: List[Dict[str, Any]],
    alias_pairs: List[Dict[str, Any]],
    campaign_profiles: List[Dict[str, Any]],
) -> List[Dict[str, Any]]:
    plan: List[Dict[str, Any]] = []
    priority = 1
    questions_limited, _ = truncate_list([str(q) for q in questions], 8)

    has_files = bool(files)
    has_profiles = bool(profiles)
    has_campaigns = bool(campaign_profiles)
    has_procs = bool(parsed.get("procedures"))
    has_infra = bool(parsed.get("infrastructure_links"))
    has_malware = bool(parsed.get("malware_links"))
    has_vulns = bool(parsed.get("vulnerability_links"))
    has_victimology = bool(parsed.get("victimology"))
    has_sponsorships = bool(parsed.get("sponsorships"))
    has_personas = bool(parsed.get("personas") or parsed.get("handles"))

    configured_connectors = payload.get("configured_connectors") or []
    has_connectors = bool(configured_connectors) and not any("None configured" in str(x) for x in configured_connectors)

    def add(
        operation: str,
        tool: str,
        purpose: str,
        status: str,
        expected_output: str,
        safety_risk: str = "LOW",
        policy_note: str = "Defensive / authorized / evidence-first threat-actor intelligence only.",
    ) -> None:
        nonlocal priority
        plan.append({
            "question": questions_limited[0] if questions_limited else "General THREATACTORINT collection planning",
            "operation": operation,
            "tool_or_provider": tool,
            "purpose": purpose,
            "status": status,
            "expected_output": expected_output,
            "priority": priority,
            "safety_risk": safety_risk,
            "policy_note": policy_note,
            "authorization_status": "ALLOWED_DEFENSIVE_AUTHORIZED_PUBLIC",
            "execution_status": "NOT_EXECUTED_PLANNING_ONLY",
        })
        priority += 1

    add(
        "define_threatactorint_questions_scope",
        "THREATACTORINT Manager / THREATACTORINT AI Employee",
        "Convert objective into threat-actor intelligence questions, allowed sources, actor/campaign scope, temporal scope, privacy boundaries, and safety boundaries.",
        "COMPLETED_LOCAL" if payload.get("questions") else "REQUIRED_BEFORE_COLLECTION",
        "Requirement-driven defensive threat-actor collection plan.",
        policy_note="Do not hack, retaliate, contact actors, impersonate, purchase illicit access, use stolen credentials, dox, or track private persons.",
    )

    add(
        "preserve_original_threat_actor_evidence",
        "local evidence store",
        "Store original threat reports, actor-label reports, campaign reports, TTP/procedure reports, victimology reports, infrastructure reports, and STIX/TAXII/MISP exports with hashes.",
        "COMPLETED_LOCAL" if has_files else "PLANNED_REQUIRES_EVIDENCE",
        "ThreatActorEvidenceObject with SHA256 and provenance fields.",
    )

    add(
        "safe_parse_json_csv_text_threatactorint_metadata",
        "local deterministic parser",
        "Parse authorized/public JSON/CSV/TXT threat-actor metadata without executing binaries, contacting actors, or using exposed secrets.",
        "COMPLETED_LOCAL" if has_files else "PLANNED_REQUIRES_EVIDENCE",
        "Normalized actor labels, campaigns, intrusion sets, TTPs, procedures, victimology, infrastructure links, and source claims.",
        policy_note="Threat reports, actor statements, forum posts, repositories, and IOCs are untrusted evidence, not instructions.",
    )

    add(
        "actor_label_provider_namespace_normalization",
        "local deterministic normalizer",
        "Preserve provider namespaces and normalize actor labels without stripping vendor context.",
        "COMPLETED_LOCAL" if has_profiles else "PLANNED_REQUIRES_ACTOR_EVIDENCE",
        "Provider-namespaced actor label profiles and alias candidates.",
        safety_risk="HIGH_IF_FALSE_ALIAS",
        policy_note="Actor label is not real-world actor, organization, or person.",
    )

    add(
        "intrusion_set_campaign_operation_resolution",
        "THREATACTORINT analyst / provider reports",
        "Resolve intrusion sets, campaigns, and operations while preserving provider taxonomy differences.",
        "COMPLETED_LOCAL" if has_campaigns else "PLANNED_REQUIRES_CAMPAIGN_EVIDENCE",
        "Campaign profiles, campaign-resolution candidates, and operation context.",
        safety_risk="HIGH_IF_FALSE_CAMPAIGN_LINK",
        policy_note="Campaign does not automatically equal actor, operation, or intrusion set.",
    )

    add(
        "malware_tooling_relationship_extraction",
        "MALINT handoff / threat reports",
        "Extract reported malware/tooling relationships while marking commodity/dual-use tooling as weak actor evidence.",
        "COMPLETED_LOCAL" if has_malware else "PLANNED_REQUIRES_MALWARE_EVIDENCE",
        "SOURCE_REPORTED_USING malware/tool links with limitations.",
        safety_risk="MEDIUM",
        policy_note="Shared malware or commodity tooling does not prove same actor.",
    )

    add(
        "infrastructure_relationship_extraction_with_control_era_caution",
        "DNSINT / IPINT / CERTINT / INFRAINT",
        "Extract reported infrastructure relationships and require temporal control-era validation.",
        "COMPLETED_LOCAL" if has_infra else "PLANNED_REQUIRES_INFRASTRUCTURE_EVIDENCE",
        "Temporally qualified infrastructure links with shared/leased/compromised/reassigned caution.",
        safety_risk="HIGH_IF_FALSE_INFRA_LINK",
        policy_note="Infrastructure overlap alone is weak actor-attribution evidence.",
    )

    add(
        "ttp_procedure_extraction_and_attck_mapping",
        "MITRE ATT&CK / vendor reports / incident reports",
        "Extract tactics, techniques, sub-techniques, and procedures with versioned ATT&CK mapping.",
        "COMPLETED_LOCAL" if has_procs else "PLANNED_REQUIRES_PROCEDURE_EVIDENCE",
        "TTP/procedure records with generic vs discriminating weighting.",
        safety_risk="HIGH_IF_GENERIC_TTP_OVERWEIGHT",
        policy_note="Do not keyword-map blindly; procedure-level evidence is more discriminating.",
    )

    add(
        "victimology_sector_geography_analysis",
        "CTI / incident reports / public advisories",
        "Analyze reported victims, sectors, countries, and regions while preserving disclosure/visibility bias.",
        "COMPLETED_LOCAL" if has_victimology else "PLANNED_REQUIRES_VICTIMOLOGY_EVIDENCE",
        "Victimology summary with TARGETED vs OPPORTUNISTIC_IMPACT caution.",
        safety_risk="MEDIUM",
        policy_note="Do not infer attacker nationality from victim geography.",
    )

    add(
        "source_attribution_objective_sponsorship_claim_extraction",
        "government advisories / vendor CTI / public statements",
        "Extract source-attributed objectives, motivations, sponsorship claims, and responsibility claims without treating them as verified facts.",
        "COMPLETED_LOCAL" if (has_sponsorships or parsed.get("objectives") or parsed.get("motivations") or parsed.get("source_claims")) else "PLANNED_REQUIRES_ATTRIBUTION_EVIDENCE",
        "SOURCE_ATTRIBUTED_OBJECTIVE / SOURCE_ALLEGED_STATE_LINK / CLAIM_OF_RESPONSIBILITY records.",
        safety_risk="HIGH_IF_STATE_SPONSORSHIP_OVERCLAIM",
        policy_note="State sponsorship and real-world attribution require human review and strong multi-source evidence.",
    )

    add(
        "public_persona_handle_context",
        "SOCMINT under privacy restrictions",
        "Record lawful public persona/handle context without mapping to real persons, tracking, doxxing, or deceptive contact.",
        "COMPLETED_LOCAL" if has_personas else "PLANNED_REQUIRES_PUBLIC_PERSONA_EVIDENCE",
        "PUBLIC_PERSONA_CONTEXT / HANDLE_MATCH_CANDIDATE records.",
        safety_risk="HIGH_IF_PRIVACY_HARM",
        policy_note="Do not identify private persons from handles, faces, IPs, paths, language, or one leaked record.",
    )

    add(
        "source_reliability_bias_independence",
        "THREATACTORINT analyst + report provenance",
        "Assess government/vendor/researcher/incident/community sources and cluster same-upstream reports.",
        "PLANNED_ANALYTIC",
        "INDEPENDENT / PARTIALLY_DEPENDENT / DEPENDENT / UNKNOWN states.",
        safety_risk="HIGH_IF_SOURCE_DEPENDENCE_ERROR",
        policy_note="Five vendors quoting one advisory are not five independent attributions.",
    )

    add(
        "contradiction_competing_hypothesis_ach_falsification",
        "Primary THREATACTORINT Analyst + Independent Attribution Skeptic",
        "Generate competing hypotheses, ACH-style matrix, falsification questions, and contradiction preservation.",
        "PLANNED_ANALYTIC",
        "AGREE / PARTIAL_AGREEMENT / DISAGREE / INSUFFICIENT_EVIDENCE and unresolved alternatives.",
        safety_risk="HIGH_IF_CONFIRMATION_BIAS",
        policy_note="Behavior first, clustering second, attribution last.",
    )

    add(
        "defensive_detection_hunting_handoffs",
        "SOC / detection engineering / CTI / MALINT / INFRAINT",
        "Translate actor TTPs/procedures into defensive telemetry, hunt questions, and specialist handoffs without offensive emulation payloads.",
        "PLANNED_ANALYTIC",
        "Detection coverage gaps, hunt hypotheses, and handoff packages.",
        policy_note="Do not provide advice to actors on improving OPSEC or evasion.",
    )

    return plan


def policy_screen(payload: Dict[str, Any]) -> Dict[str, Any]:
    scanned_text = " ".join(
        [
            str(payload.get("objective", "")),
            " ".join(str(q) for q in payload.get("questions", [])),
            str(payload.get("target", "")),
            " ".join(str(s) for s in payload.get("actor_labels", [])),
            " ".join(str(s) for s in payload.get("provider_labels", [])),
            " ".join(str(s) for s in payload.get("intrusion_sets", [])),
            " ".join(str(s) for s in payload.get("campaigns", [])),
            " ".join(str(s) for s in payload.get("operations", [])),
            " ".join(str(s) for s in payload.get("malware", [])),
            " ".join(str(s) for s in payload.get("tools", [])),
            " ".join(str(s) for s in payload.get("victims", [])),
            " ".join(str(s) for s in payload.get("sectors", [])),
            " ".join(str(s) for s in payload.get("countries", [])),
            " ".join(str(s) for s in payload.get("regions", [])),
            str(payload.get("incident_context", "")),
        ]
    ).lower()

    blocked_reasons = [p for p in POLICY_BLOCK_PATTERNS if re.search(p, scanned_text, re.IGNORECASE)]

    human_review_required = False
    safety_notes: List[str] = []

    if payload.get("target_type") in SENSITIVE_TARGET_TYPES:
        human_review_required = True
        safety_notes.append(
            "Sensitive threat-actor/campaign/victimology/incident context detected. Analysis must remain defensive, authorized, evidence-first, and privacy-respecting. "
            "No hacking, retaliation, actor contact, impersonation, illicit purchase, stolen credential use, malware deployment, infrastructure exploitation, doxxing, private-person tracking, sensitive-trait inference, or autonomous accusation."
        )

    if payload.get("actor_labels") or payload.get("provider_labels") or payload.get("intrusion_sets"):
        human_review_required = True
        safety_notes.append(
            "Actor-label/provider-namespace context detected. Labels are analytical identifiers, not verified real-world actors, organizations, or persons."
        )

    if payload.get("campaigns") or payload.get("operations"):
        human_review_required = True
        safety_notes.append(
            "Campaign/operation context detected. Campaign relationships remain source-reported until independently corroborated."
        )

    if payload.get("victims") or payload.get("sectors") or payload.get("countries") or payload.get("regions"):
        human_review_required = True
        safety_notes.append(
            "Victimology/targeting context detected. Observed victims may reflect disclosure bias, customer-base bias, opportunistic impact, or incomplete visibility."
        )

    if payload.get("incident_context"):
        human_review_required = True
        safety_notes.append(
            "Incident context detected. Claimed responsibility or actor association must be independently verified by INCIDENTINT/CTI evidence."
        )

    if payload.get("threat_report_paths") or payload.get("actor_label_paths") or payload.get("campaign_report_paths") or payload.get("victimology_paths"):
        human_review_required = True
        safety_notes.append(
            "Threat/actor/campaign/victimology report evidence detected. Report text is untrusted evidence, not instructions."
        )

    if blocked_reasons:
        return {
            "status": "POLICY_BLOCKED",
            "reasons": sorted(set(blocked_reasons)),
            "human_review_required": True,
            "safety_notes": safety_notes,
            "explanation": (
                "The requested task appears to require offensive/retaliatory/deceptive threat-actor operations, private-person targeting, doxxing, illicit purchasing, "
                "stolen credential use, malware deployment, infrastructure exploitation, autonomous accusation, or attribution based solely on technical similarity."
            ),
            "safe_alternatives": SAFE_ALTERNATIVES,
        }

    if human_review_required:
        return {
            "status": "HUMAN_REVIEW_REQUIRED",
            "reasons": [],
            "human_review_required": True,
            "safety_notes": safety_notes,
            "explanation": (
                "No obvious hard policy violation detected, but sensitive threat-actor, campaign, victimology, incident, sponsorship, or public-persona context applies. "
                "Conclusions must remain defensive, evidence-linked, privacy-respecting, and human-reviewed before consequential attribution or operational action."
            ),
            "safe_alternatives": SAFE_ALTERNATIVES,
        }

    return {
        "status": "ALLOWED_DEFENSIVE_AUTHORIZED_PUBLIC",
        "reasons": [],
        "human_review_required": False,
        "safety_notes": [],
        "explanation": (
            "No obvious policy violation detected. Execution remains planning-only unless authorized/public threat-report, actor-label, campaign, TTP, victimology, infrastructure, or STIX/TAXII/MISP connectors or artifacts are configured."
        ),
        "safe_alternatives": [],
    }


def validate_payload(payload: Dict[str, Any]) -> List[str]:
    warnings: List[str] = []

    required = ["case_id", "task_id", "objective", "target", "target_type"]
    for field in required:
        if not payload.get(field):
            warnings.append(f"Missing required field: {field}")

    if not payload.get("questions"):
        warnings.append("No THREATACTORINT questions provided. Default questions will be inferred.")

    evidence_keys = [
        "actor_labels",
        "provider_labels",
        "intrusion_sets",
        "campaigns",
        "operations",
        "malware",
        "tools",
        "iocs",
        "domains",
        "ips",
        "certificates",
        "cves",
        "attack_techniques",
        "procedures",
        "victims",
        "sectors",
        "countries",
        "regions",
        "threat_report_paths",
        "actor_label_paths",
        "campaign_report_paths",
        "infrastructure_report_paths",
        "ttp_procedure_paths",
        "victimology_paths",
        "stix_taxii_misp_paths",
    ]

    if not any(payload.get(k) for k in evidence_keys):
        warnings.append("No actor/campaign/TTP/victimology/infrastructure/report evidence provided. Output remains planning-only.")

    if not payload.get("time_range"):
        warnings.append("No time range provided. Actor behavior, campaigns, infrastructure control eras, and attributions are highly temporal.")

    if not payload.get("configured_connectors"):
        warnings.append("No vendor CTI/government/MISP/STIX/TAXII/ATT&CK/infrastructure connectors configured. External correlation remains planning-only.")

    if payload.get("target_type") in SENSITIVE_TARGET_TYPES:
        warnings.append(
            "Sensitive threat-actor/campaign/victimology/incident context triggers defensive/privacy/safety controls. "
            "No hacking, retaliation, actor contact, impersonation, illicit purchase, stolen credential use, malware deployment, infrastructure exploitation, doxxing, private-person tracking, sensitive-trait inference, or autonomous accusation is permitted."
        )

    return warnings


def default_questions(payload: Dict[str, Any]) -> List[str]:
    target = payload.get("target", "target")

    return [
        "Which actor labels/provider namespaces are present, and which source created each label?",
        "Do labels appear to refer to the same actor cluster, overlapping clusters, or distinct clusters?",
        "Which intrusion sets, campaigns, and operations are associated, and how do provider taxonomies differ?",
        "Which malware families/variants and tools are reported, and which are commodity/dual-use rather than discriminating?",
        "Which infrastructure relationships are reported, and are they temporally aligned with control-era evidence?",
        "Which TTPs are generic versus procedure-level discriminating?",
        "Which victimology/sector/geography patterns are reported, and do they indicate deliberate targeting or opportunistic impact?",
        "Which source-attributed objectives, motivations, sponsorship claims, or responsibility claims exist?",
        "Which sources are independent versus dependent copies of the same upstream report/incident?",
        "What contradictions, timeline conflicts, and alternative explanations remain?",
        "What competing hypotheses and ACH-style assessments are supported?",
        "What defensive detection/hunting opportunities follow from the reported behavior?",
        "What specialist handoffs are required for malware, vulnerability, infrastructure, incident, or campaign attribution?",
        "What next authorized action provides the most attribution value without offensive action or privacy harm?",
    ]


class TraceAtlasTHREATACTORINTPanel(tk.Tk):
    def __init__(self) -> None:
        super().__init__()
        self.title(APP_TITLE)
        self.geometry("1380x940")
        self.minsize(1100, 760)

        self.entries: Dict[str, Any] = {}
        self.last_result: Dict[str, Any] = {}

        self.analyzed_files: List[Dict[str, Any]] = []
        self.parsed: Dict[str, Any] = empty_parsed()
        self.profiles: List[Dict[str, Any]] = []
        self.alias_pairs: List[Dict[str, Any]] = []
        self.campaign_profiles: List[Dict[str, Any]] = []
        self.contradictions: List[Dict[str, Any]] = []

        self._configure_style()
        self._build_ui()
        self._set_defaults()

    def _configure_style(self) -> None:
        style = ttk.Style(self)

        try:
            style.theme_use("clam")
        except tk.TclError:
            pass

        self.configure(bg="#0b0f19")

        style.configure("TFrame", background="#0b0f19")
        style.configure("TLabel", background="#0b0f19", foreground="#e5e7eb", font=("Segoe UI", 10))
        style.configure(
            "Header.TLabel",
            background="#0b0f19",
            foreground="#c084fc",
            font=("Segoe UI", 17, "bold"),
        )
        style.configure(
            "Subheader.TLabel",
            background="#0b0f19",
            foreground="#94a3b8",
            font=("Segoe UI", 9),
        )
        style.configure("TNotebook", background="#0b0f19", borderwidth=0)
        style.configure("TNotebook.Tab", padding=[14, 7], font=("Segoe UI", 10, "bold"))

        style.configure(
            "TEntry",
            fieldbackground="#111827",
            foreground="#e5e7eb",
            insertcolor="#ffffff",
            bordercolor="#334155",
            lightcolor="#334155",
            darkcolor="#334155",
        )

        style.configure(
            "TCombobox",
            fieldbackground="#111827",
            foreground="#e5e7eb",
            arrowcolor="#e5e7eb",
            bordercolor="#334155",
            lightcolor="#334155",
            darkcolor="#334155",
        )

        style.configure(
            "TButton",
            padding=7,
            font=("Segoe UI", 10, "bold"),
            background="#1f2937",
            foreground="#e5e7eb",
            bordercolor="#475569",
            lightcolor="#475569",
            darkcolor="#475569",
        )

        style.map(
            "TButton",
            background=[("active", "#334155")],
            foreground=[("active", "#ffffff")],
        )

        style.configure(
            "Vertical.TScrollbar",
            background="#1f2937",
            troughcolor="#0b0f19",
            arrowcolor="#e5e7eb",
        )

    def _build_ui(self) -> None:
        header = ttk.Frame(self)
        header.pack(fill="x", padx=16, pady=(14, 8))

        ttk.Label(header, text="TraceAtlas THREATACTORINT AI Employee", style="Header.TLabel").pack(anchor="w")

        ttk.Label(
            header,
            text=(
                "Defensive / authorized / evidence-first threat-actor intelligence • Planning-only by default • "
                "Local deterministic JSON/CSV/TXT threat-report parsing only • "
                "No hacking / retaliation / actor contact / impersonation / illicit purchase / stolen credential use / malware deployment / infrastructure exploitation / doxxing / private-person tracking • "
                "Actor label != real-world actor • campaign != actor • malware != actor • infrastructure != actor • attribute last"
            ),
            style="Subheader.TLabel",
            wraplength=1280,
            justify="left",
        ).pack(anchor="w", pady=(2, 0))

        self.notebook = ttk.Notebook(self)
        self.notebook.pack(fill="both", expand=True, padx=16, pady=(8, 16))

        self.input_tab = ttk.Frame(self.notebook)
        self.output_tab = ttk.Frame(self.notebook)

        self.notebook.add(self.input_tab, text="THREATACTORINT Task Input")
        self.notebook.add(self.output_tab, text="Output / THREATACTORINT Plan / Evidence")

        self._build_input_tab()
        self._build_output_tab()

    def _build_input_tab(self) -> None:
        container = ttk.Frame(self.input_tab)
        container.pack(fill="both", expand=True)

        self.canvas = tk.Canvas(container, bg="#0b0f19", highlightthickness=0)
        scrollbar = ttk.Scrollbar(container, orient="vertical", command=self.canvas.yview)
        self.form = ttk.Frame(self.canvas)

        self.form.bind("<Configure>", lambda e: self.canvas.configure(scrollregion=self.canvas.bbox("all")))
        self.canvas_window = self.canvas.create_window((0, 0), window=self.form, anchor="nw")
        self.canvas.configure(yscrollcommand=scrollbar.set)

        self.canvas.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")

        row = 0

        for key, label, kind in FIELDS:
            ttk.Label(self.form, text=label).grid(row=row, column=0, sticky="nw", padx=10, pady=6)

            if kind == "entry":
                widget = ttk.Entry(self.form, width=102)

            elif kind == "combo":
                widget = ttk.Combobox(
                    self.form,
                    values=TARGET_TYPES if key == "target_type" else [],
                    width=100,
                    state="readonly",
                )

            else:
                widget = tk.Text(
                    self.form,
                    height=3,
                    width=102,
                    bg="#111827",
                    fg="#e5e7eb",
                    insertbackground="white",
                    relief="flat",
                    highlightthickness=1,
                    highlightbackground="#334155",
                    font=("Segoe UI", 10),
                    wrap="word",
                )

            widget.grid(row=row, column=1, sticky="ew", padx=10, pady=6)
            self.entries[key] = widget
            row += 1

        self.form.columnconfigure(1, weight=1)

        buttons1 = ttk.Frame(self.input_tab)
        buttons1.pack(fill="x", padx=10, pady=(12, 4))

        buttons2 = ttk.Frame(self.input_tab)
        buttons2.pack(fill="x", padx=10, pady=(0, 12))

        ttk.Button(buttons1, text="Add Threat Reports", command=self.add_threat_reports).pack(side="left", padx=4)
        ttk.Button(buttons1, text="Add Actor Label Reports", command=self.add_actor_label_reports).pack(side="left", padx=4)
        ttk.Button(buttons1, text="Add Campaign Reports", command=self.add_campaign_reports).pack(side="left", padx=4)
        ttk.Button(buttons1, text="Add Infrastructure Reports", command=self.add_infrastructure_reports).pack(side="left", padx=4)
        ttk.Button(buttons1, text="Add TTP / Procedure Reports", command=self.add_ttp_procedure_reports).pack(side="left", padx=4)
        ttk.Button(buttons1, text="Add Victimology Reports", command=self.add_victimology_reports).pack(side="left", padx=4)
        ttk.Button(buttons1, text="Add STIX / TAXII / MISP", command=self.add_stix_taxii_misp).pack(side="left", padx=4)

        ttk.Button(buttons2, text="Analyze Local THREATACTORINT Evidence", command=self.analyze_local_threatactorint).pack(side="left", padx=4)
        ttk.Button(buttons2, text="Run Policy Screen", command=self.run_policy_screen).pack(side="left", padx=4)
        ttk.Button(buttons2, text="Generate THREATACTORINT Plan", command=self.generate_plan).pack(side="left", padx=4)
        ttk.Button(buttons2, text="Export JSON", command=self.export_json).pack(side="left", padx=4)
        ttk.Button(buttons2, text="Copy Output", command=self.copy_output).pack(side="left", padx=4)
        ttk.Button(buttons2, text="Clear Form", command=self.clear_form).pack(side="left", padx=4)

    def _build_output_tab(self) -> None:
        container = ttk.Frame(self.output_tab)
        container.pack(fill="both", expand=True)

        self.output = tk.Text(
            container,
            wrap="word",
            bg="#020617",
            fg="#e9d5ff",
            insertbackground="white",
            relief="flat",
            highlightthickness=1,
            highlightbackground="#334155",
            font=("Consolas", 11),
        )

        output_scroll = ttk.Scrollbar(container, orient="vertical", command=self.output.yview)
        self.output.configure(yscrollcommand=output_scroll.set)

        self.output.pack(side="left", fill="both", expand=True)
        output_scroll.pack(side="right", fill="y")

    def _set_defaults(self) -> None:
        self.set_widget_value("case_id", "THREATACTORINT-CASE-001")
        self.set_widget_value("task_id", "THREATACTORINT-TASK-001")
        self.set_widget_value(
            "objective",
            "Analyze authorized or publicly documented threat-actor intelligence using defensive, evidence-first THREATACTORINT methods. "
            "Preserve originals, parse safe threat/actor/campaign/TTP/victimology/infrastructure metadata deterministically, preserve provider namespaces, "
            "resolve alias/intrusion-set/campaign candidates cautiously, separate generic from discriminating TTP/procedure evidence, assess source independence, "
            "preserve contradictions and competing hypotheses, support defensive detection/hunting, and produce defensible attribution support without hacking, "
