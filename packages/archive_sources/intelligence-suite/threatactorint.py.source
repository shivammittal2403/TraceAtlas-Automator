    def run_policy_screen(self) -> None:
        payload = self.collect_payload()
        policy = policy_screen(payload)

        result = {
            "mode": "POLICY_SCREEN_ONLY",
            "panel_version": APP_VERSION,
            "policy_screen": policy,
            "payload_preview": {
                "case_id": payload.get("case_id"),
                "task_id": payload.get("task_id"),
                "objective": payload.get("objective"),
                "target": payload.get("target"),
                "target_type": payload.get("target_type"),
                "has_actor_labels": bool(payload.get("actor_labels")),
                "has_provider_labels": bool(payload.get("provider_labels")),
                "has_intrusion_sets": bool(payload.get("intrusion_sets")),
                "has_campaigns": bool(payload.get("campaigns")),
                "has_operations": bool(payload.get("operations")),
                "has_malware": bool(payload.get("malware")),
                "has_tools": bool(payload.get("tools")),
                "has_victims": bool(payload.get("victims")),
                "has_sectors": bool(payload.get("sectors")),
                "has_countries": bool(payload.get("countries")),
                "has_regions": bool(payload.get("regions")),
                "has_threat_reports": bool(payload.get("threat_report_paths")),
                "has_actor_label_reports": bool(payload.get("actor_label_paths")),
                "has_campaign_reports": bool(payload.get("campaign_report_paths")),
                "has_infrastructure_reports": bool(payload.get("infrastructure_report_paths")),
                "has_ttp_procedure_reports": bool(payload.get("ttp_procedure_paths")),
                "has_victimology_reports": bool(payload.get("victimology_paths")),
                "has_stix_taxii_misp": bool(payload.get("stix_taxii_misp_paths")),
            },
        }

        self.last_result = result
        self._write_output(result)
        self.notebook.select(self.output_tab)

        if policy["status"] == "POLICY_BLOCKED":
            messagebox.showwarning(
                "Policy Blocked",
                "This THREATACTORINT request is policy-blocked.\n\n"
                + "\n".join(policy["reasons"])
                + "\n\nUse only defensive/authorized alternatives.",
            )
        elif policy["status"] == "HUMAN_REVIEW_REQUIRED":
            messagebox.showwarning(
                "Human Review Required",
                "No hard policy block detected, but sensitive threat-actor/campaign/victimology/incident context applies.",
            )
        else:
            messagebox.showinfo(
                "Policy Screen",
                "No obvious policy violation detected. Planning-only mode remains active.",
            )

    def analyze_local_threatactorint(self) -> None:
        payload = self.collect_payload()
        policy = policy_screen(payload)

        if policy["status"] == "POLICY_BLOCKED":
            result = {
                "mode": "POLICY_BLOCKED",
                "panel_version": APP_VERSION,
                "policy_screen": policy,
                "evidence_inventory": [],
                "actor_label_profile_preview": [],
                "alias_resolution_preview": [],
                "campaign_profile_preview": [],
                "observations": [],
                "candidate_facts": [],
            }
            self.last_result = result
            self._write_output(result)
            messagebox.showwarning("Policy Blocked", "Local THREATACTORINT evidence analysis blocked by policy screen.")
            return

        path_fields = [
            "threat_report_paths",
            "actor_label_paths",
            "campaign_report_paths",
            "infrastructure_report_paths",
            "ttp_procedure_paths",
            "victimology_paths",
            "stix_taxii_misp_paths",
        ]

        all_paths: List[str] = []
        seen = set()

        for field in path_fields:
            for p in payload.get(field, []):
                sp = str(p).strip()
                if sp and sp not in seen:
                    seen.add(sp)
                    all_paths.append(sp)

        if not all_paths:
            messagebox.showwarning("No THREATACTORINT Evidence", "Add local authorized/public threat-actor evidence files first.")
            return

        self.output.delete("1.0", "end")
        self.output.insert("1.0", "Analyzing local authorized/public THREATACTORINT evidence. Hashing and parsing may take time...\n")
        self.notebook.select(self.output_tab)

        files: List[Dict[str, Any]] = []
        parsed_list: List[Dict[str, Any]] = []

        for p in all_paths[:30]:
            f, parsed = analyze_threatactor_file(p, payload.get("case_id", ""), payload.get("task_id", ""))
            files.append(f)
            parsed_list.append(parsed)

        aggregated = aggregate_parsed(parsed_list)
        profiles = build_actor_profiles(aggregated)
        alias_pairs = build_alias_resolution(profiles)
        campaign_profiles = build_campaign_profiles(aggregated)
        contradictions = build_contradictions(aggregated, profiles, alias_pairs, campaign_profiles)

        self.analyzed_files = files
        self.parsed = aggregated
        self.profiles = profiles
        self.alias_pairs = alias_pairs
        self.campaign_profiles = campaign_profiles
        self.contradictions = contradictions

        report = self._build_local_analysis_report(
            files=files,
            parsed=aggregated,
            profiles=profiles,
            alias_pairs=alias_pairs,
            campaign_profiles=campaign_profiles,
            contradictions=contradictions,
            payload=payload,
            policy=policy,
        )

        self.last_result = report
        self._write_output(report)

        succeeded = sum(1 for f in files if f.get("status") == "SUCCEEDED")
        messagebox.showinfo(
            "Local THREATACTORINT Evidence Analysis Complete",
            f"Processed {len(files)} evidence file(s).\n"
            f"Succeeded: {succeeded}\n"
            f"Actor label profiles: {len(profiles)}\n"
            f"Alias pairs: {len(alias_pairs)}\n"
            f"Campaign profiles: {len(campaign_profiles)}\n"
            f"Procedures: {len(aggregated.get('procedures', []))}\n"
            f"Infrastructure links: {len(aggregated.get('infrastructure_links', []))}\n"
            f"Contradictions: {len(contradictions)}\n"
            "Review output for limitations and next actions.",
        )

    def generate_plan(self) -> None:
        payload = self.collect_payload()
        warnings = validate_payload(payload)
        policy = policy_screen(payload)

        if policy["status"] == "POLICY_BLOCKED":
            result = {
                "mode": "POLICY_BLOCKED",
                "panel_version": APP_VERSION,
                "policy_screen": policy,
                "warnings": warnings,
                "payload": payload,
                "threatactorint_collection_plan": [],
                "next_best_action": {
                    "action": "Revise task to remove prohibited offensive, retaliatory, deceptive, private-person targeting, doxxing, credential-use, malware-deployment, or autonomous accusation behavior.",
                    "owner": "Threat Actor Intelligence Manager",
                    "expected_output": "Policy-compliant defensive THREATACTORINT scope and question set.",
                },
            }
            self.last_result = result
            self._write_output(result)
            messagebox.showwarning(
                "Policy Blocked",
                "THREATACTORINT plan not generated because the request is policy-blocked.",
            )
            return

        questions = payload.get("questions") or default_questions(payload)

        files = self.analyzed_files
        parsed = self.parsed
        profiles = self.profiles or build_actor_profiles(parsed)
        alias_pairs = self.alias_pairs or build_alias_resolution(profiles)
        campaign_profiles = self.campaign_profiles or build_campaign_profiles(parsed)
        contradictions = self.contradictions or build_contradictions(parsed, profiles, alias_pairs, campaign_profiles)

        hypotheses = build_hypotheses(parsed, profiles, alias_pairs, campaign_profiles, contradictions)
        ach_matrix = build_ach_matrix(alias_pairs, profiles)
        knowledge_gaps = build_knowledge_gaps(payload, files, parsed, profiles, alias_pairs, campaign_profiles, contradictions)
        handoffs = build_specialist_handoffs(payload, parsed, profiles, campaign_profiles)
        next_action = build_next_best_action(payload, policy, files, parsed, profiles, alias_pairs, campaign_profiles, contradictions)

        ttp_summary = build_ttp_summary(parsed)
        victimology_summary = build_victimology_summary(parsed)
        attribution_assessment = build_attribution_assessment(profiles, alias_pairs, parsed)
        campaign_resolution = build_campaign_resolution(campaign_profiles)
        canonical_candidates = build_canonical_candidates(profiles, alias_pairs)

        overall_status = "PLANNING_ONLY"
        if policy["status"] == "HUMAN_REVIEW_REQUIRED":
            overall_status = "HUMAN_REVIEW_REQUIRED"
        if files or profiles or campaign_profiles or alias_pairs:
            overall_status = "PLANNING_PLUS_LOCAL_DETERMINISTIC_EVIDENCE"

        result = {
            "mode": overall_status,
            "panel_version": APP_VERSION,
            "policy": (
                "This output does not hack threat actors, retaliate, contact operators, impersonate buyers/researchers/victims, purchase illicit access or stolen data, "
                "use leaked credentials/stolen sessions, bypass authentication, deploy malware, exploit infrastructure, dox private people, track private individuals, "
                "infer sensitive personal traits, publish accusations autonomously, perform law-enforcement action, or attribute guilt solely from technical similarity. "
                "Local deterministic analysis is limited to hashing, safe JSON/CSV/TXT threat-report parsing, actor-label/provider-namespace preservation, "
                "intrusion-set/campaign/operation candidate resolution, malware/tooling relationship extraction, infrastructure relationship extraction with control-era caution, "
                "TTP/procedure extraction, ATT&CK candidate mapping, victimology analysis, source-attributed objective/sponsorship/responsibility claim extraction, "
                "source independence analysis, contradiction detection, competing hypotheses, ACH-style review, secret redaction, prompt-injection flagging, "
                "defensive detection/hunting planning, and specialist handoff planning. "
                "Live vendor CTI/government/MISP/STIX/TAXII/ATT&CK/infrastructure enrichment, actor contact, infrastructure exploitation, and consequential attribution remain planning-only unless configured/authorized/human-reviewed."
            ),
            "policy_screen": policy,
            "warnings": warnings,
            "payload": payload,
            "intelligence_questions": questions,
            "evidence_inventory": files,
            "actor_label_profile_preview": profiles[:300],
            "actor_label_profile_count": len(profiles),
            "alias_resolution_preview": alias_pairs[:300],
            "alias_resolution_count": len(alias_pairs),
            "canonical_actor_candidate_preview": canonical_candidates[:300],
            "campaign_profile_preview": campaign_profiles[:300],
            "campaign_profile_count": len(campaign_profiles),
            "campaign_resolution_preview": campaign_resolution[:300],
            "ttp_summary": ttp_summary,
            "victimology_summary": victimology_summary,
            "attribution_assessment_preview": attribution_assessment[:300],
            "contradictions": contradictions[:1000],
            "hypotheses": hypotheses,
            "ach_matrix": ach_matrix,
            "knowledge_gaps": knowledge_gaps,
            "specialist_handoffs": handoffs,
            "next_best_action": next_action,
            "threatactorint_collection_plan": build_collection_plan(payload, questions, files, parsed, profiles, alias_pairs, campaign_profiles),
            **self._policy_sections(),
            **self._schemas(),
        }

        self.last_result = result
        self._write_output(result)
        self.notebook.select(self.output_tab)

        if warnings:
            messagebox.showwarning(
                "Validation Warnings",
                "THREATACTORINT plan generated with warnings:\n\n" + "\n".join(warnings),
            )

    def _build_local_analysis_report(
        self,
        files: List[Dict[str, Any]],
        parsed: Dict[str, Any],
        profiles: List[Dict[str, Any]],
        alias_pairs: List[Dict[str, Any]],
        campaign_profiles: List[Dict[str, Any]],
        contradictions: List[Dict[str, Any]],
        payload: Dict[str, Any],
        policy: Dict[str, Any],
    ) -> Dict[str, Any]:
        hypotheses = build_hypotheses(parsed, profiles, alias_pairs, campaign_profiles, contradictions)
        ach_matrix = build_ach_matrix(alias_pairs, profiles)
        knowledge_gaps = build_knowledge_gaps(payload, files, parsed, profiles, alias_pairs, campaign_profiles, contradictions)
        handoffs = build_specialist_handoffs(payload, parsed, profiles, campaign_profiles)
        next_action = build_next_best_action(payload, policy, files, parsed, profiles, alias_pairs, campaign_profiles, contradictions)

        ttp_summary = build_ttp_summary(parsed)
        victimology_summary = build_victimology_summary(parsed)
        attribution_assessment = build_attribution_assessment(profiles, alias_pairs, parsed)
        campaign_resolution = build_campaign_resolution(campaign_profiles)
        canonical_candidates = build_canonical_candidates(profiles, alias_pairs)

        observations: List[Dict[str, Any]] = []

        for f in files:
            observations.append({
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": f"A local authorized/public THREATACTORINT evidence file was accessed and hashed: {f.get('filename')}.",
                "evidence_id": f.get("evidence_id"),
                "source_id": f.get("source_id"),
                "observed_at": now_utc(),
                "extraction_method": "local_deterministic_file_hash",
                "limitations": "File hash does not prove actor identity, campaign relationship, victim impact, or real-world attribution.",
            })

        observations.extend([
            {
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": f"{len(files)} THREATACTORINT evidence file(s) were parsed locally.",
                "evidence_id": "AGGREGATE",
                "source_id": "LOCAL_PARSER",
                "observed_at": now_utc(),
                "extraction_method": "safe_json_csv_text_threatactorint_parser",
                "limitations": "Parser output is normalized evidence, not verified external reality.",
            },
            {
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": f"{len(profiles)} actor-label profile candidate(s) were constructed with provider namespaces preserved.",
                "evidence_id": "AGGREGATE",
                "source_id": "LOCAL_ACTOR_LABEL_PROFILER",
                "observed_at": now_utc(),
                "extraction_method": "actor_label_provider_namespace_aggregation",
                "limitations": "Actor label is an analytical identifier, not automatically a real-world actor, organization, or person.",
            },
            {
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": f"{len(alias_pairs)} alias-resolution pair candidate(s) were generated.",
                "evidence_id": "AGGREGATE",
                "source_id": "LOCAL_ALIAS_RESOLVER",
                "observed_at": now_utc(),
                "extraction_method": "procedure_malware_infrastructure_temporal_similarity",
                "limitations": "Alias resolution is analytical and source-dependent; source independence remains unresolved.",
            },
            {
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": f"{len(campaign_profiles)} campaign profile candidate(s) were constructed.",
                "evidence_id": "AGGREGATE",
                "source_id": "LOCAL_CAMPAIGN_PROFILER",
                "observed_at": now_utc(),
                "extraction_method": "campaign_actor_malware_infrastructure_victimology_aggregation",
                "limitations": "Campaign does not automatically equal actor, operation, or intrusion set.",
            },
            {
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": f"{len(parsed.get('procedures', []))} procedure record(s) were extracted.",
                "evidence_id": "AGGREGATE",
                "source_id": "LOCAL_PROCEDURE_PARSER",
                "observed_at": now_utc(),
                "extraction_method": "ttp_procedure_extraction",
                "limitations": "Procedure similarity is analytical evidence, not identity proof.",
            },
            {
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": f"{len(parsed.get('infrastructure_links', []))} infrastructure link record(s) were extracted.",
                "evidence_id": "AGGREGATE",
                "source_id": "LOCAL_INFRASTRUCTURE_PARSER",
                "observed_at": now_utc(),
                "extraction_method": "domain_ip_url_cert_asn_relationship_extraction",
                "limitations": "Infrastructure overlap alone is weak actor-attribution evidence; control era must be validated.",
            },
            {
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": f"{len(parsed.get('victimology', []))} victimology record(s) were extracted.",
                "evidence_id": "AGGREGATE",
                "source_id": "LOCAL_VICTIMOLOGY_PARSER",
                "observed_at": now_utc(),
                "extraction_method": "victim_sector_country_region_technology_extraction",
                "limitations": "Victim lists are visibility-biased and not complete targeting pictures.",
            },
            {
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": f"{len(contradictions)} contradiction candidate(s) were detected.",
                "evidence_id": "AGGREGATE",
                "source_id": "LOCAL_CONTRADICTION_DETECTOR",
                "observed_at": now_utc(),
                "extraction_method": "provider_taxonomy_timeline_infrastructure_conflict_detection",
                "limitations": "Contradictions may reflect provider taxonomy differences, source dependence, shared commodity tooling, or temporal mismatches.",
            },
            {
                "observation_id": f"OBS-{uuid.uuid4()}",
                "statement": "No hacking, retaliation, actor contact, impersonation, illicit purchase, stolen credential use, malware deployment, infrastructure exploitation, doxxing, private-person tracking, sensitive-trait inference, or autonomous accusation was performed.",
                "evidence_id": "LOCAL_PANEL_POLICY",
                "source_id": "LOCAL_POLICY_GUARD",
                "observed_at": now_utc(),
                "extraction_method": "defensive_privacy_respecting_policy",
                "limitations": "Planning/local deterministic panel only.",
            },
        ])

        observations, _ = truncate_list(observations, 500)

        candidate_facts: List[Dict[str, Any]] = []

        for f in files:
            if f.get("sha256"):
                candidate_facts.append({
                    "candidate_fact": f"The preserved local THREATACTORINT evidence artifact {f.get('filename')} has SHA256 {f.get('sha256')}.",
                    "status": "SUPPORTED",
                    "evidence_ids": [f.get("evidence_id")],
                    "notes": "Supported by deterministic local hashing/parsing. Does not prove actor identity, campaign relationship, or real-world attribution.",
                })

        candidate_facts.extend([
            {
                "candidate_fact": f"The parsed evidence set contains {len(profiles)} actor-label profile candidate(s).",
                "status": "SUPPORTED_AS_CANDIDATE_ONLY",
                "evidence_ids": ["AGGREGATE"],
                "notes": "Actor labels are source-observed analytical identifiers, not verified real-world actors.",
            },
            {
                "candidate_fact": f"{len(alias_pairs)} alias-resolution pair candidate(s) were generated.",
                "status": "SUPPORTED_AS_CANDIDATE_ONLY",
                "evidence_ids": ["AGGREGATE"],
                "not_supported": [
                    "verified real-world actor identity",
                    "verified state sponsorship",
                    "verified campaign ownership",
                    "verified real-person attribution",
                ],
            },
            {
                "candidate_fact": f"{len(campaign_profiles)} campaign profile candidate(s) were constructed.",
                "status": "SUPPORTED_AS_CANDIDATE_ONLY",
                "evidence_ids": ["AGGREGATE"],
                "notes": "Campaign boundaries and actor relationships remain source-reported until independently corroborated.",
            },
            {
                "candidate_fact": f"{len(parsed.get('procedures', []))} procedure record(s) were extracted.",
                "status": "SUPPORTED_AS_PROCEDURE_CANDIDATE_ONLY",
                "evidence_ids": ["AGGREGATE"],
                "notes": "Procedure similarity is analytical evidence, not identity proof.",
            },
            {
                "candidate_fact": f"{len(parsed.get('infrastructure_links', []))} infrastructure link record(s) were extracted.",
                "status": "SUPPORTED_AS_INFRASTRUCTURE_CANDIDATE_ONLY",
                "evidence_ids": ["AGGREGATE"],
                "notes": "Infrastructure may be leased, compromised, shared, cloud-hosted, CDN-mediated, VPN-mediated, or reassigned.",
            },
            {
                "candidate_fact": "No hacking, retaliation, actor contact, impersonation, illicit purchase, stolen credential use, malware deployment, infrastructure exploitation, doxxing, private-person tracking, sensitive-trait inference, or autonomous accusation was performed.",
                "status": "SUPPORTED",
                "evidence_ids": ["LOCAL_PANEL_POLICY"],
                "notes": "Defensive/privacy-respecting planning boundary.",
            },
        ])

        candidate_facts, _ = truncate_list(candidate_facts, 200)

        fact_gate = {
            "status": "LOCAL_DETERMINISTIC_ONLY" if files or profiles or campaign_profiles else "NO_LOCAL_THREATACTORINT_EVIDENCE",
            "supported": [
                "file existence and SHA256 hash",
                "parsed actor labels with provider namespaces",
                "parsed intrusion sets, campaigns, and operations",
                "parsed malware/tooling relationship claims",
                "parsed infrastructure relationship claims",
                "parsed TTPs and procedures",
                "parsed victimology/sector/country/region records",
                "parsed source-attributed objectives/motivations/sponsorships/responsibility claims",
                "alias-resolution candidates",
                "campaign-resolution candidates",
                "contradiction candidates",
                "ACH-style competing hypothesis matrix",
                "secret redaction flags",
                "prompt-injection flags",
            ],
            "not_supported": [
                "verified real-world actor identity",
                "verified real-world organization attribution",
                "verified state sponsorship",
                "verified real-person attribution",
                "verified campaign ownership",
                "verified infrastructure control era",
                "verified victim impact",
                "verified compromise",
                "actor contact",
                "retaliation",
                "infrastructure exploitation",
                "malware deployment",
                "doxxing",
                "private-person tracking",
                "sensitive-trait inference",
                "autonomous accusation",
            ],
            "safety_status": "No hacking, retaliation, actor contact, impersonation, illicit purchase, stolen credential use, malware deployment, infrastructure exploitation, doxxing, private-person tracking, sensitive-trait inference, or autonomous accusation performed.",
        }

        return {
            "mode": "LOCAL_DETERMINISTIC_THREATACTORINT_ANALYSIS",
            "panel_version": APP_VERSION,
            "policy_screen": policy,
            "hacking_performed": False,
            "retaliation_performed": False,
            "actor_contact_performed": False,
            "impersonation_performed": False,
            "illicit_purchase_performed": False,
            "credential_use_performed": False,
            "malware_deployment_performed": False,
            "infrastructure_exploitation_performed": False,
            "doxxing_performed": False,
            "private_person_tracking_performed": False,
            "sensitive_trait_inference_performed": False,
            "autonomous_accusation_performed": False,
            "evidence_inventory": files,
            "actor_label_profile_preview": profiles[:300],
            "actor_label_profile_count": len(profiles),
            "alias_resolution_preview": alias_pairs[:300],
            "alias_resolution_count": len(alias_pairs),
            "canonical_actor_candidate_preview": canonical_candidates[:300],
            "campaign_profile_preview": campaign_profiles[:300],
            "campaign_profile_count": len(campaign_profiles),
            "campaign_resolution_preview": campaign_resolution[:300],
            "ttp_summary": ttp_summary,
            "victimology_summary": victimology_summary,
            "attribution_assessment_preview": attribution_assessment[:300],
            "contradictions": contradictions[:1000],
            "hypotheses": hypotheses,
            "ach_matrix": ach_matrix,
            "observations": observations,
            "candidate_facts": candidate_facts,
            "fact_gate": fact_gate,
            "knowledge_gaps": knowledge_gaps,
            "specialist_handoffs": handoffs,
            "recommended_next_actions": next_action,
            "limitations": [
                "Only local deterministic checks were performed.",
                "No network access was performed.",
                "No hacking, retaliation, actor contact, impersonation, illicit purchase, stolen credential use, malware deployment, infrastructure exploitation, doxxing, private-person tracking, sensitive-trait inference, or autonomous accusation was performed.",
                "Actor label is not real-world actor, organization, or person.",
                "Campaign is not actor.",
                "Intrusion set is not real-world organization.",
                "Malware family is not actor.",
                "Shared malware does not prove same actor.",
                "Shared CVE does not prove same actor.",
                "Shared IP/domain/certificate/cloud provider does not prove same actor without control-era and independence evidence.",
                "Generic TTPs are weak actor-attribution evidence.",
                "Procedure-level evidence is more discriminating but still requires corroboration.",
                "Victim lists are visibility-biased and not complete targeting pictures.",
                "State sponsorship is high-consequence and requires human review.",
                "Real-person attribution is unsupported by this panel.",
                "Exposed secrets were redacted heuristically and not used.",
                "Threat reports, actor statements, forum posts, repositories, and IOCs were treated as untrusted evidence.",
            ],
        }

    def _write_output(self, result: Dict[str, Any]) -> None:
        self.output.delete("1.0", "end")
        self.output.insert("1.0", json.dumps(result, ensure_ascii=False, indent=2, default=str))

