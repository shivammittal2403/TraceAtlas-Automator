        "actor_label": str(actor_label or "").strip() or None,
        "campaign": str(campaign or "").strip() or None,
        "source_id": source_id,
        "evidence_id": evidence_id,
        "temporal": temporal or {},
        "state": state,
        "limitations": [
            "Procedure similarity is analytical evidence, not identity proof.",
            "Do not reproduce offensive procedures or create emulation payloads automatically.",
        ],
    })


def add_victimology(
    parsed: Dict[str, Any],
    victim: Any = None,
    sector: Any = None,
    country: Any = None,
    region: Any = None,
    technology: Any = None,
    actor_label: Any = None,
    campaign: Any = None,
    source_id: str = "",
    evidence_id: str = "",
    temporal: Optional[Dict[str, Any]] = None,
    state: str = "REPORTED_VICTIMOLOGY",
) -> None:
    if not any([victim, sector, country, region, technology]):
        return
    if len(parsed.get("victimology", [])) >= 200000:
        return

    parsed["victimology"].append({
        "victimology_id": f"VIC-{uuid.uuid4()}",
        "victim": redact_secrets(str(victim or ""))[0][:200] or None,
        "sector": redact_secrets(str(sector or ""))[0][:200] or None,
        "country": redact_secrets(str(country or ""))[0][:200] or None,
        "region": redact_secrets(str(region or ""))[0][:200] or None,
        "technology": redact_secrets(str(technology or ""))[0][:200] or None,
        "actor_label": str(actor_label or "").strip() or None,
        "campaign": str(campaign or "").strip() or None,
        "source_id": source_id,
        "evidence_id": evidence_id,
        "temporal": temporal or {},
        "state": state,
        "limitations": [
            "Observed victims depend on provider customer base, disclosure bias, incident visibility, and regional collection.",
            "Victim list is not a complete targeting picture.",
            "Sector prevalence may be opportunistic impact, not deliberate targeting.",
        ],
    })

    if sector:
        parsed["sectors"].append({"sector": redact_secrets(str(sector))[0][:200], "source_id": source_id, "evidence_id": evidence_id})
    if country:
        parsed["countries"].append({"country": redact_secrets(str(country))[0][:200], "source_id": source_id, "evidence_id": evidence_id})
    if region:
        parsed["regions"].append({"region": redact_secrets(str(region))[0][:200], "source_id": source_id, "evidence_id": evidence_id})


