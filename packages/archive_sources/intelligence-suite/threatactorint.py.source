def now_utc() -> str:
    return datetime.now(timezone.utc).isoformat()


def normalize_text(value: Any) -> str:
    return re.sub(r"\s+", " ", str(value or "")).strip().lower()


def normalize_key(value: Any) -> str:
    s = str(value or "").strip().lower()
    s = re.sub(r"[^a-z0-9]+", "_", s)
    return s.strip("_")


def normalize_provider_label(provider: Any, label: Any) -> str:
    lab = str(label or "").strip()
    prov = str(provider or "").strip()
    if prov and lab and "::" not in lab:
        return f"{prov}::{lab}"
    return lab or prov


def label_core(label: Any) -> str:
    s = str(label or "")
    if "::" in s:
        s = s.split("::", 1)[1]
    return normalize_text(s)


def parse_list(value: str) -> List[Any]:
    value = str(value or "").strip()
    if not value:
        return []

    try:
        parsed = json.loads(value)
        if isinstance(parsed, list):
            return parsed
        if isinstance(parsed, dict):
            return [parsed]
    except Exception:
        pass

    normalized = value.replace(",", "\n")
    parts = [p.strip() for p in normalized.splitlines()]
    return [p for p in parts if p]


def parse_dict(value: str) -> Dict[str, Any]:
    value = str(value or "").strip()
    if not value:
        return {}

    try:
        parsed = json.loads(value)
        if isinstance(parsed, dict):
            return parsed
    except Exception:
        pass

    result: Dict[str, Any] = {}
    for line in value.splitlines():
        line = line.strip()
        if not line or ":" not in line:
            continue
        key, val = line.split(":", 1)
        result[key.strip()] = val.strip()
    return result


def listify(value: Any) -> List[Any]:
    if value is None:
        return []
    if isinstance(value, list):
        return value
    if isinstance(value, dict):
        return [value]
    return [value]


def first(items: List[Any]) -> Optional[Any]:
    return items[0] if items else None


def unique_preserve_order(items: List[Any]) -> List[Any]:
    seen = set()
    out = []
    for item in items:
        key = json.dumps(item, ensure_ascii=False, sort_keys=True, default=str) if isinstance(item, (dict, list)) else str(item)
        if key not in seen:
            seen.add(key)
            out.append(item)
    return out


def truncate_list(items: List[Any], limit: int) -> Tuple[List[Any], bool]:
    if len(items) <= limit:
        return items, False
    return items[:limit], True


def clean_list(values: Any, limit: int = 100) -> List[str]:
    out: List[str] = []
    for v in listify(values):
        s = redact_secrets(str(v))[0].strip()
        if s and s not in out:
            out.append(s[:200])
        if len(out) >= limit:
            break
    return out


def sha256_text(text: str) -> str:
    return hashlib.sha256((text or "").encode("utf-8", errors="replace")).hexdigest()


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def redact_secrets(text: str) -> Tuple[str, List[str]]:
    flags: List[str] = []
    if not text:
        return "", flags

    out = text
    for name, rx in SECRET_PATTERNS:
        if rx.search(out):
            flags.append(name)
            out = rx.sub("[REDACTED_SECRET]", out)

    return out, sorted(set(flags))


def detect_prompt_injection(text: str) -> List[str]:
    flags: List[str] = []
    low = normalize_text(text)
    for pattern in PROMPT_INJECTION_PATTERNS:
        if re.search(pattern, low, re.I):
            flags.append(pattern)
    return sorted(set(flags))


def valid_ip(value: Any) -> bool:
    s = str(value or "").strip()
    if not re.fullmatch(r"(?:\d{1,3}\.){3}\d{1,3}", s):
        return False
    parts = s.split(".")
    try:
        return all(0 <= int(p) <= 255 for p in parts)
    except Exception:
        return False


def normalize_domain(value: Any) -> str:
    original = str(value or "").strip().lower().rstrip(".")
    if not original:
        return ""

    if "://" in original:
        try:
            parsed = urlparse(original)
            original = (parsed.netloc or "").lower()
            if "@" in original:
                original = original.split("@", 1)[1]
            if ":" in original and not original.startswith("["):
                original = original.split(":", 1)[0]
        except Exception:
            pass

    if original.startswith("[") and original.endswith("]"):
        original = original[1:-1]

    try:
        original = original.encode("idna").decode("ascii")
    except Exception:
        pass

    return original


def normalize_url(value: Any) -> str:
    s = str(value or "").strip()
    if not s:
        return ""
    try:
        if "://" not in s:
            s = "http://" + s
        p = urlparse(s)
        return p.geturl()
    except Exception:
        return s


def normalize_cve(value: Any) -> Optional[str]:
    s = str(value or "").strip().upper()
    if CVE_RE.fullmatch(s):
        return s
    return None


def parse_datetime(value: Any) -> Optional[datetime]:
    if value in (None, ""):
        return None

    s = str(value).strip()
    if not s:
        return None

    s = s.replace("Z", "+00:00")

    try:
        dt = datetime.fromisoformat(s)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        return dt
    except Exception:
        pass

    m = re.search(r"(\d{4})-(\d{2})-(\d{2})", s)
    if m:
        try:
            return datetime(int(m.group(1)), int(m.group(2)), int(m.group(3)), tzinfo=timezone.utc)
        except Exception:
            pass

    return None


def get_field(rec: Dict[str, Any], keys: List[str]) -> Any:
    if not isinstance(rec, dict):
        return None

    lower = {normalize_key(k): v for k, v in rec.items()}
    for key in keys:
        nk = normalize_key(key)
        if nk in lower and lower[nk] not in (None, ""):
            val = lower[nk]
            if isinstance(val, list):
                return val[0] if val else None
            return val
    return None


def extract_temporal(rec: Dict[str, Any]) -> Dict[str, str]:
    temporal: Dict[str, str] = {}
    mappings = {
        "first_seen": ["first_seen", "firstseen", "first_observed", "created", "start_time", "start"],
        "last_seen": ["last_seen", "lastseen", "last_observed", "updated", "end_time", "end"],
        "observed_at": ["observed_at", "observedat", "timestamp", "time", "observed"],
        "published_at": ["published_at", "publishedat", "publication_date", "published"],
        "updated_at": ["updated_at", "updatedat", "last_updated"],
        "retrieved_at": ["retrieved_at", "retrievedat", "collected_at"],
    }

    for canonical, aliases in mappings.items():
        val = get_field(rec, aliases)
        if val not in (None, ""):
            temporal[canonical] = str(val)

    return temporal


def match_explicit(text: str, pattern: str, limit: int = 50) -> List[str]:
    out: List[str] = []
    for m in re.finditer(pattern, text, re.I):
        v = m.group(1).strip()
        if v and v not in out:
            out.append(v[:200])
        if len(out) >= limit:
            break
    return out


def empty_parsed() -> Dict[str, Any]:
    return {
        "actor_labels": [],
        "provider_namespaces": [],
        "intrusion_sets": [],
        "campaigns": [],
        "operations": [],
        "malware_links": [],
        "tool_links": [],
        "infrastructure_links": [],
        "vulnerability_links": [],
        "ttps": [],
        "procedures": [],
        "victimology": [],
        "sectors": [],
        "countries": [],
        "regions": [],
        "source_claims": [],
        "sponsorships": [],
        "objectives": [],
        "motivations": [],
        "personas": [],
        "handles": [],
        "observations": [],
        "notes": [],
    }


def add_note(parsed: Dict[str, Any], note_type: str, **kwargs: Any) -> None:
    if len(parsed.get("notes", [])) >= 200000:
        return
    note = {"type": note_type}
    note.update(kwargs)
    parsed["notes"].append(note)


def add_observation(parsed: Dict[str, Any], statement: str, source_id: str, evidence_id: str, context: str = "") -> None:
    if len(parsed.get("observations", [])) >= 200000:
        return

    redacted, secret_flags = redact_secrets(str(statement or "")[:1000])
    injection_flags = detect_prompt_injection(str(statement or ""))

    parsed["observations"].append({
        "observation_id": f"OBS-{uuid.uuid4()}",
        "statement": redacted,
        "source_id": source_id,
        "evidence_id": evidence_id,
        "context": context[:200],
        "state": "SOURCE_OBSERVED",
        "secret_flags": secret_flags,
        "prompt_injection_flags": injection_flags,
        "content_hash": sha256_text(str(statement or "")),
        "limitations": [
            "Source observation is not verified real-world attribution, campaign identity, actor identity, or victim impact.",
        ],
    })

    if secret_flags:
        add_note(parsed, "SECRET_REDACTION", flags=secret_flags, source_id=source_id, evidence_id=evidence_id, context=context)
    if injection_flags:
        add_note(parsed, "PROMPT_INJECTION_FLAG", flags=injection_flags, source_id=source_id, evidence_id=evidence_id, context=context,
                 caution="Threat reports, actor statements, forum posts, repositories, and IOCs are untrusted evidence, not instructions.")


def add_actor_label(
    parsed: Dict[str, Any],
    label: Any,
    provider: Any = None,
    source_id: str = "",
    evidence_id: str = "",
    context: str = "",
    temporal: Optional[Dict[str, Any]] = None,
    aliases: Any = None,
    description: Any = None,
    state: str = "SOURCE_OBSERVED_LABEL",
) -> None:
    raw = str(label or "").strip()
    if not raw or len(parsed.get("actor_labels", [])) >= 200000:
        return

    redacted, secret_flags = redact_secrets(raw)
    injection_flags = detect_prompt_injection(raw)
    prov = str(provider or "").strip()
    if normalize_text(prov) == "source_text":
        prov = ""

    namespace = normalize_provider_label(prov, redacted)

    parsed["actor_labels"].append({
        "label_id": f"LBL-{uuid.uuid4()}",
        "namespace": namespace,
        "provider": prov or None,
        "display_label": redacted,
        "aliases": clean_list(aliases),
        "description": redact_secrets(str(description or ""))[0][:300],
        "source_id": source_id,
        "evidence_id": evidence_id,
        "context": context[:200],
        "temporal": temporal or {},
        "state": state,
        "secret_flags": secret_flags,
        "prompt_injection_flags": injection_flags,
        "content_hash": sha256_text(namespace),
        "limitations": [
            "Actor label is an analytical identifier created by a provider/source, not automatically a real-world organization, team, or person.",
            "Provider namespace must be preserved.",
        ],
    })

    if prov and prov not in parsed["provider_namespaces"]:
        parsed["provider_namespaces"].append(prov)


def add_intrusion_set(
    parsed: Dict[str, Any],
    label: Any,
    provider: Any = None,
    source_id: str = "",
    evidence_id: str = "",
    temporal: Optional[Dict[str, Any]] = None,
    campaigns: Any = None,
    malware: Any = None,
    ttps: Any = None,
    victimology: Any = None,
    infrastructure: Any = None,
) -> None:
    raw = str(label or "").strip()
    if not raw or len(parsed.get("intrusion_sets", [])) >= 200000:
        return

    parsed["intrusion_sets"].append({
        "intrusion_set_id": f"IS-{uuid.uuid4()}",
        "namespace": normalize_provider_label(provider, raw),
        "provider": str(provider or "").strip() or None,
        "label": redact_secrets(raw)[0][:200],
        "source_id": source_id,
        "evidence_id": evidence_id,
        "temporal": temporal or {},
        "campaigns": clean_list(campaigns),
        "malware": clean_list(malware),
        "ttps": clean_list(ttps),
        "victimology": clean_list(victimology),
        "infrastructure": clean_list(infrastructure),
        "state": "SOURCE_OBSERVED_INTRUSION_SET",
        "limitations": [
            "Intrusion set is an analytical grouping, not automatically a real-world organization.",
            "Intrusion sets may later merge, split, be renamed, or remain unattributed.",
        ],
    })


def add_campaign(
    parsed: Dict[str, Any],
    name: Any,
    aliases: Any = None,
    start_time: Any = None,
    end_time: Any = None,
    sectors: Any = None,
    regions: Any = None,
    victims: Any = None,
    malware: Any = None,
    tools: Any = None,
    infrastructure: Any = None,
    vulnerabilities: Any = None,
    ttps: Any = None,
    procedures: Any = None,
    actor_labels: Any = None,
    source_id: str = "",
    evidence_id: str = "",
    temporal: Optional[Dict[str, Any]] = None,
    state: str = "SOURCE_REPORTED_CAMPAIGN",
) -> None:
    raw = str(name or "").strip()
    if not raw or len(parsed.get("campaigns", [])) >= 200000:
        return

    parsed["campaigns"].append({
        "campaign_id": f"CMP-{uuid.uuid4()}",
        "name": redact_secrets(raw)[0][:200],
        "aliases": clean_list(aliases),
        "start_time": str(start_time or "")[:100] or None,
        "end_time": str(end_time or "")[:100] or None,
        "sectors": clean_list(sectors),
        "regions": clean_list(regions),
        "victims": clean_list(victims),
        "malware": clean_list(malware),
        "tools": clean_list(tools),
        "infrastructure": clean_list(infrastructure),
        "vulnerabilities": clean_list(vulnerabilities),
        "ttps": clean_list(ttps),
        "procedures": clean_list(procedures),
        "actor_labels": clean_list(actor_labels),
        "source_id": source_id,
        "evidence_id": evidence_id,
        "temporal": temporal or {},
        "state": state,
        "limitations": [
            "Campaign is a bounded activity cluster, not automatically an actor.",
            "One campaign may involve multiple teams, contractors, shared infrastructure, or commodity malware.",
        ],
    })


def add_operation(
    parsed: Dict[str, Any],
    name: Any,
    actor_labels: Any = None,
    campaigns: Any = None,
