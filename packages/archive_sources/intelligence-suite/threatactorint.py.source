def add_infrastructure_link(
    parsed: Dict[str, Any],
    actor_label: Any = None,
    campaign: Any = None,
    domain: Any = None,
    ip: Any = None,
    url: Any = None,
    certificate: Any = None,
    asn: Any = None,
    source_id: str = "",
    evidence_id: str = "",
    temporal: Optional[Dict[str, Any]] = None,
    state: str = "SOURCE_REPORTED_INFRASTRUCTURE",
) -> None:
    domain = normalize_domain(domain)
    ip = str(ip or "").strip()
    url = normalize_url(url)
    certificate = str(certificate or "").strip()
    asn = str(asn or "").strip()

    if not any([domain, ip, url, certificate, asn]):
        return
    if len(parsed.get("infrastructure_links", [])) >= 200000:
        return

    parsed["infrastructure_links"].append({
        "infrastructure_link_id": f"INF-{uuid.uuid4()}",
        "actor_label": str(actor_label or "").strip() or None,
        "campaign": str(campaign or "").strip() or None,
        "domain": domain or None,
        "ip": ip or None,
        "url": url or None,
        "certificate": certificate or None,
        "asn": asn or None,
        "source_id": source_id,
        "evidence_id": evidence_id,
        "temporal": temporal or {},
        "state": state,
        "limitations": [
            "Infrastructure may be owned, leased, compromised, shared, cloud-hosted, CDN-mediated, VPN-mediated, or third-party.",
            "Infrastructure overlap alone does not prove actor identity.",
            "Domain/IP control era must be considered; historical reuse does not imply current operator.",
        ],
    })


def add_vulnerability_link(
    parsed: Dict[str, Any],
    cve: Any,
    actor_label: Any = None,
    campaign: Any = None,
