        "source_id": source_id,
        "evidence_id": evidence_id,
        "temporal": temporal or {},
        "state": "SOURCE_REPORTED_OPERATION",
        "limitations": [
            "Operation terminology varies by provider/government/research source.",
            "Do not automatically convert Operation = Campaign = Actor.",
        ],
    })


