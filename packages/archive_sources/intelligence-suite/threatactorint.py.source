    evidence_id: str = "",
    temporal: Optional[Dict[str, Any]] = None,
    state: str = "SOURCE_REPORTED_EXPLOITING",
) -> None:
    cve_norm = normalize_cve(cve)
    if not cve_norm or len(parsed.get("vulnerability_links", [])) >= 200000:
        return

    parsed["vulnerability_links"].append({
        "vulnerability_link_id": f"VL-{uuid.uuid4()}",
        "cve": cve_norm,
        "actor_label": str(actor_label or "").strip() or None,
        "campaign": str(campaign or "").strip() or None,
        "source_id": source_id,
        "evidence_id": evidence_id,
        "temporal": temporal or {},
        "state": state,
        "limitations": [
            "Shared exploitation of the same CVE is usually weak actor-attribution evidence.",
            "Vulnerability truth belongs to VULNINT; exploitation trend context belongs to EXPLOITINT.",
        ],
    })


def add_ttp(
    parsed: Dict[str, Any],
    tactic: Any = None,
    technique: Any = None,
    subtechnique: Any = None,
    procedure: Any = None,
    actor_label: Any = None,
    campaign: Any = None,
    source_id: str = "",
    evidence_id: str = "",
    temporal: Optional[Dict[str, Any]] = None,
    state: str = "SOURCE_REPORTED_TTP",
    attack_version: str = "UNKNOWN",
) -> None:
    tech = str(technique or "").strip().upper()
    sub = str(subtechnique or "").strip().upper()
    if not any([tactic, tech, sub, procedure]):
        return
    if len(parsed.get("ttps", [])) >= 200000:
        return

    base = tech.split(".")[0] if tech else ""
    generic = base in GENERIC_TTPS

    parsed["ttps"].append({
        "ttp_id": f"TTP-{uuid.uuid4()}",
        "tactic": str(tactic or "").strip() or None,
        "technique": tech or None,
        "subtechnique": sub or None,
        "procedure": redact_secrets(str(procedure or ""))[0][:300] or None,
        "actor_label": str(actor_label or "").strip() or None,
        "campaign": str(campaign or "").strip() or None,
        "source_id": source_id,
        "evidence_id": evidence_id,
        "temporal": temporal or {},
        "state": state,
        "attack_version": attack_version,
        "generic_ttp": generic,
        "limitations": [
            "Generic TTP overlap is weak actor-attribution evidence.",
            "Procedure-level evidence is more discriminating than generic technique counts.",
            "ATT&CK mapping requires version, source, and evidence scope.",
        ],
    })


def add_procedure(
    parsed: Dict[str, Any],
