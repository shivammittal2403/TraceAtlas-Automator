            },
            "priority_schema": {
                "priority_id": "Unique priority identifier",
                "cve": "Normalized CVE",
                "priority": "EMERGENCY/CRITICAL_ACTION/HIGH/MEDIUM/LOW/MONITOR/NOT_APPLICABLE/UNKNOWN",
