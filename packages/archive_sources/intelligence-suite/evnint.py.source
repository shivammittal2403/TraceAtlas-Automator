                continue
            if best_dt is None or dt < best_dt:
                best = o
                best_dt = dt
        return best
    class ContradictionDetector:
    def detect(self, observations: List[Observation], baselines: List[Baseline]) -> List[Contradiction]:
        contradictions=[]
        # group same domain/measurement/region/2h
        groups={}
        for o in observations:
            if o.normalized_value is None or o.timestamp is None: continue
            key=(o.domain.value,o.measurement_type,o.region, round_coord(o.location_lat), round_coord(o.location_lon))
            groups.setdefault(key,[]).append(o)
        for key, items in groups.items():
            items=sorted(items,key=lambda x:x.timestamp)
            for a,b in itertools.combinations(items,2):
                if abs((a.timestamp-b.timestamp).total_seconds())>7200: continue
                if a.source_type==b.source_type and a.sensor_id==b.sensor_id: continue
                diff=abs((a.normalized_value or 0)-(b.normalized_value or 0))
                tol=max(1e-6, 3*(a.uncertainty or 0), 3*(b.uncertainty or 0), 0.25*max(abs(a.normalized_value or 0), abs(b.normalized_value or 0)))
                if diff>tol:
                    contradictions.append(Contradiction(... SENSOR_DISAGREEMENT))
        # model vs direct
        for ...
        return contradictions
