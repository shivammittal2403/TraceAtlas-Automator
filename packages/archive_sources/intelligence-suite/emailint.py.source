"""

    case = {
        "case_id": "DEMO-EMAILINT-001",
        "task_id": "TASK-001",
        "objective": "Analyze suspected BEC email for technical indicators and authentication status.",
        "questions": ["Is the domain authenticated?", "Are there signs of impersonation?", "What is the risk level?"],
        "authorization": "INCIDENT_RESPONSE_AUTHORIZED",
        "email_artifacts": [
            {
                "source_id": "GATEWAY_LOG_EXPORT",
                "raw_content": raw_eml
            }
        ],
        "organizational_directory": {
