@dataclass
class Evidence:
    evidence_id: str = field(default_factory=lambda: new_id("EV"))
    case_id: str = ""
    email_id: str = ""
    source_id: str = ""
    source_type: str = "UNKNOWN"
    artifact_hash: str = ""
    raw_artifact_reference: str = ""
    file_format: str = "UNKNOWN"
    ingested_at: datetime = field(default_factory=utcnow)
    parser_version: str = "EMAILINT-parser-0.1.0"
    normalizer_version: str = "EMAILINT-normalizer-0.1.0"
    authorization_context: str = ""


@dataclass
class ReceivedHop:
    hop_id: str = field(default_factory=lambda: new_id("HOP"))
    order_index: int = 0 # 0 is oldest/first received
    from_host: str = ""
    from_ip: Optional[str] = None
    by_host: str = ""
    by_ip: Optional[str] = None
    protocol: str = ""
    tls_cipher: Optional[str] = None
    timestamp: Optional[datetime] = None
    queue_id: Optional[str] = None
    trust_level: HopTrustLevel = HopTrustLevel.UNKNOWN
    raw_header_line: str = ""


@dataclass
class AuthenticationResult:
    auth_id: str = field(default_factory=lambda: new_id("AUTH"))
    mechanism: str = "" # SPF, DKIM, DMARC, ARC
    result: AuthResultStatus = AuthResultStatus.UNKNOWN
    domain: Optional[str] = None
    selector: Optional[str] = None # For DKIM
    smtp_remote_ip: Optional[str] = None
    comment: Optional[str] = None
    producing_server: Optional[str] = None
    raw_field: str = ""


