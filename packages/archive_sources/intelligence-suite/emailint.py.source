# SECTION 9 — MAIN EMPLOYEE
# ======================================================================

class EmailIntelligenceEmployee:
    def __init__(self, mode: ModelMode = ModelMode.LOCAL_ONLY):
        self.mode = mode
        self.policy = PolicyGuard()
        self.parser = EMAILINTParser()
        self.trust_analyzer = TrustBoundaryAnalyzer(trusted_providers=["google.com", "microsoft.com", "proton.me", "internal.mail"])
        self.auth_interpreter = AuthenticationInterpreter()
        self.thread_reconstructor = ThreadReconstructor()
        self.impersonation_analyzer = ImpersonationAnalyzer()
        self.bec_analyzer = BecAnalyzer()
        self.compromise_analyzer = MailboxCompromiseAnalyzer()
        self.fact_gate = FactGate()
        self.reviewer = DualAIReviewer()
        self.memory = GraphicalMemory()
        self.reporter = ReportGenerator()

    def run_case(self, case: Dict[str, Any]) -> EMAILINTResult:
        case_id = str(case.get("case_id", new_id("CASE")))
        objective = str(case.get("objective", ""))
        
        # Policy Check
        req_text = objective + " " + " ".join(str(q) for q in case.get("questions", []))
        pol = self.policy.check_request(req_text)
        if pol.decision == PolicyDecision.POLICY_BLOCKED:
            return EMAILINTResult(
                case_id=case_id,
                task_id=str(case.get("task_id")),
                objective=objective,
                status="POLICY_BLOCKED",
                policy_decision=PolicyDecision.POLICY_BLOCKED,
                report="POLICY_BLOCKED: Request seeks prohibited email intrusion/phishing/spoofing activities.",
                safety_flags=["No mailbox access provided.", "No spoofing/phishing generated."],
                limitations=[pol.reason]
            )

        emails = []
        evidence = []
        
        # Ingest Emails
        for eml_data in case.get("email_artifacts", []):
            raw = eml_data.get("raw_content", "")
            src_id = eml_data.get("source_id", "USER_SUPPLIED")
            msg, ev = self.parser.parse_raw_eml(raw, case_id, src_id)
            
            # Analyze Trust
            self.trust_analyzer.analyze(msg)
            
            # Interpret Auth
            msg.auth_interpretation = self.auth_interpreter.interpret(msg) # Added dynamic attr for simplicity
            
            emails.append(msg)
            evidence.append(ev)
            
        # Threads
        threads = self.thread_reconstructor.reconstruct(emails)
        
        # Impersonation/BEC
        imp_findings = []
        bec_findings = []
        comp_findings = []
        
        org_dir = case.get("organizational_directory", {})
        hist_vendor = case.get("historical_vendor_details", {})
        audit_logs = case.get("mailbox_audit_logs", [])
        
        for e in emails:
            imp_findings.extend(self.impersonation_analyzer.analyze(e, org_dir))
            bec_findings.extend(self.bec_analyzer.analyze(e, hist_vendor))
            state = self.compromise_analyzer.analyze(e, audit_logs)
            if state != MailboxCompromiseState.NOT_SUPPORTED:
                comp_findings.append({"email_id": e.email_id, "state": state.value})
                
        # Fact Gate
        fg_out = self.fact_gate.generate(emails=emails, sources=[])
        
        # Review
        rev = self.reviewer.review(emails=emails, findings=imp_findings + bec_findings)
        
        status = "SUCCEEDED" if emails else "INSUFFICIENT_DATA"
        if rev["human_review_required"]:
            status = "PARTIAL_HUMAN_REVIEW_REQUIRED"
            
        result = EMAILINTResult(
            case_id=case_id,
            task_id=str(case.get("task_id")),
            objective=objective,
            status=status,
            evidence=evidence,
            emails=emails,
            threads=threads,
            impersonation_findings=imp_findings,
            bec_findings=bec_findings,
            mailbox_compromise_findings=comp_findings,
            facts=fg_out["facts"],
            hypotheses=[], # Placeholder
            contradictions=[], # Placeholder
            knowledge_gaps=fg_out["knowledge_gaps"],
            next_actions=fg_out["next_actions"],
            specialist_handoffs=fg_out["specialist_handoffs"],
            source_independence={}, # Placeholder
            review=rev,
            graph=self.memory.write_result(_ := EMAILINTResult(**{"case_id":"tmp","task_id":"t","objective":"o","status":"s"})), # Hacky init for mem
            report="",
            unknowns=fg_out["unknowns"],
            limitations=fg_out["limitations"],
            safety_flags=["No active content executed.", "No credentials used.", "Original hashes preserved."],
            privacy_flags=["BCC minimized unless authorized.", "PII redacted in reports where possible."]
        )
        
        result.graph = self.memory.write_result(result)
        result.report = self.reporter.generate(result)
        return result


