    HYBRID = "HYBRID"
    CLOUD = "CLOUD"


class PolicyDecision(str, Enum):
    ALLOW = "ALLOW"
    POLICY_BLOCKED = "POLICY_BLOCKED"


class HopTrustLevel(str, Enum):
    TRUSTED_HOP = "TRUSTED_HOP"
    UNTRUSTED_HOP = "UNTRUSTED_HOP"
    UNKNOWN = "UNKNOWN"


class AuthResultStatus(str, Enum):
    PASS = "PASS"
    FAIL = "FAIL"
    SOFT_FAIL = "SOFT_FAIL"
    NEUTRAL = "NEUTRAL"
    TEMPERROR = "TEMPERROR"
    PERMERROR = "PERMERROR"
    NONE = "NONE"
    UNKNOWN = "UNKNOWN"


