    result = employee.run_case(case)
    print(result.report)


def main() -> None:
    print("\n" + "=" * 72)
    print("LAWFUL DEFENSIVE NARRATIVE PROPAGATION DEMO")
    print("=" * 72 + "\n")
    demo_lawful_narrative_propagation()

    print("\n" + "=" * 72)
    print("POLICY-BLOCKED PROPAGANDA / BOT / MICROTARGETING DEMO")
    print("=" * 72 + "\n")
    demo_policy_blocked_manipulation()


