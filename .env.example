# Public Vercel control plane (publishable key only)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
TRACEATLAS_ALLOWED_ORIGINS=https://traceatlas-automator.vercel.app

# Worker only. Never add this value to browser/public Vercel variables.
SUPABASE_SECRET_KEY=SET_ONLY_ON_THE_PRIVATE_WORKER
TRACEATLAS_WORKER_ID=oracle-worker-01

# Optional separately deployed enrichment services. Keep keys server/local only.
INTELOWL_URL=http://127.0.0.1:80
INTELOWL_API_KEY=SET_ONLY_ON_THE_PRIVATE_WORKER
# MISP is optional and is used only for bounded exact-observable searches.
MISP_URL=http://127.0.0.1:8081
MISP_API_KEY=SET_ONLY_ON_THE_PRIVATE_WORKER
# Comma-separated hostnames required when IntelOwl or MISP uses remote HTTPS.
TRACEATLAS_SERVICE_HOSTS=

# Optional official provider credentials used only by the local/private runtime.
GITHUB_TOKEN=
YOUTUBE_API_KEY=
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
VIRUSTOTAL_API_KEY=
NVD_API_KEY=
HIBP_API_KEY=
ORCID_ACCESS_TOKEN=
WIGLE_API_NAME=
WIGLE_API_TOKEN=
